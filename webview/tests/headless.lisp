(load (merge-pathnames "../scripts/bootstrap.lisp" *load-truename*))
(asdf:load-system "lut/webview")
(let* ((window (lut:make-widget 'lut:window :width 400 :height 300))
       (view (lut:add-child window (lut:make-widget 'lut-webview:webview)))
       (events nil))
  (lut:layout window 0 0 400 300)
  (assert (not (lut::focusable-p nil)))
  (assert (eq :retained (lut:cache-mode view)))
  (assert (lut::focusable-p view))
  (lut:focus window view)
  (assert (eq view (lut:focused-widget window)))
  (assert (null (lut::embedded-input view window (lut:make-event :kind :key :key :a))))
  (defmethod lut::embedded-input ((w lut-webview:webview) root event)
    (declare (ignore w root)) (push (lut:event-kind event) events) t)
  (lut:dispatch window (lut:make-event :kind :text :text "λ"))
  (assert (equal events '(:text)))
  (setf (lut:visible-p view) nil)
  (lut:dispatch window (lut:make-event :kind :text :text "hidden"))
  (assert (equal events '(:text)))
  (remove-method #'lut::embedded-input
    (find-method #'lut::embedded-input nil (list (find-class 'lut-webview:webview) (find-class t) (find-class t))))
  (lut:dispose window))
(asdf:test-system "lut")
(format t "PASS: headless webview focus, input consumption, hidden-input exclusion, and LUT suite.~%")
