(load (merge-pathnames "../scripts/bootstrap.lisp" *load-truename*))
(asdf:load-system "lut/cef")
;; Hosted macOS VMs lack the OpenGL pixel format raylib needs. Exercise the real
;; CEF bridge and CFFI on the OS main thread without creating a GL window.
(lut-webview::call-with-native-run (lambda ()
  (lut-webview::initialize-cef)
  (let ((view nil))
    (labels ((await-cef (predicate)
               (let ((deadline (+ (get-internal-real-time) (* 20 internal-time-units-per-second))))
                 (loop do (lut-webview::%pump)
                       when (funcall predicate) return t
                       do (when (> (get-internal-real-time) deadline) (error "CEF offscreen wait timed out (title ~s, URL ~s)." (lut-webview::%title view) (lut-webview::%url view)))
                          (sleep 0.01)))))
      (unwind-protect
        (progn
          (setf view (lut-webview::%create
            (concatenate 'string "file://" #+win32 "/"
              (namestring (asdf:system-relative-pathname "lut/webview" "webview/tests/smoke.html"))) 640 480 1d0))
          (assert (not (cffi:null-pointer-p view)))
          (await-cef (lambda () (and (= 0 (lut-webview::%loading view))
                                   (string= "LUT smoke ready" (lut-webview::%title view)))))
          (await-cef (lambda ()
            (cffi:with-foreign-objects ((w :int) (h :int) (r :uint64))
              (and (not (cffi:null-pointer-p (lut-webview::%frame view w h r)))
                   (plusp (cffi:mem-ref r :uint64))))))
          (dotimes (i 20) (lut-webview::%pump) (sleep 0.01))
          (lut-webview::%state view 1 0)
          (lut-webview::%mouse view 0 40 170 0 0)
          (lut-webview::%mouse view 1 40 170 0 0)
          (lut-webview::%mouse view 2 40 170 0 0)
          (await-cef (lambda () (string= "pointer verified" (lut-webview::%title view))))
          (lut-webview::%mouse view 1 40 100 0 0)
          (lut-webview::%mouse view 2 40 100 0 0)
          (lut-webview::%text view "λCEF")
          (await-cef (lambda () (string= "input:λCEF" (lut-webview::%title view))))
          (lut-webview::%key view 8 0)
          (await-cef (lambda () (string= "input:λCE" (lut-webview::%title view))))
          (lut-webview::%resize view 700 500 2d0)
          (await-cef (lambda ()
            (cffi:with-foreign-objects ((w :int) (h :int) (r :uint64))
              (let ((pixels (lut-webview::%frame view w h r)))
                (and (not (cffi:null-pointer-p pixels))
                     (= 1400 (cffi:mem-ref w :int)) (= 1000 (cffi:mem-ref h :int))
                     (plusp (cffi:mem-ref r :uint64)))))))
          (lut-webview::%navigate view "about:blank")
          (await-cef (lambda () (and (= 0 (lut-webview::%loading view))
                                   (string= "about:blank" (lut-webview::%url view)))))
          (format t "PASS: CEF offscreen pointer, Unicode text, key, DPI pixels and navigation.~%"))
        (when (and view (not (cffi:null-pointer-p view)))
          (lut-webview::%close view)
          (await-cef (lambda () (= 1 (lut-webview::%closed view))))
          (lut-webview::%release view))
        (assert (= 1 (lut-webview::%shutdown)))
        (setf lut-webview::*initialized* nil))))))
(when rl:*last-error* (uiop:quit 1))
