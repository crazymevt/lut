(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (merge-pathnames "../../lut.asd" *load-truename*))
(ql:quickload "lut/cef" :silent t)
(let* ((limit (uiop:getenv "LUT_WEBVIEW_FRAMES"))
       (frames (and limit (parse-integer limit)))
       (smoke (uiop:getenv "LUT_WEBVIEW_SMOKE")))
  (when (and frames (not (plusp frames))) (error "LUT_WEBVIEW_FRAMES must be positive."))
  (lut-webview:run-demo :frames frames :smoke smoke :screenshot (uiop:getenv "LUT_WEBVIEW_SCREENSHOT")))
(when rl:*last-error* (uiop:quit 1))
