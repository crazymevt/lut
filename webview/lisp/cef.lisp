(in-package #:lut-webview)
(defvar *library* nil)
(defvar *views* nil)
(defvar *closing* nil)
(defvar *initialized* nil)
(defvar *scheduled-pump* nil)
(defparameter *runtime*
  (or (let ((path (uiop:getenv "LUT_CEF_RUNTIME"))) (when path (uiop:ensure-directory-pathname path)))
      (asdf:system-relative-pathname "lut/webview" "webview/runtime/")))
(defun load-bridge ()
  (unless *library*
    (let ((path (namestring (merge-pathnames
                 #+darwin "liblut_cef.dylib" #+win32 "lut_cef.dll"
                 #-(or darwin win32) "liblut_cef.so" *runtime*))))
      #+win32
      (cffi:with-foreign-string (wide path :encoding :utf-16le)
        ;; Resolve libcef and its dependencies beside the bridge, independent of
        ;; the executable's location and the user's current working directory.
        (let ((module (cffi:foreign-funcall ("LoadLibraryExW" :convention :stdcall)
                        :pointer wide :pointer (cffi:null-pointer) :uint32 #x1100 :pointer)))
          (when (cffi:null-pointer-p module) (error "Could not load CEF runtime at ~a" path))
          (unwind-protect (setf *library* (cffi:load-foreign-library path))
            (cffi:foreign-funcall ("FreeLibrary" :convention :stdcall) :pointer module :int))))
      #-win32 (setf *library* (cffi:load-foreign-library path)))))
(cffi:defcfun ("lut_cef_init" %init) :int (runtime :string) (helper :string))
(cffi:defcfun ("lut_cef_pump" %pump) :void)
(cffi:defcfun ("lut_cef_set_wake" %set-wake) :void (wake :pointer))
(cffi:defcfun ("lut_cef_next_delay_ms" %next-delay) :int64)
(defun cef-pump-delay ()
  (when *initialized* (let ((delay (%next-delay))) (unless (minusp delay) (/ delay 1000.0d0)))))
(defun enable-scheduled-pump (window)
  "Service CEF deadlines on the native UI thread. Earlier deadlines wake through
  raylib's native C entry point; foreign CEF threads never enter Lisp."
  (unless (cffi:foreign-symbol-pointer "lut_cef_next_delay_ms")
    (error "Rebuild the CEF bridge for scheduled pumping."))
  (setf *scheduled-pump* t)
  (%set-wake (or (cffi:foreign-symbol-pointer "LUTWakeEvents") (cffi:null-pointer)))
  (lut:register-ui-service (lambda () (pump-webviews window)) #'cef-pump-delay :owner window)
  ;; Sync native size/focus/visibility and newly attached views on actual UI work.
  (lut:on window :tick (lambda (w dt) (declare (ignore dt)) (pump-webviews w)) :interval nil)
  (lut:on window :context-close (lambda (w event) (declare (ignore w event))
                                (%set-wake (cffi:null-pointer)) (setf *scheduled-pump* nil))))
(cffi:defcfun ("lut_cef_shutdown" %shutdown) :int)
(cffi:defcfun ("lut_cef_create" %create) :pointer (url :string) (width :int) (height :int) (scale :double))
(cffi:defcfun ("lut_cef_close" %close) :void (view :pointer))
(cffi:defcfun ("lut_cef_closed" %closed) :int (view :pointer))
(cffi:defcfun ("lut_cef_release" %release) :void (view :pointer))
(cffi:defcfun ("lut_cef_resize" %resize) :void (view :pointer) (width :int) (height :int) (scale :double))
(cffi:defcfun ("lut_cef_state" %state) :void (view :pointer) (focus :int) (hidden :int))
(cffi:defcfun ("lut_cef_navigate" %navigate) :void (view :pointer) (url :string))
(cffi:defcfun ("lut_cef_messages" %messages) :void (view :pointer) (url :string))
(cffi:defcfun ("lut_cef_execute" %execute) :int (view :pointer) (script :string))
(cffi:defcfun ("lut_cef_message" %message) :string (view :pointer))
(cffi:defcfun ("lut_cef_command" %command) :void (view :pointer) (command :int))
(cffi:defcfun ("lut_cef_mouse" %mouse) :void (view :pointer) (kind :int) (x :int) (y :int) (modifiers :int) (delta :int))
(cffi:defcfun ("lut_cef_key" %key) :void (view :pointer) (key :int) (modifiers :int))
(cffi:defcfun ("lut_cef_text" %text) :void (view :pointer) (text :string))
(cffi:defcfun ("lut_cef_damage" %damage) :pointer
  (view :pointer) (since :uint64) (cursor :pointer) (x :pointer) (y :pointer) (width :pointer) (height :pointer))
(cffi:defcfun ("lut_cef_frame" %frame) :pointer (view :pointer) (width :pointer) (height :pointer) (revision :pointer))
(cffi:defcfun ("lut_cef_title" %title) :string (view :pointer))
(cffi:defcfun ("lut_cef_url" %url) :string (view :pointer))
(cffi:defcfun ("lut_cef_loading" %loading) :int (view :pointer))
(cffi:defcfun ("lut_cef_error" %error) :string (view :pointer))
(defun live-handle (view)
  (lut::ensure-live view)
  (or (handle view) (error "Webview has no native context yet.")))
(defmethod execute-script ((view webview) script)
  (check-type script string)
  (and (handle view) (= 1 (%execute (handle view) script))))
(defmethod webviews-ready-p () *initialized*)
(defun runtime-available-p ()
  (not (null (probe-file (merge-pathnames #+darwin "liblut_cef.dylib" #+win32 "lut_cef.dll"
                         #-(or darwin win32) "liblut_cef.so" *runtime*)))))
(defmethod attach-webview ((view webview) window)
  (unless *initialized* (error "Initialize the CEF runtime before opening native windows."))
  (unless (eq (lut:root-of view) window) (error "Attach the webview to its owning window first."))
  (unless (member view *views*)
    (push view *views*)
    (lut:on window :context-close
      (lambda (w event) (declare (ignore w event)) (release-webview-native view))))
  view)
(defun pump-webviews (window)
  (when *initialized*
    (when (or (not *scheduled-pump*) (let ((delay (cef-pump-delay))) (and delay (<= delay 0))))
      (%pump))
    (reap-closed)
    (dolist (view (copy-list *views*))
      (when (eq (lut:root-of view) window) (update-view view window)))))
(defmethod navigate ((view webview) url)
  (check-type url string) (%navigate (live-handle view) url) view)
(defmethod go-back ((view webview)) (%command (live-handle view) 0))
(defmethod go-forward ((view webview)) (%command (live-handle view) 1))
(defmethod reload-page ((view webview)) (%command (live-handle view) 2))
(defmethod stop-loading ((view webview)) (%command (live-handle view) 3))
(defun initialize-cef ()
  (load-bridge)
  (when *initialized* (error "Only one standalone CEF session is supported."))
  (unless (= 1 (%init (namestring *runtime*)
    (namestring (merge-pathnames
      #+darwin "LUT Webview Helper.app/Contents/MacOS/lut_cef_helper"
      #+win32 "lut_cef_helper.exe" #-(or darwin win32) "lut_cef_helper" *runtime*))))
    (error "CEF initialization failed; on macOS use a fresh Lisp process before opening LUT windows."))
  (setf *initialized* t))
(defun reap-closed ()
  (setf *closing* (delete-if (lambda (handle)
    (when (= 1 (%closed handle)) (%release handle) t)) *closing*)))
(defun update-view (view window)
  (let* ((scale (coerce (lut::widget-raster-scale view) 'double-float))
         (width (max 1 (round (lut:width view))))
         (height (max 1 (round (lut:height view))))
         (visible (and (lut::live-input-widget-p view window)
                       (not (lut:disposed-p view))))
         (state (list (eq view (lut:focused-widget window)) (not visible))))
    (unless (handle view)
      (let ((h (%create (initial-url view) width height scale)))
        (when (cffi:null-pointer-p h) (error "CEF browser creation failed (maximum size 8192 × 8192)."))
        (setf (handle view) h)
        (when (local-messages-p view) (%messages h (initial-url view)))))
    (loop repeat 128 for message = (%message (handle view)) while message do
      (lut:emit view :message message)
      (when (lut:disposed-p view) (return-from update-view nil)))
    (let ((size (list width height scale)))
      (unless (equal size (native-size view))
        (%resize (handle view) width height scale)
        (setf (native-size view) size)))
    (unless (equal state (native-state view))
      (%state (handle view) (if (first state) 1 0) (if (second state) 1 0))
      (setf (native-state view) state))
    (dolist (spec '((page-title %title :title-change) (page-url %url :url-change)
                    (loading-p %loading :loading-change) (load-error %error :load-error)))
      (destructuring-bind (slot getter event) spec
        (let ((value (funcall getter (handle view))))
          (when (eq slot 'loading-p) (setf value (= value 1)))
          (unless (equal value (slot-value view slot))
            (setf (slot-value view slot) value)
            (lut:emit view event value)))))
    (cffi:with-foreign-objects ((w :int) (h :int) (r :uint64))
      (let ((pixels (%frame (handle view) w h r)))
        (unless (or (cffi:null-pointer-p pixels) (= (revision view) (cffi:mem-ref r :uint64)))
          (let ((pw (cffi:mem-ref w :int)) (ph (cffi:mem-ref h :int)))
            (upload-frame view pixels pw ph (cffi:mem-ref r :uint64))))))))

(defun upload-frame (view pixels pw ph next-revision)
  (lut:request-paint view)
  ;; Revision commits only after all uploads succeed. Partial failures can retry
  ;; from the previous revision; native damage is never consumed destructively.
  (if (or (null (texture view))
          (/= pw (rl:texture-width (texture view)))
          (/= ph (rl:texture-height (texture view))))
      (progn
        (when (texture view) (rl:unload-texture (texture view)) (setf (texture view) nil))
        (setf (texture view) (rl:load-texture-from-image
          (rl:make-image :data pixels :width pw :height ph :mipmap-count 1
                        :pixel-format :uncompressed-r8g8b8a8)))
        (clrhash (damage-keys view))
        (incf (uploaded-bytes view) (* pw ph 4))
        ;; A texture replacement is a whole-widget visual change, not layout.
        (incf (slot-value view 'lut::render-revision)))
      (cffi:with-foreign-objects ((cursor :int) (x :int) (y :int) (w :int) (h :int))
        (setf (cffi:mem-ref cursor :int) 0)
        (loop for patch = (%damage (handle view) (revision view) cursor x y w h)
              until (cffi:null-pointer-p patch) do
          (let ((rx (cffi:mem-ref x :int)) (ry (cffi:mem-ref y :int))
                (rw (cffi:mem-ref w :int)) (rh (cffi:mem-ref h :int)))
            (rl:update-texture-rec (texture view) (rl:rect rx ry rw rh) patch)
            (setf (gethash (list rx ry) (damage-keys view)) next-revision)
            (incf (uploaded-bytes view) (* rw rh 4))))))
  (setf (revision view) next-revision)
  (incf (uploads view)))

(defun frame-render-regions (view pw ph)
  ;; Pixel blocks map to logical widget coordinates (including fractional DPI).
  ;; Keep keys for unchanged blocks stable, with bounded storage per texture.
  (when (and (plusp pw) (plusp ph))
    (loop for y from 0 below ph by 128 append
      (loop for x from 0 below pw by 128 collect
        ;; Include a one-texel sampling halo for filtered/fractional-scale draws.
        (let ((left (max 0 (1- x))) (top (max 0 (1- y)))
              (right (min pw (+ x 129))) (bottom (min ph (+ y 129))))
          (list (list (* left (/ (lut:width view) pw)) (* top (/ (lut:height view) ph))
                      (* (- right left) (/ (lut:width view) pw))
                      (* (- bottom top) (/ (lut:height view) ph)))
                (gethash (list x y) (damage-keys view) 0)))))))
(defmethod lut:widget-render-regions ((view webview))
  (when (texture view)
    (frame-render-regions view (rl:texture-width (texture view)) (rl:texture-height (texture view)))))
(defmethod lut:render ((view webview))
  (when (texture view)
    (rl:draw-texture-pro (texture view)
      (rl:rect 0 0 (rl:texture-width (texture view)) (rl:texture-height (texture view)))
      (rl:rect (lut:x view) (lut:y view) (lut:width view) (lut:height view))
      (rl:vec2 0 0) 0 :white)))
(defun release-webview-native (view)
  (when (handle view)
    (%close (handle view)) (push (handle view) *closing*) (setf (handle view) nil))
  (when (texture view) (rl:unload-texture (texture view)) (setf (texture view) nil))
  (clrhash (damage-keys view))
  view)
(defmethod lut:dispose :before ((view webview))
  (release-webview-native view)
  (setf *views* (remove view *views*)))
(defun event-modifiers (event)
  (logior (if (lut:event-shift-p event) 2 0)
          (if (lut:event-control-p event) 4 0)
          (if (lut:event-alt-p event) 8 0)
          (if (lut:event-super-p event) 128 0)))
(defun virtual-key (event)
  (or (cdr (assoc (lut:event-base-key event)
    '((:backspace . 8) (:tab . 9) (:enter . 13) (:escape . 27) (:space . 32)
      (:left . 37) (:up . 38) (:right . 39) (:down . 40) (:delete . 46)
      (:home . 36) (:end . 35) (:page-up . 33) (:page-down . 34))))
    (let ((name (symbol-name (lut:event-base-key event))))
      (when (= 1 (length name)) (char-code (char-upcase (char name 0)))))))
(defmethod lut::embedded-input ((view webview) window event)
  (unless (handle view) (return-from lut::embedded-input nil))
  (let* ((kind (lut:event-kind event))
         (x (round (- (lut:event-x event) (lut:x view))))
         (y (round (- (lut:event-y event) (lut:y view))))
         (modifiers (logior (event-modifiers event)
           (if (and (eq kind :move) (eq view (slot-value window 'lut::pressed-widget))) 16 0))))
    (case kind
      (:down (lut:focus window view) (setf (slot-value window 'lut::pressed-widget) view)
             (%state (handle view) 1 0) (%mouse (handle view) 1 x y modifiers 0))
      (:up (%mouse (handle view) 2 x y modifiers 0)
           (setf (slot-value window 'lut::pressed-widget) nil))
      (:move (%mouse (handle view) 0 x y modifiers 0))
      (:wheel (%mouse (handle view) 3 x y modifiers (round (* 120 (lut:event-delta event)))))
      (:key (if (eq (lut:event-base-key event) :f12)
                (lut:focus window nil)
                (let ((key (virtual-key event)))
                  (when key (%key (handle view) key modifiers)))))
      (:text (%text (handle view) (lut:event-text event)))
      (otherwise (return-from lut::embedded-input nil)))) t)
(defun finish-cef-shutdown ()
  ;; OnBeforeClose precedes final deferred client releases on some platforms.
  ;; Pump those releases before attempting CEF teardown.
  (let ((deadline (+ (get-internal-real-time) (* 10 internal-time-units-per-second))))
    (loop until (= 1 (%shutdown)) do
      (when (> (get-internal-real-time) deadline)
        (error "CEF retained live clients after browser closure."))
      (%pump) (sleep 0.01)))
  (setf *initialized* nil))
(defun close-session ()
  (dolist (view (copy-list *views*)) (lut:dispose view))
  (let ((deadline (+ (get-internal-real-time) (* 10 internal-time-units-per-second))))
    (loop while *closing* do (%pump) (reap-closed)
      (when (> (get-internal-real-time) deadline)
        (error "CEF close timed out; runtime retained to avoid unsafe shutdown."))
      (sleep 0.01)))
  (finish-cef-shutdown))

(defun call-with-native-run (function)
  "Run synchronously on the native thread and re-signal failures after cleanup.
Do not rely on raylib:*last-error*, which native teardown can clear."
  (let ((failure nil) (result nil))
    (rl:run (lambda ()
      (let ((lut::*signal-run-errors* t))
        (handler-case (setf result (funcall function))
          (error (condition) (setf failure condition))))) :wait t)
    (when failure (error failure))
    result))
