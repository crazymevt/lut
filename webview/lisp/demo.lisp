(in-package #:lut-webview)
(defclass demo-window (lut:window) ())
(defmethod lut:layout :after ((window demo-window) x y width height)
  (destructuring-bind (toolbar browser status) (lut:children window)
    (setf (lut:width (fourth (lut:children toolbar))) (max 120 (- width 288)))
    (lut:layout toolbar (+ x 12) (+ y 12) (- width 24) 36)
    (lut:layout browser (+ x 12) (+ y 60) (- width 24) (max 1 (- height 104)))
    (lut:layout status (+ x 16) (+ y (- height 32)) (- width 32) 24)))
(defun demo-page-url ()
  (let ((path (namestring (asdf:system-relative-pathname "lut/webview" "webview/tests/page.html"))))
    (concatenate 'string "file://" #+win32 "/" path)))
(defun capture-demo (window path)
  ;; Capture the retained UI in an explicit render target, independent of
  ;; native framebuffer readback and Retina viewport state.
  (let ((target (rl:load-render-texture (round (* (lut:width window) (lut:ui-scale window)))
                                       (round (* (lut:height window) (lut:ui-scale window))))))
    (unwind-protect
      (progn
        (rl:with-texture-mode (target)
          (rl:clear-background (lut::style-value window :background))
          (let ((lut::*composite-window-cache* nil)) (lut::render-window window)))
        (let ((image (rl:load-image-from-texture (rl:render-texture-texture target))))
          (unwind-protect (progn (rl:image-flip-vertical image) (rl:export-image image path))
            (rl:unload-image image))))
      (rl:unload-render-texture target))))
(defun launch-ui-scale (&optional (value (uiop:getenv "LUT_UI_SCALE")))
  "Read a decimal UI scale without invoking the Lisp reader."
  (if (or (null value) (zerop (length value))) 1
      (let* ((dot (position #\. value))
             (digits (remove #\. value)))
        (unless (and (plusp (length digits))
                     (every (lambda (c) (digit-char-p c 10)) digits)
                     (or (null dot) (= 1 (count #\. value))))
          (error "LUT_UI_SCALE must be a decimal number between 0.5 and 4."))
        (let ((scale (/ (parse-integer digits)
                        (if dot (expt 10 (- (length value) dot 1)) 1))))
          (unless (<= 1/2 scale 4)
            (error "LUT_UI_SCALE must be between 0.5 and 4."))
          scale))))
(defun run-demo (&key frames smoke (ui-scale (if smoke 1 (launch-ui-scale)))
                        (url (if smoke (concatenate 'string "file://" #+win32 "/"
                          (namestring (asdf:system-relative-pathname "lut/webview" "webview/tests/smoke.html")))
                          (demo-page-url))) screenshot)
  "Run once in a fresh process. F12 returns browser keyboard focus to LUT."
  (call-with-native-run
   (lambda ()
    (initialize-cef)
    (let* ((*views* nil) (*closing* nil)
           (window (lut:make-widget 'demo-window :text "LUT · CEF Webview" :theme lut:*dark-theme* :ui-scale ui-scale :width 1100 :height 760
                     :style '(:background (24 27 34 255) :padding 0)))
           (toolbar (lut:add-child window (lut:make-widget 'lut:box :orientation :horizontal
                         :height 36 :spacing 8 :style '(:padding 0))))
           (back (lut:add-child toolbar (lut:make-widget 'lut:button :text "Back" :width 72 :height 34)))
           (forward (lut:add-child toolbar (lut:make-widget 'lut:button :text "Forward" :width 88 :height 34)))
           (reload (lut:add-child toolbar (lut:make-widget 'lut:button :text "Reload" :width 80 :height 34)))
           (address (lut:add-child toolbar (lut:make-widget 'lut:entry :text url :width 620 :height 34)))
           (view (lut:add-child window (lut:make-widget 'webview :url url)))
           (status (lut:add-child window (lut:make-widget 'lut:label :text "Starting Chromium… · F12 releases browser focus" :height 24)))
           (loaded nil) (seen-paint nil) (stable-revision nil) (stable-count 0) (reuse nil)
           (stage :idle) (idle-presents nil) (idle-cpu nil) (idle-wall nil) (idle-percent nil) (smoke-result nil))
      (setf *views* (list view))
      (lut:on back :activate (lambda (w e) (declare (ignore w e)) (go-back view)))
      (lut:on forward :activate (lambda (w e) (declare (ignore w e)) (go-forward view)))
      (lut:on reload :activate (lambda (w e) (declare (ignore w e)) (reload-page view)))
      (lut:on address :activate (lambda (w e) (declare (ignore e)) (navigate view (lut:text w))))
      (lut:on view :url-change (lambda (w value) (declare (ignore w)) (setf (lut:text address) value)))
      (lut:on view :title-change (lambda (w value) (declare (ignore w))
        (setf (lut:text window) (format nil "~a · LUT Webview" value))))
      (lut:on view :loading-change (lambda (w value)
        (unless value (setf loaded t))
        (setf (lut:text status) (if value "Loading…" (format nil "~a · F12 releases browser focus" (page-title w))))))
      (lut:on view :load-error (lambda (w value) (declare (ignore w))
        (unless (zerop (length value)) (setf (lut:text status) value))))
      (lut:on window :tick (lambda (w dt) (declare (ignore dt))
        (%pump) (reap-closed)
        (dolist (v *views*) (update-view v w))
        (when (plusp (revision view)) (setf seen-paint t))
        (when (and screenshot (not smoke) loaded seen-paint)
          (if (eql stable-revision (revision view)) (incf stable-count)
              (setf stable-revision (revision view) stable-count 0))
          (when (> stable-count 90) (capture-demo w screenshot) (setf screenshot nil)))
        (when (and smoke loaded seen-paint)
          (flet ((send (kind &rest args)
                   (lut:dispatch w (apply #'lut:make-event :kind kind args)))
                 (click (px py)
                   (lut:dispatch w (lut:make-event :kind :down :x (+ (lut:x view) px) :y (+ (lut:y view) py)))
                   (lut:dispatch w (lut:make-event :kind :up :x (+ (lut:x view) px) :y (+ (lut:y view) py)))))
            (case stage
              (:idle
                (if (eql stable-revision (revision view)) (incf stable-count)
                    (setf stable-revision (revision view) stable-count 0))
                (when (> stable-count 90)
                  (setf reuse t idle-cpu (get-internal-run-time)
                        idle-wall (get-internal-real-time)
                        idle-presents (getf (lut:window-cache-statistics w) :presents) stage :measure)))
              (:measure
                (assert (= stable-revision (revision view)) () "Static browser repainted during idle sample.")
                (when (> (- (get-internal-real-time) idle-wall) (* 3 internal-time-units-per-second))
                  (assert (zerop (getf (lut:window-cache-statistics w) :dynamic-paints)))
                  (assert (<= (- (getf (lut:window-cache-statistics w) :presents) idle-presents) 4))
                  (setf idle-percent (* 100.0 (/ (- (get-internal-run-time) idle-cpu)
                                               (- (get-internal-real-time) idle-wall))))
                  (when screenshot (capture-demo w screenshot))
                  (click 60 170) (setf stage :pointer)))
              (:pointer (when (string= (page-title view) "pointer verified")
                (click 60 100) (send :text :text "λCEF") (setf stage :text)))
              (:text (when (string= (page-title view) "input:λCEF")
                (send :key :key :backspace :base-key :backspace) (setf stage :key)))
              (:key (when (string= (page-title view) "input:λCE")
                (send :wheel :x (+ (lut:x view) 500) :y (+ (lut:y view) 400) :delta -4)
                (setf stage :scroll)))
              (:scroll (when (string= (page-title view) "scroll verified")
                (lut:set-normal-window-size w 980 700)
                (setf (lut:ui-scale w) 1.25 stage :resize)))
              (:resize (when (and (= (lut:ui-scale w) 1.25)
                                  (texture view)
                                  (= (rl:texture-width (texture view))
                                     (round (* (lut::widget-raster-scale view) (lut:width view)))))
                (navigate view "about:blank") (setf stage :navigate)))
              (:navigate (when (and (string= (page-url view) "about:blank") (not (loading-p view)))
                (go-back view) (setf stage :back)))
              (:back (when (and (search "smoke.html" (page-url view)) (not (loading-p view)))
                (setf smoke-result (statistics view) stage :done)
                (lut:stop))))))))
      ;; Native textures and browsers must be released before raylib closes its GL context.
      (lut:on window :context-close (lambda (w e) (declare (ignore w e)) (close-session)))
      (unwind-protect
        (progn
          (lut:run window :frames frames)
          (when smoke
            (assert loaded) (assert seen-paint) (assert reuse) (assert (eq stage :done) () "Smoke stopped at ~s (title ~s)." stage (page-title view))
            (format t "PASS CEF load, pointer, Unicode text, key, scroll, resize/DPI, navigation/back, texture reuse and shutdown.~%Host idle CPU: ~,2f%; ~s~%" idle-percent smoke-result)))
        (when *initialized* (close-session))
        (lut:dispose window))))))
