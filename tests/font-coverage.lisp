(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload '("lut/raylib" "lut/gtk-demo") :silent t)
(defclass caption-probe (lut:label) ((calls :initform 0 :accessor calls)))
(defmethod lut:text-width ((w caption-probe) string) (incf (calls w)) (length string))
(let* ((probe (make-instance 'caption-probe))
       (fitted (lut::fit-caption probe (make-string 100000 :initial-element #\A) 20)))
  (assert (string= fitted "AAAAAAAAAAAAAAAAA..."))
  (assert (<= (calls probe) 21))
  (assert (string= (lut::fit-caption probe "Long" 2) "")))
(let* ((w (lut:make-widget 'lut:window))
       (label (lut:make-widget 'lut:label :text "A é ◆ ● ■ ★ ✓"))
       (diagnostics (make-string-output-stream)))
  (lut:add-child w label)
  (lut:on w :tick (lambda (root dt)
    (declare (ignore root dt))
    (let ((font (lut::widget-font label)))
      (assert (= 65 (rl:glyph-info-value (rl:get-glyph-info font 65))))
      (assert (= 233 (rl:glyph-info-value (rl:get-glyph-info font 233))))
      (assert (/= #x25c6 (rl:glyph-info-value (rl:get-glyph-info font #x25c6)))))))
  (let ((*error-output* diagnostics)) (lut:run w :frames 3))
  (assert (not (search "Requested codepoints glyphs found" (get-output-stream-string diagnostics)))))
(dolist (name '("iconview" "iconview_edit"))
  (let ((diagnostics (make-string-output-stream)))
    (let ((*error-output* diagnostics)) (lut:run (lut-gtk-demo:demo name) :frames 3))
    (assert (not (search "Requested codepoints glyphs found" (get-output-stream-string diagnostics))))))
(format t "Font coverage filtering, supported Unicode and logarithmic caption truncation passed.~%")
