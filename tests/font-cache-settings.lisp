;; Run from the LUT repository: sbcl --script tests/font-cache-settings.lisp
(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(asdf:load-system "lut/raylib")
(let ((original (symbol-function 'lut::load-covered-font))
      (loads 0) (lut::*font-cache* nil) (lut::*used-fonts* nil)
      (lut::*active-window* nil)
      (label (lut:make-widget 'lut:label :style '(:font "/missing/font-a.ttf" :font-size 14)))
      (glyphs (lut::intern-font-glyph-set '(65))))
  (unwind-protect
      (progn
        (setf (symbol-function 'lut::load-covered-font)
              (lambda (path size codes)
                (declare (ignore path size codes)) (incf loads) (gensym "FONT")))
        (let ((key (lut:text-metric-key label)))
          (dotimes (lookup 100) (assert (equal key (lut:text-metric-key label))))
          (setf (lut:style label) '(:font "/missing/font-a.ttf" :font-size 15))
          (assert (not (equal key (lut:text-metric-key label))))
          (setf (lut:style label) '(:font "/missing/font-a.ttf" :font-size 14)))
        (let ((font (lut::lookup-widget-font label glyphs)))
          ;; Nonexistent paths are intentional: a cache hit must never stat them.
          (dotimes (lookup 100) (assert (eq font (lut::lookup-widget-font label glyphs)))))
        (assert (= loads 1))
        (setf (lut:style label) '(:font "/missing/font-b.ttf" :font-size 14))
        (lut::lookup-widget-font label glyphs)
        (assert (= loads 2))
        (setf (lut:style label) '(:font "/missing/font-b.ttf" :font-size 20))
        (lut::lookup-widget-font label glyphs)
        (assert (= loads 3))
        (lut::lookup-widget-font label (lut::intern-font-glyph-set '(65 66)))
        (assert (= loads 4)))
    (setf (symbol-function 'lut::load-covered-font) original)))
(format t "Font cache reuse and settings invalidation checks passed.~%")
