(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload '("lut/demo" "lut/raylib") :silent t)
(dolist (name '("Controls / Button" "Views / Styled text"))
 (dolist (cached '(nil t))
  (let* ((root (lut-demo:make-app)) (frame 0) (start 0) (repaints 0) (layouts 0))
   (setf (lut:cache-enabled-p root) cached)
   (lut-demo::show-example root (find name lut-demo::*examples* :key #'lut-demo::example-name :test #'string=))
   (lut:on root :tick (lambda (w dt) (declare (ignore dt))
     (incf frame)
     (when (= frame 20)
       (setf start (get-internal-run-time)
             layouts (or (getf (lut:window-cache-statistics w) :layout-passes) 0)))
     (when (> frame 20)
       (let ((dirty (getf (lut:window-cache-statistics w) :last-repaints)))
         (when cached (assert (zerop dirty)))
         (incf repaints dirty)))
     (when (= frame 120)
       (when cached
         (assert (= layouts (getf (lut:window-cache-statistics w) :layout-passes)))
         (assert (<= (getf (lut:window-cache-statistics w) :presents) 5)))
       (format t "PROFILE ~a cached=~a cpu-ms/frame=~,3f repaints/frame=~,2f stats=~s~%"
         name cached (* 1000 (/ (- (get-internal-run-time) start) internal-time-units-per-second 100.0))
         (/ repaints 100.0) (lut:window-cache-statistics w)))))
   (let ((lut::*event-sink* (lambda (event) (declare (ignore event)))))
     (unwind-protect (lut:run root :frames 120) (lut:dispose root))))))
