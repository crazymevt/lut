(in-package #:lut-tests)
(defclass command-restore-probe (lut:button) ())
(defmethod (setf lut:text) :after (text (view command-restore-probe))
 (declare (ignore view)) (when (string= text "Original") (error "Expected restoration error")))
(defun command-model () (list :allowed t :count 0))
(defun make-test-command (&optional (shortcut :f6))
 (lut:make-command :increment "Increment"
   (lambda (command context) (declare (ignore command)) (incf (getf context :count)) nil)
   :enabled-when (lambda (command context) (declare (ignore command)) (getf context :allowed))
   :shortcut shortcut))
(defun commands-tests ()
 ;; The same logical action drives toolbar/menu buttons and a shortcut.
 (let* ((root (lut:make-widget 'lut:window)) (model (command-model))
        (command (make-test-command))
        (a (lut:add-child root (lut:make-widget 'lut:button :text "Old A")))
        (bar (lut:add-child root (lut:make-widget 'lut:menu-bar)))
        (b (lut:add-child bar (lut:make-widget 'lut:button :text "Old B")))
        (ba (lut:bind-command root command :widget a :context model))
        (bb (lut:bind-command root command :widget b :context-function (lambda (w) (declare (ignore w)) model) :shortcut-p nil)))
   (assert (equal (lut:window-commands root) (list command)))
   (lut:layout root 0 0 600 400)
   (assert (string= "Increment" (lut:text a))) (assert (string= (lut:text a) (lut:text b)))
   (lut:emit a :activate) (lut:emit b :activate) (assert (= 2 (getf model :count)))
   (let ((event (lut:make-event :kind :key :key :f6)))
     (lut:dispatch root event)
     (assert (null (lut:event-key event))))
   (assert (= 3 (getf model :count)))
   (multiple-value-bind (executed result) (lut:invoke-command command model)
     (assert executed) (assert (null result))) ; NIL action result is still success
   (setf (getf model :allowed) nil)
   (lut:refresh-commands root)
   (assert (not (lut:enabled-p a))) (assert (not (lut:enabled-p b)))
   (lut:emit a :activate)
   (let ((event (lut:make-event :kind :key :key :f6)))
     (lut:dispatch root event) (assert (eq :f6 (lut:event-key event))))
   (assert (= 4 (getf model :count)))
   (assert (not (lut:invoke-command command model)))
   (setf (getf model :allowed) t)
   (lut:refresh-commands root)
   (setf (lut:enabled-p command) nil) (assert (not (lut:enabled-p a)))
   (setf (lut:enabled-p command) t) (assert (lut:enabled-p a))
   (setf (lut:command-label command) "Updated action")
   (assert (string= "Updated action" (lut:text a))) (assert (string= (lut:text a) (lut:text b)))
   (setf (lut:command-shortcut command) :f7)
   (lut:dispatch root (lut:make-event :kind :key :key :f6)) (assert (= 4 (getf model :count)))
   (lut:dispatch root (lut:make-event :kind :key :key :f7)) (assert (= 5 (getf model :count)))
   ;; Modal overlays suppress shortcuts. Menu controls in that overlay can invoke.
   (let* ((menu (lut:make-widget 'lut:context-menu :width 200 :height 120))
          (item (lut:add-child menu (lut:make-widget 'lut:button)))
          (bm (lut:bind-command root command :widget item :context model :shortcut-p nil)))
     (lut:show-dialog root menu) (lut:refresh-commands root)
     (lut:dispatch root (lut:make-event :kind :key :key :f7)) (assert (= 5 (getf model :count)))
     (lut:focus root item)
     (lut:dispatch root (lut:make-event :kind :key :key :enter))
     (assert (= 6 (getf model :count)))
     (assert (null (lut::overlays root)))
     (lut:dispose item) (assert (not (lut:command-binding-active-p bm))))
   (lut:unbind-command ba)
   (assert (string= "Old A" (lut:text a))) (assert (lut:enabled-p a))
   (assert (not (lut:command-binding-active-p ba)))
   (lut:unbind-command ba)
   (dolist (slot '(lut::command lut::window lut::widget lut::context lut::context-function lut::connections))
     (assert (null (slot-value ba slot))))
   ;; Disposing one control leaves another binding usable; disposing a command
   ;; disables the remaining control and clears all event/binding references.
   (lut:dispose b) (assert (not (lut:command-binding-active-p bb)))
   (let* ((c (lut:add-child root (lut:make-widget 'lut:button)))
          (bc (lut:bind-command root command :widget c :context model)))
     (lut:dispose command)
     (assert (not (lut:enabled-p c))) (assert (not (lut:command-binding-active-p bc)))
     (assert (null (lut:command-action command)))
     (assert (null (slot-value root 'lut::command-links)))
     (assert (null (slot-value root 'lut::handlers))))
   (lut:dispose root))
 ;; Per-window contexts can differ for the same command. An action rechecks its
 ;; predicate even if a control has not yet been refreshed after a model change.
 (let* ((a (lut:make-widget 'lut:window)) (b (lut:make-widget 'lut:window))
        (ma (command-model)) (mb (command-model)) (command (make-test-command))
        (view (lut:add-child a (lut:make-widget 'lut:button)))
        (ba (lut:bind-command a command :widget view :context ma))
        (bb (lut:bind-command b command :context mb)))
   (setf (getf ma :allowed) nil)
   (lut:emit view :activate) (assert (zerop (getf ma :count)))
   (lut:dispatch b (lut:make-event :kind :key :key :f6)) (assert (= 1 (getf mb :count)))
   (lut:remove-child a view) (lut:refresh-commands a)
   (assert (not (lut:enabled-p view)))
   (lut:add-child a view) (setf (getf ma :allowed) t) (lut:refresh-commands a)
   (assert (lut:enabled-p view))
   (lut:dispose a) (assert (not (lut:command-binding-active-p ba)))
   (assert (lut:command-binding-active-p bb))
   (lut:dispatch b (lut:make-event :kind :key :key :f6)) (assert (= 2 (getf mb :count)))
   (lut:dispose b) (lut:dispose command))
 ;; Exact modifier specs distinguish Cmd/Super from Control despite legacy aliases.
 (let* ((root (lut:make-widget 'lut:window)) (model (command-model))
        (command (make-test-command '(:key :s :super t))))
   (lut:bind-command root command :context model)
   (lut:dispatch root (lut:make-event :kind :key :key :control-s :base-key :s :control-p t))
   (assert (zerop (getf model :count)))
   (lut:dispatch root (lut:make-event :kind :key :key :control-s :base-key :s :super-p t))
   (assert (= 1 (getf model :count)))
   (lut:dispatch root (lut:make-event :kind :key :key :control-shift-s :base-key :s :super-p t :shift-p t))
   (assert (= 1 (getf model :count)))
   (assert (handler-case (progn (setf (lut:command-shortcut command) '(:key :s :unknown t)) nil) (error () t)))
   (assert (equal (lut:command-shortcut command) '(:key :s :super t)))
   (lut:dispose root) (lut:dispose command))
 ;; Registration order resolves enabled shortcut collisions; a disabled action
 ;; does not consume the event, so the next registered command may handle it.
 (let* ((root (lut:make-widget 'lut:window)) (ma (command-model)) (mb (command-model))
        (a (make-test-command)) (b (make-test-command)))
   (setf (getf ma :allowed) nil)
   (lut:bind-command root a :context ma) (lut:bind-command root b :context mb)
   (lut:dispatch root (lut:make-event :kind :key :key :f6))
   (assert (zerop (getf ma :count))) (assert (= 1 (getf mb :count)))
   (setf (getf ma :allowed) t)
   (lut:dispatch root (lut:make-event :kind :key :key :f6))
   (assert (= 1 (getf ma :count))) (assert (= 1 (getf mb :count)))
   (lut:dispose root) (lut:dispose a) (lut:dispose b))
 ;; Failed construction rolls back connections and endpoint references.
 (let* ((root (lut:make-widget 'lut:window)) (view (lut:add-child root (lut:make-widget 'lut:button :text "Original")))
        (command (make-test-command)))
   (assert (handler-case
     (progn (lut:bind-command root command :widget view
               :context-function (lambda (w) (declare (ignore w)) (error "Expected context failure"))) nil)
     (error () t)))
   (assert (string= "Original" (lut:text view))) (assert (lut:enabled-p view))
   (assert (null (slot-value root 'lut::handlers)))
   (assert (null (slot-value root 'lut::command-links)))
   (assert (null (slot-value command 'lut::command-links)))
   (lut:dispose root) (lut:dispose command))
 ;; Even a failing custom setter cannot retain contexts or interrupt cleanup
 ;; of other bindings and children when the owning window is disposed.
 (let* ((root (lut:make-widget 'lut:window)) (model (command-model))
        (a (lut:add-child root (lut:make-widget 'command-restore-probe :text "Original")))
        (b (lut:add-child root (lut:make-widget 'lut:button)))
        (command (make-test-command))
        (ba (lut:bind-command root command :widget a :context model))
        (bb (lut:bind-command root command :widget b :context model)))
   (assert (handler-case (progn (lut:dispose root) nil) (error () t)))
   (assert (lut:disposed-p a)) (assert (lut:disposed-p b))
   (assert (not (lut:command-binding-active-p ba))) (assert (not (lut:command-binding-active-p bb)))
   (assert (null (slot-value ba 'lut::context)))
   (assert (null (slot-value command 'lut::command-links)))
   (assert (null (lut:children root)))
   (lut:dispose command))
 (format t "Command controls, contexts, predicates, shortcuts/modifiers, modal suppression, cleanup and registration rollback passed.~%"))
