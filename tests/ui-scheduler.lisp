(require :asdf)
(asdf:initialize-output-translations
 `(:output-translations (t (,(merge-pathnames "lut-scheduler-tests/" (uiop:temporary-directory)) :implementation :**/ :*.*.*)) :ignore-inherited-configuration))
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/raylib" :silent t)

;; Fake monotonic time makes earlier deadlines, coalescing and disposal exact.
(let* ((now 0) (wakes 0) (calls nil)
       (lut::*scheduler-clock* (lambda () now))
       (lut::*ui-timers* nil) (lut::*ui-services* nil)
       (lut::*ui-wake-function* (lambda () (incf wakes)))
       (owner (lut:make-widget 'lut:window)))
  (let ((late (lut:schedule-ui 10 (lambda () (push :late calls)) :owner owner))
        (repeat (lut:schedule-ui 2 (lambda () (push :repeat calls)) :owner owner :interval 2)))
    (assert (= 2 (lut::next-ui-delay)))
    (lut:schedule-ui 1 (lambda () (push :early calls)) :owner owner)
    (assert (= 1 (lut::next-ui-delay)))
    (setf now 1) (lut::run-ui-deadlines) (assert (equal calls '(:early)))
    (setf now 9) (lut::run-ui-deadlines) (assert (equal calls '(:repeat :early)))
    (assert (= 11 (lut::ui-timer-deadline repeat))) ; missed repeats coalesced
    (lut:cancel-ui-timer late) (lut:cancel-ui-timer repeat)
    (assert (null (lut::next-ui-delay)))
    (lut:schedule-ui 0 (lambda () (error "Disposed owner timer fired")) :owner owner)
    (lut:dispose owner)
    (lut::run-ui-deadlines)
    (assert (null lut::*ui-timers*))
    (assert (>= wakes 5)))
  (let* ((root (lut:make-widget 'lut:window))
         (passive (nth-value 1 (lut:on root :tick (lambda (w dt) (declare (ignore w dt))) :interval nil))))
    (assert (null (lut::legacy-tick-delay root)))
    (lut:on root :tick (lambda (w dt) (declare (ignore w dt))) :interval 0.2)
    (assert (= 0.2 (lut::legacy-tick-delay root)))
    (lut:disconnect passive) (lut:dispose root)))
(let* ((now 0) (lut::*scheduler-clock* (lambda () now))
       (root (lut:make-widget 'lut:window))
       (menu (lut:make-widget 'lut:context-menu)))
  (setf (slot-value root 'lut::overlays) (list menu)
        (slot-value menu 'lut::hover-pending) (list :item 0))
  (assert (< (abs (- (lut::context-menu-delay root) 0.2)) 0.00001))
  (setf now 1) (assert (zerop (lut::context-menu-delay root)))
  (setf (slot-value menu 'lut::hover-pending) nil)
  (assert (null (lut::context-menu-delay root)))
  (lut:dispose root))
(format t "PASS: monotonic deadlines, earlier insertion, cancellation, disposed owners, coalescing and explicit tick cadence.~%")

(when (uiop:getenv "LUT_SCHEDULER_NATIVE")
  (assert (lut:native-event-backend-p))
  (let* ((root (lut:make-widget 'lut:window :width 400 :height 180 :text "LUT wait/wake test"))
         (label (lut:add-child root (lut:make-widget 'lut:label :text "Waiting")))
         (ready (sb-thread:make-semaphore :count 0))
         (queue-delivered nil) (timer-delivered nil) (race-count 0)
         (ack (sb-thread:make-semaphore :count 0)) (failure nil) (posted 0) (latency nil) (turns 0)
         (thread (sb-thread:make-thread
          (lambda ()
            (unwind-protect
              (handler-case
                (progn
                  (sb-thread:wait-on-semaphore ready)
                  (sleep 0.1)
                  (setf posted (lut::scheduler-now))
                  (lut:enqueue-ui (lambda ()
                                    (setf queue-delivered t latency (- (lut::scheduler-now) posted)
                                          (lut:text label) "Queue woke native wait")) :owner root)
                  (sleep 0.1)
                  (lut:schedule-ui 0.02 (lambda () (setf timer-delivered t)) :owner root)
                  (sleep 0.1)
                  ;; Handshake repeatedly across the check-queue/enter-wait
                  ;; boundary; a lost native wake times out deterministically.
                  (dotimes (i 100)
                    (lut:enqueue-ui (lambda () (incf race-count) (sb-thread:signal-semaphore ack)) :owner root)
                    (unless (sb-thread:wait-on-semaphore ack :timeout 2)
                      (error "Lost native wake at publication ~D" i)))
                  (sleep 0.1))
                (error (condition) (setf failure condition)))
              (lut:stop))) :name "LUT native wait publisher")))
    (lut:on root :context-open
      (lambda (w event) (declare (ignore w event)) (sb-thread:signal-semaphore ready)))
    ;; A late timer must not hide the earlier deadline from the worker.
    (lut:schedule-ui 30 (lambda () (error "Late timer fired")) :owner root)
    (lut:on root :tick (lambda (w dt) (declare (ignore w dt)) (incf turns)) :interval nil)
    (unwind-protect
         (let ((lut::*signal-run-errors* t))
           (lut:run root)
           (assert (null failure)) (assert queue-delivered) (assert timer-delivered) (assert (= race-count 100))
           (assert (< latency 0.2)) (assert (< turns 400)))
      (sb-thread:signal-semaphore ready)
      (lut:stop) (sb-thread:join-thread thread) (lut:dispose root))
    (format t "PASS: 100 queue/wait races, earlier deadline wake and cross-thread sleeping shutdown; latency ~,4Fs, ~D turns.~%" latency turns)))

(when (uiop:getenv "LUT_SCHEDULER_NATIVE")
  (let* ((root (lut:make-widget 'lut:window :width 400 :height 180 :text "LUT pause/resume test" :initial-focus-p nil))
         (first t) (resumed nil) (ready (sb-thread:make-semaphore :count 0))
         (thread (sb-thread:make-thread
           (lambda () (sb-thread:wait-on-semaphore ready)
             (sleep 0.15) (rl:resume) (sleep 0.2) (lut:stop)))))
    (lut:on root :context-open (lambda (w e) (declare (ignore w e)) (sb-thread:signal-semaphore ready)))
    (lut:on root :tick (lambda (w dt) (declare (ignore w dt))
      (when first (setf first nil) (error "Expected pause-policy probe"))
      (setf resumed t) (lut:stop)) :interval nil)
    (unwind-protect (progn (lut:run root) (assert resumed))
      (sb-thread:signal-semaphore ready) (lut:stop) (sb-thread:join-thread thread) (lut:dispose root)))
  (format t "PASS: interactive error screen polls input and event-driven dispatch resumes correctly.~%"))
