(in-package #:lut-tests)
(defun same-buffer-text-p (&rest strings)
 (every (lambda (text) (string= (first strings) text)) (rest strings)))
(defclass short-buffer-view (lut:text-view) ())
(defmethod lut:validate-slot :before ((view short-buffer-view) slot value)
 (declare (ignore view))
 (when (and (eq slot 'lut:text) (> (length value) 6)) (error "Text is too long for this view")))
(defun text-buffer-tests ()
 (let* ((buffer (lut:make-text-buffer :text "abcdef"))
        (a (lut:make-widget 'lut:text-view :view-buffer buffer :cursor 2))
        (b (lut:make-widget 'lut:text-view :view-buffer buffer :cursor 5))
        (a-changes 0) (b-changes 0) (changes 0) (edits nil))
   (setf (slot-value a 'lut::anchor) 4 (slot-value b 'lut::anchor) 3
         (lut:text-offset a) 10 (lut:vertical-offset a) 20
         (lut:text-offset b) 30 (lut:vertical-offset b) 40)
   (lut:on buffer :edit (lambda (w edit)
     (assert (same-buffer-text-p (lut:text w) (lut:text a) (lut:text b)))
     (push edit edits)))
   (lut:on buffer :change (lambda (w p) (declare (ignore w p)) (incf changes)))
   (lut:on a :change (lambda (w p) (declare (ignore w p)) (incf a-changes)))
   (lut:on b :change (lambda (w p) (declare (ignore w p)) (incf b-changes)))
   (lut:replace-selection a "XYQ")
   (assert (same-buffer-text-p "abXYQef" (lut:text buffer) (lut:text a) (lut:text b)))
   (assert (= 5 (lut:cursor a) (slot-value a 'lut::anchor)))
   (assert (= 6 (lut:cursor b))) (assert (= 5 (slot-value b 'lut::anchor)))
   (assert (= 10 (lut:text-offset a))) (assert (= 20 (lut:vertical-offset a)))
   (assert (= 30 (lut:text-offset b))) (assert (= 40 (lut:vertical-offset b)))
   (assert (= 1 changes a-changes b-changes (lut:buffer-revision buffer)))
   (let ((edit (first edits)))
     (assert (= 2 (lut:edit-start edit))) (assert (= 4 (lut:edit-old-end edit)))
     (assert (= 5 (lut:edit-new-end edit))) (assert (= 1 (lut:edit-revision edit)))
     (assert (eq a (lut:edit-origin edit))))
   (assert (lut:can-undo-p a)) (assert (lut:can-undo-p b))
   (assert (lut:undo a))
   (assert (same-buffer-text-p "abcdef" (lut:text buffer) (lut:text b)))
   (assert (= 2 (lut:cursor a))) (assert (= 4 (slot-value a 'lut::anchor)))
   (assert (lut:can-redo-p b)) (assert (lut:redo b))
   (assert (same-buffer-text-p "abXYQef" (lut:text a)))
   (assert (= 5 (lut:cursor b) (slot-value b 'lut::anchor)))
   (assert (= 3 changes a-changes b-changes (lut:buffer-revision buffer)))
   (lut:replace-selection b "!")
   (assert (not (lut:can-redo-p a)))
   ;; History contains only changed substrings and numeric selections, not views.
   (dolist (entry (lut::undo-history buffer))
     (assert (stringp (lut::buffer-history-entry-removed entry)))
     (assert (stringp (lut::buffer-history-entry-inserted entry)))
     (assert (every (lambda (v) (or (null v) (integerp v)))
               (list (lut::buffer-history-entry-before-cursor entry) (lut::buffer-history-entry-before-anchor entry)
                     (lut::buffer-history-entry-after-cursor entry) (lut::buffer-history-entry-after-anchor entry)))))
   (lut:dispose a) (lut:dispose b) (assert (null (lut::buffer-views buffer))) (lut:dispose buffer))
 ;; Insertions use right affinity; range and whole-text edits keep all positions valid.
 (let* ((buffer (lut:make-text-buffer :text "abc"))
        (view (lut:make-widget 'lut:text-view :view-buffer buffer :cursor 0)))
   (lut:replace-buffer-range buffer 0 0 "X") (assert (= 1 (lut:cursor view)))
   (setf (lut:text view) "Xa!")
   (assert (same-buffer-text-p "Xa!" (lut:text buffer)))
   (let ((revision (lut:buffer-revision buffer)))
     (assert (null (lut:replace-buffer-range buffer 0 1 "X")))
     (assert (= revision (lut:buffer-revision buffer))))
   (setf (lut:text buffer) "")
   (assert (zerop (lut:cursor view))) (assert (zerop (slot-value view 'lut::anchor)))
   (lut:dispose view) (lut:dispose buffer))
 ;; Shared model ownership and range indices are character based, including Unicode.
 (let* ((source (copy-seq "αβγ")) (buffer (lut:make-widget 'lut:text-buffer :text source)))
   (setf (char source 0) #\Z)
   (assert (same-buffer-text-p "αβγ" (lut:text buffer)))
   (lut:replace-buffer-range buffer 1 2 "λμ")
   (assert (same-buffer-text-p "αλμγ" (lut:text buffer)))
   (lut:dispose buffer))
 ;; A view can be rebound or detached without changing either model.
 (let* ((a (lut:make-text-buffer :text "shared")) (b (lut:make-text-buffer :text "new"))
        (view (lut:make-widget 'lut:text-view :text "local")))
   (lut:select-all view) (lut:replace-selection view "edited") (assert (lut:can-undo-p view))
   (setf (lut:view-buffer view) a)
   (assert (same-buffer-text-p "shared" (lut:text view))) (assert (null (lut::undo-history view)))
   (setf (lut:view-buffer view) b)
   (assert (null (lut::buffer-views a))) (assert (same-buffer-text-p "new" (lut:text view)))
   (assert (<= (lut:cursor view) 3))
   (setf (lut:view-buffer view) nil)
   (lut:select-all view) (lut:replace-selection view "standalone")
   (assert (same-buffer-text-p "new" (lut:text b)))
   (setf (lut:view-buffer view) a)
   (lut:dispose a)
   (assert (null (lut:view-buffer view))) (assert (same-buffer-text-p "shared" (lut:text view)))
   (assert (lut:read-only-p view))
   (assert (handler-case (progn (setf (lut:view-buffer view) a) nil) (error () t)))
   (lut:dispose view) (lut:dispose b))
 ;; Initial buffer contents take precedence over :TEXT, including cursor validation.
 (let* ((buffer (lut:make-text-buffer :text "shared"))
        (view (lut:make-widget 'lut:entry :text "" :view-buffer buffer :cursor 4)))
   (assert (= 4 (lut:cursor view))) (assert (same-buffer-text-p "shared" (lut:text view)))
   (lut:dispose view) (assert (not (lut:disposed-p buffer))) (lut:dispose buffer))
 ;; Shared history is bounded at the model, independently of each view's local limits.
 (let* ((buffer (lut:make-text-buffer :text "a" :history-limit 1 :history-character-limit 10))
        (view (lut:make-widget 'lut:text-view :view-buffer buffer :history-limit 0)))
   (setf (lut:text view) "ab" (lut:text view) "abc")
   (assert (= 1 (length (lut::undo-history buffer))))
   (assert (lut:undo view)) (assert (same-buffer-text-p "ab" (lut:text buffer)))
   (assert (not (lut:can-undo-p buffer)))
   (setf (lut:history-character-limit buffer) 1 (lut:text buffer) "long text")
   (assert (not (lut:can-undo-p buffer)))
   (lut:dispose view) (lut:dispose buffer))
 ;; Shared updates preserve per-view text validation without partial edits.
 (let* ((buffer (lut:make-text-buffer :text "abc"))
        (view (lut:make-widget 'short-buffer-view :view-buffer buffer))
        (long (lut:make-text-buffer :text "too long")))
   (assert (handler-case (progn (lut:replace-buffer-range buffer 0 0 "long") nil) (error () t)))
   (assert (same-buffer-text-p "abc" (lut:text buffer)))
   (assert (zerop (lut:buffer-revision buffer))) (assert (not (lut:can-undo-p buffer)))
   (assert (handler-case (progn (setf (lut:view-buffer view) long) nil) (error () t)))
   (assert (eq buffer (lut:view-buffer view)))
   (assert (equal (lut::buffer-views buffer) (list view)))
   (assert (null (lut::buffer-views long)))
   (lut:dispose view) (lut:dispose buffer) (lut:dispose long))
 ;; Rejected undo must preserve both shared stacks and the content revision.
 (let* ((buffer (lut:make-text-buffer :text "long initial text")))
   (setf (lut:text buffer) "short")
   (let ((view (lut:make-widget 'short-buffer-view :view-buffer buffer)))
     (assert (handler-case (progn (lut:undo view) nil) (error () t)))
     (assert (same-buffer-text-p "short" (lut:text buffer)))
     (assert (= 1 (lut:buffer-revision buffer) (length (lut::undo-history buffer))))
     (assert (null (lut::redo-history buffer)))
     (setf (lut:view-buffer view) nil)
     (assert (lut:undo buffer)) (assert (same-buffer-text-p "long initial text" (lut:text buffer)))
     (lut:dispose view))
   (lut:dispose buffer))
 (large-buffer-history-tests)
 (text-buffer-read-only-tests)
 (text-buffer-error-tests)
 (format t "Shared buffer range edits, view positions, history, notifications, read-only policy, rebinding and disposal passed.~%"))
(defun text-buffer-read-only-tests ()
 (let* ((root (lut:make-widget 'lut:window))
        (buffer (lut:make-text-buffer :text "abc"))
        (a (lut:add-child root (lut:make-widget 'lut:text-view :view-buffer buffer :read-only-p t)))
        (b (lut:add-child root (lut:make-widget 'lut:text-view :view-buffer buffer))))
   (lut:layout root 0 0 400 300) (lut:focus root a) (lut:select-all a)
   (dolist (key '(:backspace :delete :cut :paste :undo :redo :enter))
     (lut:dispatch root (lut:make-event :kind :key :key key)))
   (lut:dispatch root (lut:make-event :kind :text :text "blocked"))
   (assert (same-buffer-text-p "abc" (lut:text buffer)))
   (multiple-value-bind (start end) (lut:selection a) (assert (zerop start)) (assert (= 3 end)))
   (lut:dispatch root (lut:make-event :kind :key :key :copy))
   (assert (same-buffer-text-p "abc" (lut:clipboard-text a)))
   (let ((menu (lut:open-context-menu root a (lut:make-event :kind :context :x 10 :y 10))))
     (assert (not (lut:enabled-p (first (lut:children menu)))))
     (assert (lut:enabled-p (second (lut:children menu))))
     (assert (not (lut:enabled-p (third (lut:children menu)))))
     (lut:dismiss-dialog menu) (lut:dispose menu))
   (lut:select-all b) (lut:replace-selection b "def")
   (assert (same-buffer-text-p "def" (lut:text a)))
   (setf (lut:read-only-p buffer) t)
   (assert (not (lut:editable-p b))) (assert (not (lut:undo b)))
   (assert (null (lut:replace-buffer-range buffer 0 1 "Z")))
   ;; Programmatic content refresh remains possible for read-only displays.
   (setf (lut:text a) "refreshed") (assert (same-buffer-text-p "refreshed" (lut:text buffer) (lut:text b)))
   (lut:dispose root) (assert (null (lut::buffer-views buffer))) (lut:dispose buffer))
 ;; The same read-only editing rules apply to standalone entries.
 (let ((view (lut:make-widget 'lut:entry :text "local" :read-only-p t)))
   (lut:select-all view) (assert (null (lut:replace-selection view "blocked")))
   (assert (same-buffer-text-p "local" (lut:text view))) (lut:dispose view)))
(defun text-buffer-error-tests ()
 (let* ((buffer (lut:make-text-buffer :text "abc"))
        (a (lut:make-widget 'lut:text-view :view-buffer buffer))
        (b (lut:make-widget 'lut:text-view :view-buffer buffer))
        (foreign (lut:make-widget 'lut:text-view)))
   (dolist (range '((-1 0) (2 1) (0 10)))
     (assert (handler-case
       (progn (lut:replace-buffer-range buffer (first range) (second range) "bad") nil) (error () t))))
   (assert (handler-case (progn (lut:replace-buffer-range buffer 0 1 "bad" :origin foreign) nil) (error () t)))
   (assert (zerop (lut:buffer-revision buffer))) (assert (not (lut:can-undo-p buffer)))
   (let ((connection (nth-value 1 (lut:on buffer :change (lambda (w text)
                         (declare (ignore text)) (setf (lut:text w) "recursive"))))))
     (assert (handler-case (progn (lut:replace-buffer-range buffer 0 1 "X") nil) (error () t)))
     (assert (same-buffer-text-p "Xbc" (lut:text buffer) (lut:text a) (lut:text b)))
     (assert (= 1 (lut:buffer-revision buffer)))
     (lut:disconnect connection)
     (assert (lut:undo buffer)) (assert (same-buffer-text-p "abc" (lut:text a))))
   ;; A callback can destroy a peer without stale notifications or references.
   (lut:on a :change (lambda (w text) (declare (ignore w text)) (lut:dispose b)))
   (lut:replace-buffer-range buffer 0 0 "!")
   (assert (lut:disposed-p b)) (assert (equal (lut::buffer-views buffer) (list a)))
   (lut:dispose a) (lut:dispose foreign) (lut:dispose buffer)))

(defun large-buffer-history-tests ()
 ;; Default history must depend on edit size, not the size of the source file.
 (let* ((original (make-string (* 1024 1024) :initial-element #\a))
        (middle (floor (length original) 2))
        (buffer (lut:make-text-buffer :text original))
        (a (lut:make-widget 'lut:text-view :view-buffer buffer))
        (b (lut:make-widget 'lut:text-view :view-buffer buffer))
        (inserted "ABCDEFGHIJKL"))
   (assert (> (length original) (lut:history-character-limit buffer)))
   (dotimes (i (length inserted))
     (lut:replace-buffer-range buffer (+ middle i) (+ middle i) (string (char inserted i)) :origin a))
   (assert (= 12 (length (lut::undo-history buffer))))
   (assert (= 12 (reduce #'+ (lut::undo-history buffer) :key #'lut::buffer-history-characters)))
   (assert (lut:can-undo-p a)) (assert (lut:can-undo-p b))
   (dotimes (i 12) (assert (lut:undo (if (evenp i) a b))))
   (assert (same-buffer-text-p original (lut:text buffer) (lut:text a) (lut:text b)))
   (assert (not (lut:can-undo-p buffer)))
   (assert (= 12 (length (lut::redo-history buffer))))
   (dotimes (i 12) (assert (lut:redo (if (evenp i) b a))))
   (assert (same-buffer-text-p
     (concatenate 'string (subseq original 0 middle) inserted (subseq original middle))
     (lut:text buffer) (lut:text a) (lut:text b)))
   (assert (= 36 (lut:buffer-revision buffer)))
   (lut:dispose a) (lut:dispose b) (lut:dispose buffer))
 ;; The character budget counts removed+inserted payload, retaining a contiguous
 ;; newest prefix. It must not skip an oversized edit and expose invalid older undo.
 (let ((buffer (lut:make-text-buffer :text (make-string 300000 :initial-element #\a)
                                      :history-limit 10 :history-character-limit 4)))
   (dotimes (i 6) (lut:replace-buffer-range buffer 0 0 "x"))
   (assert (= 4 (length (lut::undo-history buffer))))
   (loop repeat 4 do (assert (lut:undo buffer)))
   (assert (= 300002 (length (lut:text buffer))))
   (assert (not (lut:can-undo-p buffer)))
   (lut:replace-buffer-range buffer 0 5 "replacement")
   (assert (not (lut:can-undo-p buffer))) (assert (not (lut:can-redo-p buffer)))
   (lut:dispose buffer))
 ;; Repeated characters must replay the exact stored range, not rediscover a
 ;; different equivalent difference that would remap a peer's caret incorrectly.
 (let* ((buffer (lut:make-text-buffer :text "aaaa"))
        (view (lut:make-widget 'lut:text-view :view-buffer buffer :cursor 2)))
   (setf (slot-value view 'lut::anchor) 2)
   (lut:replace-buffer-range buffer 1 1 "a")
   (assert (= 3 (lut:cursor view)))
   (assert (lut:undo buffer)) (assert (= 2 (lut:cursor view)))
   (assert (lut:redo buffer)) (assert (= 3 (lut:cursor view)))
   (lut:dispose view) (lut:dispose buffer))
 (format t "Range history retains 12 undo/redo steps in a 1 Mi-character buffer; payload budgets and exact replay passed.~%"))
