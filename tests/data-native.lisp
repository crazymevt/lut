(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(asdf:load-system "lut/examples")
(defun capture-data-views (root path)
 (let ((target (rl:load-render-texture (round (lut:width root)) (round (lut:height root)))))
   (unwind-protect
       (progn
         (rl:with-texture-mode (target) (rl:clear-background (lut:style-value root :background)) (lut::render-window root))
         (let ((image (rl:load-image-from-texture (rl:render-texture-texture target))))
           (unwind-protect (progn (rl:image-flip-vertical image) (assert (rl:export-image image path))) (rl:unload-image image))))
     (rl:unload-render-texture target))))
(dolist (theme (list lut:*light-theme* lut:*dark-theme*))
 (let* ((root (lut-examples:data-models)) (frame 0) (checked nil) (labels 0)
        (list (lut:find-widget root :lazy-data)) (tree (lut:find-widget root :tree-data))
        (table (lut:find-widget root :table-data)) (name (if (eq theme lut:*light-theme*) "light" "dark")))
   (setf (lut:theme root) theme
         (lut:row-label-function list) (lambda (item) (incf labels) item))
   (lut:on root :tick (lambda (w dt)
     (declare (ignore w dt))
     (case (incf frame)
       (2
        (lut:focus root list)
        (lut:dispatch root (lut:make-event :kind :key :key :end))
        (lut:dispatch root (lut:make-event :kind :key :key :up :shift-p t))
        (assert (= 2 (length (lut:selected-keys (lut:view-selection list)))))
        (assert (> (lut:scroll-offset list) 1000000))
        (lut:focus root tree)
        (lut:dispatch root (lut:make-event :kind :key :key :home))
        (lut:dispatch root (lut:make-event :kind :key :key :left))
        (assert (= 1 (lut:model-count (lut:view-model tree))))
        (lut:dispatch root (lut:make-event :kind :key :key :right))
        (assert (= 4 (lut:model-count (lut:view-model tree))))
        (let ((px (+ (lut:x table) (/ (lut:width table) 3) 12))
              (py (+ (lut:y table) (lut:row-height table) 10)))
          (lut:dispatch root (lut:make-event :kind :down :x px :y py))
          (lut:dispatch root (lut:make-event :kind :up :x px :y py)))
        (assert (= 1 (lut:active-column table)))
        (lut:dispatch root (lut:make-event :kind :key :key :enter))
        (assert (lut:cell-editor table))
        (lut:dispatch root (lut:make-event :kind :text :text "Native commit"))
        (lut:dispatch root (lut:make-event :kind :key :key :enter))
        (assert (null (lut:cell-editor table)))
        (assert (string= "Native commit" (getf (lut:cell-presentation table 0 1) :text))))
       (3
        (lut:dispatch root (lut:make-event :kind :move :x (+ (lut:x list) 12) :y (+ (lut:y list) 5)))
        (assert (= (lut:visible-model-range list) (lut::hovered-row list)))
        (lut:dispatch root (lut:make-event :kind :move :x (+ (lut:x tree) 12) :y (+ (lut:y tree) (lut:row-height tree) 5)))
        (assert (= 1 (lut::hovered-row tree)))
        (lut:dispatch root (lut:make-event :kind :move :x (+ (lut:x table) 12) :y (+ (lut:y table) 5)))
        (assert (null (lut::hovered-row table)))
        (lut:dispatch root (lut:make-event :kind :move :x (+ (lut:x table) 12) :y (+ (lut:y table) (* 2 (lut:row-height table)) 5)))
        (assert (= 1 (lut::hovered-row table)))
        (setf labels 0)
        (capture-data-views root (format nil "/tmp/lut-data-~a.png" name))
        (assert (< 0 labels 30))
        (lut:begin-cell-edit table)
        (assert (= 1 (length (lut:children table)))))
       (4
        (capture-data-views root (format nil "/tmp/lut-data-~a-editor.png" name))
        (lut:dispatch root (lut:make-event :kind :key :key :escape))
        (assert (null (lut:cell-editor table))) (setf checked t)))))
   (unwind-protect (progn (lut:run root :frames 5) (assert checked)) (lut:dispose root))))
(format t "Native million-row virtualization, range selection, tree expansion and table commit/cancel passed in light/dark themes; /tmp/lut-data-*.png.~%")
