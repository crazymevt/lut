(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/raylib" :silent t)
#+darwin
(let* ((lut:*default-application-command* :auto)
       (capabilities (lut:default-application-capabilities))
       (missing (merge-pathnames (format nil "~a.absent" (gensym "lut-missing-launch-")) (uiop:temporary-directory))))
 (assert (getf capabilities :available-p))
 (assert (eq :macos-open (getf capabilities :backend)))
 (assert (not (probe-file missing)))
 ;; Exercise the actual native helper's argv/error route without opening an app.
 (assert (handler-case (progn (lut::launch-application-target (namestring missing)) nil)
           (lut:target-launch-error (condition)
             (and (eq :nonzero-exit (lut:launch-error-reason condition))
                  (search "does not exist" (lut:launch-error-detail condition)))))))
;; Packet generation guards are deterministic and do not require a native context.
(let ((window (lut:make-widget 'lut:window)))
 (setf (lut::native-operation-generation window) 4)
 (lut:set-normal-window-size window 500 400)
 (assert (not (lut::accept-native-window-report window '(3 :normal 100 100))))
 (assert (equal '(500 400) (multiple-value-list (lut:normal-window-size window))))
 (assert (lut::accept-native-window-report window '(4 :maximized 500 400)))
 (assert (not (lut::accept-native-window-report window '(5 :normal -1 20))))
 (lut:dispose window))
(dolist (scale '(1 5/4 2))
 (let* ((root (lut:make-widget 'lut:window :text "Native application adapter check" :width 300 :height 200 :ui-scale scale))
        (peer (lut:make-widget 'lut:window :text "Native worker state check" :width 280 :height 200 :ui-scale scale))
        (remote nil) (primary-stage :start) (worker-stage :start) (ticks 0) (restoring-at 0) (worker-restoring-at 0) (checked nil))
   ;; Legacy pre-open setters must control both actual native opening paths.
   (setf (lut:width root) 420 (lut:height root) 300
         (lut:width peer) 360 (lut:height peer) 260)
   (lut:on root :tick (lambda (window dt)
     (declare (ignore dt)) (incf ticks)
     (case primary-stage
       (:start
         (assert (eq :normal (lut:window-state window)))
         (assert (< (abs (- (/ (rl:get-screen-width) scale) 420)) 2))
         (assert (< (abs (- (/ (rl:get-screen-height) scale) 300)) 2))
         (let ((normal (multiple-value-list (lut:normal-window-size window))))
           (lut:layout window 0 0 999 777)
           (assert (equal normal (multiple-value-list (lut:normal-window-size window)))))
         (setf remote (lut:spawn-window peer))
         (lut:set-window-state window :maximized) (setf primary-stage :maximizing))
       (:maximizing
         (when (and (eq :maximized (lut:window-state window))
                    (> (/ (rl:get-screen-width) (lut:ui-scale window)) 450)
                    (> (/ (rl:get-screen-height) (lut:ui-scale window)) 330))
           (assert (<= (nth-value 0 (lut:normal-window-size window)) 421))
           (lut:set-normal-window-size window 430 310)
           (lut:set-window-state window :normal)
           (setf primary-stage :restoring restoring-at ticks)))
       (:restoring
         (when (and (eq :normal (lut:window-state window)) (> (- ticks restoring-at) 6))
           (multiple-value-bind (width height) (lut:normal-window-size window)
             (assert (< (abs (- width 430)) 2)) (assert (< (abs (- height 310)) 2)))
           (assert (< (abs (- (lut:width window) 430)) 2))
           (assert (< (abs (- (lut:height window) 310)) 2))
           (setf primary-stage :done))))
     (case worker-stage
       (:start
         (when (and remote (> (lut::remote-window-frames remote) 2) (eq :normal (lut:window-state peer)))
           (assert (< (abs (- (lut:width peer) 360)) 2))
           (assert (< (abs (- (lut:height peer) 260)) 2))
           (assert (< (abs (- (nth-value 0 (lut:normal-window-size peer)) 360)) 2))
           (assert (< (abs (- (nth-value 1 (lut:normal-window-size peer)) 260)) 2))
           (lut:set-window-state peer :maximized) (setf worker-stage :maximizing)))
       (:maximizing
         (when (and (eq :maximized (lut:window-state peer))
                    (> (lut:width peer) 380) (> (lut:height peer) 280))
           (assert (<= (nth-value 0 (lut:normal-window-size peer)) 361))
           (lut:set-normal-window-size peer 390 270)
           (lut:set-window-state peer :normal)
           (setf worker-stage :restoring worker-restoring-at (lut::remote-window-frames remote))))
       (:restoring
         (when (and (eq :normal (lut:window-state peer))
                    (> (- (lut::remote-window-frames remote) worker-restoring-at) 6))
           (multiple-value-bind (width height) (lut:normal-window-size peer)
             (assert (< (abs (- width 390)) 2)) (assert (< (abs (- height 270)) 2)))
           (assert (< (abs (- (lut:width peer) 390)) 2))
           (assert (< (abs (- (lut:height peer) 270)) 2))
           (setf worker-stage :done))))
     (when (and (eq primary-stage :done) (eq worker-stage :done))
       (setf checked t) (lut:stop))
     (when (= ticks 220)
       (error "Native state timeout: primary ~s/~s, worker ~s/~s, worker error ~a"
         primary-stage (lut:window-state window) worker-stage (lut:window-state peer)
         (and remote (lut::remote-window-error remote))))))
   (unwind-protect (progn (lut:run root :frames 225) (assert checked))
     (lut:dispose root) (unless (lut:disposed-p peer) (lut:dispose peer)))))
(format t "Native primary/worker maximize, restore, normal-size isolation, scale conversion and stale IPC rejection passed at 100/125/200%.~%")
