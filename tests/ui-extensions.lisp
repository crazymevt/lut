(in-package #:lut-tests)
(defun ui-extension-tests ()
  ;; Resize handles capture outside bounds and release on detach/modal changes.
  (let* ((root (lut:make-widget 'lut:window :width 400 :height 200))
         (handle (lut:add-child root (lut:make-widget 'lut:resize-handle :x 50 :y 0 :width 8 :height 200)))
         (movement nil) (ended 0))
    (unwind-protect
         (progn
           (lut:on handle :resize (lambda (w payload) (declare (ignore w)) (setf movement payload)))
           (lut:on handle :resize-end (lambda (w payload) (declare (ignore w payload)) (incf ended)))
           (lut:dispatch root (lut:make-event :kind :down :x 54 :y 30))
           (assert (lut:pointer-captured-p handle))
           (lut:dispatch root (lut:make-event :kind :move :x 350 :y 250))
           (assert (= 296 (getf movement :dx)))
           (lut:dispatch root (lut:make-event :kind :up :x 350 :y 250))
           (assert (= 1 ended)) (assert (not (lut:pointer-captured-p handle)))
           (lut:capture-pointer handle)
           (lut:remove-child root handle)
           (assert (not (lut:pointer-captured-p handle)))
           (lut:add-child root handle) (lut:capture-pointer handle)
           (let ((dialog (lut:make-widget 'lut:popover)))
             (lut:show-dialog root dialog)
             (assert (not (lut:pointer-captured-p handle)))
             (lut:dismiss-dialog dialog) (lut:dispose dialog)))
      (lut:dispose root)))
  ;; Selection changes do not activate rows; completed clicks and Enter do.
  (let* ((root (lut:make-widget 'lut:window :width 300 :height 200))
         (view (lut:add-child root (lut:make-widget 'lut:list-view :width 200 :height 100 :items '("a" "b"))))
         (activated nil))
    (unwind-protect
         (progn
           (lut:on view :activate (lambda (w row) (declare (ignore w)) (push row activated)))
           (lut:focus root view)
           (lut:dispatch root (lut:make-event :kind :key :key :up))
           (assert (null activated))
           (lut:dispatch root (lut:make-event :kind :key :key :enter))
           (assert (equal activated '(0)))
           (lut:dispatch root (lut:make-event :kind :down :x 20 :y 40))
           (lut:dispatch root (lut:make-event :kind :up :x 250 :y 150))
           (assert (equal activated '(0)))
           (lut:dispatch root (lut:make-event :kind :down :x 20 :y 40))
           (lut:dispatch root (lut:make-event :kind :up :x 20 :y 40))
           (assert (equal activated '(1 0))))
      (lut:dispose root)))
  (let* ((root (lut:make-widget 'lut:window :width 400 :height 200))
         (book (lut:add-child root (lut:make-widget 'lut:notebook :width 400 :height 200 :closable-p t
                                                   :reorderable-p t :tab-group :test :items '("One"))))
         (page (lut:add-child book (lut:make-widget 'lut:box))) (calls 0)
         (action (lut:make-notebook-action :label "Action" :function (lambda (b p) (declare (ignore b p)) (incf calls)))))
    (unwind-protect
         (progn
           (setf (lut:page-action book page) action)
           (lut:layout root 0 0 400 200)
           (destructuring-bind (x y w h) (lut:tab-action-rectangle book 0)
             (let ((cx (+ x (/ w 2))) (cy (+ y (/ h 2))))
               (assert (null (lut:drag-data book (lut:make-event :kind :down :x cx :y cy))))
               (lut:dispatch root (lut:make-event :kind :move :x cx :y cy))
               (assert (string= "Action" (lut:tooltip-text book)))
               (lut:dispatch root (lut:make-event :kind :down :x cx :y cy))
               (lut:dispatch root (lut:make-event :kind :up :x cx :y (+ cy 50)))
               (assert (zerop calls))
               (dolist (kind '(:down :up)) (lut:dispatch root (lut:make-event :kind kind :x cx :y cy)))
               (assert (= 1 calls))
               (setf (lut:notebook-action-enabled-p action) nil)
               (dolist (kind '(:down :up)) (lut:dispatch root (lut:make-event :kind kind :x cx :y cy)))
               (assert (= 1 calls))))
           (let ((other (lut:add-child root (lut:make-widget 'lut:notebook :reorderable-p t :tab-group :test))))
             (lut:move-page book page other 0)
             (assert (eq action (lut:page-action other page)))
             (assert (null (lut:page-action book page)))))
      (lut:dispose root)))
  (let ((view (lut:make-widget 'lut:styled-text-view :text "one long line" :width 100 :height 100
                              :style '(:font-size 18 :line-height 30 :caret-height :font :focus-outline-p nil))))
    (unwind-protect
         (progn
           (assert (= 18 (nth-value 3 (lut:text-caret-rectangle view))))
           (assert (= 30 (nth-value 3 (lut:text-position-rectangle view 0))))
           (lut:scroll-geometry view :horizontal)
           (let ((cache (slot-value view 'lut::horizontal-extent-cache)) (key (lut:text-metric-key view)))
             (setf (lut:width view) 70)
             (lut:set-text-presentation view :runs '((:start 0 :end 3 :style (:foreground (255 0 0 255))))
                                       :reveal-cursor-p nil)
             (lut:scroll-geometry view :horizontal)
             (assert (eq cache (slot-value view 'lut::horizontal-extent-cache)))
             (assert (equal key (lut:text-metric-key view)))
             (lut:set-text-presentation view :runs '((:start 0 :end 3 :style (:font-size 24))))
             (lut:scroll-geometry view :horizontal)
             (assert (not (eq cache (slot-value view 'lut::horizontal-extent-cache)))))
           (let ((cache (slot-value view 'lut::horizontal-extent-cache)))
             (setf (lut:text view) "different")
             (lut:scroll-geometry view :horizontal)
             (assert (not (eq cache (slot-value view 'lut::horizontal-extent-cache))))))
      (lut:dispose view)))
  (format t "Public resize/capture, tab actions, list activation, caret geometry and text caching passed.~%"))
