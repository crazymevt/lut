(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload '("lut" "lut/gtk-demo") :silent t)
(asdf:test-system "lut")
(asdf:test-system "lut/gtk-demo-tests")
(ql:quickload "lut/gc-tests" :silent t)
(asdf:test-system "lut/gc-tests")
(ql:quickload "lut/gtk-demo-gc-tests" :silent t)
(asdf:test-system "lut/gtk-demo-gc-tests")
(ql:quickload "lut/docs" :silent t)
(lut-docs:generate)
(format t "Portable suites and generated docset passed on ~a ~a.~%" (lisp-implementation-type) (lisp-implementation-version))
