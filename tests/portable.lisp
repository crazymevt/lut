(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lui.asd"))
(ql:quickload '("lui" "lui/gtk-demo") :silent t)
(asdf:test-system "lui")
(asdf:test-system "lui/gtk-demo-tests")
(ql:quickload "lui/gc-tests" :silent t)
(asdf:test-system "lui/gc-tests")
(ql:quickload "lui/gtk-demo-gc-tests" :silent t)
(asdf:test-system "lui/gtk-demo-gc-tests")
(ql:quickload "lui/docs" :silent t)
(lui-docs:generate)
(format t "Portable suites and generated docset passed on ~a ~a.~%" (lisp-implementation-type) (lisp-implementation-version))
