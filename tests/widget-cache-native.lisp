(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/raylib" :silent t)
(defclass cache-scene (lut:widget) ())
(defmethod lut:layout :after ((w cache-scene) x y width height)
 (declare (ignore width height))
 (loop for child in (lut:children w) for rect in '((20 20 160 36) (350 20 140 36) (20 90 210 60) (350 270 140 60))
       do (lut:layout child (+ x (first rect)) (+ y (second rect)) (third rect) (fourth rect))))
(defun cache-image (root cached)
 (let ((target (rl:load-render-texture (round (* (lut:width root) (lut:ui-scale root)))
                                       (round (* (lut:height root) (lut:ui-scale root))))))
   (unwind-protect
     (progn
       (rl:with-texture-mode (target)
         (rl:clear-background (lut:style-value root :background))
         ;; Match opaque framebuffer coverage when capturing into an RGBA texture:
         ;; RGB blends normally; alpha accumulates with ONE, not SRC_ALPHA.
         (cffi:foreign-funcall "rlSetBlendFactorsSeparate"
           :int #x0302 :int #x0303 :int 1 :int #x0303 :int #x8006 :int #x8006 :void)
         (let ((lut::*composite-window-cache* (and cached (lut::render-identity root)))
               (lut::*render-cache-painting* t))
           (rl:with-blend-mode (:custom-separate) (lut::render-window root))))
       (let ((image (rl:load-image-from-texture (rl:render-texture-texture target))))
         (rl:image-flip-vertical image) image))
     (rl:unload-render-texture target))))
(defun assert-cache-parity (root name)
 (lut::prepare-window-cache root :pixel-scale 1)
 (let ((direct (cache-image root nil)) (cached (cache-image root t)))
   (unwind-protect
     (let ((different 0) (max-delta 0))
       ;; Compare borrowed native pixels directly, without allocating millions of conses.
       (dotimes (i (* 4 (rl:image-width direct) (rl:image-height direct)))
         (let ((delta (abs (- (cffi:mem-aref (rl:image-data direct) :unsigned-char i)
                              (cffi:mem-aref (rl:image-data cached) :unsigned-char i)))))
           (unless (zerop delta) (incf different)) (setf max-delta (max max-delta delta))))
       (format t "~a: ~d differing channels, maximum delta ~d.~%" name different max-delta)
       ;; An extra transparent 8-bit target introduces at most one rounding level.
       ;; Opaque retained controls must remain byte-for-byte identical.
       (unless (if (eq name :transparent-custom-drawing) (<= max-delta 1) (zerop different))
         (rl:export-image direct "/tmp/lut-cache-direct.png") (rl:export-image cached "/tmp/lut-cache-retained.png")
         (error "Cached rendering differs from direct rendering: ~a" name)))
     (rl:unload-image direct) (rl:unload-image cached))))
(loop for scale in '(1 1.25 2) do
 (let* ((root (lut:make-widget 'lut:window :width (* 520 scale) :height (* 400 scale) :ui-scale scale :content-layout :fill :style '(:padding 0)))
        (scene (lut:add-child root (lut:make-widget 'cache-scene :cache-mode :retained)))
        (label (lut:add-child scene (lut:make-widget 'lut:label :text "Unchanged" :style '(:padding 8))))
        (button (lut:add-child scene (lut:make-widget 'lut:button :text "Press me")))
        (entry (lut:add-child scene (lut:make-widget 'lut:styled-text-view :text "Styled text" :style '(:padding 8))))
        (area (lut:add-child scene (lut:make-widget 'lut:drawing-area)))
        (frame 0) (draws 0))
   (lut:on root :tick
     (lambda (w dt)
       (declare (ignore dt))
       (case (incf frame)
         (3
          (lut::prepare-window-cache w :pixel-scale 1)
          (lut::prepare-window-cache w :pixel-scale 1)
          (assert (zerop (getf (lut:window-cache-statistics w) :last-repaints)))
          (setf (lut:text label) "Changed")
          (lut::prepare-window-cache w :pixel-scale 1)
          (let ((stats (lut:window-cache-statistics w)))
            (assert (< 0 (getf stats :last-repaints) (getf stats :tiles))))
          (assert-cache-parity w :changed-text)
          (lut:focus w entry) (setf (lut:cursor entry) 6 (lut:anchor entry) 1)
          (lut:set-text-presentation entry :runs '((:start 0 :end 6 :style (:bold t :font-size 20))) :reveal-cursor-p nil)
          (assert-cache-parity w :selection-and-styling)
          (setf (lut::hovered-p button) t)
          (assert-cache-parity w :hover)
          (setf (lut:theme w) lut:*dark-theme*)
          (assert-cache-parity w :theme)
          (lut:remove-child scene label)
          (assert-cache-parity w :removed-child)
          (lut:add-child scene label)
          (lut:layout label 30 180 160 36)
          (assert-cache-parity w :moved-child)
          ;; A callback that spans tile boundaries must still execute just once.
          (lut:layout area 200 200 200 100)
          (setf (lut:draw-function area)
            (lambda (widget) (incf draws)
              (rl:draw-rectangle (lut:x widget) (lut:y widget) (lut:width widget) (lut:height widget) '(200 40 80 128))))
          (setf draws 0)
          (lut::prepare-window-cache w :pixel-scale 1) (assert (= 1 draws))
          (lut::prepare-window-cache w :pixel-scale 1) (assert (= 2 draws))
          ;; Capture only reads that prepared dynamic surface; it must not call it again.
          (let ((image (cache-image w t))) (rl:unload-image image)) (assert (= 2 draws))
          (assert-cache-parity w :transparent-custom-drawing)
          (setf (lut:draw-function area) nil)
          (lut::prepare-window-cache w :pixel-scale 1)
          (lut::prepare-window-cache w :pixel-scale 1)
          (assert (zerop (getf (lut:window-cache-statistics w) :last-repaints)))
          (setf (lut:cache-enabled-p w) nil)
          (lut::prepare-window-cache w :pixel-scale 1)
          (assert (zerop (getf (lut:window-cache-statistics w) :tiles)))))))
   (unwind-protect (lut:run root :frames 4) (lut:dispose root))))
(format t "PASS: default cache reuse, regional invalidation, callback frequency and direct/cached pixel parity at 100/125/200%.~%")
