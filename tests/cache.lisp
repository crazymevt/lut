(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lui.asd"))
(ql:quickload "lui/raylib")
(uiop:with-temporary-file (:pathname first-path :type "png")
 (uiop:with-temporary-file (:pathname second-path :type "png")
  (let* ((w (lui:make-widget 'lui:window :width 500 :height 240))
         (field (lui:add-child w (lui:make-widget 'lui:label :text "Font cache")))
         (image (lui:add-child w (lui:make-widget 'lui:image :height 40)))
         (frame 0) (observations 0) (verified nil))
   (lui:on w :tick
     (lambda (root dt)
       (declare (ignore root dt))
       (incf frame)
       (when (= frame 1)
         (dolist (pair (list (cons first-path :red) (cons second-path :blue)))
           (let ((pixels (rl:gen-image-color 4 4 (cdr pair))))
             (unwind-protect (assert (rl:export-image pixels (car pair))) (rl:unload-image pixels)))))
       (setf (lui:style field) (list :font-size (+ 14 frame))
             (lui:source image) (if (evenp frame) first-path second-path))
       (when (= frame 9) (lui:dispose field) (lui:dispose image))) :owner field)
   (lui:on w :tick (lambda (root dt)
     (declare (ignore root dt))
     (incf observations)
     (assert (<= (length lui::*font-cache*) 1))
     (assert (<= (length lui::*texture-cache*) 1))
     (when (>= observations 10)
       (assert (null lui::*font-cache*)) (assert (null lui::*texture-cache*)) (setf verified t))))
   (lui:run w :frames 12)
   (assert verified)
   (assert (= 1 (length (slot-value w 'lui::handlers))))
   (assert (null lui:*window*)) (assert (null lui::*ui-queue*)) (assert (null lui::*remote-windows*))
   (lui:dispose w)
   (format t "Stale atlas/texture eviction, owned callback cleanup and loop teardown checks passed.~%"))))
