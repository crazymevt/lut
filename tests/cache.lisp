(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/raylib")
(uiop:with-temporary-file (:pathname first-path :type "png")
 (uiop:with-temporary-file (:pathname second-path :type "png")
  (let* ((w (lut:make-widget 'lut:window :width 500 :height 240))
         (field (lut:add-child w (lut:make-widget 'lut:label :text "Font cache")))
         (image (lut:add-child w (lut:make-widget 'lut:image :height 40)))
         (frame 0) (observations 0) (verified nil))
   (lut:on w :tick
     (lambda (root dt)
       (declare (ignore root dt))
       (incf frame)
       (when (= frame 1)
         (dolist (pair (list (cons first-path :red) (cons second-path :blue)))
           (let ((pixels (rl:gen-image-color 4 4 (cdr pair))))
             (unwind-protect (assert (rl:export-image pixels (car pair))) (rl:unload-image pixels)))))
       (setf (lut:style field) (list :font-size (+ 14 frame))
             (lut:source image) (if (evenp frame) first-path second-path))
       (when (= frame 9) (lut:dispose field) (lut:dispose image))) :owner field)
   (lut:on w :tick (lambda (root dt)
     (declare (ignore root dt))
     (incf observations)
     (assert (<= (length lut::*font-cache*) 1))
     (assert (<= (length lut::*texture-cache*) 1))
     (when (>= observations 10)
       (assert (null lut::*font-cache*)) (assert (null lut::*texture-cache*)) (setf verified t))))
   (lut:run w :frames 12)
   (assert verified)
   (assert (= 1 (length (slot-value w 'lut::handlers))))
   (assert (null lut:*window*)) (assert (null lut::*ui-queue*)) (assert (null lut::*remote-windows*))
   (lut:dispose w)
   (format t "Stale atlas/texture eviction, owned callback cleanup and loop teardown checks passed.~%"))))
