(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(asdf:load-system "lut/raylib")
(let ((original (symbol-function 'rl:begin-scissor-mode)) (actual nil) (lut::*render-ui-scale* 5/4))
 (unwind-protect
     (progn
       (setf (symbol-function 'rl:begin-scissor-mode) (lambda (&rest rectangle) (setf actual rectangle)))
       (lut:begin-ui-scissor 51/5 102/5 303/10 203/5)
       (assert (equal '(12 25 39 52) actual)))
   (setf (symbol-function 'rl:begin-scissor-mode) original)))
(defun check-scaled-frame (root scale)
 (let* ((target (rl:load-render-texture (round (* (lut:width root) scale)) (round (* (lut:height root) scale)))))
   (unwind-protect
       (progn
         (rl:with-texture-mode (target) (rl:clear-background :white) (lut::render-window root))
         (let ((image (rl:load-image-from-texture (rl:render-texture-texture target))))
           (unwind-protect
             (progn
               (rl:image-flip-vertical image)
               (let ((inside (rl:get-image-color image (round (* 50 scale)) (round (* 60 scale))))
                     (outside (rl:get-image-color image (round (* 32 scale)) (round (* 60 scale)))))
                 (assert (> (rl:color-r inside) 200)) (assert (< (rl:color-g inside) 100))
                 (assert (> (rl:color-g outside) 200)))
               (assert (rl:export-image image (format nil "/tmp/lut-platform-~d.png" (round (* 100 scale))))))
             (rl:unload-image image))))
     (rl:unload-render-texture target))))
(dolist (scale '(1 5/4 2))
 (let* ((root (lut:make-widget 'lut:window :width 360 :height 220 :ui-scale scale :content-layout :fill :theme lut:*light-theme*))
        (canvas (lut:add-child root (lut:make-widget 'lut:drawing-area :draw-function
          (lambda (w) (declare (ignore w)) (lut:with-ui-scissor (40 50 20 30) (rl:draw-rectangle 30 50 80 30 :red))))))
        (button (lut:add-child canvas (lut:make-widget 'lut:button :x 150 :y 90 :width 120 :height 35 :text "Scaled input")))
        (entry (lut:add-child canvas (lut:make-widget 'lut:entry :x 10 :y 140 :width 320 :height 40 :text "Metrics and selection")))
        (calls 0) (checked nil) (frame 0))
   (lut:on button :activate (lambda (w p) (declare (ignore w p)) (incf calls)))
   (lut:on root :tick (lambda (w dt) (declare (ignore dt))
     (when (= 2 (incf frame))
       (dolist (kind '(:down :up))
         (lut:dispatch-device-event w (lut:make-event :kind kind :x (* 180 scale) :y (* 105 scale))))
       (assert (= 1 calls))
       (assert (= (round (* 18 scale)) (rl:font-base-size (lut::widget-font entry "Metrics"))))
       (loop for position from 0 to (lut:text-length entry) do
         (multiple-value-bind (x y) (lut:text-position-rectangle entry position)
           (assert (= position (lut:text-point-position entry x (+ y 5))))))
       (check-scaled-frame root scale) (setf checked t))))
   (unwind-protect (progn (lut:run root :frames 3) (assert checked)) (lut:dispose root))))
#+darwin
(let* ((root (lut:make-widget 'lut:window :width 640 :height 520)) (calls 0) (fail nil)
       (command (lut:make-command :native "Native action" (lambda (c context) (declare (ignore c)) (assert (eq root context))
                  (when fail (error "Native callback failure")) (incf calls)) :shortcut :control-j))
       (menu (lut:install-command-menu root (list (list :label "Test" :commands (list command :separator command))) :native :auto))
       (frame 0) (checked nil))
 (lut:on root :tick (lambda (w dt) (declare (ignore dt))
   (when (= 2 (incf frame))
     (assert (eq :native (lut:command-menu-backend menu)))
     (let* ((state (lut::menu-native-state menu)) (item (cdr (assoc command (getf state :items)))))
       (let* ((submenu (lut::cocoa-send item "menu" :pointer))
              (separator (lut::cocoa-send submenu "itemAtIndex:" :long 1 :pointer)))
         (assert (= 3 (lut::cocoa-send submenu "numberOfItems" :long)))
         (assert (= 1 (lut::cocoa-send separator "isSeparatorItem" :uint8))))
       (setf (lut:command-label command) "Updated native action" (lut:enabled-p command) nil)
       (lut:refresh-command-menu menu)
       (assert (string= "Updated native action" (lut::cocoa-lisp-string (lut::cocoa-send item "title" :pointer))))
       (assert (zerop (lut::cocoa-send item "isEnabled" :uint8)))
       (setf (lut:enabled-p command) t (lut:command-shortcut command) '(:key :p :super t :shift t))
       (lut:refresh-command-menu menu)
       (assert (string= "p" (lut::cocoa-lisp-string (lut::cocoa-send item "keyEquivalent" :pointer))))
       (assert (= (+ (ash 1 20) (ash 1 17)) (lut::cocoa-send item "keyEquivalentModifierMask" :unsigned-long)))
       (lut::cocoa-send (getf state :target) "lutActivate:" :pointer item :void)
       (lut::drain-ui-queue) (assert (= 1 calls))
       (let* ((child (lut:make-command :recent "Recent file" (lambda (c context) (declare (ignore c context)) (incf calls))))
              (entries (list child)))
         (unwind-protect
           (progn
             (setf (lut:command-submenu command) (lambda (c context) (declare (ignore c context)) entries))
             (lut:refresh-command-menu menu)
             (let* ((submenu (lut::cocoa-send item "submenu" :pointer))
                    (recent (lut::cocoa-send submenu "itemAtIndex:" :long 0 :pointer))
                    (tags (length (getf (lut::menu-native-state menu) :tags))))
               (assert (= 1 (lut::cocoa-send submenu "numberOfItems" :long)))
               (lut::cocoa-send (getf state :target) "lutActivate:" :pointer recent :void)
               (lut::drain-ui-queue) (assert (= 2 calls))
               (setf (lut:command-label child) "Updated recent file")
               (lut:refresh-command-menu menu)
               (assert (= tags (length (getf (lut::menu-native-state menu) :tags))))
               (assert (string= "Updated recent file"
                 (lut::cocoa-lisp-string (lut::cocoa-send
                   (lut::cocoa-send (lut::cocoa-send item "submenu" :pointer) "itemAtIndex:" :long 0 :pointer)
                   "title" :pointer))))
               (setf entries nil)
               (lut:refresh-command-menu menu)
               (assert (zerop (lut::cocoa-send (lut::cocoa-send item "submenu" :pointer) "numberOfItems" :long)))))
           (lut:dispose child)))
       (setf (lut:command-submenu command) nil)
       (lut:refresh-command-menu menu)
       (assert (cffi:null-pointer-p (lut::cocoa-send item "submenu" :pointer)))
       (setf fail t)
       (lut::cocoa-send (getf state :target) "lutActivate:" :pointer item :void)
       (assert (handler-case (progn (lut::drain-ui-queue) nil) (error () t)))
       (setf fail nil))
     (let ((popup (lut:open-context-menu w w (lut:make-event :kind :context :x 10 :y 10)
                    (list (list "First" (lambda () nil) t) :separator (list "Second" (lambda () nil) t)))))
       (assert (typep (second (lut:children popup)) 'lut:menu-separator))
       (rl:with-drawing (:white) (lut::render-window w))
       (lut:dismiss-dialog popup) (lut:dispose popup))
     ;; Configure all three real AppKit panels; automate cancellation through
     ;; their actual modal loop rather than accepting a user-selected path.
     (dolist (kind '(:file :folder :save))
       (let* ((callbacks 0)
              (lut::*cocoa-panel-runner*
                (lambda (panel)
                  (unless (eq kind :save)
                    (assert (= (if (eq kind :file) 1 0) (lut::cocoa-send panel "canChooseFiles" :uint8)))
                    (assert (= (if (eq kind :folder) 1 0) (lut::cocoa-send panel "canChooseDirectories" :uint8))))
                  (lut::cocoa-send panel "performSelector:withObject:afterDelay:inModes:"
                    :pointer (lut::cocoa-selector "cancel:") :pointer (cffi:null-pointer) :double 0.1d0
                    :pointer (lut::cocoa-send (lut::cocoa-class "NSArray") "arrayWithObject:"
                      :pointer (lut::cocoa-string "NSModalPanelRunLoopMode") :pointer) :void)
                  (lut::cocoa-send panel "runModal" :long)))
              (request (lut:request-path w (lambda (path) (assert (null path)) (incf callbacks))
                        :kind kind :native t :title "LUT automated cancellation" :filename (when (eq kind :save) "test.txt"))))
         (assert (eq :cancelled (lut:path-request-state request))) (assert (= 1 callbacks))
         (lut:dispose request)))
     ;; Invalid portable input must not escape a real frame callback or hide
     ;; the feedback/Cancel action below the dialog's content bounds.
     (let* ((callbacks 0)
            (missing (format nil "lut-missing-~a/file.txt" (symbol-name (gensym "PATH-"))))
            (request (lut:request-path w (lambda (path) (declare (ignore path)) (incf callbacks)) :native nil))
            (dialog (lut:path-request-dialog request))
            (path (find-if (lambda (child) (typep child 'lut:entry)) (lut:children dialog)))
            (status (lut:find-widget dialog :path-validation-status))
            (choose (find-if (lambda (child) (and (typep child 'lut:button) (string= "Choose" (lut:text child)))) (lut:children dialog))))
       (setf (lut:text path) missing)
       (lut:emit choose :activate nil)
       (assert (eq :pending (lut:path-request-state request))) (assert (zerop callbacks))
       (assert (plusp (length (lut:text status))))
       (lut::layout-window w)
       (dolist (child (cons status (remove-if-not (lambda (child) (typep child 'lut:button)) (lut:children dialog))))
         (assert (<= (+ (lut:y child) (lut:height child)) (+ (lut:y dialog) (lut:height dialog)))))
       (rl:with-drawing (:white) (lut::render-window w))
       (lut:cancel-path-request request) (assert (= 1 callbacks)) (lut:dispose request))
     (setf checked t))))
 (unwind-protect (progn (lut:run root :frames 3) (assert checked)) (lut:dispose root) (lut:dispose command))
 (assert (zerop (hash-table-count lut::*cocoa-menu-actions*)))
 (assert (zerop (hash-table-count lut::*cocoa-menu-targets*))))
#+darwin
(let* ((root (lut:make-widget 'lut:window :width 240 :height 140)) (saw-native nil)
       (command (lut:make-command :cleanup "Cleanup" (lambda (c context) (declare (ignore c context)) nil))))
 (lut:on root :context-close (lambda (w p) (declare (ignore w p)) (error "Context-close observer")))
 (let ((menu (lut:install-command-menu root (list (list :label "Test" :commands (list command))))))
   (lut:on root :tick (lambda (w dt) (declare (ignore w dt))
     (when (eq :native (lut:command-menu-backend menu)) (setf saw-native t))))
   (unwind-protect
       (progn (assert (handler-case (progn (lut:run root :frames 2) nil)
                        (error (e) (assert (search "Context-close observer" (princ-to-string e))) t)))
         (assert saw-native)
         (assert (eq :drawn (lut:command-menu-backend menu)))
         (assert (zerop (hash-table-count lut::*cocoa-menu-actions*)))
         (assert (zerop (hash-table-count lut::*cocoa-menu-targets*))))
     (lut:dispose root) (lut:dispose command))))
(format t "Native 100/125/200% clipping, font metrics and input passed; AppKit menu updates/actions and file/folder/save modal cancellation passed on macOS.~%")
