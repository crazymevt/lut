(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/examples" :silent t)
(dolist (theme (list lut:*light-theme* lut:*dark-theme*))
 (let* ((root (lut-examples:command-actions)) (button (lut:find-widget root :command-button))
        (menu (lut:find-widget root :command-menu)) (toggle (lut:find-widget root :allow-command))
        (status (lut:find-widget root :command-status)) (frame 0) (point nil)
        (path "/tmp/lut-commands.png"))
   (setf (lut:theme root) theme)
   (lut:on root :tick (lambda (w dt)
     (declare (ignore w dt))
     (case (incf frame)
       (2
         (let ((x (+ (lut:x button) 10)) (y (+ (lut:y button) 10)))
           (lut:dispatch root (lut:make-event :kind :down :x x :y y))
           (lut:dispatch root (lut:make-event :kind :up :x x :y y)))
         (assert (string= "Count: 1" (lut:text status)))
         (let ((x (+ (lut:x menu) 10)) (y (+ (lut:y menu) 10)))
           (lut:dispatch root (lut:make-event :kind :down :x x :y y))
           (lut:dispatch root (lut:make-event :kind :up :x x :y y)))
         (assert (string= "Count: 2" (lut:text status)))
         (lut:dispatch root (lut:make-event :kind :key :key :f6))
         (assert (string= "Count: 3" (lut:text status)))
         (setf (lut:value toggle) nil) (lut:emit toggle :change nil)
         (assert (not (lut:enabled-p button))) (assert (not (lut:enabled-p menu)))
         (lut:dispatch root (lut:make-event :kind :key :key :f6))
         (assert (string= "Count: 3" (lut:text status)))
         (setf point (list (+ (lut:x button) 30) (+ (lut:y button) 30)))
         (let ((texture (rl:load-render-texture (round (lut:width root)) (round (lut:height root)))))
           (unwind-protect
             (progn
               (rl:with-texture-mode (texture)
                 (rl:clear-background (lut:style-value root :background)) (lut::render-window root))
               (let ((image (rl:load-image-from-texture (rl:render-texture-texture texture))))
                 (unwind-protect
                   (progn (rl:image-flip-vertical image) (assert (rl:export-image image path)))
                   (rl:unload-image image))))
             (rl:unload-render-texture texture))))
       (3
         (setf (lut:value toggle) t) (lut:emit toggle :change t)
         (assert (lut:enabled-p button)) (assert (lut:enabled-p menu))
         (lut:dispatch root (lut:make-event :kind :key :key :f6))
         (assert (string= "Count: 4" (lut:text status)))))))
   (unwind-protect
     (progn
       (lut:run root :frames 4)
       (let ((image (rl:load-image path)))
         (unwind-protect
           (assert (= (rl:color-to-int (rl:get-image-color image (round (first point)) (round (second point))))
                      (rl:color-to-int (lut:style-value button :disabled-color))))
           (rl:unload-image image))))
     (lut:dispose root))))
(format t "Shared toolbar/menu/shortcut actions and disabled command rendering passed in both themes.~%")
