(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/examples")
;; Queue order, failure preservation and edits submitted by another thread.
(let ((seen nil))
 (lut:enqueue-ui (lambda () (push 1 seen)))
 (lut:enqueue-ui (lambda () (error "Expected queue failure")))
 (lut:enqueue-ui (lambda () (push 2 seen)))
 (assert (handler-case (progn (lut::drain-ui-queue) nil) (error () t)))
 (assert (equal seen '(1)))
 (bt:join-thread (bt:make-thread (lambda () (lut:enqueue-ui (lambda () (push 3 seen))))))
 (lut::drain-ui-queue)
 (assert (equal seen '(3 2 1))))
;; A named callback redefinition and a queued structural edit take effect live.
(defun live-label () "before")
(let* ((w (lut-examples:hello-world))
       (label (first (lut:children w))) (frames 0))
 (lut:on w :tick
   (lambda (window dt)
     (declare (ignore dt))
     (incf frames)
     (setf (lut:text label) (live-label))
     (when (= frames 1)
       (setf (symbol-function 'live-label) (lambda () "after"))
       (lut:on-ui
         (asdf:load-system "lut" :force t)
         (lut:add-child window (lut:make-widget 'lut:label :text "queued"))))))
 (lut:run w :frames 3)
 (assert (string= "after" (lut:text label)))
 (assert (= 3 (length (lut:children w)))))
(format t "REPL queue and live redefinition checks passed.~%")
;; F9: redefine a class and its rendering method while retaining an old instance.
(lut:defwidget live-gadget (lut:label) "Live reload test widget."
 ((tally 0 (integer 0 *) "Render count.")))
(defmethod lut:render ((w live-gadget)) (incf (tally w)) (call-next-method))
(let* ((w (lut:make-widget 'lut:window :width 500 :height 240))
       (gadget (lut:make-widget 'live-gadget :text "before")) (frame 0))
 (lut:add-child w gadget)
 (lut:on w :tick (lambda (window dt) (declare (ignore window dt))
   (when (= (incf frame) 1)
     (lut:on-ui
       (eval '(lut:defwidget live-gadget (lut:label) "Redefined test widget."
                ((tally 0 (integer 0 *) "Render count.") (badge "added live" string "New slot."))))
       (eval '(defmethod lut:render ((g live-gadget))
                (setf (lut:text g) (badge g)) (incf (tally g)) (call-next-method)))))))
 (lut:run w :frames 4)
 (assert (string= "added live" (slot-value gadget 'badge)))
 (assert (string= "added live" (lut:text gadget)))
 (assert (>= (tally gadget) 4))
 (format t "Live DEFWIDGET instance migration and per-class rendering redefinition passed.~%"))
