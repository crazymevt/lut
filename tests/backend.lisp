(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lui.asd"))
(ql:quickload "lui/examples")
;; Queue order, failure preservation and edits submitted by another thread.
(let ((seen nil))
 (lui:enqueue-ui (lambda () (push 1 seen)))
 (lui:enqueue-ui (lambda () (error "Expected queue failure")))
 (lui:enqueue-ui (lambda () (push 2 seen)))
 (assert (handler-case (progn (lui::drain-ui-queue) nil) (error () t)))
 (assert (equal seen '(1)))
 (bt:join-thread (bt:make-thread (lambda () (lui:enqueue-ui (lambda () (push 3 seen))))))
 (lui::drain-ui-queue)
 (assert (equal seen '(3 2 1))))
;; A named callback redefinition and a queued structural edit take effect live.
(defun live-label () "before")
(let* ((w (lui-examples:hello-world))
       (label (first (lui:children w))) (frames 0))
 (lui:on w :tick
   (lambda (window dt)
     (declare (ignore dt))
     (incf frames)
     (setf (lui:text label) (live-label))
     (when (= frames 1)
       (setf (symbol-function 'live-label) (lambda () "after"))
       (lui:on-ui
         (asdf:load-system "lui" :force t)
         (lui:add-child window (lui:make-widget 'lui:label :text "queued"))))))
 (lui:run w :frames 3)
 (assert (string= "after" (lui:text label)))
 (assert (= 3 (length (lui:children w)))))
(format t "REPL queue and live redefinition checks passed.~%")
;; F9: redefine a class and its rendering method while retaining an old instance.
(lui:defwidget live-gadget (lui:label) "Live reload test widget."
 ((tally 0 (integer 0 *) "Render count.")))
(defmethod lui:render ((w live-gadget)) (incf (tally w)) (call-next-method))
(let* ((w (lui:make-widget 'lui:window :width 500 :height 240))
       (gadget (lui:make-widget 'live-gadget :text "before")) (frame 0))
 (lui:add-child w gadget)
 (lui:on w :tick (lambda (window dt) (declare (ignore window dt))
   (when (= (incf frame) 1)
     (lui:on-ui
       (eval '(lui:defwidget live-gadget (lui:label) "Redefined test widget."
                ((tally 0 (integer 0 *) "Render count.") (badge "added live" string "New slot."))))
       (eval '(defmethod lui:render ((g live-gadget))
                (setf (lui:text g) (badge g)) (incf (tally g)) (call-next-method)))))))
 (lui:run w :frames 4)
 (assert (string= "added live" (slot-value gadget 'badge)))
 (assert (string= "added live" (lui:text gadget)))
 (assert (>= (tally gadget) 4))
 (format t "Live DEFWIDGET instance migration and per-class rendering redefinition passed.~%"))
