(in-package #:lut-tests)
(defclass unit-measure-button (lut:button) ())
(defmethod lut:text-width ((w unit-measure-button) string) (declare (ignore w)) (length string))
(defclass unit-measure-label (lut:label) ())
(defmethod lut:text-width ((w unit-measure-label) string) (declare (ignore w)) (length string))
(defun measure-label (text &rest initargs)
 (apply #'lut:make-widget 'unit-measure-label :text text
   :style '(:padding 0 :font-size 1 :line-height 2 :wrap-text t) initargs))
(defun measurement-geometry (widget)
 (list (lut:x widget) (lut:y widget) (lut:width widget) (lut:height widget)))
(defun size-measurement-tests ()
 (let* ((label (measure-label "aa bb cc")) (before (measurement-geometry label)))
   (assert (equal '(2 8) (multiple-value-list (lut:measure label :horizontal))))
   (assert (equal '(6 6) (multiple-value-list (lut:measure label :vertical 2))))
   (assert (equal '(2 2) (multiple-value-list (lut:measure label :vertical 8))))
   (assert (equal before (measurement-geometry label)))
   (lut:layout label 10 20 2 6)
   (assert (equal '(2 8) (multiple-value-list (lut:measure label :horizontal))))
   (setf (lut:max-width label) 5)
   (assert (= 4 (nth-value 1 (lut:measure label :vertical 8))))
   (setf (lut:max-width label) nil)
   (setf (lut:text label) "aa bb cc dd")
   (assert (= 8 (nth-value 1 (lut:measure label :vertical 2))))
   (setf (lut:style label) '(:padding 1 :font-size 1 :line-height 3 :wrap-text t))
   (assert (= 14 (nth-value 1 (lut:measure label :vertical 4))))
   (setf (lut:visible-p label) nil) (assert (equal '(0 0) (multiple-value-list (lut:measure label :vertical 4))))
   (setf (lut:visible-p label) t)
   (assert (handler-case (progn (lut:measure label :diagonal) nil) (error () t)))
   (assert (handler-case (progn (lut:measure label :vertical -1) nil) (error () t)))
   (lut:dispose label)
   (assert (handler-case (progn (lut:measure label :horizontal) nil) (error () t))))
 (let ((widget (lut:make-widget 'lut:widget :width 70 :height 30 :width-request 90)))
   (assert (= 90 (nth-value 1 (lut:measure widget :horizontal))))
   (lut:layout widget 0 0 400 200)
   (assert (= 90 (nth-value 1 (lut:measure widget :horizontal))))
   (setf (lut:width-request widget) nil)
   (assert (= 70 (nth-value 1 (lut:measure widget :horizontal))))
   (setf (lut:min-width widget) 50 (lut:max-width widget) 80)
   (assert (equal '(50 70) (multiple-value-list (lut:measure widget :horizontal))))
   (assert (handler-case (progn (setf (lut:max-width widget) 40) nil) (error () t)))
   (assert (= 80 (lut:max-width widget)))
   (assert (handler-case (progn (setf (lut:min-width widget) 90) nil) (error () t)))
   (assert (= 50 (lut:min-width widget)))
   (setf (lut:width-request widget) 200)
   (assert (= 80 (nth-value 1 (lut:measure widget :horizontal))))
   (lut:dispose widget))
 (assert (handler-case (progn (lut:make-widget 'lut:widget :min-height 20 :max-height 10) nil) (error () t)))
 (let ((label (measure-label "aa bb")))
   (setf (lut:style label) '(:padding 0 :font-size 10 :line-height 2 :wrap-text t))
   (assert (= 12 (nth-value 1 (lut:measure label :vertical 2))))
   (lut:dispose label))
 (let ((button (lut:make-widget 'unit-measure-button :text "aa bb" :style '(:padding 0 :font-size 1 :line-height 2 :button-depth 0 :wrap-text t))))
   (assert (equal '(5 5) (multiple-value-list (lut:measure button :horizontal))))
   (assert (= 1 (nth-value 1 (lut:measure button :vertical 1))))
   (lut:dispose button))
 (let ((entry (lut:make-widget 'lut:text-view :width 90 :height 45 :text "A long line remains unwrapped" :style '(:wrap-text t))))
   (assert (= 90 (nth-value 1 (lut:measure entry :horizontal))))
   (assert (= 45 (nth-value 1 (lut:measure entry :vertical 15))))
   (lut:dispose entry)))
(defun measured-box-tests ()
 (let* ((box (lut:make-widget 'lut:measured-box :spacing 1 :style '(:padding 0)))
        (label (lut:add-child box (measure-label "aa bb cc")))
        (flow (lut:add-child box (lut:make-widget 'lut:flow-box :row-spacing 1 :column-spacing 1 :style '(:padding 0)))))
   (loop repeat 3 do (lut:add-child flow (measure-label "xx")))
   (assert (= 10 (nth-value 1 (lut:measure box :vertical 5))))
   (lut:layout box 0 0 5 20)
   (assert (= 4 (lut:height label)))
   (assert (= 5 (lut:y flow))) (assert (= 5 (lut:height flow)))
   (lut:layout box 0 0 20 20)
   (assert (= 2 (lut:height label))) (assert (= 2 (lut:height flow)))
   (lut:layout box 0 0 5 20)
   (assert (= 4 (lut:height label))) (assert (= 5 (lut:height flow)))
   (setf (lut:visible-p label) nil)
   (lut:layout box 0 0 5 20) (assert (zerop (lut:y flow)))
   (lut:dispose box))
 (let* ((box (lut:make-widget 'lut:measured-box :orientation :horizontal :spacing 0 :style '(:padding 0)))
        (a (lut:add-child box (lut:make-widget 'lut:widget :width-request 15 :min-width 5)))
        (b (lut:add-child box (lut:make-widget 'lut:widget :width-request 30 :min-width 10))))
   (lut:layout box 0 0 30 20)
   (assert (= 10 (lut:width a))) (assert (= 20 (lut:width b)))
   (lut:dispose box))
 (let* ((box (lut:make-widget 'lut:measured-box :orientation :horizontal :spacing 0 :style '(:padding 0)))
        (a (lut:add-child box (lut:make-widget 'lut:widget :width 10 :height 5 :hexpand t :max-width 20)))
        (b (lut:add-child box (lut:make-widget 'lut:widget :width 10 :height 5 :hexpand t))))
   (lut:layout box 0 0 100 20)
   (assert (= 20 (lut:width a))) (assert (= 80 (lut:width b)))
   (lut:layout box 0 0 30 20)
   (assert (= 15 (lut:width a))) (assert (= 15 (lut:width b)))
   (setf (lut:min-width a) 10 (lut:min-width b) 10)
   (lut:layout box 0 0 5 20)
   (assert (= 10 (lut:width a))) (assert (= 10 (lut:width b)))
   (lut:dispose box))
 ;; Requests, not previous allocation, determine stable expansion after repeated resize.
 (let* ((box (lut:make-widget 'lut:measured-box :spacing 0 :style '(:padding 0)))
        (a (lut:add-child box (lut:make-widget 'lut:widget :height 10 :vexpand t :max-height 20)))
        (b (lut:add-child box (lut:make-widget 'lut:widget :height 10 :vexpand t))))
   (lut:layout box 0 0 100 100) (assert (= 20 (lut:height a))) (assert (= 80 (lut:height b)))
   (lut:layout box 0 0 100 30) (assert (= 15 (lut:height a))) (assert (= 15 (lut:height b)))
   (lut:dispose box)))
(defun flow-layout-tests ()
 (let* ((root (lut:make-widget 'lut:window :width 40 :height 40 :content-layout :fill :style '(:padding 0)))
        (flow (lut:add-child root (lut:make-widget 'lut:flow-box :row-spacing 1 :column-spacing 1)))
        (a (lut:add-child flow (measure-label "xx")))
        (b (lut:add-child flow (measure-label "xx")))
        (c (lut:add-child flow (measure-label "xx"))))
   (assert (equal '(2 8) (multiple-value-list (lut:measure flow :horizontal))))
   (assert (= 5 (nth-value 1 (lut:measure flow :vertical 5))))
   (lut:layout flow 10 10 5 20)
   (assert (equal '(10 10 2 2) (measurement-geometry a)))
   (assert (equal '(13 10 2 2) (measurement-geometry b)))
   (assert (equal '(10 13 2 2) (measurement-geometry c)))
   (assert (eq b (lut:hit-test root 14 11)))
   (lut:layout flow 10 10 8 20)
   (assert (= 10 (lut:y c))) (assert (= 16 (lut:x c)))
   (lut:layout flow 10 10 0 0)
   (assert (= 2 (lut:width a))) ; intrinsic minimum is preserved when it cannot fit
   (assert (> (lut:y b) (lut:y a)))
   (setf (lut:enabled-p b) nil)
   (lut:layout flow 10 10 5 20) (assert (= 13 (lut:y c)))
   (setf (lut:visible-p b) nil) (lut:layout flow 10 10 5 20)
   (assert (= 10 (lut:y c)))
   (lut:remove-child flow a)
   (assert (= 2 (nth-value 1 (lut:measure flow :vertical 5))))
   (lut:dispose a) (lut:dispose root)
   (assert (lut:disposed-p flow))
   (assert (null (lut:children flow))) (assert (null (lut:parent c))))
 (let* ((flow (lut:make-widget 'lut:flow-box :column-spacing 0 :style '(:padding 0)))
        (a (lut:add-child flow (lut:make-widget 'lut:widget :width 10 :height 5 :hexpand t :max-width 15)))
        (b (lut:add-child flow (lut:make-widget 'lut:widget :width 10 :height 10 :hexpand t :vexpand t))))
   (lut:layout flow 0 0 50 100) (assert (= 15 (lut:width a))) (assert (= 35 (lut:width b)))
   (lut:layout flow 0 0 25 100) (assert (= 25/2 (lut:width a))) (assert (= 25/2 (lut:width b)))
   (lut:dispose flow))
 (let ((empty (lut:make-widget 'lut:flow-box :style '(:padding 2))))
   (assert (equal '(4 4) (multiple-value-list (lut:measure empty :horizontal))))
   (assert (equal '(4 4) (multiple-value-list (lut:measure empty :vertical 0))))
   (lut:layout empty 0 0 0 0) (lut:dispose empty)))
(defvar *measurement-call-counts* nil)
(defvar *measurement-text-width-count* 0)
(defmethod lut:measure :before ((w lut:widget) axis &optional for-size)
 (when *measurement-call-counts*
   (incf (gethash (list w axis for-size) *measurement-call-counts* 0))))
(defmethod lut:text-width :before ((w unit-measure-label) string)
 (declare (ignore string))
 (when *measurement-call-counts* (incf *measurement-text-width-count*)))
(defun nested-measurement-tree (depth)
 (let* ((root (lut:make-widget 'lut:measured-box :spacing 0 :style '(:padding 0))) (tip root))
   (loop repeat depth do
     (setf tip (lut:add-child tip (lut:make-widget 'lut:measured-box :hexpand t :spacing 0 :style '(:padding 0)))))
   (values root (lut:add-child tip (measure-label "aa bb cc dd ee ff gg hh" :hexpand t)))))
(defun nested-measurement-counts (depth &optional standalone)
 (multiple-value-bind (root leaf) (nested-measurement-tree depth)
   (declare (ignore leaf))
   (unwind-protect
     (let ((*measurement-call-counts* (make-hash-table :test #'equal)) (*measurement-text-width-count* 0))
       (if standalone (lut:measure root :vertical 32) (lut:layout root 0 0 32 300))
       (assert (loop for count being the hash-values of *measurement-call-counts* always (= count 1)))
       (assert (<= (hash-table-count *measurement-call-counts*) (* 4 (+ depth 2))))
       (assert (null lut::*measurement-cache*))
       (list (hash-table-count *measurement-call-counts*) *measurement-text-width-count*))
     (lut:dispose root))))
(defclass measurement-query-box (lut:widget)
 ((results :initform nil :accessor measurement-query-results)
  (fail :initform nil :accessor measurement-query-fail-p)))
(defmethod lut:layout :after ((w measurement-query-box) x y width height)
 (declare (ignore x y width height))
 (setf (measurement-query-results w)
   (loop for offered in '(2 32 2) collect
     (nth-value 1 (lut:measure (first (lut:children w)) :vertical offered))))
 (when (measurement-query-fail-p w) (error "Test layout failure after measurement.")))
(defun measurement-cache-tests ()
 (let ((shallow (nested-measurement-counts 2)) (deep (nested-measurement-counts 6))
       (query (nested-measurement-counts 6 t)))
   ;; Repeated queries must not multiply text work as nesting increases.
   (assert (= (second shallow) (second deep) (second query)))
   (format t "Pass-scoped measurement cache: depths 2/6 use ~d/~d primary queries and ~d/~d text-width calls.~%"
     (first shallow) (first deep) (second shallow) (second deep)))
 (let* ((root (lut:make-widget 'measurement-query-box))
        (leaf (lut:add-child root (measure-label "aa bb cc dd"))))
   (unwind-protect
     (progn
       (let ((*measurement-call-counts* (make-hash-table :test #'equal)))
         (lut:layout root 0 0 32 100)
         (assert (equal '(8 2 8) (measurement-query-results root)))
         (assert (= 1 (gethash (list leaf :vertical 2) *measurement-call-counts*)))
         (assert (= 1 (gethash (list leaf :vertical 32) *measurement-call-counts*))))
       ;; Every outer pass is fresh, even when dimensions are unchanged.
       (setf (lut:text leaf) "aa bb cc dd ee ff")
       (lut:layout root 0 0 32 100)
       (assert (equal '(12 2 12) (measurement-query-results root)))
       (setf (lut:style leaf) '(:padding 0 :font-size 1 :line-height 3 :wrap-text t))
       (lut:layout root 0 0 32 100)
       (assert (equal '(18 3 18) (measurement-query-results root)))
       (setf (lut:height-request leaf) 30)
       (lut:layout root 0 0 32 100)
       (assert (equal '(30 30 30) (measurement-query-results root)))
       (setf (lut:height-request leaf) nil (lut:visible-p leaf) nil)
       (lut:layout root 0 0 32 100)
       (assert (equal '(0 0 0) (measurement-query-results root)))
       (setf (lut:visible-p leaf) t (measurement-query-fail-p root) t)
       (assert (handler-case (progn (lut:layout root 0 0 32 100) nil) (error () t)))
       (assert (null lut::*measurement-cache*))
       (setf (measurement-query-fail-p root) nil (lut:text leaf) "aa")
       (lut:layout root 0 0 32 100)
       (assert (equal '(3 3 3) (measurement-query-results root)))
       ;; Standalone public queries do not share a cache with later queries.
       (assert (= 3 (nth-value 1 (lut:measure leaf :vertical 2))))
       (setf (lut:text leaf) "aa bb")
       (assert (= 6 (nth-value 1 (lut:measure leaf :vertical 2))))
       (assert (null lut::*measurement-cache*)))
     (lut:dispose root))))
(defun measurement-tests ()
 (size-measurement-tests) (measured-box-tests) (flow-layout-tests) (measurement-cache-tests)
 (format t "Minimum/natural measurement, shared label wrapping, requests/constraints, measured boxes, flow rows, resizing and hit testing passed.~%"))
