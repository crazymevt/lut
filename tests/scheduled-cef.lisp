(require :asdf)
(asdf:initialize-output-translations
 `(:output-translations (t (,(merge-pathnames "lut-scheduler-tests/" (uiop:temporary-directory)) :implementation :**/ :*.*.*)) :ignore-inherited-configuration))
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/cef" :silent t)
(lut-webview:call-with-native-run
 (lambda ()
  (handler-bind ((error (lambda (condition) (declare (ignore condition)) (sb-debug:print-backtrace :count 30))))
  (let ((mask #+(and sbcl darwin) (cffi:foreign-funcall "sb_toggle_sigprof" :pointer (cffi:null-pointer) :int 1 :int)
              #-(and sbcl darwin) nil))
   (unwind-protect
    (progn
     (lut-webview:initialize-cef)
     (let* ((root (lut:make-widget 'lut:window :width 768 :height 512 :text "LUT scheduled CEF smoke"))
            (view (lut:add-child root (lut:make-widget 'lut-webview:webview :height 512 :local-messages-p t
                       :url (concatenate 'string "file://" #+win32 "/"
                          (namestring (asdf:system-relative-pathname "lut" "webview/tests/damage.html"))))))
            (finished nil) baseline-cache baseline-uploads)
       (assert (lut:native-event-backend-p))
       (lut-webview:attach-webview view root)
       (lut-webview:enable-scheduled-pump root)
       (lut:schedule-ui 0.6 (lambda ()
         (setf baseline-cache (lut:window-cache-statistics root)
               baseline-uploads (getf (lut-webview:statistics view) :texture-uploads))) :owner root)
       (lut:schedule-ui 2 (lambda ()
         (format t "CEF scheduled state: ~S; size ~S; visible ~S; next ~D; schedules ~D; pumps ~D; loading ~S; error ~S~%"
                 (lut-webview:statistics view) (lut-webview::native-size view) (lut-webview::native-state view)
                 (lut-webview::%next-delay)
                 (cffi:foreign-funcall "lut_cef_schedule_count" :uint64)
                 (cffi:foreign-funcall "lut_cef_pump_count" :uint64)
                 (lut-webview:loading-p view) (lut-webview:load-error view))
         (assert (lut-webview::texture view))
         (assert (> (getf (lut-webview:statistics view) :texture-uploads) 1))
         (let* ((cache (lut:window-cache-statistics root))
                (uploads (- (getf (lut-webview:statistics view) :texture-uploads) baseline-uploads)))
           (assert (> uploads 5))
           (assert (= (getf cache :layout-passes) (getf baseline-cache :layout-passes)))
           (assert (< (- (getf cache :repaints) (getf baseline-cache :repaints)) (* uploads 5))))
         (rl:set-window-size 640 480)
         (assert (lut-webview:execute-script view "document.title='Scheduled wake complete';document.getElementById('dot').style.animation='none'"))) :owner root)
       (lut:schedule-ui 3 (lambda () (rl:minimize-window)) :owner root)
       (lut:schedule-ui 3.5 (lambda () (rl:restore-window)) :owner root)
       (lut:schedule-ui 4.5 (lambda ()
         (assert (string= "Scheduled wake complete" (lut-webview:page-title view)))
         (assert (= 640 (rl:get-screen-width)))
         (setf finished t) (lut:stop)) :owner root)
       (unwind-protect
           (let ((lut::*signal-run-errors* t)) (lut:run root) (assert finished))
         (lut:dispose root) (lut-webview:close-session))))
    #+(and sbcl darwin)
    (cffi:foreign-funcall "sb_toggle_sigprof" :pointer (cffi:null-pointer) :int mask :int))))))
(format t "PASS: scheduled CEF animation, native resize, minimized timer wake, restore and JS/title delivery without legacy ticks.~%")
