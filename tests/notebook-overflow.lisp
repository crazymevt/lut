(in-package #:lut-tests)
(defun overflow-fixture (&optional (count 10))
 (let* ((root (lut:make-widget 'lut:window :width 320 :height 200 :content-layout :fill))
        (book (lut:add-child root (lut:make-widget 'lut:notebook :reorderable-p t
                    :items (loop for i below count collect (format nil "Tab ~d" i))))))
   (dotimes (i count) (lut:add-child book (lut:make-widget 'lut:entry :text (format nil "Page ~d" i))))
   (lut:layout root 0 0 320 200) (values root book)))
(defun notebook-overflow-tests ()
 (vertical-notebook-tests)
 (content-sized-tab-tests)
 (multiple-value-bind (root book) (overflow-fixture)
   (multiple-value-bind (tab left viewport button extent) (lut::tab-strip-geometry book)
     (declare (ignore tab extent))
     (assert (plusp button)) (assert (plusp viewport))
     (assert (null (lut:tab-at-position book 2 10)))
     (assert (zerop (lut:tab-at-position book (+ left 5) 10)))
     ;; Navigation controls scroll without selecting or arming a tab drag.
     (drag-event root :down 318 10) (drag-event root :up 318 10)
     (assert (plusp (lut:tab-offset book))) (assert (zerop (lut:value book)))
     (assert (null (lut:current-drag root)))
     (assert (plusp (lut:tab-at-position book (+ left 5) 10)))
     (let ((before (lut:tab-offset book)))
       (lut:dispatch root (lut:make-event :kind :wheel :x (+ left 20) :y 10 :delta -1))
       (assert (> (lut:tab-offset book) before)))
     ;; Keyboard selection immediately reveals the selected page.
     (lut:focus root book) (drag-event root :key 0 0 :left)
     (assert (= 9 (lut:value book)))
     (assert (= (lut:tab-offset book) (lut::tab-scroll-limit book)))
     (assert (= 9 (lut:tab-at-position book (- (+ left viewport) 5) 10)))
     (lut:select-page book 0) (assert (zerop (lut:tab-offset book)))
     ;; Dragging near the edge scrolls the strip and uses the exposed tab index.
     (let ((page (first (lut:children book))))
       (drag-event root :down (+ left 10) 10)
       (dotimes (i 30) (drag-event root :move (- (+ left viewport) 3) 10))
       (assert (plusp (lut:tab-offset book)))
       (let ((boundary (lut::notebook-drop-index book (- (+ left viewport) 3))))
         (assert (> boundary 2))
         (drag-event root :up (- (+ left viewport) 3) 10)
         (assert (eq page (nth (1- boundary) (lut:children book)))))
       (assert (null (lut:current-drag root)))))
   ;; Resizing to fit removes controls and clamps the old scroll offset.
   (lut:layout root 0 0 2000 200)
   (assert (zerop (lut:tab-offset book)))
   (multiple-value-bind (tab left viewport button) (lut::tab-strip-geometry book)
     (declare (ignore tab left viewport)) (assert (zerop button)))
   (assert (not (lut:handle-event book (lut:make-event :kind :wheel :x 20 :y 10 :delta 1))))
   ;; Narrow strips keep distinct left/right drag scrolling zones.
   (lut:layout root 0 0 70 200) (lut:select-page book 0)
   (multiple-value-bind (tab left viewport) (lut::tab-strip-geometry book)
     (declare (ignore tab))
     (drag-event root :down (+ left 1) 10)
     (drag-event root :move (- (+ left viewport) 1) 10)
     (assert (plusp (lut:tab-offset book)))
     (drag-event root :key 0 0 :escape))
   ;; Very small/zero widths remain safe and do not hit hidden tabs.
   (dolist (width '(20 0))
     (lut:layout root 0 0 width 200)
     (assert (null (lut:tab-at-position book 1 10)))))
 ;; Last-page removal and caption changes clamp/reveal on layout.
 (multiple-value-bind (root book) (overflow-fixture)
   (lut:select-page book 9)
   (dolist (page (subseq (copy-list (lut:children book)) 1)) (lut:remove-child book page))
   (setf (lut:items book) '("Only"))
   (lut:layout root 0 0 320 200)
   (assert (zerop (lut:tab-offset book))))
 ;; Modifier data is available to custom input handlers, independent of aliases.
 (let* ((root (lut:make-widget 'lut:window)) (seen nil)
        (event (lut:make-event :kind :key :key :copy :base-key :c
                              :shift-p t :control-p nil :alt-p t :super-p t)))
   (lut:on root :key (lambda (w e) (declare (ignore w)) (setf seen e)))
   (lut:dispatch root event)
   (assert (eq event seen)) (assert (eq :copy (lut:event-key seen)))
   (assert (eq :c (lut:event-base-key seen)))
   (assert (lut:event-shift-p seen)) (assert (lut:event-alt-p seen))
   (assert (lut:event-super-p seen)) (assert (not (lut:event-control-p seen))))
 (format t "Notebook overflow controls, wheel/keyboard reveal, drag scrolling, resize and modifier input checks passed.~%"))


(defun content-sized-tab-tests ()
 (let* ((root (lut:make-widget 'lut:window :width 900 :height 200 :content-layout :fill))
        (book (lut:add-child root (lut:make-widget 'lut:notebook :closable-p t :reorderable-p t
                 :items '("a.lisp" "a-significantly-longer-filename.lisp")
                 :style '(:tab-sizing :content :tab-min-width 96 :font-size 14 :padding 8))))
        (first (lut:add-child book (lut:make-widget 'lut:entry)))
        (second (lut:add-child book (lut:make-widget 'lut:entry))))
   (declare (ignore first))
   (unwind-protect
        (progn
          (lut:layout root 0 0 900 200)
          (let ((short (lut::tab-width-at book 0)) (long (lut::tab-width-at book 1)))
            (assert (= 96 short)) (assert (> long short))
            (assert (< (+ short long) (lut:width book)))
            (assert (= 1 (lut::tab-at-position book (+ (lut:x book) short 0.5) (+ (lut:y book) 5))))
            (assert (lut::tab-close-position-p book 1 (+ (lut:x book) short long -2)))
            (assert (= 1 (lut::notebook-drop-index book (+ (lut:x book) short 1))))
            (setf (lut:tab-badge second) "*")
            (lut:layout root 0 0 1000 200)
            (assert (= short (lut::tab-width-at book 0)))
            (assert (> (lut::tab-width-at book 1) long))
            (lut:layout root 0 0 150 200)
            (assert (plusp (lut::tab-scroll-limit book)))
            (lut:reveal-page book 1)
            (assert (plusp (lut:tab-offset book)))))
     (lut:dispose root))))

(defun vertical-notebook-tests ()
 (let* ((root (lut:make-widget 'lut:window :width 400 :height 180 :content-layout :fill))
        (book (lut:add-child root (lut:make-widget 'lut:vertical-notebook
                 :tab-strip-width 120 :items '("Appearance" "Editor" "Tools")
                 :style '(:row-height 36 :padding 12))))
        (first (lut:add-child book (lut:make-widget 'lut:entry :text "First")))
        (second (lut:add-child book (lut:make-widget 'lut:entry :text "Second")))
        (third (lut:add-child book (lut:make-widget 'lut:entry :text "Third")))
        (changes 0) (reorders 0))
   (unwind-protect
     (progn
       (lut:on book :change (lambda (w p) (declare (ignore w p)) (incf changes)))
       (lut:on book :reorder (lambda (w p) (declare (ignore w)) (assert (equal '(0 1) p)) (incf reorders)))
       (lut:layout root 0 0 400 180)
       (lut:dispatch root (lut:make-event :kind :move :x 20 :y 48))
       (assert (= 1 (lut::hovered-row book)))
       (assert (zerop (lut:value book)))
       (lut:dispatch root (lut:make-event :kind :move :x 20 :y 150))
       (assert (null (lut::hovered-row book)))
       (lut:dispatch root (lut:make-event :kind :move :x 140 :y 10))
       (assert (not (lut::hovered-p book)))
       (assert (null (lut::hovered-row book)))
       (assert (= 132 (lut:x first))) (assert (= 268 (lut:width first)))
       (assert (= 180 (lut:height first)))
       (assert (= 0 (lut:tab-at-position book 20 10)))
       (assert (null (lut:tab-at-position book 140 10)))
       (dolist (kind '(:down :up)) (lut:dispatch root (lut:make-event :kind kind :x 20 :y 48)))
       (assert (= 1 (lut:value book))) (assert (eq book (lut:focused-widget root)))
       (assert (equal (list second) (lut:active-children book)))
       (assert (= 132 (lut:x second))) (assert (= 1 changes))
       (lut:dispatch root (lut:make-event :kind :key :key :down))
       (assert (= 2 (lut:value book)))
       (lut:dispatch root (lut:make-event :kind :key :key :home))
       (assert (zerop (lut:value book)))
       (lut:dispatch root (lut:make-event :kind :key :key :tab))
       (assert (eq first (lut:focused-widget root)))
       ;; Static tabs still select, but a drag never changes page/title order.
       (assert (not (lut:reorderable-p book)))
       (flet ((drag ()
                (lut:dispatch root (lut:make-event :kind :down :x 20 :y 10))
                (lut:dispatch root (lut:make-event :kind :move :x 20 :y 48))
                (lut:dispatch root (lut:make-event :kind :up :x 20 :y 48))))
         (drag)
         (assert (equal (list first second third) (lut:children book)))
         (assert (zerop reorders))
         (setf (lut:reorderable-p book) t)
         (drag)
         (assert (= 1 reorders))
         (assert (equal (list second first third) (lut:children book)))
         (assert (equal '("Editor" "Appearance" "Tools") (lut:items book)))
         (assert (eq first (nth (lut:value book) (lut:children book)))))
       ;; Overflow scrolls independently; keyboard navigation reveals selection.
       (lut:layout root 0 0 400 50)
       (lut:dispatch root (lut:make-event :kind :wheel :x 20 :y 20 :delta -1))
       (assert (plusp (lut:tab-offset book)))
       (lut:focus root book)
       (lut:dispatch root (lut:make-event :kind :key :key :end))
       (assert (= 2 (lut:value book)))
       (assert (= 58 (lut:tab-offset book)))
       (assert (= 2 (lut:tab-at-position book 20 49)))
       (lut:layout root 0 0 400 180)
       (assert (zerop (lut:tab-offset book)))
       (assert (every (lambda (page) (eq book (lut:parent page))) (lut:children book))))
     (lut:dispose root))
   (assert (null (lut:items book))))
 (let ((empty (lut:make-widget 'lut:vertical-notebook)))
   (lut:layout empty 0 0 20 20)
   (assert (null (lut:active-children empty)))
   (assert (null (lut:tab-at-position empty 1 1)))
   (lut:dispose empty))
 (format t "Vertical notebook layout, input, scrolling and optional reordering passed.~%"))
