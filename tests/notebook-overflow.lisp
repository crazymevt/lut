(in-package #:lut-tests)
(defun overflow-fixture (&optional (count 10))
 (let* ((root (lut:make-widget 'lut:window :width 320 :height 200 :content-layout :fill))
        (book (lut:add-child root (lut:make-widget 'lut:notebook :reorderable-p t
                    :items (loop for i below count collect (format nil "Tab ~d" i))))))
   (dotimes (i count) (lut:add-child book (lut:make-widget 'lut:entry :text (format nil "Page ~d" i))))
   (lut:layout root 0 0 320 200) (values root book)))
(defun notebook-overflow-tests ()
 (multiple-value-bind (root book) (overflow-fixture)
   (multiple-value-bind (tab left viewport button extent) (lut::tab-strip-geometry book)
     (declare (ignore tab extent))
     (assert (plusp button)) (assert (plusp viewport))
     (assert (null (lut:tab-at-position book 2 10)))
     (assert (zerop (lut:tab-at-position book (+ left 5) 10)))
     ;; Navigation controls scroll without selecting or arming a tab drag.
     (drag-event root :down 318 10) (drag-event root :up 318 10)
     (assert (plusp (lut:tab-offset book))) (assert (zerop (lut:value book)))
     (assert (null (lut:current-drag root)))
     (assert (plusp (lut:tab-at-position book (+ left 5) 10)))
     (let ((before (lut:tab-offset book)))
       (lut:dispatch root (lut:make-event :kind :wheel :x (+ left 20) :y 10 :delta -1))
       (assert (> (lut:tab-offset book) before)))
     ;; Keyboard selection immediately reveals the selected page.
     (lut:focus root book) (drag-event root :key 0 0 :left)
     (assert (= 9 (lut:value book)))
     (assert (= (lut:tab-offset book) (lut::tab-scroll-limit book)))
     (assert (= 9 (lut:tab-at-position book (- (+ left viewport) 5) 10)))
     (lut:select-page book 0) (assert (zerop (lut:tab-offset book)))
     ;; Dragging near the edge scrolls the strip and uses the exposed tab index.
     (let ((page (first (lut:children book))))
       (drag-event root :down (+ left 10) 10)
       (dotimes (i 30) (drag-event root :move (- (+ left viewport) 3) 10))
       (assert (plusp (lut:tab-offset book)))
       (let ((boundary (lut::notebook-drop-index book (- (+ left viewport) 3))))
         (assert (> boundary 2))
         (drag-event root :up (- (+ left viewport) 3) 10)
         (assert (eq page (nth (1- boundary) (lut:children book)))))
       (assert (null (lut:current-drag root)))))
   ;; Resizing to fit removes controls and clamps the old scroll offset.
   (lut:layout root 0 0 2000 200)
   (assert (zerop (lut:tab-offset book)))
   (multiple-value-bind (tab left viewport button) (lut::tab-strip-geometry book)
     (declare (ignore tab left viewport)) (assert (zerop button)))
   (assert (not (lut:handle-event book (lut:make-event :kind :wheel :x 20 :y 10 :delta 1))))
   ;; Narrow strips keep distinct left/right drag scrolling zones.
   (lut:layout root 0 0 70 200) (lut:select-page book 0)
   (multiple-value-bind (tab left viewport) (lut::tab-strip-geometry book)
     (declare (ignore tab))
     (drag-event root :down (+ left 1) 10)
     (drag-event root :move (- (+ left viewport) 1) 10)
     (assert (plusp (lut:tab-offset book)))
     (drag-event root :key 0 0 :escape))
   ;; Very small/zero widths remain safe and do not hit hidden tabs.
   (dolist (width '(20 0))
     (lut:layout root 0 0 width 200)
     (assert (null (lut:tab-at-position book 1 10)))))
 ;; Last-page removal and caption changes clamp/reveal on layout.
 (multiple-value-bind (root book) (overflow-fixture)
   (lut:select-page book 9)
   (dolist (page (subseq (copy-list (lut:children book)) 1)) (lut:remove-child book page))
   (setf (lut:items book) '("Only"))
   (lut:layout root 0 0 320 200)
   (assert (zerop (lut:tab-offset book))))
 ;; Modifier data is available to custom input handlers, independent of aliases.
 (let* ((root (lut:make-widget 'lut:window)) (seen nil)
        (event (lut:make-event :kind :key :key :copy :base-key :c
                              :shift-p t :control-p nil :alt-p t :super-p t)))
   (lut:on root :key (lambda (w e) (declare (ignore w)) (setf seen e)))
   (lut:dispatch root event)
   (assert (eq event seen)) (assert (eq :copy (lut:event-key seen)))
   (assert (eq :c (lut:event-base-key seen)))
   (assert (lut:event-shift-p seen)) (assert (lut:event-alt-p seen))
   (assert (lut:event-super-p seen)) (assert (not (lut:event-control-p seen))))
 (format t "Notebook overflow controls, wheel/keyboard reveal, drag scrolling, resize and modifier input checks passed.~%"))
