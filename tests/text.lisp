(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/raylib")
(let* ((w (lut:make-widget 'lut:window :width 400 :height 200))
       (field (lut:make-widget 'lut:entry :text "Long Unicode text: Καλημέρα κόσμε — Привет мир — Καλημέρα κόσμε — Привет мир"))
       (checked nil))
 (lut:add-child w field) (lut:focus w field) (lut:select-all field)
 (lut:on w :tick (lambda (w dt) (declare (ignore w dt))
   (let* ((font (lut::widget-font field)) (index (rl:get-glyph-index font (char-code #\λ))))
       (assert (= (char-code #\λ) (rl:glyph-info-value (rl:get-glyph-info font (char-code #\λ)))))
       (assert (>= index 0))
       (assert (= (lut:text-width field "Καλημέρα")
                  (rl:vector2-x (rl:measure-text-ex font "Καλημέρα"
                    (lut:style-value field :font-size) (lut:style-value field :font-spacing))))))
   (when (plusp (lut:text-offset field)) (setf checked t))))
 (lut:run w :frames 3)
 (assert checked)
 (format t "Unicode glyph loading, whole-string metrics and horizontal scrolling passed.~%"))
