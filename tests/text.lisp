(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lui.asd"))
(ql:quickload "lui/raylib")
(let* ((w (lui:make-widget 'lui:window :width 400 :height 200))
       (field (lui:make-widget 'lui:entry :text "Long Unicode text: Καλημέρα κόσμε — Привет мир — Καλημέρα κόσμε — Привет мир"))
       (checked nil))
 (lui:add-child w field) (lui:focus w field) (lui:select-all field)
 (lui:on w :tick (lambda (w dt) (declare (ignore w dt))
   (let* ((font (lui::widget-font field)) (index (rl:get-glyph-index font (char-code #\λ))))
       (assert (= (char-code #\λ) (rl:glyph-info-value (rl:get-glyph-info font (char-code #\λ)))))
       (assert (>= index 0))
       (assert (= (lui:text-width field "Καλημέρα")
                  (rl:vector2-x (rl:measure-text-ex font "Καλημέρα"
                    (lui:style-value field :font-size) (lui:style-value field :font-spacing))))))
   (when (plusp (lui:text-offset field)) (setf checked t))))
 (lui:run w :frames 3)
 (assert checked)
 (format t "Unicode glyph loading, whole-string metrics and horizontal scrolling passed.~%"))
