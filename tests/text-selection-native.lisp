(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(asdf:load-system "lut/examples")
(let* ((root (lut-examples:text-selection)) (view (lut:find-widget root :selection-view))
       (peer (lut:find-widget root :selection-peer)) (buffer (lut:view-buffer view)) (frame 0) (checked nil))
 (lut:on root :tick (lambda (w dt)
   (declare (ignore w dt))
   (case (incf frame)
     (2
       (lut:focus root view) (setf (lut:cursor view) 8 (slot-value view 'lut::anchor) 8)
       (lut:dispatch root (lut:make-event :kind :key :key :right :control-p t :shift-p t))
       (assert (string= "αβγ_words" (lut:selected-text view)))
       (multiple-value-bind (px py) (lut:text-position-rectangle view 8)
         (dolist (count '(2 3))
           (lut:dispatch root (lut:make-event :kind :down :x (+ px 1) :y (+ py 5) :click-count count))
           (lut:dispatch root (lut:make-event :kind :up :x (+ px 1) :y (+ py 5)))
           (if (= count 2) (assert (string= "αβγ_words" (lut:selected-text view)))
               (assert (char= #\Newline (char (lut:selected-text view) (1- (length (lut:selected-text view)))))))))
       (let ((px (+ (lut:x view) (lut:width view) 40)) (py (+ (lut:y view) (lut:height view) 50)))
         (lut:dispatch root (lut:make-event :kind :down :x (+ (lut:x view) 20) :y (+ (lut:y view) 20)))
         (lut:dispatch root (lut:make-event :kind :move :x px :y py))
         (dotimes (i 3) (assert (lut:advance-text-selection root 0.1)))
         (assert (plusp (lut:text-offset view))) (assert (plusp (lut:vertical-offset view)))
         (assert (zerop (lut:text-offset peer))) (assert (zerop (lut:vertical-offset peer)))
         (lut:dispatch root (lut:make-event :kind :up :x px :y py))
         (assert (not (lut:advance-text-selection root 0.1))))
       (assert (zerop (lut:buffer-revision buffer)))
       ;; A read-only consumer can finish selecting while model-only output
       ;; arrives; appending must preserve the peer's capture and viewport.
       (let* ((px (+ (lut:x peer) 20)) (py (+ (lut:y peer) 20))
              (end (lut:text-length buffer)))
         (lut:dispatch root (lut:make-event :kind :down :x px :y py))
         (assert (eq peer (first (slot-value root 'lut::text-selection-state))))
         (lut:replace-buffer-range buffer end end (format nil "Incoming output~%"))
         (assert (eq peer (first (slot-value root 'lut::text-selection-state))))
         (lut:dispatch root (lut:make-event :kind :move :x (+ px 60) :y py))
         (assert (plusp (length (lut:selected-text peer))))
         (lut:dispatch root (lut:make-event :kind :up :x (+ px 60) :y py))
         (assert (null (slot-value root 'lut::text-selection-state)))
         (assert (zerop (lut:text-offset peer))) (assert (zerop (lut:vertical-offset peer))))
       (setf checked t))
     (3
       (let ((texture (rl:load-render-texture (round (lut:width root)) (round (lut:height root)))))
         (unwind-protect
             (progn
               (rl:with-texture-mode (texture)
                 (rl:clear-background (lut:style-value root :background)) (lut::render-window root))
               (let ((image (rl:load-image-from-texture (rl:render-texture-texture texture))))
                 (unwind-protect
                     (progn (rl:image-flip-vertical image) (rl:export-image image "/tmp/lut-text-selection.png"))
                   (rl:unload-image image))))
           (rl:unload-render-texture texture)))))))
 (unwind-protect (progn (lut:run root :frames 4) (assert checked))
   (lut:dispose root) (lut:dispose buffer)))
;; Worker IPC must preserve explicit click counts, timestamp-based repetition,
;; and independent shortcut modifiers. The controller owns the shared views.
(let* ((root (lut:make-widget 'lut:window :width 320 :height 180))
       (buffer (lut:make-text-buffer :text (format nil "Line 0: αβγ_words, punctuation!~%second line")))
       (a (lut:add-child root (lut:make-widget 'lut:text-view :view-buffer buffer)))
       (dialog (lut:make-widget 'lut:dialog :text "Selection peer" :width 360 :height 200))
       (b (lut:add-child dialog (lut:make-widget 'lut:text-view :view-buffer buffer)))
       (remote nil) (phase :open) (px 0) (py 0)
       (deadline (+ (get-internal-real-time) (* 15 internal-time-units-per-second))))
 (labels ((send-event (&rest args)
            (lut:evaluate-in-window remote (list `(lut::forward-native-event (lut:make-event ,@args))))))
   (lut:on root :tick (lambda (w dt)
     (declare (ignore w dt))
     (when (> (get-internal-real-time) deadline) (error "Selection peer timeout: ~a" phase))
     (when (and remote (lut::remote-window-error remote)) (error (lut::remote-window-error remote)))
     (case phase
       (:open
         (lut:show-dialog root dialog)
         (let ((host (lut::root-of b)))
           (setf remote (find host lut::*remote-windows* :key #'lut::remote-window-root))
           (assert remote) (lut:focus host b))
         (setf phase :ready))
       (:ready
         (when (>= (lut::remote-window-frames remote) 2)
           (multiple-value-bind (x y) (lut:text-position-rectangle b 8) (setf px (+ x 1) py (+ y 5)))
           (send-event :kind :down :x px :y py :click-count 2 :timestamp 1)
           (send-event :kind :up :x px :y py)
           (setf phase :word)))
       (:word
         (when (equal '(8 17) (multiple-value-list (lut:selection b)))
           (assert (zerop (lut:cursor a)))
           (loop for time in '(10 10.2 10.4) do
             (send-event :kind :down :x px :y py :timestamp time)
             (send-event :kind :up :x px :y py))
           (setf phase :line)))
       (:line
         (when (equal (list 0 (1+ (nth-value 1 (lut:text-line-range buffer 0)))) (multiple-value-list (lut:selection b)))
           (send-event :kind :key :key :home :control-p t)
           (send-event :kind :key :key :right :control-p t :shift-p t)
           (setf phase :key)))
       (:key
         (when (equal '(0 5) (multiple-value-list (lut:selection b)))
           (assert (zerop (lut:cursor a))) (assert (zerop (lut:buffer-revision buffer)))
           (lut:dismiss-dialog dialog) (setf phase :closing)))
       (:closing
         (when (null (lut::remote-window-root remote))
           (assert (lut:disposed-p b))
           (assert (null (slot-value root 'lut::text-selection-state)))
           (setf phase :done) (lut:stop))))))
   (unwind-protect (progn (lut:run root :frames 1500) (assert (eq phase :done)))
     (lut:dispose root) (lut:dispose buffer))))
(format t "Native word/line selection, reveal/autoscroll, independent views, worker click/timestamp/modifier IPC and cleanup passed; /tmp/lut-text-selection.png.~%")
