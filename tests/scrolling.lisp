(in-package #:lut-tests)
(defclass unit-scroll-text (lut:text-view) ())
(defmethod lut:text-width ((view unit-scroll-text) string) (declare (ignore view)) (length string))
(defclass bounded-reveal-text (unit-scroll-text) ())
(defvar *reveal-measured-characters* 0)
(defvar *reveal-horizontal-queries* 0)
(defmethod lut::map-text-run-advances :around ((view bounded-reveal-text) string function)
 (declare (ignore function))
 (incf *reveal-measured-characters* (length string)) (call-next-method))
(defmethod lut:scroll-geometry :around ((view bounded-reveal-text) &optional (axis :vertical))
 (when (eq axis :horizontal) (incf *reveal-horizontal-queries*)) (call-next-method))
(defun bounded-horizontal-reveal-tests ()
 (let* ((*reveal-measured-characters* 0) (*reveal-horizontal-queries* 0)
        (line-size 4096)
        (string (format nil "~{~a~^~%~}" (make-list 512 :initial-element (make-string line-size :initial-element #\a))))
        (view (lut:make-widget 'bounded-reveal-text :text string :width 10 :height 4
                 :style '(:padding 0 :font-size 1 :line-height 2 :caret-width 1))))
   (unwind-protect
       (progn
         (setf (lut:cursor view) 2 (slot-value view 'lut::anchor) 1)
         (dolist (request '((400 8 3 256) (3 15 4 256) (500 2048 4 2304)))
           (destructuring-bind (line column length bound) request
             (setf *reveal-measured-characters* 0)
             (let ((start (+ (* line (1+ line-size)) column)))
               (lut:reveal-text-range view start (+ start length))
               (assert (<= *reveal-measured-characters* bound))
               (assert (zerop *reveal-horizontal-queries*))
               (assert (= (max 0 (- (+ column length) 10)) (lut:text-offset view)))
               (assert (= 2 (lut:cursor view)))
               (assert (string= "a" (lut:selected-text view)))
               (setf *reveal-measured-characters* 0)
               (lut:reveal-text-range view start (+ start length))
               (assert (zerop *reveal-measured-characters*)))))
         ;; A caller-supplied content rectangle needs no text measurement at all.
         (setf *reveal-measured-characters* 0)
         (lut:reveal-rectangle view 3000 10 4 2)
         (assert (= 2994 (lut:text-offset view)))
         (lut:reveal-rectangle view -4 10 1 2)
         (assert (zerop (lut:text-offset view)))
         (assert (zerop *reveal-measured-characters*))
         (assert (zerop *reveal-horizontal-queries*)))
     (lut:dispose view))))
(defun scrolling-tests ()
 (dropdown-scrollbar-regression-tests)
 (plain-list-scrollbar-tests)
 (bounded-horizontal-reveal-tests)
 (let* ((outer (lut:make-widget 'lut:scroll-view :style '(:padding 0) :spacing 0))
        (filler (lut:add-child outer (lut:make-widget 'lut:widget :height 60)))
        (inner (lut:add-child outer (lut:make-widget 'lut:scroll-view :height 40 :spacing 0 :style '(:padding 0)))))
   (lut:add-child inner (lut:make-widget 'lut:widget :height 60))
   (let ((target (lut:add-child inner (lut:make-widget 'lut:button :height 10))))
     (lut:layout outer 10 20 100 40)
     (assert (equal '(100 40 0) (multiple-value-list (lut:scroll-geometry outer))))
     (lut:reveal-widget target)
     (assert (= 30 (lut:scroll-offset inner))) (assert (= 60 (lut:scroll-offset outer)))
     (assert (= 50 (lut:y target)))
     (assert (eq target (lut:hit-test outer (+ (lut:x target) 1) (+ (lut:y target) 1))))
     (lut:scroll-to outer -100) (assert (zerop (lut:scroll-offset outer)))
     (lut:scroll-to outer 999) (assert (= 60 (lut:scroll-offset outer)))
     (lut:set-follow-end outer t :distance 5)
     (assert (= 55 (lut:scroll-offset outer)))
     (let ((extra (lut:add-child outer (lut:make-widget 'lut:widget :height 20))))
       (lut:layout outer 10 20 100 40)
       (assert (= 75 (lut:scroll-offset outer)))
       (assert (= 5 (lut:follow-end-distance outer)))
       (lut:set-follow-end outer nil)
       (setf (lut:height extra) 40)
       (lut:layout outer 10 20 100 40)
       (assert (= 75 (lut:scroll-offset outer)))
       (lut:set-follow-end outer t)
       (assert (= 100 (lut:scroll-offset outer)))
       (lut:remove-child outer extra :dispose t)
       (lut:layout outer 10 20 100 40)
       (assert (= 60 (lut:scroll-offset outer))))
     (setf (lut:visible-p filler) nil)
     (lut:layout outer 10 20 100 40)
     (assert (zerop (lut:scroll-offset outer))))
   (lut:dispose outer)
   (assert (null (slot-value outer 'lut::scroll-follow-distance))))
 (let ((view (lut:make-widget 'unit-wrapped-text :text "abcdefghijklmnopqrst" :width 4 :height 4
               :style '(:padding 0 :font-size 1 :line-height 2))))
   (assert (equal '(10 4 0) (multiple-value-list (lut:scroll-geometry view))))
   (lut:set-follow-end view t :distance 2) (assert (= 4 (lut:vertical-offset view)))
   (setf (lut:text view) "abcdefghijklmnopqrstuvwx")
   (lut:layout view 0 0 4 4) (assert (= 6 (lut:vertical-offset view)))
   (lut:layout view 0 0 2 4) (assert (= 18 (lut:vertical-offset view)))
   (lut:set-follow-end view nil)
   (setf (lut:text view) "abcdefghijklmnopqrstuvwxyz12")
   (lut:layout view 0 0 2 4) (assert (= 18 (lut:vertical-offset view)))
   (setf (lut:cursor view) 2 (slot-value view 'lut::anchor) 1)
   (lut:reveal-text-range view 0 1) (assert (zerop (lut:vertical-offset view)))
   (assert (= 2 (lut:cursor view))) (assert (string= "b" (lut:selected-text view)))
   (lut:reveal-text-range view 27 28) (assert (= 24 (lut:vertical-offset view)))
   (lut:reveal-text-range view 28 28) (assert (= 24 (lut:vertical-offset view)))
   (assert (equal '(2 2 0) (multiple-value-list (lut:scroll-geometry view :horizontal))))
   (lut:scroll-to view 99 :axis :horizontal) (assert (zerop (lut:text-offset view)))
   (setf (lut:text view) (format nil "ab~%~%cd~%"))
   (lut:layout view 0 0 4 4)
   (lut:reveal-text-range view 2 3) ; newline-only range on a nonempty row
   (assert (zerop (lut:vertical-offset view)))
   (lut:reveal-text-range view 3 4) ; empty paragraph
   (lut:reveal-text-range view 7 7) ; trailing newline's empty EOF row
   (assert (= 4 (lut:vertical-offset view)))
   (assert (handler-case (progn (lut:reveal-text-range view 3 2) nil) (error () t)))
   (lut:dispose view)
   (assert (handler-case (progn (lut:scroll-geometry view) nil) (error () t))))
 (let ((view (lut:make-widget 'unit-wrapped-document
               :text (format nil "Heading~%~a~%Body" (code-char #xfffc)) :width 20 :height 6
               :paragraph-spacing 3 :style '(:padding 0 :font-size 1 :line-height 2))))
   (lut:set-text-presentation view :runs '((:start 0 :end 7 :style (:font-size 5)))
     :images '((:position 8 :source "examples/assets/demo.png" :width 8 :height 12)))
   (lut:reveal-text-range view 8 9) (assert (= 8 (lut:vertical-offset view)))
   (lut:reveal-text-range view 10 14) (assert (= 19 (lut:vertical-offset view)))
   (lut:set-follow-end view t)
   (lut:reveal-text-range view 0 1) (assert (zerop (lut:vertical-offset view)))
   (assert (= 0 (lut:follow-end-distance view)))
   (lut:layout view 0 0 20 6) (assert (= 19 (lut:vertical-offset view)))
   (lut:dispose view))
 (let ((view (lut:make-widget 'unit-scroll-text :text "abcdefghij" :width 4 :height 2
               :style '(:padding 0 :font-size 1 :line-height 2 :caret-width 1))))
   (assert (equal '(11 4 0) (multiple-value-list (lut:scroll-geometry view :horizontal))))
   (lut:reveal-text-range view 8 10) (assert (= 6 (lut:text-offset view)))
   (lut:scroll-to view 99 :axis :horizontal) (assert (= 7 (lut:text-offset view)))
   (lut:reveal-text-range view 0 0) (assert (zerop (lut:text-offset view)))
   (lut:dispose view))
 (let* ((outer (lut:make-widget 'lut:scroll-view :spacing 0 :style '(:padding 0)))
        (spacer (lut:add-child outer (lut:make-widget 'lut:widget :height 30)))
        (view (lut:add-child outer (lut:make-widget 'unit-wrapped-text :text "abcdefghijklmnop"
                 :height 4 :style '(:padding 0 :font-size 1 :line-height 2)))))
   (declare (ignore spacer))
   (lut:layout outer 10 20 4 10)
   ;; Scrollbar consumes width at this allocation: allocate a wider outer box,
   ;; then use explicit newlines so vertical text geometry is independent of it.
   (setf (lut:text view) (format nil "a~%b~%c~%d"))
   (lut:layout outer 10 20 100 10)
   (lut:reveal-text-range view 6 7)
   (assert (= 4 (lut:vertical-offset view)))
   (assert (= 24 (lut:scroll-offset outer)))
   (assert (<= (lut:y outer) (+ (nth-value 1 (lut:text-position-rectangle view 6)) 1)
               (+ (lut:y outer) (lut:height outer))))
   (lut:dispose outer))
 (let* ((model (lut:make-vector-model '(a b c d e)))
        (view (lut:make-widget 'lut:model-table-view :model model :table-columns (list (lut:make-data-column :id :item :title "Item" :getter #'identity))
                :height 6 :style '(:row-height 2))))
   (assert (equal '(10 4 0) (multiple-value-list (lut:scroll-geometry view))))
   (lut:set-follow-end view t) (assert (= 6 (lut:scroll-offset view)))
   (lut:dispose model)
   (lut:layout view 0 0 100 6) (assert (zerop (lut:scroll-offset view)))
   (lut:dispose view))
 (let ((view (lut:make-widget 'lut:list-view :items '("a" "b" "c") :height 2 :style '(:row-height 2))))
   (lut:reveal-rectangle view 0 4 10 2) (assert (= 4 (lut:scroll-offset view)))
   (lut:set-follow-end view t :distance 99) (assert (zerop (lut:scroll-offset view)))
   (lut:dispose view))
 (let ((widget (lut:make-widget 'lut:widget)))
   (assert (handler-case (progn (lut:scroll-geometry widget) nil) (error () t)))
   (assert (handler-case (progn (lut:set-follow-end widget t) nil) (error () t)))
   (lut:dispose widget))
 (format t "Public scroll geometry, clamping, nested child/text reveal, empty ranges, selection preservation, follow distance/pause/resize/shrink, model disposal and lifecycle passed.~%"))


(defun plain-list-scrollbar-tests ()
 (let* ((root (lut:make-widget 'lut:window :content-layout :fill))
        (view (lut:add-child root (lut:make-widget 'lut:list-view :value 0
                  :items (loop for i below 30 collect (format nil "Row ~d" i)))))
        (changes 0))
   (unwind-protect
     (progn
       (lut:on view :change (lambda (w v) (declare (ignore w v)) (incf changes)))
       (lut:layout root 0 0 200 120)
       (assert (= (* 30 (lut:row-height view)) (lut::scrollbar-extent view)))
       (multiple-value-bind (sx sy sw sh travel) (lut::scrollbar-bounds view)
         (assert (plusp travel)) (assert (< sh (lut:height view)))
         ;; Track clicks and thumb drag preserve the row selection.
         (lut:dispatch root (lut:make-event :kind :down :x (+ sx (/ sw 2)) :y (+ sy (/ sh 2))))
         (lut:dispatch root (lut:make-event :kind :move :x (+ sx (/ sw 2)) :y 500))
         (lut:dispatch root (lut:make-event :kind :up :x (+ sx (/ sw 2)) :y 500))
         (assert (= (lut::scrollbar-range view) (lut:scroll-offset view)))
         (assert (zerop changes)) (assert (zerop (lut:value view)))
         (assert (null (lut::interaction-state root)))
         (lut:dispatch root (lut:make-event :kind :down :x (+ sx (/ sw 2)) :y 1))
         (lut:dispatch root (lut:make-event :kind :up :x (+ sx (/ sw 2)) :y 1))
         (assert (zerop (lut:scroll-offset view))))
       ;; The strip returns to ordinary list content when nothing overflows.
       (lut:scroll-to view (lut::scrollbar-range view))
       (setf (lut:items view) '("Only row"))
       (lut:layout root 0 0 200 120)
       (assert (zerop (lut:scroll-offset view)))
       (assert (zerop (lut::scrollbar-range view)))
       (lut:dispatch root (lut:make-event :kind :down :x 190 :y 10))
       (lut:dispatch root (lut:make-event :kind :up :x 190 :y 10))
       (assert (= 1 changes))
       (lut:layout view 0 0 0 0)
       (assert (every (lambda (v) (and (realp v) (not (minusp v)))) (multiple-value-list (lut::scrollbar-bounds view)))))
     (lut:dispose root)))
 ;; A fitting child list must not block its parent's scrollbar capture.
 (let* ((root (lut:make-widget 'lut:window :content-layout :fill))
        (outer (lut:add-child root (lut:make-widget 'lut:scroll-view :style '(:padding 0))))
        (inner (lut:add-child outer (lut:make-widget 'lut:list-view :items '("One row") :height 40))))
   (lut:add-child outer (lut:make-widget 'lut:label :height 200))
   (unwind-protect
     (progn
       (lut:layout root 0 0 200 120)
       (assert (zerop (lut::scrollbar-range inner)))
       (lut:dispatch root (lut:make-event :kind :down :x 194 :y 20))
       (assert (eq outer (second (lut::interaction-state root))))
       (lut:dispatch root (lut:make-event :kind :move :x 194 :y 500))
       (lut:dispatch root (lut:make-event :kind :up :x 194 :y 500))
       (assert (= (lut::scrollbar-range outer) (lut:scroll-offset outer))))
     (lut:dispose root)))
 ;; Rendering and input must agree on the supported plain-list geometry.
 (dolist (class '(lut:tree-view lut:table-view))
   (let ((view (lut:make-widget class)))
     (assert (not (lut::scrollbar-view-p view))) (lut:dispose view))))


(defun dropdown-scrollbar-regression-tests ()
 (dolist (count '(4 20))
   (let* ((root (lut:make-widget 'lut:window))
          (dropdown (lut:add-child root (lut:make-widget 'lut:dropdown :height 36 :value 0
                      :items (loop for i below count collect (format nil "Choice ~d" i))))))
     (unwind-protect
       (progn
         (lut:layout root 0 0 300 320)
         (let ((x (- (+ (lut:x dropdown) (lut:width dropdown)) 4))
               (y (+ (lut:y dropdown) 18)))
           ;; The arrow strip belongs to the closed control, not a scrollbar.
           (lut:dispatch root (lut:make-event :kind :down :x x :y y))
           (assert (lut:expanded-p dropdown))
           (assert (null (lut::interaction-state root)))
           (lut:dispatch root (lut:make-event :kind :up :x x :y y)))
         (assert (not (lut::scrollbar-view-p dropdown)))
         (assert (zerop (lut:scroll-offset dropdown)))
         (let* ((popup (first (lut::overlays root))) (list (first (lut:children popup))))
           (assert (typep list 'lut::selection-list))
           (assert (lut::scrollbar-view-p list))
           ;; The open popup still has a real scrolling list when it overflows.
           (when (> count 4)
             (assert (plusp (lut::scrollbar-range list)))
             (multiple-value-bind (sx sy sw sh) (lut::scrollbar-bounds list)
               (let ((x (+ sx (/ sw 2))))
                 (lut:dispatch root (lut:make-event :kind :down :x x :y (+ sy (/ sh 2))))
                 (lut:dispatch root (lut:make-event :kind :move :x x :y 500))
                 (lut:dispatch root (lut:make-event :kind :up :x x :y 500))))
             (assert (= (lut::scrollbar-range list) (lut:scroll-offset list)))
             (assert (zerop (lut:value dropdown)))
             (assert (lut:expanded-p dropdown)))))
       (lut:dispose root)))))
