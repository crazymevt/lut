(defpackage #:lut-tests (:use #:cl) (:export #:run-tests))
(in-package #:lut-tests)
(defun run-tests ()
 (let* ((w (lut:make-widget 'lut:window :width 600 :height 500))
        (field (lut:make-widget 'lut:entry :text "hello"))
        (b (lut:make-widget 'lut:button :text "Go")) (clicks 0))
   (lut:add-child w field) (lut:add-child w b)
   (assert (handler-case (progn (lut:add-child field w) nil) (error () t)))
   (setf (lut:style w) '(:font-size 22))
   (assert (= 22 (lut:style-value field :font-size)))
   (setf (lut:style field) '(:font-size 14))
   (assert (= 14 (lut:style-value field :font-size)))
   (lut:layout w 0 0 600 500)
   (assert (eq field (lut:hit-test w 12 12)))
   (lut:focus w field) (lut:select-all field)
   (assert (string= "hello" (lut:selected-text field)))
   (lut:dispatch w (lut:make-event :kind :text :text "world"))
   (assert (string= "world" (lut:text field)))
   (lut:dispatch w (lut:make-event :kind :key :key :backspace))
   (assert (string= "worl" (lut:text field)))
   (lut:dispatch w (lut:make-event :kind :key :key :tab))
   (assert (eq b (lut:focused-widget w)))
   (lut:on b :activate (lambda (node event) (declare (ignore node event)) (incf clicks)))
   (lut:dispatch w (lut:make-event :kind :key :key :enter))
   (assert (= 1 clicks))
   (lut:dispatch w (lut:make-event :kind :down :x 12 :y 56))
   (lut:dispatch w (lut:make-event :kind :up :x 12 :y 56))
   (assert (= 2 clicks))
   (let ((d (lut:make-widget 'lut:dialog)))
     (lut:show-dialog w d)
     (assert (null (lut:focused-widget w)))
     (lut:layout d 100 100 200 200)
     (lut:dispatch w (lut:make-event :kind :down :x 12 :y 56))
     (lut:dispatch w (lut:make-event :kind :up :x 12 :y 56))
     (assert (= 2 clicks))
     (assert (eq d (lut:close-dialog w))))
   (lut:focus w field) (lut:remove-child w field)
   (assert (null (lut:focused-widget w)))
   )
 (let* ((w (lut:make-widget 'lut:window))
        (list (lut:make-widget 'lut:list-view :height 80 :items '("a" "b" "c" "d" "e"))))
   (lut:add-child w list) (lut:layout w 0 0 500 500)
   (lut:dispatch w (lut:make-event :kind :wheel :x 12 :y 12 :delta -100))
   (assert (= (- (* (lut:row-height list) 5) 80) (lut:scroll-offset list))))
 (assert (handler-case (progn (lut:make-widget 'lut:box :orientation :diagonal) nil)
           (type-error () t)))
 (assert (handler-case (progn (lut:make-widget 'lut:slider :minimum 10 :value 0) nil)
           (error () t)))
 (let* ((w (lut:make-widget 'lut:window))
        (field (lut:make-widget 'lut:entry :text "abcdef")))
   (lut:add-child w field) (lut:focus w field) (lut:select-all field)
   (setf (lut:text field) "a")
   (assert (string= "a" (lut:selected-text field)))
   (setf (lut:enabled-p field) nil)
   (lut:dispatch w (lut:make-event :kind :text :text "bad"))
   (assert (string= "a" (lut:text field))))
 (dolist (orientation '(:horizontal :vertical))
   (let* ((w (lut:make-widget 'lut:window :content-layout :fill))
          (pane (lut:add-child w (lut:make-widget 'lut:paned :orientation orientation)))
          (horizontal (eq orientation :horizontal))
          (x (if horizontal 300 100)) (y (if horizontal 100 250))
          (expected (if horizontal :resize-ew :resize-ns)))
     (lut:add-child pane (lut:make-widget 'lut:label :text "First"))
     (lut:add-child pane (lut:make-widget 'lut:label :text "Second"))
     (lut:layout w 0 0 600 500)
     (assert (eq expected (lut:window-pointer-cursor w x y)))
     (assert (eq :default (lut:window-pointer-cursor w 50 50)))
     (lut:dispatch w (lut:make-event :kind :down :x x :y y))
     (assert (eq expected (lut:window-pointer-cursor w 50 50)))
     (lut:dispatch w (lut:make-event :kind :up :x 50 :y 50))
     (assert (eq :default (lut:window-pointer-cursor w 50 50)))
     (let ((dialog (lut:make-widget 'lut:dialog)))
       (lut:show-dialog w dialog)
       (lut:layout dialog 0 0 50 50)
       (assert (eq :default (lut:window-pointer-cursor w x y)))
       (lut:close-dialog w))
     (setf (lut:enabled-p pane) nil)
     (assert (eq :default (lut:window-pointer-cursor w x y)))
     (setf (lut:enabled-p pane) t (lut:visible-p pane) nil)
     (assert (eq :default (lut:window-pointer-cursor w x y)))))
 (format t "LUT core checks passed.~%") t)
