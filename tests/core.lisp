(defpackage #:lui-tests (:use #:cl) (:export #:run-tests))
(in-package #:lui-tests)
(defun run-tests ()
 (let* ((w (lui:make-widget 'lui:window :width 600 :height 500))
        (field (lui:make-widget 'lui:entry :text "hello"))
        (b (lui:make-widget 'lui:button :text "Go")) (clicks 0))
   (lui:add-child w field) (lui:add-child w b)
   (assert (handler-case (progn (lui:add-child field w) nil) (error () t)))
   (setf (lui:style w) '(:font-size 22))
   (assert (= 22 (lui:style-value field :font-size)))
   (setf (lui:style field) '(:font-size 14))
   (assert (= 14 (lui:style-value field :font-size)))
   (lui:layout w 0 0 600 500)
   (assert (eq field (lui:hit-test w 12 12)))
   (lui:focus w field) (lui:select-all field)
   (assert (string= "hello" (lui:selected-text field)))
   (lui:dispatch w (lui:make-event :kind :text :text "world"))
   (assert (string= "world" (lui:text field)))
   (lui:dispatch w (lui:make-event :kind :key :key :backspace))
   (assert (string= "worl" (lui:text field)))
   (lui:dispatch w (lui:make-event :kind :key :key :tab))
   (assert (eq b (lui:focused-widget w)))
   (lui:on b :activate (lambda (node event) (declare (ignore node event)) (incf clicks)))
   (lui:dispatch w (lui:make-event :kind :key :key :enter))
   (assert (= 1 clicks))
   (lui:dispatch w (lui:make-event :kind :down :x 12 :y 56))
   (lui:dispatch w (lui:make-event :kind :up :x 12 :y 56))
   (assert (= 2 clicks))
   (let ((d (lui:make-widget 'lui:dialog)))
     (lui:show-dialog w d)
     (assert (null (lui:focused-widget w)))
     (lui:layout d 100 100 200 200)
     (lui:dispatch w (lui:make-event :kind :down :x 12 :y 56))
     (lui:dispatch w (lui:make-event :kind :up :x 12 :y 56))
     (assert (= 2 clicks))
     (assert (eq d (lui:close-dialog w))))
   (lui:focus w field) (lui:remove-child w field)
   (assert (null (lui:focused-widget w)))
   )
 (let* ((w (lui:make-widget 'lui:window))
        (list (lui:make-widget 'lui:list-view :height 80 :items '("a" "b" "c" "d" "e"))))
   (lui:add-child w list) (lui:layout w 0 0 500 500)
   (lui:dispatch w (lui:make-event :kind :wheel :x 12 :y 12 :delta -100))
   (assert (= (- (* (lui:row-height list) 5) 80) (lui:scroll-offset list))))
 (assert (handler-case (progn (lui:make-widget 'lui:box :orientation :diagonal) nil)
           (type-error () t)))
 (assert (handler-case (progn (lui:make-widget 'lui:slider :minimum 10 :value 0) nil)
           (error () t)))
 (let* ((w (lui:make-widget 'lui:window))
        (field (lui:make-widget 'lui:entry :text "abcdef")))
   (lui:add-child w field) (lui:focus w field) (lui:select-all field)
   (setf (lui:text field) "a")
   (assert (string= "a" (lui:selected-text field)))
   (setf (lui:enabled-p field) nil)
   (lui:dispatch w (lui:make-event :kind :text :text "bad"))
   (assert (string= "a" (lui:text field))))
 (format t "LUI core checks passed.~%") t)
