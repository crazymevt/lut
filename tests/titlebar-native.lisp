(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/raylib" :silent t)
#+darwin
(progn
 ;; Keep the explicit structure type visible to CFFI's macro expansion.
 (defun titlebar-test-event (window x y clicks &optional (type 1))
   (lut::cocoa-send (lut::cocoa-class "NSEvent")
     "mouseEventWithType:location:modifierFlags:timestamp:windowNumber:context:eventNumber:clickCount:pressure:"
     :unsigned-long type (:struct lut::cocoa-point) (list 'lut::x x 'lut::y y)
     :unsigned-long 0 :double 0d0 :long (lut::cocoa-send window "windowNumber" :long)
     :pointer (cffi:null-pointer) :long 1 :long clicks :float 1f0 :pointer))
 (loop repeat 2 do
 (let ((root (lut:make-widget 'lut:window :width 640 :height 400)) (checked nil))
   (lut:on root :tick
     (lambda (w dt)
       (declare (ignore w dt))
       (unless checked
         (let* ((window (rl:get-window-handle))
                (class (lut::cocoa-object-class window))
                (view (lut::cocoa-send window "contentView" :pointer))
                (rect (lut::cocoa-view-frame view))
                (top (+ (getf (getf rect 'lut::origin) 'lut::y)
                        (getf (getf rect 'lut::size) 'lut::height)))
                (title-y (+ top 10d0))
                (event (titlebar-test-event window 320d0 title-y 2)))
           (lut::install-cocoa-titlebar-zoom)
           (assert (cffi:pointer-eq class (lut::cocoa-object-class window)))
           (assert (lut::cocoa-titlebar-double-click-p window event))
           (assert (not (lut::cocoa-titlebar-double-click-p window (titlebar-test-event window 320d0 title-y 1))))
           (assert (not (lut::cocoa-titlebar-double-click-p window (titlebar-test-event window 320d0 100d0 2))))
           (assert (not (lut::cocoa-titlebar-double-click-p window (titlebar-test-event window 320d0 title-y 2 2))))
           ;; The traffic-light buttons must not zoom the window.
           (assert (not (lut::cocoa-titlebar-double-click-p window (titlebar-test-event window 20d0 title-y 2))))
           (assert (zerop (lut::cocoa-send window "isZoomed" :uint8)))
           (lut::cocoa-send window "sendEvent:" :pointer event :void)
           (assert (plusp (lut::cocoa-send window "isZoomed" :uint8)))
           (assert (rl:is-window-maximized))
           (lut::sync-native-window-state root)
           (assert (eq :maximized (lut:window-state root)))
           (setf rect (lut::cocoa-view-frame view)
                 top (+ (getf (getf rect 'lut::origin) 'lut::y) (getf (getf rect 'lut::size) 'lut::height)))
           (lut::cocoa-send window "sendEvent:" :pointer (titlebar-test-event window 320d0 (+ top 10d0) 2) :void)
           (assert (zerop (lut::cocoa-send window "isZoomed" :uint8)))
           (assert (not (rl:is-window-maximized)))
           (lut::sync-native-window-state root)
           (assert (eq :normal (lut:window-state root)))
           (assert (= 640 (rl:get-screen-width)))
           (assert (= 400 (rl:get-screen-height)))
           (setf checked t)))))
   (unwind-protect (progn (lut:run root :frames 3) (assert checked)) (lut:dispose root)))))
(format t "Native title-bar double-click zoom/restore passed.~%")
