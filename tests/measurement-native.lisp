(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/examples" :silent t)
(defun capture-measured-layout (root path)
 (let* ((scale (lut:ui-scale root))
        (target (rl:load-render-texture (round (* (lut:width root) scale)) (round (* (lut:height root) scale)))))
   (unwind-protect
     (progn
       (rl:with-texture-mode (target)
         (rl:clear-background (lut:style-value root :background)) (lut::render-window root))
       (let ((image (rl:load-image-from-texture (rl:render-texture-texture target))))
         (unwind-protect
           (progn (rl:image-flip-vertical image) (assert (rl:export-image image path)))
           (rl:unload-image image))))
     (rl:unload-render-texture target))))
(dolist (theme (list lut:*light-theme* lut:*dark-theme*))
 (dolist (scale '(1 5/4 2))
   (let* ((root (lut-examples:measured-layout))
          (prose (lut:find-widget root :measured-prose))
          (initial-text (lut:text prose))
          (flow (lut:find-widget root :measured-actions))
          (button (first (lut:children flow)))
          (frame 0) (checked nil))
     (setf (lut:theme root) theme (lut:ui-scale root) scale)
     (lut:on root :tick
       (lambda (w dt)
         (declare (ignore dt))
         (when (= 2 (incf frame))
           ;; Exercise actual font/render/input backends at explicit logical
           ;; allocations, independently of native window resize/DPI events.
           (lut:layout w 0 0 760 540)
           (let ((wide-height (lut:height prose)) (wide-row (lut:height flow)))
             (assert (= wide-height (nth-value 1 (lut:measure prose :vertical (lut:width prose)))))
             (lut:layout w 0 0 340 700)
             (assert (> (lut:height prose) wide-height))
             (assert (> (lut:height flow) wide-row))
             (assert (= (lut:height prose) (nth-value 1 (lut:measure prose :vertical (lut:width prose)))))
             (capture-measured-layout w
               (format nil "/tmp/lut-measured-~a-~d.png"
                 (if (eq theme lut:*light-theme*) "light" "dark") (round (* scale 100))))
             (let ((old (lut:text prose))
                   (x (* scale (+ (lut:x button) (/ (lut:width button) 2))))
                   (y (* scale (+ (lut:y button) (/ (lut:height button) 2)))))
               (dolist (kind '(:down :up))
                 (lut:dispatch-device-event w (lut:make-event :kind kind :x x :y y)))
               (assert (> (length (lut:text prose)) (length old))))
             (setf (lut:text prose) initial-text)
             (lut:layout w 0 0 760 540)
             (assert (= wide-height (lut:height prose)))
             (assert (= wide-row (lut:height flow)))
             (setf checked t)))))
     (unwind-protect
       (progn (lut:run root :frames 3) (assert checked))
       (lut:dispose root)))))
(format t "Measured light/dark rendering, explicit wide/narrow/wide allocation, paint-height agreement and 100/125/200% row input passed.~%")
