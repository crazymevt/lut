(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lui.asd"))
(ql:quickload "lui/raylib")
(let* ((w (lui:make-widget 'lui:window :width 500 :height 220))
       (secondary (lui:with-ui (lui:window :width 400 :height 200)
                    (lui:make-widget 'lui:label :text "Static scene")))
       (remote (lui::make-remote-window :root secondary)) (done nil))
 (setf lui:*window* w)
 (lui:on w :tick (lambda (window dt) (declare (ignore dt))
   (unless done
     (lui::layout-window secondary)
     (assert (stringp (lui::encode-remote-frame remote)))
     (assert (null (lui::encode-remote-frame remote)))
     (assert (= 1 (lui::remote-window-encoded-frames remote)))
     (setf (lui:text (first (lui:children secondary))) "Changed scene")
     (assert (stringp (lui::encode-remote-frame remote)))
     (assert (= 2 (lui::remote-window-encoded-frames remote)))
     ;; Resizing must invalidate the pixel comparison, even for identical colors.
     (lui::layout-window secondary 200 400)
     (assert (stringp (lui::encode-remote-frame remote)))
     (lui::finalize-remote-window remote)
     (assert (null (lui::remote-window-last-pixels remote)))
     (assert (null (lui::remote-window-last-size remote)))
     (lui:dispose window)
     (assert (null lui:*window*)) (assert (null lui::*primary-window*))
     (setf done t))))
 (lui:run w :frames 5)
 (assert done) (assert (null lui:*window*)) (assert (null lui::*primary-window*))
 (assert (null lui::*remote-windows*))
 (format t "F12 primary disposal and F14 unchanged-frame suppression checks passed.~%"))
