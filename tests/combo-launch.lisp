(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload '("lut/raylib" "lut/gtk-demo") :silent t)
(let* ((browser (lut-gtk-demo:browser)) (remote nil) (phase :launch)
       (deadline (+ (get-internal-real-time) (* 20 internal-time-units-per-second))))
  (lut:on browser :tick
    (lambda (w dt)
      (declare (ignore dt))
      (when (> (get-internal-real-time) deadline) (error "Combobox launch timed out at ~a" phase))
      (when (and remote (lut::remote-window-error remote)) (error (lut::remote-window-error remote)))
      (case phase
        (:launch
         ;; A formatted native warning must not leak onto a framed REPL's stdout.
         (cffi:with-foreign-object (points :int 2)
           (setf (cffi:mem-aref points :int 0) 65 (cffi:mem-aref points :int 1) #xf0000)
           (let ((font (rl:load-font-ex (asdf:system-relative-pathname "lut" "assets/NotoSans-Regular.ttf")
                                       18 points 2)))
             (assert (rl:is-font-valid font))
             (rl:unload-font font)))
         (lut:emit (lut:find-widget w :query) :change "cbx")
         (let* ((list (lut:find-widget w :demos))
                (index (position "combobox" (lut:items list) :test #'string=)))
           (assert index)
           (setf (lut:value list) index)
           (lut:emit list :change index)
           (lut:emit (lut:find-widget w :query) :activate nil)
           (setf remote (first lut::*remote-windows*) phase :opened)
           (assert remote)))
        (:opened
         (when (>= (lut::remote-window-frames remote) 3)
           (lut:on-window remote (rl:take-screenshot "/tmp/lut-combobox-closed.png"))
           (let* ((root (lut::remote-window-root remote)) (choice (lut:find-widget root :icons)))
             (lut:focus root choice)
             (lut:dispatch root (lut:make-event :kind :key :key :enter))
             (assert (lut:expanded-p choice))
             (setf phase :popup))))
        (:popup
         (when (>= (lut::remote-window-frames remote) 6)
           (lut:on-window remote (rl:take-screenshot "/tmp/lut-combobox-open.png"))
           (let* ((root (lut::remote-window-root remote))
                  (popup (first (slot-value root 'lut::overlays)))
                  (list (first (lut:children popup))))
             (assert (<= (+ (lut:y list) (* (length (lut:items list)) (lut:row-height list)))
                         (+ (lut:y popup) (lut:height popup))))
             (assert (eq (lut:focused-widget root) list))
             (lut:dispatch root (lut:make-event :kind :key :key :down))
             (assert (= (lut:value (lut:find-widget root :icons)) 0))
             (lut:dispatch root (lut:make-event :kind :key :key :enter))
             (assert (= (lut:value (lut:find-widget root :icons)) 1))
             (assert (not (lut:expanded-p (lut:find-widget root :icons))))
             (assert (search "Green" (lut:text (lut:find-widget root :status))))
             (let ((editable (lut:find-widget root :editable)))
               (lut:focus root editable)
               (lut:select-all editable) (lut:replace-selection editable "Custom city")
               (lut:dispatch root (lut:make-event :kind :down :x (+ (lut:x editable) 10) :y (+ (lut:y editable) 18)))
               (lut:dispatch root (lut:make-event :kind :up :x (+ (lut:x editable) 10) :y (+ (lut:y editable) 18)))
               (assert (not (lut:expanded-p editable)))
               (assert (string= (lut:text editable) "Custom city"))
               (assert (= (lut::selection-button-width editable) 36))
               (lut:dispatch root (lut:make-event :kind :down
                 :x (+ (lut::selection-button-x editable) 18) :y (+ (lut:y editable) 18)))
               (assert (lut:expanded-p editable)))
             (setf phase :combo-popup))))
        (:combo-popup
         (when (>= (lut::remote-window-frames remote) 9)
           (let* ((root (lut::remote-window-root remote))
                  (popup (first (slot-value root 'lut::overlays)))
                  (options (first (lut:children popup)))
                  (editable (lut:find-widget root :editable)))
             (lut:on-window remote (rl:take-screenshot "/tmp/lut-editable-combo-open.png"))
             (assert (eq (lut:focused-widget root) options))
             (lut:dispatch root (lut:make-event :kind :key :key :down))
             (lut:dispatch root (lut:make-event :kind :key :key :down))
             (assert (string= (lut:text editable) "Custom city"))
             (lut:dispatch root (lut:make-event :kind :key :key :enter))
             (assert (string= (lut:text editable) "Paris"))
             (assert (eq (lut:focused-widget root) editable))
             (assert (not (lut:expanded-p editable)))
             (assert (string= (lut:text (lut:find-widget root :status)) "Paris"))
             ;; Key-only open, navigation, cancellation and reopening: no Tab
             ;; or pointer events may be needed after focusing the owner.
             (lut:dispatch root (lut:make-event :kind :key :key :down))
             (lut:dispatch root (lut:make-event :kind :key :key :down))
             (assert (lut:expanded-p editable))
             (lut:dispatch root (lut:make-event :kind :key :key :escape))
             (assert (string= (lut:text editable) "Paris"))
             (assert (eq (lut:focused-widget root) editable))
             (assert (not (lut:expanded-p editable)))
             (lut:dispatch root (lut:make-event :kind :key :key :down))
             (lut:dispatch root (lut:make-event :kind :key :key :down))
             (lut:dispatch root (lut:make-event :kind :key :key :enter))
             (assert (string= (lut:text editable) "Boston"))
             (assert (eq (lut:focused-widget root) editable))
             (let ((choice (lut:find-widget root :icons)))
               (lut:focus root choice)
               (lut:dispatch root (lut:make-event :kind :key :key :down))
               (lut:dispatch root (lut:make-event :kind :key :key :down))
               (lut:dispatch root (lut:make-event :kind :key :key :escape))
               (assert (= (lut:value choice) 1))
               (assert (eq (lut:focused-widget root) choice))
               (lut:dispatch root (lut:make-event :kind :key :key :down))
               (lut:dispatch root (lut:make-event :kind :key :key :down))
               (lut:dispatch root (lut:make-event :kind :key :key :enter))
               (assert (= (lut:value choice) 2))
               (assert (not (lut:expanded-p choice)))
               (assert (eq (lut:focused-widget root) choice)))
             (setf phase :selected))))
        (:selected
         (when (>= (lut::remote-window-frames remote) 12)
           (lut:close-window remote) (setf phase :closing)))
        (:closing
         (when (null (lut::remote-window-process remote))
           (setf phase :done) (lut:stop))))))
  (lut:run browser :frames 1500)
  (assert (eq phase :done))
  (assert (null (lut::remote-window-error remote))))
(format t "Launcher combobox worker, dropdown popup, selection and cleanup passed.~%")
