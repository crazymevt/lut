(in-package #:lut-tests)

(defun data-model-tests ()
 (row-icon-tests)
 (virtual-model-tests)
 (model-hover-tests)
 (model-selection-tests)
 (projection-tree-tests)
 (table-cell-tests)
 (format t "Lazy viewport bounds, keyed selection, sorted/filtered/tree identity, cell factories/editing and model lifecycle passed.~%"))
(defun virtual-model-tests ()
 (let* ((calls 0) (count 1000000)
        (model (lut:make-function-model :count (lambda () count) :item (lambda (i) (incf calls) i)
                 :index (lambda (key) (when (and (integerp key) (<= 0 key) (< key count)) key))))
        (view (lut:make-widget 'lut:model-list-view :model model :width 200 :height 65 :style '(:row-height 20))))
   (assert (zerop calls)) (assert (null (lut:children view))) (assert (null (lut:items view)))
   (assert (equal '(0 4) (multiple-value-list (lut:visible-model-range view))))
   (let ((seen nil))
     (assert (= 4 (lut:map-visible-model-rows view (lambda (i key item x y w h)
       (declare (ignore x y w h)) (assert (= i key item)) (push i seen)))))
     (assert (equal '(3 2 1 0) seen)))
   (assert (= 4 calls))
   (lut:reveal-model-index view 999999)
   (assert (equal '(999996 1000000) (multiple-value-list (lut:visible-model-range view))))
   (lut:map-visible-model-rows view (lambda (&rest row) (declare (ignore row))))
   (assert (= 8 calls))
   (setf count 2) (lut:notify-model-change model)
   (assert (zerop (lut:scroll-offset view)))
   (lut:handle-event view (lut:make-event :kind :wheel :delta 10))
   (assert (zerop (lut:scroll-offset view)))
   (setf (lut:height view) 0)
   (assert (equal '(0 0) (multiple-value-list (lut:visible-model-range view))))
   (let ((selection (lut:view-selection view)))
     (lut:dispose view) (assert (lut:disposed-p selection)) (assert (not (lut:disposed-p model))))
   (lut:dispose model))
 (let* ((model (lut:make-vector-model '(a b))) (view (lut:make-widget 'lut:model-list-view :model model)))
   (lut:dispose model)
   (assert (null (lut:view-model view)))
   (assert (equal '(0 0) (multiple-value-list (lut:visible-model-range view))))
   (lut:dispose view)))
(defun model-hover-tests ()
 (dolist (class '(lut:model-list-view lut:model-tree-view lut:model-table-view))
   (let* ((root (lut:make-widget 'lut:window :width 400 :height 200)) (count 6) (requests 0)
          (model (if (eq class 'lut:model-tree-view)
                     (lut:make-tree-model '(a b c d e f) :children (constantly nil))
                     (lut:make-function-model :count (lambda () count) :item (lambda (i) (incf requests) i))))
          (table-p (eq class 'lut:model-table-view)) (header (if table-p 20 0))
          (view (lut:add-child root (apply #'lut:make-widget class :model model :x 10 :y 10 :width 200 :height 80
                     :style '(:row-height 20) (when table-p (list :table-columns (list (lut:make-data-column :id :value))))))))
     (setf (lut:scroll-offset view) 20)
     (selection-pointer root :move 15 (+ 15 header))
     (assert (= 1 (lut::hovered-row view)))
     (assert (null (lut:items view)))
     (when table-p
       (selection-pointer root :move 15 15)
       (assert (null (lut::hovered-row view))))
     (selection-pointer root :move 350 150)
     (assert (null (lut::hovered-row view)))
     (if (eq class 'lut:model-tree-view) (lut:replace-tree-roots model '(a))
         (progn (setf count 1) (lut:notify-model-change model)))
     (selection-pointer root :move 15 (+ 15 header))
     (assert (= 0 (lut::hovered-row view)))
     (selection-pointer root :move 15 85)
     (assert (null (lut::hovered-row view)))
     (assert (zerop requests))
     (lut:dispose model)
     (selection-pointer root :move 15 (+ 15 header))
     (assert (null (lut::hovered-row view)))
     (lut:dispose root))))
(defun model-selection-tests ()
 (let* ((model (lut:make-vector-model '(a b c d e)))
        (selection (lut:make-selection-model model :mode :multiple))
        (view (lut:make-widget 'lut:model-list-view :model model :selection selection))
        (peer (lut:make-widget 'lut:model-list-view :model model :selection selection))
        (notifications 0))
   (lut:on selection :selection-change (lambda (s keys) (declare (ignore s keys)) (incf notifications)))
   (lut:select-model-index selection 1)
   (lut:select-model-index selection 3 :extend t)
   (assert (equal '(b c d) (lut:selected-keys selection)))
   (assert (= 3 (lut:value view) (lut:value peer)))
   (lut:select-model-index selection 2 :toggle t)
   (assert (equal '(b d) (lut:selected-keys selection)))
   (let ((keys (lut:selected-keys selection))) (setf (car keys) 'changed))
   (assert (lut:selection-contains-p selection 'b))
   (lut:replace-model-items model '(e d c b a))
   (assert (= 2 (lut:value view)))
   (assert (equal '(b d) (lut:selected-keys selection)))
   (lut:replace-model-items model '(e b a))
   (assert (equal '(b) (lut:selected-keys selection)))
   (assert (null (lut:selection-focus selection)))
   (lut:handle-selection-event selection (lut:make-event :kind :key :key :end))
   (assert (equal '(a) (lut:selected-keys selection)))
   (assert (plusp notifications))
   (lut:clear-model-selection selection)
   (lut:dispose view) (lut:dispose peer) (assert (not (lut:disposed-p selection)))
   (lut:dispose selection) (lut:dispose model))
 (dolist (mode '(:none :single))
   (let* ((model (lut:make-vector-model '(a b c))) (selection (lut:make-selection-model model :mode mode)))
     (lut:select-model-index selection 0) (lut:select-model-index selection 2 :extend t :toggle t)
     (assert (equal (if (eq mode :none) nil '(c)) (lut:selected-keys selection)))
     (lut:dispose selection) (lut:dispose model)))
 ;; Pointer modifiers and keyboard range selection use the same independent contract.
 (let* ((root (lut:make-widget 'lut:window :width 300 :height 200)) (model (lut:make-vector-model '(a b c d)))
        (selection (lut:make-selection-model model :mode :multiple))
        (view (lut:add-child root (lut:make-widget 'lut:model-list-view :model model :selection selection
                                   :width 200 :height 100 :style '(:row-height 20)))))
   (selection-pointer root :down 10 5) (selection-pointer root :up 10 5)
   (lut:dispatch root (lut:make-event :kind :down :x 10 :y 45 :control-p t))
   (selection-pointer root :up 10 45)
   (assert (equal '(a c) (lut:selected-keys selection)))
   (lut:dispatch root (lut:make-event :kind :key :key :down :shift-p t))
   (assert (equal '(c d) (lut:selected-keys selection)))
   (assert (eq view (lut:focused-widget root)))
   (lut:dispose root) (lut:dispose selection) (lut:dispose model)))
(defun projection-tree-tests ()
 (let* ((a (list :id :a :rank 2)) (b (list :id :b :rank 1)) (c (list :id :c :rank 2))
        (model (lut:make-vector-model (list a b c) :key (lambda (item) (getf item :id))))
        (projection (lut:make-projection-model model :lessp (lambda (a b) (< (getf a :rank) (getf b :rank)))))
        (selection (lut:make-selection-model projection)))
   (assert (equal '(:b :a :c) (loop for i below 3 collect (lut:model-key projection i))))
   (lut:select-model-index selection 1)
   (lut:set-model-query projection :predicate (lambda (item) (not (eq :a (getf item :id)))))
   (assert (equal '(:a) (lut:selected-keys selection)))
   (assert (null (lut:model-index projection :a)))
   (lut:set-model-query projection :predicate nil)
   (assert (= 1 (lut:model-index projection :a)))
   (let ((revision (lut:model-revision model)))
     (assert (handler-case (progn (lut:replace-model-items model (list a a)) nil) (error () t)))
     (assert (= revision (lut:model-revision model)))
     (assert (= 3 (lut:model-count model))))
   (assert (handler-case (progn (lut:set-model-query projection :predicate (lambda (i) (declare (ignore i)) (error "bad query"))) nil) (error () t)))
   (assert (= 3 (lut:model-count projection)))
   (lut:replace-model-items model (list c b))
   (assert (null (lut:selected-keys selection)))
   (lut:dispose model) (assert (lut:disposed-p projection)) (assert (lut:disposed-p selection)))
 (let* ((leaf (list :id :leaf :children nil)) (branch (list :id :branch :children (list leaf)))
        (model (lut:make-tree-model (list branch) :key (lambda (item) (getf item :id)) :children (lambda (item) (getf item :children))))
        (selection (lut:make-selection-model model)))
   (assert (= 1 (lut:model-count model))) (assert (lut:model-branch-p model 0))
   (lut:set-tree-expanded model :branch t)
   (assert (= 2 (lut:model-count model))) (assert (= 1 (lut:model-depth model 1)))
   (lut:select-model-index selection 1)
   (lut:set-tree-expanded model :branch nil)
   (assert (equal '(:leaf) (lut:selected-keys selection)))
   (assert (null (lut:model-index model :leaf)))
   (lut:set-tree-expanded model :branch t)
   (assert (= 1 (lut:model-index model (lut:selection-focus selection))))
   (let ((revision (lut:model-revision model)))
     (assert (handler-case (progn (lut:replace-tree-roots model (list branch leaf)) nil) (error () t)))
     (assert (= revision (lut:model-revision model))))
   (lut:replace-tree-roots model (list leaf))
   (assert (equal '(:leaf) (lut:selected-keys selection)))
   (lut:replace-tree-roots model nil) (assert (null (lut:selected-keys selection)))
   (lut:dispose selection) (lut:dispose model))
 ;; Reentrant writes reject before mutation. Disposal visits all dependents,
 ;; even if an earlier observer fails or recursively disposes the same source.
 (let ((model (lut:make-vector-model '(a b))))
   (lut:on model :model-change (lambda (m revision) (declare (ignore revision))
     (assert (handler-case (progn (lut:replace-model-items m '(bad)) nil) (error () t)))))
   (lut:replace-model-items model '(b a))
   (assert (eq 'b (lut:model-item model 0)))
   (lut:on model :model-disposing (lambda (m p) (declare (ignore p)) (lut:dispose m) (error "Disposal observer")))
   (let* ((projection (lut:make-projection-model model))
          (selection (lut:make-selection-model projection))
          (view (lut:make-widget 'lut:model-list-view :model projection :selection selection)))
     (assert (handler-case (progn (lut:dispose model) nil) (error () t)))
     (assert (every #'lut:disposed-p (list model projection selection)))
     (assert (null (lut:view-model view)))
     (lut:dispose model) (lut:dispose view)))
 (let* ((fail nil) (source (lut:make-vector-model '(a)))
        (projection (lut:make-projection-model source :predicate (lambda (item) (declare (ignore item))
                       (when fail (error "Source query failure")) t)))
        (selection (lut:make-selection-model projection)))
   (setf fail t)
   (assert (handler-case (progn (lut:replace-model-items source '(b c)) nil) (error () t)))
   (assert (= 2 (lut:model-count source)))
   (assert (lut:disposed-p projection)) (assert (lut:disposed-p selection))
   (lut:dispose source)))
(defun table-cell-tests ()
 (let* ((model (lut:make-vector-model '(a))) (column (lut:make-data-column :id :duplicate)))
   (dolist (class '(lut:model-tree-view lut:model-table-view))
     (assert (handler-case (progn (lut:make-widget class :model model) nil) (error () t))))
   (assert (handler-case (progn (lut:make-widget 'lut:model-table-view :model model :table-columns (list column column)) nil) (error () t)))
   (assert (null (slot-value model 'lut::handlers)))
   (lut:dispose model))
 (let* ((root (lut:make-widget 'lut:window :width 400 :height 200))
        (a (list :id :a :name "Alpha")) (b (list :id :b :name "Beta"))
        (source (lut:make-vector-model (list a b) :key (lambda (item) (getf item :id))))
        (model (lut:make-projection-model source :lessp (lambda (a b) (string< (getf a :name) (getf b :name)))))
        (column (lut:make-data-column :id :name :title "Name" :getter (lambda (item) (getf item :name))
          :cell-factory (lambda (item value) (declare (ignore item)) (list :text value :foreground :blue))
          :editor-factory (lambda (view key column value) (declare (ignore view key column)) (lut:make-widget 'lut:entry :text value))
          :setter (lambda (item text) (when (string= text "bad") (error "Rejected cell")) (setf (getf item :name) text))))
        (view (lut:add-child root (lut:make-widget 'lut:model-table-view :model model :table-columns (list column)
                                   :width 300 :height 150 :style '(:row-height 30))))
        (committed nil) (cancelled nil))
   (lut:on view :cell-edit-commit (lambda (v event) (declare (ignore v)) (setf committed event)))
   (lut:on view :cell-edit-cancel (lambda (v event) (declare (ignore v)) (setf cancelled event)))
   (assert (equal '(:text "Alpha" :foreground :blue) (lut:cell-presentation view 0 0)))
   (let ((presentation (lut:cell-presentation view 0 0))) (setf (char (getf presentation :text) 0) #\X))
   (assert (string= "Alpha" (getf a :name)))
   (lut:select-model-index (lut:view-selection view) 0)
   (lut:focus root view)
   (lut:dispatch root (lut:make-event :kind :key :key :enter))
   (assert (typep (lut:cell-editor view) 'lut:entry))
   (assert (= 1 (length (lut:children view))))
   (setf (lut:text (lut:cell-editor view)) "bad")
   (assert (handler-case (progn (lut:commit-cell-edit view) nil) (error () t)))
   (assert (lut:cell-editor view)) (assert (string= "Alpha" (getf a :name)))
   (setf (lut:text (lut:cell-editor view)) "Zulu")
   (lut:dispatch root (lut:make-event :kind :key :key :enter))
   (assert (null (lut:cell-editor view))) (assert (eq view (lut:focused-widget root)))
   (assert (eq :a (getf committed :key))) (assert (string= "Zulu" (getf a :name)))
   (assert (= 1 (lut:model-index model :a)))
   (lut:begin-cell-edit view) (setf (lut:text (lut:cell-editor view)) "discarded")
   (lut:dispatch root (lut:make-event :kind :key :key :escape))
   (assert cancelled) (assert (string= "Zulu" (getf a :name)))
   (lut:begin-cell-edit view)
   (lut:replace-model-items source (list b))
   (assert (null (lut:cell-editor view))) (assert (eq :model-change (getf cancelled :reason)))
   (lut:dispose root) (lut:dispose model) (lut:dispose source)))

(defun row-icon-tests ()
 (let* ((font (asdf:system-relative-pathname "lut" "assets/NotoSans-Regular.ttf"))
        (text (copy-seq "A")) (color (list 12 34 56 255))
        (icon (lut:make-glyph-icon :text text :font font :color color :glyphs "AB"))
        (model (lut:make-vector-model '(one)))
        (view (lut:make-widget 'lut:model-list-view :model model)))
   (unwind-protect
     (progn
       (setf (char text 0) #\B (first color) 99)
       (assert (string= "A" (lut:glyph-icon-text icon)))
       (assert (equal '(12 34 56 255) (lut:glyph-icon-color icon)))
       (assert (equal '(65 66) (lut::glyph-icon-codes icon)))
       (let ((before (lut:widget-render-key view)))
         (setf (lut:row-icon-function view) (constantly icon))
         (assert (not (equal before (lut:widget-render-key view))))
         (assert (eq icon (funcall (lut:row-icon-function view) 'one))))
       (dolist (args (list (list :text "AB" :font font)
                           (list :text "A" :font font :size 0)
                           (list :text "A" :font "missing-symbol-font.ttf")))
         (assert (handler-case (progn (apply #'lut:make-glyph-icon args) nil) (error () t)))))
     (lut:dispose view) (lut:dispose model))))
