(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(asdf:load-system "lut/examples")
(defun check-unicode-run-fonts ()
 (let* ((string (concatenate 'string (make-string 256 :initial-element #\a)
                  (coerce (loop for code from #x4e00 below #x5000 collect (code-char code)) 'string)))
        (view (lut:make-widget 'lut:text-view :text string))
        (before (length lut::*font-cache*)) (walks 0)
        (original (symbol-function 'lut::font-codepoints)))
   ;; Count actual discovery calls outside PAINT-TEXT, not a timing threshold.
   (unwind-protect
       (progn
         (setf (symbol-function 'lut::font-codepoints)
               (lambda (w) (incf walks) (funcall original w)))
         (lut:text-position-rectangle view (length string))
         (assert (<= (- (length lut::*font-cache*) before) 3))
         (assert (<= walks 3))
         (let ((cached-walks walks))
           (lut:text-position-rectangle view (length string))
           (assert (= walks cached-walks))))
     (setf (symbol-function 'lut::font-codepoints) original)
     (lut:dispose view))))
(defun check-plain-label-overflow ()
 (let ((label (lut:make-widget 'lut:label :x 20 :y 30 :width 8 :height 16
                              :text (format nil "First long line~%Second~%Third")))
       (original (symbol-function 'lut::draw-string)) (draws nil))
   (unwind-protect
       (progn
         (setf (symbol-function 'lut::draw-string)
               (lambda (w string x y &optional color)
                 (declare (ignore w color)) (push (list string x y) draws)))
         (lut:render label)
         (assert (equal (nreverse draws)
                        '(("First long line" 28 38) ("Second" 28 64) ("Third" 28 90)))))
     (setf (symbol-function 'lut::draw-string) original)
     (lut:dispose label))))
(let* ((root (lut-examples:indexed-text))
       (view (lut:find-widget root :indexed-view)) (buffer (lut:view-buffer view))
       (frame 0) (checked nil))
 (lut:on root :tick (lambda (w dt)
   (declare (ignore w dt))
   (case (incf frame)
     (2
       (check-plain-label-overflow)
       (check-unicode-run-fonts)
       (setf (lut:style view) '(:font-spacing 2))
       (let* ((end (lut:text-length buffer))
              (append (lut:find-widget root :indexed-append)))
         (lut:emit append :activate)
         (assert (> (lut:text-length buffer) end)))
       (assert (not (slot-value buffer 'lut::text-snapshot-p))))
     (3
       (assert (plusp (lut:vertical-offset view)))
       (assert (not (slot-value buffer 'lut::text-snapshot-p)))
       (let* ((line (1- (lut:text-line-count buffer)))
              (previous (1- line)))
         (multiple-value-bind (start end) (lut:text-line-range buffer previous)
           (multiple-value-bind (x y) (lut:text-position-rectangle view end)
             (assert (= end (lut:text-point-position view x y)))
             (let ((start-x (lut:text-position-rectangle view start)))
               (assert (< (abs (- (- x start-x) (lut:text-width view (lut:text-range buffer start end)))) 0.1)))))
         (assert (< (length (slot-value view 'lut::geometry-cache)) 9)))
       (let ((texture (rl:load-render-texture (round (lut:width root)) (round (lut:height root)))))
         (unwind-protect
             (progn
               (rl:with-texture-mode (texture)
                 (rl:clear-background (lut:style-value root :background)) (lut::render-window root))
               (let ((image (rl:load-image-from-texture (rl:render-texture-texture texture))))
                 (unwind-protect
                     (progn (rl:image-flip-vertical image) (rl:export-image image "/tmp/lut-indexed-text.png"))
                   (rl:unload-image image))))
           (rl:unload-render-texture texture)))
       (setf checked t)))))
 (unwind-protect
     (progn (lut:run root :frames 4) (assert checked))
   (lut:dispose root) (lut:dispose buffer)))
(format t "Native Unicode run atlas/tree-walk bounds, tiny-label overflow, indexed EOF reveal/append, spaced metrics and rendering passed; /tmp/lut-indexed-text.png.~%")
