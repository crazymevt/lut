(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/raylib" :silent t)
(let* ((root (lut:make-widget 'lut:window :width 400 :height 180))
       (label (lut:add-child root (lut:make-widget 'lut:label :text "Waiting")))
       (frames 0) (delivered nil) (posted nil) (first-time nil) (last-time nil) (elapsed 0) (presents 0)
       (thread (bt:make-thread
         (lambda ()
           (sleep 0.25)
           (setf posted (/ (get-internal-real-time) internal-time-units-per-second))
           (lut:on-widget label
             (setf (lut:text label) "Queued work delivered"
                   delivered (/ (get-internal-real-time) internal-time-units-per-second)))))))
 (lut:on root :tick
   (lambda (window dt)
     (incf frames)
     (unless first-time (setf first-time (/ (get-internal-real-time) internal-time-units-per-second)))
     (setf last-time (/ (get-internal-real-time) internal-time-units-per-second))
     (when (> frames 1) (incf elapsed dt))
     (when (= frames 60) (setf presents (getf (lut:window-cache-statistics window) :presents)))))
 (unwind-protect
   (progn
     (lut:run root :frames 61)
     (bt:join-thread thread)
     (assert delivered) (assert (< (- delivered posted) 0.25))
     (assert (string= "Queued work delivered" (lut:text label)))
     (assert (< (abs (- elapsed (- last-time first-time))) 0.1))
     (assert (< presents 10)))
   (lut:dispose root)))
(format t "PASS: idle queue delivery, monotonic tick deltas and limited buffer presentation.~%")
;; Native workers also skip unchanged buffer presentation while idle, but still
;; acknowledge snapshots and present new frames.
(let* ((root (lut:make-widget 'lut:window :width 300 :height 120 :text "Idle controller"))
       (peer (lut:make-widget 'lut:window :width 300 :height 120 :text "Idle worker"))
       (label (lut:add-child peer (lut:make-widget 'lut:label :text "Static worker")))
       (remote nil) (phase :spawn) (mark-frames 0) (mark-presents 0) (mark-time 0) (idle-presents nil)
       (deadline (+ (get-internal-real-time) (* 30 internal-time-units-per-second))))
 (flet ((now () (/ (get-internal-real-time) internal-time-units-per-second)))
   (lut:on root :tick
     (lambda (w dt) (declare (ignore w dt))
       (when (> (get-internal-real-time) deadline) (error "Idle worker timed out at ~s" phase))
       (when (and remote (lut::remote-window-error remote)) (error (lut::remote-window-error remote)))
       (case phase
         (:spawn (setf remote (lut:spawn-window peer) phase :settling))
         (:settling (when (>= (lut::remote-window-frames remote) 10)
           (setf mark-presents (lut::remote-window-worker-presents remote)
                 mark-frames (lut::remote-window-frames remote) mark-time (now) phase :idle)))
         (:idle (when (>= (- (now) mark-time) 2)
           ;; Two seconds allow roughly two compositor refreshes, not 120 swaps.
           (assert (> (lut::remote-window-frames remote) (+ mark-frames 10)))
           (setf idle-presents (- (lut::remote-window-worker-presents remote) mark-presents))
           (setf mark-presents (lut::remote-window-worker-presents remote)
                 mark-frames (lut::remote-window-encoded-frames remote))
           (setf (lut:text label) "Changed worker" phase :changed)))
         (:changed (when (and (> (lut::remote-window-encoded-frames remote) mark-frames)
                              (> (lut::remote-window-worker-presents remote) mark-presents))
           (setf phase :done) (lut:stop)))))))
 (unwind-protect (progn (lut:run root :frames 3000) (assert (eq phase :done)))
   (when (and remote (lut:remote-alive-p remote)) (lut:close-window remote))
   (lut:dispose root) (lut:dispose peer))
 (format t "Worker idle presents over 2 s: ~d.~%" idle-presents)
 (assert (<= idle-presents 5)))
(format t "PASS: idle native worker presentation is limited and still shows changed snapshots.~%")
