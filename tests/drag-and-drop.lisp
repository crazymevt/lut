(in-package #:lut-tests)
(defclass drag-button (lut:button) ())
(defclass drop-box (lut:box) ())
(defclass rejecting-drop-box (drop-box) ())
(defmethod lut:perform-drop ((target rejecting-drop-box) session event)
 (declare (ignore target session event)) nil)
(defmethod lut:drag-data ((source drag-button) event)
 (declare (ignore source event)) (values :test-payload t))
(defmethod lut:accepts-drop-p ((target drop-box) session event)
 (declare (ignore target event)) (eq (lut:drag-payload session) :test-payload))
(defun drag-event (root kind x y &optional key)
 (lut:dispatch root (lut:make-event :kind kind :x x :y y :key key)))
(defun drag-fixture ()
 (let* ((root (lut:make-widget 'lut:window :width 400 :height 300))
        (source (lut:add-child root (lut:make-widget 'drag-button :height 40)))
        (target (lut:add-child root (lut:make-widget 'drop-box :height 80)))
        (child (lut:add-child target (lut:make-widget 'lut:label :text "Drop on descendant"))))
   (lut:layout root 0 0 400 300)
   (values root source target child)))
(defun drag-and-drop-tests ()
 ;; Small motions remain clicks. Real drags capture input, bubble target lookup
 ;; through a child, emit ordered notifications, and cannot activate the source.
 (multiple-value-bind (root source target child) (drag-fixture)
   (declare (ignore child))
   (let ((clicks 0) (events nil) (retained nil))
     (lut:on source :activate (lambda (w p) (declare (ignore w p)) (incf clicks)))
     (dolist (spec (list (cons source :drag-start) (cons target :drag-enter)
                        (cons target :drag-over) (cons target :drop)
                        (cons target :drag-leave) (cons source :drag-end)))
       (let ((name (cdr spec)))
         (lut:on (car spec) name (lambda (w session)
           (declare (ignore w)) (push name events) (setf retained session)
           (when (eq name :drop) (assert (eq :dropped (lut:drag-state session))))))))
     (drag-event root :down 20 20)
     (drag-event root :move 22 21)
     (assert (eq :pending (lut:drag-state (lut:current-drag root))))
     (drag-event root :up 22 21) (assert (= 1 clicks))
     (assert (null events)) (assert (null (lut:current-drag root)))
     (drag-event root :down 20 20) (drag-event root :move 20 70)
     (assert (eq target (lut:drag-target (lut:current-drag root))))
     (drag-event root :up 20 70)
     (assert (= 1 clicks))
     (assert (equal (reverse events) '(:drag-start :drag-enter :drag-over :drag-over :drop :drag-leave :drag-end)))
     (assert (eq :dropped (lut:drag-state retained)))
     (assert (null (lut:drag-source retained))) (assert (null (lut:drag-payload retained)))
     (assert (null (lut:drag-target retained)))
     (assert (null (slot-value root 'lut::pressed-widget)))))
 ;; Cancelling before the threshold also releases the original mouse press.
 (multiple-value-bind (root source) (drag-fixture)
   (drag-event root :down 20 20)
   (drag-event root :key 0 0 :escape)
   (assert (null (lut:current-drag root)))
   (assert (not (lut::pressed-p source)))
   (assert (null (slot-value root 'lut::pressed-widget))))
 ;; Rejection, Escape, ancestor disposal/removal and modal activation all clean up.
 (dolist (action '(:reject :escape :remove-source :remove-target :dispose :modal))
   (multiple-value-bind (root source target) (drag-fixture)
     (let ((ended nil))
       (lut:on source :drag-end (lambda (w s) (declare (ignore w)) (setf ended (lut:drag-state s))))
       (drag-event root :down 20 20) (drag-event root :move 20 70)
       (case action
         (:reject (drag-event root :up 390 290))
         (:escape (drag-event root :key 0 0 :escape))
         (:remove-source (lut:remove-child root source))
         (:remove-target (lut:remove-child root target))
         (:dispose (lut:dispose root))
         (:modal (lut:show-dialog root (lut:make-widget 'lut:dialog))))
       (assert (eq ended (if (eq action :reject) :rejected :cancelled)))
       (assert (null (lut:current-drag root)))
       (assert (null (slot-value root 'lut::pressed-widget))))))
 ;; Handler errors propagate, but never leave an active capture or payload behind.
 (multiple-value-bind (root source target) (drag-fixture)
   (declare (ignore target))
   (lut:on source :drag-start (lambda (w s) (declare (ignore w s)) (error "Intentional callback failure")))
   (drag-event root :down 20 20)
   (assert (handler-case (progn (drag-event root :move 20 70) nil) (error () t)))
   (assert (null (lut:current-drag root)))
   (assert (null (slot-value root 'lut::pressed-widget))))
 ;; Target transitions are balanced, and rejection at commit emits no :drop.
 (multiple-value-bind (root source target) (drag-fixture)
   (declare (ignore source))
   (let ((enters 0) (leaves 0))
     (lut:on target :drag-enter (lambda (w s) (declare (ignore w s)) (incf enters)))
     (lut:on target :drag-leave (lambda (w s) (declare (ignore w s)) (incf leaves)))
     (drag-event root :down 20 20) (drag-event root :move 20 70)
     (drag-event root :move 390 290) (drag-event root :move 20 70)
     (drag-event root :up 20 70)
     (assert (= enters 2)) (assert (= leaves 2))))
 (multiple-value-bind (root source target) (drag-fixture)
   (change-class target 'rejecting-drop-box)
   (let ((end nil) (drops 0))
     (lut:on source :drag-end (lambda (w s) (declare (ignore w)) (setf end (lut:drag-state s))))
     (lut:on target :drop (lambda (w s) (declare (ignore w s)) (incf drops)))
     (drag-event root :down 20 20) (drag-event root :move 20 70) (drag-event root :up 20 70)
     (assert (eq end :rejected)) (assert (zerop drops))))
 ;; A callback may remove its own target during :drag-enter.
 (multiple-value-bind (root source target) (drag-fixture)
   (declare (ignore source))
   (lut:on target :drag-enter (lambda (w s) (declare (ignore s)) (lut:remove-child root w)))
   (drag-event root :down 20 20) (drag-event root :move 20 70)
   (assert (null (lut:current-drag root)))
   (assert (null (slot-value root 'lut::pressed-widget))))
 ;; Errors in a terminal callback do not rewrite a completed drop's state.
 (multiple-value-bind (root source target) (drag-fixture)
   (declare (ignore target))
   (let ((session nil))
     (lut:on source :drag-end (lambda (w s)
       (declare (ignore w)) (setf session s) (error "Intentional end callback failure")))
     (drag-event root :down 20 20) (drag-event root :move 20 70)
     (assert (handler-case (progn (drag-event root :up 20 70) nil) (error () t)))
     (assert (eq :dropped (lut:drag-state session)))
     (assert (null (lut:drag-payload session)))
     (assert (null (lut:current-drag root)))
     (assert (null (slot-value root 'lut::pressed-widget)))))
 ;; Hiding/disabling a source invalidates its drag before another event is handled.
 (multiple-value-bind (root source) (drag-fixture)
   (drag-event root :down 20 20) (drag-event root :move 20 70)
   (setf (lut:enabled-p source) nil)
   (drag-event root :up 20 70) (assert (null (lut:current-drag root))))
 (notebook-drag-tests)
 (format t "Drag threshold, capture, drop lifecycle, rejection, cancellation, disposal, errors and notebook transfer checks passed.~%"))
(defun notebook-fixture ()
 (let* ((root (lut:make-widget 'lut:window :width 600 :height 300))
        (a (lut:add-child root (lut:make-widget 'lut:notebook :reorderable-p t :tab-group :shared :items '("A" "B" "C"))))
        (b (lut:add-child root (lut:make-widget 'lut:notebook :reorderable-p t :tab-group :shared :items '("D")))))
   (dotimes (i 3) (lut:add-child a (lut:make-widget 'lut:entry :text (write-to-string i))))
   (lut:add-child b (lut:make-widget 'lut:label :text "Other"))
   (lut:layout root 0 0 600 300)
   (lut:layout a 0 0 300 200) (lut:layout b 300 0 300 200)
   (values root a b)))
(defun notebook-drag-tests ()
 (multiple-value-bind (root a b) (notebook-fixture)
   (let ((page (first (lut:children a))) (changes 0))
     (lut:on a :pages-changed (lambda (w p) (declare (ignore w p)) (incf changes)))
     ;; Reorder at the final insertion boundary, keeping caption and selection.
     (drag-event root :down 20 10) (drag-event root :move 295 10) (drag-event root :up 295 10)
     (assert (equal (lut:items a) '("B" "C" "A")))
     (assert (eq page (third (lut:children a)))) (assert (= 2 (lut:value a)))
     (assert (= 1 changes))
     ;; Transfer to another notebook, preserving the actual page instance.
     (drag-event root :down 250 10) (drag-event root :move 590 10) (drag-event root :up 590 10)
     (assert (eq b (lut:parent page)))
     (assert (equal (lut:items a) '("B" "C"))) (assert (equal (lut:items b) '("D" "A")))
     (assert (= 1 (lut:value b))) (assert (= 2 changes))
     ;; Programmatic transfers preserve the focused descendant.
     (lut:focus root page)
     (lut:move-page b page a 0)
     (assert (eq page (lut:focused-widget root)))
     (assert (equal (lut:items a) '("A" "B" "C")))
     ;; Mismatched groups and header-to-body drops are rejected.
     (setf (lut:tab-group b) :other)
     (drag-event root :down 20 10) (drag-event root :move 590 10) (drag-event root :up 590 10)
     (assert (eq a (lut:parent page)))
     (setf (lut:tab-group b) :shared)
     (drag-event root :down 20 10) (drag-event root :move 590 100) (drag-event root :up 590 100)
     (assert (eq a (lut:parent page)))
     ;; A removed page cancels an armed drag even though its source is the notebook.
     (drag-event root :down 20 10)
     (lut:remove-child a page)
     (assert (null (lut:current-drag root)))))
 ;; Empty destinations and removing a notebook's final page remain valid.
 (multiple-value-bind (root a b) (notebook-fixture)
   (let ((page (first (lut:children b))))
     (lut:move-page b page a 0)
     (assert (null (lut:children b))) (assert (null (lut:items b))) (assert (zerop (lut:value b)))
     (drag-event root :down 20 10) (drag-event root :move 400 10) (drag-event root :up 400 10)
     (assert (eq b (lut:parent page))) (assert (equal (lut:items b) '("D")))))
 ;; Opt-in, cross-window and containment restrictions.
 (multiple-value-bind (root a b) (notebook-fixture)
   (setf (lut:reorderable-p a) nil)
   (drag-event root :down 20 10) (assert (null (lut:current-drag root)))
   (let ((page (first (lut:children a)))
         (foreign (lut:make-widget 'lut:notebook)))
     (assert (handler-case (progn (lut:move-page a page foreign 0) nil) (error () t)))
     (assert (eq a (lut:parent page)))
     (assert (handler-case (progn (lut:move-page a page b 10) nil) (error () t)))
     (assert (eq a (lut:parent page))))))
