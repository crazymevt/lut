(in-package #:lut-tests)
(defclass disposal-probe (lut:widget) ((calls :initform 0 :accessor disposal-calls)))
(defmethod lut:dispose :after ((w disposal-probe)) (incf (disposal-calls w)))
(defclass failing-disposal-probe (lut:widget) ())
(defmethod lut:dispose :before ((w failing-disposal-probe)) (error "Expected custom destructor failure"))
(defun lifecycle-tests ()
 (let* ((root (lut:make-widget 'lut:window))
        (box (lut:add-child root (lut:make-widget 'lut:box :height 160)))
        (entry (lut:add-child box (lut:make-widget 'lut:entry :text "Owned")))
        (calls 0))
   (lut:on entry :activate (lambda (w p) (declare (ignore w p)) (incf calls)))
   (lut:layout root 0 0 600 400) (lut:focus root entry)
   (lut:dispatch root (lut:make-event :kind :down :x (+ (lut:x entry) 2) :y (+ (lut:y entry) 2)))
   (setf (slot-value root 'lut::interaction-state) (list :drag box 0 0))
   (lut:remove-child root box)
   (assert (null (lut:focused-widget root)))
   (assert (null (slot-value root 'lut::pressed-widget)))
   (assert (null (slot-value root 'lut::interaction-state)))
   (assert (not (lut:disposed-p box)))
   (lut:emit entry :activate) (assert (= 1 calls))
   (lut:add-child root box) (lut:remove-child root box :dispose t)
   (assert (lut:disposed-p box)) (assert (lut:disposed-p entry))
   (assert (null (lut:children box))) (assert (null (lut:parent entry)))
   (assert (null (slot-value entry 'lut::handlers)))
   (lut:emit entry :activate) (assert (= 1 calls))
   (assert (handler-case (progn (lut:add-child root entry) nil) (error () t))))
 (let* ((root (lut:make-widget 'lut:window)) (owner (lut:make-widget 'lut:label))
        (connection (nth-value 1 (lut:on root :tick (lambda (w dt) (declare (ignore w dt)) (lut:text owner)) :owner owner))))
   (assert (= 1 (length (slot-value root 'lut::handlers))))
   (lut:dispose owner)
   (assert (null (slot-value root 'lut::handlers)))
   (assert (null (slot-value owner 'lut::connections)))
   (assert (null (lut::connection-callback connection)))
   (assert (null (lut::connection-source connection)))
   (assert (null (lut::connection-owner connection)))
   (lut:disconnect connection))
 (let ((w (lut:make-widget 'lut:button)) (calls nil) (second nil))
   (lut:on w :activate (lambda (w p) (declare (ignore w p)) (push 1 calls) (lut:disconnect second)))
   (setf second (nth-value 1 (lut:on w :activate (lambda (w p) (declare (ignore w p)) (push 2 calls)))))
   (lut:emit w :activate) (assert (equal '(1) calls))
   (assert (= 1 (lut:off w))) (assert (null (slot-value w 'lut::handlers))))
 (let* ((w (lut:make-widget 'lut:window)) (d (lut:make-widget 'lut:dialog))
        (field (lut:add-child d (lut:make-widget 'lut:entry))))
   (lut:show-dialog w d) (lut:focus w field) (lut:dispose d)
   (assert (null (slot-value w 'lut::overlays)))
   (assert (null (lut:focused-widget w)))
   (assert (lut:disposed-p field)))
 (let ((a (lut:make-widget 'lut:radio-button)) (b (lut:make-widget 'lut:radio-button)))
   (lut:group-radios a b) (lut:dispose a) (assert (not (member a (lut:group b)))))
 (let ((w (lut:make-widget 'disposal-probe)))
   (lut:dispose w) (lut:dispose w) (assert (= 1 (disposal-calls w))))
 (let* ((root (lut:make-widget 'lut:box))
        (bad (lut:add-child root (lut:make-widget 'failing-disposal-probe)))
        (good (lut:add-child root (lut:make-widget 'lut:entry :text "still clean up"))))
   (assert (handler-case (progn (lut:dispose root) nil) (error () t)))
   (assert (lut:disposed-p bad)) (assert (lut:disposed-p good))
   (assert (null (lut:children root))) (assert (null (lut:parent good))))
 (format t "Widget ownership, connection and idempotent disposal checks passed.~%") t)
