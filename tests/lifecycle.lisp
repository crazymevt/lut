(in-package #:lui-tests)
(defclass disposal-probe (lui:widget) ((calls :initform 0 :accessor disposal-calls)))
(defmethod lui:dispose :after ((w disposal-probe)) (incf (disposal-calls w)))
(defclass failing-disposal-probe (lui:widget) ())
(defmethod lui:dispose :before ((w failing-disposal-probe)) (error "Expected custom destructor failure"))
(defun lifecycle-tests ()
 (let* ((root (lui:make-widget 'lui:window))
        (box (lui:add-child root (lui:make-widget 'lui:box :height 160)))
        (entry (lui:add-child box (lui:make-widget 'lui:entry :text "Owned")))
        (calls 0))
   (lui:on entry :activate (lambda (w p) (declare (ignore w p)) (incf calls)))
   (lui:layout root 0 0 600 400) (lui:focus root entry)
   (lui:dispatch root (lui:make-event :kind :down :x (+ (lui:x entry) 2) :y (+ (lui:y entry) 2)))
   (setf (slot-value root 'lui::interaction-state) (list :drag box 0 0))
   (lui:remove-child root box)
   (assert (null (lui:focused-widget root)))
   (assert (null (slot-value root 'lui::pressed-widget)))
   (assert (null (slot-value root 'lui::interaction-state)))
   (assert (not (lui:disposed-p box)))
   (lui:emit entry :activate) (assert (= 1 calls))
   (lui:add-child root box) (lui:remove-child root box :dispose t)
   (assert (lui:disposed-p box)) (assert (lui:disposed-p entry))
   (assert (null (lui:children box))) (assert (null (lui:parent entry)))
   (assert (null (slot-value entry 'lui::handlers)))
   (lui:emit entry :activate) (assert (= 1 calls))
   (assert (handler-case (progn (lui:add-child root entry) nil) (error () t))))
 (let* ((root (lui:make-widget 'lui:window)) (owner (lui:make-widget 'lui:label))
        (connection (nth-value 1 (lui:on root :tick (lambda (w dt) (declare (ignore w dt)) (lui:text owner)) :owner owner))))
   (assert (= 1 (length (slot-value root 'lui::handlers))))
   (lui:dispose owner)
   (assert (null (slot-value root 'lui::handlers)))
   (assert (null (slot-value owner 'lui::connections)))
   (assert (null (lui::connection-callback connection)))
   (assert (null (lui::connection-source connection)))
   (assert (null (lui::connection-owner connection)))
   (lui:disconnect connection))
 (let ((w (lui:make-widget 'lui:button)) (calls nil) (second nil))
   (lui:on w :activate (lambda (w p) (declare (ignore w p)) (push 1 calls) (lui:disconnect second)))
   (setf second (nth-value 1 (lui:on w :activate (lambda (w p) (declare (ignore w p)) (push 2 calls)))))
   (lui:emit w :activate) (assert (equal '(1) calls))
   (assert (= 1 (lui:off w))) (assert (null (slot-value w 'lui::handlers))))
 (let* ((w (lui:make-widget 'lui:window)) (d (lui:make-widget 'lui:dialog))
        (field (lui:add-child d (lui:make-widget 'lui:entry))))
   (lui:show-dialog w d) (lui:focus w field) (lui:dispose d)
   (assert (null (slot-value w 'lui::overlays)))
   (assert (null (lui:focused-widget w)))
   (assert (lui:disposed-p field)))
 (let ((a (lui:make-widget 'lui:radio-button)) (b (lui:make-widget 'lui:radio-button)))
   (lui:group-radios a b) (lui:dispose a) (assert (not (member a (lui:group b)))))
 (let ((w (lui:make-widget 'disposal-probe)))
   (lui:dispose w) (lui:dispose w) (assert (= 1 (disposal-calls w))))
 (let* ((root (lui:make-widget 'lui:box))
        (bad (lui:add-child root (lui:make-widget 'failing-disposal-probe)))
        (good (lui:add-child root (lui:make-widget 'lui:entry :text "still clean up"))))
   (assert (handler-case (progn (lui:dispose root) nil) (error () t)))
   (assert (lui:disposed-p bad)) (assert (lui:disposed-p good))
   (assert (null (lui:children root))) (assert (null (lui:parent good))))
 (format t "Widget ownership, connection and idempotent disposal checks passed.~%") t)
