(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(asdf:load-system "lut/raylib")
(let* ((root (lut:make-widget 'lut:window :width 240 :height 140 :ui-scale 5/4))
       (child (lut:make-widget 'lut:window :width 200 :height 140 :ui-scale 2 :content-layout :fill))
       (canvas (lut:add-child child (lut:make-widget 'lut:drawing-area)))
       (button (lut:add-child canvas (lut:make-widget 'lut:button :x 10 :y 20 :width 80 :height 30 :text "Worker input")))
       (calls 0) (remote nil) (phase :spawn) (after 0)
       (deadline (+ (get-internal-real-time) (* 20 internal-time-units-per-second))))
 (lut:on button :activate (lambda (w p) (declare (ignore w p)) (incf calls)))
 (labels ((click ()
            (lut:evaluate-in-window remote
              '((lut::forward-native-event (lut:make-event :kind :down :x 50 :y 35))
                (lut::forward-native-event (lut:make-event :kind :up :x 50 :y 35))))))
   (lut:on root :tick (lambda (w dt) (declare (ignore w dt))
     (when (> (get-internal-real-time) deadline) (error "Scaled worker timed out at ~s" phase))
     (when (and remote (lut::remote-window-error remote)) (error (lut::remote-window-error remote)))
     (case phase
       (:spawn (setf remote (lut:spawn-window child) phase :first))
       (:first (when (>= (lut::remote-window-frames remote) 3)
                 (assert (= 200 (lut:width child)))
                 (assert (equal '(400 280) (lut::remote-window-last-size remote)))
                 (click) (setf phase :resize)))
       (:resize (when (= 1 calls)
                  (setf (lut:ui-scale child) 5/4 after (+ 3 (lut::remote-window-frames remote)) phase :second)))
       (:second (when (>= (lut::remote-window-frames remote) after)
                  (assert (= 320 (lut:width child)))
                  (lut:evaluate-in-window remote '((assert (= 5/4 (lut:ui-scale lut::*active-window*)))))
                  (click) (setf phase :close)))
       (:close (when (= 2 calls) (lut:close-window remote) (setf phase :closing)))
       (:closing (when (null (lut::remote-window-process remote)) (setf phase :done) (lut:stop)))))))
 (unwind-protect (progn (lut:run root :frames 1500) (assert (eq phase :done)))
   (when (and remote (lut:remote-alive-p remote)) (lut:close-window remote))
   (lut:dispose root) (lut:dispose child)))
(format t "Worker physical frames, logical sizes, runtime 200% to 125% scaling and exactly-once input conversion passed.~%")
