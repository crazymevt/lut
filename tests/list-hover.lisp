(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/raylib" :silent t)
;; Hit testing uses content coordinates, including scrolling and table headers.
(let ((list (lut:make-widget 'lut:list-view :items '("One" "Two" "Three"))))
  (lut:layout list 10 20 200 150)
  (setf (lut:scroll-offset list) 30)
  (lut::update-pointer-hover list list (lut:make-event :kind :move :x 20 :y 25))
  (assert (= (lut::hovered-row list) 1))
  (lut::update-pointer-hover list list (lut:make-event :kind :move :x 20 :y 140))
  (assert (null (lut::hovered-row list)))
  (lut::update-pointer-hover list nil (lut:make-event :kind :move :x 0 :y 0))
  (assert (null (lut::hovered-row list))))
(let ((table (lut:make-widget 'lut:table-view :columns '("Name") :rows '(("One") ("Two")))))
  (lut:layout table 10 20 200 150)
  (lut::update-pointer-hover table table (lut:make-event :kind :move :x 20 :y 25))
  (assert (null (lut::hovered-row table)))
  (lut::update-pointer-hover table table (lut:make-event :kind :move :x 20 :y 55))
  (assert (zerop (lut::hovered-row table))))
(defclass hover-window (lut:window)
 ((options :accessor options) (pointer-row :initform 1 :accessor pointer-row)))
;; Inject pointer motion after POLL-INPUT, so real cursor position cannot make
;; this pixel regression flaky. The same dispatch path handles native events.
(defmethod lut:render :before ((w hover-window))
 (let* ((list (options w)) (row (pointer-row w)))
   (lut:dispatch w (lut:make-event :kind :move
     :x (if row (+ (lut:x list) 100) -1)
     :y (if row (+ (lut:y list) (* row (lut:row-height list)) 15) -1)))
   (assert (eql (lut::hovered-row list) row))
   (assert (zerop (lut:value list)))))
(loop for theme in (list lut:*light-theme* lut:*dark-theme*)
      for name in '("light" "dark") do
 (let* ((w (make-instance 'hover-window :width 400 :height 260 :theme theme))
        (choice (lut:make-widget 'lut:dropdown :items '("Selected" "Second" "Third") :value 0))
        (frame 0) (sample-x nil) (sample-y nil))
   (lut:add-child w choice) (lut:layout w 0 0 400 260)
   (lut::popup-selection choice)
   (setf (options w) (first (lut:children (lut::input-root w))))
   (lut:on w :tick (lambda (root dt)
     (declare (ignore root dt))
     (incf frame)
     (when (member frame '(3 5 7))
       (rl:take-screenshot (format nil "/tmp/lut-hover-~a-~d.png" name frame)))
     (setf sample-x (round (- (+ (lut:x (options w)) (lut:width (options w))) 30))
           sample-y (round (+ (lut:y (options w)) 15)))
     (case frame (3 (setf (pointer-row w) 2)) (5 (setf (pointer-row w) nil)))))
   (lut:run w :frames 7)
   (loop for frame in '(3 5 7) for hovered in '(1 2 nil) do
     (let ((image (rl:load-image (format nil "/tmp/lut-hover-~a-~d.png" name frame))))
       (unwind-protect
         (loop for row below 3
               for expected = (getf theme (cond ((zerop row) :accent)
                                                ((eql row hovered) :hover-color)
                                                (t :surface))) do
           (assert (= (rl:color-to-int (rl:get-image-color image sample-x (+ sample-y (* row 30))))
                      (rl:color-to-int expected))))
         (rl:unload-image image))))))
(format t "Popup row hover pixels, movement, leave and unchanged selection passed in both themes.~%")
