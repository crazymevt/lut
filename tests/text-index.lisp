(in-package #:lut-tests)
(defun assert-text-tree (root)
 (when root
   (if (lut::text-node-string root)
       (progn (assert (<= 1 (lut::node-size root) 1024))
              (assert (= (lut::node-lines root) (count #\Newline (lut::text-node-string root)))))
       (let ((a (lut::text-node-left root)) (b (lut::text-node-right root)))
         (assert (and a b))
         (assert (<= (abs (- (lut::node-depth a) (lut::node-depth b))) 1))
         (assert (= (lut::node-size root) (+ (lut::node-size a) (lut::node-size b))))
         (assert (= (lut::node-lines root) (+ (lut::node-lines a) (lut::node-lines b))))
         (assert (= (lut::node-depth root) (1+ (max (lut::node-depth a) (lut::node-depth b)))) )
         (assert-text-tree a) (assert-text-tree b)))))
(defun text-tree-leaves (root)
 (when root (if (lut::text-node-string root) (list root)
               (append (text-tree-leaves (lut::text-node-left root)) (text-tree-leaves (lut::text-node-right root))))))
(defun assert-text-index (buffer string)
 (assert (= (length string) (lut:text-length buffer)))
 (assert (string= string (lut:text-range buffer 0)))
 (let ((lines (lut::text-lines string)))
   (assert (= (length lines) (lut:text-line-count buffer)))
   (loop for bounds in lines for i from 0 do
     (assert (equal bounds (multiple-value-list (lut:text-line-range buffer i)))))
   (loop for p from 0 to (length string) do
     (assert (= (count #\Newline string :end p) (lut:text-position-line buffer p)))))
 (assert-text-tree (slot-value buffer 'lut::text-root)))
(defclass counting-text-view (lut:text-view) ((measured :initform 0 :accessor measured) (metric-scale :initform 1 :accessor metric-scale)))
(defmethod lut::text-character-advance ((view counting-text-view) character)
 (incf (measured view)) (* (metric-scale view) (if (char= character #\λ) 15 10)))
(defclass masked-index-view (lut:entry) ())
(defmethod lut:display-text ((view masked-index-view)) (make-string (lut:text-length view) :initial-element #\*))
(defun text-index-tests ()
 ;; Deterministic differential edits cover boundary chunks, Unicode and EOF.
 (let* ((string (format nil "αβ~%~%λ😀~%")) (buffer (lut:make-text-buffer :text string)) (seed 17))
   (labels ((next (limit) (setf seed (mod (+ (* seed 1103515245) 12345) 2147483648)) (mod seed limit)))
     (dotimes (i 300)
       (assert-text-index buffer string)
       (let* ((a (next (1+ (length string)))) (b (+ a (next (1+ (- (length string) a)))))
              (replacement (nth (next 6) (list "" "α" (string #\Newline) "λ😀" (format nil "a~%b") "xyz"))))
         (lut:replace-buffer-range buffer a b replacement)
         (setf string (concatenate 'string (subseq string 0 a) replacement (subseq string b)))))
     (assert-text-index buffer string)) (lut:dispose buffer))
 ;; AVL balance under many edits to a large buffer and structural sharing.
 (let* ((buffer (lut:make-text-buffer :text (make-string 1048576 :initial-element #\a)))
        (view (lut:make-widget 'lut:text-view :view-buffer buffer))
        (before (text-tree-leaves (slot-value buffer 'lut::text-root))))
   (lut:replace-buffer-range buffer 1048575 1048576 (format nil "λ~%"))
   (assert (not (slot-value buffer 'lut::text-snapshot-p)))
   (assert (= 1048577 (lut:text-length view)))
   (assert (= 2 (lut:text-line-count view)))
   (assert (equal '(1048577 1048577) (multiple-value-list (lut:text-line-range view 1))))
   (let ((after (text-tree-leaves (slot-value buffer 'lut::text-root))))
     (assert (>= (length (intersection before after :test #'eq)) (1- (length before)))))
   (dotimes (i 1000)
     (let ((p (mod (* i 997) (lut:text-length buffer))))
       (lut:replace-buffer-range buffer p p "x") (assert-text-tree (slot-value buffer 'lut::text-root))))
   (assert (not (slot-value buffer 'lut::text-snapshot-p)))
   (assert (lut:undo view)) (assert (lut:redo view))
   (assert (not (slot-value buffer 'lut::text-snapshot-p)))
   (lut:dispose view) (lut:dispose buffer))
 ;; Replacements/removals spanning many chunks, checked against a flat oracle.
 (let* ((string (with-output-to-string (out) (dotimes (i 600) (format out "~d αβγ~%" i))))
        (buffer (lut:make-text-buffer :text string)) (seed 91))
   (labels ((next (limit) (setf seed (mod (+ (* seed 1664525) 1013904223) 4294967296)) (mod seed limit)))
     (dotimes (i 200)
       (let* ((a (next (1+ (length string))))
              (b (+ a (next (1+ (min 1700 (- (length string) a))))))
              (replacement (make-string (next 1200) :initial-element (if (evenp i) #\λ #\Newline))))
         (lut:replace-buffer-range buffer a b replacement)
         (setf string (concatenate 'string (subseq string 0 a) replacement (subseq string b)))
         (assert (string= string (lut:text-range buffer 0)))
         (assert-text-tree (slot-value buffer 'lut::text-root))
         (let ((lines (lut::text-lines string)))
           (assert (= (length lines) (lut:text-line-count buffer)))
           (loop for bounds in lines for line from 0 do
             (assert (equal bounds (multiple-value-list (lut:text-line-range buffer line))))))
         (dotimes (j 12)
           (let ((p (next (1+ (length string)))))
             (assert (= (count #\Newline string :end p) (lut:text-position-line buffer p))))))))
   (lut:dispose buffer))
 ;; Geometry and visible-line iteration use independent viewport state.
 (let* ((buffer (lut:make-text-buffer :text (format nil "ab~%λx~%")))
        (view (lut:make-widget 'counting-text-view :view-buffer buffer :x 20 :y 30 :width 100 :height 36
                               :style '(:padding 4 :line-height 20)))
        (peer (lut:make-widget 'counting-text-view :view-buffer buffer :style '(:padding 4 :line-height 20))))
   (setf (lut:text-offset view) 3 (lut:vertical-offset view) 10)
   (assert (equal '(36 44 2 20) (multiple-value-list (lut:text-position-rectangle view 4))))
   (assert (= 4 (lut:text-point-position view 36 44)))
   (assert (= 0 (lut:text-point-position view -100 -100)))
   (assert (= 6 (lut:text-point-position view 500 500)))
   (let (visible)
     (assert (= 2 (lut:map-visible-text-lines view (lambda (&rest row) (push row visible)))))
     (assert (equal '((0 0 2 21 24) (1 3 5 21 44)) (nreverse visible))))
   (let ((old-x (lut:text-position-rectangle peer 4)))
     (lut:replace-buffer-range buffer 3 4 "xx")
     (assert (/= old-x (lut:text-position-rectangle peer 5))))
   (setf (lut:style view) '(:padding 8 :line-height 30))
   (assert (= 58 (nth-value 1 (lut:text-position-rectangle view 3))))
   (assert (not (slot-value buffer 'lut::text-snapshot-p)))
   (lut:dispose view) (assert (null (slot-value view 'lut::geometry-cache)))
   (lut:dispose peer) (lut:dispose buffer))
 ;; A long line is measured incrementally, in bounded runs, with cached advances.
 (let* ((buffer (lut:make-text-buffer :text (make-string 1048576 :initial-element #\a)))
        (view (lut:make-widget 'counting-text-view :view-buffer buffer :width 100 :style '(:padding 0))))
   (assert (= 5 (lut:text-point-position view 50 0)))
   (assert (<= (measured view) 256))
   (let ((count (measured view)))
     (assert (= 50 (lut:text-position-rectangle view 5)))
     (assert (= count (measured view))))
   (setf (lut:text-offset view) 10000)
   (assert (= 1005 (lut:text-point-position view 50 0)))
   (assert (<= (measured view) 1024))
   (lut:replace-buffer-range buffer 0 1 "λ")
   (setf (lut:text-offset view) 0)
   (assert (= 15 (lut:text-position-rectangle view 1)))
   (assert (not (slot-value buffer 'lut::text-snapshot-p)))
   (lut:dispose view) (lut:dispose buffer))
 ;; Effective inherited font styles invalidate; custom metric state has an
 ;; explicit invalidation hook. Allocation and scroll are query-time inputs.
 (let* ((root (lut:make-widget 'lut:window :style '(:font-size 10)))
        (view (lut:add-child root (lut:make-widget 'lut:text-view :text "abc" :style '(:padding 0)))))
   (assert (= 6 (lut:text-position-rectangle view 1)))
   (setf (lut:style root) '(:font-size 20))
   (assert (= 12 (lut:text-position-rectangle view 1)))
   (setf (lut:x view) 100 (lut:text-offset view) 5)
   (assert (= 107 (lut:text-position-rectangle view 1)))
   (setf (lut:text view) "x") (assert (= 1 (lut:text-line-count view)))
   (lut:dispose root))
 (let ((view (lut:make-widget 'counting-text-view :text "abc" :style '(:padding 0))))
   (assert (= 10 (lut:text-position-rectangle view 1)))
   (setf (metric-scale view) 2)
   (assert (eq view (lut:invalidate-text-geometry view)))
   (assert (= 20 (lut:text-position-rectangle view 1)))
   (lut:dispose view))
 ;; Standalone setters, display overrides, bad indices and zero-height viewports.
 (let ((view (lut:make-widget 'masked-index-view :text (format nil "a~%b") :height 0)))
   (assert (= 0 (lut:map-visible-text-lines view (lambda (&rest args) (declare (ignore args)) (error "Unexpected line")))))
   (assert (= 3 (lut:text-point-position view 1000 8)))
   (setf (lut:text view) "x") (assert (= 1 (lut:text-length view)))
   (assert (= 1 (lut:text-line-count view)))
   (assert (handler-case (progn (lut:text-line-range view 1) nil) (error () t)))
   (assert (handler-case (progn (lut:text-range view -1) nil) (error () t)))
   (assert (handler-case (progn (lut:text-position-rectangle view 2) nil) (error () t)))
   (lut:dispose view))
 (format t "Indexed storage, AVL sharing, Unicode/EOF ranges, incremental geometry, viewport/cache invalidation and disposal passed.~%"))
