(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/examples" :silent t)
(defun capture-wrapped (root path)
 (let ((texture (rl:load-render-texture (round (* (lut:ui-scale root) (lut:width root))) (round (* (lut:ui-scale root) (lut:height root))))))
   (unwind-protect
       (progn
         (rl:with-texture-mode (texture)
           (rl:clear-background (lut:style-value root :background)) (lut::render-window root))
         (let ((image (rl:load-image-from-texture (rl:render-texture-texture texture))))
           (unwind-protect (progn (rl:image-flip-vertical image) (rl:export-image image path)) (rl:unload-image image))))
     (rl:unload-render-texture texture))))
(dolist (scale '(1 5/4 2))
 (let* ((root (lut-examples:wrapped-text))
        (composer (lut:find-widget root :wrapped-composer))
        (document (lut:find-widget root :wrapped-document))
        (frame 0) (checked nil))
   (setf (lut:ui-scale root) scale)
   (setf (lut:text document) (format nil "Heading~%~a~%Linked paragraph wraps across several rows at narrow widths." (code-char #xfffc)))
   (lut:set-text-presentation document
     :runs '((:start 0 :end 7 :style (:font-size 32)))
     :images '((:position 8 :source "examples/assets/demo.png" :width 120 :height 90))
     :links '((:start 10 :end 68 :target :application-link)))
   (lut:on root :tick (lambda (w dt)
     (declare (ignore dt))
     (when (= 2 (incf frame))
       (lut:layout w 0 0 640 600)
       (let ((wide (lut:height composer)))
         (lut:layout w 0 0 220 700)
         (assert (> (lut:height composer) wide))
         (assert (= (lut:height composer) (nth-value 1 (lut:measure composer :vertical (lut:width composer)))))
         (multiple-value-bind (cx cy cw ch) (lut:text-position-rectangle document 8)
           (declare (ignore cw)) (assert (>= ch 90))
           (assert (eq :image (lut:document-hit-test document (+ cx 10) (+ cy 10)))))
         (let* ((row (aref (lut::wrapped-rows composer) 1)) (p (lut::visual-row-start row)))
           (multiple-value-bind (cx cy cw ch) (lut:text-position-rectangle composer p)
             (declare (ignore cw ch))
             (dolist (kind '(:down :up))
               (lut:dispatch-device-event w (lut:make-event :kind kind :x (* scale cx) :y (* scale (+ cy 1)))))
             (assert (= p (lut:cursor composer)))))
         (capture-wrapped w (format nil "/tmp/lut-wrapped-narrow-~d.png" (round (* scale 100))))
         (lut:select-all composer)
         ;; Keep selection active through an actual render frame.
         (lut:layout w 0 0 640 600)
         (assert (= wide (lut:height composer)))
         (capture-wrapped w (format nil "/tmp/lut-wrapped-wide-~d.png" (round (* scale 100))))
         (setf checked t)))))
   (unwind-protect (progn (lut:run root :frames 4) (assert checked)) (lut:dispose root))))
(format t "Native wrapped text reflow, heading/image rendering, selection and scaled pointer input passed at 100/125/200%.~%")
