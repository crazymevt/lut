(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lui.asd"))
(ql:quickload "lui/gtk-demo-native" :silent t)
;; Actual codec IO, not the injected deterministic decoder used in headless tests.
(let* ((root (lui-gtk-demo:demo "video_player")) (resource nil) (directory nil) (frames 0))
 (lui:on root :tick (lambda (w dt) (declare (ignore w dt))
  (incf frames)
  (when (= frames 1)
   (setf (lui-gtk-demo::state root :volume) 0)
   (lui-gtk-demo::load-video root)
   (setf resource (lui-gtk-demo::state root :video))
   (assert resource)
   (setf directory (lui-gtk-demo::frame-directory resource))
   (assert (= 20 (length (lui-gtk-demo::frame-files resource))))
   (assert (probe-file (lui-gtk-demo::frame-audio resource)))
   (assert (probe-file (aref (lui-gtk-demo::frame-files resource) 0))))
  (when (= frames 2)
   (assert (= 1 lui-gtk-demo-native::*music-users*))
   (assert (lui-gtk-demo-native::music-started-p (lui-gtk-demo::state root :music-resource)))
   (setf (lui-gtk-demo::state root :running) nil))
  (when (= frames 3)
   (assert (not (lui-gtk-demo-native::music-playing-p (lui-gtk-demo::state root :music-resource))))
   (setf (lui-gtk-demo::state root :time) 0.5 (lui-gtk-demo::state root :running) t))
  (when (= frames 4)
   (assert (lui-gtk-demo-native::music-playing-p (lui-gtk-demo::state root :music-resource))))))
 (unwind-protect (lui:run root :frames 4) (lui:dispose root))
 (assert (null (probe-file directory)))
 (assert (zerop lui-gtk-demo-native::*music-users*))
 (assert (not lui-gtk-demo-native::*own-audio-device*))
 (assert (null (lui-gtk-demo::frame-files resource)))
 (format t "Real FFmpeg playback frames and temporary-file disposal passed.~%"))
;; Repeated source reloads must not accumulate disposed shader resource wrappers.
(let* ((root (lui-gtk-demo:demo "shadertoy")) (frames 0))
 (lui:on root :tick (lambda (w dt) (declare (ignore w dt))
  (when (> frames 0) (assert (= 1 (length (lui-gtk-demo::native-resources root)))))
  (setf (lui-gtk-demo::state root :shader)
        (concatenate 'string lui-gtk-demo::*fragment-shader* (format nil "~%// Reload ~d" (incf frames))))))
 (unwind-protect (lui:run root :frames 12)
  (assert (null (lui-gtk-demo::native-resources root)))
  (lui:dispose root))
 (assert (null lui::*font-cache*)) (assert (null lui::*texture-cache*))
 (format t "Repeated live shader reload and context-close cleanup passed.~%"))
