(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/gtk-demo-native" :silent t)
;; Actual codec IO, not the injected deterministic decoder used in headless tests.
(let* ((root (lut-gtk-demo:demo "video_player")) (resource nil) (directory nil) (frames 0))
 (lut:on root :tick (lambda (w dt) (declare (ignore w dt))
  (incf frames)
  (when (= frames 1)
   (setf (lut-gtk-demo::state root :volume) 0)
   (lut::layout-window root)
   (let* ((load (lut-gtk-demo::control root :load))
          (x (+ (lut:x load) (/ (lut:width load) 2)))
          (y (+ (lut:y load) (/ (lut:height load) 2))))
     (assert (<= (+ (lut:y load) (lut:height load)) (lut:height root)))
     (assert (eq load (lut:hit-test root x y)))
     (lut:dispatch root (lut:make-event :kind :down :x x :y y))
     (lut:dispatch root (lut:make-event :kind :up :x x :y y)))
   (setf resource (lut-gtk-demo::state root :video))
   (assert resource)
   (setf directory (lut-gtk-demo::frame-directory resource))
   (assert (= 20 (length (lut-gtk-demo::frame-files resource))))
   (assert (probe-file (lut-gtk-demo::frame-audio resource)))
   (assert (probe-file (aref (lut-gtk-demo::frame-files resource) 0))))
  (when (= frames 2)
   (assert (some (lambda (entry)
                   (equal (first (car entry))
                          (namestring (aref (lut-gtk-demo::frame-files resource) 0))))
                 lut::*texture-cache*))
   (assert (= 1 lut-gtk-demo-native::*music-users*))
   (assert (lut-gtk-demo-native::music-started-p (lut-gtk-demo::state root :music-resource)))
   (setf (lut-gtk-demo::state root :running) nil))
  (when (= frames 3)
   (assert (not (lut-gtk-demo-native::music-playing-p (lut-gtk-demo::state root :music-resource))))
   (setf (lut-gtk-demo::state root :time) 0.5 (lut-gtk-demo::state root :running) t))
  (when (= frames 4)
   (assert (lut-gtk-demo-native::music-playing-p (lut-gtk-demo::state root :music-resource))))))
 (unwind-protect (lut:run root :frames 4) (lut:dispose root))
 (assert (null (probe-file directory)))
 (assert (zerop lut-gtk-demo-native::*music-users*))
 (assert (not lut-gtk-demo-native::*own-audio-device*))
 (assert (null (lut-gtk-demo::frame-files resource)))
 (format t "Visible Load button, real FFmpeg playback frames and temporary-file disposal passed.~%"))
;; Repeated source reloads must not accumulate disposed shader resource wrappers.
(let* ((root (lut-gtk-demo:demo "shadertoy")) (frames 0))
 (lut:on root :tick (lambda (w dt) (declare (ignore w dt))
  (when (> frames 0) (assert (= 1 (length (lut-gtk-demo::native-resources root)))))
  (setf (lut-gtk-demo::state root :shader)
        (concatenate 'string lut-gtk-demo::*fragment-shader* (format nil "~%// Reload ~d" (incf frames))))))
 (unwind-protect (lut:run root :frames 12)
  (assert (null (lut-gtk-demo::native-resources root)))
  (lut:dispose root))
 (assert (null lut::*font-cache*)) (assert (null lut::*texture-cache*))
 (format t "Repeated live shader reload and context-close cleanup passed.~%"))
