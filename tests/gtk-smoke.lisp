(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload '("lut/raylib" "lut/gtk-demo"))
(dolist (name (lut-gtk-demo:demo-names))
 (let ((root (lut-gtk-demo:demo name)))
  (unwind-protect (lut:run root :frames 2) (lut:dispose root)))
 (format t "GTK native adaptation ~a: passed~%" name))
