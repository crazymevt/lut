(in-package #:lut-tests)
(defun demo-findings-tests ()
 (symbol-tooltip-tests)
 ;; Text inputs keep visible focus after pointer activation, including combo-box
 ;; whose event handler can consume input before dispatch-base runs.
 (dolist (class '(lut:entry lut:text-view lut:combo-box))
   (let* ((root (lut:make-widget 'lut:window :width 500 :height 200))
          (field (lut:add-child root (lut:make-widget class :text "Editable"))))
     (lut:layout root 0 0 500 200)
     (lut:dispatch root (lut:make-event :kind :down :x 20 :y 20))
     (lut:dispatch root (lut:make-event :kind :up :x 20 :y 20))
     (assert (eq field (lut:focused-widget root)))
     (assert (lut::focus-visible-p root))))
 (let* ((root (lut:make-widget 'lut:window :width 500 :height 400))
        (spin (lut:add-child root (lut:make-widget 'lut:spin-button :value 5 :maximum 20))))
   (lut:layout root 0 0 500 400)
   (flet ((send (kind x &optional (delta 0))
            (lut:dispatch root (lut:make-event :kind kind :x x :y 20 :delta delta))))
     (send :down 20) (assert (= 5 (lut:value spin)))
     (send :up 20) (assert (= 4 (lut:value spin)))
     (send :down 20) (send :move 100) (send :up 100)
     (assert (= 4 (lut:value spin)))
     (assert (eq spin (lut:focused-widget root)))
     (assert (not (lut::focus-visible-p root)))
     (send :wheel 100 0.25) (assert (= 5 (lut:value spin)))
     (send :wheel 100 -0.25) (assert (= 4 (lut:value spin)))
     (send :down 470) (send :move 400) (send :up 400)
     (assert (= 4 (lut:value spin)))
     (send :down 470) (send :up 470) (assert (= 5 (lut:value spin)))
     (send :down 250) (send :up 250) (assert (= 5 (lut:value spin)))
     (lut:dispatch root (lut:make-event :kind :key :key :up))
     (assert (= 6 (lut:value spin))) (assert (lut::focus-visible-p root))
     (setf (lut:step spin) 0.5)
     (send :wheel 100 0.1) (assert (= 6.5 (lut:value spin)))))
 (let* ((root (lut:make-widget 'lut:window :width 300 :height 200))
        (view (lut:add-child root (lut:make-widget 'lut:scroll-view :height 150))))
   (dotimes (i 20) (lut:add-child view (lut:make-widget 'lut:button :text (write-to-string i))))
   (lut:layout root 0 0 300 200)
   (assert (plusp (lut::scroll-range view)))
   (multiple-value-bind (sx sy sw sh travel) (lut::scrollbar-bounds view)
     (declare (ignore sw travel))
     (assert (< (+ (lut:x (first (lut:children view))) (lut:width (first (lut:children view)))) sx))
     (lut:dispatch root (lut:make-event :kind :down :x (+ sx 2) :y (+ sy (/ sh 2))))
     (lut:dispatch root (lut:make-event :kind :move :x (+ sx 2) :y (+ (lut:y view) (lut:height view))))
     (lut:dispatch root (lut:make-event :kind :up :x (+ sx 2) :y 190))
     (assert (= (lut:scroll-offset view) (lut::scroll-range view)))
     (assert (null (slot-value root 'lut::pressed-widget))))
   (lut:layout root 0 0 300 200)
   (lut:dispatch root (lut:make-event :kind :wheel :x 20 :y 20 :delta 1))
   (assert (< (lut:scroll-offset view) (lut::scroll-range view)))
   (dolist (c (rest (lut:children view))) (setf (lut:visible-p c) nil))
   (lut:layout root 0 0 300 200)
   (assert (zerop (lut:scroll-offset view))) (assert (zerop (lut::scroll-range view))))
 (let* ((root (lut:make-widget 'lut:window :width 500 :height 250))
        (button (lut:add-child root (lut:make-widget 'lut:button :tooltip-text "Visible help"))))
   (lut:layout root 0 0 500 250)
   (lut:dispatch root (lut:make-event :kind :move :x 470 :y 20))
   (let* ((tip (first (lut::overlays root))) (label (first (lut:children tip))))
     (assert (typep tip 'lut:tooltip))
     (assert (string= "Visible help" (lut:text label)))
     (assert (<= (lut:x tip) (lut:x label)))
     (assert (<= (+ (lut:x label) (lut:width label)) (+ (lut:x tip) (lut:width tip))))
     (assert (<= (+ (lut:y label) (lut:height label)) (+ (lut:y tip) (lut:height tip))))
     (assert (<= (+ (lut:x tip) (lut:width tip)) (lut:width root)))
     (assert (eq button (lut:hit-test root 470 20)))))
 (format t "Demo findings: spin steps, pointer/keyboard focus, scrollbar capture, wheel/clamping and first-frame tooltip layout passed.~%"))

(defclass tooltip-metric-button (lut:button) ())
(defmethod lut:text-width ((button tooltip-metric-button) text)
 (declare (ignore button text)) 0)
(defun symbol-tooltip-tests ()
 (let* ((root (lut:make-widget 'lut:window :width 500 :height 250))
        (button (lut:add-child root (lut:make-widget 'tooltip-metric-button
                   :text "X" :style '(:font-size 24 :padding 4)
                   :tooltip-text "Toggle explorer"))))
   (lut:layout root 0 0 500 250)
   (lut:dispatch root (lut:make-event :kind :move :x (+ (lut:x button) 10) :y (+ (lut:y button) 10)))
   (let* ((tip (first (lut::overlays root))) (label (first (lut:children tip))))
     (assert (typep tip 'lut:tooltip))
     (assert (>= (- (lut:width label) (* 2 (lut:style-value label :padding)))
                 (lut:text-width label (lut:text label))))
     (assert (= (lut:height tip) (+ (lut:style-value label :font-size) 10)))
     (assert (= (- (lut:y label) (lut:y tip))
                (- (+ (lut:y tip) (lut:height tip)) (+ (lut:y label) (lut:height label)))))
     (assert (= (lut:width tip) (+ 16 (lut:text-width label (lut:text label))))))
   (lut:dispose root)))
