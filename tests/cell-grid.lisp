(in-package #:lut-tests)
(defun cell-grid-tests ()
 (let* ((root (lut:make-widget 'lut:window :width 300 :height 200))
        (grid (lut:add-child root (lut:make-widget 'lut:cell-grid)))
        (button (lut:add-child root (lut:make-widget 'lut:button)))
        (keys nil) (texts nil) (window-keys 0) (sizes nil) (commands 0))
   (unwind-protect
     (progn
       (lut:on grid :grid-resize (lambda (w size) (declare (ignore w)) (push size sizes)))
       (lut:set-grid-cell-metrics grid 10 20)
       (lut:layout grid 12 24 40 60)
       (assert (equal '(4 3) (list (lut:grid-columns grid) (lut:grid-rows grid))))
       (assert (equal '(4 3) (first sizes)))
       (let ((count (length sizes))) (lut:layout grid 12 24 40 60) (assert (= count (length sizes))))
       (assert (equal '(10 20) (multiple-value-list (lut:grid-cell-metrics grid))))
       (assert (equal '(1 1) (multiple-value-list (lut:grid-point-cell grid 22 44))))
       (assert (null (lut:grid-point-cell grid 52 24)))
       (assert (equal '(3 0) (multiple-value-list (lut:grid-point-cell grid 99 -1 :clamp t))))
       (loop for r below 3 do (loop for c below 4 do (lut:set-grid-cell grid c r (code-char (+ 65 c (* 4 r))))))
       (lut:select-grid-cells grid 2 1 1 0)
       (assert (string= (format nil "BCD~%EFG") (lut:grid-selected-text grid)))
       (lut:select-grid-cells grid 2 1 1 0 :rectangular t)
       (assert (string= (format nil "BC~%FG") (lut:copy-grid-selection grid)))
       (assert (string= (lut:clipboard-text grid) (lut:grid-selected-text grid)))
       (let ((color (list 1 2 3 255)))
         (lut:set-grid-cell grid 0 0 #\x :foreground color)
         (setf (first color) 99)
         (let ((cell (lut:grid-cell grid 0 0)))
           (assert (= 1 (first (getf cell :foreground))))
           (setf (getf cell :character) #\z)
           (assert (char= #\x (getf (lut:grid-cell grid 0 0) :character)))))
       (assert (handler-case (progn (lut:set-grid-cell-metrics grid 0 10) nil) (error () t)))
       (assert (handler-case (progn (lut:set-grid-cell grid 0 0 #\Newline) nil) (error () t)))
       (lut:layout grid 12 24 20 20)
       (assert (char= #\x (getf (lut:grid-cell grid 0 0) :character)))
       (assert (string= "" (lut:grid-selected-text grid)))
       (lut:layout grid 12 24 0 0)
       (assert (null (lut:grid-point-cell grid 0 0 :clamp t)))
       (lut:layout grid 12 24 40 60)
       ;; Captured keys/text bypass window handlers and commands; passthrough
       ;; is explicit and the release event itself is consumed.
       (lut:on root :key (lambda (w event) (declare (ignore w event)) (incf window-keys)))
       (lut:on grid :raw-key (lambda (w event) (declare (ignore w)) (push (lut:event-key event) keys)))
       (lut:on grid :raw-text (lambda (w event) (declare (ignore w)) (push (lut:event-text event) texts)))
       (let ((command (lut:make-command :test "Test" (lambda (c context) (declare (ignore c context)) (incf commands)) :shortcut :left)))
         (unwind-protect
           (progn
             (lut:bind-command root command)
             (lut:focus root grid) (lut:capture-keys grid)
             (dolist (key '(:tab :escape :left :c)) (lut:dispatch root (lut:make-event :kind :key :key key)))
             (lut:dispatch root (lut:make-event :kind :text :text "hello"))
             (assert (equal '(:c :left :escape :tab) keys)) (assert (equal '("hello") texts))
             (assert (zerop window-keys)) (assert (zerop commands))
             (assert (eq grid (lut:focused-widget root)))
             (lut:capture-keys grid :passthrough '(:left))
             (lut:dispatch root (lut:make-event :kind :key :key :left))
             (assert (= 1 commands))
             (lut:dispatch root (lut:make-event :kind :key :key :f12))
             (assert (not (lut:keys-captured-p grid)))
             (lut:dispatch root (lut:make-event :kind :key :key :tab))
             (assert (eq button (lut:focused-widget root)))
             (lut:focus root grid) (lut:capture-keys grid) (lut:focus root button)
             (assert (not (lut:keys-captured-p grid)))
             (assert (handler-case (progn (lut:capture-keys grid :release-key nil) nil) (error () t))))
           (lut:dispose command)))
       ;; Popup Escape handling retains precedence over capture.
       (lut:focus root grid) (lut:capture-keys grid)
       (let ((popup (lut:make-widget 'lut:suggestion-surface :items '("one" "two"))))
         (lut:show-anchored-surface grid popup :rectangle '(12 24 10 20))
         (let ((count (length keys)))
           (lut:dispatch root (lut:make-event :kind :key :key :escape))
           (assert (= count (length keys)))
           (assert (null (lut::anchor-owner popup))))
         (lut:dispose popup))
       ;; A modal input scope prevents capture by a previously focused grid.
       (let ((dialog (lut:make-widget 'lut:dialog)))
         (lut:show-dialog root dialog)
         (let ((count (length keys)))
           (lut:dispatch root (lut:make-event :kind :key :key :left))
           (assert (= count (length keys))))
         (lut:dismiss-dialog dialog) (lut:dispose dialog))
       (lut:focus root grid) (lut:capture-keys grid)
       (let ((count (length keys)))
         (setf (lut:enabled-p grid) nil)
         (let ((text-count (length texts)))
           (lut:dispatch root (lut:make-event :kind :text :text "disabled"))
           (assert (= text-count (length texts))))
         (lut:dispatch root (lut:make-event :kind :key :key :tab))
         (assert (= count (length keys)))
         (setf (lut:enabled-p grid) t))
       (lut:focus root grid) (lut:capture-keys grid)
       (lut:remove-child root grid)
       (assert (not (lut:keys-captured-p grid)))
       (lut:add-child root grid)
       ;; Pointer drag is routed through existing pointer capture, even outside.
       (lut:layout button 200 100 60 30)
       (lut:layout grid 12 24 40 60)
       (dotimes (r 3) (dotimes (c 4) (lut:set-grid-cell grid c r #\a)))
       (lut:dispatch root (lut:make-event :kind :down :x 13 :y 25))
       (lut:dispatch root (lut:make-event :kind :move :x 51 :y 83))
       (lut:dispatch root (lut:make-event :kind :up :x 51 :y 83))
       (assert (not (lut::pressed-p grid)))
       (assert (string= (format nil "aaaa~%aaaa~%aaaa") (lut:grid-selected-text grid)))
       (lut:dispatch root (lut:make-event :kind :key :key :copy :base-key :c :super-p t))
       (assert (string= (lut:grid-selected-text grid) (lut:clipboard-text grid)))
       (lut:dispatch root (lut:make-event :kind :down :x 33 :y 65 :alt-p t))
       (lut:dispatch root (lut:make-event :kind :move :x 23 :y 45))
       (lut:dispatch root (lut:make-event :kind :up :x 23 :y 45))
       (assert (string= (format nil "aa~%aa") (lut:grid-selected-text grid)))
       (lut:focus root grid)
       (let ((release (list :key :k :control t)))
         (lut:capture-keys grid :release-key release)
         (setf (getf release :key) :q)
         (lut:dispatch root (lut:make-event :kind :key :key :control-k :base-key :k :control-p t))
         (assert (not (lut:keys-captured-p grid))))
       (lut:capture-keys grid) (setf (lut:focused-widget root) nil)
       (assert (not (lut:keys-captured-p grid)))
       (lut:dispose grid) (assert (zerop (lut:grid-columns grid))))
     (lut:dispose root)))
 (format t "Cell grid and key capture tests passed.~%"))
