(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/raylib" :silent t)
(let* ((root (lut:make-widget 'lut:window :width 540 :height 470 :text "Date/time picker checks"))
       (date (lut:add-child root (lut:make-widget 'lut:date-picker :calendar-date '(2024 2 29))))
       (time (lut:add-child root (lut:make-widget 'lut:time-picker :clock-time '(23 59 59))))
       (frame 0))
 (lut:on root :tick
   (lambda (w dt)
     (declare (ignore dt))
     (incf frame)
     (case frame
       (2 (lut:focus w date)
          (lut:dispatch w (lut:make-event :kind :key :key :enter)))
       (4 (assert (lut::picker-popup date))
          (rl:take-screenshot "/tmp/lut-date-time-calendar.png")
          (lut:dispatch w (lut:make-event :kind :key :key :escape))
          (assert (null (lut::picker-popup date)))
          (assert (eq (lut:focused-widget w) date)))
       (5 (lut:focus w time)
          (lut:dispatch w (lut:make-event :kind :key :key :up))
          (assert (equal '(0 59 59) (lut:clock-time time))))
       (7 (rl:take-screenshot "/tmp/lut-date-time.png")))))
 (unwind-protect (lut:run root :frames 8) (lut:dispose root))
 (format t "PASS: native date calendar, cancellation/focus, and time edits rendered.~%"))
