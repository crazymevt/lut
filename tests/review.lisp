(in-package #:lui-tests)
(defun review-tests ()
 ;; F8: fractional and degenerate numeric ranges.
 (let ((s (lui:make-widget 'lui:slider :minimum 0 :maximum 0.5 :value 0.25)))
   (assert (= 0.5 (lui:range-fraction s)))
   (setf (lui:value s) 0.5) (assert (= 1 (lui:range-fraction s)))
   (assert (handler-case (progn (setf (lui:value s) 1) nil) (error () t)))
   (assert (= 0.5 (lui:value s))))
 (assert (zerop (lui:range-fraction (lui:make-widget 'lui:slider :minimum 2 :maximum 2 :value 2))))
 ;; F11: invalid REPL edits cannot corrupt the previous slot value.
 (let ((b (lui:make-widget 'lui:box)))
   (assert (handler-case (progn (setf (lui:orientation b) :diagonal) nil) (type-error () t)))
   (assert (eq :vertical (lui:orientation b))))
 ;; F5: root class/state rule and local state override precedence.
 (let* ((w (lui:make-widget 'lui:window :style-rules
              '((:class lui:button :state :hover :style (:font-size 32)))))
        (b (lui:make-widget 'lui:button)))
   (lui:add-child w b) (lui:layout w 0 0 600 400)
   (lui:dispatch w (lui:make-event :kind :move :x 10 :y 10))
   (assert (= 32 (lui:style-value b :font-size)))
   (setf (lui:state-style b) '(:hover (:font-size 22)))
   (assert (= 22 (lui:style-value b :font-size)))
   (setf (lui:enabled-p w) nil)
   (assert (eq :disabled (lui:widget-state b))))
 ;; F2: dialog drag persists across subsequent layout passes.
 (let* ((w (lui:make-widget 'lui:window :width 600 :height 400))
        (d (lui:make-widget 'lui:dialog :width 200 :height 160 :detach-on-drag-p nil)))
   (lui:show-dialog w d) (lui:layout d 100 100 200 160)
   (lui:dispatch w (lui:make-event :kind :down :x 110 :y 110))
   (lui:dispatch w (lui:make-event :kind :move :x 160 :y 150))
   (lui:dispatch w (lui:make-event :kind :up :x 160 :y 150))
   (assert (eq :absolute (lui:position-mode d)))
   (assert (= 150 (lui:x d))) (assert (= 140 (lui:y d))))
 ;; F4: reusable entry menu, pointer positioning, action routing and dismissal.
 (let* ((w (lui:make-widget 'lui:window :width 600 :height 400))
        (field (lui:make-widget 'lui:entry :text "hello")))
   (lui:add-child w field) (lui:layout w 0 0 600 400) (lui:select-all field)
   (lui:dispatch w (lui:make-event :kind :context :x 20 :y 20))
   (let ((menu (lui::input-root w)))
     (assert (typep menu 'lui:context-menu))
     (assert (= 20 (lui:x menu))) (assert (= 4 (length (lui:children menu))))
     (lui::activate (second (lui:children menu)))
     (assert (string= "hello" (lui:clipboard-text field))))
   (lui:dispatch w (lui:make-event :kind :context :x 20 :y 20))
   (lui:dispatch w (lui:make-event :kind :down :x 590 :y 390))
   (assert (eq w (lui::input-root w))))
 ;; F3: page selection excludes inactive children from hit testing.
 (let* ((stack (lui:make-widget 'lui:stack))
        (a (lui:make-widget 'lui:button :text "a")) (b (lui:make-widget 'lui:button :text "b")))
   (lui:add-child stack a) (lui:add-child stack b)
   (lui:layout stack 0 0 200 100)
   (assert (eq a (lui:hit-test stack 10 10)))
   (lui:select-page stack 1)
   (lui:layout stack 0 0 200 100)
   (assert (eq b (lui:hit-test stack 10 10))))
 (let ((a (lui:make-widget 'lui:radio-button)) (b (lui:make-widget 'lui:radio-button)))
   (lui:group-radios a b) (lui::activate a) (lui::activate b)
   (assert (not (lui:value a))) (assert (lui:value b)))
 (let ((tree (lui:make-widget 'lui:tree-view :nodes
              '((:text "Root" :children ((:text "Child")))))))
   (assert (= 1 (length (lui:tree-rows tree))))
   (lui:handle-event tree (lui:make-event :kind :down :x 1 :y 1))
   (assert (= 2 (length (lui:tree-rows tree)))))
 (let* ((main (lui:make-widget 'lui:window :theme lui:*dark-theme*
                    :style-rules '((:class lui:button :style (:font-size 27)))))
        (second (lui:make-widget 'lui:window :theme nil :style-source main))
        (button (lui:add-child second (lui:make-widget 'lui:button))))
   (assert (= 27 (lui:style-value button :font-size)))
   (assert (equal (getf lui:*dark-theme* :foreground) (lui:style-value button :foreground)))
   (setf (lui:theme main) lui:*light-theme*)
   (assert (equal (getf lui:*light-theme* :foreground) (lui:style-value button :foreground)))
   (assert (handler-case (progn (setf (lui:style-source main) second) nil) (error () t)))
   (assert (null (lui:style-source main))))
 (format t "Review regression checks passed.~%") t)
(defun widget-coverage-tests ()
 (let ((grid (lui:make-widget 'lui:grid :columns 2)))
   (dotimes (i 4) (lui:add-child grid (lui:make-widget 'lui:button :id (intern (format nil "CELL-~d" i) :keyword))))
   (lui:layout grid 0 0 400 200)
   (assert (= (lui:width (first (lui:children grid))) (lui:width (second (lui:children grid)))))
   (assert (> (lui:y (third (lui:children grid))) (lui:y (first (lui:children grid))))))
 (let* ((w (lui:make-widget 'lui:window))
        (d (lui:make-widget 'lui:dropdown :items '("First" "Second")))
        (changed nil))
   (lui:add-child w d) (lui:layout w 0 0 600 400)
   (lui:on d :change (lambda (w v) (declare (ignore w)) (setf changed v)))
   (lui:handle-event d (lui:make-event :kind :key :key :enter))
   (let* ((popup (lui::input-root w)) (list (first (lui:children popup))))
     (lui:focus w list) (lui:dispatch w (lui:make-event :kind :key :key :down))
     (assert (= 1 changed)) (assert (= 1 (lui:value d)))
     (assert (eq w (lui::input-root w)))))
 (let ((table (lui:make-widget 'lui:column-view :columns '("Name" "Rank") :rows '(("Z" 2) ("A" 1)))))
   (lui:sort-table table 0)
   (assert (equal '("A" 1) (first (lui:rows table)))))
 (let* ((w (lui:make-widget 'lui:window :width 600 :height 500)) (chosen nil)
        (d (lui:choose-color w (lambda (color) (setf chosen color)) :initial '(1 2 3 255))))
   (setf (lui:value (first (lui:children d))) 42)
   (lui:emit (first (lui:children d)) :change 42)
   (lui::activate (car (last (lui:children d))))
   (assert (equal '(42 2 3 255) chosen)))
 (let* ((w (lui:make-widget 'lui:window)) (chosen nil)
        (d (lui:choose-font w (lambda (path size) (setf chosen (list path size)))
                           :initial (asdf:system-relative-pathname "lui" "assets/NotoSans-Regular.ttf"))))
   (lui::activate (car (last (lui:children d))))
   (assert (probe-file (first chosen))) (assert (= 18 (second chosen))))
 (let* ((w (lui:make-widget 'lui:window)) (chosen nil)
        (d (lui:choose-file w (lambda (path) (setf chosen path)) :directory (asdf:system-source-directory "lui"))))
   (setf (lui:text (first (lui:children d))) (namestring (asdf:system-relative-pathname "lui" "lui.asd")))
   (lui::activate (car (last (lui:children d))))
   (assert (probe-file chosen)))
 (format t "Expanded widget behavior checks passed.~%") t)
