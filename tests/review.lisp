(in-package #:lut-tests)
(defun review-tests ()
 ;; F8: fractional and degenerate numeric ranges.
 (let ((s (lut:make-widget 'lut:slider :minimum 0 :maximum 0.5 :value 0.25)))
   (assert (= 0.5 (lut:range-fraction s)))
   (setf (lut:value s) 0.5) (assert (= 1 (lut:range-fraction s)))
   (assert (handler-case (progn (setf (lut:value s) 1) nil) (error () t)))
   (assert (= 0.5 (lut:value s))))
 (assert (zerop (lut:range-fraction (lut:make-widget 'lut:slider :minimum 2 :maximum 2 :value 2))))
 ;; F11: invalid REPL edits cannot corrupt the previous slot value.
 (let ((b (lut:make-widget 'lut:box)))
   (assert (handler-case (progn (setf (lut:orientation b) :diagonal) nil) (type-error () t)))
   (assert (eq :vertical (lut:orientation b))))
 ;; F5: root class/state rule and local state override precedence.
 (let* ((w (lut:make-widget 'lut:window :style-rules
              '((:class lut:button :state :hover :style (:font-size 32)))))
        (b (lut:make-widget 'lut:button)))
   (lut:add-child w b) (lut:layout w 0 0 600 400)
   (lut:dispatch w (lut:make-event :kind :move :x 10 :y 10))
   (assert (= 32 (lut:style-value b :font-size)))
   (setf (lut:state-style b) '(:hover (:font-size 22)))
   (assert (= 22 (lut:style-value b :font-size)))
   (setf (lut:enabled-p w) nil)
   (assert (eq :disabled (lut:widget-state b))))
 ;; F2: dialog drag persists across subsequent layout passes.
 (let* ((w (lut:make-widget 'lut:window :width 600 :height 400))
        (d (lut:make-widget 'lut:dialog :width 200 :height 160 :detach-on-drag-p nil)))
   (lut:show-dialog w d) (lut:layout d 100 100 200 160)
   (lut:dispatch w (lut:make-event :kind :down :x 110 :y 110))
   (lut:dispatch w (lut:make-event :kind :move :x 160 :y 150))
   (lut:dispatch w (lut:make-event :kind :up :x 160 :y 150))
   (assert (eq :absolute (lut:position-mode d)))
   (assert (= 150 (lut:x d))) (assert (= 140 (lut:y d))))
 ;; F4: reusable entry menu, pointer positioning, action routing and dismissal.
 (let* ((w (lut:make-widget 'lut:window :width 600 :height 400))
        (field (lut:make-widget 'lut:entry :text "hello")))
   (lut:add-child w field) (lut:layout w 0 0 600 400) (lut:select-all field)
   (lut:dispatch w (lut:make-event :kind :context :x 20 :y 20))
   (let ((menu (lut::input-root w)))
     (assert (typep menu 'lut:context-menu))
     (assert (= 20 (lut:x menu))) (assert (= 4 (length (lut:children menu))))
     (lut::activate (second (lut:children menu)))
     (assert (string= "hello" (lut:clipboard-text field))))
   (lut:dispatch w (lut:make-event :kind :context :x 20 :y 20))
   (lut:dispatch w (lut:make-event :kind :down :x 590 :y 390))
   (assert (eq w (lut::input-root w))))
 ;; F3: page selection excludes inactive children from hit testing.
 (let* ((stack (lut:make-widget 'lut:stack))
        (a (lut:make-widget 'lut:button :text "a")) (b (lut:make-widget 'lut:button :text "b")))
   (lut:add-child stack a) (lut:add-child stack b)
   (lut:layout stack 0 0 200 100)
   (assert (eq a (lut:hit-test stack 10 10)))
   (lut:select-page stack 1)
   (lut:layout stack 0 0 200 100)
   (assert (eq b (lut:hit-test stack 10 10))))
 (let ((a (lut:make-widget 'lut:radio-button)) (b (lut:make-widget 'lut:radio-button)))
   (lut:group-radios a b) (lut::activate a) (lut::activate b)
   (assert (not (lut:value a))) (assert (lut:value b)))
 (let ((tree (lut:make-widget 'lut:tree-view :nodes
              '((:text "Root" :children ((:text "Child")))))))
   (assert (= 1 (length (lut:tree-rows tree))))
   (lut:handle-event tree (lut:make-event :kind :down :x 1 :y 1))
   (assert (= 2 (length (lut:tree-rows tree)))))
 (let* ((main (lut:make-widget 'lut:window :theme lut:*dark-theme*
                    :style-rules '((:class lut:button :style (:font-size 27)))))
        (second (lut:make-widget 'lut:window :theme nil :style-source main))
        (button (lut:add-child second (lut:make-widget 'lut:button))))
   (assert (= 27 (lut:style-value button :font-size)))
   (assert (equal (getf lut:*dark-theme* :foreground) (lut:style-value button :foreground)))
   (setf (lut:theme main) lut:*light-theme*)
   (assert (equal (getf lut:*light-theme* :foreground) (lut:style-value button :foreground)))
   (assert (handler-case (progn (setf (lut:style-source main) second) nil) (error () t)))
   (assert (null (lut:style-source main))))
 (format t "Review regression checks passed.~%") t)
(defun widget-coverage-tests ()
 (let ((grid (lut:make-widget 'lut:grid :columns 2)))
   (dotimes (i 4) (lut:add-child grid (lut:make-widget 'lut:button :id (intern (format nil "CELL-~d" i) :keyword))))
   (lut:layout grid 0 0 400 200)
   (assert (= (lut:width (first (lut:children grid))) (lut:width (second (lut:children grid)))))
   (assert (> (lut:y (third (lut:children grid))) (lut:y (first (lut:children grid))))))
 (let* ((w (lut:make-widget 'lut:window))
        (d (lut:make-widget 'lut:dropdown :items '("First" "Second")))
        (changed nil))
   (lut:add-child w d) (lut:layout w 0 0 600 400)
   (lut:on d :change (lambda (w v) (declare (ignore w)) (setf changed v)))
   (lut:handle-event d (lut:make-event :kind :key :key :enter))
   (let* ((popup (lut::input-root w)) (list (first (lut:children popup))))
     (lut:focus w list) (lut:dispatch w (lut:make-event :kind :key :key :down))
     (assert (= 1 changed)) (assert (= 1 (lut:value d)))
     (assert (eq w (lut::input-root w)))))
 (let ((table (lut:make-widget 'lut:column-view :columns '("Name" "Rank") :rows '(("Z" 2) ("A" 1)))))
   (lut:sort-table table 0)
   (assert (equal '("A" 1) (first (lut:rows table)))))
 (let* ((w (lut:make-widget 'lut:window :width 600 :height 500)) (chosen nil)
        (d (lut:choose-color w (lambda (color) (setf chosen color)) :initial '(1 2 3 255))))
   (setf (lut:value (first (lut:children d))) 42)
   (lut:emit (first (lut:children d)) :change 42)
   (lut::activate (car (last (lut:children d))))
   (assert (equal '(42 2 3 255) chosen)))
 (let* ((w (lut:make-widget 'lut:window)) (chosen nil)
        (d (lut:choose-font w (lambda (path size) (setf chosen (list path size)))
                           :initial (asdf:system-relative-pathname "lut" "assets/NotoSans-Regular.ttf"))))
   (lut::activate (car (last (lut:children d))))
   (assert (probe-file (first chosen))) (assert (= 18 (second chosen))))
 (let* ((w (lut:make-widget 'lut:window)) (chosen nil)
        (d (lut:choose-file w (lambda (path) (setf chosen path)) :directory (asdf:system-source-directory "lut"))))
   (setf (lut:text (first (lut:children d))) (namestring (asdf:system-relative-pathname "lut" "lut.asd")))
   (lut::activate (car (last (lut:children d))))
   (assert (probe-file chosen)))
 (format t "Expanded widget behavior checks passed.~%") t)
