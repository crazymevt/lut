(in-package #:lut-tests)
(defclass unit-wrapped-text (lut:wrapped-text-view) ())
(defclass unit-wrapped-document (lut:wrapped-document-view) ())
(defmethod lut:text-width ((view unit-wrapped-text) string) (declare (ignore view)) (length string))
(defmethod lut:text-width ((view unit-wrapped-document) string) (declare (ignore view)) (length string))
(defun wrapped-text-tests ()
 (let ((view (lut:make-widget 'unit-wrapped-text :text "abcdefghij" :width 4 :height 4
              :style '(:padding 0 :font-size 1 :line-height 2))))
   (assert (= 6 (nth-value 1 (lut:measure view :vertical 4))))
   (loop for p from 0 to 10 do
     (multiple-value-bind (x y) (lut:text-position-rectangle view p)
       (assert (= p (lut:text-point-position view x (+ y 0.5))))))
   (setf (lut:cursor view) 2 (lut::anchor view) 2)
   (assert (= 6 (lut:move-text-cursor view :down)))
   (assert (= 10 (lut:move-text-cursor view :down)))
   (assert (= 6 (lut:move-text-cursor view :up :extend t)))
   (assert (string= "ghij" (lut:selected-text view)))
   (lut:replace-selection view "XY")
   (assert (string= "abcdefXY" (lut:text view)))
   (lut:undo view) (assert (string= "abcdefghij" (lut:text view)))
   (lut:redo view) (assert (string= "abcdefXY" (lut:text view)))
   (setf (lut:cursor view) 5 (lut::anchor view) 5)
   (assert (= 4 (lut:move-text-cursor view :line-start)))
   (setf (lut:cursor view) 1 (lut::anchor view) 1)
   (assert (= 4 (lut:move-text-cursor view :line-end)))
   (assert (zerop (nth-value 1 (lut:text-position-rectangle view 4))))
   (assert (= 4 (lut:move-text-cursor view :line-end)))
   (assert (= 0 (lut:move-text-cursor view :line-start)))
   (setf (lut:max-height view) 4)
   (setf (lut:text view) "abcdefghijklmnop")
   (assert (= 4 (nth-value 1 (lut:measure view :vertical 4))))
   (lut:layout view 10 20 4 4)
   (setf (lut:cursor view) 16)
   (lut:reveal-text-cursor view)
   (assert (= 4 (lut:vertical-offset view)))
   (assert (zerop (lut:text-offset view)))
   (lut:layout view 10 20 16 4)
   (assert (zerop (lut:vertical-offset view)))
   (setf (lut:max-height view) nil)
   (assert (= 2 (nth-value 1 (lut:measure view :vertical 16))))
   (setf (lut:text view) (format nil "ab~%~%c~%"))
   (assert (= 8 (lut::text-content-height view)))
   (loop for p from 0 to (lut:text-length view) do
     (multiple-value-bind (x y) (lut:text-position-rectangle view p)
       (assert (= p (lut:text-point-position view x (+ y 0.5))))))
   (lut:dispose view) (assert (null (slot-value view 'lut::geometry-cache))))
 (let* ((text (format nil "Heading~%~a~%Body" (code-char #xfffc)))
        (view (lut:make-widget 'unit-wrapped-document :text text :width 20 :height 100
                :paragraph-spacing 3 :style '(:padding 0 :font-size 1 :line-height 2))))
   (lut:set-text-presentation view :runs '((:start 0 :end 7 :style (:font-size 5)))
     :images '((:position 8 :source "assets/fonts/NotoSans-Regular.ttf" :width 8 :height 12)))
   (assert (= 5 (nth-value 3 (lut:text-position-rectangle view 0))))
   (assert (= 8 (nth-value 1 (lut:text-position-rectangle view 8))))
   (assert (= 12 (nth-value 3 (lut:text-position-rectangle view 8))))
   (assert (= (nth-value 1 (lut:text-position-rectangle view 10)) 23))
   (assert (eq :image (lut:document-hit-test view 6 10)))
   (setf (lut:cursor view) 10 (lut::anchor view) 10)
   (assert (< (lut:move-text-cursor view :up) 10))
   (let ((before (lut:text view)))
     (lut:select-all view) (lut:replace-selection view "x")
     (assert (string= before (lut:text view))))
   (setf (lut:paragraph-spacing view) 6)
   (assert (= 11 (nth-value 1 (lut:text-position-rectangle view 8))))
   (lut:dispose view))
 (let* ((buffer (lut:make-text-buffer :text "abcdef"))
        (a (lut:make-widget 'unit-wrapped-text :view-buffer buffer :width 3 :height 2
             :style '(:padding 0 :font-size 1 :line-height 2)))
        (b (lut:make-widget 'unit-wrapped-text :view-buffer buffer :width 6 :height 2
             :style '(:padding 0 :font-size 1 :line-height 2))))
   (assert (= 4 (lut::text-content-height a)))
   (assert (= 2 (lut::text-content-height b)))
   (lut:select-all a) (lut:replace-selection a "123456789")
   (assert (= 6 (lut::text-content-height a)))
   (assert (= 4 (lut::text-content-height b)))
   (let ((rows (lut::wrapped-rows a)))
     (assert (eq rows (lut::wrapped-rows a)))
     (lut:invalidate-text-geometry a)
     (assert (not (eq rows (lut::wrapped-rows a)))))
   (lut:dispose a) (lut:dispose b) (lut:dispose buffer))
 (let* ((root (lut:make-widget 'lut:window :width 20 :height 20))
        (view (lut:add-child root (lut:make-widget 'unit-wrapped-text
          :text (make-string 100 :initial-element #\a) :width 4 :height 4
          :style '(:padding 0 :font-size 1 :line-height 2)))))
   (lut:dispatch root (lut:make-event :kind :down :x 1 :y 1))
   (lut:dispatch root (lut:make-event :kind :move :x 1 :y 18))
   (lut:advance-text-selection root 0.1)
   (assert (> (lut:vertical-offset view) 0))
   (assert (zerop (lut:text-offset view)))
   (lut:dispatch root (lut:make-event :kind :up :x 1 :y 18))
   (assert (plusp (length (lut:selected-text view))))
   (lut:dispose root))
 (format t "Wrapped editing, geometry round trips, visual navigation, resize, bounded measurement, variable block metrics and disposal passed.~%"))
