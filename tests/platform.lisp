(in-package #:lut-tests)
(defun platform-tests ()
 (menu-heading-hover-tests) (submenu-hover-grace-tests) (menu-heading-layout-tests) (submenu-hover-tests) (ui-scaling-tests) (submenu-tests) (dropdown-edge-tests) (command-menu-tests) (menu-separator-tests) (path-request-tests) (path-request-validation-tests)
 (let ((root (lut:make-widget 'lut:window)))
   (dolist (capability '(:shaping :bidi :ime-composition :accessibility))
     (assert (eq :unsupported (getf (lut:platform-capability root capability) :status))))
   (assert (null (lut:platform-capability root :unknown))) (lut:dispose root))
 (format t "Logical UI scaling/input, drawn command menus, file/folder/save request lifetime and explicit capability gaps passed.~%"))
(defun ui-scaling-tests ()
 (dolist (scale '(1 5/4 2))
   (let* ((root (lut:make-widget 'lut:window :ui-scale scale :width 400 :height 200))
          (button (lut:add-child root (lut:make-widget 'lut:button :x 20 :y 30 :width 100 :height 30)))
          (entry (lut:add-child root (lut:make-widget 'lut:entry :x 10 :y 100 :text "abc"))) (activated 0))
     (assert (equal '(20 30) (multiple-value-list (lut:device-to-ui root (* scale 20) (* scale 30)))))
     (assert (equal (list (* scale 20) (* scale 30)) (multiple-value-list (lut:ui-to-device root 20 30))))
     (lut:on button :activate (lambda (b p) (declare (ignore b p)) (incf activated)))
     (dolist (kind '(:down :up))
       (let ((event (lut:make-event :kind kind :x (* scale 30) :y (* scale 40))))
         (lut:dispatch-device-event root event) (assert (= (* scale 30) (lut:event-x event)))))
     (assert (= 1 activated))
     (assert (= (getf lut:*light-theme* :font-size) (lut:style-value entry :font-size)))
     (lut:text-position-rectangle entry 2) (assert (slot-value entry 'lut::geometry-cache))
     (setf (lut:ui-scale root) 3/2) (assert (null (slot-value entry 'lut::geometry-cache)))
     (assert (handler-case (progn (setf (lut:ui-scale root) 0) nil) (error () t)))
     (assert (= 3/2 (lut:ui-scale root)))
     (lut:dispose root))))
(defun command-menu-tests ()
 (let* ((root (lut:make-widget 'lut:window :width 400 :height 200)) (calls 0)
        (command (lut:make-command :test "Original" (lambda (c context) (declare (ignore c)) (assert (eq root context)) (incf calls)) :shortcut :control-j))
        (menu (lut:install-command-menu root (list (list :label "File" :commands (list command :separator command nil))) :native nil)))
   (assert (eq :drawn (lut:command-menu-backend menu)))
   (assert (eq root (lut:parent (lut:command-menu-bar menu))))
   (lut:dispatch root (lut:make-event :kind :key :key :control-j)) (assert (= 1 calls))
   (setf (lut:command-label command) "Renamed" (lut:enabled-p command) nil)
   (let ((group (first (lut:children (lut:command-menu-bar menu)))))
     (lut:emit group :activate nil)
     (let* ((popup (lut::input-root root)) (item (first (lut:children popup))))
       (assert (= 4 (length (lut:children popup))))
       (assert (typep (second (lut:children popup)) 'lut:menu-separator))
       (assert (typep (fourth (lut:children popup)) 'lut:menu-separator))
       (assert (string= "Renamed" (lut:text item))) (assert (not (lut:enabled-p item)))
       (lut:emit item :activate nil) (assert (= 1 calls))))
   (setf (lut:enabled-p command) t (lut:command-shortcut command) :control-k)
   (lut:refresh-command-menu menu)
   (lut:dispatch root (lut:make-event :kind :key :key :control-j)) (assert (= 1 calls))
   (lut:dispatch root (lut:make-event :kind :key :key :control-k)) (assert (= 2 calls))
   (assert (handler-case (progn (lut:install-command-menu root (list (list :label "Other" :commands (list command)))) nil) (error () t)))
   (lut:dispose root) (assert (lut:disposed-p menu)) (assert (not (lut:disposed-p command)))
   (assert (null (lut::menu-bindings menu))) (lut:dispose command)))
(defun menu-separator-tests ()
 (let* ((root (lut:make-widget 'lut:window :width 400 :height 400))
        (target (lut:add-child root (lut:make-widget 'lut:button :width 100 :height 30)))
        (calls 0) (popup nil))
   (lut:on target :context (lambda (w event)
     (setf popup (lut:open-context-menu root w event
       (list (list "First" (lambda () (incf calls)) t) :separator
             (list "Disabled" (lambda () (incf calls 100)) nil) nil
             (list "Last" (lambda () (incf calls)) t))))))
   (lut:dispatch root (lut:make-event :kind :context :x 10 :y 10))
   (assert popup) (assert (= 5 (length (lut:children popup))))
   (let ((separator (second (lut:children popup))))
     (assert (typep separator 'lut:menu-separator)) (assert (not (lut::focusable-p separator)))
     (selection-pointer root :down (+ (lut:x separator) 10) (+ (lut:y separator) 4))
     (selection-pointer root :up (+ (lut:x separator) 10) (+ (lut:y separator) 4))
     (assert (zerop calls)) (assert (eq popup (lut::input-root root))))
   (let ((last (fifth (lut:children popup))))
     (selection-pointer root :down (+ (lut:x last) 10) (+ (lut:y last) 4))
     (selection-pointer root :up (+ (lut:x last) 10) (+ (lut:y last) 4)))
   (assert (= 1 calls)) (assert (eq root (lut::input-root root)))
   (lut:dispose popup) (lut:dispose root)))
(defun path-request-tests ()
 (let ((directory (truename "./")))
   (dolist (kind '(:file :folder :save))
     (let* ((root (lut:make-widget 'lut:window :width 600 :height 500)) (result :unset) (callbacks 0)
            (filename (case kind (:file "src/core.lisp") (:save "lut-no-file-is-written.txt") (otherwise "")))
            (request (lut:request-path root (lambda (path) (setf result path) (incf callbacks))
                       :kind kind :directory directory :filename filename :native nil))
            (dialog (lut:path-request-dialog request))
            (choose (find-if (lambda (child) (and (typep child 'lut:button) (string= "Choose" (lut:text child)))) (lut:children dialog))))
       (assert (eq :pending (lut:path-request-state request)))
       (lut:emit choose :activate nil)
       (assert (eq :accepted (lut:path-request-state request))) (assert (pathnamep result))
       (assert (= 1 callbacks)) (assert (null (lut:path-request-dialog request)))
       (when (eq kind :file) (assert (equal (truename "src/core.lisp") result)))
       (when (eq kind :folder) (assert (uiop:directory-pathname-p result)))
       (when (eq kind :save) (assert (not (probe-file result))))
       (lut:cancel-path-request request) (assert (= 1 callbacks))
       (lut:dispose request) (lut:dispose root)))
   (let* ((root (lut:make-widget 'lut:window)) (calls 0)
          (request (lut:request-path root (lambda (path) (assert (null path)) (incf calls)) :directory directory :native nil)))
     (lut:dispatch root (lut:make-event :kind :key :key :escape))
     (assert (eq :cancelled (lut:path-request-state request))) (assert (= 1 calls))
     (lut:cancel-path-request request) (assert (= 1 calls))
     (lut:dispose request)
     (let ((pending (lut:request-path root (lambda (path) (declare (ignore path)) (error "Owner disposal must be silent")) :directory directory :native nil)))
       (lut:dispose root) (assert (lut:disposed-p pending))))))
(defun path-request-validation-tests ()
 (let ((directory (truename "./"))
       (missing (format nil "lut-missing-~a/" (symbol-name (gensym "PATH-")))))
   (assert (not (uiop:directory-exists-p missing)))
   (dolist (kind '(:file :folder :save))
     (let* ((root (lut:make-widget 'lut:window :width 600 :height 500)) (calls 0) (result :unset)
            (request (lut:request-path root (lambda (path) (incf calls) (setf result path))
                       :directory directory :kind kind :native nil))
            (dialog (lut:path-request-dialog request))
            (path (find-if (lambda (child) (typep child 'lut:entry)) (lut:children dialog)))
            (status (lut:find-widget dialog :path-validation-status))
            (choose (find-if (lambda (child) (and (typep child 'lut:button) (string= "Choose" (lut:text child)))) (lut:children dialog)))
            (invalid (case kind (:file (list (concatenate 'string missing "missing.txt"))) (:folder (list missing))
                       (:save (list "./" (concatenate 'string missing "missing.txt")))))
            (valid (case kind (:file "src/core.lisp") (:folder "./")
                     (:save (format nil "lut-no-write-~a.txt" (symbol-name (gensym "PATH-")))))))
       (dolist (input invalid)
         (setf (lut:text path) input)
         ;; An ordinary activation must return normally, retaining the request
         ;; and displaying actionable feedback instead of entering a debugger.
         (lut:emit choose :activate nil)
         (assert (eq :pending (lut:path-request-state request)))
         (assert (eq dialog (lut:path-request-dialog request)))
         (assert (eq root (lut:parent dialog))) (assert (not (lut:disposed-p dialog)))
         (assert (plusp (length (lut:text status))))
         (assert (eq path (lut:focused-widget root)))
         (assert (zerop calls)) (assert (eq :unset result)))
       ;; Correct the input through the focused field's normal input dispatch.
       (lut:select-all path)
       (lut:dispatch root (lut:make-event :kind :text :text valid))
       (lut:emit choose :activate nil)
       (assert (eq :accepted (lut:path-request-state request)))
       (assert (= 1 calls)) (assert (pathnamep result))
       (assert (equal result (lut:path-request-result request)))
       (assert (null (lut:path-request-dialog request))) (assert (lut:disposed-p dialog))
       (assert (lut:disposed-p status))
       (when (eq kind :save) (assert (not (probe-file result))))
       (lut:dispose request) (lut:dispose root)))
   ;; Application errors must not be swallowed as if the chosen path were bad.
   (let* ((root (lut:make-widget 'lut:window))
          (request (lut:request-path root (lambda (path) (declare (ignore path)) (error "Application callback failure"))
                     :directory directory :filename "src/core.lisp" :native nil))
          (dialog (lut:path-request-dialog request))
          (choose (find-if (lambda (child) (and (typep child 'lut:button) (string= "Choose" (lut:text child)))) (lut:children dialog))))
     (assert (handler-case (progn (lut:emit choose :activate nil) nil)
               (error (condition) (assert (search "Application callback failure" (princ-to-string condition))) t)))
     (assert (eq :accepted (lut:path-request-state request)))
     (assert (pathnamep (lut:path-request-result request)))
     (assert (null (lut:path-request-dialog request)))
     (lut:dispose request) (lut:dispose root))))

(defun submenu-tests ()
 (let* ((root (lut:make-widget 'lut:window :width 400 :height 300)) (calls 0)
        (child (lut:make-command :child "Recent path" (lambda (c context) (declare (ignore c context)) (incf calls))))
        (entries (list child))
        (parent (lut:make-command :recent "Recent" (lambda (c context) (declare (ignore c context)))
                  :submenu (lambda (c context) (declare (ignore c context)) entries)))
        (menu (lut:install-command-menu root (list (list :label "File" :commands (list parent))) :native nil)))
   (unwind-protect
     (progn
       (lut:emit (first (lut:children (lut:command-menu-bar menu))) :activate nil)
       (lut:emit (first (lut:children (lut::input-root root))) :activate nil)
       (assert (string= "Recent path" (lut:text (first (lut:children (lut::input-root root))))))
       (lut:emit (first (lut:children (lut::input-root root))) :activate nil)
       (assert (= 1 calls))
       (setf entries (list :separator child) (lut:command-label child) "Updated")
       (let ((records (getf (first (getf (first (lut::menu-command-snapshot menu)) :commands)) :commands)))
         (assert (eq :separator (first records)))
         (assert (string= "Updated" (getf (second records) :label)))))
     (lut:dispose root) (lut:dispose parent) (lut:dispose child))))
(defun dropdown-edge-tests ()
 (let* ((root (lut:make-widget 'lut:window :width 400 :height 200))
        (dropdown (lut:add-child root (lut:make-widget 'lut:dropdown :x 300 :y 174 :width 140 :height 26
                                      :items '("Text" "Lisp" "Markdown") :value 1))))
   (unwind-protect
     (progn
       (lut:handle-event dropdown (lut:make-event :kind :key :key :space))
       (let ((popup (lut::input-root root)))
         (assert (<= 0 (lut:x popup))) (assert (<= (+ (lut:x popup) (lut:width popup)) (lut:width root)))
         (assert (<= 0 (lut:y popup))) (assert (<= (+ (lut:y popup) (lut:height popup)) (lut:y dropdown)))
         (assert (= 1 (lut:value (first (lut:children popup))))))
       (lut:dispatch root (lut:make-event :kind :key :key :escape))
       (assert (not (lut:expanded-p dropdown))))
     (lut:dispose root))))


(defun menu-heading-layout-tests ()
 (let* ((root (lut:make-widget 'lut:window :width 800 :height 500))
        (command (lut:make-command :noop "Noop" (lambda (c context) (declare (ignore c context)))))
        (menu (lut:install-command-menu root
                (list (list :label "File" :commands (list command))
                      (list :label "Longer menu" :commands (list command))) :native nil))
        (bar (lut:command-menu-bar menu)))
   (unwind-protect
       (let ((widths nil))
         (dolist (available '(400 800))
           (lut:layout bar 0 0 available 32)
           (let ((actual (mapcar #'lut:width (lut:children bar))))
             (if widths (assert (equal widths actual)) (setf widths actual)))
           (dolist (heading (lut:children bar))
             (assert (= (+ 24 (lut:text-width heading (lut:text heading))) (lut:width heading)))
             (assert (zerop (lut:style-value heading :button-depth)))
             (assert (zerop (lut:style-value heading :border-width)))))
         (assert (< (first widths) (second widths))))
     (lut:dispose root) (lut:dispose command))))

(defun submenu-hover-tests ()
 (let* ((root (lut:make-widget 'lut:window :width 800 :height 500))
        (target (lut:add-child root (lut:make-widget 'lut:button)))
        (calls 0) (opens 0) (clock 0)
        (menu (lut:open-context-menu root target (lut:make-event :kind :context :x 20 :y 60)
                (list (list "First" (lambda () (incf calls)) t
                            (lambda () (incf opens) (list (list "First child" (lambda () (incf calls)) t))))
                      (list "Second" (lambda () (incf calls)) t
                            (lambda () (incf opens) (list (list "Second child" (lambda () (incf calls)) t))))
                      (list "Disabled" (lambda () (incf calls)) nil
                            (lambda () (incf opens) nil))
                      (list "Leaf" (lambda () (incf calls)) t)))))
   (unwind-protect
       (flet ((hover (item)
                (incf clock 1)
                (dolist (time (list clock (+ clock 0.21)))
                  (lut:dispatch root (lut:make-event :kind :move :timestamp time
                                       :x (+ (lut:x item) 10) :y (+ (lut:y item) 10))))))
         ;; At the right edge the submenu opens to the left, beside its parent.
         (lut:layout menu 580 60 (lut:width menu) (lut:height menu))
         (hover (third (lut:children menu))) (assert (zerop opens))
         (hover (first (lut:children menu)))
         (let ((child (lut::input-root root)))
           (assert (not (eq menu child)))
           (assert (<= (+ (lut:x child) (lut:width child)) (lut:x menu)))
           (assert (string= "First child" (lut:text (first (lut:children child)))))
           (hover (first (lut:children menu))) (assert (eq child (lut::input-root root))))
         (assert (= opens 1)) (assert (zerop calls))
         (hover (second (lut:children menu)))
         (assert (= opens 2))
         (assert (string= "Second child" (lut:text (first (lut:children (lut::input-root root))))))
         (hover (fourth (lut:children menu)))
         (assert (eq menu (lut::input-root root))) (assert (zerop calls))
         (hover (first (lut:children menu)))
         (let* ((child (lut::input-root root)) (item (first (lut:children child))))
           (hover item) (assert (zerop calls))
           (lut:emit item :activate nil)
           (assert (= calls 1)) (assert (eq root (lut::input-root root)))))
     (lut:dispose root))))


(defun submenu-hover-grace-tests ()
 (let* ((root (lut:make-widget 'lut:window :width 1000 :height 600))
        (target (lut:add-child root (lut:make-widget 'lut:button)))
        (opens 0) (calls 0)
        (menu (lut:open-context-menu root target (lut:make-event :kind :context :x 10 :y 50)
                (list (list "Owner" nil t
                         (lambda () (incf opens)
                           (list (list "Nested owner" nil t
                                   (lambda () (list (list "Deep child" (lambda () (incf calls)) t)))))))
                      (list "Sibling" nil t (lambda () (list (list "Other child" nil t))))
                      (list "Leaf" (lambda () (incf calls)) t)))))
   (unwind-protect
       (flet ((hover (item time)
                (lut:dispatch root (lut:make-event :kind :move :timestamp time
                                     :x (+ (lut:x item) 10) :y (+ (lut:y item) 10)))))
         (hover (first (lut:children menu)) 0)
         (let* ((child (lut::input-root root)) (nested (first (lut:children child))))
           ;; Crossing sibling/leaf rows must preserve the current child briefly.
           (hover (third (lut:children menu)) 0.01)
           (hover (third (lut:children menu)) 0.15)
           (assert (eq child (lut::input-root root)))
           (hover nested 0.16)
           (let ((deep (lut::input-root root)))
             (assert (not (eq child deep)))
             ;; Returning to the first owner keeps the second-level instance.
             (hover (first (lut:children menu)) 0.17)
             (assert (eq child (lut::input-root root))) (assert (= opens 1)))
           ;; Entering the child cancelled the earlier pending close.
           (hover (third (lut:children menu)) 1.0)
           (assert (eq child (lut::input-root root)))
           (hover (third (lut:children menu)) 1.21)
           (assert (eq menu (lut::input-root root)))
           (hover (first (lut:children menu)) 2.0)
           (let ((current (lut::input-root root)))
             (hover (second (lut:children menu)) 2.01)
             (assert (eq current (lut::input-root root)))
             (hover (second (lut:children menu)) 2.22)
             (assert (not (eq current (lut::input-root root)))))
           (assert (zerop calls))))
     (lut:dispose root))))

(defun menu-heading-hover-tests ()
 (let* ((root (lut:make-widget 'lut:window :width 800 :height 500))
        (calls 0)
        (command (lut:make-command :noop "Noop" (lambda (c context) (declare (ignore c context)) (incf calls))))
        (menu (lut:install-command-menu root (list (list :label "File" :commands (list command))
                                                  (list :label "Edit" :commands (list command))) :native nil))
        (bar (lut:command-menu-bar menu)) (file (first (lut:children bar))) (edit (second (lut:children bar))))
   (unwind-protect
       (flet ((hover (heading)
                (lut:dispatch root (lut:make-event :kind :move :x (+ (lut:x heading) 10) :y (+ (lut:y heading) 10)))))
         (lut:layout bar 0 0 800 32)
         (hover edit) (assert (eq root (lut::input-root root)))
         (lut:emit file :activate nil)
         (let ((popup (lut::input-root root)))
           (hover edit)
           (assert (not (eq popup (lut::input-root root))))
           (assert (eq edit (lut::popup-owner (lut::input-root root)))))
         (let ((popup (lut::input-root root)))
           (hover edit) (assert (eq popup (lut::input-root root))))
         (hover file)
         (assert (eq file (lut::popup-owner (lut::input-root root))))
         (assert (zerop calls))
         (lut:emit (first (lut:children (lut::input-root root))) :activate nil)
         (assert (= 1 calls)) (assert (eq root (lut::input-root root))))
     (lut:dispose root) (lut:dispose command))))
