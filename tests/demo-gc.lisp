(defpackage #:lui-demo-gc-tests (:use #:cl) (:export #:run-tests))
(in-package #:lui-demo-gc-tests)
(defun fixture ()
 (loop for name in (lui-gtk-demo:demo-names) append
  (let* ((root (lui-gtk-demo:demo name)) (nodes nil))
   (lui:walk-widgets root (lambda (w) (push (trivial-garbage:make-weak-pointer w) nodes)))
   (lui:dispose root)
   (assert (null (lui-gtk-demo::model root)))
   (assert (null (lui-gtk-demo::resources root)))
   nodes)))
(defun run-tests ()
 (let ((weak (bt:join-thread (bt:make-thread #'fixture :name "GTK demo disposal fixture"))))
  (trivial-garbage:gc :full t)
  (assert (notany #'trivial-garbage:weak-pointer-value weak))
  (format t "GTK demo GC: ~d disposed widget instances across all 108 demos collected.~%" (length weak))) t)
