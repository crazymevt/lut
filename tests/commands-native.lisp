(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/raylib" :silent t)
(let* ((root (lut:make-widget 'lut:window :text "Command owner" :width 320 :height 180))
       (dialog (lut:make-widget 'lut:dialog :text "Worker command" :width 300 :height 160))
       (button (lut:add-child dialog (lut:make-widget 'lut:button)))
       (model (list :count 0 :allowed nil)) (binding nil) (remote nil) (frames 0) (phase :open)
       (command (lut:make-command :perform "Perform (F6)"
                  (lambda (command context)
                    (declare (ignore command))
                    (assert (eq context model))
                    (incf (getf context :count)) (lut:dismiss-dialog dialog))
                  :enabled-when (lambda (command context) (declare (ignore command)) (getf context :allowed))
                  :shortcut :f6))
       (deadline (+ (get-internal-real-time) (* 15 internal-time-units-per-second))))
 (lut:on root :tick (lambda (w dt)
   (declare (ignore w dt))
   (when (> (get-internal-real-time) deadline) (error "Native command timeout in ~a" phase))
   (when (and remote (lut::remote-window-error remote)) (error (lut::remote-window-error remote)))
   (case phase
     (:open
       (lut:show-dialog root dialog)
       (let ((host (lut::root-of dialog)))
         (setf remote (find host lut::*remote-windows* :key #'lut::remote-window-root)
               binding (lut:bind-command host command :widget button :context model)))
       (assert remote) (assert (not (lut:enabled-p button)))
       (setf phase :disabled))
     (:disabled
       (when (>= (lut::remote-window-frames remote) 2)
         (lut:on-window remote (lut::forward-native-event (lut:make-event :kind :key :key :f6)))
         (setf frames (lut::remote-window-frames remote) phase :enable)))
     (:enable
       (when (>= (lut::remote-window-frames remote) (+ frames 2))
         (assert (zerop (getf model :count)))
         (setf (getf model :allowed) t)
         (lut:refresh-commands (lut::remote-window-root remote))
         (assert (lut:enabled-p button))
         (assert (string= "Perform (F6)" (lut:text button)))
         (lut:on-window remote (lut::forward-native-event (lut:make-event :kind :key :key :f6)))
         (setf phase :closing)))
     (:closing
       (when (null (lut::remote-window-root remote))
         (assert (= 1 (getf model :count))) (setf phase :done) (lut:stop))))))
 (unwind-protect
   (progn
     (lut:run root :frames 1500)
     (assert (eq phase :done))
     (assert (lut:disposed-p dialog))
     (assert (not (lut:command-binding-active-p binding)))
     (assert (null (slot-value binding 'lut::context)))
     (assert (null (slot-value binding 'lut::window)))
     (assert (null lut::*remote-windows*)))
   (lut:dispose root) (lut:dispose command)))
(format t "Native worker command availability, shortcut forwarding, original context and teardown passed.~%")
