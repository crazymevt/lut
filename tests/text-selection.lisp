(in-package #:lut-tests)
(defclass proportional-selection-view (lut:text-view) ())
(defmethod lut::text-character-advance ((view proportional-selection-view) character)
 (case character (#\W 20) (#\i 5) (t 10)))
(defclass drag-selection-view (lut:text-view) ())
(defmethod lut:drag-data ((view drag-selection-view) event)
 (declare (ignore view event)) (values :test-payload t))
(defun selection-fixture (&optional (text (format nil "alpha beta~%second line~%third")))
 (let* ((root (lut:make-widget 'lut:window :width 600 :height 400))
        (view (lut:add-child root (lut:make-widget 'lut:text-view :text text :x 10 :y 10 :width 120 :height 60
                                                    :style '(:padding 0 :font-size 10 :line-height 20)))))
   (lut:focus root view) (values root view)))
(defun selection-pointer (root kind x y &key timestamp click-count shift)
 (lut:dispatch root (lut:make-event :kind kind :x x :y y :timestamp timestamp :click-count click-count :shift-p shift)))
(defun pointer-click-count-tests ()
 (let ((state nil))
   (flet ((click (time x y target &optional explicit (cycle 2))
            (multiple-value-bind (count next)
                (lut:pointer-click-count (lut:make-event :kind :down :timestamp time :x x :y y :click-count explicit)
                                         state :target target :cycle cycle)
              (setf state next) count)))
     (assert (= 1 (click 1.0 0 0 :a)))
     (assert (= 2 (click 1.2 3 4 :a)))
     (assert (= 1 (click 1.3 3 4 :a)))
     (assert (= 1 (click 2.0 3 4 :a)))
     (assert (= 1 (click 2.1 3 4 :b)))
     (assert (= 1 (click 2.2 9 4 :b)))
     (assert (= 1 (click 2.0 9 4 :b)))
     (assert (= 2 (click 2.1 9 4 :b 2)))
     (setf state nil)
     (assert (= 1 (click 3.0 0 0 :a nil 3)))
     (assert (= 2 (click 3.1 0 0 :a nil 3)))
     (assert (= 3 (click 3.2 0 0 :a nil 3)))
     (assert (= 1 (click 3.3 0 0 :a nil 3)))
     (assert (= 1 (click nil 0 0 :a)))
     (assert (null state)))))
(defun text-selection-tests ()
 (pointer-click-count-tests)
 (multiple-value-bind (root view) (selection-fixture "alpha beta")
   (unwind-protect
     (progn
       (selection-pointer root :down 12 15 :timestamp 10.0)
       (selection-pointer root :move 42 15 :timestamp 10.1)
       (selection-pointer root :up 42 15 :timestamp 10.2)
       (assert (plusp (length (lut:selected-text view)))))
     (lut:dispose root)))
 (single-line-centering-tests)
 (let ((buffer (lut:make-text-buffer :text "αβ_2  !!x")))
   (assert (equal '(0 4) (multiple-value-list (lut:text-word-range buffer 2))))
   (assert (equal '(4 6) (multiple-value-list (lut:text-word-range buffer 4))))
   (assert (equal '(6 8) (multiple-value-list (lut:text-word-range buffer 6))))
   (assert (equal '(8 9) (multiple-value-list (lut:text-word-range buffer 9))))
   (assert (handler-case (progn (lut:text-word-range buffer 10) nil) (error () t)))
   (lut:dispose buffer))
 (multiple-value-bind (root view) (selection-fixture "αβ_2  !!x")
   (let ((changes 0))
     (lut:on view :change (lambda (w p) (declare (ignore w p)) (incf changes)))
     (assert (= 6 (lut:move-text-cursor view :word-right)))
     (assert (= 8 (lut:move-text-cursor view :word-right :extend t)))
     (assert (equal '(6 8) (multiple-value-list (lut:selection view))))
     (assert (= 6 (lut:move-text-cursor view :word-left))) ; collapse selection
     (assert (= 0 (lut:move-text-cursor view :word-left)))
     (lut:dispatch root (lut:make-event :kind :key :key :right :alt-p t :shift-p t))
     (assert (equal '(0 6) (multiple-value-list (lut:selection view))))
     (lut:dispatch root (lut:make-event :kind :key :key :end :control-p t))
     (assert (= 9 (lut:cursor view)))
     (lut:dispatch root (lut:make-event :kind :key :key :left :super-p t :shift-p t))
     (assert (equal '(0 9) (multiple-value-list (lut:selection view))))
     (setf (lut:read-only-p view) t)
     (lut:select-word view 1) (assert (string= "αβ_2" (lut:selected-text view)))
     (assert (not (lut:can-undo-p view))) (assert (zerop changes))) (lut:dispose root))
 (multiple-value-bind (root view) (selection-fixture (format nil "ab~%cd~%"))
   (lut:select-line view 1) (assert (equal '(0 3) (multiple-value-list (lut:selection view))))
   (lut:select-line view 5) (assert (equal '(3 6) (multiple-value-list (lut:selection view))))
   (lut:select-line view 6) (assert (equal '(6 6) (multiple-value-list (lut:selection view))))
   (lut:move-text-cursor view :document-start)
   (lut:dispatch root (lut:make-event :kind :key :key :end :shift-p t))
   (assert (string= "ab" (lut:selected-text view))) (lut:dispose root))
 ;; Vertical navigation uses pixels and retains the goal across short lines.
 (let* ((view (lut:make-widget 'proportional-selection-view :text (format nil "WW~%i~%WW")
                               :width 100 :height 20 :style '(:padding 0 :line-height 20))))
   (setf (lut:cursor view) 2 (slot-value view 'lut::anchor) 2)
   (assert (= 4 (lut:move-text-cursor view :down :extend t)))
   (assert (= 7 (lut:move-text-cursor view :down :extend t)))
   (assert (= 40 (lut:vertical-offset view)))
   (assert (equal '(2 7) (multiple-value-list (lut:selection view))))
   (lut:move-text-cursor view :up) (assert (= 4 (lut:cursor view)))
   (lut:move-text-cursor view :up) (assert (= 2 (lut:cursor view)))
   (setf (lut:cursor view) 0)
   (assert (= 3 (lut:move-text-cursor view :down))) ; manual cursor resets goal
   (lut:dispose view))
 ;; Repeated clicks infer word/line selection only with explicit timestamps;
 ;; synthetic legacy events remain single clicks. Fourth click starts anew.
 (multiple-value-bind (root view) (selection-fixture)
   (loop for time in '(1 1.2 1.4 1.6) for expected in '((1 1) (0 5) (0 11) (1 1)) do
     (selection-pointer root :down 16 15 :timestamp time)
     (selection-pointer root :up 16 15 :timestamp time)
     (assert (equal expected (multiple-value-list (lut:selection view)))))
   (selection-pointer root :down 16 15 :timestamp 3)
   (assert (equal '(1 1) (multiple-value-list (lut:selection view))))
   (selection-pointer root :up 16 15)
   (selection-pointer root :down 16 15 :click-count 2)
   (selection-pointer root :move 58 15)
   (assert (string= "alpha beta" (lut:selected-text view)))
   (selection-pointer root :up 58 15)
   (selection-pointer root :down 22 35 :click-count 3)
   (selection-pointer root :move 16 15)
   (assert (equal '(0 23) (multiple-value-list (lut:selection view))))
   (assert (= 0 (lut:cursor view))) ; backwards unit selection preserves direction
   (selection-pointer root :up 16 15)
   (selection-pointer root :down 28 15 :shift t)
   (assert (= 23 (slot-value view 'lut::anchor)))
   (selection-pointer root :up 28 15)
   (assert (null (slot-value root 'lut::text-selection-state))) (lut:dispose root))
 ;; Word selection targets the glyph under the pointer rather than the
 ;; nearest insertion point, especially in the final half of a word character.
 (multiple-value-bind (root view) (selection-fixture "ab! ")
   (selection-pointer root :down 20 15 :click-count 2)
   (assert (string= "ab" (lut:selected-text view)))
   (selection-pointer root :move 26 15)
   (assert (string= "ab!" (lut:selected-text view)))
   (selection-pointer root :up 26 15) (lut:dispose root))
 ;; Revealing a word/line can scroll the viewport on DOWN. A stationary
 ;; MOVE/UP (and idle autoscroll frame) must preserve that exact unit selection.
 (dolist (line-p '(nil t))
   (multiple-value-bind (root view)
       (selection-fixture (if line-p (format nil "first~%second") (make-string 50 :initial-element #\a)))
     (setf (lut:width view) 60 (lut:height view) 20)
     (selection-pointer root :down 16 15 :click-count (if line-p 3 2))
     (let ((expected (multiple-value-list (lut:selection view))))
       (assert (if line-p (plusp (lut:vertical-offset view)) (plusp (lut:text-offset view))))
       (selection-pointer root :move 16 15)
       (assert (not (lut:advance-text-selection root 0.1)))
       (selection-pointer root :up 16 15)
       (assert (equal expected (multiple-value-list (lut:selection view)))))
     (lut:dispose root)))
 ;; Click distance is radial, and text-selection cancellation never steals
 ;; an active drag-and-drop source's independent pointer capture.
 (multiple-value-bind (root view) (selection-fixture)
   (selection-pointer root :down 16 15 :timestamp 1) (selection-pointer root :up 16 15)
   (selection-pointer root :down 20 19 :timestamp 1.2)
   (assert (equal '(2 2) (multiple-value-list (lut:selection view))))
   (lut:dispose root))
 (let* ((root (lut:make-widget 'lut:window :width 400 :height 200))
        (view (lut:add-child root (lut:make-widget 'drag-selection-view :text "drag" :x 10 :y 10 :width 120 :height 60)))
        (target (lut:add-child root (lut:make-widget 'drop-box :x 200 :y 10 :width 100 :height 100))))
   (declare (ignore target))
   (selection-pointer root :down 20 20)
   (assert (slot-value root 'lut::text-selection-state))
   (selection-pointer root :move 220 30)
   (assert (eq :dragging (lut:drag-state (lut:current-drag root))))
   (assert (eq view (slot-value root 'lut::pressed-widget)))
   (assert (null (slot-value root 'lut::text-selection-state)))
   (lut:cancel-text-selection root :forget-clicks t)
   (assert (eq view (slot-value root 'lut::pressed-widget)))
   (selection-pointer root :up 220 30)
   (assert (null (lut:current-drag root))) (lut:dispose root))
 ;; Whole-word dragging into a long line selects its end without measuring
 ;; that far-off caret just to clamp horizontal autoscroll.
 (let* ((root (lut:make-widget 'lut:window :width 300 :height 200))
        (view (lut:add-child root (lut:make-widget 'counting-text-view
                 :text (concatenate 'string (format nil "a~%") (make-string 10000 :initial-element #\a))
                 :width 60 :height 60 :style '(:padding 0 :line-height 20)))))
   (selection-pointer root :down 1 5 :click-count 2)
   (selection-pointer root :move 90 25)
   (assert (= 10002 (lut:cursor view)))
   (assert (lut:advance-text-selection root 0.1))
   (assert (<= (measured view) 513))
   (lut:dispose root))
 ;; Timed, stationary-pointer autoscroll affects only the captured shared view.
 (let* ((text (with-output-to-string (s) (dotimes (i 100) (write-string (make-string 100 :initial-element #\a) s) (terpri s))))
        (buffer (lut:make-text-buffer :text text))
        (root (lut:make-widget 'lut:window :width 300 :height 200))
        (view (lut:add-child root (lut:make-widget 'lut:text-view :view-buffer buffer :width 60 :height 60
                                                 :style '(:padding 0 :font-size 10 :line-height 20))))
        (peer (lut:make-widget 'lut:text-view :view-buffer buffer)))
   (lut:replace-buffer-range buffer 0 0 "x") (setf (lut:read-only-p buffer) t)
   (selection-pointer root :down 12 10)
   (selection-pointer root :move 90 90)
   (let ((position (lut:cursor view)))
     (assert (not (lut:advance-text-selection root 0)))
     (assert (lut:advance-text-selection root 0.1))
     (assert (> (lut:cursor view) position))
     (assert (= 2 (slot-value view 'lut::anchor)))
     (assert (plusp (lut:text-offset view))) (assert (plusp (lut:vertical-offset view)))
     (assert (zerop (lut:text-offset peer))) (assert (zerop (lut:vertical-offset peer)))
     (assert (not (slot-value buffer 'lut::text-snapshot-p)))
     (let ((old-x (lut:text-offset view)) (old-y (lut:vertical-offset view)))
       (lut:advance-text-selection root 100)
       (assert (<= (- (lut:text-offset view) old-x) 80))
       (assert (<= (- (lut:vertical-offset view) old-y) 80)))
     (selection-pointer root :move -90 -90)
     (dotimes (i 10) (lut:advance-text-selection root 0.1))
     (assert (zerop (lut:text-offset view))) (assert (zerop (lut:vertical-offset view)))
     (assert (not (lut:advance-text-selection root 0.1)))
     (selection-pointer root :up -90 -90)
     (assert (not (lut:advance-text-selection root 0.1))))
   ;; Disable, edit, rebind and detach each cancel their own capture references.
   (selection-pointer root :down 12 10) (setf (lut:enabled-p view) nil)
   (assert (not (lut:advance-text-selection root 0.1)))
   (assert (null (slot-value root 'lut::text-selection-state)))
   (setf (lut:enabled-p view) t (lut:read-only-p buffer) nil)
   (selection-pointer root :down 12 10) (lut:replace-buffer-range buffer 0 0 "x" :origin view)
   (assert (null (slot-value root 'lut::text-selection-state)))
   (selection-pointer root :down 12 10) (setf (lut:view-buffer view) nil)
   (assert (null (slot-value root 'lut::text-selection-state)))
   (selection-pointer root :down 12 10 :timestamp 10) (lut:remove-child root view)
   (assert (null (slot-value root 'lut::text-selection-state)))
   (assert (null (slot-value root 'lut::text-click-state)))
   (lut:dispose view) (lut:dispose peer) (lut:dispose root) (lut:dispose buffer))
 ;; Incoming output and other views' edits preserve a read-only drag. Remap
 ;; both the captured anchor/unit and the visible selection before observers.
 (dolist (count '(1 2 3))
   (let* ((root (lut:make-widget 'lut:window :width 400 :height 200))
          (buffer (lut:make-text-buffer :text (format nil "alpha beta~%second line~%third")))
          (view (lut:add-child root (lut:make-widget 'lut:text-view :view-buffer buffer :read-only-p t
                    :x 10 :y 10 :width 120 :height 60 :style '(:padding 0 :font-size 10 :line-height 20))))
          (writer (lut:make-widget 'lut:text-view :view-buffer buffer)))
     (selection-pointer root :down 22 15 :click-count count)
     (selection-pointer root :move 58 15)
     (let* ((state (slot-value root 'lut::text-selection-state))
            (bounds (list (fifth state) (sixth state)))
            (positions (list (lut:cursor view) (slot-value view 'lut::anchor))))
       (dotimes (i 5)
         (let ((end (lut:text-length buffer))) (lut:replace-buffer-range buffer end end " output"))
         (assert (eq state (slot-value root 'lut::text-selection-state)))
         (assert (equal bounds (list (fifth state) (sixth state)))))
       (lut:replace-buffer-range buffer 0 0 "ZZ " :origin writer)
       (assert (equal (mapcar (lambda (p) (+ p 3)) bounds) (list (fifth state) (sixth state))))
       (assert (equal (mapcar (lambda (p) (+ p 3)) positions) (list (lut:cursor view) (slot-value view 'lut::anchor))))
       (lut:replace-buffer-range buffer 0 2 "" :origin writer)
       (assert (equal (mapcar #'1+ bounds) (list (fifth state) (sixth state))))
       (lut:replace-buffer-range buffer 2 4 "!" :origin writer)
       (assert (eq state (slot-value root 'lut::text-selection-state)))
       (assert (eq view (slot-value root 'lut::pressed-widget)))
       (selection-pointer root :move 90 35)
       (assert (= (fifth state) (slot-value view 'lut::anchor)))
       (assert (> (lut:cursor view) (slot-value view 'lut::anchor)))
       (selection-pointer root :move 10 15)
       (assert (= 0 (lut:cursor view)))
       (assert (= (if (= count 1) (fifth state) (sixth state)) (slot-value view 'lut::anchor)))
       (selection-pointer root :up 10 15)
       (assert (null (slot-value root 'lut::text-selection-state))))
     (lut:dispose root) (lut:dispose writer) (lut:dispose buffer)))
 ;; One complete 1 Mi-character run remains selectable/navigable. Only the
 ;; initial kind lookup descends by character index; scans walk leaf strings.
 (let* ((buffer (lut:make-text-buffer :text (make-string 1048576 :initial-element #\a)))
        (lookups 0) (original (symbol-function 'lut::index-character)))
   (lut:replace-buffer-range buffer 1048576 1048576 "a")
   (unwind-protect
       (progn
         (setf (symbol-function 'lut::index-character)
               (lambda (root position) (incf lookups) (funcall original root position)))
         (assert (equal '(0 1048577) (multiple-value-list (lut:text-word-range buffer 500000))))
         (let ((root (slot-value buffer 'lut::text-root)))
           (assert (= 0 (lut::word-navigation-position root 1048577 :word-left)))
           (assert (= 1048577 (lut::word-navigation-position root 0 :word-right))))
         (assert (< lookups 128))
         (assert (not (slot-value buffer 'lut::text-snapshot-p))))
     (setf (symbol-function 'lut::index-character) original) (lut:dispose buffer)))
 ;; Modal surfaces and focus changes stop selection without clearing its range.
 (multiple-value-bind (root view) (selection-fixture)
   (selection-pointer root :down 16 15 :click-count 2)
   (lut:show-dialog root (lut:make-widget 'lut:dialog))
   (assert (null (slot-value root 'lut::text-selection-state)))
   (assert (string= "alpha" (lut:selected-text view)))
   (lut:close-dialog root)
   (selection-pointer root :down 16 15)
   (lut:focus root nil) (assert (null (slot-value root 'lut::text-selection-state)))
   (lut:dispose root))
 (format t "Word/line navigation, pixel goals, repeated-click unit selection, timed autoscroll and capture cleanup passed.~%"))

(defun single-line-centering-tests ()
 (dolist (class '(lut:entry lut:combo-box))
   (dolist (height '(20 28 40 64))
     (let ((view (lut:make-widget class :text "Hello" :y 10 :height height
                                 :style '(:font-size 16 :line-height 26 :padding 8))))
       (unwind-protect
         (progn
           (multiple-value-bind (x y width caret-height) (lut:text-position-rectangle view 2)
             (declare (ignore width))
             (assert (= 16 caret-height))
             (assert (= (+ 10 (/ (- height 16) 2)) y))
             (assert (= 2 (lut:text-point-position view x (+ y 8))))
             (let ((seen 0))
               (lut:map-visible-text-lines view
                 (lambda (line start end px py) (declare (ignore px))
                   (assert (zerop line)) (assert (zerop start)) (assert (= 5 end))
                   (assert (= y py)) (incf seen)))
               (assert (= 1 seen))))
           (lut:reveal-text-cursor view)
           (assert (zerop (lut:vertical-offset view))))
         (lut:dispose view)))))
 (let ((view (lut:make-widget 'lut:text-view :text "Hello" :y 10 :height 64
                              :style '(:font-size 16 :line-height 26 :padding 8))))
   (unwind-protect
     (multiple-value-bind (x y width height) (lut:text-position-rectangle view 0)
       (declare (ignore x width)) (assert (= 18 y)) (assert (= 26 height)))
     (lut:dispose view)))
 (format t "Single-line entry/combo centering and multiline top alignment passed.~%"))
