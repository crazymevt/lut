(in-package #:lut-tests)
(defclass recording-application-window (lut:window) ((requests :initform nil :accessor window-requests)))
(defmethod lut::native-window-state-available-p ((window recording-application-window)) t)
(defmethod lut::request-native-window-operation ((window recording-application-window) operation value)
 (push (list operation value) (window-requests window)))
(defun application-adapter-tests ()
 (let* ((lut:*default-application-command* (list "/usr/bin/printf" "%s"))
        (uri "https://example.invalid/a?q=';$()&name=two%20words") (seen nil)
        (lut::*launch-program-function* (lambda (argv) (setf seen argv) (values "" "" 0))))
   (assert (equal '(t :configured) (multiple-value-list (lut:launch-uri uri))))
   (assert (equal (list "/usr/bin/printf" "%s" uri) seen))
   (let ((cap (lut:default-application-capabilities)))
     (setf (char (first (getf cap :command)) 0) #\X)
     (assert (equal "/usr/bin/printf" (first lut:*default-application-command*))))
   (uiop:with-temporary-file (:pathname path :prefix "lut-launch spaced-")
     (lut:launch-file path) (assert (equal (namestring (truename path)) (third seen))))
   (let ((removed nil) (previous seen))
     (uiop:with-temporary-file (:pathname path) (setf removed path))
     (assert (handler-case (progn (lut:launch-file removed) nil)
       (lut:target-launch-error (c) (eq :invalid-target (lut:launch-error-reason c)))))
     (assert (eq previous seen)))
   (dolist (invalid '("relative/path" "-bad:uri" "1bad:uri" "https://two words" "λ:bad"))
     (assert (handler-case (progn (lut:launch-uri invalid) nil)
               (lut:target-launch-error (c) (eq :invalid-target (lut:launch-error-reason c))))))
   (let ((lut::*launch-program-function* (lambda (argv) (declare (ignore argv)) (values "" "refused" 7))))
     (assert (handler-case (progn (lut:launch-uri uri) nil)
       (lut:target-launch-error (c) (and (eq :nonzero-exit (lut:launch-error-reason c))
          (= 7 (lut:launch-error-exit-code c)) (equal "refused" (lut:launch-error-detail c)))))))
   (let ((lut::*launch-program-function* (lambda (argv) (declare (ignore argv)) (error "process failed"))))
     (assert (handler-case (progn (lut:launch-uri uri) nil)
       (lut:target-launch-error (c) (eq :process-error (lut:launch-error-reason c)))))))
 (let ((lut:*default-application-command* nil))
   (assert (not (getf (lut:default-application-capabilities) :available-p)))
   (assert (handler-case (progn (lut:launch-uri "https://example.invalid") nil)
     (lut:target-launch-error (c) (eq :unavailable (lut:launch-error-reason c))))))
 (let ((lut:*default-application-command* '("lut-nonexistent-launcher-328574")))
   (assert (not (getf (lut:default-application-capabilities) :available-p))))
 (let ((lut:*default-application-command* '("/usr/bin/printf" "%s"))
       (actual lut::*launch-program-function*) (uri "custom:a;$()&b='literal'"))
   (let ((lut::*launch-program-function* (lambda (argv)
     (multiple-value-bind (out err code) (funcall actual argv)
       (assert (equal out uri)) (values out err code)))))
     (assert (lut:launch-uri uri))))
 (let ((window (lut:make-widget 'lut:window :width 800 :height 600)))
   (setf (lut:width window) 1000 (lut:height window) 700)
   (assert (equal '(1000 700) (multiple-value-list (lut:normal-window-size window))))
   ;; No normal size is saved yet: startup retains the legacy current-size rule.
   (lut:layout window 0 0 1200 900)
   (assert (equal '(1200 900) (multiple-value-list (lut:normal-window-size window))))
   (assert (equal '(:unavailable nil) (multiple-value-list (lut:window-state window))))
   (lut:set-normal-window-size window 640 480)
   (lut:layout window 0 0 1800 1200)
   (assert (equal '(640 480) (multiple-value-list (lut:normal-window-size window))))
   (assert (handler-case (progn (lut:set-window-state window :maximized) nil) (lut:unsupported-capability () t)))
   (assert (handler-case (progn (lut:set-normal-window-size window 0 20) nil) (error () t)))
   (assert (equal '(640 480) (multiple-value-list (lut:normal-window-size window))))
   (lut:dispose window)
   (assert (handler-case (progn (lut:window-state window) nil) (error () t))))
 (let ((window (lut:make-widget 'recording-application-window)))
   (lut:set-normal-window-size window 500 400)
   (lut:set-window-state window :maximized)
   (assert (equal '((:state :maximized) (:normal-size (500 400))) (window-requests window)))
   (assert (equal '(500 400) (multiple-value-list (lut:normal-window-size window))))
   (assert (handler-case (progn (lut:set-window-state window :fullscreen) nil) (error () t)))
   (lut:dispose window))
 (format t "Explicit launch argv, real stub process, failures/availability, independent normal size, native operation routing and validation passed.~%"))
