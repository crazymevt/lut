(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(asdf:load-system "lut/examples")
(defun capture-presentation (root path)
 (let ((texture (rl:load-render-texture (round (lut:width root)) (round (lut:height root)))))
   (unwind-protect
       (progn
         (rl:with-texture-mode (texture)
           (rl:clear-background (lut:style-value root :background)) (lut::render-window root))
         (let ((image (rl:load-image-from-texture (rl:render-texture-texture texture))))
           (unwind-protect (progn (rl:image-flip-vertical image) (rl:export-image image path)) (rl:unload-image image))))
     (rl:unload-render-texture texture))))
(dolist (theme (list lut:*light-theme* lut:*dark-theme*))
 (let* ((root (lut-examples:document-presentation)) (editor (lut:find-widget root :presentation-editor))
        (document (lut:find-widget root :presentation-document))
        (status (lut:find-widget root :presentation-status)) (frame 0) (checked nil)
        (name (if (eq theme lut:*light-theme*) "light" "dark")))
   (setf (lut:theme root) theme)
   (lut:on root :tick (lambda (w dt)
     (declare (ignore w dt))
     (case (incf frame)
       (2
         (setf (lut:style editor) '(:font-size 18 :line-height 32 :font-spacing 2))
         ;; A whole native span and the character geometry must agree across
         ;; font boundaries, including inter-fragment spacing.
         (multiple-value-bind (start end) (lut:text-line-range editor 0)
           (let ((expected 0) (fragments 0))
             (lut::map-presentation-fragments editor start end
               (lambda (a b style image)
                 (declare (ignore image))
                 (let ((lut::*text-style-context* (cons editor style)))
                   (incf expected (lut:text-width editor (lut:text-range editor a b))) (incf fragments))))
             (incf expected (* (max 0 (1- fragments)) 2))
             (assert (< (abs (- expected (- (lut:text-position-rectangle editor end) (lut:text-position-rectangle editor start)))) 0.5)))
           (loop for position from start to end do
             (multiple-value-bind (x y) (lut:text-position-rectangle editor position)
               (assert (= position (lut:text-point-position editor x (+ y 5)))))))
         (let* ((image (first (lut:document-images document))) (position (getf image :position)))
           (multiple-value-bind (x y) (lut:text-position-rectangle document position)
             (assert (eq :image (lut:document-hit-test document (+ x 15) (+ y 16))))))
         (let ((position (getf (first (lut:document-links document)) :start)))
           (multiple-value-bind (x y) (lut:text-position-rectangle document position)
             (lut:dispatch root (lut:make-event :kind :down :x (+ x 1) :y (+ y 5)))
             (lut:dispatch root (lut:make-event :kind :up :x (+ x 1) :y (+ y 5)))))
         (assert (search "handled link" (lut:text status)))
         (assert (lut:find-widget root :presentation-help))
         (lut:dispatch root (lut:make-event :kind :key :key :escape))
         (lut:emit (lut:find-widget root :show-suggestions) :activate)
         (assert (eq editor (lut:focused-widget root)))
         (lut:dispatch root (lut:make-event :kind :text :text "x"))
         (assert (lut:find-widget root :presentation-suggestions))
         (lut:dispatch root (lut:make-event :kind :key :key :down)))
       (3
         ;; Rendering must preserve a wheel viewport even when the selected
         ;; candidate is offscreen. Restore the demo candidates afterward.
         (let* ((surface (lut:find-widget root :presentation-suggestions))
                (items (lut:items surface)))
           (setf (lut:items surface) (loop for i below 30 collect (list :label (format nil "Candidate ~d" i)))
                 (lut:value surface) 0)
           (lut:dispatch root (lut:make-event :kind :wheel :x (+ (lut:x surface) 12)
                                            :y (+ (lut:y surface) 12) :delta -6))
           (let ((offset (lut:scroll-offset surface)))
             (assert (plusp offset))
             (capture-presentation root (format nil "/tmp/lut-presentation-~a-wheel.png" name))
             (assert (= offset (lut:scroll-offset surface))))
           (setf (lut:items surface) items (lut:value surface) 1))
         (capture-presentation root (format nil "/tmp/lut-presentation-~a-suggestions.png" name))
         (lut:dispatch root (lut:make-event :kind :key :key :enter))
         (assert (search "Accepted application candidate: format" (lut:text status)))
         (assert (null (lut:find-widget root :presentation-suggestions)))
         (lut:emit (lut:find-widget root :show-help) :activate)
         (let ((help (lut:find-widget root :presentation-help-text)))
           (lut:focus root help) (lut:select-all help)
           (assert (search "Application-owned help" (lut:selected-text help)))))
       (4
         (capture-presentation root (format nil "/tmp/lut-presentation-~a-help.png" name))
         (lut:dispatch root (lut:make-event :kind :key :key :escape))
         (assert (eq editor (lut:focused-widget root)))
         (assert (not (lut:editable-p document))) (assert lut::*used-textures*)
         (setf checked t)))))
   (unwind-protect (progn (lut:run root :frames 5) (assert checked)) (lut:dispose root))))
(format t "Native mixed-font metrics/hit testing, gutters/decorations, inline images/links, suggestion acceptance and selectable help passed in light/dark themes; /tmp/lut-presentation-*.png.~%")
