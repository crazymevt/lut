(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/examples")
;; Focus is reported over IPC; exercise transitions deterministically without
;; changing which desktop application the person is using during the tests.
(let* ((owner (lut:make-widget 'lut:window))
       (modal (lut:make-widget 'lut:dialog))
       (modeless (lut:make-widget 'lut:dialog :modal-p nil))
       (remote (lut::make-remote-window :owner owner :dialog modal :root (lut:make-widget 'lut:window)))
       (other (lut::make-remote-window :owner owner :dialog modeless :root (lut:make-widget 'lut:window)))
       (lut::*remote-windows* (list remote other)))
 (lut::sync-modal-window-levels t)
 (assert (lut::remote-window-topmost-p remote))
 (assert (not (lut::remote-window-topmost-p other)))
 (setf (lut::remote-window-forms remote) nil)
 (lut::focus-modal remote)
 (lut::sync-modal-window-levels nil)
 (assert (not (lut::remote-window-topmost-p remote)))
 (assert (equal '((rl:clear-window-state :window-topmost)) (lut::remote-window-forms remote)))
 (assert (eq remote (lut::modal-blocker owner))) ; backgrounding does not dismiss or unblock
 (setf (lut::remote-window-forms remote) nil)
 (lut::sync-modal-window-levels nil)
 (assert (null (lut::remote-window-forms remote))) ; no repeated state commands
 (setf (lut::remote-window-focused-p remote) t)
 (lut::sync-modal-window-levels nil)
 (assert (lut::remote-window-topmost-p remote)) ; return through the dialog
 (setf (lut::remote-window-focused-p remote) nil)
 (lut::sync-modal-window-levels nil)
 (assert (not (lut::remote-window-topmost-p remote)))
 (lut::sync-modal-window-levels t)
 (assert (lut::remote-window-topmost-p remote)) ; return through the owner
 (assert (not (lut::remote-window-topmost-p other)))
 (setf (lut::remote-window-focused-p other) t)
 (lut::sync-modal-window-levels nil)
 (assert (lut::remote-window-topmost-p remote)) ; another LUT window keeps the group active
 (setf (lut::remote-window-closing-p other) t)
 (lut::sync-modal-window-levels nil)
 (assert (not (lut::remote-window-topmost-p remote))))
(format t "Modal stacking releases on app deactivation and restores for owner/worker activation; modeless and input blocking checks passed.~%")
(let* ((main (lut-examples:hello-world))
       (dialog (lut:make-widget 'lut:dialog :text "Native dialog" :width 400 :height 220))
       (button (lut:make-widget 'lut:button :text "Same parent objects"))
       (remote nil) (phase :start) (clicks 0) (draws 0)
       (deadline (+ (get-internal-real-time) (* 15 internal-time-units-per-second))))
 (lut:on button :activate (lambda (w e) (declare (ignore w e))
                          (incf clicks) (lut:dismiss-dialog dialog)))
 (lut:add-child dialog button)
 (lut:add-child dialog (lut:make-widget 'lut:drawing-area :height 60
   :draw-function (lambda (area) (incf draws)
     (rl:draw-circle (+ (lut:x area) 30) (+ (lut:y area) 30) 20 :skyblue))))
 (lut:show-dialog main dialog)
 (lut:on main :tick
   (lambda (w dt)
     (declare (ignore w dt))
     (when (> (get-internal-real-time) deadline)
       (error "Native IPC timeout in ~a; frames ~a, error ~a" phase
         (and remote (lut::remote-window-frames remote)) (and remote (lut::remote-window-error remote))))
     (when (and remote (lut::remote-window-error remote)) (error (lut::remote-window-error remote)))
     (case phase
       (:start
        (setf remote (find (lut::root-of dialog) lut::*remote-windows* :key #'lut::remote-window-root)
              phase :waiting)
        (assert remote)
        (assert (not (member dialog (lut::overlays main))))
        (assert (lut::native-p dialog))
        (assert (not (lut:draggable-p dialog)))
        (lut:on-window remote (assert (rl:is-window-state :window-topmost))))
       (:waiting
        (unless (lut:remote-alive-p remote) (error "Worker exited before readiness."))
        (when (>= (lut::remote-window-frames remote) 2)
          (assert (eq button (first (lut:children dialog))))
          (assert (>= draws 2))
          (setf (lut:text button) "Edited from original REPL" (lut:theme main) lut:*dark-theme*)
          (assert (equal (getf lut:*dark-theme* :foreground) (lut:style-value button :foreground)))
          (lut:on-window remote
            (lut::forward-native-event (lut:make-event :kind :down :x 20 :y 20))
            (lut::forward-native-event (lut:make-event :kind :up :x 20 :y 20)))
          (setf phase :response)))
       (:response
        (when (and (= clicks 1) (not (lut:remote-alive-p remote)) (null (lut::remote-window-root remote)))
          (setf phase :done) (lut:stop))))))
 (unwind-protect (lut:run main :frames 1500)
   (when (and remote (lut:remote-alive-p remote)) (lut:close-window remote)))
 (assert (eq phase :done))
 (assert (= clicks 1))
 (assert (lut:disposed-p dialog))
 (assert (null (lut::remote-window-root remote)))
 (assert (null (lut::remote-window-process remote)))
 (assert (null (lut::remote-window-reader remote)))
 (assert (not (member remote lut::*remote-windows*)))
 (assert (null (lut::remote-window-error remote)))
 (format t "Direct native-dialog IPC, drawing, inherited styling and callback checks passed (~d round trips).~%"
         (lut::remote-window-frames remote)))
 ;; Dialogs created while the controller runs open immediately, without a drag.
(let* ((main (lut-examples:hello-world))
       (dialog (lut:make-widget 'lut:dialog :text "Immediate native dialog" :detach-on-drag-p nil))
       (popup (lut:make-widget 'lut:popover))
       (owner-button (lut:add-child main (lut:make-widget 'lut:button :text "Owner action")))
       (owner-list (lut:add-child main (lut:make-widget 'lut:list-view :items '("Hover row"))))
       (parent-clicks 0) (parent-keys 0)
       (remote nil) (phase :open)
       (deadline (+ (get-internal-real-time) (* 15 internal-time-units-per-second))))
 (lut:on owner-button :activate (lambda (w e) (declare (ignore w e)) (incf parent-clicks)))
 (lut:on main :key (lambda (w e) (declare (ignore w e)) (incf parent-keys)))
 (lut:on main :tick (lambda (w dt)
   (declare (ignore w dt))
   (when (> (get-internal-real-time) deadline) (error "Immediate dialog timeout: ~a" phase))
   (when (and remote (lut::remote-window-error remote)) (error (lut::remote-window-error remote)))
   (case phase
     (:open
       (setf (lut::hovered-p owner-button) t
             (lut::hovered-p owner-list) t (lut::hovered-row owner-list) 0)
       (assert (eq dialog (lut:show-dialog main dialog)))
       (assert (not (lut::hovered-p owner-button)))
       (assert (not (lut::hovered-p owner-list)))
       (assert (null (lut::hovered-row owner-list)))
       (assert (null (lut::overlays main)))
       (setf remote (find (lut::root-of dialog) lut::*remote-windows* :key #'lut::remote-window-root))
       (assert remote)
       (lut:show-dialog main popup)
       (assert (member popup (lut::overlays main)))
       (assert (eq main (lut::root-of popup)))
       (lut:dismiss-dialog popup)
       (setf phase :ready))
     (:ready
       (when (>= (lut::remote-window-frames remote) 2)
         (assert (eq remote (lut::modal-blocker main)))
         (lut:focus main owner-button)
         (lut:dispatch main (lut:make-event :kind :key :key :enter))
         (lut:dispatch main (lut:make-event :kind :down :x (+ (lut:x owner-button) 10) :y (+ (lut:y owner-button) 10)))
         (lut:dispatch main (lut:make-event :kind :up :x (+ (lut:x owner-button) 10) :y (+ (lut:y owner-button) 10)))
         (assert (zerop parent-clicks)) (assert (zerop parent-keys))
         ;; Modeless dialogs explicitly allow owner input.
         (setf (lut:modal-p dialog) nil)
         (lut:on-window remote (assert (not (rl:is-window-state :window-topmost))))
         (assert (null (lut::modal-blocker main)))
         (lut:dispatch main (lut:make-event :kind :key :key :enter))
         (assert (= 1 parent-clicks))
         (setf (lut:modal-p dialog) t)
         (lut:on-window remote (assert (rl:is-window-state :window-topmost)))
         ;; Nested modals redirect focus to the deepest child.
         (let* ((nested (lut:make-widget 'lut:dialog :text "Nested modal"))
                (host (lut::remote-window-root remote)))
           (lut:show-dialog host nested)
           (let ((nested-remote (lut::modal-blocker host)))
             (assert nested-remote)
             (assert (eq nested-remote (lut::modal-blocker main)))
             (lut:dismiss-dialog nested)
             (assert (eq remote (lut::modal-blocker main)))))
         (lut:on-window remote
           (lut::forward-native-event (lut:make-event :kind :key :key :escape)))
         (setf phase :closing)))
     (:closing
       (when (null (lut::remote-window-root remote))
         (assert (null (lut::modal-blocker main)))
         (lut:dispatch main (lut:make-event :kind :key :key :enter))
         (assert (= 2 parent-clicks))
         (setf phase :done) (lut:stop))))))
 (lut:run main :frames 1500)
 (assert (eq phase :done))
 (assert (lut:disposed-p dialog))
 (assert (null (lut::remote-window-error remote)))
 (format t "Immediate native creation, modal/modeless owner input, nested modals, overlay popovers and Escape dismissal passed.~%"))
;; Teardown also handles a worker still starting when the primary loop exits.
(let ((main (lut-examples:hello-world)) (remote nil))
 (lut:on main :tick (lambda (w dt) (declare (ignore w dt))
   (unless remote (setf remote (lut:spawn-window (lut-examples:hello-world))))))
 (lut:run main :frames 3)
 (assert (null (lut::remote-window-root remote)))
 (assert (null lut::*remote-windows*))
 (assert (null lut::*ui-queue*))
 (assert (null lut:*window*))
 (let ((deadline (+ (get-internal-real-time) (* 10 internal-time-units-per-second))))
   (loop while (lut::remote-window-process remote)
         do (when (> (get-internal-real-time) deadline) (error "Worker process did not exit after controller shutdown."))
            (sleep 0.01)))
 (assert (null (lut::remote-window-reader remote)))
 (assert (null (lut::remote-window-error remote)))
 (format t "Primary shutdown released starting worker roots and process references.~%"))
