(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lui.asd"))
(ql:quickload "lui/examples")
(let* ((main (lui-examples:hello-world))
       (dialog (lui:make-widget 'lui:dialog :text "Detached native dialog" :width 400 :height 220))
       (button (lui:make-widget 'lui:button :text "Same parent objects"))
       (remote nil) (phase :start) (clicks 0) (draws 0)
       (deadline (+ (get-internal-real-time) (* 15 internal-time-units-per-second))))
 (lui:on button :activate (lambda (w e) (declare (ignore w e))
                          (incf clicks) (lui:dismiss-dialog dialog)))
 (lui:add-child dialog button)
 (lui:add-child dialog (lui:make-widget 'lui:drawing-area :height 60
   :draw-function (lambda (area) (incf draws)
     (rl:draw-circle (+ (lui:x area) 30) (+ (lui:y area) 30) 20 :skyblue))))
 (lui:show-dialog main dialog)
 (lui:on main :tick
   (lambda (w dt)
     (declare (ignore w dt))
     (when (> (get-internal-real-time) deadline)
       (error "Native IPC timeout in ~a; frames ~a, error ~a" phase
         (and remote (lui::remote-window-frames remote)) (and remote (lui::remote-window-error remote))))
     (when (and remote (lui::remote-window-error remote)) (error (lui::remote-window-error remote)))
     (case phase
       (:start
        (lui::layout-window main)
        (lui:dispatch main (lui:make-event :kind :down :x (+ (lui:x dialog) 8) :y (+ (lui:y dialog) 8)))
        (lui:dispatch main (lui:make-event :kind :move :x (+ (lui:width main) 20) :y (+ (lui:y dialog) 40)))
        (setf remote (find (lui::root-of dialog) lui::*remote-windows* :key #'lui::remote-window-root)
              phase :waiting)
        (assert remote))
       (:waiting
        (unless (lui:remote-alive-p remote) (error "Worker exited before readiness."))
        (when (>= (lui::remote-window-frames remote) 2)
          (assert (eq button (first (lui:children dialog))))
          (assert (>= draws 2))
          (setf (lui:text button) "Edited from original REPL" (lui:theme main) lui:*dark-theme*)
          (assert (equal (getf lui:*dark-theme* :foreground) (lui:style-value button :foreground)))
          (lui:on-window remote
            (lui::forward-native-event (lui:make-event :kind :down :x 20 :y 48))
            (lui::forward-native-event (lui:make-event :kind :up :x 20 :y 48)))
          (setf phase :response)))
       (:response
        (when (and (= clicks 1) (not (lui:remote-alive-p remote)) (null (lui::remote-window-root remote)))
          (setf phase :done) (lui:stop))))))
 (unwind-protect (lui:run main :frames 1500)
   (when (and remote (lui:remote-alive-p remote)) (lui:close-window remote)))
 (assert (eq phase :done))
 (assert (= clicks 1))
 (assert (lui:disposed-p dialog))
 (assert (null (lui::remote-window-root remote)))
 (assert (null (lui::remote-window-process remote)))
 (assert (null (lui::remote-window-reader remote)))
 (assert (not (member remote lui::*remote-windows*)))
 (assert (null (lui::remote-window-error remote)))
 (format t "Native detached-window IPC, drawing, inherited styling and callback checks passed (~d round trips).~%"
         (lui::remote-window-frames remote)))
;; Teardown also handles a worker still starting when the primary loop exits.
(let ((main (lui-examples:hello-world)) (remote nil))
 (lui:on main :tick (lambda (w dt) (declare (ignore w dt))
   (unless remote (setf remote (lui:spawn-window (lui-examples:hello-world))))))
 (lui:run main :frames 3)
 (assert (null (lui::remote-window-root remote)))
 (assert (null lui::*remote-windows*))
 (assert (null lui::*ui-queue*))
 (assert (null lui:*window*))
 (let ((deadline (+ (get-internal-real-time) (* 10 internal-time-units-per-second))))
   (loop while (lui::remote-window-process remote)
         do (when (> (get-internal-real-time) deadline) (error "Worker process did not exit after controller shutdown."))
            (sleep 0.01)))
 (assert (null (lui::remote-window-reader remote)))
 (assert (null (lui::remote-window-error remote)))
 (format t "Primary shutdown released starting worker roots and process references.~%"))
