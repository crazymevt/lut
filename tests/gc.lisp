(defpackage #:lut-gc-tests (:use #:cl) (:export #:run-tests))
(in-package #:lut-gc-tests)
(declaim (notinline make-disposed-weak make-detached-cycle))
(defun make-disposed-weak (root)
 (let* ((child (lut:add-child root (lut:make-widget 'lut:entry :text "temporary")))
        (weak (trivial-garbage:make-weak-pointer child)))
   (lut:on root :tick (lambda (w dt) (declare (ignore w dt)) (lut:text child)) :owner child)
   (lut:on-widget child (lut:text child))
   (lut:dispose child) weak))
(defun make-detached-cycle (root)
 (let* ((box (lut:add-child root (lut:make-widget 'lut:box)))
        (child (lut:add-child box (lut:make-widget 'lut:label)))
        (weak (trivial-garbage:make-weak-pointer child)))
   (lut:on child :test (lambda (w p) (declare (ignore w p)) (lut:children box)))
   (lut:remove-child root box) weak))
(defun make-gc-fixture ()
 ;; Construct on a terminating thread so conservative stack/register remnants
 ;; cannot keep the last loop temporary alive during the actual reachability check.
 (let* ((root (lut:make-widget 'lut:window))
        (weak (loop repeat 300 collect (make-disposed-weak root)))
        (cycles (loop repeat 300 collect (make-detached-cycle root))))
   (list root weak cycles)))
(declaim (notinline make-command-cycle))
(defun make-command-cycle (root command)
 (let* ((context (list :count 0))
        (view (lut:add-child root (lut:make-widget 'lut:button)))
        (binding (lut:bind-command root command :widget view
                   :context-function (lambda (w) (declare (ignore w)) context)))
        (weak-context (trivial-garbage:make-weak-pointer context))
        (weak-view (trivial-garbage:make-weak-pointer view)))
   (lut:dispose view)
   (list binding weak-context weak-view)))
(defun make-command-gc-fixture ()
 (let* ((root (lut:make-widget 'lut:window))
        (command (lut:make-command :test "Test" (lambda (c context) (declare (ignore c context)) nil)))
        (records (loop repeat 100 collect (make-command-cycle root command))))
   (list root command records)))
(declaim (notinline make-buffer-view-weak))
(defun make-buffer-view-weak (root buffer)
 (let* ((view (lut:add-child root (lut:make-widget 'lut:text-view :view-buffer buffer)))
        (weak (trivial-garbage:make-weak-pointer view)))
   (lut:on buffer :change (lambda (w text) (declare (ignore w text)) (lut:cursor view)) :owner view)
   (lut:replace-buffer-range buffer 0 0 "x" :origin view)
   ;; Retain both active gesture and repeated-click metadata in the live root.
   ;; Disposal must release these references without native font measurement.
   (setf (slot-value root 'lut::text-selection-state) (list view 0 0 :word 0 1)
         (slot-value root 'lut::text-click-state) (list view 1 0 0 2))
   (lut:dispose view) weak))
(defun make-buffer-gc-fixture ()
 (let* ((root (lut:make-widget 'lut:window)) (buffer (lut:make-text-buffer :text "text" :history-limit 5))
        (weak (loop repeat 100 collect (make-buffer-view-weak root buffer))))
   (list root buffer weak)))
(defun make-presentation-gc-fixture ()
 (let* ((root (lut:make-widget 'lut:window :width 300 :height 200))
        (records (loop repeat 50 collect
          (let* ((payload (lut:make-widget 'lut:widget))
                 (owner (lut:add-child root (lut:make-widget 'lut:document-view :text "link")))
                 (surface (lut:make-widget 'lut:suggestion-surface :items (list payload)
                            :item-label-function (lambda (item) (declare (ignore item)) (lut:id payload))))
                 (weak-owner (trivial-garbage:make-weak-pointer owner))
                 (weak-payload (trivial-garbage:make-weak-pointer payload)))
            (lut:set-text-presentation owner :links (list (list :start 0 :end 4 :target payload)))
            (lut:on surface :accept (lambda (w item) (declare (ignore w item)) (lut:text owner)) :owner owner)
            (lut:show-anchored-surface owner surface :rectangle '(0 0 1 1))
            (lut:dispose owner) (list surface weak-owner weak-payload)))))
   (list root records)))
(defun run-tests ()
 (destructuring-bind (root weak cycles)
     (bt:join-thread (bt:make-thread #'make-gc-fixture :name "LUT GC fixture"))
   (assert (null (lut:children root)))
   (assert (null (slot-value root 'lut::handlers)))
   (assert (null lut::*ui-queue*))
   (trivial-garbage:gc :full t)
   (assert (notany #'trivial-garbage:weak-pointer-value weak))
   (assert (notany #'trivial-garbage:weak-pointer-value cycles)))
 (let ((owner (lut:make-widget 'lut:widget)) (calls 0))
   (let ((job (nth-value 1 (lut:enqueue-ui (lambda () (incf calls)) :owner owner))))
     (lut:dispose owner)
     (assert (null (lut::ui-job-function job)))
     (assert (null (lut::ui-job-owner job)))
     (lut::drain-ui-queue) (assert (zerop calls)))
   (let ((job (nth-value 1 (lut:enqueue-ui (lambda () (incf calls))))))
     (assert (= 1 (lut:cancel-ui job)))
     (lut::drain-ui-queue) (assert (zerop calls))))
 (let ((owner (lut:make-widget 'lut:widget)) (calls 0))
   (lut:enqueue-ui (lambda () (lut:dispose owner)))
   (lut:on-widget owner (incf calls))
   (lut::drain-ui-queue) (assert (zerop calls)))
 (destructuring-bind (root command records)
     (bt:join-thread (bt:make-thread #'make-command-gc-fixture :name "LUT command GC fixture"))
   (trivial-garbage:gc :full t)
   (assert (null (lut:children root)))
   (assert (null (slot-value root 'lut::command-links)))
   (assert (null (slot-value command 'lut::command-links)))
   (dolist (record records)
     (assert (not (lut:command-binding-active-p (first record))))
     (assert (null (trivial-garbage:weak-pointer-value (second record))))
     (assert (null (trivial-garbage:weak-pointer-value (third record)))))
   (lut:dispose root) (lut:dispose command))
 (destructuring-bind (root buffer weak)
     (bt:join-thread (bt:make-thread #'make-buffer-gc-fixture :name "LUT buffer-view GC fixture"))
   (trivial-garbage:gc :full t)
   (assert (null (lut:children root))) (assert (null (lut::buffer-views buffer)))
   (assert (null (slot-value buffer 'lut::handlers)))
   (assert (= 5 (length (lut::undo-history buffer))))
   (assert (notany #'trivial-garbage:weak-pointer-value weak))
   (lut:dispose root) (lut:dispose buffer))
 (destructuring-bind (root records)
     (bt:join-thread (bt:make-thread #'make-presentation-gc-fixture :name "LUT presentation GC fixture"))
   (trivial-garbage:gc :full t)
   (assert (null (slot-value root 'lut::overlays)))
   (dolist (record records)
     (assert (lut:disposed-p (first record)))
     (assert (null (trivial-garbage:weak-pointer-value (second record))))
     (assert (null (trivial-garbage:weak-pointer-value (third record)))))
   (lut:dispose root))
 (format t "GC reachability passed for 300 disposed widgets and 300 detached callback cycles; 100 command-binding contexts/controls, 100 shared-buffer views, 50 document/anchor payloads and owned queue cancellation passed.~%") t)
