(defpackage #:lui-gc-tests (:use #:cl) (:export #:run-tests))
(in-package #:lui-gc-tests)
(declaim (notinline make-disposed-weak make-detached-cycle))
(defun make-disposed-weak (root)
 (let* ((child (lui:add-child root (lui:make-widget 'lui:entry :text "temporary")))
        (weak (trivial-garbage:make-weak-pointer child)))
   (lui:on root :tick (lambda (w dt) (declare (ignore w dt)) (lui:text child)) :owner child)
   (lui:on-widget child (lui:text child))
   (lui:dispose child) weak))
(defun make-detached-cycle (root)
 (let* ((box (lui:add-child root (lui:make-widget 'lui:box)))
        (child (lui:add-child box (lui:make-widget 'lui:label)))
        (weak (trivial-garbage:make-weak-pointer child)))
   (lui:on child :test (lambda (w p) (declare (ignore w p)) (lui:children box)))
   (lui:remove-child root box) weak))
(defun make-gc-fixture ()
 ;; Construct on a terminating thread so conservative stack/register remnants
 ;; cannot keep the last loop temporary alive during the actual reachability check.
 (let* ((root (lui:make-widget 'lui:window))
        (weak (loop repeat 300 collect (make-disposed-weak root)))
        (cycles (loop repeat 300 collect (make-detached-cycle root))))
   (list root weak cycles)))
(defun run-tests ()
 (destructuring-bind (root weak cycles)
     (bt:join-thread (bt:make-thread #'make-gc-fixture :name "LUI GC fixture"))
   (assert (null (lui:children root)))
   (assert (null (slot-value root 'lui::handlers)))
   (assert (null lui::*ui-queue*))
   (trivial-garbage:gc :full t)
   (assert (notany #'trivial-garbage:weak-pointer-value weak))
   (assert (notany #'trivial-garbage:weak-pointer-value cycles)))
 (let ((owner (lui:make-widget 'lui:widget)) (calls 0))
   (let ((job (nth-value 1 (lui:enqueue-ui (lambda () (incf calls)) :owner owner))))
     (lui:dispose owner)
     (assert (null (lui::ui-job-function job)))
     (assert (null (lui::ui-job-owner job)))
     (lui::drain-ui-queue) (assert (zerop calls)))
   (let ((job (nth-value 1 (lui:enqueue-ui (lambda () (incf calls))))))
     (assert (= 1 (lui:cancel-ui job)))
     (lui::drain-ui-queue) (assert (zerop calls))))
 (let ((owner (lui:make-widget 'lui:widget)) (calls 0))
   (lui:enqueue-ui (lambda () (lui:dispose owner)))
   (lui:on-widget owner (incf calls))
   (lui::drain-ui-queue) (assert (zerop calls)))
 (format t "GC reachability passed for 300 disposed widgets and 300 detached callback cycles; owned queue cancellation passed.~%") t)
