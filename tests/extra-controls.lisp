(in-package #:lut-tests)
(defun extra-control-tests ()
 (date-time-tests)
 (polished-control-tests)
 (let* ((root (lut:make-widget 'lut:window :width 400 :height 200))
        (search (lut:add-child root (lut:make-widget 'lut:search-control :text "hello")))
        (submitted nil) (cancelled 0) (changed 0))
   (unwind-protect
        (progn
          (lut:layout search 0 0 300 36)
          (lut:on search :search (lambda (w value) (declare (ignore w)) (push value submitted)))
          (lut:on search :cancel (lambda (w value) (declare (ignore w value)) (incf cancelled)))
          (lut:on search :change (lambda (w value) (declare (ignore w value)) (incf changed)))
          (lut:focus root search)
          (lut:dispatch root (lut:make-event :kind :key :key :enter))
          (assert (equal submitted '("hello")))
          (lut:dispatch root (lut:make-event :kind :key :key :escape))
          (assert (string= "" (lut:text search))) (assert (= 1 cancelled changed))
          (lut:undo search) (assert (string= "hello" (lut:text search)))
          (setf (lut:read-only-p search) t)
          (lut:dispatch root (lut:make-event :kind :key :key :escape))
          (assert (= cancelled 1))
          (setf (lut:read-only-p search) nil)
          (lut:dispatch root (lut:make-event :kind :down :x 280 :y 18))
          (lut:dispatch root (lut:make-event :kind :up :x 280 :y 18))
          (assert (string= "" (lut:text search)))
          (assert (eq search (lut:focused-widget root)))
          (lut:dispatch root (lut:make-event :kind :down :x 18 :y 18))
          (lut:dispatch root (lut:make-event :kind :up :x 18 :y 18))
          (assert (equal submitted '("" "hello"))))
     (lut:dispose root)))
 (let* ((root (lut:make-widget 'lut:window :width 400 :height 200))
        (button (lut:add-child root (lut:make-widget 'lut:icon-toggle-button :text "*")))
        (changes 0))
   (unwind-protect
        (progn
          (lut:on button :change (lambda (w v) (declare (ignore w v)) (incf changes)))
          (lut:focus root button)
          (lut:dispatch root (lut:make-event :kind :key :key :space))
          (assert (lut:value button)) (assert (= 1 changes))
          (setf (lut:enabled-p button) nil)
          (lut:dispatch root (lut:make-event :kind :key :key :enter))
          (assert (= 1 changes)))
     (lut:dispose root)))
 (let ((spinner (lut:make-widget 'lut:activity-indicator)))
   (assert (lut:activity-running-p spinner))
   (assert (not (lut::focusable-p spinner)))
   (setf (lut:activity-running-p spinner) nil)
   (assert (not (lut:activity-running-p spinner)))
   (lut:dispose spinner))
 t)

(defun date-time-tests ()
 (let* ((root (lut:make-widget 'lut:window :width 500 :height 400))
        (date (lut:add-child root (lut:make-widget 'lut:date-picker :calendar-date '(2024 1 31) :picker-field 1)))
        (time (lut:add-child root (lut:make-widget 'lut:time-picker :clock-time '(23 59 59))))
        (events nil))
   (unwind-protect
       (progn
         (lut:layout date 0 0 340 36)
         (lut:layout time 0 50 280 36)
         (lut:on date :change (lambda (w payload) (declare (ignore w)) (push payload events)))
         (lut:focus root date)
         (lut:dispatch root (lut:make-event :kind :key :key :up))
         (assert (equal '(2024 2 29) (lut:calendar-date date)))
         (assert (equal '((2024 2 29)) events))
         (setf (lut:picker-field date) 0)
         (lut:dispatch root (lut:make-event :kind :key :key :down))
         (assert (equal '(2023 2 28) (lut:calendar-date date)))
         (setf (lut:picker-field date) 2)
         (lut:dispatch root (lut:make-event :kind :key :key :up))
         (assert (equal '(2023 3 1) (lut:calendar-date date)))
         (lut:dispatch root (lut:make-event :kind :key :key :down))
         (assert (equal '(2023 2 28) (lut:calendar-date date)))
         (dolist (bad '((1900 2 29) (2024 4 31) (0 1 1) (10000 1 1) (2024 13 1) (2024 2) (2024 2 1.5)))
           (assert (handler-case (progn (setf (lut:calendar-date date) bad) nil) (error () t)))
           (assert (equal '(2023 2 28) (lut:calendar-date date))))
         (let ((v (list 2000 2 29)) (count (length events)))
           (setf (lut:calendar-date date) v)
           (setf (first v) 1900)
           (setf (first (lut:calendar-date date)) 1900)
           (assert (equal '(2000 2 29) (lut:calendar-date date)))
           (assert (= count (length events))))
         (setf (lut:picker-field date) 0)
         (lut:dispatch root (lut:make-event :kind :text :text "2026"))
         (assert (equal '(2026 2 28) (lut:calendar-date date)))
         (setf (lut:calendar-date date) '(1 1 1) (lut:picker-field date) 2)
         (lut:dispatch root (lut:make-event :kind :key :key :down))
         (assert (equal '(1 1 1) (lut:calendar-date date)))
         (setf (lut:calendar-date date) '(9999 12 31))
         (lut:dispatch root (lut:make-event :kind :key :key :up))
         (assert (equal '(9999 12 31) (lut:calendar-date date)))
         (lut:focus root time)
         (lut:dispatch root (lut:make-event :kind :key :key :up))
         (assert (equal '(0 59 59) (lut:clock-time time)))
         (lut:dispatch root (lut:make-event :kind :key :key :right))
         (lut:dispatch root (lut:make-event :kind :key :key :up))
         (assert (equal '(0 0 59) (lut:clock-time time)))
         (dolist (bad '((24 0 0) (0 60 0) (0 0 -1) (0 0) (1 2 3 4)))
           (assert (handler-case (progn (setf (lut:clock-time time) bad) nil) (error () t))))
         (setf (lut:enabled-p time) nil)
         (lut:dispatch root (lut:make-event :kind :key :key :up))
         (assert (equal '(0 0 59) (lut:clock-time time)))
         ;; Mouse opens calendar, weekday alignment and selection commit.
         (setf (lut:calendar-date date) '(2024 2 1))
         (lut:dispatch root (lut:make-event :kind :down :x 330 :y 18))
         (lut:dispatch root (lut:make-event :kind :up :x 330 :y 18))
         (let* ((popup (first (lut::overlays root)))
                (days (second (lut:children popup)))
                (day (find "29" (lut:children days) :key (lambda (w) (if (typep w 'lut:label) (lut:text w) "")) :test #'string=)))
           (assert popup) (assert day)
           ;; February 1 2024 was Thursday: 7 headings and 3 blanks precede day 1.
           (assert (string= "1" (lut:text (nth 10 (lut:children days)))))
           (lut:emit day :activate)
           (assert (equal '(2024 2 29) (lut:calendar-date date)))
           (assert (lut:disposed-p popup))
           (assert (null (lut::overlays root))))
         (lut:focus root date)
         (lut:dispatch root (lut:make-event :kind :key :key :enter))
         (let ((popup (lut::picker-popup date)))
           (lut:dispatch root (lut:make-event :kind :key :key :escape))
           (assert (lut:disposed-p popup))
           (assert (eq date (lut:focused-widget root))))
         (lut:dispatch root (lut:make-event :kind :key :key :enter))
         (let ((popup (lut::picker-popup date)))
           (lut:dispose date)
           (assert (lut:disposed-p popup))
           (assert (null (lut::overlays root)))))
     (lut:dispose root)))
 (dolist (class '(lut:date-picker lut:time-picker))
   (assert (handler-case (progn (lut:make-widget class :calendar-date '(1900 2 29)) nil) (error () t))))
 t)

(defun polished-control-tests ()
 (let ((before (multiple-value-list (get-decoded-time))) (picker (lut:make-widget 'lut:date-picker))
       (after (multiple-value-list (get-decoded-time))))
   (assert (or (equal (lut:calendar-date picker) (list (sixth before) (fifth before) (fourth before)))
               (equal (lut:calendar-date picker) (list (sixth after) (fifth after) (fourth after)))))
   (lut:dispose picker))
 (let* ((root (lut:make-widget 'lut:window :width 500 :height 450 :ui-scale 2))
        (date (lut:add-child root (lut:make-widget 'lut:date-picker :calendar-date '(2026 10 31) :picker-field 2)))
        (time (lut:add-child root (lut:make-widget 'lut:time-picker :time-format :12-hour :clock-time '(0 30 0))))
        (search (lut:add-child root (lut:make-widget 'lut:search-control :text (make-string 200 :initial-element #\W)))))
   (unwind-protect
     (progn
       (lut:layout date 20 20 340 36) (lut:layout time 20 80 320 36) (lut:layout search 20 140 340 36)
       (flet ((click (w region &optional cancel)
                (let* ((field-width (lut::picker-field-width w))
                       (local (+ (* 3 field-width) (case region (:minus 12) (:plus 36) (:calendar 60) (:period 70))))
                       (px (* 2 (+ (lut:x w) local))) (py (* 2 (+ (lut:y w) 18))))
                  (lut:dispatch-device-event root (lut:make-event :kind :down :x px :y py))
                  (lut:dispatch-device-event root (lut:make-event :kind :up :x (if cancel 0 px) :y py)))))
         (click date :minus) (assert (equal '(2026 10 30) (lut:calendar-date date)))
         (assert (null (lut::picker-popup date)))
         (click date :plus) (assert (equal '(2026 10 31) (lut:calendar-date date)))
         (assert (null (lut::picker-popup date)))
         (click date :minus t) (assert (equal '(2026 10 31) (lut:calendar-date date)))
         (click date :calendar) (assert (lut::picker-popup date))
         (lut:dispatch root (lut:make-event :kind :key :key :escape))
         (assert (null (lut::picker-popup date)))
         (dotimes (field 3)
           (let ((px (* 2 (+ (lut:x date) (* (+ field 0.5) (lut::picker-field-width date)))))
                 (py (* 2 (+ (lut:y date) 18))))
             (lut:dispatch-device-event root (lut:make-event :kind :down :x px :y py))
             (lut:dispatch-device-event root (lut:make-event :kind :up :x px :y py))
             (assert (lut::picker-popup date))
             (assert (equal '(2026 10 31) (lut:calendar-date date)))
             (lut:dispatch root (lut:make-event :kind :key :key :escape))
             (assert (eq date (lut:focused-widget root)))))
         (assert (string= "12" (lut::picker-field-string time 0)))
         (click time :period) (assert (equal '(12 30 0) (lut:clock-time time)))
         (assert (= 3 (lut:picker-field time)))
         (lut:dispatch root (lut:make-event :kind :text :text "a"))
         (assert (equal '(0 30 0) (lut:clock-time time)))
         (lut:dispatch root (lut:make-event :kind :text :text "P"))
         (assert (equal '(12 30 0) (lut:clock-time time)))
         (setf (lut:picker-field time) 0)
         (lut:dispatch root (lut:make-event :kind :text :text "01"))
         (assert (equal '(13 30 0) (lut:clock-time time)))
         (assert (string= "01" (lut::picker-field-string time 0)))
         (setf (lut:picker-field time) 3 (lut:time-format time) :24-hour)
         (assert (= 0 (lut:picker-field time)))
         (assert (equal '(13 30 0) (lut:clock-time time)))
         (assert (string= "13" (lut::picker-field-string time 0))))
       (lut:focus root search) (setf (lut:cursor search) 200) (lut:reveal-text-cursor search)
       (multiple-value-bind (cx cy cw ch) (lut:text-caret-rectangle search)
         (declare (ignore cy ch))
         (multiple-value-bind (vx vy vw vh) (lut:scroll-viewport search)
           (declare (ignore vy vh)) (assert (<= vx cx (+ cx cw) (+ vx vw)))))
       (assert (zerop (lut:style-value date :button-depth))))
     (lut:dispose root))) t)
