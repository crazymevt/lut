(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/raylib" :silent t)
(defclass counted-font-window (lut:window) ())
(defclass counted-font-document (lut:wrapped-document-view) ())
(defvar *glyph-scans* 0)
(defvar *glyph-characters* 0)
(defvar *window-discoveries* 0)
(defmethod lut::scan-wrapped-codepoints :around ((view counted-font-document) root)
 (incf *glyph-scans*) (incf *glyph-characters* (lut::node-size root))
 (call-next-method))
(defmethod lut::discover-font-codepoints :around ((view counted-font-window))
 (incf *window-discoveries*) (call-next-method))
(defvar *glyph-set-builds* 0)
(defvar *glyph-set-build-characters* 0)
(defvar *font-membership-probes* 0)
(defvar *font-signature-characters* 0)
(defmethod lut::font-glyph-signature :around (codes)
 (incf *font-signature-characters* (length codes)) (call-next-method))
(defmethod lut::build-font-glyph-set :around (codes signature)
 (incf *glyph-set-builds*) (incf *glyph-set-build-characters* (length codes))
 (call-next-method))
(defmethod lut::font-glyph-member-p :around ((set lut::font-glyph-set) code)
 (incf *font-membership-probes*) (call-next-method))
(defun check-large-font-lookups (label)
 (let* ((*glyph-set-builds* 0) (*glyph-set-build-characters* 0) (*font-membership-probes* 0) (*font-signature-characters* 0)
        (codes (append (loop for code from 32 below 127 collect code)
                       (loop for code from #x4e00 below #x5e00 collect code)))
        (before (length lut::*font-cache*)) (base-font nil) (extra-font nil))
   ;; New list identities model fresh discovery in subsequent passes. Atlas and
   ;; membership-set identity must survive without rebuilding for each lookup.
   (dotimes (pass 3)
     (let ((lut::*font-discovery-pass* (make-hash-table :test #'eq))
           (lut::*font-codepoints-cache* (list (cons (lut::root-of label) (copy-list codes)))))
       (dotimes (i 20)
         (let ((font (lut::widget-font label "abc")))
           (if base-font (assert (eq base-font font)) (setf base-font font)))
         (assert (plusp (lut:text-width label "abc"))))
       (dotimes (i 10) (lut::map-text-run-advances label "abc" (lambda (advance) (assert (>= advance 0)))))
       ;; Missing-string glyphs extend the set once and reuse their atlas.
       (dotimes (i 20)
         (let ((font (lut::widget-font label "λ")))
           (if extra-font (assert (eq extra-font font)) (setf extra-font font))))
       (dotimes (i 10) (lut::map-text-run-advances label "λ" (lambda (advance) (assert (>= advance 0)))))
       (assert (equal codes (lut::font-glyph-set-codes
                             (lut::widget-glyph-set label "abc"))))))
   (assert (= 2 *glyph-set-builds*))
   (assert (= (+ (* 2 (length codes)) 1) *glyph-set-build-characters*))
   ;; Work in repeated lookups/runs is bounded by requested string length,
   ;; independent of the 4,191-code-point base set.
   (assert (<= *font-membership-probes* 1000))
   (assert (= (* 3 (+ (* 2 (length codes)) 1)) *font-signature-characters*))
   (assert (= 2 (- (length lut::*font-cache*) before)))
   (format t "Font lookup: 4096 CJK codes, 3 passes, two membership sets/atlases, and at most 1000 string-sized membership probes passed.~%")))
;; Exercise the distinct-code-point dimension separately from document length.
;; Discovery does not load fonts, so this does not require CJK font coverage.
(let* ((*glyph-scans* 0) (*glyph-characters* 0) (*window-discoveries* 0)
       (count 4096)
       (cjk (coerce (loop for code from #x4e00 below (+ #x4e00 count) collect (code-char code)) 'string))
       (expected (append (loop for code from 32 below 127 collect code)
                         (list (char-code #\λ))
                         (loop for code from #x4e00 below (+ #x4e00 count) collect code)))
       (root (lut:make-widget 'counted-font-window))
       (document (lut:add-child root (lut:make-widget 'counted-font-document :text cjk))))
 (unwind-protect
     (progn
       ;; Overlapping cached sets and ordinary text must merge without duplicates
       ;; or mutation of the retained per-view sets.
       (dotimes (i 4)
         (lut:add-child root (lut:make-widget 'lut:wrapped-document-view :text (reverse cjk))))
       (lut:add-child root (lut:make-widget 'lut:label :text (concatenate 'string cjk "λ" (string #\Newline))))
       (let ((cached (lut::wrapped-font-codepoints document)))
         (dotimes (pass 4)
           (assert (equal expected (lut::font-codepoints root))))
         (assert (= 1 *glyph-scans*))
         (assert (= count *glyph-characters*))
         (assert (eq cached (lut::wrapped-font-codepoints document)))
         (assert (equal cached (nthcdr 96 expected)))))
   (lut:dispose root)))
(format t "Font discovery: 4096 distinct CJK characters across overlapping views produce a sorted unique union over repeated passes without rescanning cached views.~%")
(let* ((size 65536)
       (root (lut:make-widget 'counted-font-window :width 500 :height 400 :content-layout :fill))
       (body (lut:add-child root (lut:make-widget 'lut:measured-box)))
       (document (lut:add-child body (lut:make-widget 'counted-font-document
                     :text (make-string size :initial-element #\a) :max-height 120 :hexpand t)))
       (label (lut:add-child body (lut:make-widget 'lut:label :text "Measured label")))
       (frame 0) (baseline nil) (pass-baseline nil) (checked nil))
 (dotimes (i 8) (lut:add-child body (lut:make-widget 'lut:label :text (format nil "Label ~d" i))))
 (lut:on root :tick (lambda (w dt)
   (declare (ignore dt))
   (case (incf frame)
     (2
       (assert (= 1 *glyph-scans*)) (assert (= size *glyph-characters*))
       (check-large-font-lookups label)
       ;; Several measurements and painters share one root discovery per pass.
       (let ((before *window-discoveries*))
         (lut:layout w 0 0 500 400)
         (assert (= 1 (- *window-discoveries* before))))
       (let ((before *window-discoveries*)
             (lut::*font-discovery-pass* (make-hash-table :test #'eq)))
         (dotimes (i 12) (lut:text-width label "repeat"))
         (assert (= 1 (- *window-discoveries* before))))
       (let ((before *window-discoveries*))
         (lut:layout w 0 0 450 400)
         (assert (= 1 (- *window-discoveries* before))))
       (assert (= 1 *glyph-scans*))
       (setf baseline *glyph-scans* pass-baseline *window-discoveries*))
     (3
       (assert (= 2 (- *window-discoveries* pass-baseline)))
       (setf pass-baseline *window-discoveries*))
     (4
       ;; Two complete unchanged layout/render frames perform no buffer scans.
       (assert (= 2 (- *window-discoveries* pass-baseline)))
       (assert (= baseline *glyph-scans*))
       (setf (lut:text document) (concatenate 'string (lut:text document) "λ"))
       (assert (member (char-code #\λ) (lut::font-codepoints label)))
       (assert (= (1+ baseline) *glyph-scans*))
       (assert (= (+ size (1+ size)) *glyph-characters*)))
     (5
       (assert (= (1+ baseline) *glyph-scans*))
       (lut:set-text-presentation document :runs '((:start 0 :end 3 :style (:font-size 22))))
       (lut::font-codepoints label)
       (assert (= (+ baseline 2) *glyph-scans*)))
     (6
       (assert (= (+ baseline 2) *glyph-scans*))
       ;; Removing a view must also change the next pass's window glyph set.
       (lut:remove-child body document)
       (assert (not (member (char-code #\λ) (lut::font-codepoints label))))
       (lut:dispose document)
       (assert (null (slot-value document 'lut::wrapped-codepoints-cache)))
       (setf checked t)))))
 (unwind-protect (progn (lut:run root :frames 6) (assert checked))
   (lut:dispose root) (unless (lut:disposed-p document) (lut:dispose document))))
(format t "Font discovery: 64K document scanned once across unchanged frames; one window discovery per pass; text/presentation invalidation, removal and disposal passed.~%")
