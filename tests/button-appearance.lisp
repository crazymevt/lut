(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/raylib" :silent t)
(loop for theme in (list lut:*light-theme* lut:*dark-theme*)
      for name in '("light" "dark") do
  (let* ((w (lut:make-widget 'lut:window :width 440 :height 440 :theme theme))
         (normal (lut:make-widget 'lut:button :text "Raised" :height 52))
         (hover (lut:make-widget 'lut:button :text "Hover" :height 52))
         (pressed (lut:make-widget 'lut:button :text "Depressed" :height 52))
         (disabled (lut:make-widget 'lut:button :text "Disabled" :height 52 :enabled-p nil))
         (selected (lut:make-widget 'lut:toggle-button :text "Selected toggle" :value t :height 52))
         (flat (lut:make-widget 'lut:button :text "Flat override" :height 52 :style '(:button-depth 0)))
         (path (format nil "/tmp/lut-buttons-~a.png" name)) (frame 0) (points nil))
    (dolist (control (list normal hover pressed disabled selected flat)) (lut:add-child w control))
    (lut:on w :tick (lambda (window dt)
      (declare (ignore window dt))
      (setf (lut::hovered-p hover) t (lut::pressed-p pressed) t)
      (assert (< (lut::button-caption-offset normal) 0))
      (assert (> (lut::button-caption-offset pressed) 0))
      (assert (> (lut::button-caption-offset selected) 0))
      (assert (zerop (lut::button-depth disabled)))
      (assert (zerop (lut::button-depth flat)))
      (when (= (incf frame) 3)
        (setf points
          (list (list (round (+ (lut:x normal) (/ (lut:width normal) 2))) (+ (round (lut:y normal)) 1))
                (list (round (+ (lut:x normal) (/ (lut:width normal) 2))) (- (round (+ (lut:y normal) (lut:height normal))) 1))
                (list (round (+ (lut:x pressed) (/ (lut:width pressed) 2))) (round (lut:y pressed)))))
        (rl:take-screenshot path))))
    (lut:run w :frames 4)
    (let ((image (rl:load-image path)))
      (unwind-protect
        (let ((pixels (loop for (x y) in points collect (rl:color-to-int (rl:get-image-color image x y)))))
          ;; Raised lower edge and depressed upper edge share a shadow;
          ;; the raised top highlight must visibly differ from that shadow.
          (assert (= (second pixels) (third pixels)))
          (assert (/= (first pixels) (third pixels))))
        (rl:unload-image image)))))
(format t "Button elevation, caption motion, flat/disabled states and edge pixels passed in both palettes.~%")
