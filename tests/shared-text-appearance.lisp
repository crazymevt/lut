(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/examples" :silent t)
(dolist (theme (list lut:*light-theme* lut:*dark-theme*))
 (let* ((root (lut-examples:shared-text)) (a (lut:find-widget root :first-view))
        (b (lut:find-widget root :second-view)) (buffer (lut:view-buffer a))
        (frame 0) (path "/tmp/lut-shared-text.png"))
   (setf (lut:theme root) theme)
   (lut:on root :tick (lambda (w dt)
     (declare (ignore w dt))
     (case (incf frame)
       (2
         (assert (eq buffer (lut:view-buffer b)))
         (lut:focus root a) (lut:select-all a)
         (lut:dispatch root (lut:make-event :kind :text :text "Updated shared text"))
         (assert (string= (lut:text a) (lut:text b)))
         (let* ((toggle (lut:find-widget root :peer-read-only))
                (x (+ (lut:x toggle) 10)) (y (+ (lut:y toggle) 10)))
           (lut:dispatch root (lut:make-event :kind :down :x x :y y))
           (lut:dispatch root (lut:make-event :kind :up :x x :y y))
           (assert (lut:value toggle)) (assert (lut:read-only-p b)))
         (lut:focus root b)
         (lut:dispatch root (lut:make-event :kind :text :text "blocked"))
         (assert (string= "Updated shared text" (lut:text buffer)))
         (let ((texture (rl:load-render-texture (round (lut:width root)) (round (lut:height root)))))
           (unwind-protect
             (progn
               (rl:with-texture-mode (texture)
                 (rl:clear-background (lut:style-value root :background)) (lut::render-window root))
               (let ((image (rl:load-image-from-texture (rl:render-texture-texture texture))))
                 (unwind-protect
                   (progn (rl:image-flip-vertical image) (assert (rl:export-image image path)))
                   (rl:unload-image image))))
             (rl:unload-render-texture texture))))
       (3
         (lut:focus root a) (lut:dispatch root (lut:make-event :kind :key :key :undo))
         (assert (search "Shared buffer" (lut:text b)))
         (lut:refresh-commands root)
         (assert (not (lut:enabled-p (lut:find-widget root :buffer-undo))))
         (assert (lut:enabled-p (lut:find-widget root :buffer-redo)))))))
   (unwind-protect
     (progn
       (lut:run root :frames 4)
       (let ((image (rl:load-image path)))
         (unwind-protect
           (dolist (view (list a b))
             (assert (loop for y from (ceiling (+ (lut:y view) 8)) below (floor (+ (lut:y view) 30))
                       thereis (loop for x from (ceiling (+ (lut:x view) 8)) below (floor (+ (lut:x view) 190))
                         thereis (= (rl:color-to-int (rl:get-image-color image x y))
                                    (rl:color-to-int (lut:style-value view :foreground)))))))
           (rl:unload-image image))))
     (lut:dispose root) (assert (null (lut::buffer-views buffer))) (lut:dispose buffer))))
(format t "Shared text rendering, read-only peer input, shared undo and command availability passed in both themes.~%")
