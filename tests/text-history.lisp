(in-package #:lut-tests)
(defclass guarded-history-view (lut:text-view) ((reject :initform nil :accessor reject-history-text)))
(defmethod lut:validate-slot :before ((view guarded-history-view) slot value)
 (when (and (eq slot 'lut:text) (equal value (reject-history-text view))) (error "Rejected history text")))
(defun history-view-state (view)
 (list (lut:text view) (lut:cursor view) (slot-value view 'lut::anchor)))
(defun standalone-history-tests ()
 ;; Differential oracle preserves the original snapshot selection contract:
 ;; undo captures the invoking selection for redo, including reversed ranges.
 (let ((view (lut:make-widget 'lut:text-view :text "αβγ" :history-limit 1000))
       (state (list "αβγ" 0 0)) (past nil) (future nil) (seed 75))
   (labels ((next (n) (setf seed (mod (+ (* seed 1664525) 1013904223) 4294967296)) (mod seed n))
            (check ()
              (assert (equal state (history-view-state view)))
              (assert (= (length past) (length (lut::undo-history view))))
              (assert (= (length future) (length (lut::redo-history view))))))
     (dotimes (i 300)
       (let* ((cursor (next (1+ (length (first state))))) (anchor (next (1+ (length (first state))))))
         (setf (lut:cursor view) cursor (slot-value view 'lut::anchor) anchor
               state (list (first state) cursor anchor)))
       (case (next 4)
         (0
          (let* ((new (concatenate 'string (subseq (first state) 0 (next (1+ (length (first state)))))
                                   (nth (next 4) '("" "λ" "xy" "😀")))))
            (unless (string= new (first state)) (push state past) (setf future nil))
            (setf state (list new (min (second state) (length new)) (min (third state) (length new))))
            (setf (lut:text view) new)))
         (1
          (let* ((a (min (second state) (third state))) (b (max (second state) (third state)))
                 (replacement (nth (next 4) '("" "λ" "xy" "😀")))
                 (new (concatenate 'string (subseq (first state) 0 a) replacement (subseq (first state) b))))
            (unless (string= new (first state)) (push state past) (setf future nil))
            (setf state (list new (+ a (length replacement)) (+ a (length replacement))))
            (lut:replace-selection view replacement)))
         (2 (if past
                (progn (push state future) (setf state (pop past)) (assert (lut:undo view)))
                (assert (not (lut:undo view)))))
         (3 (if future
                (progn (push state past) (setf state (pop future)) (assert (lut:redo view)))
                (assert (not (lut:redo view))))))
       (check))) (lut:dispose view))
 ;; Small edits in a large standalone view retain changed payloads, not snapshots.
 (let* ((original (make-string 1048576 :initial-element #\a))
        (view (lut:make-widget 'lut:text-view :text original :history-character-limit 16)))
   (dotimes (i 12)
     (setf (lut:cursor view) (+ 100 i) (slot-value view 'lut::anchor) (+ 100 i))
     (lut:replace-selection view "λ"))
   (assert (= 12 (length (lut::undo-history view))))
   (assert (= 12 (reduce #'+ (lut::undo-history view) :key #'lut::buffer-history-characters)))
   (dotimes (i 12) (assert (lut:undo view)))
   (assert (string= original (lut:text view)))
   (dotimes (i 12) (assert (lut:redo view)))
   (assert (= (+ 12 (length original)) (lut:text-length view)))
   (lut:dispose view)
   (assert (null (lut::undo-history view))) (assert (null (lut::redo-history view))))
 ;; Replacing reversed selections restores the original direction. No-op edits
 ;; collapse the selection without adding history or discarding redo.
 (let ((view (lut:make-widget 'lut:text-view :text "αβγδε")))
   (setf (lut:cursor view) 1 (slot-value view 'lut::anchor) 4)
   (lut:replace-selection view "λ")
   (assert (equal '("αλε" 2 2) (history-view-state view)))
   (assert (lut:undo view)) (assert (equal '("αβγδε" 1 4) (history-view-state view)))
   (setf (lut:cursor view) 2 (slot-value view 'lut::anchor) 1)
   (lut:replace-selection view "β")
   (assert (equal '("αβγδε" 2 2) (history-view-state view)))
   (assert (lut:can-redo-p view)) (assert (lut:redo view))
   (assert (equal '("αλε" 2 2) (history-view-state view)))
   (setf (lut:read-only-p view) t) (assert (not (lut:undo view)))
   (lut:dispose view))
 ;; Validation failure must preserve text, selection and both stacks on edits,
 ;; undo and redo. Programmatic SETF still clamps selections as before.
 (let ((view (lut:make-widget 'guarded-history-view :text "abcdef" :cursor 5)))
   (setf (slot-value view 'lut::anchor) 2 (lut:text view) "ab")
   (assert (equal '("ab" 2 2) (history-view-state view)))
   (setf (reject-history-text view) "abcdef")
   (let ((past (lut::undo-history view)))
     (assert (handler-case (progn (lut:undo view) nil) (error () t)))
     (assert (eq past (lut::undo-history view)))
     (assert (equal '("ab" 2 2) (history-view-state view))))
   (setf (reject-history-text view) nil) (assert (lut:undo view))
   (assert (equal '("abcdef" 5 2) (history-view-state view)))
   (setf (reject-history-text view) "ab")
   (let ((future (lut::redo-history view)))
     (assert (handler-case (progn (lut:redo view) nil) (error () t)))
     (assert (eq future (lut::redo-history view)))
     (assert (handler-case (progn (setf (lut:text view) "ab") nil) (error () t)))
     (assert (eq future (lut::redo-history view)))
     (assert (null (lut::undo-history view))))
   (setf (reject-history-text view) nil (lut:text view) "new")
   (assert (not (lut:can-redo-p view))) (lut:dispose view))
 ;; Undo's change callbacks record follow-up edits normally (no leaked history
 ;; suppression or pending selection from the inverse operation).
 (let ((view (lut:make-widget 'lut:text-view :text "a")))
   (setf (lut:text view) "ab")
   (lut:on view :change (lambda (w text) (when (string= text "a") (setf (lut:text w) "ac"))))
   (assert (lut:undo view)) (assert (string= "ac" (lut:text view)))
   (assert (lut:can-undo-p view)) (assert (not (lut:can-redo-p view)))
   (lut:dispose view))
 (history-overflow-tests)
 (format t "Standalone range history, snapshot-oracle selections, large text, failed validation and budget feedback passed.~%"))
(defun history-overflow-tests ()
 ;; Model and standalone owners report oversized committed records identically.
 (dolist (shared '(nil t))
   (let* ((owner (if shared (lut:make-text-buffer :text "a" :history-character-limit 4)
                    (lut:make-widget 'lut:text-view :text "a" :history-character-limit 4)))
          (view (if shared (lut:make-widget 'lut:text-view :view-buffer owner) owner)) (events nil))
     (lut:on owner :history-overflow (lambda (w payload)
       (assert (eq w owner)) (assert (string= "a123456" (lut:text w)))
       (assert (not (lut:can-undo-p w))) (assert (not (lut:can-redo-p w)))
       (assert (= 7 (lut:cursor view))) (push payload events)))
     (setf (lut:cursor view) 1 (slot-value view 'lut::anchor) 1)
     (lut:replace-selection view "1") (assert (null events))
     (setf (lut:cursor view) 2 (slot-value view 'lut::anchor) 2)
     (lut:replace-selection view "2345") ; exactly the budget; older record evicted
     (assert (null events)) (assert (= 1 (length (lut::undo-history owner))))
     (lut:undo view)
     (setf (lut:cursor view) 2 (slot-value view 'lut::anchor) 2)
     (lut:replace-selection view "23456")
     (assert (equal '((:operation :edit :stack :undo :characters 5 :limit 4)) events))
     (dolist (limits '((0 4) (10 0)))
       (setf (lut:history-limit owner) (first limits) (lut:history-character-limit owner) (second limits))
       (lut:replace-selection view "oversized but intentionally disabled")
       (assert (= 1 (length events))))
     (lut:dispose view) (unless (eq owner view) (lut:dispose owner))))
 ;; Replacement budgets count both sides. No-op and read-only attempts do
 ;; not report overflow, and programmatic standalone setters keep their original
 ;; no-CHANGE behavior even when they emit overflow feedback.
 (dolist (shared '(nil t))
   (let* ((owner (if shared (lut:make-text-buffer :text "a" :history-character-limit 1)
                    (lut:make-widget 'lut:text-view :text "a" :history-character-limit 1)))
          (view (if shared (lut:make-widget 'lut:text-view :view-buffer owner) owner))
          (events nil) (changes 0))
     (lut:on owner :history-overflow (lambda (w p) (declare (ignore w)) (push p events)))
     (lut:on owner :change (lambda (w p) (declare (ignore w p)) (incf changes)))
     (setf (lut:text owner) "b")
     (assert (equal '((:operation :edit :stack :undo :characters 2 :limit 1)) events))
     (assert (= changes (if shared 1 0)))
     (lut:select-all view) (lut:replace-selection view "b")
     (setf (lut:read-only-p view) t) (lut:replace-selection view "oversized")
     (assert (= 1 (length events)))
     (lut:dispose view) (unless (eq owner view) (lut:dispose owner))))
 (let ((view (lut:make-widget 'guarded-history-view :text "a" :history-character-limit 1)) (events 0))
   (setf (reject-history-text view) "oversized")
   (lut:on view :history-overflow (lambda (w p) (declare (ignore w p)) (incf events)))
   (assert (handler-case (progn (setf (lut:text view) "oversized") nil) (error () t)))
   (assert (zerop events)) (assert (string= "a" (lut:text view))) (lut:dispose view))
 ;; Lowering a budget can prevent an inverse from entering its destination stack.
 (dolist (shared '(nil t))
   (dolist (direction '(:undo :redo))
     (let* ((owner (if shared (lut:make-text-buffer :history-character-limit 10)
                      (lut:make-widget 'lut:text-view :history-character-limit 10)))
            (view (if shared (lut:make-widget 'lut:text-view :view-buffer owner) owner)) (events nil))
       (lut:replace-selection view "abcd")
       (when (eq direction :redo) (lut:undo view))
       (setf (lut:history-character-limit owner) 2)
       (lut:on owner :history-overflow (lambda (w payload) (declare (ignore w)) (push payload events)))
       (assert (if (eq direction :undo) (lut:undo view) (lut:redo view)))
       (assert (equal (list (list :operation direction :stack (if (eq direction :undo) :redo :undo)
                                 :characters 4 :limit 2)) events))
       (assert (not (lut:can-undo-p view))) (assert (not (lut:can-redo-p view)))
       (lut:dispose view) (unless (eq owner view) (lut:dispose owner)))))
 ;; Feedback captures the budget used for retention even if change observers
 ;; adjust it. Callback errors leave committed text/history and release guards.
 (let* ((buffer (lut:make-text-buffer :history-character-limit 2)) (events nil))
   (lut:on buffer :change (lambda (w text) (declare (ignore text)) (setf (lut:history-character-limit w) 100)))
   (lut:on buffer :history-overflow (lambda (w payload) (declare (ignore w)) (push payload events)))
   (lut:replace-buffer-range buffer 0 0 "abc")
   (assert (equal '((:operation :edit :stack :undo :characters 3 :limit 2)) events))
   (lut:dispose buffer))
 (dolist (shared '(nil t))
   (let* ((owner (if shared (lut:make-text-buffer :history-character-limit 1)
                    (lut:make-widget 'lut:text-view :history-character-limit 1)))
          (view (if shared (lut:make-widget 'lut:text-view :view-buffer owner) owner)))
     (lut:on owner :history-overflow (lambda (w payload) (declare (ignore w payload)) (error "Feedback failure")))
     (assert (handler-case (progn (lut:replace-selection view "abc") nil) (error () t)))
     (assert (string= "abc" (lut:text owner))) (assert (not (lut:can-undo-p owner)))
     (when shared (assert (not (lut::buffer-notifying-p owner))))
     (lut:off owner :history-overflow)
     (lut:replace-selection view "d") (assert (lut:can-undo-p owner))
     (lut:dispose view) (unless (eq owner view) (lut:dispose owner)))))
