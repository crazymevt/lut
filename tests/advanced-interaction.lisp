(in-package #:lut-tests)
(defun advanced-books ()
 (let* ((controller (lut:make-drag-controller))
        (a (lut:make-widget 'lut:window :width 400 :height 250))
        (b (lut:make-widget 'lut:window :width 400 :height 250 :ui-scale 2))
        (left (lut:add-child a (lut:make-widget 'lut:notebook :width 400 :height 250 :reorderable-p t :closable-p t :tab-group :test :items '("A" "B"))))
        (right (lut:add-child b (lut:make-widget 'lut:notebook :width 400 :height 250 :reorderable-p t :tab-group :test :items '("C"))))
        (page (lut:add-child left (lut:make-widget 'lut:label :text "First" :tab-badge "3"))))
   (lut:add-child left (lut:make-widget 'lut:label :text "Second"))
   (lut:add-child right (lut:make-widget 'lut:label :text "Third"))
   (lut:register-drag-window controller a) (lut:register-drag-window controller b)
   (values controller a b left right page)))
(defun advanced-close-tests ()
 (multiple-value-bind (controller a b book target page) (advanced-books)
   (declare (ignore target))
   (let ((requests 0) (closed 0)
         (connection (lut:on book :page-close-request (lambda (w request) (declare (ignore w))
           (assert (eq page (lut:close-request-page request)))
           (setf (lut:close-request-veto-p request) t)))))
     (lut:on book :page-closed (lambda (w request) (declare (ignore w request)) (incf closed)))
     (lut:on book :page-close-request (lambda (w request) (declare (ignore w request)) (incf requests)))
     (assert (null (lut:request-page-close book page)))
     (assert (eq book (lut:parent page))) (assert (= 1 requests)) (assert (zerop closed))
     (lut:off book :page-close-request connection)
     (lut:select-page book 1)
     (assert (lut:request-page-close book page))
     (assert (zerop (lut:value book))) (assert (equal '("B") (lut:items book)))
     (assert (null (lut:parent page))) (assert (not (lut:disposed-p page)))
     (assert (string= "3" (lut:tab-badge page))) (assert (= 1 closed))
     ;; Pointer close affordance must cancel the armed tab drag, even after veto.
     (let ((remaining (first (lut:children book))))
       (lut:dispatch a (lut:make-event :kind :down :x 390 :y 10))
       (assert (null (lut:current-drag a))) (assert (null (lut:parent remaining)))
       (assert (null (lut:children book))) (assert (null (lut:items book)))
       (lut:dispose remaining)))
   (lut:dispose page) (assert (null (lut:tab-badge page)))
   (lut:dispose controller) (lut:dispose a) (lut:dispose b)))
(defun advanced-transfer-tests ()
 (multiple-value-bind (controller a b left right page) (advanced-books)
   (let ((entry (lut:add-child page (lut:make-widget 'lut:entry :text "Focused child"))))
     (lut:focus a entry))
   (let ((events nil) (session nil))
     (dolist (kind '(:drag-start :drag-end))
       (let ((kind kind)) (lut:on left kind (lambda (w s) (declare (ignore w)) (push (list kind (lut:drag-state s)) events)))))
     (lut:dispatch a (lut:make-event :kind :down :x 20 :y 10))
     (setf session (lut:current-drag a)) (assert session)
     ;; Device-to-logical conversion occurs independently for each receiving window.
     (lut:dispatch-device-event b (lut:make-event :kind :move :x 600 :y 20))
     (assert (eq :dragging (lut:drag-state session))) (assert (eq right (lut:drag-target session)))
     (lut:dispatch-device-event b (lut:make-event :kind :up :x 600 :y 20))
     (assert (eq right (lut:parent page))) (assert (string= "3" (lut:tab-badge page)))
     (assert (equal '("B") (lut:items left))) (assert (equal '("C" "A") (lut:items right)))
     (assert (eq :dropped (lut:drag-state session)))
     (assert (equal '((:drag-end :dropped) (:drag-start :dragging)) events))
     (assert (null (lut:drag-source session))) (assert (null (lut:drag-target session)))
     (assert (null (lut:drag-payload session))) (assert (null (lut:current-drag a))))
   ;; A direct transfer requires matching explicit registration, irrespective of tab groups.
   (lut:unregister-drag-window controller b)
   (assert (handler-case (progn (lut:move-page right page left 0) nil) (error () t)))
   (lut:register-drag-window controller b)
   (let ((session (lut:begin-keyboard-drag right (lut::make-notebook-tab :source right :page page))))
     (lut:keyboard-drag-to b left 20 10)
     (assert (eq left (lut:drag-target session)))
     (lut:remove-child a left) ; removing a peer target cancels the source session
     (assert (eq :cancelled (lut:drag-state session))) (assert (null (lut:current-drag b)))
     (assert (null (lut:drag-payload session))) (lut:dispose left))
   (lut:dispose controller)
   (assert (null (lut:window-drag-controller a))) (assert (null (lut:window-drag-controller b)))
   (lut:dispose a) (lut:dispose b)))
(defun advanced-keyboard-tests ()
 (let* ((root (lut:make-widget 'lut:window :width 500 :height 300))
        (source (lut:add-child root (lut:make-widget 'lut:button :x 0 :y 0 :width 80 :height 30)))
        (count 0)
        (zone (lut:add-child root (lut:make-widget 'lut:drop-zone :x 100 :y 100 :width 200 :height 100
          :drop-predicate (lambda (w s e) (declare (ignore w e)) (eq :payload (lut:drag-payload s)))
          :drop-function (lambda (w s e) (declare (ignore w s e)) (incf count)))))
        (session (lut:begin-keyboard-drag source :payload)))
   (lut:dispatch root (lut:make-event :kind :key :key :tab))
   (assert (eq zone (lut:drag-target session)))
   ;; Native backends poll pointer movement every frame; it must not retarget a keyboard drag.
   (lut:dispatch root (lut:make-event :kind :move :x 0 :y 0))
   (assert (eq zone (lut:drag-target session)))
   (lut:dispatch root (lut:make-event :kind :key :key :enter))
   (assert (= 1 count)) (assert (eq :dropped (lut:drag-state session)))
   (let ((next (lut:begin-keyboard-drag source :payload)))
     (lut:keyboard-drag-to root zone)
     (lut:dispatch root (lut:make-event :kind :key :key :escape))
     (assert (eq :cancelled (lut:drag-state next))) (assert (= 1 count)))
   ;; Commit failures propagate after terminal callbacks and reference cleanup.
   (setf (lut:drop-function zone) (lambda (&rest args) (declare (ignore args)) (error "commit failed")))
   (let ((next (lut:begin-keyboard-drag source :payload)))
     (lut:keyboard-drag-to root zone)
     (assert (handler-case (progn (lut:dispatch root (lut:make-event :kind :key :key :enter)) nil) (error () t)))
     (assert (null (lut:current-drag root))) (assert (null (lut:drag-payload next))))
   (lut:dispose root) (assert (null (lut:drop-function zone))) (assert (null (lut:drop-predicate zone)))))
(defun advanced-autoscroll-tests ()
 (let* ((root (lut:make-widget 'lut:window :width 400 :height 300))
        (source (lut:add-child root (lut:make-widget 'lut:button :x 250 :y 0 :width 100 :height 30)))
        (view (lut:add-child root (lut:make-widget 'lut:scroll-view :x 0 :y 50 :width 200 :height 100)))
        (zone (lut:add-child view (lut:make-widget 'lut:drop-zone :height 1000
          :drop-predicate (lambda (&rest args) (declare (ignore args)) t))))
        (session (lut:begin-keyboard-drag source :payload)))
   (lut:layout view 0 50 200 100)
   (lut:keyboard-drag-to root zone 50 145)
   (assert (lut:advance-drag root 1/10))
   (assert (= 30 (lut:scroll-offset view)))
   (lut:advance-drag root 100) (assert (= (lut::scroll-range view) (lut:scroll-offset view)))
   (assert (null (lut:advance-drag root 0)))
   (setf (lut:visible-p source) nil)
   (lut:advance-drag root 1/10) (assert (eq :cancelled (lut:drag-state session)))
   (lut:dispose root)))
(defun advanced-split-tests ()
 (dolist (edge '(:left :right :top :bottom))
   (let* ((root (lut:make-widget 'lut:window))
          (a (lut:add-child root (lut:make-widget 'lut:label :text "A")))
          (b (lut:add-child root (lut:make-widget 'lut:label :text "B")))
          (pane (lut:split-drop a b edge :ratio 1/3)))
     (assert (equal (list pane) (lut:children root)))
     (assert (equal (if (member edge '(:left :top)) (list b a) (list a b)) (lut:children pane)))
     (assert (= 1/3 (lut:value pane)))
     (assert (eq (if (member edge '(:left :right)) :horizontal :vertical) (lut:orientation pane)))
     (assert (handler-case (progn (lut:split-drop a pane edge) nil) (error () t)))
     (lut:dispose root)))
 (let* ((root (lut:make-widget 'lut:window :width 400 :height 200))
        (source (lut:add-child root (lut:make-widget 'lut:label :width 80 :height 30)))
        (zone (lut:add-child root (lut:make-widget 'lut:split-drop-zone :x 100 :y 50 :width 200 :height 100)))
        (session (lut:begin-keyboard-drag source source)))
   (lut:keyboard-drag-to root zone)
   (lut:dispatch root (lut:make-event :kind :key :key :enter))
   (assert (eq :dropped (lut:drag-state session)))
   (assert (typep (lut:parent source) 'lut:paned))
   (assert (eq (lut:parent source) (lut:parent zone))) (lut:dispose root)))
(defun advanced-os-drop-tests ()
 (let* ((root (lut:make-widget 'lut:window :width 400 :height 200)) (retained nil) (count 0)
        (zone (lut:add-child root (lut:make-widget 'lut:drop-zone :width 300 :height 200
          :drop-predicate (lambda (w s e) (declare (ignore w e))
            (let ((p (lut:drag-payload s)))
              (and (typep p 'lut:os-drop) (string= "application/x-lut-file-path-list" (lut:os-drop-mime p)))))
          :drop-function (lambda (w s e) (declare (ignore w e))
            (assert (equal '("/tmp/α.txt" "/tmp/b.txt") (lut:os-drop-data (lut:drag-payload s))))
            (setf retained s) (incf count))))))
   (assert (lut:dispatch-os-drop root "application/x-lut-file-path-list" '("/tmp/α.txt" "/tmp/b.txt") 10 10))
   (assert (= 1 count)) (assert (null (lut:drag-payload retained)))
   (assert (null (lut:dispatch-os-drop root "text/plain" "unsupported" 10 10)))
   (setf (lut:enabled-p zone) nil)
   (assert (null (lut:dispatch-os-drop root "application/x-lut-file-path-list" '("/tmp/α.txt" "/tmp/b.txt") 10 10)))
   (assert (= 1 count)) (lut:dispose root)))
(defun advanced-controller-lifetime-tests ()
 (multiple-value-bind (controller a b left right page) (advanced-books)
   (declare (ignore page))
   (let ((first (lut:begin-keyboard-drag left :one)) (second nil))
     (setf second (lut:begin-keyboard-drag right :two))
     (assert (eq :cancelled (lut:drag-state first))) (assert (null (lut:drag-payload first)))
     (lut:on right :drag-end (lambda (w s) (declare (ignore w s)) (error "terminal callback failure")))
     (assert (handler-case (progn (lut:dispose controller) nil) (error () t)))
     (assert (lut:disposed-p controller)) (assert (null (lut::drag-windows controller)))
     (assert (null (lut:window-drag-controller a))) (assert (null (lut:window-drag-controller b)))
     (assert (null (lut:drag-payload second))) (assert (null (lut:current-drag b))))
   (lut:dispose a) (lut:dispose b)))
(defun advanced-transfer-focus-tests ()
 (multiple-value-bind (controller a b book target page) (advanced-books)
   (let ((entry (lut:add-child page (lut:make-widget 'lut:entry :text "Focused child"))))
     (lut:focus a entry) (lut:move-page book page target 0)
     (assert (null (lut:focused-widget a))) (assert (eq entry (lut:focused-widget b))))
   (lut:dispose controller) (lut:dispose a) (lut:dispose b)))
(defun advanced-close-error-tests ()
 (multiple-value-bind (controller a b book target page) (advanced-books)
   (declare (ignore target))
   (let ((callback (lut:on book :page-close-request
                     (lambda (w r) (declare (ignore w r)) (error "application close failure")))))
     (assert (handler-case (progn (lut:request-page-close book page) nil) (error () t)))
     (assert (eq book (lut:parent page))) (assert (equal '("A" "B") (lut:items book)))
     (lut:off book :page-close-request callback))
   (lut:dispose controller) (lut:dispose a) (lut:dispose b)))
(defun advanced-interaction-tests ()
 (advanced-close-tests) (advanced-close-error-tests) (advanced-controller-lifetime-tests) (advanced-transfer-tests) (advanced-keyboard-tests) (advanced-transfer-focus-tests)
 (advanced-autoscroll-tests) (advanced-split-tests) (advanced-os-drop-tests)
 (format t "Advanced tab closing/badges, controller transfer, keyboard dragging, stationary autoscroll, split zones and OS adapter delivery passed.~%"))
