(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/examples")
(let ((w (lut-examples:gallery)) (frame 0))
  (lut:on w :tick (lambda (w dt) (declare (ignore w dt))
    (when (= (incf frame) 3) (rl:take-screenshot "/tmp/lut-gallery.png"))))
  (lut:run w :frames 4))
