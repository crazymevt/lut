(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/gtk-demo" :silent t)
(assert (equal (lut-gtk-demo:demo-names) (lut-gtk-demo::fuzzy-demo-names "")))
(assert (equal (lut-gtk-demo:demo-names) (lut-gtk-demo::fuzzy-demo-names "  ")))
(assert (string= "combobox" (first (lut-gtk-demo::fuzzy-demo-names "CBX"))))
(assert (string= "font_features" (first (lut-gtk-demo::fuzzy-demo-names "font feat"))))
(assert (string= "listview_filebrowser" (first (lut-gtk-demo::fuzzy-demo-names "lvfb"))))
(assert (string= "stack" (first (lut-gtk-demo::fuzzy-demo-names "stack"))))
(assert (< (lut-gtk-demo::demo-match-score "combo" "combobox")
           (lut-gtk-demo::demo-match-score "combo" "xxx_combo")))
(assert (< (lut-gtk-demo::demo-match-score "cbx" "combobox")
           (lut-gtk-demo::demo-match-score "cbx" "c_long_b_long_x")))
(assert (null (lut-gtk-demo::fuzzy-demo-names "zzzzzzzz")))
(let* ((root (lut-gtk-demo:browser)) (query (lut:find-widget root :query))
       (list (lut:find-widget root :demos)) (info (lut:find-widget root :description)))
  (unwind-protect
    (progn
      (setf (lut:scroll-offset list) 200)
      (lut:emit query :change "cbx")
      (assert (string= "combobox" (first (lut:items list))))
      (assert (zerop (lut:value list))) (assert (zerop (lut:scroll-offset list)))
      (assert (plusp (length (lut:text info))))
      (lut:emit query :change "zzzzzzzz")
      (assert (null (lut:items list))) (assert (null (lut:value list)))
      (assert (search "No demos match" (lut:text info)))
      (lut:emit (lut:find-widget root :run) :activate nil)
      (lut:emit query :activate nil)
      (lut:emit query :change "")
      (assert (equal (lut:items list) (lut-gtk-demo:demo-names))))
    (lut:dispose root)))
(format t "Fuzzy matching, ranking, case/separators, reset and no-match launcher checks passed.~%")
