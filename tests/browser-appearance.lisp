(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload '("lut/raylib" "lut/gtk-demo") :silent t)
;; Tall controls resolve both surface and focus geometry to an eight-pixel cap.
(dolist (class '(lut:text-view lut:notebook lut:expander lut:button lut:list-view))
  (let ((control (lut:make-widget class :width 500 :height 380)))
    (assert (= (* 190 (lut::resolved-roundness control)) 8))
    (assert (= (* 189 (lut::resolved-roundness control 498 378)) 8))))
;; A small pill retains full roundness; larger pills can explicitly raise the cap.
(let ((control (lut:make-widget 'lut:button :width 100 :height 16
                               :style '(:border-radius 1))))
  (assert (= (lut::resolved-roundness control) 1))
  (setf (lut:style control) '(:border-radius 1 :max-border-radius 30))
  (assert (= (lut::resolved-roundness control 200 60) 1)))
(assert (handler-case (progn (lut::validate-style '(:max-border-radius -1)) nil)
          (error () t)))
(let* ((w (lut-gtk-demo:browser))
       (list (lut:find-widget w :demos))
       (info (lut:find-widget w :description))
       (index (position "clipboard" (lut:items list) :test #'string=))
       (frame 0) (selection-top nil))
  (assert index)
  (lut:focus w list)
  (setf (lut:value list) index)
  (lut:emit list :change index)
  (assert (lut::style-value info :wrap-text))
  (lut:on w :tick (lambda (window dt)
    (declare (ignore window dt))
    (when (= (incf frame) 3)
      (assert (<= (+ (lut:y (lut:find-widget w :run))
                     (lut:height (lut:find-widget w :run))) (lut:height w)))
      (let ((lines (lut::wrapped-label-lines info)))
        (assert (>= (length lines) 2))
        (assert (every (lambda (line)
                         (<= (lut:text-width info line)
                             (- (lut:width info) (* 2 (lut::style-value info :padding)))))
                       lines))
        (assert (<= (+ (* (length lines) (lut::line-height info))
                       (* 2 (lut::style-value info :padding))) (lut:height info))))
      (setf selection-top (+ (lut:y list) (* index (lut::row-height list))))
      (assert (= (- (lut::row-text-y list selection-top) selection-top) 6))
      (rl:take-screenshot "/tmp/lut-browser.png"))))
  (lut:run w :frames 4)
  ;; White text pixels inside the blue selection prove :on-accent is used.
  (let ((image (rl:load-image "/tmp/lut-browser.png")))
    (unwind-protect
      (assert (loop for y from (+ (round selection-top) 6) below (+ (round selection-top) 24)
                    thereis (loop for x from 16 below 80 thereis
                              (= (rl:color-to-int (rl:get-image-color image x y))
                                 (rl:color-to-int '(255 255 255 255))))))
      (rl:unload-image image))))
(format t "Demo browser rendering and button bounds passed.~%")
;; Exercise the table-specific renderer with the same selection treatment.
(dolist (theme (list lut:*light-theme* lut:*dark-theme*))
  (let* ((w (lut:make-widget 'lut:window :width 400 :height 240 :theme theme))
         (table (lut:make-widget 'lut:table-view :height 200 :columns '("Name" "Value")
                                :rows '(("Selected" "One") ("Other" "Two")) :value 0)))
    (lut:add-child w table)
    (lut:focus w table)
    (lut:run w :frames 3)))
(format t "Table selection rendering passed in both palettes.~%")
