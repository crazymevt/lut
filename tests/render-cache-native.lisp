;;;; Standalone native cache contract: no application or widget tree required.
(require :asdf)
(asdf:load-asd (merge-pathnames "../lut.asd" *load-truename*))
(ql:quickload "lut/render-cache")

(defun cache-test-capture (painter scale)
  (let ((image nil))
    (rl:with-drawing (:black)
      (lut:call-with-render-transform painter :scale scale)
      (cffi:foreign-funcall "rlDrawRenderBatchActive" :void)
      (setf image (rl:load-image-from-screen)))
    image))

(defun cache-test-pixels (image)
  (loop for i below (* 4 (rl:image-width image) (rl:image-height image))
        collect (cffi:mem-aref (rl:image-data image) :unsigned-char i)))

(defun cache-test-parity (cache id box painter scale background)
  (let ((direct (cache-test-capture painter scale)))
    (unwind-protect
         (progn
           (lut:update-cached-region cache id box (list scale background) painter
                                    :scale scale :background background)
           (let ((cached (cache-test-capture (lambda () (lut:draw-cached-region cache id)) scale)))
             (unwind-protect
                  (let ((different (count nil (mapcar #'= (cache-test-pixels direct)
                                                        (cache-test-pixels cached)))))
                    (format t "~a, scale ~a: ~d differing pixel channels.~%" id scale different)
                    (assert (zerop different)))
               (rl:unload-image cached))))
      (rl:unload-image direct))))

(defun cache-test-invalidation (cache)
  (let ((box '(10 10 40 40)) (calls 0))
    (flet ((paint () (incf calls) (rl:draw-rectangle 10 10 40 40 :red)))
      (lut:update-cached-region cache :a box 1 #'paint)
      (lut:update-cached-region cache :b box 1 #'paint)
      (lut:update-cached-region cache :a box 1 #'paint)
      (assert (= 2 calls))
      (lut:invalidate-render-cache cache :a)
      (lut:update-cached-region cache :a box 1 #'paint)
      (lut:update-cached-region cache :b box 1 #'paint)
      (assert (= 3 calls))
      (lut:invalidate-render-cache cache)
      (lut:update-cached-region cache :b box 1 #'paint)
      (assert (= 4 calls))
      (let ((failed nil))
        (handler-case
            (lut:update-cached-region cache :a box 2 (lambda () (error "paint failure")))
          (error () (setf failed t)))
        (assert failed)
        (rl:with-drawing (:black) (assert (not (lut:draw-cached-region cache :a)))))
      (lut:update-cached-region cache :a box 2 #'paint)
      (assert (= 5 calls))
      (assert (= 2 (lut:render-cache-paint-count cache :b)))
      (lut:update-cached-region cache :b '(10 10 0 40) 1 #'paint)
      (rl:with-drawing (:black) (assert (not (lut:draw-cached-region cache :b)))))))

(let ((done nil))
  (rl:run
   (lambda ()
     (rl:with-window (640 360 "LUT panel cache check" :exit-key nil :flags '(:window-highdpi))
       (let ((cache (lut:make-render-cache)))
         (unwind-protect
              (progn
                (dolist (scale '(1 13/10 3/2))
                  (cache-test-parity cache :clipping '(53 41 160 100)
                    (lambda ()
                      (lut:with-ui-scissor (53 41 160 100)
                        (rl:draw-rectangle 53 41 160 100 :blue)
                        (rl:draw-rectangle 63 51 30 20 :red)
                        (lut:with-ui-scissor (100 80 40 30)
                          (rl:draw-rectangle 90 70 80 70 :green)))) scale :black))
                (cache-test-parity cache :alpha '(20 20 40 40)
                  (lambda () (rl:draw-rectangle 20 20 40 40 (rl:color 255 0 0 128))) 1 :blank)
                (cache-test-invalidation cache))
           (lut:dispose cache))
         (assert (lut:disposed-p cache))
         (lut:dispose cache)))
     (setf done t)) :wait t)
  (assert done))
