(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/raylib" :silent t)
(defun list-scrollbar-pixel (image x y scale)
 (logand #xffffffff (rl:color-to-int (rl:get-image-color image (floor (* x scale)) (floor (* y scale))))))
(dolist (theme (list lut:*light-theme* lut:*dark-theme*))
 (dolist (scale '(1 5/4 2))
   (let* ((root (lut:make-widget 'lut:window :width 240 :height 160 :content-layout :fill :theme theme :ui-scale scale))
          (view (lut:add-child root (lut:make-widget 'lut:list-view :value 0
                     :items (loop repeat 30 collect "A deliberately long label that reaches the scrollbar strip"))))
          (checked nil))
     (lut:on root :tick (lambda (w dt)
       (declare (ignore dt))
       (unless checked
         (setf checked t)
         (lut:layout w 0 0 240 160)
         (let ((texture (rl:load-render-texture (round (* scale 240)) (round (* scale 160)))))
           (unwind-protect
             (labels ((capture-check (at-bottom &optional fitted)
                        (rl:with-texture-mode (texture)
                          (rl:clear-background (lut:style-value root :background)) (lut::render-window root))
                        (let ((image (rl:load-image-from-texture (rl:render-texture-texture texture))))
                          (unwind-protect
                            (progn
                              (rl:image-flip-vertical image)
                              (multiple-value-bind (sx sy sw sh travel) (lut::scrollbar-bounds view)
                                (declare (ignore travel))
                                (let ((x (+ sx (/ sw 2)))
                                      (surface (logand #xffffffff (rl:color-to-int (lut:style-value view :surface))))
                                      (thumb (logand #xffffffff (rl:color-to-int (lut:style-value view :border-color)))))
                                  (if fitted
                                      (assert (= surface (list-scrollbar-pixel image x 100 scale)))
                                      (progn
                                        (assert (= thumb (list-scrollbar-pixel image x (+ sy (/ sh 2)) scale)))
                                        (assert (= surface (list-scrollbar-pixel image x (if at-bottom 5 150) scale))))))))
                            (rl:unload-image image)))))
               (capture-check nil)
               (multiple-value-bind (sx sy sw sh) (lut::scrollbar-bounds view)
                 (let ((x (* scale (+ sx (/ sw 2)))) (y (* scale (+ sy (/ sh 2)))))
                   (lut:dispatch-device-event root (lut:make-event :kind :down :x x :y y))
                   (lut:dispatch-device-event root (lut:make-event :kind :move :x x :y (* scale 500)))
                   (lut:dispatch-device-event root (lut:make-event :kind :up :x x :y (* scale 500)))))
               (assert (= (lut::scrollbar-range view) (lut:scroll-offset view)))
               (assert (zerop (lut:value view)))
               (capture-check t)
               (setf (lut:items view) '("Only row")) (lut:layout root 0 0 240 160)
               (assert (zerop (lut:scroll-offset view)))
               (capture-check nil t))
             (rl:unload-render-texture texture))))))
     (unwind-protect (lut:run root :frames 2) (lut:dispose root))
     (assert checked))))
(format t "List scrollbar track/thumb pixels, scaled dragging, row preservation and overflow hiding passed in both themes at 100/125/200%.~%")
