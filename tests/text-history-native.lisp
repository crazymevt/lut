(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(asdf:load-system "lut/examples")
(let* ((root (lut-examples:standalone-history)) (view (lut:find-widget root :history-view))
       (initial (lut:text view)) (frame 0) (checked nil))
 (lut:on root :tick (lambda (w dt)
   (declare (ignore w dt))
   (when (= 2 (incf frame))
     (assert (null (lut:view-buffer view)))
     (lut:emit (lut:find-widget root :history-small) :activate)
     (assert (lut:can-undo-p view)) (assert (= 1 (lut:cursor view)))
     (lut:refresh-commands root)
     (lut:emit (lut:find-widget root :history-undo) :activate)
     (assert (string= initial (lut:text view))) (assert (zerop (lut:cursor view)))
     (lut:refresh-commands root)
     (lut:emit (lut:find-widget root :history-redo) :activate)
     (assert (= 1 (lut:cursor view)))
     (lut:emit (lut:find-widget root :history-large) :activate)
     (assert (not (lut:can-undo-p view))) (assert (not (lut:can-redo-p view)))
     (assert (search "not retained" (lut:text (lut:find-widget root :history-status))))
     (setf checked t))))
 (unwind-protect (progn (lut:run root :frames 4) (assert checked)) (lut:dispose root)))
(format t "Native standalone range history example, command undo/redo, selection and overflow status passed.~%")
