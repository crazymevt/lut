(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/examples" :silent t)
(defun check-native-path-poll (root)
 ;; The OS gesture itself remains manual. Verify the native allocation boundary,
 ;; Unicode decoding, copied event data and unloading on callback errors here.
 (let ((dropped (symbol-function 'rl:is-file-dropped))
       (load-files (symbol-function 'rl:load-dropped-files))
       (unload-files (symbol-function 'rl:unload-dropped-files))
       (unloaded 0) (event nil))
   (cffi:with-foreign-string (path "/tmp/α.txt" :encoding :utf-8)
     (cffi:with-foreign-object (paths :pointer)
       (setf (cffi:mem-aref paths :pointer 0) path)
       (unwind-protect
         (progn
           (setf (symbol-function 'rl:is-file-dropped) (lambda () t)
                 (symbol-function 'rl:load-dropped-files) (lambda () (rl:make-file-path-list :count 1 :paths paths))
                 (symbol-function 'rl:unload-dropped-files) (lambda (files) (declare (ignore files)) (incf unloaded)))
           (let ((lut::*event-sink* (lambda (e) (when (eq (lut:event-kind e) :os-drop) (setf event e)))))
             (lut::poll-input root))
           (assert (equal '("/tmp/α.txt") (lut:event-drop-data event))) (assert (= 1 unloaded))
           (let ((lut::*event-sink* (lambda (e) (when (eq (lut:event-kind e) :os-drop) (error "Test drop failure")))))
             (assert (handler-case (progn (lut::poll-input root) nil) (error () t))))
           (assert (= 2 unloaded)))
         (setf (symbol-function 'rl:is-file-dropped) dropped
               (symbol-function 'rl:load-dropped-files) load-files
               (symbol-function 'rl:unload-dropped-files) unload-files))))))
;; Exercise complete example layout and tab badge/close rendering in both themes.
(dolist (theme (list lut:*light-theme* lut:*dark-theme*))
 (let ((root (lut-examples:advanced-interaction)) (frame 0) (checked nil))
   (setf (lut:theme root) theme)
   (lut:on root :tick (lambda (w dt) (declare (ignore dt))
     (when (= 3 (incf frame))
       (assert (getf (lut:os-drag-capabilities w) :incoming))
       (assert (null (getf (lut:os-drag-capabilities w) :outgoing)))
       (check-native-path-poll w)
       (let* ((books (first (lut:children w))) (book (first (lut:children books)))
              (page (second (lut:children book))))
         (assert (not (lut:request-page-close book page)))
         (setf (lut:tab-badge page) nil) (assert (lut:request-page-close book page))
         (assert (lut:disposed-p page)))
       (rl:take-screenshot (if (eq theme lut:*light-theme*) "/tmp/lut-advanced-light.png" "/tmp/lut-advanced-dark.png"))
       (setf checked t))))
   (unwind-protect (progn (lut:run root :frames 4) (assert checked)) (lut:dispose root))))
;; Injected peer events verify worker routing and IPC, not physical pointer capture.
;; OS data also crosses IPC without serializing widgets.
(let* ((controller (lut:make-drag-controller))
       (root (lut:make-widget 'lut:window :width 480 :height 320 :content-layout :fill))
       (peer (lut:make-widget 'lut:window :width 480 :height 320 :content-layout :fill :ui-scale 2))
       (canvas (lut:add-child peer (lut:make-widget 'lut:drawing-area)))
       (left (lut:add-child root (lut:make-widget 'lut:notebook :items '("Source") :closable-p t :reorderable-p t :tab-group :native)))
       (right (lut:add-child canvas (lut:make-widget 'lut:notebook :x 0 :y 0 :width 480 :height 160 :reorderable-p t :tab-group :native)))
       (page (lut:add-child left (lut:make-widget 'lut:label :text "Cross-worker page" :tab-badge "7")))
       (calls 0) (retained nil) (session nil)
       (zone (lut:add-child canvas (lut:make-widget 'lut:drop-zone :x 0 :y 200 :width 480 :height 100
         :drop-predicate (lambda (w s e) (declare (ignore w e)) (typep (lut:drag-payload s) 'lut:os-drop))
         :drop-function (lambda (w s e) (declare (ignore w e))
           (assert (equal '("/tmp/α.txt") (lut:os-drop-data (lut:drag-payload s))))
           (setf retained s) (incf calls)))) )
       (remote nil) (phase :spawn)
       (deadline (+ (get-internal-real-time) (* 20 internal-time-units-per-second))))
 (declare (ignore zone))
 (lut:register-drag-window controller root) (lut:register-drag-window controller peer)
 (lut:on root :tick (lambda (w dt) (declare (ignore dt))
   (when (> (get-internal-real-time) deadline) (error "Advanced worker timed out at ~s" phase))
   (when (and remote (lut::remote-window-error remote)) (error (lut::remote-window-error remote)))
   (case phase
     (:spawn (setf remote (lut:spawn-window peer) phase :ready))
     (:ready (when (>= (lut::remote-window-frames remote) 3)
       (lut:dispatch w (lut:make-event :kind :down :x 20 :y 10))
       (setf session (lut:current-drag w)) (assert session)
       (lut:evaluate-in-window remote
         '((lut::forward-native-event (lut:make-event :kind :move :x 200 :y 10))
           (lut::forward-native-event (lut:make-event :kind :up :x 200 :y 10))))
       (setf phase :transferred)))
     (:transferred (when (eq right (lut:parent page))
       (assert (eq :dropped (lut:drag-state session))) (assert (null (lut:drag-payload session)))
       (assert (string= "7" (lut:tab-badge page)))
       (lut:evaluate-in-window remote
         '((lut::forward-native-event (lut:make-event :kind :os-drop :drop-data '("/tmp/α.txt") :x 20 :y 220))))
       (setf phase :os-delivered)))
     (:os-delivered (when (= 1 calls)
       (assert (null (lut:drag-payload retained)))
       (lut:begin-keyboard-drag right (lut::make-notebook-tab :source right :page page))
       (lut:keyboard-drag-to peer left 200 10)
       (lut:evaluate-in-window remote '((lut::forward-native-event (lut:make-event :kind :key :key :enter))))
       (setf phase :keyboard-return)))
     (:keyboard-return (when (eq left (lut:parent page))
       (setf session (lut:begin-keyboard-drag left (lut::make-notebook-tab :source left :page page)))
       (lut:keyboard-drag-to root right 200 10)
       (lut:close-window remote :dispose nil) (setf phase :closing)))
     (:closing (when (null (lut::remote-window-process remote))
       (assert (eq :cancelled (lut:drag-state session)))
       (assert (null (lut:current-drag root))) (assert (null (lut:window-drag-controller peer)))
       (assert (not (lut:disposed-p peer)))
       (setf phase :done) (lut:stop))))))
 (unwind-protect (progn (lut:run root :frames 1800) (assert (eq phase :done)))
   (when (and remote (lut:remote-alive-p remote)) (lut:close-window remote))
   (lut:dispose controller) (lut:dispose root) (lut:dispose peer)))
(format t "Advanced light/dark rendering, close veto, 200% injected peer-event transfer, OS path IPC, keyboard return and peer teardown passed.~%")
