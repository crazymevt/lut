(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/raylib" :silent t)
(loop for theme in (list lut:*light-theme* lut:*dark-theme*) for name in '("light" "dark") do
 (let* ((root (lut:make-widget 'lut:window :width 600 :height 700 :theme theme))
        (spin (lut:add-child root (lut:make-widget 'lut:spin-button :value 5 :height 40)))
        (text (lut:add-child root (lut:make-widget 'lut:text-view :height 120 :text "Editable text")))
        (scroll (lut:add-child root (lut:make-widget 'lut:scroll-view :height 150)))
        (expander (lut:add-child root (lut:make-widget 'lut:expander :height 140 :value t :text "Advanced options")))
        (button (lut:add-child root (lut:make-widget 'lut:button :text "Hover for help" :tooltip-text "The tooltip text is visible.")))
        (frame 0) (tip nil) (path (format nil "/tmp/lut-findings-~a.png" name)))
   (declare (ignore spin))
   (dotimes (i 20) (lut:add-child scroll (lut:make-widget 'lut:check-button :text (format nil "Option ~d" (1+ i)))))
   (lut:add-child expander (lut:make-widget 'lut:entry :text "Trace destination"))
   (lut:on root :tick (lambda (w dt)
     (declare (ignore w dt))
     (when (= (incf frame) 3)
       (lut:dispatch root (lut:make-event :kind :move :x (+ (lut:x button) 20) :y (+ (lut:y button) 10)))
       (setf tip (first (lut::overlays root)) (lut::hovered-p text) t)
       (lut:focus root expander)
       (assert (equal (lut::surface-color text) (lut:style-value text :surface)))
       (rl:with-drawing ((lut:style-value root :background))
         (lut::render-window root) (rl:take-screenshot path)))))
   (lut:run root :frames 4)
   (let ((image (rl:load-image path)))
     (unwind-protect
       (flet ((pixel (x y) (rl:color-to-int (rl:get-image-color image (round x) (round y)))))
         (assert (= (pixel (+ (lut:x text) 100) (+ (lut:y text) 80))
                    (rl:color-to-int (lut:style-value text :surface))))
         ;; Expander keyboard focus is confined to the heading, leaving the body clear.
         (assert (= (pixel (+ (lut:x expander) 1) (- (+ (lut:y expander) (lut:height expander)) 3))
                    (rl:color-to-int (lut:style-value root :background))))
         (multiple-value-bind (sx sy sw sh) (lut::scrollbar-bounds scroll)
           (assert (= (pixel (+ sx (/ sw 2)) (+ sy (/ sh 2)))
                      (rl:color-to-int (lut:style-value scroll :border-color)))))
         ;; Text-colored pixels prove the tooltip contains rendered help on its first frame.
         (assert (loop for y from (ceiling (+ (lut:y tip) 10)) below (floor (+ (lut:y tip) (lut:height tip) -5))
                  thereis (loop for x from (ceiling (+ (lut:x tip) 10)) below (floor (+ (lut:x tip) (lut:width tip) -5))
                    thereis (= (pixel x y) (rl:color-to-int (lut:style-value tip :foreground)))))))
       (rl:unload-image image)))))
(format t "Text hover, expander heading focus, visible scrollbar and first-frame tooltip pixels passed in both themes.~%")
