(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(asdf:load-system "lut/raylib")
(define-condition expected-clip-error (error) ())
(defclass observed-document (lut:styled-text-view) ())
(defvar *focus-observed* nil)
(defmethod lut:render :after ((view observed-document))
  (assert (eq view (lut:focused-widget (lut:root-of view))))
  (setf *focus-observed* t))
(let* ((root (lut:make-widget 'lut:window :width 500 :height 300))
       (view (lut:add-child root (lut:make-widget 'observed-document :text "Focus stays intact"
                        :style '(:focus-outline-p nil :caret-height :font :caret-width 1))))
       (checks 0))
  (lut:add-child root (lut:make-widget 'lut:drawing-area :width 100 :height 60 :draw-function
    (lambda (w)
      (let ((before (lut:current-drawing-clip)))
        (handler-case
            (lut:with-drawing-clip ((lut:x w) (lut:y w) 20 20)
              (let ((inside (lut:current-drawing-clip)))
                (assert (<= (third inside) 20))
                (assert (<= (fourth inside) 20)))
              (error 'expected-clip-error))
          (expected-clip-error () nil))
        (assert (equal before (lut:current-drawing-clip)))
        (incf checks)))))
  (lut:on root :tick (lambda (w dt) (declare (ignore dt)) (lut:focus w view)))
  (unwind-protect
       (progn (lut:start root :frames 3 :wait t) (assert *focus-observed*) (assert (plusp checks)))
    (lut:dispose root)))
(format t "Native focus-preserving caret rendering and nested/error clipping passed.~%")
