(in-package #:lut-tests)
(defun text-presentation-tests ()
 ;; Style metrics and gutter offsets drive drawing geometry and hit testing.
 (let* ((view (lut:make-widget 'lut:styled-text-view :text "abcd" :x 10 :y 20 :width 200 :height 80
                               :gutter-width 20 :style '(:padding 2 :font-size 10 :line-height 30)))
        (runs (list (list :start 1 :end 3 :style (list :font-size 20 :foreground (list 1 2 3 255))))))
   (lut:set-text-presentation view :runs runs :decorations
     '((:start 1 :end 3 :kind :underline :color :red) (:start 0 :end 4 :kind :gutter :text "1")
       (:start 4 :end 4 :kind :annotation :text "note")))
   (assert (= 32 (lut:text-position-rectangle view 0)))
   (assert (= 62 (lut:text-position-rectangle view 3)))
   (assert (= 2 (lut:text-point-position view 50 23)))
   (setf (getf (getf (first runs) :style) :font-size) 90)
   (setf (first (getf (getf (first runs) :style) :foreground)) 99)
   (assert (= 20 (getf (lut:text-style-at view 1) :font-size)))
   (assert (= 1 (first (getf (lut:text-style-at view 1) :foreground))))
   (let ((revision (lut:text-presentation-revision view)) (before (lut:text-runs view)))
     (assert (handler-case (progn (lut:set-text-presentation view :runs '((:start 3 :end 7 :style (:font-size 12)))) nil) (error () t)))
     (assert (= revision (lut:text-presentation-revision view))) (assert (equal before (lut:text-runs view))))
   (let ((seen nil))
     (lut:on view :presentation-change (lambda (w revision) (assert (= revision (lut:text-presentation-revision w))) (setf seen t)))
     (lut:invalidate-text-presentation view) (assert seen))
   ;; Before/after intervals remap; intersected intervals drop rather than assert
   ;; syntax meaning for new text. Standalone notifications see updated ranges.
   (setf (lut:text view) "Zabcd")
   (assert (equal '((:start 2 :end 4 :style (:font-size 20 :foreground (1 2 3 255)))) (lut:text-runs view)))
   (setf (lut:text view) "ZaXcd") (assert (null (lut:text-runs view)))
   (lut:dispose view) (assert (null (lut:text-decorations view))))
 ;; Shared peers have independent formatting; edit notifications see all styles
 ;; remapped, and detaching preserves the formatted snapshot.
 (let* ((buffer (lut:make-text-buffer :text "abcd"))
        (a (lut:make-widget 'lut:styled-text-view :view-buffer buffer))
        (b (lut:make-widget 'lut:styled-text-view :view-buffer buffer)))
   (lut:set-text-presentation a :runs '((:start 0 :end 2 :style (:foreground :red))))
   (lut:set-text-presentation b :runs '((:start 2 :end 4 :style (:foreground :blue))))
   (lut:on buffer :edit (lambda (w edit) (declare (ignore w edit))
     (assert (= 1 (getf (first (lut:text-runs a)) :start)))
     (assert (= 3 (getf (first (lut:text-runs b)) :start)))))
   (lut:replace-buffer-range buffer 0 0 "Z")
   (assert (eq :red (getf (lut:text-style-at a 1) :foreground)))
   (assert (eq :blue (getf (lut:text-style-at b 3) :foreground)))
   (setf (lut:view-buffer a) nil) (assert (lut:text-runs a))
   (setf (lut:view-buffer a) buffer) (assert (null (lut:text-runs a)))
   (lut:dispose a) (lut:dispose b) (lut:dispose buffer))
 ;; Document links/images occupy character ranges, with normal selection/copy.
 (let* ((root (lut:make-widget 'lut:window :width 400 :height 200))
        (view (lut:add-child root (lut:make-widget 'lut:document-view :text (format nil "go ~c end" (code-char #xfffc))
                                   :x 10 :y 10 :width 200 :height 60 :style '(:padding 0 :font-size 10 :line-height 30))))
        (target (list :document 7)) (activated nil))
   (lut:set-text-presentation view :links (list (list :start 0 :end 2 :target target))
     :images '((:position 3 :source "examples/assets/demo.png" :width 20 :height 16 :alt "demo")))
   (assert (not (lut:editable-p view))) (assert (zerop (lut:history-limit view)))
   (assert (handler-case (progn (setf (lut:read-only-p view) nil) nil) (error () t)))
   (assert (= 48 (lut:text-position-rectangle view 4)))
   (assert (eq :image (lut:document-hit-test view 38 25)))
   (assert (eq :link (lut:document-hit-test view 11 15)))
   (assert (eq target (getf (nth-value 1 (lut:document-hit-test view 11 15)) :target)))
   (assert (null (lut:document-hit-test view 11 59)))
   (lut:on view :link (lambda (w value) (declare (ignore w)) (setf activated value)))
   (selection-pointer root :down 11 15) (selection-pointer root :up 11 15)
   (assert (eq target activated))
   (setf activated nil)
   (selection-pointer root :down 11 15 :click-count 2) (selection-pointer root :up 11 15)
   (assert (null activated)) (assert (string= "go" (lut:selected-text view)))
   (lut:dispatch root (lut:make-event :kind :text :text "blocked"))
   (assert (= 8 (lut:text-length view)))
   (lut:dispose root))
 (anchored-surface-tests)
 (point-decoration-remapping-tests)
 (format t "Styled runs/decorations, geometry invalidation/remapping, document links/images and anchored surfaces passed.~%"))
(defun point-decoration-remapping-tests ()
 (dolist (shared '(nil t))
   (let* ((buffer (when shared (lut:make-text-buffer :text "abcdefghij")))
          (view (lut:make-widget 'lut:styled-text-view :text "abcdefghij" :view-buffer buffer)))
     (lut:set-text-presentation view :decorations
       '((:start 4 :end 4 :kind :annotation :text "note") (:start 4 :end 4 :kind :gutter :text "!")))
     (labels ((edit (start end text)
                (if buffer (lut:replace-buffer-range buffer start end text)
                    (setf (lut:text view) (concatenate 'string (subseq (lut:text view) 0 start) text (subseq (lut:text view) end)))))
              (at (position)
                (assert (= 2 (length (lut:text-decorations view))))
                (dolist (record (lut:text-decorations view))
                  (assert (= position (getf record :start) (getf record :end))))))
       (edit 10 10 "k") (at 4)
       (edit 7 9 "X") (at 4)
       (edit 4 4 "Y") (at 5)
       (edit 3 5 "Z") (at 4)
       (edit 3 5 "Q") (assert (null (lut:text-decorations view))))
     (lut:dispose view) (when buffer (lut:dispose buffer)))))
(defun anchored-surface-tests ()
 (let* ((root (lut:make-widget 'lut:window :width 300 :height 200))
        (owner (lut:add-child root (lut:make-widget 'lut:entry :text "abc" :x 10 :y 10 :width 100)))
        (first (list :label "alpha")) (second (list :label "beta"))
        (surface (lut:make-widget 'lut:suggestion-surface :items (list first second) :item-label-function (lambda (i) (getf i :label))
                                  :width 120 :height 80)) (accepted nil) (dismissals 0))
   (lut:on surface :accept (lambda (w item) (assert (null (lut:parent w))) (setf accepted item)))
   (lut:on surface :dismiss (lambda (w reason) (declare (ignore w reason)) (incf dismissals)))
   (setf (lut:value surface) 1)
   (lut:show-anchored-surface owner surface :rectangle '(280 175 2 15))
   (assert (= 1 (lut:value surface))) (setf (lut:value surface) 0)
   (assert (eq owner (lut:focused-widget root))) (assert (eq root (lut::input-root root)))
   (assert (= 180 (lut:x surface))) (assert (= 95 (lut:y surface)))
   (setf (lut:width root) 50 (lut:height root) 40) (lut::update-anchored-surfaces root)
   (assert (= 50 (lut:width surface)))
   (setf (lut:width root) 300 (lut:height root) 200) (lut::update-anchored-surfaces root)
   (assert (= 120 (lut:width surface))) (assert (= 80 (lut:height surface)))
   (lut:dispatch root (lut:make-event :kind :text :text "x"))
   (assert (string= "xabc" (lut:text owner))) (assert (lut:parent surface))
   (lut:dispatch root (lut:make-event :kind :key :key :down)) (assert (= 1 (lut:value surface)))
   (lut:dispatch root (lut:make-event :kind :key :key :enter))
   (assert (eq accepted second)) (assert (= 1 dismissals)) (assert (eq owner (lut:focused-widget root)))
   (lut:dismiss-anchored-surface surface) (assert (= 1 dismissals))
   (lut:show-anchored-surface owner surface) (setf (lut:items surface) nil)
   (assert (null (lut:value surface))) (assert (not (lut:accept-suggestion surface)))
   (lut:dispatch root (lut:make-event :kind :key :key :escape)) (assert (null (lut:parent surface)))
   (setf (lut:items surface) (list first second))
   (lut:show-anchored-surface owner surface :rectangle '(10 50 2 15))
   (let ((x (+ (lut:x surface) 12)) (y (+ (lut:y surface) 12)))
     (selection-pointer root :down x y) (selection-pointer root :up x y))
   (assert (eq accepted first))
   (lut:show-anchored-surface owner surface)
   (selection-pointer root :down 250 20) (selection-pointer root :up 250 20)
   (assert (null (lut:parent surface)))
   (lut:show-anchored-surface owner surface) (lut:dispose owner)
   (assert (lut:disposed-p surface)) (assert (null (lut:items surface)))
   (assert (null (slot-value surface 'lut::anchor-owner)))
   (lut:dispose root))
 ;; Initial caret anchoring reveals an offscreen caret before placing the
 ;; surface, rather than waiting for a later painter pass to move the caret.
 (let* ((root (lut:make-widget 'lut:window :width 400 :height 200))
        (owner (lut:add-child root (lut:make-widget 'lut:entry :text (make-string 100 :initial-element #\a)
                  :cursor 100 :width 80 :style '(:padding 0 :font-size 10))))
        (surface (lut:make-widget 'lut:anchored-surface :width 80 :height 60)))
   (lut:show-anchored-surface owner surface)
   (assert (plusp (lut:text-offset owner)))
   (assert (= (lut:x surface) (lut:text-position-rectangle owner 100)))
   (assert (< (lut:x surface) (+ (lut:x owner) (lut:width owner))))
   (lut:dispose root))
 ;; Help content can take focus, select/copy, and return focus on dismissal.
 (let* ((root (lut:make-widget 'lut:window :width 400 :height 300))
        (owner (lut:add-child root (lut:make-widget 'lut:entry)))
        (surface (lut:make-widget 'lut:anchored-surface :width 180 :height 100))
        (doc (lut:add-child surface (lut:make-widget 'lut:document-view :text "selectable help"))))
   (lut:show-anchored-surface owner surface)
   (lut:focus root doc) (lut::update-anchored-surfaces root)
   (assert (lut:parent surface))
   (lut:select-all doc) (assert (string= "selectable help" (lut:selected-text doc)))
   (lut:dispatch root (lut:make-event :kind :key :key :escape))
   (assert (eq owner (lut:focused-widget root)))
   (lut:dispose surface) (lut:dispose root))
 ;; Modal scope changes dismiss existing anchors. Escape dismisses help before
 ;; it reaches the underlying modal dialog.
 (let* ((root (lut:make-widget 'lut:window :width 400 :height 300))
        (modal (lut:make-widget 'lut:dialog :width 300 :height 200))
        (owner (lut:add-child modal (lut:make-widget 'lut:entry)))
        (surface (lut:make-widget 'lut:anchored-surface :width 180 :height 100))
        (doc (lut:add-child surface (lut:make-widget 'lut:document-view :text "selectable help"
                                    :style '(:padding 0 :font-size 10))))
        (background (lut:add-child root (lut:make-widget 'lut:entry))))
   (lut:show-dialog root modal) (lut:layout modal 0 0 300 200)
   (lut:show-anchored-surface owner surface)
   (lut:focus root doc)
   (assert (lut::live-input-widget-p doc root))
   (assert (handler-case (progn (lut:focus root background) nil) (error () t)))
   (multiple-value-bind (x y) (lut:text-position-rectangle doc 0)
     (selection-pointer root :down x (+ y 5))
     (selection-pointer root :move (lut:text-position-rectangle doc 5) (+ y 5))
     (selection-pointer root :up (lut:text-position-rectangle doc 5) (+ y 5)))
   (assert (eq doc (lut:focused-widget root)))
   (assert (string= "selec" (lut:selected-text doc)))
   (lut:dispatch root (lut:make-event :kind :key :key :right))
   (assert (eq doc (lut:focused-widget root)))
   (lut:dispatch root (lut:make-event :kind :key :key :escape))
   (assert (eq owner (lut:focused-widget root)))
   (assert (eq modal (lut::input-root root))) (assert (null (lut:parent surface)))
   (lut:show-anchored-surface owner surface)
   (let ((next (lut:make-widget 'lut:dialog)))
     (lut:show-dialog root next) (assert (null (lut:parent surface)))
     (lut:dismiss-dialog next) (lut:dispose next))
   (lut:dispose surface) (lut:dispose root))
 ;; Wheel scrolling is independent of selection; changing selection reveals it.
 (let* ((root (lut:make-widget 'lut:window :width 400 :height 300))
        (owner (lut:add-child root (lut:make-widget 'lut:text-view :text (format nil "one~%two"))))
        (other (lut:add-child root (lut:make-widget 'lut:text-view :text "other")))
        (surface (lut:make-widget 'lut:suggestion-surface :width 180 :height 80
                                  :items (loop for i below 30 collect i) :dismiss-on-blur-p nil)))
   (lut:show-anchored-surface owner surface :rectangle '(10 60 1 1))
   (lut:dispatch root (lut:make-event :kind :wheel :x (+ 12 (lut:x surface)) :y (+ 12 (lut:y surface)) :delta -4))
   (assert (plusp (lut:scroll-offset surface)))
   (let ((offset (lut:scroll-offset surface)))
     (lut::update-anchored-surfaces root) (assert (= offset (lut:scroll-offset surface))))
   (setf (lut:value surface) 29)
   (assert (plusp (lut:scroll-offset surface)))
   (setf (lut:value surface) 0) (assert (zerop (lut:scroll-offset surface)))
   (lut:dispatch root (lut:make-event :kind :key :key :down :shift-p t))
   (assert (plusp (length (lut:selected-text owner)))) (assert (zerop (lut:value surface)))
   (dolist (modifier '(:control-p :alt-p :super-p))
     (assert (not (lut::dispatch-anchored-surfaces root (apply #'lut:make-event :kind :key :key :down (list modifier t))))))
   (lut:focus root other)
   (lut:dispatch root (lut:make-event :kind :key :key :end))
   (assert (= 5 (lut:cursor other))) (assert (zerop (lut:value surface)))
   (lut:focus root owner) (setf (lut:items surface) nil)
   (lut:select-all owner)
   (lut:dispatch root (lut:make-event :kind :key :key :enter))
   (assert (string= (string #\Newline) (lut:text owner)))
   (assert (lut:parent surface))
   (lut:dispose root))
 ;; Observer errors do not roll back dismissal; later disposal releases data.
 (let* ((root (lut:make-widget 'lut:window :width 300 :height 200))
        (owner (lut:add-child root (lut:make-widget 'lut:entry)))
        (surface (lut:make-widget 'lut:suggestion-surface :items '("one"))))
   (lut:show-anchored-surface owner surface)
   (lut:on surface :dismiss (lambda (w why) (declare (ignore w why)) (error "Dismiss observer failure")))
   (assert (handler-case (progn (lut:dismiss-anchored-surface surface) nil) (error () t)))
   (assert (null (lut:parent surface)))
   (assert (null (slot-value surface 'lut::anchor-owner)))
   (lut:dispose surface)
   (assert (lut:disposed-p surface)) (assert (null (lut:items surface)))
   (lut:dispose root)))
