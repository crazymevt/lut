(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/raylib" :silent t)
(defun polish-snapshot (root path)
 (let ((texture (rl:load-render-texture (round (* (lut:width root) (lut:ui-scale root)))
                                        (round (* (lut:height root) (lut:ui-scale root))))))
   (unwind-protect
     (progn
       (rl:with-texture-mode (texture)
         (rl:clear-background (lut:style-value root :background)) (lut::render-window root))
       (let ((image (rl:load-image-from-texture (rl:render-texture-texture texture))))
         (unwind-protect
           (progn (rl:image-flip-vertical image) (assert (rl:export-image image path)))
           (rl:unload-image image))))
     (rl:unload-render-texture texture))))
(dolist (scale '(1 2))
 (loop for theme in (list lut:*light-theme* lut:*dark-theme*) for palette in '("light" "dark") do
  (let* ((root (lut:make-widget 'lut:window :width (* 520 scale) :height (* 660 scale) :ui-scale scale
                                :theme theme :style '(:padding 20 :spacing 14)))
         (title (lut:add-child root (lut:make-widget 'lut:label :text "Everyday controls" :height 40 :style '(:font-size 24 :bold t))))
         (search (lut:add-child root (lut:make-widget 'lut:search-control :search-hint "Search projects, files and people" :height 40)))
         (date (lut:add-child root (lut:make-widget 'lut:date-picker :height 40)))
         (time (lut:add-child root (lut:make-widget 'lut:time-picker :clock-time '(14 30 0) :time-format :12-hour :height 40)))
         (time24 (lut:add-child root (lut:make-widget 'lut:time-picker :clock-time '(14 30 0) :height 40)))
         (spin (lut:add-child root (lut:make-widget 'lut:spin-button :value 5 :height 40)))
         (spinner (lut:add-child root (lut:make-widget 'lut:activity-indicator :height 64)))
         (button (lut:add-child root (lut:make-widget 'lut:button :text "Continue" :height 40)))
         (check (lut:add-child root (lut:make-widget 'lut:check-button :text "Keep me signed in" :value t)))
         (progress (lut:add-child root (lut:make-widget 'lut:progress-bar :value 65)))
         (frame 0) (path (format nil "/tmp/lut-polished-~a-~dx.png" palette scale)))
    (declare (ignore title time24 button progress))
    (lut:on root :tick
      (lambda (w dt)
        (declare (ignore dt))
        (case (incf frame)
          (3 (polish-snapshot w path))
          (4 (lut:focus w date)
             (polish-snapshot w (format nil "/tmp/lut-polished-focus-~a-~dx.png" palette scale)))
          (5 (lut:dispatch w (lut:make-event :kind :move :x (+ (lut:x date) 10) :y (+ (lut:y date) 10)))
             (polish-snapshot w (format nil "/tmp/lut-polished-hover-~a-~dx.png" palette scale)))
          (6 (let ((x (+ (lut:x date) 60)) (y (+ (lut:y date) 20)))
               (lut:dispatch w (lut:make-event :kind :down :x x :y y))
               (lut:dispatch w (lut:make-event :kind :up :x x :y y)))
             (assert (lut::picker-popup date)))
          (8 (polish-snapshot w (format nil "/tmp/lut-polished-calendar-~a-~dx.png" palette scale))
             (lut:dispatch w (lut:make-event :kind :key :key :right))
             (lut:dispatch w (lut:make-event :kind :key :key :escape)))
          (9 (lut:focus w time)
             (polish-snapshot w (format nil "/tmp/lut-polished-time-focus-~a-~dx.png" palette scale)))
          (10 (setf (lut:text search) "A very long search query that scrolls smoothly past the clear icon without painting over it")
              (lut:focus w search) (setf (lut:cursor search) (length (lut:text search))))
          (12 (polish-snapshot w (format nil "/tmp/lut-polished-search-~a-~dx.png" palette scale)))
          (13 (lut:dispatch w (lut:make-event :kind :move :x (+ (lut:x spin) 16) :y (+ (lut:y spin) 20)))
              (polish-snapshot w (format nil "/tmp/lut-polished-spin-hover-~a-~dx.png" palette scale)))
          (20 (polish-snapshot w (format nil "/tmp/lut-polished-animated-~a-~dx.png" palette scale))))))
    (unwind-protect
        (progn
          (lut:run root :frames 21)
          (let ((normal (rl:load-image path))
                (focused (rl:load-image (format nil "/tmp/lut-polished-focus-~a-~dx.png" palette scale)))
                (hover (rl:load-image (format nil "/tmp/lut-polished-hover-~a-~dx.png" palette scale)))
                (spin-hover (rl:load-image (format nil "/tmp/lut-polished-spin-hover-~a-~dx.png" palette scale)))
                (animated (rl:load-image (format nil "/tmp/lut-polished-animated-~a-~dx.png" palette scale))))
            (unwind-protect
              (flet ((pixel (image x y) (rl:color-to-int (rl:get-image-color image (round (* x scale)) (round (* y scale))))))
                ;; The ring must paint outside the border, and hover must leave the interior unchanged.
                (assert (loop for dy from -4 below 0 thereis
                         (/= (pixel normal (+ (lut:x date) 80) (+ (lut:y date) dy))
                             (pixel focused (+ (lut:x date) 80) (+ (lut:y date) dy)))))
                (assert (= (pixel focused (+ (lut:x date) 140) (+ (lut:y date) 3))
                           (pixel hover (+ (lut:x date) 140) (+ (lut:y date) 3))))
                (let* ((pad (min (lut:style-value check :padding) (/ (lut:height check) 4) (/ (lut:width check) 4)))
                       (size (min (lut:style-value check :font-size) (- (lut:height check) (* 2 pad))))
                       (ix (- (+ (lut:x check) (lut:width check)) size pad))
                       (iy (+ (lut:y check) (/ (- (lut:height check) size) 2))))
                  (assert (/= (pixel normal (+ ix 4) (+ iy 4)) (rl:color-to-int (lut:style-value root :background)))))
                (let ((cy (+ (lut:y spin) (/ (lut:height spin) 2))))
                  (assert (= (pixel spin-hover (+ (lut:x spin) 16) (- cy 6))
                             (rl:color-to-int (lut:style-value spin :hover-color))))
                  (assert (= (pixel spin-hover (- (+ (lut:x spin) (lut:width spin)) 16) (- cy 6))
                             (pixel normal (- (+ (lut:x spin) (lut:width spin)) 16) (- cy 6))))
                  (assert (= (pixel spin-hover (+ (lut:x spin) 100) (- cy 6))
                             (pixel normal (+ (lut:x spin) 100) (- cy 6)))))
                ;; Even a stretched 480-by-64 allocation keeps spinner pixels within 20 logical pixels.
                (let ((xs nil) (ys nil) (changed nil) (bg (rl:color-to-int (lut:style-value root :background))))
                  (loop for y from (round (+ (lut:y spinner) 4)) below (round (- (+ (lut:y spinner) (lut:height spinner)) 4)) do
                    (loop for x from (round (+ (lut:x spinner) 4)) below (round (- (+ (lut:x spinner) (lut:width spinner)) 4)) do
                      (let ((color (pixel normal x y)))
                        (unless (= color bg) (push x xs) (push y ys))
                        (unless (= color (pixel animated x y)) (setf changed t)))))
                  (assert xs) (assert ys) (assert changed)
                  (assert (<= (- (reduce #'max xs) (reduce #'min xs)) 22))
                  (assert (<= (- (reduce #'max ys) (reduce #'min ys)) 22))))
              (mapc #'rl:unload-image (list normal focused hover spin-hover animated)))))
      (lut:dispose root)))))
(format t "PASS: polished controls, external focus, neutral hover, compact animated spinner; light/dark at 100/200%.~%")
