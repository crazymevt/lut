(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(asdf:load-asd (truename "lut.asd"))
(ql:quickload "lut/examples" :silent t)
(defun assert-following-tail (view)
 (multiple-value-bind (extent page offset) (lut:scroll-geometry view)
   (assert (< (abs (- offset (max 0 (- extent page)))) 0.01))))
(defun scrolling-click (root id)
 (let* ((button (lut:find-widget root id)) (scale (lut:ui-scale root))
        (x (* scale (+ (lut:x button) (/ (lut:width button) 2))))
        (y (* scale (+ (lut:y button) (/ (lut:height button) 2)))))
   (dolist (kind '(:down :up))
     (lut:dispatch-device-event root (lut:make-event :kind kind :x x :y y)))))
(defun capture-scrolling (root path)
 (let* ((scale (lut:ui-scale root))
        (target (rl:load-render-texture (round (* scale (lut:width root))) (round (* scale (lut:height root))))))
   (unwind-protect
     (progn
       (rl:with-texture-mode (target)
         (rl:clear-background (lut:style-value root :background)) (lut::render-window root))
       (let ((image (rl:load-image-from-texture (rl:render-texture-texture target))))
         (unwind-protect (progn (rl:image-flip-vertical image) (assert (rl:export-image image path)))
           (rl:unload-image image))))
     (rl:unload-render-texture target))))
(dolist (theme (list lut:*light-theme* lut:*dark-theme*))
 (dolist (scale '(1 5/4 2))
   (let* ((root (lut-examples:scrolling)) (document (lut:find-widget root :scroll-document))
          (region (lut:find-widget root :scroll-region)) (frame 0) (checked nil))
     (setf (lut:theme root) theme (lut:ui-scale root) scale)
     (lut:on root :tick (lambda (w dt)
       (declare (ignore dt))
       (case (incf frame)
         (1
           (lut:layout w 0 0 700 550)
           (scrolling-click w :scroll-resume))
         (2
           (assert-following-tail document) (assert-following-tail region)
           (let ((before (lut:text-length document)) (cursor (lut:cursor document)))
             (scrolling-click w :scroll-append)
             (assert (> (lut:text-length document) before))
             (lut:layout w 0 0 700 550)
             (assert-following-tail document)
             (assert (= cursor (lut:cursor document))))
           (scrolling-click w :scroll-pause)
           (assert (null (lut:follow-end-distance document)))
           (lut:scroll-to document 50)
           (scrolling-click w :scroll-append)
           (lut:layout w 0 0 320 700)
           (assert (= 50 (lut:vertical-offset document)))
           (scrolling-click w :scroll-search)
           (assert (zerop (lut:vertical-offset document)))
           (multiple-value-bind (x y cw ch) (lut:text-position-rectangle document 0)
             (declare (ignore cw))
             (assert (lut::contains-point-p region x (+ y 1)))
             (assert (<= (+ y ch) (+ (lut:y region) (lut:height region)))))
           (capture-scrolling w (format nil "/tmp/lut-scroll-search-~a-~d.png"
             (if (eq theme lut:*light-theme*) "light" "dark") (round (* scale 100))))
           (scrolling-click w :scroll-resume)
           (lut:layout w 0 0 700 550)
           (assert-following-tail document) (assert-following-tail region))
         (3
           ;; Verify an actual render/frame did not let caret tracking undo following.
           (assert-following-tail document) (assert-following-tail region)
           (capture-scrolling w (format nil "/tmp/lut-scroll-tail-~a-~d.png"
             (if (eq theme lut:*light-theme*) "light" "dark") (round (* scale 100))))
           (setf checked t)))))
     (unwind-protect (progn (lut:run root :frames 4) (assert checked)) (lut:dispose root)
       (assert (null (slot-value document 'lut::scroll-follow-distance)))))))
(format t "Native scroll geometry, nested range reveal, append/follow/pause/restore, resize and scaled button input passed in light/dark at 100/125/200%.~%")
