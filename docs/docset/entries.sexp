(:entry "class/dropdown" :names ("DROPDOWN") :kind :class :kind-name "Class" :package "LUT" :summary "Closed selection opens a reusable popup list." :sections (("Description" (:p "Closed selection opens a reusable popup list.")) ("Superclasses" (:p "(list-view)")) ("Initargs, defaults and valid values" (:p ":expanded-p — Whether the option popup is open. Valid values: boolean. Default form: nil. Accessor: expanded-p.") (:p ":items — Strings displayed as rows. Valid values: list. Default form: nil. Accessor: items.") (:p ":hovered-row — Internal pointer row; separate from selection. Valid values: (or null (integer 0 *)). Default form: nil. Accessor: hovered-row.") (:p ":value — Selected zero-based index, or NIL. Valid values: (or null (integer 0 *)). Default form: nil. Accessor: value.") (:p ":scroll-offset — Vertical scroll in pixels. Valid values: (real 0 *). Default form: 0. Accessor: scroll-offset.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:dropdown)"))))
(:entry "class/entry" :names ("ENTRY") :kind :class :kind-name "Class" :package "LUT" :summary "Editable single-line text. Selection uses character indices." :sections (("Description" (:p "Editable single-line text. Selection uses character indices.")) ("Superclasses" (:p "(label)")) ("Initargs, defaults and valid values" (:p ":view-buffer — Optional shared text model; NIL keeps standalone entry editing. Valid values: (or null text-buffer). Default form: nil. Accessor: view-buffer.") (:p ":read-only-p — Prevent editing in this view while permitting selection and copying. Valid values: boolean. Default form: nil. Accessor: read-only-p.") (:p ":cursor — Insertion position. Valid values: (integer 0 *). Default form: 0. Accessor: cursor.") (:p ":anchor — Other end of selection. Valid values: (integer 0 *). Default form: 0. Accessor: anchor.") (:p ":text-offset — Horizontal text viewport offset in pixels. Valid values: (real 0 *). Default form: 0. Accessor: text-offset.") (:p ":vertical-offset — Vertical multiline text viewport offset in pixels. Valid values: (real 0 *). Default form: 0. Accessor: vertical-offset.") (:p ":undo-history — Internal prior range edit records. Valid values: list. Default form: nil. Accessor: undo-history.") (:p ":redo-history — Internal undone range edit records. Valid values: list. Default form: nil. Accessor: redo-history.") (:p ":history-limit — Maximum range records per undo/redo stack; zero disables history. Valid values: (integer 0 *). Default form: 100. Accessor: history-limit.") (:p ":history-character-limit — Maximum removed plus inserted characters retained per history stack; zero disables retention. Valid values: (integer 0 *). Default form: 262144. Accessor: history-character-limit.") (:p ":last-cursor — Internal previous caret position for viewport tracking. Valid values: (integer -1 *). Default form: -1. Accessor: last-cursor.") (:p ":navigation-x — Internal preferred horizontal pixel position for vertical navigation. Valid values: (or null real). Default form: nil. Accessor: navigation-x.") (:p ":text — Displayed text. Valid values: string. Default form: \"\". Accessor: text.") (:p ":text-root — Internal indexed text cache. Valid values: t. Default form: nil. Accessor: text-root.") (:p ":indexed-string — Internal source identity for standalone indexing. Valid values: (or null string). Default form: nil. Accessor: indexed-string.") (:p ":geometry-cache — Internal bounded line measurement cache. Valid values: list. Default form: nil. Accessor: geometry-cache.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:entry)"))))
(:entry "class/expander" :names ("EXPANDER") :kind :class :kind-name "Class" :package "LUT" :summary "Header toggles visibility of its content." :sections (("Description" (:p "Header toggles visibility of its content.")) ("Superclasses" (:p "(box)")) ("Initargs, defaults and valid values" (:p ":text — Header caption. Valid values: string. Default form: \"Details\". Accessor: text.") (:p ":value — Whether content is expanded. Valid values: boolean. Default form: nil. Accessor: value.") (:p ":orientation — Stack direction. Valid values: (member :vertical :horizontal). Default form: :vertical. Accessor: orientation.") (:p ":spacing — Space between children. Valid values: (real 0 *). Default form: 8. Accessor: spacing.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:expander)"))))
(:entry "class/file-chooser" :names ("FILE-CHOOSER") :kind :class :kind-name "Class" :package "LUT" :summary "Portable file chooser with directory navigation and explicit filename." :sections (("Description" (:p "Portable file chooser with directory navigation and explicit filename.")) ("Superclasses" (:p "(dialog)")) ("Initargs, defaults and valid values" (:p ":directory — Current directory. Valid values: pathname. Default form: (user-homedir-pathname). Accessor: directory.") (:p ":value — Chosen file pathname. Valid values: (or null pathname). Default form: nil. Accessor: value.") (:p ":modal-p — Block input to the owner while this native dialog is open. Valid values: boolean. Default form: t. Accessor: modal-p.") (:p ":native-p — Backend-managed native dialog presentation. Valid values: boolean. Default form: nil. Accessor: native-p.") (:p ":text — Dialog title. Valid values: string. Default form: \"Dialog\". Accessor: text.") (:p ":position-mode — Centered until dragged, then absolute coordinates. Valid values: (member :center :absolute). Default form: :center. Accessor: position-mode.") (:p ":draggable-p — Drag unoccupied dialog surface to move it. Valid values: boolean. Default form: t. Accessor: draggable-p.") (:p ":detach-on-drag-p — Detach as a native window when dragged beyond the root bounds. Valid values: boolean. Default form: t. Accessor: detach-on-drag-p.") (:p ":orientation — Stack direction. Valid values: (member :vertical :horizontal). Default form: :vertical. Accessor: orientation.") (:p ":spacing — Space between children. Valid values: (real 0 *). Default form: 8. Accessor: spacing.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:file-chooser)"))))
(:entry "class/font-chooser" :names ("FONT-CHOOSER") :kind :class :kind-name "Class" :package "LUT" :summary "Portable font chooser accepting an explicit font file and pixel size." :sections (("Description" (:p "Portable font chooser accepting an explicit font file and pixel size.")) ("Superclasses" (:p "(dialog)")) ("Initargs, defaults and valid values" (:p ":value — Selected TrueType/OpenType font file. Valid values: (or null string pathname). Default form: nil. Accessor: value.") (:p ":font-size — Selected positive pixel size. Valid values: (integer 1 *). Default form: 18. Accessor: font-size.") (:p ":modal-p — Block input to the owner while this native dialog is open. Valid values: boolean. Default form: t. Accessor: modal-p.") (:p ":native-p — Backend-managed native dialog presentation. Valid values: boolean. Default form: nil. Accessor: native-p.") (:p ":text — Dialog title. Valid values: string. Default form: \"Dialog\". Accessor: text.") (:p ":position-mode — Centered until dragged, then absolute coordinates. Valid values: (member :center :absolute). Default form: :center. Accessor: position-mode.") (:p ":draggable-p — Drag unoccupied dialog surface to move it. Valid values: boolean. Default form: t. Accessor: draggable-p.") (:p ":detach-on-drag-p — Detach as a native window when dragged beyond the root bounds. Valid values: boolean. Default form: t. Accessor: detach-on-drag-p.") (:p ":orientation — Stack direction. Valid values: (member :vertical :horizontal). Default form: :vertical. Accessor: orientation.") (:p ":spacing — Space between children. Valid values: (real 0 *). Default form: 8. Accessor: spacing.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:font-chooser)"))))
