(:entry "class/stack" :names ("STACK") :kind :class :kind-name "Class" :package "LUT" :summary "Only child at selected page VALUE participates in layout and input." :sections (("Description" (:p "Only child at selected page VALUE participates in layout and input.")) ("Superclasses" (:p "(widget)")) ("Initargs, defaults and valid values" (:p ":value — Visible zero-based page index. Valid values: (integer 0 *). Default form: 0. Accessor: value.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:stack)"))))
(:entry "class/styled-text-view" :names ("STYLED-TEXT-VIEW") :kind :class :kind-name "Class" :package "LUT" :summary "Unwrapped text with application-supplied character runs and decorations." :sections (("Description" (:p "Unwrapped text with application-supplied character runs and decorations.")) ("Superclasses" (:p "(text-view)")) ("Initargs, defaults and valid values" (:p ":gutter-width — Reserved left gutter width in pixels. Valid values: (real 0 *). Default form: 0. Accessor: gutter-width.") (:p ":presentation-runs — Internal disjoint style intervals. Valid values: vector. Default form: #(). Accessor: presentation-runs.") (:p ":presentation-decorations — Internal overlapping decoration intervals. Valid values: vector. Default form: #(). Accessor: presentation-decorations.") (:p ":decoration-max-ends — Internal decoration prefix interval index. Valid values: vector. Default form: #(). Accessor: decoration-max-ends.") (:p ":presentation-links — Internal disjoint application link intervals. Valid values: vector. Default form: #(). Accessor: presentation-links.") (:p ":presentation-images — Internal inline-image character records. Valid values: vector. Default form: #(). Accessor: presentation-images.") (:p ":presentation-revision — Internal presentation cache generation. Valid values: (integer 0 *). Default form: 0. Accessor: presentation-revision.") (:p ":pressed-document-link — Internal link pointer capture. Valid values: t. Default form: nil. Accessor: pressed-document-link.") (:p ":view-buffer — Optional shared text model; NIL keeps standalone entry editing. Valid values: (or null text-buffer). Default form: nil. Accessor: view-buffer.") (:p ":read-only-p — Prevent editing in this view while permitting selection and copying. Valid values: boolean. Default form: nil. Accessor: read-only-p.") (:p ":cursor — Insertion position. Valid values: (integer 0 *). Default form: 0. Accessor: cursor.") (:p ":anchor — Other end of selection. Valid values: (integer 0 *). Default form: 0. Accessor: anchor.") (:p ":text-offset — Horizontal text viewport offset in pixels. Valid values: (real 0 *). Default form: 0. Accessor: text-offset.") (:p ":vertical-offset — Vertical multiline text viewport offset in pixels. Valid values: (real 0 *). Default form: 0. Accessor: vertical-offset.") (:p ":undo-history — Internal prior range edit records. Valid values: list. Default form: nil. Accessor: undo-history.") (:p ":redo-history — Internal undone range edit records. Valid values: list. Default form: nil. Accessor: redo-history.") (:p ":history-limit — Maximum range records per undo/redo stack; zero disables history. Valid values: (integer 0 *). Default form: 100. Accessor: history-limit.") (:p ":history-character-limit — Maximum removed plus inserted characters retained per history stack; zero disables retention. Valid values: (integer 0 *). Default form: 262144. Accessor: history-character-limit.") (:p ":last-cursor — Internal previous caret position for viewport tracking. Valid values: (integer -1 *). Default form: -1. Accessor: last-cursor.") (:p ":navigation-x — Internal preferred horizontal pixel position for vertical navigation. Valid values: (or null real). Default form: nil. Accessor: navigation-x.") (:p ":text — Displayed text. Valid values: string. Default form: \"\". Accessor: text.") (:p ":text-root — Internal indexed text cache. Valid values: t. Default form: nil. Accessor: text-root.") (:p ":indexed-string — Internal source identity for standalone indexing. Valid values: (or null string). Default form: nil. Accessor: indexed-string.") (:p ":geometry-cache — Internal bounded line measurement cache. Valid values: list. Default form: nil. Accessor: geometry-cache.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:styled-text-view)"))))
(:entry "class/suggestion-surface" :names ("SUGGESTION-SURFACE") :kind :class :kind-name "Class" :package "LUT" :summary "Keyboard/pointer candidate list; acceptance emits the original application item." :sections (("Description" (:p "Keyboard/pointer candidate list; acceptance emits the original application item.")) ("Superclasses" (:p "(anchored-surface)")) ("Initargs, defaults and valid values" (:p ":items — Application candidates, retained until replaced or disposed. Valid values: list. Default form: nil. Accessor: items.") (:p ":item-label-function — Pure candidate-to-string function designator. Valid values: (or symbol function). Default form: #'princ-to-string. Accessor: item-label-function.") (:p ":value — Highlighted candidate index, or NIL. Valid values: (or null (integer 0 *)). Default form: nil. Accessor: value.") (:p ":scroll-offset — Candidate viewport offset in pixels. Valid values: (real 0 *). Default form: 0. Accessor: scroll-offset.") (:p ":anchor-owner — Owner; assigned by SHOW-ANCHORED-SURFACE and released on dismissal. Valid values: (or null widget). Default form: nil. Accessor: anchor-owner.") (:p ":anchor-rectangle — NIL follows an entry caret; otherwise root X Y WIDTH HEIGHT. Valid values: list. Default form: nil. Accessor: anchor-rectangle.") (:p ":dismiss-on-blur-p — Dismiss when focus moves away from the owner. Valid values: boolean. Default form: t. Accessor: dismiss-on-blur-p.") (:p ":anchor-root — Internal input scope saved when shown. Valid values: (or null widget). Default form: nil. Accessor: anchor-root.") (:p ":anchor-position — Internal resolved placement. Valid values: (member :above :below). Default form: :below. Accessor: anchor-position.") (:p ":requested-width — Internal preferred popup width before viewport clamping. Valid values: (or null real). Default form: nil. Accessor: requested-width.") (:p ":requested-height — Internal preferred popup height before viewport clamping. Valid values: (or null real). Default form: nil. Accessor: requested-height.") (:p ":surface-pressed-item — Internal suggestion pointer capture. Valid values: (or null integer). Default form: nil. Accessor: surface-pressed-item.") (:p ":popup-owner — Control owning this popup, when applicable. Valid values: (or null widget). Default form: nil. Accessor: popup-owner.") (:p ":position-mode — Popup position is in root pixels. Valid values: (member :center :absolute). Default form: :absolute. Accessor: position-mode.") (:p ":draggable-p — Popups do not drag by default. Valid values: boolean. Default form: nil. Accessor: draggable-p.") (:p ":modal-p — Block input to the owner while this native dialog is open. Valid values: boolean. Default form: t. Accessor: modal-p.") (:p ":native-p — Backend-managed native dialog presentation. Valid values: boolean. Default form: nil. Accessor: native-p.") (:p ":text — Dialog title. Valid values: string. Default form: \"Dialog\". Accessor: text.") (:p ":detach-on-drag-p — Detach as a native window when dragged beyond the root bounds. Valid values: boolean. Default form: t. Accessor: detach-on-drag-p.") (:p ":orientation — Stack direction. Valid values: (member :vertical :horizontal). Default form: :vertical. Accessor: orientation.") (:p ":spacing — Space between children. Valid values: (real 0 *). Default form: 8. Accessor: spacing.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:suggestion-surface)"))))
(:entry "class/switch" :names ("SWITCH") :kind :class :kind-name "Class" :package "LUT" :summary "Boolean switch with the same keyboard semantics as a toggle." :sections (("Description" (:p "Boolean switch with the same keyboard semantics as a toggle.")) ("Superclasses" (:p "(toggle-button)")) ("Initargs, defaults and valid values" (:p ":value — Checked state. Valid values: boolean. Default form: nil. Accessor: value.") (:p ":text — Displayed text. Valid values: string. Default form: \"\". Accessor: text.") (:p ":text-root — Internal indexed text cache. Valid values: t. Default form: nil. Accessor: text-root.") (:p ":indexed-string — Internal source identity for standalone indexing. Valid values: (or null string). Default form: nil. Accessor: indexed-string.") (:p ":geometry-cache — Internal bounded line measurement cache. Valid values: list. Default form: nil. Accessor: geometry-cache.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:switch)"))))
(:entry "class/table-view" :names ("TABLE-VIEW") :kind :class :kind-name "Class" :package "LUT" :summary "Rows of column values, selected as a list." :sections (("Description" (:p "Rows of column values, selected as a list.")) ("Superclasses" (:p "(list-view)")) ("Initargs, defaults and valid values" (:p ":columns — Column header strings. Valid values: list. Default form: nil. Accessor: columns.") (:p ":rows — Rows, each a list of printable cell values. Valid values: list. Default form: nil. Accessor: rows.") (:p ":items — Strings displayed as rows. Valid values: list. Default form: nil. Accessor: items.") (:p ":hovered-row — Internal pointer row; separate from selection. Valid values: (or null (integer 0 *)). Default form: nil. Accessor: hovered-row.") (:p ":value — Selected zero-based index, or NIL. Valid values: (or null (integer 0 *)). Default form: nil. Accessor: value.") (:p ":scroll-offset — Vertical scroll in pixels. Valid values: (real 0 *). Default form: 0. Accessor: scroll-offset.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input