(:entry "class/list-view" :names ("LIST-VIEW") :kind :class :kind-name "Class" :package "LUT" :summary "Selectable rows; :CHANGE receives selected index." :sections (("Description" (:p "Selectable rows; :CHANGE receives selected index.")) ("Superclasses" (:p "(widget)")) ("Initargs, defaults and valid values" (:p ":items — Strings displayed as rows. Valid values: list. Default form: nil. Accessor: items.") (:p ":hovered-row — Internal pointer row; separate from selection. Valid values: (or null (integer 0 *)). Default form: nil. Accessor: hovered-row.") (:p ":value — Selected zero-based index, or NIL. Valid values: (or null (integer 0 *)). Default form: nil. Accessor: value.") (:p ":scroll-offset — Vertical scroll in pixels. Valid values: (real 0 *). Default form: 0. Accessor: scroll-offset.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:list-view)"))))
(:entry "class/menu-bar" :names ("MENU-BAR") :kind :class :kind-name "Class" :package "LUT" :summary "Horizontal container of menu buttons." :sections (("Description" (:p "Horizontal container of menu buttons.")) ("Superclasses" (:p "(header-bar)")) ("Initargs, defaults and valid values" (:p ":orientation — Default horizontal orientation. Valid values: (member :horizontal :vertical). Default form: :horizontal. Accessor: orientation.") (:p ":spacing — Space between children. Valid values: (real 0 *). Default form: 8. Accessor: spacing.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":disposed-p 