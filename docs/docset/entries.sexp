(:entry "class/anchored-surface" :names ("ANCHORED-SURFACE") :kind :class :kind-name "Class" :package "LUT" :summary "Nonmodal in-window content anchored to an owner caret or root rectangle." :sections (("Description" (:p "Nonmodal in-window content anchored to an owner caret or root rectangle.")) ("Superclasses" (:p "(popover)")) ("Initargs, defaults and valid values" (:p ":anchor-owner — Owner; assigned by SHOW-ANCHORED-SURFACE and released on dismissal. Valid values: (or null widget). Default form: nil. Accessor: anchor-owner.") (:p ":anchor-rectangle — NIL follows an entry caret; otherwise root X Y WIDTH HEIGHT. Valid values: list. Default form: nil. Accessor: anchor-rectangle.") (:p ":dismiss-on-blur-p — Dismiss when focus moves away from the owner. Valid values: boolean. Default form: t. Accessor: dismiss-on-blur-p.") (:p ":anchor-root — Internal input scope saved when shown. Valid values: (or null widget). Default form: nil. Accessor: anchor-root.") (:p ":anchor-position — Internal resolved placement. Valid values: (member :above :below). Default form: :below. Accessor: anchor-position.") (:p ":requested-width — Internal preferred popup width before viewport clamping. Valid values: (or null real). Default form: nil. Accessor: requested-width.") (:p ":requested-height — Internal preferred popup height before viewport clamping. Valid values: (or null real). Default form: nil. Accessor: requested-height.") (:p ":surface-pressed-item — Internal suggestion pointer capture. Valid values: (or null integer). Default form: nil. Accessor: surface-pressed-item.") (:p ":popup-owner — Control owning this popup, when applicable. Valid values: (or null widget). Default form: nil. Accessor: popup-owner.") (:p ":position-mode — Popup position is in root pixels. Valid values: (member :center :absolute). Default form: :absolute. Accessor: position-mode.") (:p ":draggable-p — Popups do not drag by default. Valid values: boolean. Default form: nil. Accessor: draggable-p.") (:p ":modal-p — Block input to the owner while this native dialog is open. Valid values: boolean. Default form: t. Accessor: modal-p.") (:p ":native-p — Backend-managed native dialog presentation. Valid values: boolean. Default form: nil. Accessor: native-p.") (:p ":text — Dialog title. Valid values: string. Default form: \"Dialog\". Accessor: text.") (:p ":detach-on-drag-p — Detach as a native window when dragged beyond the root bounds. Valid values: boolean. Default form: t. Accessor: detach-on-drag-p.") (:p ":orientation — Stack direction. Valid values: (member :vertical :horizontal). Default form: :vertical. Accessor: orientation.") (:p ":spacing — Space between children. Valid values: (real 0 *). Default form: 8. Accessor: spacing.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:anchored-surface)"))))
(:entry "class/box" :names ("BOX") :kind :class :kind-name "Class" :package "LUT" :summary "Linear layout container." :sections (("Description" (:p "Linear layout container.")) ("Superclasses" (:p "(widget)")) ("Initargs, defaults and valid values" (:p ":orientation — Stack direction. Valid values: (member :vertical :horizontal). Default form: :vertical. Accessor: orientation.") (:p ":spacing — Space between children. Valid values: (real 0 *). Default form: 8. Accessor: spacing.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:box)"))))
(:entry "class/button" :names ("BUTTON") :kind :class :kind-name "Class" :package "LUT" :summary "Activates on pointer release inside or Space/Enter; emits :ACTIVATE." :sections (("Description" (:p "Activates on pointer release inside or Space/Enter; emits :ACTIVATE.")) ("Superclasses" (:p "(label)")) ("Initargs, defaults and valid values" (:p ":text — Displayed text. Valid values: string. Default form: \"\". Accessor: text.") (:p ":text-root — Internal indexed text cache. Valid values: t. Default form: nil. Accessor: text-root.") (:p ":indexed-string — Internal source identity for standalone indexing. Valid values: (or null string). Default form: nil. Accessor: indexed-string.") (:p ":geometry-cache — Internal bounded line measurement cache. Valid values: list. Default form: nil. Accessor: geometry-cache.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:button)"))))
(:entry "class/check-button" :names ("CHECK-BUTTON") :kind :class :kind-name "Class" :package "LUT" :summary "Boolean toggle; emits :CHANGE after updating VALUE." :sections (("Description" (:p "Boolean toggle; emits :CHANGE after updating VALUE.")) ("Superclasses" (:p "(button)")) ("Initargs, defaults and valid values" (:p ":value — Checked state. Valid values: boolean. Default form: nil. Accessor: value.") (:p ":text — Displayed text. Valid values: string. Default form: \"\". Accessor: text.") (:p ":text-root — Internal indexed text cache. Valid values: t. Default form: nil. Accessor: text-root.") (:p ":indexed-string — Internal source identity for standalone indexing. Valid values: (or null string). Default form: nil. Accessor: indexed-string.") (:p ":geometry-cache — Internal bounded line measurement cache. Valid values: list. Default form: nil. Accessor: geometry-cache.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding