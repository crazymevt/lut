(:entry "class/color-chooser" :names ("COLOR-CHOOSER") :kind :class :kind-name "Class" :package "LUT" :summary "RGBA color chooser built from numeric channel controls." :sections (("Description" (:p "RGBA color chooser built from numeric channel controls.")) ("Superclasses" (:p "(dialog)")) ("Initargs, defaults and valid values" (:p ":value — Four integer channels, each 0..255. Valid values: list. Default form: '(0 0 0 255). Accessor: value.") (:p ":text — Dialog title. Valid values: string. Default form: \"Dialog\". Accessor: text.") (:p ":position-mode — Centered until dragged, then absolute coordinates. Valid values: (member :center :absolute). Default form: :center. Accessor: position-mode.") (:p ":draggable-p — Drag unoccupied dialog surface to move it. Valid values: boolean. Default form: t. Accessor: draggable-p.") (:p ":detach-on-drag-p — Detach as a native window when dragged beyond the root bounds. Valid values: boolean. Default form: t. Accessor: detach-on-drag-p.") (:p ":orientation — Stack direction. Valid values: (member :vertical :horizontal). Default form: :vertical. Accessor: orientation.") (:p ":spacing — Space between children. Valid values: (real 0 *). Default form: 8. Accessor: spacing.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real