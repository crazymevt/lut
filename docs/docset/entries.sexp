(:entry "class/box" :names ("BOX") :kind :class :kind-name "Class" :package "LUT" :summary "Linear layout container." :sections (("Description" (:p "Linear layout container.")) ("Superclasses" (:p "(widget)")) ("Initargs, defaults and valid values" (:p ":orientation — Stack direction. Valid values: (member :vertical :horizontal). Default form: :vertical. Accessor: orientation.") (:p ":spacing — Space between children. Valid values: (real 0 *). Default form: 8. Accessor: spacing.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:box)"))))
