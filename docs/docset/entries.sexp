(:entry "class/notebook" :names ("NOTEBOOK") :kind :class :kind-name "Class" :package "LUT" :summary "Tabbed stack; click tab header or use Left/Right to select a page." :sections (("Description" (:p "Tabbed stack; click tab header or use Left/Right to select a page.")) ("Superclasses" (:p "(stack)")) ("Initargs, defaults and valid values" (:p ":items — Tab labels corresponding to children. Valid values: list. Default form: nil. Accessor: items.") (:p ":value — Visible zero-based page index. Valid values: (integer 0 *). Default form: 0. Accessor: value.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections."