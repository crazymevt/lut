(:entry "class/color-chooser" :names ("COLOR-CHOOSER") :kind :class :kind-name "Class" :package "LUT" :summary "RGBA color chooser built from numeric channel controls." :sections (("Description" (:p "RGBA color chooser built from numeric channel controls.")) ("Superclasses" (:p "(dialog)")) ("Initargs, defaults and valid values" (:p ":value — Four integer channels, each 0..255. Valid values: list. Default form: '(0 0 0 255). Accessor: value.") (:p ":modal-p — Block input to the owner while this native dialog is open. Valid values: boolean. Default form: t. Accessor: modal-p.") (:p ":native-p — Backend-managed native dialog presentation. Valid values: boolean. Default form: nil. Accessor: native-p.") (:p ":text — Dialog title. Valid values: string. Default form: \"Dialog\". Accessor: text.") (:p ":position-mode — Centered until dragged, then absolute coordinates. Valid values: (member :center :absolute). Default form: :center. Accessor: position-mode.") (:p ":draggable-p — Drag unoccupied dialog surface to move it. Valid values: boolean. Default form: t. Accessor: draggable-p.") (:p ":detach-on-drag-p — Detach as a native window when dragged beyond the root bounds. Valid values: boolean. Default form: t. Accessor: detach-on-drag-p.") (:p ":orientation — Stack direction. Valid values: (member :vertical :horizontal). Default form: :vertical. Accessor: orientation.") (:p ":spacing — Space between children. Valid values: (real 0 *). Default form: 8. Accessor: spacing.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:color-chooser)"))))
(:entry "class/column-view" :names ("COLUMN-VIEW") :kind :class :kind-name "Class" :package "LUT" :summary "Table with user-supplied column headings and rows." :sections (("Description" (:p "Table with user-supplied column headings and rows.")) ("Superclasses" (:p "(table-view)")) ("Initargs, defaults and valid values" (:p ":columns — Column header strings. Valid values: list. Default form: nil. Accessor: columns.") (:p ":rows — Rows, each a list of printable cell values. Valid values: list. Default form: nil. Accessor: rows.") (:p ":items — Strings displayed as rows. Valid values: list. Default form: nil. Accessor: items.") (:p ":hovered-row — Internal pointer row; separate from selection. Valid values: (or null (integer 0 *)). Default form: nil. Accessor: hovered-row.") (:p ":value — Selected zero-based index, or NIL. Valid values: (or null (integer 0 *)). Default form: nil. Accessor: value.") (:p ":scroll-offset — Vertical scroll in pixels. Valid values: (real 0 *). Default form: 0. Accessor: scroll-offset.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:column-view)"))))
(:entry "class/combo-box" :names ("COMBO-BOX") :kind :class :kind-name "Class" :package "LUT" :summary "Editable selection with suggested string ITEMS." :sections (("Description" (:p "Editable selection with suggested string ITEMS.")) ("Superclasses" (:p "(entry)")) ("Initargs, defaults and valid values" (:p ":items — Available completion strings. Valid values: list. Default form: nil. Accessor: items.") (:p ":expanded-p — Whether the option popup is open. Valid values: boolean. Default form: nil. Accessor: expanded-p.") (:p ":view-buffer — Optional shared text model; NIL keeps standalone entry editing. Valid values: (or null text-buffer). Default form: nil. Accessor: view-buffer.") (:p ":read-only-p — Prevent editing in this view while permitting selection and copying. Valid values: boolean. Default form: nil. Accessor: read-only-p.") (:p ":cursor — Insertion position. Valid values: (integer 0 *). Default form: 0. Accessor: cursor.") (:p ":anchor — Other end of selection. Valid values: (integer 0 *). Default form: 0. Accessor: anchor.") (:p ":text-offset — Horizontal text viewport offset in pixels. Valid values: (real 0 *). Default form: 0. Accessor: text-offset.") (:p ":vertical-offset — Vertical multiline text viewport offset in pixels. Valid values: (real 0 *). Default form: 0. Accessor: vertical-offset.") (:p ":undo-history — Internal prior range edit records. Valid values: list. Default form: nil. Accessor: undo-history.") (:p ":redo-history — Internal undone range edit records. Valid values: list. Default form: nil. Accessor: redo-history.") (:p ":history-limit — Maximum range records per undo/redo stack; zero disables history. Valid values: (integer 0 *). Default form: 100. Accessor: history-limit.") (:p ":history-character-limit — Maximum removed plus inserted characters retained per history stack; zero disables retention. Valid values: (integer 0 *). Default form: 262144. Accessor: history-character-limit.") (:p ":last-cursor — Internal previous caret position for viewport tracking. Valid values: (integer -1 *). Default form: -1. Accessor: last-cursor.") (:p ":navigation-x — Internal preferred horizontal pixel position for vertical navigation. Valid values: (or null real). Default form: nil. Accessor: navigation-x.") (:p ":text — Displayed text. Valid values: string. Default form: \"\". Accessor: text.") (:p ":text-root — Internal indexed text cache. Valid values: t. Default form: nil. Accessor: text-root.") (:p ":indexed-string — Internal source identity for standalone indexing. Valid values: (or null string). Default form: nil. Accessor: indexed-string.") (:p ":geometry-cache — Internal bounded line measurement cache. Valid values: list. Default form: nil. Accessor: geometry-cache.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:combo-box)"))))
(:entry "class/command" :names ("COMMAND") :kind :class :kind-name "Class" :package "LUT" :summary "Nonvisual reusable action with a label, shortcut and context-sensitive availability." :sections (("Description" (:p "Nonvisual reusable action with a label, shortcut and context-sensitive availability.")) ("Superclasses" (:p "(widget)")) ("Initargs, defaults and valid values" (:p ":command-label — Caption shared by bound buttons and menu buttons. Valid values: string. Default form: \"\". Accessor: command-label.") (:p ":command-action — Function designator taking (command context). Valid values: (or null function symbol). Default form: nil. Accessor: command-action.") (:p ":command-predicate — Optional pure function (command context); true enables execution. Valid values: (or null function symbol). Default form: nil. Accessor: command-predicate.") (:p ":command-shortcut — Normalized key keyword, or exact (:KEY key :CONTROL bool :ALT bool :SUPER bool :SHIFT bool) spec. Valid values: (or null symbol list). Default form: nil. Accessor: command-shortcut.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:command)"))))
(:entry "class/context-menu" :names ("CONTEXT-MENU") :kind :class :kind-name "Class" :package "LUT" :summary "Reusable modal menu of ordinary buttons." :sections (("Description" (:p "Reusable modal menu of ordinary buttons.")) ("Superclasses" (:p "(dialog)")) ("Initargs, defaults and valid values" (:p ":modal-p — Block input to the owner while this native dialog is open. Valid values: boolean. Default form: t. Accessor: modal-p.") (:p ":native-p — Backend-managed native dialog presentation. Valid values: boolean. Default form: nil. Accessor: native-p.") (:p ":text — Dialog title. Valid values: string. Default form: \"Dialog\". Accessor: text.") (:p ":position-mode — Centered until dragged, then absolute coordinates. Valid values: (member :center :absolute). Default form: :center. Accessor: position-mode.") (:p ":draggable-p — Drag unoccupied dialog surface to move it. Valid values: boolean. Default form: t. Accessor: draggable-p.") (:p ":detach-on-drag-p — Detach as a native window when dragged beyond the root bounds. Valid values: boolean. Default form: t. Accessor: detach-on-drag-p.") (:p ":orientation — Stack direction. Valid values: (member :vertical :horizontal). Default form: :vertical. Accessor: orientation.") (:p ":spacing — Space between children. Valid values: (real 0 *). Default form: 8. Accessor: spacing.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:context-menu)"))))
(:entry "class/dialog" :names ("DIALOG") :kind :class :kind-name "Class" :package "LUT" :summary "Dialog surface; the raylib backend opens it in a native worker window." :sections (("Description" (:p "Dialog surface; the raylib backend opens it in a native worker window.")) ("Superclasses" (:p "(box)")) ("Initargs, defaults and valid values" (:p ":modal-p — Block input to the owner while this native dialog is open. Valid values: boolean. Default form: t. Accessor: modal-p.") (:p ":native-p — Backend-managed native dialog presentation. Valid values: boolean. Default form: nil. Accessor: native-p.") (:p ":text — Dialog title. Valid values: string. Default form: \"Dialog\". Accessor: text.") (:p ":position-mode — Centered until dragged, then absolute coordinates. Valid values: (member :center :absolute). Default form: :center. Accessor: position-mode.") (:p ":draggable-p — Drag unoccupied dialog surface to move it. Valid values: boolean. Default form: t. Accessor: draggable-p.") (:p ":detach-on-drag-p — Detach as a native window when dragged beyond the root bounds. Valid values: boolean. Default form: t. Accessor: detach-on-drag-p.") (:p ":orientation — Stack direction. Valid values: (member :vertical :horizontal). Default form: :vertical. Accessor: orientation.") (:p ":spacing — Space between children. Valid values: (real 0 *). Default form: 8. Accessor: spacing.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:dialog)"))))
(:entry "class/document-view" :names ("DOCUMENT-VIEW") :kind :class :kind-name "Class" :package "LUT" :summary "Read-only selectable document; applications supply text, links, images and formatting." :sections (("Description" (:p "Read-only selectable document; applications supply text, links, images and formatting.")) ("Superclasses" (:p "(styled-text-view)")) ("Initargs, defaults and valid values" (:p ":read-only-p — Document views always reject interactive edits; programmatic TEXT refresh is permitted. Valid values: boolean. Default form: t. Accessor: read-only-p.") (:p ":history-limit — Standalone document refreshes do not retain undo by default; shared models keep their own policy. Valid values: (integer 0 *). Default form: 0. Accessor: history-limit.") (:p ":gutter-width — Reserved left gutter width in pixels. Valid values: (real 0 *). Default form: 0. Accessor: gutter-width.") (:p ":presentation-runs — Internal disjoint style intervals. Valid values: vector. Default form: #(). Accessor: presentation-runs.") (:p ":presentation-decorations — Internal overlapping decoration intervals. Valid values: vector. Default form: #(). Accessor: presentation-decorations.") (:p ":decoration-max-ends — Internal decoration prefix interval index. Valid values: vector. Default form: #(). Accessor: decoration-max-ends.") (:p ":presentation-links — Internal disjoint application link intervals. Valid values: vector. Default form: #(). Accessor: presentation-links.") (:p ":presentation-images — Internal inline-image character records. Valid values: vector. Default form: #(). Accessor: presentation-images.") (:p ":presentation-revision — Internal presentation cache generation. Valid values: (integer 0 *). Default form: 0. Accessor: presentation-revision.") (:p ":pressed-document-link — Internal link pointer capture. Valid values: t. Default form: nil. Accessor: pressed-document-link.") (:p ":view-buffer — Optional shared text model; NIL keeps standalone entry editing. Valid values: (or null text-buffer). Default form: nil. Accessor: view-buffer.") (:p ":cursor — Insertion position. Valid values: (integer 0 *). Default form: 0. Accessor: cursor.") (:p ":anchor — Other end of selection. Valid values: (integer 0 *). Default form: 0. Accessor: anchor.") (:p ":text-offset — Horizontal text viewport offset in pixels. Valid values: (real 0 *). Default form: 0. Accessor: text-offset.") (:p ":vertical-offset — Vertical multiline text viewport offset in pixels. Valid values: (real 0 *). Default form: 0. Accessor: vertical-offset.") (:p ":undo-history — Internal prior range edit records. Valid values: list. Default form: nil. Accessor: undo-history.") (:p ":redo-history — Internal undone range edit records. Valid values: list. Default form: nil. Accessor: redo-history.") (:p ":history-character-limit — Maximum removed plus inserted characters retained per history stack; zero disables retention. Valid values: (integer 0 *). Default form: 262144. Accessor: history-character-limit.") (:p ":last-cursor — Internal previous caret position for viewport tracking. Valid values: (integer -1 *). Default form: -1. Accessor: last-cursor.") (:p ":navigation-x — Internal preferred horizontal pixel position for vertical navigation. Valid values: (or null real). Default form: nil. Accessor: navigation-x.") (:p ":text — Displayed text. Valid values: string. Default form: \"\". Accessor: text.") (:p ":text-root — Internal indexed text cache. Valid values: t. Default form: nil. Accessor: text-root.") (:p ":indexed-string — Internal source identity for standalone indexing. Valid values: (or null string). Default form: nil. Accessor: indexed-string.") (:p ":geometry-cache — Internal bounded line measurement cache. Valid values: list. Default form: nil. Accessor: geometry-cache.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:document-view)"))))
(:entry "class/drawing-area" :names ("DRAWING-AREA") :kind :class :kind-name "Class" :package "LUT" :summary "Custom drawing callback receives widget during rendering." :sections (("Description" (:p "Custom drawing callback receives widget during rendering.")) ("Superclasses" (:p "(widget)")) ("Initargs, defaults and valid values" (:p ":draw-function — Backend-specific drawing callback. Valid values: (or null function). Default form: nil. Accessor: draw-function.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: lis