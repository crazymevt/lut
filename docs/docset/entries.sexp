(:entry "class/text-buffer" :names ("TEXT-BUFFER") :kind :class :kind-name "Class" :package "LUT" :summary "Nonvisual text/history model shared by multiple entry or text views." :sections (("Description" (:p "Nonvisual text/history model shared by multiple entry or text views.")) ("Superclasses" (:p "(widget)")) ("Initargs, defaults and valid values" (:p ":text-root — Internal immutable indexed text tree. Valid values: t. Default form: nil. Accessor: text-root.") (:p ":text-snapshot-p — Internal full-string snapshot validity. Valid values: boolean. Default form: t. Accessor: text-snapshot-p.") (:p ":text — Shared contents; use range edits or SETF TEXT rather than mutating the returned string. Valid values: string. Default form: \"\". Accessor: text.") (:p ":read-only-p — Disable editing APIs; programmatic SETF TEXT remains available for application refresh. Valid values: boolean. Default form: nil. Accessor: read-only-p.") (:p ":undo-history — Internal shared range-based undo records. Valid values: list. Default form: nil. Accessor: undo-history.") (:p ":redo-history — Internal shared range-based redo records. Valid values: list. Default form: nil. Accessor: redo-history.") (:p ":history-limit — Maximum range records in each shared history stack. Valid values: (integer 0 *). Default form: 100. Accessor: history-limit.") (:p ":history-character-limit — Maximum removed plus inserted characters retained in each shared history stack. Valid values: (integer 0 *). Default form: 262144. Accessor: history-character-limit.") (:p ":revision — Internal monotonically increasing content revision. Valid values: (integer 0 *). Default form: 0. Accessor: revision.") (:p ":buffer-views — Internal attached views; disposal/detachment releases these references. Valid values: list. Default form: nil. Accessor: buffer-views.") (:p ":buffer-notifying-p — Internal guard against reentrant edits during change notification. Valid values: boolean. Default form: nil. Accessor: buffer-notifying-p.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:text-buffer)"))))
(:entry "class/text-view" :names ("TEXT-VIEW") :kind :class :kind-name "Class" :package "LUT" :summary "Multiline editable text; Enter inserts a newline." :sections (("Description" (:p "Multiline editable text; Enter inserts a newline.")) ("Superclasses" (:p "(entry)")) ("Initargs, defaults and valid values" (:p ":view-buffer — Optional shared text model; NIL keeps standalone entry editing. Valid values: (or null text-buffer). Default form: nil. Accessor: view-buffer.") (:p ":read-only-p — Prevent editing in this view while permitting selection and copying. Valid values: boolean. Default form: nil. Accessor: read-only-p.") (:p ":cursor — Insertion position. Valid values: (integer 0 *). Default form: 0. Accessor: cursor.") (:p ":anchor — Other end of selection. Valid values: (integer 0 *). Default form: 0. Accessor: anchor.") (:p ":text-offset — Horizontal text viewport offset in pixels. Valid values: (real 0 *). Default form: 0. Accessor: text-offset.") (:p ":vertical-offset — Vertical multiline text viewport offset in pixels. Valid values: (real 0 *). Default form: 0. Accessor: vertical-offset.") (:p ":undo-history — Internal prior range edit records. Valid values: list. Default form: nil. Accessor: undo-history.") (:p ":redo-history — Internal undone range edit records. Valid values: list. Default form: nil. Accessor: redo-history.") (:p ":history-limit — Maximum range records per undo/redo stack; zero disables history. Valid values: (integer 0 *). Default form: 100. Accessor: history-limit.") (:p ":history-character-limit — Maximum removed plus inserted characters retained per history stack; zero disables retention. Valid values: (integer 0 *). Default form: 262144. Accessor: history-character-limit.") (:p ":last-cursor — Internal previous caret position for viewport tracking. Valid values: (integer -1 *). Default form: -1. Accessor: last-cursor.") (:p ":navigation-x — Internal preferred horizontal pixel position for vertical navigation. Valid values: (or null real). Default form: nil. Accessor: navigation-x.") (:p ":text — Displayed text. Valid values: string. Default form: \"\". Accessor: text.") (:p ":text-root — Internal indexed text cache. Valid values: t. Default form: nil. Accessor: text-root.") (:p ":indexed-string — Internal source identity for standalone indexing. Valid values: (or null string). Default form: nil. Accessor: indexed-string.") (:p ":geometry-cache — Internal bounded line measurement cache. Valid values: list. Default form: nil. Accessor: geometry-cache.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:text-view)"))))
(:entry "class/toggle-button" :names ("TOGGLE-BUTTON") :kind :class :kind-name "Class" :package "LUT" :summary "Persistent on/off button; VALUE is boolean." :sections (("Description" (:p "Persistent on/off button; VALUE is boolean.")) ("Superclasses" (:p "(check-button)")) ("Initargs, defaults and valid values" (:p ":value — Checked state. Valid values: boolean. Default form: nil. Accessor: value.") (:p ":text — Displayed text. Valid values: string. Default form: \"\". Accessor: text.") (:p ":text-root — Internal indexed text cache. Valid values: t. Default form: nil. Accessor: text-root.") (:p ":indexed-string — Internal source identity for standalone indexing. Valid values: (or null string). Default form: nil. Accessor: indexed-string.") (:p ":geometry-cache — Internal bounded line measurement cache. Valid values: list. Default form: nil. Accessor: geometry-cache.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:toggle-button)"))))
(:entry "class/tooltip" :names ("TOOLTIP") :kind :class :kind-name "Class" :package "LUT" :summary "Noninteractive tooltip surface." :sections (("Description" (:p "Noninteractive tooltip surface.")) ("Superclasses" (:p "(popover)")) ("Initargs, defaults and valid values" (:p ":popup-owner — Control owning this popup, when applicable. Valid values: (or null widget). Default form: nil. Accessor: popup-owner.") (:p ":position-mode — Popup position is in root pixels. Valid values: (member :center :absolute). Default form: :absolute. Accessor: position-mode.") (:p ":draggable-p — Popups do not drag by default. Valid values: boolean. Default form: nil. Accessor: draggable-p.") (:p ":modal-p — Block input to the owner while this native dialog is open. Valid values: boolean. Default form: t. Accessor: modal-p.") (:p ":native-p — Backend-managed native dialog presentation. Valid values: boolean. Default form: nil. Accessor: native-p.") (:p ":text — Dialog title. Valid values: string. Default form: \"Dialog\". Accessor: text.") (:p ":detach-on-drag-p — Detach as a native window when dragged beyond the root bounds. Valid values: boolean. Default form: t. Accessor: detach-on-drag-p.") (:p ":orientation — Stack direction. Valid values: (member :vertical :horizontal). Default form: :vertical. Accessor: orientation.") (:p ":spacing — Space between children. Valid values: (real 0 *). Default form: 8. Accessor: spacing.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:tooltip)"))))
(:entry "class/tree-view" :names ("TREE-VIEW") :kind :class :kind-name "Class" :package "LUT" :summary "Expandable tree. NODES are (:TEXT string :CHILDREN nodes :OPEN boolean)." :sections (("Description" (:p "Expandable tree. NODES are (:TEXT string :CHILDREN nodes :OPEN boolean).")) ("Superclasses" (:p "(list-view)")) ("Initargs, defaults and valid values" (:p ":nodes — Nested node property lists; expansion is stored in each node. Valid values: list. Default form: nil. Accessor: nodes.") (:p ":items — Strings displayed as rows. Valid values: list. Default form: nil. Accessor: items.") (:p ":hovered-row — Internal pointer row; separate from selection. Valid values: (or null (integer 0 *)). Default form: nil. Accessor: hovered-row.") (:p ":value — Selected zero-based index, or NIL. Valid values: (or null (integer 0 *)). Default form: nil. Accessor: value.") (:p ":scroll-offset — Vertical scroll in pixels. Valid values: (real 0 *). Default form: 0. Accessor: scroll-offset.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:tree-view)"))))
(:entry "class/widget" :names ("WIDGET") :kind :class :kind-name "Class" :package "LUT" :summary "Base node. Geometry is in logical pixels; styles inherit through parents." :sections (("Description" (:p "Base node. Geometry is in logical pixels; styles inherit through parents.")) ("Superclasses" (:p "nil")) ("Initargs, defaults and valid values" (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:widget)"))))
(:entry "class/window" :names ("WINDOW") :kind :class :kind-name "Class" :package "LUT" :summary "Root of a GUI tree. One native raylib window per process." :sections (("Description" (:p "Root of a GUI tree. One native raylib window per process.")) ("Superclasses" (:p "(box)")) ("Initargs, defaults and valid values" (:p ":text — Native title. Valid values: string. Default form: \"LUT\". Accessor: text.") (:p ":theme — Inherited theme property list. Valid values: list. Default form: *light-theme*. Accessor: theme.") (:p ":theme-explicit-p — Internal flag distinguishing an explicit theme from the default palette. Valid values: boolean. Default form: nil. Accessor: theme-explicit-p.") (:p ":ui-scale — Application UI zoom; layout, geometry and dispatched events remain in logical UI units. Valid values: (real (0) *). Default form: 1. Accessor: ui-scale.") (:p ":platform-resources — Internal owned menu and path-request handles. Valid values: list. Default form: nil. Accessor: platform-resources.") (:p ":style-source — Optional application window whose styles, selectors and theme are inherited across native windows. Valid values: (or null window). Default form: nil. Accessor: style-source.") (:p ":style-rules — Ordered rules: (:CLASS class :STATE state-or-NIL :STYLE token-plist). Later rules win. Valid values: list. Default form: nil. Accessor: style-rules.") (:p ":content-layout — BOX stacks children; FILL allocates every child the root content rectangle. Valid values: (member :box :fill). Default form: :box. Accessor: content-layout.") (:p ":focus-visible-p — Whether to draw keyboard focus feedback. Valid values: boolean. Default form: t. Accessor: focus-visible-p.") (:p ":focused-widget — Keyboard focus within this root. Valid values: (or null widget). Default form: nil. Accessor: focused-widget.") (:p ":overlays — Internal modal dialog stack. Valid values: list. Default form: nil. Accessor: overlays.") (:p ":pressed-widget — Internal pointer capture. Valid values: (or null widget). Default form: nil. Accessor: pressed-widget.") (:p ":drag-context — Internal pending or active drag session. Valid values: t. Default form: nil. Accessor: drag-context.") (:p ":interaction-state — Internal pointer gesture state. Valid values: list. Default form: nil. Accessor: interaction-state.") (:p ":text-selection-state — Internal captured text selection gesture. Valid values: list. Default form: nil. Accessor: text-selection-state.") (:p ":text-click-state — Internal repeated-click target, time and coordinates. Valid values: list. Default form: nil. Accessor: text-click-state.") (:p ":orientation — Stack direction. Valid values: (member :vertical :horizontal). Default form: :vertical. Accessor: orientation.") (:p ":spacing — Space between children. Valid values: (real 0 *). Default form: 8. Accessor: spacing.") (:p ":id — Optional application identifier used by FIND-WIDGET. Valid values: (or null string symbol). Default form: nil. Accessor: id.") (:p ":parent — Managed by ADD-CHILD; do not assign directly. Valid values: (or null widget). Default form: nil. Accessor: parent.") (:p ":children — Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. Valid values: list. Default form: nil. Accessor: children.") (:p ":x — Allocated horizontal position. Valid values: real. Default form: 0. Accessor: x.") (:p ":y — Allocated vertical position. Valid values: real. Default form: 0. Accessor: y.") (:p ":width — Preferred width; containers allocate available width. Valid values: (real 0 *). Default form: 160. Accessor: width.") (:p ":height — Preferred height. Valid values: (real 0 *). Default form: 36. Accessor: height.") (:p ":visible-p — NIL excludes this subtree from layout, drawing and input. Valid values: boolean. Default form: t. Accessor: visible-p.") (:p ":enabled-p — NIL disables input for this subtree. Valid values: boolean. Default form: t. Accessor: enabled-p.") (:p ":style — Property list overriding inherited theme tokens. Valid values: list. Default form: nil. Accessor: style.") (:p ":handlers — Internal event connection table. Valid values: list. Default form: nil. Accessor: handlers.") (:p ":connections — Connections to other sources owned by this widget. Valid values: list. Default form: nil. Accessor: connections.") (:p ":command-links — Internal command bindings referencing this widget. Valid values: list. Default form: nil. Accessor: command-links.") (:p ":disposed-p — True after idempotent disposal; disposed widgets cannot be adopted or rebound. Valid values: boolean. Default form: nil. Accessor: disposed-p.") (:p ":state-style — State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. Valid values: list. Default form: nil. Accessor: state-style.") (:p ":tooltip-text — Optional help shown while the pointer hovers over this widget. Valid values: (or null string). Default form: nil. Accessor: tooltip-text.") (:p ":hovered-p — Pointer is over this widget. Valid values: boolean. Default form: nil. Accessor: hovered-p.") (:p ":pressed-p — Pointer is captured by this widget. Valid values: boolean. Default form: nil. Accessor: pressed-p.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:window)"))))
(:entry "event/accept" :names (":ACCEPT") :kind :event :kind-name "Event" :package "LUT" :summary "SUGGESTION-SURFACE: original candidate object after dismissal; no automatic text edit or command execution. Observer errors propagate after dismissal and can prevent later notifications." :sections (("Payload and ordering" (:p "SUGGESTION-SURFACE: original candidate object after dismissal; no automatic text edit or command execution. Observer errors propagate after dismissal and can prevent later notifications.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :accept (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/activate" :names (":ACTIVATE") :kind :event :kind-name "Event" :package "LUT" :summary "Button, check, toggle, radio: NIL. Entry: NIL on Enter. Check state changes before activation." :sections (("Payload and ordering" (:p "Button, check, toggle, radio: NIL. Entry: NIL on Enter. Check state changes before activation.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :activate (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/cell-edit-cancel" :names (":CELL-EDIT-CANCEL") :kind :event :kind-name "Event" :package "LUT" :summary "MODEL-TABLE-VIEW: plist :KEY :COLUMN :REASON after editor disposal without setter. Reasons include :CANCEL/:REPLACE/:MODEL-CHANGE/:SELECTION/:VIEWPORT/:DISPOSE. Disposal uses ordinary disposed-widget event suppression." :sections (("Payload and ordering" (:p "MODEL-TABLE-VIEW: plist :KEY :COLUMN :REASON after editor disposal without setter. Reasons include :CANCEL/:REPLACE/:MODEL-CHANGE/:SELECTION/:VIEWPORT/:DISPOSE. Disposal uses ordinary disposed-widget event suppression.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :cell-edit-cancel (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/cell-edit-commit" :names (":CELL-EDIT-COMMIT") :kind :event :kind-name "Event" :package "LUT" :summary "MODEL-TABLE-VIEW: plist :KEY :COLUMN :OLD-VALUE :TEXT after setter success, editor disposal and underlying source notification. Setter errors leave editor open. Observer errors do not roll back data." :sections (("Payload and ordering" (:p "MODEL-TABLE-VIEW: plist :KEY :COLUMN :OLD-VALUE :TEXT after setter success, editor disposal and underlying source notification. Setter errors leave editor open. Observer errors do not roll back data.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :cell-edit-commit (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/cell-edit-start" :names (":CELL-EDIT-START") :kind :event :kind-name "Event" :package "LUT" :summary "MODEL-TABLE-VIEW: plist :KEY :COLUMN :OLD-VALUE after entry creation/focus. Application column factories and setters supply presentation/edit policy." :sections (("Payload and ordering" (:p "MODEL-TABLE-VIEW: plist :KEY :COLUMN :OLD-VALUE after entry creation/focus. Application column factories and setters supply presentation/edit policy.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :cell-edit-start (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/change" :names (":CHANGE") :kind :event :kind-name "Event" :package "LUT" :summary "Entry: complete string; slider/spin: new real; check/radio/switch: boolean; list/table/stack/notebook: zero-based integer index." :sections (("Payload and ordering" (:p "Entry: complete string; slider/spin: new real; check/radio/switch: boolean; list/table/stack/notebook: zero-based integer index.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :change (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/context" :names (":CONTEXT") :kind :event :kind-name "Event" :package "LUT" :summary "Target widget: normalized EVENT with pointer X/Y. A registered handler replaces the default entry context menu." :sections (("Payload and ordering" (:p "Target widget: normalized EVENT with pointer X/Y. A registered handler replaces the default entry context menu.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :context (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/context-close" :names (":CONTEXT-CLOSE") :kind :event :kind-name "Event" :package "LUT" :summary "Root window: NIL, while its native context is still current. Release owned GPU/audio resources here; native teardown continues even if a handler signals. CPU widget trees remain usable for a later START." :sections (("Payload and ordering" (:p "Root window: NIL, while its native context is still current. Release owned GPU/audio resources here; native teardown continues even if a handler signals. CPU widget trees remain usable for a later START.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :context-close (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/dismiss" :names (":DISMISS") :kind :event :kind-name "Event" :package "LUT" :summary "ANCHORED-SURFACE: reason keyword (:DISMISS/:ACCEPT/:ESCAPE/:OUTSIDE/:REANCHOR/:MODAL/:OWNER-UNAVAILABLE/:OWNER-DETACHED/:DISPOSE) after owner/scope/capture references are released. Explicit dismissal emits once per shown session; disposal clears quietly under disposed-widget event suppression. Errors do not roll back dismissal." :sections (("Payload and ordering" (:p "ANCHORED-SURFACE: reason keyword (:DISMISS/:ACCEPT/:ESCAPE/:OUTSIDE/:REANCHOR/:MODAL/:OWNER-UNAVAILABLE/:OWNER-DETACHED/:DISPOSE) after owner/scope/capture references are released. Explicit dismissal emits once per shown session; disposal clears quietly under disposed-widget event suppression. Errors do not roll back dismissal.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :dismiss (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/drag-end" :names (":DRAG-END") :kind :event :kind-name "Event" :package "LUT" :summary "Source: DRAG-SESSION with :DROPPED/:REJECTED/:CANCELLED. Source, target and payload references are cleared after terminal callbacks." :sections (("Payload and ordering" (:p "Source: DRAG-SESSION with :DROPPED/:REJECTED/:CANCELLED. Source, target and payload references are cleared after terminal callbacks.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :drag-end (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/drag-enter" :names (":DRAG-ENTER") :kind :event :kind-name "Event" :package "LUT" :summary "Accepted target: DRAG-SESSION when entering this target. DRAG-TARGET identifies it." :sections (("Payload and ordering" (:p "Accepted target: DRAG-SESSION when entering this target. DRAG-TARGET identifies it.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :drag-enter (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/drag-leave" :names (":DRAG-LEAVE") :kind :event :kind-name "Event" :package "LUT" :summary "Previous target: DRAG-SESSION when leaving or finishing; DRAG-TARGET can be NIL during a transition." :sections (("Payload and ordering" (:p "Previous target: DRAG-SESSION when leaving or finishing; DRAG-TARGET can be NIL during a transition.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :drag-leave (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/drag-over" :names (":DRAG-OVER") :kind :event :kind-name "Event" :package "LUT" :summary "Accepted target: DRAG-SESSION on movement and release. DRAG-X/Y are current root coordinates." :sections (("Payload and ordering" (:p "Accepted target: DRAG-SESSION on movement and release. DRAG-X/Y are current root coordinates.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :drag-over (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/drag-start" :names (":DRAG-START") :kind :event :kind-name "Event" :package "LUT" :summary "Source: DRAG-SESSION after the movement threshold. No drag lifecycle events are emitted for an ordinary click." :sections (("Payload and ordering" (:p "Source: DRAG-SESSION after the movement threshold. No drag lifecycle events are emitted for an ordinary click.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :drag-start (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/drop" :names (":DROP") :kind :event :kind-name "Event" :package "LUT" :summary "Successful target: DRAG-SESSION after PERFORM-DROP returns true, with state :DROPPED. Rejected drops do not emit this event." :sections (("Payload and ordering" (:p "Successful target: DRAG-SESSION after PERFORM-DROP returns true, with state :DROPPED. Rejected drops do not emit this event.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :drop (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/edit" :names (":EDIT") :kind :event :kind-name "Event" :package "LUT" :summary "TEXT-BUFFER: BUFFER-EDIT after text and all attached view positions have been synchronized. Then the buffer and each still-attached live view emit :CHANGE with the new text. Reentrant edits to this buffer are rejected; queue follow-up edits." :sections (("Payload and ordering" (:p "TEXT-BUFFER: BUFFER-EDIT after text and all attached view positions have been synchronized. Then the buffer and each still-attached live view emit :CHANGE with the new text. Reentrant edits to this buffer are rejected; queue follow-up edits.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :edit (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/gesture" :names (":GESTURE") :kind :event :kind-name "Event" :package "LUT" :summary "Normalized input KIND :GESTURE is delivered through HANDLE-EVENT at the pointer target. EVENT-KEY is :TAP/:DOUBLETAP/:HOLD/:DRAG/:SWIPE-LEFT/:SWIPE-RIGHT/:SWIPE-UP/:SWIPE-DOWN/:PINCH-IN/:PINCH-OUT. DELTA is hold seconds or pinch angle in degrees, otherwise zero. Worker windows forward the same event fields. Devices/backend may expose a subset." :sections (("Payload and ordering" (:p "Normalized input KIND :GESTURE is delivered through HANDLE-EVENT at the pointer target. EVENT-KEY is :TAP/:DOUBLETAP/:HOLD/:DRAG/:SWIPE-LEFT/:SWIPE-RIGHT/:SWIPE-UP/:SWIPE-DOWN/:PINCH-IN/:PINCH-OUT. DELTA is hold seconds or pinch angle in degrees, otherwise zero. Worker windows forward the same event fields. Devices/backend may expose a subset.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :gesture (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/history-overflow" :names (":HISTORY-OVERFLOW") :kind :event :kind-name "Event" :package "LUT" :summary "Standalone entry or shared TEXT-BUFFER: plist :OPERATION (:EDIT/:UNDO/:REDO), :STACK (:UNDO/:REDO), :CHARACTERS and :LIMIT after a committed range record exceeds a positive character budget and positive record limit. The destination stack is empty. Zero limits and ordinary eviction of older records are silent. Shared buffers notify after :EDIT/:CHANGE under the same reentrancy guard; standalone entries notify before the operation's :CHANGE, when applicable. Errors propagate without rolling back committed content/history." :sections (("Payload and ordering" (:p "Standalone entry or shared TEXT-BUFFER: plist :OPERATION (:EDIT/:UNDO/:REDO), :STACK (:UNDO/:REDO), :CHARACTERS and :LIMIT after a committed range record exceeds a positive character budget and positive record limit. The destination stack is empty. Zero limits and ordinary eviction of older records are silent. Shared buffers notify after :EDIT/:CHANGE under the same reentrancy guard; standalone entries notify before the operation's :CHANGE, when applicable. Errors propagate without rolling back committed content/history.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :history-overflow (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/key" :names (":KEY") :kind :event :kind-name "Event" :package "LUT" :summary "Root window: normalized :KEY event before widget dispatch. BIND-KEY consumes a shortcut by setting EVENT-KEY to NIL. Modal dialogs suspend BIND-KEY actions." :sections (("Payload and ordering" (:p "Root window: normalized :KEY event before widget dispatch. BIND-KEY consumes a shortcut by setting EVENT-KEY to NIL. Modal dialogs suspend BIND-KEY actions.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :key (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/link" :names (":LINK") :kind :event :kind-name "Event" :package "LUT" :summary "DOCUMENT-VIEW: the original application :TARGET from a link record after a collapsed single pointer click. Drag/double-click selection does not activate links. LUT does not open URLs or route application navigation." :sections (("Payload and ordering" (:p "DOCUMENT-VIEW: the original application :TARGET from a link record after a collapsed single pointer click. Drag/double-click selection does not activate links. LUT does not open URLs or route application navigation.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :link (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/model-change" :names (":MODEL-CHANGE") :kind :event :kind-name "Event" :package "LUT" :summary "DATA-MODEL: new MODEL-REVISION after committed data/query/tree updates. Source changes refresh projections and reconcile key selections. Reentrant writes are rejected; observer errors propagate after commit and may prevent later notifications." :sections (("Payload and ordering" (:p "DATA-MODEL: new MODEL-REVISION after committed data/query/tree updates. Source changes refresh projections and reconcile key selections. Reentrant writes are rejected; observer errors propagate after commit and may prevent later notifications.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :model-change (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/model-disposing" :names (":MODEL-DISPOSING") :kind :event :kind-name "Event" :package "LUT" :summary "DATA-MODEL: NIL while beginning disposal. Views detach; source disposal disposes dependent projections/selections. All active disposal handlers are attempted before cleanup; the first observer error is then propagated. Recursive disposal is idempotent." :sections (("Payload and ordering" (:p "DATA-MODEL: NIL while beginning disposal. Views detach; source disposal disposes dependent projections/selections. All active disposal handlers are attempted before cleanup; the first observer error is then propagated. Recursive disposal is idempotent.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :model-disposing (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/pages-changed" :names (":PAGES-CHANGED") :kind :event :kind-name "Event" :package "LUT" :summary "Source and destination notebooks (once for reorder): plist :PAGE :SOURCE :TARGET :OLD-INDEX :INDEX after MOVE-PAGE. The transferred page is selected; caption and identity are preserved." :sections (("Payload and ordering" (:p "Source and destination notebooks (once for reorder): plist :PAGE :SOURCE :TARGET :OLD-INDEX :INDEX after MOVE-PAGE. The transferred page is selected; caption and identity are preserved.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :pages-changed (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/presentation-change" :names (":PRESENTATION-CHANGE") :kind :event :kind-name "Event" :package "LUT" :summary "STYLED-TEXT-VIEW/DOCUMENT-VIEW: presentation revision after an explicit SET-TEXT-PRESENTATION, INVALIDATE-TEXT-PRESENTATION or gutter-width update. Content edits remap/drop records quietly before existing content notifications; they do not emit this event." :sections (("Payload and ordering" (:p "STYLED-TEXT-VIEW/DOCUMENT-VIEW: presentation revision after an explicit SET-TEXT-PRESENTATION, INVALIDATE-TEXT-PRESENTATION or gutter-width update. Content edits remap/drop records quietly before existing content notifications; they do not emit this event.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :presentation-change (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/selection-change" :names (":SELECTION-CHANGE") :kind :event :kind-name "Event" :package "LUT" :summary "SELECTION-MODEL and MODEL-LIST-VIEW/TREE/TABLE: copied list of stable selected keys, including hidden keys. Key/focus/anchor changes notify; missing keys are pruned on model changes." :sections (("Payload and ordering" (:p "SELECTION-MODEL and MODEL-LIST-VIEW/TREE/TABLE: copied list of stable selected keys, including hidden keys. Key/focus/anchor changes notify; missing keys are pruned on model changes.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :selection-change (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "event/tick" :names (":TICK") :kind :event :kind-name "Event" :package "LUT" :summary "Root window: elapsed seconds as a non-negative real, before layout/input/render." :sections (("Payload and ordering" (:p "Root window: elapsed seconds as a non-negative real, before layout/input/render.")) ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop.")) ("Example" (:code-block "lisp" "(lut:on widget :tick (lambda (widget payload) (declare (ignore widget)) (print payload)))"))))
(:entry "symbol/accept-suggestion" :names ("ACCEPT-SUGGESTION") :kind :function :kind-name "Function" :package "LUT" :summary "Dismiss a shown SURFACE before emitting :ACCEPT with the original candidate at INDEX. Return accepted-p." :sections (("Signature" (:code-block "lisp" "(accept-suggestion surface &optional (index (value surface)))")) ("Arguments and valid values" (:p "SURFACE is a shown suggestion surface. INDEX defaults to VALUE and must identify a candidate. Dismisses before emitting :ACCEPT with the original item; unavailable/empty returns NIL. No automatic insertion, ranking or language lookup.")) ("Results and errors" (:p "Accepted-p.")) ("Example" (:code-block "lisp" "(lut:accept-suggestion (lut:make-widget 'lut:suggestion-surface))"))))
(:entry "symbol/accepts-drop-p" :names ("ACCEPTS-DROP-P") :kind :function :kind-name "Function" :package "LUT" :summary "Return true if TARGET accepts SESSION at EVENT. Called during movement and again before dropping; do not mutate the tree here." :sections (("Signature" (:code-block "lisp" "(accepts-drop-p target session event)")) ("Arguments and valid values" (:p "TARGET is a live widget; SESSION is a drag; EVENT supplies the root coordinates. Pure acceptance predicate, default NIL. Ancestors are tried from deepest to root.")) ("Results and errors" (:p "Generalized boolean.")) ("Example" (:code-block "lisp" "(lut:accepts-drop-p target session (lut:make-event :kind :move))"))))
(:entry "symbol/active-children" :names ("ACTIVE-CHILDREN") :kind :function :kind-name "Function" :package "LUT" :summary "Children included in layout, drawing and input." :sections (("Signature" (:code-block "lisp" "(active-children widget)")) ("Arguments and valid values" (:p "WIDGET is a container. Stack exposes its selected child; collapsed expander exposes none; ordinary containers expose visible children.")) ("Results and errors" (:p "List of widgets.")) ("Example" (:code-block "lisp" "(lut:active-children (lut:make-widget 'lut:stack))"))))
(:entry "symbol/active-column" :names ("ACTIVE-COLUMN") :kind :function :kind-name "Function" :package "LUT" :summary "VIEW is a model table. SETF requires a valid zero-based column index; Left/Right and pointer input navigate." :sections (("Signature" (:code-block "lisp" "(active-column lut-docs::object)")) ("Arguments and valid values" (:p "VIEW is a model table. SETF requires a valid zero-based column index; Left/Right and pointer input navigate.")) ("Results and errors" (:p "Column index.")) ("Example" (:code-block "lisp" "(lut:active-column table)"))))
(:entry "symbol/add-child" :names ("ADD-CHILD") :kind :function :kind-name "Function" :package "LUT" :summary "Reparent CHILD, rejecting cycles. Return CHILD." :sections (("Signature" (:code-block "lisp" "(add-child container child)")) ("Arguments and valid values" (:p "CONTAINER and CHILD are widgets. Reparents CHILD. Rejects cycles and disposed nodes before changing ownership.")) ("Results and errors" (:p "CHILD.")) ("Example" (:code-block "lisp" "(let ((box (lut:make-widget 'lut:box))) (lut:add-child box (lut:make-widget 'lut:button)))"))))
(:entry "symbol/advance-text-selection" :names ("ADVANCE-TEXT-SELECTION") :kind :function :kind-name "Function" :package "LUT" :summary "Advance captured selection autoscroll by nonnegative SECONDS; native frames call this automatically. Return whether offsets changed." :sections (("Signature" (:code-block "lisp" "(advance-text-selection window seconds)")) ("Arguments and valid values" (:p "WINDOW is a root; SECONDS is nonnegative elapsed time. Native/controller frames call this automatically. Advances captured selection autoscroll outside content edges with bounded speed and a 0.1-second maximum step, then hit-tests using shared geometry. Stationary pointers keep scrolling. Zero time does not scroll. Invalid/hidden/disabled/modal-blocked captures cancel.")) ("Results and errors" (:p "True if offsets changed, otherwise NIL.")) ("Example" (:code-block "lisp" "(lut:advance-text-selection (lut:make-widget 'lut:window) 0.016)"))))
(:entry "symbol/begin-cell-edit" :names ("BEGIN-CELL-EDIT") :kind :function :kind-name "Function" :package "LUT" :summary "Create at most one entry editor. Returns editor, or NIL for an unselected/read-only cell. No database policy." :sections (("Signature" (:code-block "lisp" "(begin-cell-edit view &optional (index (value view)) (column-index (active-column view)))")) ("Arguments and valid values" (:p "VIEW is a live model table. Defaults to focused row and active column. Columns without a setter are read-only. Editor factory must return live unparented entry. Emits :CELL-EDIT-START.")) ("Results and errors" (:p "Entry, or NIL when unavailable/read-only.")) ("Example" (:code-block "lisp" "(lut:begin-cell-edit table)"))))
(:entry "symbol/begin-drag" :names ("BEGIN-DRAG") :kind :function :kind-name "Function" :package "LUT" :summary "Arm a drag from SOURCE using EVENT's start coordinates. Movement past :DRAG-THRESHOLD starts it; return the session." :sections (("Signature" (:code-block "lisp" "(begin-drag source payload event)")) ("Arguments and valid values" (:p "SOURCE must be enabled/visible/live in an input root; EVENT must be :DOWN. Cancels the previous session, then arms a thresholded drag with PAYLOAD.")) ("Results and errors" (:p "New pending session.")) ("Example" (:code-block "lisp" "(let* ((w (lut:make-widget 'lut:window)) (b (lut:add-child w (lut:make-widget 'lut:button)))) (lut:begin-drag b :data (lut:make-event :kind :down)))"))))
(:entry "symbol/begin-ui-scissor" :names ("BEGIN-UI-SCISSOR") :kind :function :kind-name "Function" :package "LUT" :summary "Begin backend clipping for a logical UI rectangle under the active root render scale." :sections (("Signature" (:code-block "lisp" "(begin-ui-scissor x y width height)")) ("Arguments and valid values" (:p "Raylib backend only, active drawing context. X/Y/WIDTH/HEIGHT are logical UI units; converts using active root scale, rounding outward. Application drawing callbacks inherit that scale.")) ("Results and errors" (:p "Begins native scissor; pair with RL:END-SCISSOR-MODE.")) ("Example" (:code-block "lisp" "(lut:begin-ui-scissor 10 20 100 40)"))))
(:entry "symbol/bind-command" :names ("BIND-COMMAND") :kind :function :kind-name "Function" :package "LUT" :summary "Bind COMMAND to WINDOW and optionally a button/menu button. CONTEXT is constant; CONTEXT-FUNCTION takes WINDOW and supplies dynamic context. Return a binding handle." :sections (("Signature" (:code-block "lisp" "(bind-command window command &key widget (context window) context-function (shortcut-p t))")) ("Arguments and valid values" (:p "WINDOW and COMMAND must be live. WIDGET optionally identifies a button/menu button; a control may have one active binding. CONTEXT defaults to WINDOW; CONTEXT-FUNCTION optionally takes WINDOW to obtain dynamic data. SHORTCUT-P defaults T. Binding owns label/enabled state until unbound. Detached controls are inactive until adopted by WINDOW. Existing activation handlers are retained.")) ("Results and errors" (:p "COMMAND-BINDING. On registration errors, connections and references are rolled back.")) ("Example" (:code-block "lisp" "(let* ((w (lut:make-widget 'lut:window)) (b (lut:add-child w (lut:make-widget 'lut:button))) (c (lut:make-command :hello \"Hello\" (lambda (c context) (declare (ignore c context)))))) (lut:bind-command w c :widget b))"))))
(:entry "symbol/bind-key" :names ("BIND-KEY") :kind :function :kind-name "Function" :package "LUT" :summary "Bind normalized KEY to a no-argument action on WINDOW, outside modal dialogs.
Examples: :CONTROL-S, :CONTROL-SHIFT-S, :F1. Return ON's callback and connection." :sections (("Signature" (:code-block "lisp" "(bind-key window key function &key owner)")) ("Arguments and valid values" (:p "WINDOW is a root; KEY is a normalized keyword such as :CONTROL-S or :F1; FUNCTION takes no arguments. Modal dialogs suspend root actions. OWNER optionally disconnects the shortcut on disposal.")) ("Results and errors" (:p "Callback and connection handle, as for ON.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:window))) (lut:bind-key w :control-s (lambda () (print :save)) :owner w))"))))
(:entry "symbol/buffer-revision" :names ("BUFFER-REVISION") :kind :function :kind-name "Function" :package "LUT" :summary "Return BUFFER's monotonically increasing content revision." :sections (("Signature" (:code-block "lisp" "(buffer-revision buffer)")) ("Arguments and valid values" (:p "BUFFER is a text buffer. Revision increases once per effective content edit, including undo/redo and SETF TEXT; no-op edits do not increment it.")) ("Results and errors" (:p "Nonnegative integer.")) ("Example" (:code-block "lisp" "(lut:buffer-revision (lut:make-text-buffer))"))))
(:entry "symbol/can-redo-p" :names ("CAN-REDO-P") :kind :function :kind-name "Function" :package "LUT" :summary "Whether TARGET can currently redo." :sections (("Signature" (:code-block "lisp" "(can-redo-p target)")) ("Arguments and valid values" (:p "TARGET is an entry/view or text buffer. Reports available redo history and effective read-only policy.")) ("Results and errors" (:p "Boolean.")) ("Example" (:code-block "lisp" "(lut:can-redo-p (lut:make-text-buffer))"))))
(:entry "symbol/can-undo-p" :names ("CAN-UNDO-P") :kind :function :kind-name "Function" :package "LUT" :summary "Whether TARGET can currently undo; shared views query shared history and their own read-only policy." :sections (("Signature" (:code-block "lisp" "(can-undo-p target)")) ("Arguments and valid values" (:p "TARGET is an entry/view or text buffer. Reports available history and effective read-only policy. Shared views use model history.")) ("Results and errors" (:p "Boolean.")) ("Example" (:code-block "lisp" "(lut:can-undo-p (lut:make-text-buffer))"))))
(:entry "symbol/cancel-cell-edit" :names ("CANCEL-CELL-EDIT") :kind :function :kind-name "Function" :package "LUT" :summary "Dispose the editor without calling a setter. Emit :CELL-EDIT-CANCEL with key, column and reason." :sections (("Signature" (:code-block "lisp" "(cancel-cell-edit view &optional (reason :cancel))")) ("Arguments and valid values" (:p "VIEW is a model table. Closes/disposes editor without setter; reason defaults :CANCEL. Restores table focus when appropriate, emits :CELL-EDIT-CANCEL. Idempotent.")) ("Results and errors" (:p "Cancelled-p.")) ("Example" (:code-block "lisp" "(lut:cancel-cell-edit table)"))))
(:entry "symbol/cancel-drag" :names ("CANCEL-DRAG") :kind :function :kind-name "Function" :package "LUT" :summary "Cancel a pending or active drag, releasing capture and references. Return whether one existed." :sections (("Signature" (:code-block "lisp" "(cancel-drag window)")) ("Arguments and valid values" (:p "WINDOW is a root. Cancels pending/active drag, releasing capture. Active sessions emit :DRAG-LEAVE then :DRAG-END. Safe when none exists.")) ("Results and errors" (:p "True when cancelled, otherwise NIL.")) ("Example" (:code-block "lisp" "(lut:cancel-drag (lut:make-widget 'lut:window))"))))
(:entry "symbol/cancel-path-request" :names ("CANCEL-PATH-REQUEST") :kind :function :kind-name "Function" :package "LUT" :summary "Cancel a pending portable request once, releasing UI/callback references before calling CALLBACK with NIL." :sections (("Signature" (:code-block "lisp" "(cancel-path-request request)")) ("Arguments and valid values" (:p "REQUEST is a pending portable request; completed requests are unchanged. Dismisses/disposes UI, clears owner/callback references, then calls callback once with NIL. Native panels complete synchronously; no async native cancellation API.")) ("Results and errors" (:p "REQUEST.")) ("Example" (:code-block "lisp" "(lut:cancel-path-request request)"))))
(:entry "symbol/cancel-text-selection" :names ("CANCEL-TEXT-SELECTION") :kind :function :kind-name "Function" :package "LUT" :summary "WINDOW is a root. Clears its text-selection gesture/capture without changing the selected range. FORGET-CLICKS also clears repeated-click metadata. Idempotent; independent drag-and-drop capture is preserved." :sections (("Signature" (:code-block "lisp" "(cancel-text-selection window &key forget-clicks)")) ("Arguments and valid values" (:p "WINDOW is a root. Clears its text-selection gesture/capture without changing the selected range. FORGET-CLICKS also clears repeated-click metadata. Idempotent; independent drag-and-drop capture is preserved.")) ("Results and errors" (:p "True if a text-selection gesture existed, otherwise NIL.")) ("Example" (:code-block "lisp" "(lut:cancel-text-selection (lut:make-widget 'lut:window) :forget-clicks t)"))))
(:entry "symbol/cancel-ui" :names ("CANCEL-UI") :kind :function :kind-name "Function" :package "LUT" :summary "Cancel a queued job handle or every pending occurrence of FUNCTION; return count. Running jobs finish normally." :sections (("Signature" (:code-block "lisp" "(cancel-ui handle)")) ("Arguments and valid values" (:p "HANDLE is ENQUEUE-UI/ON-UI/ON-WIDGET's second value, or a queued function object. Cancels matching pending jobs and releases function/owner references. Already executing work finishes normally.")) ("Results and errors" (:p "Number of cancelled jobs.")) ("Example" (:code-block "lisp" "(let ((job (nth-value 1 (lut:enqueue-ui (lambda () :unused))))) (lut:cancel-ui job))"))))
(:entry "symbol/cell-editor" :names ("CELL-EDITOR") :kind :function :kind-name "Function" :package "LUT" :summary "The active cell entry widget, or NIL." :sections (("Signature" (:code-block "lisp" "(cell-editor view)")) ("Arguments and valid values" (:p "VIEW is a model table. A view creates at most one entry editor, regardless of model size.")) ("Results and errors" (:p "Active entry or NIL.")) ("Example" (:code-block "lisp" "(lut:cell-editor table)"))))
(:entry "symbol/cell-presentation" :names ("CELL-PRESENTATION") :kind :function :kind-name "Function" :package "LUT" :summary "Return a fresh (:TEXT string :FOREGROUND color :BACKGROUND color) cell description; factories return a string or this plist." :sections (("Signature" (:code-block "lisp" "(cell-presentation view index column-index)")) ("Arguments and valid values" (:p "VIEW is a model table; INDEX and COLUMN-INDEX valid. Invokes getter/formatter or cell factory only for requested cell.")) ("Results and errors" (:p "Fresh presentation plist with string :TEXT and optional colors.")) ("Example" (:code-block "lisp" "(lut:cell-presentation table 0 0)"))))
(:entry "symbol/children" :names ("CHILDREN") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. (valid values list)." :sections (("Signature" (:code-block "lisp" "(children lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: Ordered child widgets; use ADD-CHILD and REMOVE-CHILD. (valid values list).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:widget))) (lut:children w))"))))
(:entry "symbol/choose-color" :names ("CHOOSE-COLOR") :kind :function :kind-name "Function" :package "LUT" :summary "Open four byte-channel sliders. CALLBACK receives a copied RGBA list on Apply." :sections (("Signature" (:code-block "lisp" "(choose-color window callback &key (initial '(0 0 0 255)))")) ("Arguments and valid values" (:p "WINDOW is root; CALLBACK receives a fresh RGBA byte list. INITIAL must have four integer channels in 0..255, default (0 0 0 255).")) ("Results and errors" (:p "Chooser dialog.")) ("Example" (:code-block "lisp" "(lut:choose-color (lut:make-widget 'lut:window) (lambda (rgba) (print rgba)) :initial '(20 40 60 255))"))))
(:entry "symbol/choose-file" :names ("CHOOSE-FILE") :kind :function :kind-name "Function" :package "LUT" :summary "Open a portable directory/file browser. CALLBACK receives the selected pathname." :sections (("Signature" (:code-block "lisp" "(choose-file window callback &key (directory (user-homedir-pathname)))")) ("Arguments and valid values" (:p "WINDOW is root; CALLBACK receives pathname on Choose. DIRECTORY defaults to user home and must be a directory pathname. Dialog supports explicit path, directory listing and navigation; file errors propagate.")) ("Results and errors" (:p "Chooser dialog.")) ("Example" (:code-block "lisp" "(lut:choose-file (lut:make-widget 'lut:window) (lambda (path) (print path)))"))))
(:entry "symbol/choose-font" :names ("CHOOSE-FONT") :kind :function :kind-name "Function" :package "LUT" :summary "Choose a font file and positive pixel size. CALLBACK receives pathname and size." :sections (("Signature" (:code-block "lisp" "(choose-font window callback &key initial)")) ("Arguments and valid values" (:p "WINDOW is root; CALLBACK receives font pathname and positive integer size. INITIAL is NIL/string/pathname. Applying requires an existing file.")) ("Results and errors" (:p "Chooser dialog.")) ("Example" (:code-block "lisp" "(lut:choose-font (lut:make-widget 'lut:window) (lambda (path size) (print (list path size))))"))))
(:entry "symbol/clear-model-selection" :names ("CLEAR-MODEL-SELECTION") :kind :function :kind-name "Function" :package "LUT" :summary "Clear keys, focus and range anchor; emit :SELECTION-CHANGE only if changed." :sections (("Signature" (:code-block "lisp" "(clear-model-selection selection)")) ("Arguments and valid values" (:p "SELECTION is live. Clear keys, focus and anchor. No event if already clear.")) ("Results and errors" (:p "SELECTION.")) ("Example" (:code-block "lisp" "(lut:clear-model-selection (lut:make-selection-model (lut:make-vector-model '(a))))"))))
(:entry "symbol/clipboard-text" :names ("CLIPBOARD-TEXT") :kind :function :kind-name "Function" :package "LUT" :summary "Read clipboard text; the core uses an in-memory clipboard." :sections (("Signature" (:code-block "lisp" "(clipboard-text widget)")) ("Arguments and valid values" (:p "WIDGET identifies backend context. Core uses an in-memory clipboard; raylib entries use the OS clipboard, requiring an active native window. SETF accepts a string.")) ("Results and errors" (:p "Clipboard string.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:widget))) (setf (lut:clipboard-text w) \"Copied\") (lut:clipboard-text w))"))))
(:entry "symbol/close-dialog" :names ("CLOSE-DIALOG") :kind :function :kind-name "Function" :package "LUT" :summary "Close the top overlay, or dismiss the native dialog hosted by WINDOW." :sections (("Signature" (:code-block "lisp" "(close-dialog window)")) ("Arguments and valid values" (:p "WINDOW is a root. Removes its top overlay and clears focus. Does not close native worker windows; use CLOSE-WINDOW for their handles.")) ("Results and errors" (:p "Removed dialog or NIL.")) ("Example" (:code-block "lisp" "(lut:close-dialog (lut:make-widget 'lut:window))"))))
(:entry "symbol/close-window" :names ("CLOSE-WINDOW") :kind :function :kind-name "Function" :package "LUT" :summary "Request closure of a remote native window; return REMOTE." :sections (("Signature" (:code-block "lisp" "(close-window remote &key (dispose t))")) ("Arguments and valid values" (:p "REMOTE is a live or closed remote-window handle. Requests native worker closure; completion is asynchronous. :DISPOSE defaults T and destroys the tree on closure. NIL preserves the tree for reuse, but always clears handle/registry references.")) ("Results and errors" (:p "REMOTE.")) ("Example" (:code-block "lisp" "(lut:close-window remote)"))))
(:entry "symbol/columns" :names ("COLUMNS") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: TABLE-VIEW: Column header strings. (valid values list); GRID: Positive number of equal-width columns. (valid values (integer 1 *))." :sections (("Signature" (:code-block "lisp" "(columns lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: TABLE-VIEW: Column header strings. (valid values list); GRID: Positive number of equal-width columns. (valid values (integer 1 *)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:table-view))) (lut:columns w))"))))
(:entry "symbol/command-action" :names ("COMMAND-ACTION") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: COMMAND: Function designator taking (command context). (valid values (or null function symbol))." :sections (("Signature" (:code-block "lisp" "(command-action lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: COMMAND: Function designator taking (command context). (valid values (or null function symbol)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:command))) (lut:command-action w))"))))
(:entry "symbol/command-available-p" :names ("COMMAND-AVAILABLE-P") :kind :function :kind-name "Function" :package "LUT" :summary "Return whether COMMAND is live, enabled, has an action, and accepts CONTEXT." :sections (("Signature" (:code-block "lisp" "(command-available-p command &optional context)")) ("Arguments and valid values" (:p "COMMAND is a command; CONTEXT is application data. Requires a live/enabled command, an action and a true predicate result. Rechecked before every invocation.")) ("Results and errors" (:p "Boolean.")) ("Example" (:code-block "lisp" "(lut:command-available-p (lut:make-command :hello \"Hello\" (lambda (c context) (declare (ignore c context)))) nil)"))))
(:entry "symbol/command-binding-active-p" :names ("COMMAND-BINDING-ACTIVE-P") :kind :function :kind-name "Function" :package "LUT" :summary "BINDING is a command binding. Read-only public accessor; false after unbinding or endpoint disposal." :sections (("Signature" (:code-block "lisp" "(command-binding-active-p lut-docs::binding)")) ("Arguments and valid values" (:p "BINDING is a command binding. Read-only public accessor; false after unbinding or endpoint disposal.")) ("Results and errors" (:p "Boolean.")) ("Example" (:code-block "lisp" "(lut:command-binding-active-p binding)"))))
(:entry "symbol/command-label" :names ("COMMAND-LABEL") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: COMMAND: Caption shared by bound buttons and menu buttons. (valid values string)." :sections (("Signature" (:code-block "lisp" "(command-label lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: COMMAND: Caption shared by bound buttons and menu buttons. (valid values string).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:command))) (lut:command-label w))"))))
(:entry "symbol/command-menu-backend" :names ("COMMAND-MENU-BACKEND") :kind :function :kind-name "Function" :package "LUT" :summary "MENU is a command menu handle. Context-sensitive; native integration requires active primary macOS context. Workers retain drawn fallback." :sections (("Signature" (:code-block "lisp" "(command-menu-backend lut-docs::handle)")) ("Arguments and valid values" (:p "MENU is a command menu handle. Context-sensitive; native integration requires active primary macOS context. Workers retain drawn fallback.")) ("Results and errors" (:p ":DRAWN or :NATIVE.")) ("Example" (:code-block "lisp" "(lut:command-menu-backend menu)"))))
(:entry "symbol/command-menu-bar" :names ("COMMAND-MENU-BAR") :kind :function :kind-name "Function" :package "LUT" :summary "MENU is a command menu. Its ordinary MENU-BAR child participates in application layout and is hidden while native." :sections (("Signature" (:code-block "lisp" "(command-menu-bar lut-docs::handle)")) ("Arguments and valid values" (:p "MENU is a command menu. Its ordinary MENU-BAR child participates in application layout and is hidden while native.")) ("Results and errors" (:p "Fallback menu-bar, or NIL after disposal.")) ("Example" (:code-block "lisp" "(lut:command-menu-bar menu)"))))
(:entry "symbol/command-predicate" :names ("COMMAND-PREDICATE") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: COMMAND: Optional pure function (command context); true enables execution. (valid values (or null function symbol))." :sections (("Signature" (:code-block "lisp" "(command-predicate lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: COMMAND: Optional pure function (command context); true enables execution. (valid values (or null function symbol)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:command))) (lut:command-predicate w))"))))
(:entry "symbol/command-shortcut" :names ("COMMAND-SHORTCUT") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: COMMAND: Normalized key keyword, or exact (:KEY key :CONTROL bool :ALT bool :SUPER bool :SHIFT bool) spec. (valid values (or null symbol list))." :sections (("Signature" (:code-block "lisp" "(command-shortcut lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: COMMAND: Normalized key keyword, or exact (:KEY key :CONTROL bool :ALT bool :SUPER bool :SHIFT bool) spec. (valid values (or null symbol list)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:command))) (lut:command-shortcut w))"))))
(:entry "symbol/commit-cell-edit" :names ("COMMIT-CELL-EDIT") :kind :function :kind-name "Function" :package "LUT" :summary "Call the column setter with original item and entry text, then notify model and emit :CELL-EDIT-COMMIT. Setter errors leave the editor open." :sections (("Signature" (:code-block "lisp" "(commit-cell-edit view)")) ("Arguments and valid values" (:p "VIEW is a live model table. Setter validates/applies original item and entry text. Errors leave editor open; no rollback of application mutations. Closes editor, notifies underlying source (refreshing projections), emits :CELL-EDIT-COMMIT.")) ("Results and errors" (:p "Committed-p.")) ("Example" (:code-block "lisp" "(lut:commit-cell-edit table)"))))
(:entry "symbol/content-layout" :names ("CONTENT-LAYOUT") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WINDOW: BOX stacks children; FILL allocates every child the root content rectangle. (valid values (member :box :fill))." :sections (("Signature" (:code-block "lisp" "(content-layout lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WINDOW: BOX stacks children; FILL allocates every child the root content rectangle. (valid values (member :box :fill)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:window))) (lut:content-layout w))"))))
(:entry "symbol/current-drag" :names ("CURRENT-DRAG") :kind :function :kind-name "Function" :package "LUT" :summary "Return WINDOW's pending/active session, or NIL. Sessions do not cross native windows." :sections (("Signature" (:code-block "lisp" "(current-drag window)")) ("Arguments and valid values" (:p "WINDOW is a root. Includes pending sessions; returns NIL after termination.")) ("Results and errors" (:p "DRAG-SESSION or NIL.")) ("Example" (:code-block "lisp" "(lut:current-drag (lut:make-widget 'lut:window))"))))
(:entry "symbol/cursor" :names ("CURSOR") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: ENTRY: Insertion position. (valid values (integer 0 *))." :sections (("Signature" (:code-block "lisp" "(cursor lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: ENTRY: Insertion position. (valid values (integer 0 *)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:entry))) (lut:cursor w))"))))
(:entry "symbol/data-column-id" :names ("DATA-COLUMN-ID") :kind :function :kind-name "Function" :package "LUT" :summary "COLUMN is a data column. Immutable application identity used in edit events." :sections (("Signature" (:code-block "lisp" "(data-column-id lut-docs::object)")) ("Arguments and valid values" (:p "COLUMN is a data column. Immutable application identity used in edit events.")) ("Results and errors" (:p "Original column ID.")) ("Example" (:code-block "lisp" "(lut:data-column-id (lut:make-data-column :id :name))"))))
(:entry "symbol/data-column-title" :names ("DATA-COLUMN-TITLE") :kind :function :kind-name "Function" :package "LUT" :summary "COLUMN is a data column. Treat the returned title as immutable." :sections (("Signature" (:code-block "lisp" "(data-column-title lut-docs::object)")) ("Arguments and valid values" (:p "COLUMN is a data column. Treat the returned title as immutable.")) ("Results and errors" (:p "Title string.")) ("Example" (:code-block "lisp" "(lut:data-column-title (lut:make-data-column :id :name :title \"Name\"))"))))
(:entry "symbol/defwidget" :names ("DEFWIDGET") :kind :macro :kind-name "Macro" :package "LUT" :summary "Define a documented widget and validated accessors. Re-evaluation updates existing CLOS instances lazily." :sections (("Signature" (:code-block "lisp" "(defwidget name supers documentation slots)")) ("Arguments and valid values" (:p "NAME is a class symbol; SUPERS a list of widget superclasses; DOCUMENTATION a string. SLOTS are (name initform type documentation) lists. Initargs use matching keywords. SETF validates before assignment. Re-evaluation uses standard CLOS class redefinition.")) ("Results and errors" (:p "The class name.")) ("Example" (:code-block "lisp" "(lut:defwidget counter-label (lut:label) \"Live counter.\" ((tally 0 (integer 0 *) \"Non-negative count.\")))"))))
(:entry "symbol/detach-on-drag-p" :names ("DETACH-ON-DRAG-P") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: DIALOG: Detach as a native window when dragged beyond the root bounds. (valid values boolean)." :sections (("Signature" (:code-block "lisp" "(detach-on-drag-p lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: DIALOG: Detach as a native window when dragged beyond the root bounds. (valid values boolean).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:dialog))) (lut:detach-on-drag-p w))"))))
(:entry "symbol/detach-window" :names ("DETACH-WINDOW") :kind :function :kind-name "Function" :package "LUT" :summary "Move DIALOG to a native worker window, retaining its authoritative objects and callbacks in the parent REPL." :sections (("Signature" (:code-block "lisp" "(detach-window dialog)")) ("Arguments and valid values" (:p "DIALOG is an in-window dialog. Transfers its original objects to a new root and opens a native worker. Parent callbacks remain in the original Lisp. Drag beyond root bounds invokes this automatically when enabled.")) ("Results and errors" (:p "REMOTE-WINDOW.")) ("Example" (:code-block "lisp" "(let ((d (lut:make-widget 'lut:dialog :width 300 :height 200))) (lut:show-dialog lut:*window* d) (lut:on-ui (lut:detach-window d)))"))))
(:entry "symbol/device-to-ui" :names ("DEVICE-TO-UI") :kind :function :kind-name "Function" :package "LUT" :summary "Convert native window coordinates to logical UI units." :sections (("Signature" (:code-block "lisp" "(device-to-ui window x y)")) ("Arguments and valid values" (:p "WINDOW is a root with positive UI-SCALE. X/Y are native-window coordinates; layout and ordinary DISPATCH remain logical.")) ("Results and errors" (:p "Two logical UI coordinates.")) ("Example" (:code-block "lisp" "(lut:device-to-ui (lut:make-widget 'lut:window :ui-scale 2) 20 40)"))))
(:entry "symbol/directory" :names ("DIRECTORY") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: FILE-CHOOSER: Current directory. (valid values pathname)." :sections (("Signature" (:code-block "lisp" "(directory lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: FILE-CHOOSER: Current directory. (valid values pathname).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:file-chooser))) (lut:directory w))"))))
(:entry "symbol/disconnect" :names ("DISCONNECT") :kind :function :kind-name "Function" :package "LUT" :summary "Idempotently disconnect CONNECTION and clear its source, owner and callback references." :sections (("Signature" (:code-block "lisp" "(disconnect connection)")) ("Arguments and valid values" (:p "CONNECTION is ON's second return value. Idempotently removes both source and owner registrations, marks it inactive and clears callback/source/owner references. Skipped if disconnected during an emission.")) ("Results and errors" (:p "CONNECTION.")) ("Example" (:code-block "lisp" "(let* ((w (lut:make-widget 'lut:button)) (c (nth-value 1 (lut:on w :activate (lambda (w p) (declare (ignore w p))))))) (lut:disconnect c))"))))
(:entry "symbol/dismiss-anchored-surface" :names ("DISMISS-ANCHORED-SURFACE") :kind :function :kind-name "Function" :package "LUT" :summary "Remove SURFACE, release owner/scope references and emit :DISMISS with REASON once. Return SURFACE." :sections (("Signature" (:code-block "lisp" "(dismiss-anchored-surface surface &optional (reason :dismiss))")) ("Arguments and valid values" (:p "SURFACE is anchored. Removes it and releases owner/input-scope/pointer references, restoring owner focus if focus was inside help content. REASON defaults :DISMISS. Candidates/content stay available for reuse. Owner disposal also disposes its shown surface.")) ("Results and errors" (:p "SURFACE. Idempotent; explicit dismissal emits :DISMISS once per shown session. Disposal clears quietly.")) ("Example" (:code-block "lisp" "(lut:dismiss-anchored-surface (lut:make-widget 'lut:anchored-surface))"))))
(:entry "symbol/dismiss-dialog" :names ("DISMISS-DIALOG") :kind :function :kind-name "Function" :package "LUT" :summary "Dismiss DIALOG from its current owner, including a detached native host. Use this in dialog response callbacks." :sections (("Signature" (:code-block "lisp" "(dismiss-dialog dialog)")) ("Arguments and valid values" (:p "DIALOG is a dialog with its current ownership intact. Removes an in-window modal overlay or closes its detached native host. Prefer this over capturing the original root in response callbacks.")) ("Results and errors" (:p "DIALOG; native closure is asynchronous.")) ("Example" (:code-block "lisp" "(let* ((w (lut:make-widget 'lut:window)) (d (lut:make-widget 'lut:dialog))) (lut:show-dialog w d) (lut:dismiss-dialog d))"))))
(:entry "symbol/dismiss-on-blur-p" :names ("DISMISS-ON-BLUR-P") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: ANCHORED-SURFACE: Dismiss when focus moves away from the owner. (valid values boolean)." :sections (("Signature" (:code-block "lisp" "(dismiss-on-blur-p lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: ANCHORED-SURFACE: Dismiss when focus moves away from the owner. (valid values boolean).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:anchored-surface))) (lut:dismiss-on-blur-p w))"))))
(:entry "symbol/dispatch" :names ("DISPATCH") :kind :function :kind-name "Function" :package "LUT" :summary "Dispatch input with state updates, generic widget handlers, popup dismissal, context menus and dialog dragging." :sections (("Signature" (:code-block "lisp" "(dispatch window event)")) ("Arguments and valid values" (:p "WINDOW is a root window; EVENT a MAKE-EVENT value. Dispatches modal input, gestures, context menus and keyboard edits. Use ON-UI from another thread.")) ("Results and errors" (:p "Target widget or NIL; handlers may return other values.")) ("Example" (:code-block "lisp" "(lut:dispatch (lut:make-widget 'lut:window) (lut:make-event :kind :key :key :tab))"))))
(:entry "symbol/dispatch-device-event" :names ("DISPATCH-DEVICE-EVENT") :kind :function :kind-name "Function" :package "LUT" :summary "Dispatch a copied native-coordinate EVENT after one coordinate conversion; wheel deltas remain row units." :sections (("Signature" (:code-block "lisp" "(dispatch-device-event window event)")) ("Arguments and valid values" (:p "WINDOW is live. EVENT uses native-window coordinates. Copies and converts X/Y once, preserving wheel counts, timestamps, text and modifiers. Original event is unchanged.")) ("Results and errors" (:p "DISPATCH result.")) ("Example" (:code-block "lisp" "(lut:dispatch-device-event (lut:make-widget 'lut:window :ui-scale 2) (lut:make-event :kind :move :x 20 :y 40))"))))
(:entry "symbol/display-text" :names ("DISPLAY-TEXT") :kind :function :kind-name "Function" :package "LUT" :summary "Return the visible string for a label/entry; override for masked or formatted controls." :sections (("Signature" (:code-block "lisp" "(display-text widget)")) ("Arguments and valid values" (:p "WIDGET is a label or entry. Returns the visible string, which can differ from TEXT for masked/formatted widgets. Override this generic to preserve common selection and rendering.")) ("Results and errors" (:p "A string with compatible character boundaries.")) ("Example" (:code-block "lisp" "(lut:display-text (lut:make-widget 'lut:entry :text \"Visible\"))"))))
(:entry "symbol/dispose" :names ("DISPOSE") :kind :function :kind-name "Function" :package "LUT" :summary "Destroy a widget subtree idempotently. Clears connections, ownership and input references; subclass before/after methods may release custom resources." :sections (("Signature" (:code-block "lisp" "(dispose widget)")) ("Arguments and valid values" (:p "WIDGET is a widget subtree or command-binding handle (which is unbound). Idempotently destroys it, detaches ownership, clears focus/capture, connections, callbacks, standard model data and owned queued work. Cannot be revived. Define DISPOSE :BEFORE/:AFTER methods for custom resources; invoke on the GUI thread while running.")) ("Results and errors" (:p "WIDGET. Cleanup runs even if a subclass disposal method signals.")) ("Example" (:code-block "lisp" "(let* ((w (lut:make-widget 'lut:box)) (child (lut:add-child w (lut:make-widget 'lut:entry)))) (lut:dispose child) (lut:disposed-p child))"))))
(:entry "symbol/disposed-p" :names ("DISPOSED-P") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET is a widget. Reports whether DISPOSE has destroyed it. The managed setter rejects state changes; use DISPOSE, not SETF, and never revive a disposed tree." :sections (("Signature" (:code-block "lisp" "(disposed-p lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET is a widget. Reports whether DISPOSE has destroyed it. The managed setter rejects state changes; use DISPOSE, not SETF, and never revive a disposed tree.")) ("Results and errors" (:p "Boolean.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:widget))) (lut:dispose w) (lut:disposed-p w))"))))
(:entry "symbol/document-hit-test" :names ("DOCUMENT-HIT-TEST") :kind :function :kind-name "Function" :package "LUT" :summary "Return KIND and copied record for an inline image/link, or :TEXT and character position. Outside content returns NIL." :sections (("Signature" (:code-block "lisp" "(document-hit-test view px py)")) ("Arguments and valid values" (:p "VIEW is a document view. PX/PY are root pixels. Uses the same style/image advances as drawing. Links hit their text cells, images their explicit centered pixel rectangle; gutter/outside content returns NIL.")) ("Results and errors" (:p "Two values: :IMAGE/:LINK and copied record, or :TEXT and character index; NIL if outside.")) ("Example" (:code-block "lisp" "(lut:document-hit-test (lut:make-widget 'lut:document-view :text \"abc\") 10 10)"))))
(:entry "symbol/document-images" :names ("DOCUMENT-IMAGES") :kind :function :kind-name "Function" :package "LUT" :summary "Return copied inline-image records." :sections (("Signature" (:code-block "lisp" "(document-images view)")) ("Arguments and valid values" (:p "VIEW is a document view. Returns copied (:POSITION :SOURCE :WIDTH :HEIGHT :ALT) records. Images occupy one U+FFFC character; plaintext selection retains that character. Sources use the backend file image cache.")) ("Results and errors" (:p "Fresh list of image plists.")) ("Example" (:code-block "lisp" "(lut:document-images (lut:make-widget 'lut:document-view))"))))
(:entry "symbol/document-links" :names ("DOCUMENT-LINKS") :kind :function :kind-name "Function" :package "LUT" :summary "Return copied link records; TARGET values retain identity." :sections (("Signature" (:code-block "lisp" "(document-links view)")) ("Arguments and valid values" (:p "VIEW is a document view. Returns copied (:START :END :TARGET) records; opaque targets keep identity. Activation emits :LINK, with application-owned routing.")) ("Results and errors" (:p "Fresh list of link plists.")) ("Example" (:code-block "lisp" "(lut:document-links (lut:make-widget 'lut:document-view))"))))
(:entry "symbol/drag-data" :names ("DRAG-DATA") :kind :function :kind-name "Function" :package "LUT" :summary "On pointer down, return (values payload T) to arm a drag from SOURCE; NIL second value declines." :sections (("Signature" (:code-block "lisp" "(drag-data source event)")) ("Arguments and valid values" (:p "SOURCE is a widget; EVENT is pointer down. Override this generic to offer arbitrary in-process data without mutating the widget tree.")) ("Results and errors" (:p "Two values: payload and offered-p. NIL payload is valid when offered-p is true.")) ("Example" (:code-block "lisp" "(lut:drag-data (lut:make-widget 'lut:button) (lut:make-event :kind :down))"))))
(:entry "symbol/drag-payload" :names ("DRAG-PAYLOAD") :kind :function :kind-name "Function" :package "LUT" :summary "SESSION is a DRAG-SESSION. Read-only public accessor. Source/payload/target references are cleared after completion callbacks." :sections (("Signature" (:code-block "lisp" "(drag-payload lut-docs::session)")) ("Arguments and valid values" (:p "SESSION is a DRAG-SESSION. Read-only public accessor. Source/payload/target references are cleared after completion callbacks.")) ("Results and errors" (:p "Arbitrary payload.")) ("Example" (:code-block "lisp" "(lut:drag-payload session)"))))
(:entry "symbol/drag-source" :names ("DRAG-SOURCE") :kind :function :kind-name "Function" :package "LUT" :summary "SESSION is a DRAG-SESSION. Read-only public accessor. Source/payload/target references are cleared after completion callbacks." :sections (("Signature" (:code-block "lisp" "(drag-source lut-docs::session)")) ("Arguments and valid values" (:p "SESSION is a DRAG-SESSION. Read-only public accessor. Source/payload/target references are cleared after completion callbacks.")) ("Results and errors" (:p "Source widget.")) ("Example" (:code-block "lisp" "(lut:drag-source session)"))))
(:entry "symbol/drag-state" :names ("DRAG-STATE") :kind :function :kind-name "Function" :package "LUT" :summary "SESSION is a DRAG-SESSION. Read-only public accessor. Source/payload/target references are cleared after completion callbacks." :sections (("Signature" (:code-block "lisp" "(drag-state lut-docs::session)")) ("Arguments and valid values" (:p "SESSION is a DRAG-SESSION. Read-only public accessor. Source/payload/target references are cleared after completion callbacks.")) ("Results and errors" (:p "One of :PENDING, :DRAGGING, :DROPPED, :REJECTED, :CANCELLED.")) ("Example" (:code-block "lisp" "(lut:drag-state session)"))))
(:entry "symbol/drag-target" :names ("DRAG-TARGET") :kind :function :kind-name "Function" :package "LUT" :summary "SESSION is a DRAG-SESSION. Read-only public accessor. Source/payload/target references are cleared after completion callbacks." :sections (("Signature" (:code-block "lisp" "(drag-target lut-docs::session)")) ("Arguments and valid values" (:p "SESSION is a DRAG-SESSION. Read-only public accessor. Source/payload/target references are cleared after completion callbacks.")) ("Results and errors" (:p "Accepted target widget or NIL.")) ("Example" (:code-block "lisp" "(lut:drag-target session)"))))
(:entry "symbol/drag-x" :names ("DRAG-X") :kind :function :kind-name "Function" :package "LUT" :summary "SESSION is a DRAG-SESSION. Read-only public accessor. Source/payload/target references are cleared after completion callbacks." :sections (("Signature" (:code-block "lisp" "(drag-x lut-docs::session)")) ("Arguments and valid values" (:p "SESSION is a DRAG-SESSION. Read-only public accessor. Source/payload/target references are cleared after completion callbacks.")) ("Results and errors" (:p "Latest root X coordinate.")) ("Example" (:code-block "lisp" "(lut:drag-x session)"))))
(:entry "symbol/drag-y" :names ("DRAG-Y") :kind :function :kind-name "Function" :package "LUT" :summary "SESSION is a DRAG-SESSION. Read-only public accessor. Source/payload/target references are cleared after completion callbacks." :sections (("Signature" (:code-block "lisp" "(drag-y lut-docs::session)")) ("Arguments and valid values" (:p "SESSION is a DRAG-SESSION. Read-only public accessor. Source/payload/target references are cleared after completion callbacks.")) ("Results and errors" (:p "Latest root Y coordinate.")) ("Example" (:code-block "lisp" "(lut:drag-y session)"))))
(:entry "symbol/draggable-p" :names ("DRAGGABLE-P") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: POPOVER: Popups do not drag by default. (valid values boolean); DIALOG: Drag unoccupied dialog surface to move it. (valid values boolean)." :sections (("Signature" (:code-block "lisp" "(draggable-p lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: POPOVER: Popups do not drag by default. (valid values boolean); DIALOG: Drag unoccupied dialog surface to move it. (valid values boolean).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:popover))) (lut:draggable-p w))"))))
(:entry "symbol/draw-function" :names ("DRAW-FUNCTION") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: DRAWING-AREA: Backend-specific drawing callback. (valid values (or null function))." :sections (("Signature" (:code-block "lisp" "(draw-function lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: DRAWING-AREA: Backend-specific drawing callback. (valid values (or null function)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:drawing-area))) (lut:draw-function w))"))))
(:entry "symbol/edit-new-end" :names ("EDIT-NEW-END") :kind :function :kind-name "Function" :package "LUT" :summary "EDIT is a BUFFER-EDIT notification record. Retaining a record with a non-NIL origin intentionally retains that view." :sections (("Signature" (:code-block "lisp" "(edit-new-end lut-docs::edit)")) ("Arguments and valid values" (:p "EDIT is a BUFFER-EDIT notification record. Retaining a record with a non-NIL origin intentionally retains that view.")) ("Results and errors" (:p "Exclusive new end character index.")) ("Example" (:code-block "lisp" "(lut:edit-new-end edit)"))))
(:entry "symbol/edit-old-end" :names ("EDIT-OLD-END") :kind :function :kind-name "Function" :package "LUT" :summary "EDIT is a BUFFER-EDIT notification record. Retaining a record with a non-NIL origin intentionally retains that view." :sections (("Signature" (:code-block "lisp" "(edit-old-end lut-docs::edit)")) ("Arguments and valid values" (:p "EDIT is a BUFFER-EDIT notification record. Retaining a record with a non-NIL origin intentionally retains that view.")) ("Results and errors" (:p "Exclusive old end character index.")) ("Example" (:code-block "lisp" "(lut:edit-old-end edit)"))))
(:entry "symbol/edit-origin" :names ("EDIT-ORIGIN") :kind :function :kind-name "Function" :package "LUT" :summary "EDIT is a BUFFER-EDIT notification record. Retaining a record with a non-NIL origin intentionally retains that view." :sections (("Signature" (:code-block "lisp" "(edit-origin lut-docs::edit)")) ("Arguments and valid values" (:p "EDIT is a BUFFER-EDIT notification record. Retaining a record with a non-NIL origin intentionally retains that view.")) ("Results and errors" (:p "Originating view or NIL.")) ("Example" (:code-block "lisp" "(lut:edit-origin edit)"))))
(:entry "symbol/edit-revision" :names ("EDIT-REVISION") :kind :function :kind-name "Function" :package "LUT" :summary "EDIT is a BUFFER-EDIT notification record. Retaining a record with a non-NIL origin intentionally retains that view." :sections (("Signature" (:code-block "lisp" "(edit-revision lut-docs::edit)")) ("Arguments and valid values" (:p "EDIT is a BUFFER-EDIT notification record. Retaining a record with a non-NIL origin intentionally retains that view.")) ("Results and errors" (:p "Committed buffer revision.")) ("Example" (:code-block "lisp" "(lut:edit-revision edit)"))))
(:entry "symbol/edit-start" :names ("EDIT-START") :kind :function :kind-name "Function" :package "LUT" :summary "EDIT is a BUFFER-EDIT notification record. Retaining a record with a non-NIL origin intentionally retains that view." :sections (("Signature" (:code-block "lisp" "(edit-start lut-docs::edit)")) ("Arguments and valid values" (:p "EDIT is a BUFFER-EDIT notification record. Retaining a record with a non-NIL origin intentionally retains that view.")) ("Results and errors" (:p "Start character index.")) ("Example" (:code-block "lisp" "(lut:edit-start edit)"))))
(:entry "symbol/editable-p" :names ("EDITABLE-P") :kind :function :kind-name "Function" :package "LUT" :summary "Whether an entry/view or buffer permits edits. Read-only views still allow navigation, selection and copy." :sections (("Signature" (:code-block "lisp" "(editable-p target)")) ("Arguments and valid values" (:p "TARGET is an entry/text view or text buffer. Requires a live target, a false local READ-ONLY-P, and (for shared views) a live writable buffer. Enabled/visible UI policy is separate.")) ("Results and errors" (:p "Boolean.")) ("Example" (:code-block "lisp" "(lut:editable-p (lut:make-widget 'lut:text-view :read-only-p t))"))))
(:entry "symbol/emit" :names ("EMIT") :kind :function :kind-name "Function" :package "LUT" :summary "Invoke active handlers in registration order; disconnected bindings are skipped even during emission." :sections (("Signature" (:code-block "lisp" "(emit widget event &optional payload)")) ("Arguments and valid values" (:p "WIDGET is a widget; EVENT a keyword; PAYLOAD defaults to NIL. Calls handlers synchronously in registration order. Handler errors propagate.")) ("Results and errors" (:p "Unspecified.")) ("Example" (:code-block "lisp" "(let ((b (lut:make-widget 'lut:button))) (lut:on b :activate (lambda (w p) (declare (ignore w p)) :ok)) (lut:emit b :activate))"))))
(:entry "symbol/enabled-p" :names ("ENABLED-P") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: NIL disables input for this subtree. (valid values boolean)." :sections (("Signature" (:code-block "lisp" "(enabled-p lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: NIL disables input for this subtree. (valid values boolean).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:widget))) (lut:enabled-p w))"))))
(:entry "symbol/enqueue-ui" :names ("ENQUEUE-UI") :kind :function :kind-name "Function" :package "LUT" :summary "Queue FUNCTION for the next frame. OWNER optionally cancels it on disposal.
Return FUNCTION and, as a second value, a cancellable job handle." :sections (("Signature" (:code-block "lisp" "(enqueue-ui function &key owner)")) ("Arguments and valid values" (:p "FUNCTION is a no-argument closure. Queues FIFO across threads; result is not transported. OWNER optionally cancels pending work when disposed. Failed jobs are not retried; later jobs remain queued.")) ("Results and errors" (:p "FUNCTION and a cancellable job handle as a second value.")) ("Example" (:code-block "lisp" "(lut:enqueue-ui (lambda () (setf (lut:text lut:*window*) \"Edited live\")))"))))
(:entry "symbol/evaluate-in-window" :names ("EVALUATE-IN-WINDOW") :kind :function :kind-name "Function" :package "LUT" :summary "Queue explicit Lisp FORMS for evaluation on the native worker GUI thread before its next snapshot.
This is an intentional REPL evaluation API over private child-process pipes; never pass untrusted forms." :sections (("Signature" (:code-block "lisp" "(evaluate-in-window remote forms)")) ("Arguments and valid values" (:p "REMOTE is a handle; FORMS is a list of trusted Lisp forms. Explicitly evaluates on worker main thread before its next frame, for native operations. Application methods/classes/source reloads belong in ON-UI. Not an untrusted-data API.")) ("Results and errors" (:p "REMOTE.")) ("Example" (:code-block "lisp" "(lut:evaluate-in-window remote '((asdf:load-system \"lut\" :force t)))"))))
(:entry "symbol/event-alt-p" :names ("EVENT-ALT-P") :kind :function :kind-name "Function" :package "LUT" :summary "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values." :sections (("Signature" (:code-block "lisp" "(event-alt-p lut-docs::widget)")) ("Arguments and valid values" (:p "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values.")) ("Results and errors" (:p "The named event field.")) ("Example" (:code-block "lisp" "(lut:event-alt-p (lut:make-event :kind :key :key :tab))"))))
(:entry "symbol/event-base-key" :names ("EVENT-BASE-KEY") :kind :function :kind-name "Function" :package "LUT" :summary "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values." :sections (("Signature" (:code-block "lisp" "(event-base-key lut-docs::widget)")) ("Arguments and valid values" (:p "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values.")) ("Results and errors" (:p "The named event field.")) ("Example" (:code-block "lisp" "(lut:event-base-key (lut:make-event :kind :key :key :tab))"))))
(:entry "symbol/event-click-count" :names ("EVENT-CLICK-COUNT") :kind :function :kind-name "Function" :package "LUT" :summary "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values." :sections (("Signature" (:code-block "lisp" "(event-click-count lut-docs::widget)")) ("Arguments and valid values" (:p "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values.")) ("Results and errors" (:p "The named event field.")) ("Example" (:code-block "lisp" "(lut:event-click-count (lut:make-event :kind :key :key :tab))"))))
(:entry "symbol/event-control-p" :names ("EVENT-CONTROL-P") :kind :function :kind-name "Function" :package "LUT" :summary "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values." :sections (("Signature" (:code-block "lisp" "(event-control-p lut-docs::widget)")) ("Arguments and valid values" (:p "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values.")) ("Results and errors" (:p "The named event field.")) ("Example" (:code-block "lisp" "(lut:event-control-p (lut:make-event :kind :key :key :tab))"))))
(:entry "symbol/event-delta" :names ("EVENT-DELTA") :kind :function :kind-name "Function" :package "LUT" :summary "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values." :sections (("Signature" (:code-block "lisp" "(event-delta lut-docs::widget)")) ("Arguments and valid values" (:p "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values.")) ("Results and errors" (:p "The named event field.")) ("Example" (:code-block "lisp" "(lut:event-delta (lut:make-event :kind :key :key :tab))"))))
(:entry "symbol/event-key" :names ("EVENT-KEY") :kind :function :kind-name "Function" :package "LUT" :summary "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values." :sections (("Signature" (:code-block "lisp" "(event-key lut-docs::widget)")) ("Arguments and valid values" (:p "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values.")) ("Results and errors" (:p "The named event field.")) ("Example" (:code-block "lisp" "(lut:event-key (lut:make-event :kind :key :key :tab))"))))
(:entry "symbol/event-kind" :names ("EVENT-KIND") :kind :function :kind-name "Function" :package "LUT" :summary "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values." :sections (("Signature" (:code-block "lisp" "(event-kind lut-docs::widget)")) ("Arguments and valid values" (:p "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values.")) ("Results and errors" (:p "The named event field.")) ("Example" (:code-block "lisp" "(lut:event-kind (lut:make-event :kind :key :key :tab))"))))
(:entry "symbol/event-shift-p" :names ("EVENT-SHIFT-P") :kind :function :kind-name "Function" :package "LUT" :summary "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values." :sections (("Signature" (:code-block "lisp" "(event-shift-p lut-docs::widget)")) ("Arguments and valid values" (:p "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values.")) ("Results and errors" (:p "The named event field.")) ("Example" (:code-block "lisp" "(lut:event-shift-p (lut:make-event :kind :key :key :tab))"))))
(:entry "symbol/event-super-p" :names ("EVENT-SUPER-P") :kind :function :kind-name "Function" :package "LUT" :summary "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values." :sections (("Signature" (:code-block "lisp" "(event-super-p lut-docs::widget)")) ("Arguments and valid values" (:p "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values.")) ("Results and errors" (:p "The named event field.")) ("Example" (:code-block "lisp" "(lut:event-super-p (lut:make-event :kind :key :key :tab))"))))
(:entry "symbol/event-text" :names ("EVENT-TEXT") :kind :function :kind-name "Function" :package "LUT" :summary "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values." :sections (("Signature" (:code-block "lisp" "(event-text lut-docs::widget)")) ("Arguments and valid values" (:p "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values.")) ("Results and errors" (:p "The named event field.")) ("Example" (:code-block "lisp" "(lut:event-text (lut:make-event :kind :key :key :tab))"))))
(:entry "symbol/event-timestamp" :names ("EVENT-TIMESTAMP") :kind :function :kind-name "Function" :package "LUT" :summary "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values." :sections (("Signature" (:code-block "lisp" "(event-timestamp lut-docs::widget)")) ("Arguments and valid values" (:p "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values.")) ("Results and errors" (:p "The named event field.")) ("Example" (:code-block "lisp" "(lut:event-timestamp (lut:make-event :kind :key :key :tab))"))))
(:entry "symbol/event-x" :names ("EVENT-X") :kind :function :kind-name "Function" :package "LUT" :summary "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values." :sections (("Signature" (:code-block "lisp" "(event-x lut-docs::widget)")) ("Arguments and valid values" (:p "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values.")) ("Results and errors" (:p "The named event field.")) ("Example" (:code-block "lisp" "(lut:event-x (lut:make-event :kind :key :key :tab))"))))
(:entry "symbol/event-y" :names ("EVENT-Y") :kind :function :kind-name "Function" :package "LUT" :summary "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values." :sections (("Signature" (:code-block "lisp" "(event-y lut-docs::widget)")) ("Arguments and valid values" (:p "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values.")) ("Results and errors" (:p "The named event field.")) ("Example" (:code-block "lisp" "(lut:event-y (lut:make-event :kind :key :key :tab))"))))
(:entry "symbol/expanded-p" :names ("EXPANDED-P") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: COMBO-BOX: Whether the option popup is open. (valid values boolean); DROPDOWN: Whether the option popup is open. (valid values boolean)." :sections (("Signature" (:code-block "lisp" "(expanded-p lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: COMBO-BOX: Whether the option popup is open. (valid values boolean); DROPDOWN: Whether the option popup is open. (valid values boolean).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:combo-box))) (lut:expanded-p w))"))))
(:entry "symbol/find-widget" :names ("FIND-WIDGET") :kind :function :kind-name "Function" :package "LUT" :summary "Return the first preorder node whose ID is EQUAL to ID, or NIL." :sections (("Signature" (:code-block "lisp" "(find-widget root id)")) ("Arguments and valid values" (:p "ROOT is a widget; ID is a string, symbol or NIL compared with EQUAL. Prefer unique non-NIL identifiers.")) ("Results and errors" (:p "First matching widget or NIL.")) ("Example" (:code-block "lisp" "(let ((w (lut:with-ui (lut:box) (lut:make-widget 'lut:entry :id :name)))) (lut:find-widget w :name))"))))
(:entry "symbol/focus" :names ("FOCUS") :kind :function :kind-name "Function" :package "LUT" :summary "Set keyboard focus to an enabled visible interactive descendant or NIL." :sections (("Signature" (:code-block "lisp" "(focus window widget)")) ("Arguments and valid values" (:p "WINDOW is the owning root; WIDGET is an enabled visible focusable descendant or NIL. Invalid targets signal ERROR.")) ("Results and errors" (:p "The new focused widget or NIL.")) ("Example" (:code-block "lisp" "(let* ((w (lut:make-widget 'lut:window)) (e (lut:add-child w (lut:make-widget 'lut:entry)))) (lut:focus w e))"))))
(:entry "symbol/focused-widget" :names ("FOCUSED-WIDGET") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WINDOW: Keyboard focus within this root. (valid values (or null widget))." :sections (("Signature" (:code-block "lisp" "(focused-widget lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WINDOW: Keyboard focus within this root. (valid values (or null widget)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:window))) (lut:focused-widget w))"))))
(:entry "symbol/font-size" :names ("FONT-SIZE") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: FONT-CHOOSER: Selected positive pixel size. (valid values (integer 1 *))." :sections (("Signature" (:code-block "lisp" "(font-size lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: FONT-CHOOSER: Selected positive pixel size. (valid values (integer 1 *)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:font-chooser))) (lut:font-size w))"))))
(:entry "symbol/frame-step" :names ("FRAME-STEP") :kind :function :kind-name "Function" :package "LUT" :summary "One frame, called by name so redefinition takes effect immediately." :sections (("Signature" (:code-block "lisp" "(frame-step w dt)")) ("Arguments and valid values" (:p "WINDOW is the primary root; DT is elapsed seconds. Requires active raylib context. Drains REPL edits and remote IPC, emits :TICK, lays out, handles input and draws.")) ("Results and errors" (:p "Unspecified.")) ("Example" (:code-block "lisp" "(lut:frame-step window 0.016)"))))
(:entry "symbol/group" :names ("GROUP") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: RADIO-BUTTON: Other radio-button instances in this exclusive group. (valid values list)." :sections (("Signature" (:code-block "lisp" "(group lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: RADIO-BUTTON: Other radio-button instances in this exclusive group. (valid values list).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:radio-button))) (lut:group w))"))))
(:entry "symbol/group-radios" :names ("GROUP-RADIOS") :kind :function :kind-name "Function" :package "LUT" :summary "Put RADIOS in one exclusive group and return the list." :sections (("Signature" (:code-block "lisp" "(group-radios &rest radios)")) ("Arguments and valid values" (:p "RADIOS are radio-button instances. Mutates each GROUP to the same list; subsequent activation enforces exclusivity.")) ("Results and errors" (:p "The radio list.")) ("Example" (:code-block "lisp" "(lut:group-radios (lut:make-widget 'lut:radio-button) (lut:make-widget 'lut:radio-button))"))))
(:entry "symbol/gutter-width" :names ("GUTTER-WIDTH") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: STYLED-TEXT-VIEW: Reserved left gutter width in pixels. (valid values (real 0 *))." :sections (("Signature" (:code-block "lisp" "(gutter-width lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: STYLED-TEXT-VIEW: Reserved left gutter width in pixels. (valid values (real 0 *)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:styled-text-view))) (lut:gutter-width w))"))))
(:entry "symbol/handle-event" :names ("HANDLE-EVENT") :kind :function :kind-name "Function" :package "LUT" :summary "Widget-specific event extension. Return true to consume EVENT before default dispatch." :sections (("Signature" (:code-block "lisp" "(handle-event widget event)")) ("Arguments and valid values" (:p "WIDGET is an extension receiver; EVENT a normalized event. Define a specialized method and return non-NIL to consume before default dispatch.")) ("Results and errors" (:p "True if consumed, NIL otherwise.")) ("Example" (:code-block "lisp" "(lut:handle-event (lut:make-widget 'lut:spin-button) (lut:make-event :kind :key :key :up))"))))
(:entry "symbol/handle-selection-event" :names ("HANDLE-SELECTION-EVENT") :kind :function :kind-name "Function" :package "LUT" :summary "Apply pointer :DOWN at supplied INDEX or keyboard Up/Down/Home/End to any model selection. Return handled-p." :sections (("Signature" (:code-block "lisp" "(handle-selection-event selection event &key index)")) ("Arguments and valid values" (:p "SELECTION is live, EVENT normalized. Pointer :DOWN uses supplied INDEX; keyboard Up/Down/Home/End uses current visible order. Shift extends, Ctrl/Cmd toggles. Independent of views.")) ("Results and errors" (:p "Handled-p.")) ("Example" (:code-block "lisp" "(lut:handle-selection-event (lut:make-selection-model (lut:make-vector-model '(a))) (lut:make-event :kind :key :key :end))"))))
(:entry "symbol/height" :names ("HEIGHT") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: MENU-SEPARATOR: Logical height reserved for the separator rule. (valid values (real 0 *)); WIDGET: Preferred height. (valid values (real 0 *))." :sections (("Signature" (:code-block "lisp" "(height lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: MENU-SEPARATOR: Logical height reserved for the separator rule. (valid values (real 0 *)); WIDGET: Preferred height. (valid values (real 0 *)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:menu-separator))) (lut:height w))"))))
(:entry "symbol/history-character-limit" :names ("HISTORY-CHARACTER-LIMIT") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: ENTRY: Maximum removed plus inserted characters retained per history stack; zero disables retention. (valid values (integer 0 *)); TEXT-BUFFER: Maximum removed plus inserted characters retained in each shared history stack. (valid values (integer 0 *))." :sections (("Signature" (:code-block "lisp" "(history-character-limit lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: ENTRY: Maximum removed plus inserted characters retained per history stack; zero disables retention. (valid values (integer 0 *)); TEXT-BUFFER: Maximum removed plus inserted characters retained in each shared history stack. (valid values (integer 0 *)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:entry))) (lut:history-character-limit w))"))))
(:entry "symbol/history-limit" :names ("HISTORY-LIMIT") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: DOCUMENT-VIEW: Standalone document refreshes do not retain undo by default; shared models keep their own policy. (valid values (integer 0 *)); ENTRY: Maximum range records per undo/redo stack; zero disables history. (valid values (integer 0 *)); TEXT-BUFFER: Maximum range records in each shared history stack. (valid values (integer 0 *))." :sections (("Signature" (:code-block "lisp" "(history-limit lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: DOCUMENT-VIEW: Standalone document refreshes do not retain undo by default; shared models keep their own policy. (valid values (integer 0 *)); ENTRY: Maximum range records per undo/redo stack; zero disables history. (valid values (integer 0 *)); TEXT-BUFFER: Maximum range records in each shared history stack. (valid values (integer 0 *)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:document-view))) (lut:history-limit w))"))))
(:entry "symbol/hit-test" :names ("HIT-TEST") :kind :function :kind-name "Function" :package "LUT" :summary "Return deepest visible enabled widget inside all ancestor bounds." :sections (("Signature" (:code-block "lisp" "(hit-test w px py)")) ("Arguments and valid values" (:p "WIDGET is a widget; PX/PY real root coordinates. Excludes hidden, disabled, inactive and clipped descendants.")) ("Results and errors" (:p "Deepest eligible widget, or NIL.")) ("Example" (:code-block "lisp" "(let ((b (lut:make-widget 'lut:button))) (lut:hit-test b 10 10))"))))
(:entry "symbol/id" :names ("ID") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: Optional application identifier used by FIND-WIDGET. (valid values (or null string symbol))." :sections (("Signature" (:code-block "lisp" "(id lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: Optional application identifier used by FIND-WIDGET. (valid values (or null string symbol)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:widget))) (lut:id w))"))))
(:entry "symbol/install-command-menu" :names ("INSTALL-COMMAND-MENU") :kind :function :kind-name "Function" :package "LUT" :summary "Install one menu per WINDOW. GROUPS are (:LABEL string :COMMANDS (command ... :SEPARATOR ...)) plists; NIL also separates. NATIVE :AUTO/T/NIL selects preference; workers retain drawn menus. Commands stay application-owned." :sections (("Signature" (:code-block "lisp" "(install-command-menu window groups &key (native :auto) (context window))")) ("Arguments and valid values" (:p "WINDOW is live, with at most one installed handle. GROUPS are copied (:LABEL string :COMMANDS (command :SEPARATOR command ...)) plists; NIL also separates. CONTEXT defaults WINDOW. NATIVE :AUTO upgrades in eligible primary macOS contexts, NIL always draws, T requires an eligible native context. Commands remain application-owned. Native labels/enabled/shortcuts update each frame; supported equivalents replace drawn bindings.")) ("Results and errors" (:p "Window-owned COMMAND-MENU. Dispose removes native/drawn UI and bindings; context-close restores prior native menu.")) ("Example" (:code-block "lisp" "(lut:install-command-menu window (list (list :label \"File\" :commands (list command :separator command))))"))))
(:entry "symbol/invalidate-text-geometry" :names ("INVALIDATE-TEXT-GEOMETRY") :kind :function :kind-name "Function" :package "LUT" :summary "Clear VIEW's measured line caches after application-defined font/measurement state changes. Return VIEW." :sections (("Signature" (:code-block "lisp" "(invalidate-text-geometry view)")) ("Arguments and valid values" (:p "VIEW is a live label/entry/text view. Standard text/font/style changes invalidate automatically. Call after changing external state used by custom text measurement methods.")) ("Results and errors" (:p "VIEW, after clearing measured line caches.")) ("Example" (:code-block "lisp" "(lut:invalidate-text-geometry (lut:make-widget 'lut:text-view))"))))
(:entry "symbol/invalidate-text-presentation" :names ("INVALIDATE-TEXT-PRESENTATION") :kind :function :kind-name "Function" :package "LUT" :summary "Invalidate measurements after external presentation/font changes and emit :PRESENTATION-CHANGE. Return revision." :sections (("Signature" (:code-block "lisp" "(invalidate-text-presentation view)")) ("Arguments and valid values" (:p "VIEW is live and styled. Increments presentation generation and clears line metrics/preferred navigation X after external font/presentation state changes. Does not edit content or history.")) ("Results and errors" (:p "New revision; emits :PRESENTATION-CHANGE.")) ("Example" (:code-block "lisp" "(lut:invalidate-text-presentation (lut:make-widget 'lut:styled-text-view))"))))
(:entry "symbol/invoke-command" :names ("INVOKE-COMMAND") :kind :function :kind-name "Function" :package "LUT" :summary "Recheck availability, then execute COMMAND with CONTEXT. Return executed-p and the action's primary result." :sections (("Signature" (:code-block "lisp" "(invoke-command command &optional context)")) ("Arguments and valid values" (:p "COMMAND is a command. Rechecks availability with CONTEXT, then calls its action exactly once. Direct programmatic invocation has no window/modal policy; bindings enforce UI policy. Errors propagate.")) ("Results and errors" (:p "Executed-p and the primary action result; unavailable returns NIL/NIL. A NIL result can still have executed-p T.")) ("Example" (:code-block "lisp" "(lut:invoke-command (lut:make-command :hello \"Hello\" (lambda (c context) (declare (ignore c context)) :done)) nil)"))))
(:entry "symbol/item-label-function" :names ("ITEM-LABEL-FUNCTION") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: SUGGESTION-SURFACE: Pure candidate-to-string function designator. (valid values (or symbol function))." :sections (("Signature" (:code-block "lisp" "(item-label-function lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: SUGGESTION-SURFACE: Pure candidate-to-string function designator. (valid values (or symbol function)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:suggestion-surface))) (lut:item-label-function w))"))))
(:entry "symbol/items" :names ("ITEMS") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: SUGGESTION-SURFACE: Application candidates, retained until replaced or disposed. (valid values list); NOTEBOOK: Tab labels corresponding to children. (valid values list); COMBO-BOX: Available completion strings. (valid values list); LIST-VIEW: Strings displayed as rows. (valid values list)." :sections (("Signature" (:code-block "lisp" "(items lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: SUGGESTION-SURFACE: Application candidates, retained until replaced or disposed. (valid values list); NOTEBOOK: Tab labels corresponding to children. (valid values list); COMBO-BOX: Available completion strings. (valid values list); LIST-VIEW: Strings displayed as rows. (valid values list).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:suggestion-surface))) (lut:items w))"))))
(:entry "symbol/layout" :names ("LAYOUT") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET is a widget; X/Y are real coordinates; WIDTH/HEIGHT non-negative pixel extents. Updates allocation and lays out container children. Override methods for custom layout." :sections (("Signature" (:code-block "lisp" "(layout widget x y width height)")) ("Arguments and valid values" (:p "WIDGET is a widget; X/Y are real coordinates; WIDTH/HEIGHT non-negative pixel extents. Updates allocation and lays out container children. Override methods for custom layout.")) ("Results and errors" (:p "WIDGET.")) ("Example" (:code-block "lisp" "(lut:layout (lut:make-widget 'lut:box) 0 0 640 480)"))))
(:entry "symbol/line-height" :names ("LINE-HEIGHT") :kind :function :kind-name "Function" :package "LUT" :summary "Styled text line height in pixels." :sections (("Signature" (:code-block "lisp" "(line-height w)")) ("Arguments and valid values" (:p "WIDGET has styles; :LINE-HEIGHT must be a positive real pixel extent.")) ("Results and errors" (:p "Positive real.")) ("Example" (:code-block "lisp" "(lut:line-height (lut:make-widget 'lut:text-view))"))))
(:entry "symbol/make-command" :names ("MAKE-COMMAND") :kind :function :kind-name "Function" :package "LUT" :summary "Construct a nonvisual COMMAND. ACTION and optional ENABLED-WHEN take (command context)." :sections (("Signature" (:code-block "lisp" "(make-command id label action &key (enabled-p t) enabled-when shortcut)")) ("Arguments and valid values" (:p "ID is a symbol/string/NIL, LABEL a string, ACTION a function designator taking (command context). ENABLED-P is the master boolean. ENABLED-WHEN is an optional pure predicate with the same arguments. SHORTCUT is a normalized keyword or exact key/modifier plist.")) ("Results and errors" (:p "A nonvisual COMMAND; keep it outside the visual child tree.")) ("Example" (:code-block "lisp" "(lut:make-command :hello \"Hello\" (lambda (command context) (declare (ignore command context)) (print :hello)) :shortcut :f6)"))))
(:entry "symbol/make-data-column" :names ("MAKE-DATA-COLUMN") :kind :function :kind-name "Function" :package "LUT" :summary "Column ID/TITLE, GETTER(item), FORMATTER(value), optional SETTER(item,text), EDITOR-FACTORY(view,key,column,value), CELL-FACTORY(item,value)." :sections (("Signature" (:code-block "lisp" "(make-data-column &key id (title \"\") (getter #'identity) (formatter #'princ-to-string) setter editor-factory cell-factory)")) ("Arguments and valid values" (:p "Non-NIL ID, string TITLE, GETTER(item), FORMATTER(value); optional CELL-FACTORY(item,value) returns string or :TEXT/:FOREGROUND/:BACKGROUND plist. SETTER(item,text) enables editing. EDITOR-FACTORY(view,key,column,value) returns unparented entry. Treat definitions as immutable.")) ("Results and errors" (:p "Shared DATA-COLUMN description.")) ("Example" (:code-block "lisp" "(lut:make-data-column :id :name :title \"Name\" :getter #'identity)"))))
(:entry "symbol/make-event" :names ("MAKE-EVENT") :kind :function :kind-name "Function" :package "LUT" :summary "KIND is :DOWN/:MOVE/:UP/:WHEEL/:KEY/:TEXT/:CONTEXT/:GESTURE. X/Y/DELTA real; KEY a keyword or NIL; TEXT string; SHIFT-P/CONTROL-P/ALT-P/SUPER-P boolean. BASE-KEY is the original key before aliases such as :COPY; native input populates it, synthetic events may supply it. TIMESTAMP optionally supplies monotonic seconds for repeated-click inference on :DOWN (0.5-second/5-pixel thresholds on the same view). CLICK-COUNT optionally forces 1/2/3. Both fields survive worker IPC. Synthetic events without either field remain single clicks. Defaults: coordinates/delta 0, text empty, keys/modifiers/timestamp/click-count NIL." :sections (("Signature" (:code-block "lisp" "(make-event &key lut-docs::kind lut-docs::x lut-docs::y lut-docs::key lut-docs::base-key lut-docs::text lut-docs::delta lut-docs::shift-p lut-docs::control-p lut-docs::alt-p lut-docs::super-p lut-docs::timestamp lut-docs::click-count)")) ("Arguments and valid values" (:p "KIND is :DOWN/:MOVE/:UP/:WHEEL/:KEY/:TEXT/:CONTEXT/:GESTURE. X/Y/DELTA real; KEY a keyword or NIL; TEXT string; SHIFT-P/CONTROL-P/ALT-P/SUPER-P boolean. BASE-KEY is the original key before aliases such as :COPY; native input populates it, synthetic events may supply it. TIMESTAMP optionally supplies monotonic seconds for repeated-click inference on :DOWN (0.5-second/5-pixel thresholds on the same view). CLICK-COUNT optionally forces 1/2/3. Both fields survive worker IPC. Synthetic events without either field remain single clicks. Defaults: coordinates/delta 0, text empty, keys/modifiers/timestamp/click-count NIL.")) ("Results and errors" (:p "A normalized event.")) ("Example" (:code-block "lisp" "(lut:make-event :kind :text :text \"Ελληνικά\")"))))
(:entry "symbol/make-function-model" :names ("MAKE-FUNCTION-MODEL") :kind :function :kind-name "Function" :package "LUT" :summary "COUNT is a nonnegative integer or zero-argument function; ITEM/KEY map index to item/key. INDEX maps key to index or NIL." :sections (("Signature" (:code-block "lisp" "(make-function-model &key count item (key #'identity) index)")) ("Arguments and valid values" (:p "COUNT is an integer or zero-argument function; ITEM and KEY map visible index to item/key; INDEX optionally maps key to index. Keys must be unique, non-NIL and stable under EQUAL. No row materialization; caller publishes external changes.")) ("Results and errors" (:p "Application-owned DATA-MODEL.")) ("Example" (:code-block "lisp" "(lut:make-function-model :count 1000000 :item #'princ-to-string)"))))
(:entry "symbol/make-projection-model" :names ("MAKE-PROJECTION-MODEL") :kind :function :kind-name "Function" :package "LUT" :summary "A sorted/filtered index over SOURCE; retains items and stable identities without copying row data." :sections (("Signature" (:code-block "lisp" "(make-projection-model source &key predicate lessp)")) ("Arguments and valid values" (:p "SOURCE is live. PREDICATE receives item; LESSP compares two items. Callbacks are pure. Filtering is O(n), sorting stable O(n log n), O(n) index storage. Owns neither source nor items.")) ("Results and errors" (:p "Sorted/filtered DATA-MODEL retaining original keys/items.")) ("Example" (:code-block "lisp" "(lut:make-projection-model (lut:make-vector-model '(3 1 2)) :lessp #'<)"))))
(:entry "symbol/make-selection-model" :names ("MAKE-SELECTION-MODEL") :kind :function :kind-name "Function" :package "LUT" :summary "Independent :NONE/:SINGLE/:MULTIPLE keyed selection. A range follows current visible model order." :sections (("Signature" (:code-block "lisp" "(make-selection-model model &key (mode :single))")) ("Arguments and valid values" (:p "MODEL is live, MODE is :NONE/:SINGLE/:MULTIPLE. Selection is independent of widgets; tracks stable keys and prunes deleted keys while retaining hidden ones.")) ("Results and errors" (:p "Application-owned SELECTION-MODEL.")) ("Example" (:code-block "lisp" "(lut:make-selection-model (lut:make-vector-model '(a b)) :mode :multiple)"))))
(:entry "symbol/make-text-buffer" :names ("MAKE-TEXT-BUFFER") :kind :function :kind-name "Function" :package "LUT" :summary "Make a nonvisual shared text/history model. Views retain independent cursor/selection/scroll state." :sections (("Signature" (:code-block "lisp" "(make-text-buffer &key (text \"\") read-only-p (history-limit 100) (history-character-limit 262144))")) ("Arguments and valid values" (:p "TEXT is a string; READ-ONLY-P controls editing APIs, not programmatic SETF TEXT. History limits bound shared range records; the character budget counts removed plus inserted text, not full-buffer size. Keep this nonvisual model outside the visual child tree.")) ("Results and errors" (:p "A shared TEXT-BUFFER.")) ("Example" (:code-block "lisp" "(lut:make-text-buffer :text \"Shared text\" :history-limit 100)"))))
(:entry "symbol/make-tree-model" :names ("MAKE-TREE-MODEL") :kind :function :kind-name "Function" :package "LUT" :summary "Tree of application objects. KEY supplies stable identity; CHILDREN returns a finite sequence. Initially collapsed." :sections (("Signature" (:code-block "lisp" "(make-tree-model roots &key (key #'identity) children)")) ("Arguments and valid values" (:p "ROOTS is a finite sequence. KEY maps item to stable key; CHILDREN maps item to finite child sequence. Validates all keys including collapsed nodes. Initially collapsed; O(all nodes) metadata, no row widgets.")) ("Results and errors" (:p "Application-owned tree DATA-MODEL.")) ("Example" (:code-block "lisp" "(lut:make-tree-model '(a) :children (constantly nil))"))))
(:entry "symbol/make-vector-model" :names ("MAKE-VECTOR-MODEL") :kind :function :kind-name "Function" :package "LUT" :summary "Copy a sequence of application items. KEY maps each item to a unique stable non-NIL identity." :sections (("Signature" (:code-block "lisp" "(make-vector-model items &key (key #'identity))")) ("Arguments and valid values" (:p "ITEMS is a sequence; KEY maps each item to an immutable unique non-NIL EQUAL key. Copies sequence structure, not items; validates duplicates before construction.")) ("Results and errors" (:p "Application-owned DATA-MODEL.")) ("Example" (:code-block "lisp" "(lut:make-vector-model '(a b c))"))))
(:entry "symbol/make-widget" :names ("MAKE-WIDGET") :kind :function :kind-name "Function" :package "LUT" :summary "Construct CLASS with CLOS initargs." :sections (("Signature" (:code-block "lisp" "(make-widget class &rest initargs)")) ("Arguments and valid values" (:p "CLASS is a widget class symbol; INITARGS are the documented keyword initargs for that class. Invalid types signal TYPE-ERROR; inconsistent numeric bounds signal ERROR.")) ("Results and errors" (:p "A new widget.")) ("Example" (:code-block "lisp" "(lut:make-widget 'lut:button :text \"Hello\")"))))
(:entry "symbol/map-visible-model-rows" :names ("MAP-VISIBLE-MODEL-ROWS") :kind :function :kind-name "Function" :package "LUT" :summary "Call FUNCTION with (INDEX KEY ITEM X Y WIDTH HEIGHT) only for visible rows. Return visited count." :sections (("Signature" (:code-block "lisp" "(map-visible-model-rows view function)")) ("Arguments and valid values" (:p "VIEW is model-backed. FUNCTION receives INDEX KEY ITEM X Y WIDTH HEIGHT for visible rows only, without building row widgets/ITEMS strings.")) ("Results and errors" (:p "Visited row count.")) ("Example" (:code-block "lisp" "(lut:map-visible-model-rows (lut:make-widget 'lut:model-list-view :model (lut:make-vector-model '(a))) (lambda (&rest row) row))"))))
(:entry "symbol/map-visible-text-lines" :names ("MAP-VISIBLE-TEXT-LINES") :kind :function :kind-name "Function" :package "LUT" :summary "Call FUNCTION with (LINE START END X Y) for vertically visible logical lines. END excludes newline; no text copies. Return count." :sections (("Signature" (:code-block "lisp" "(map-visible-text-lines view function)")) ("Arguments and valid values" (:p "VIEW is a label/entry/text view. FUNCTION receives LINE START END X Y for each vertically intersecting logical line; END excludes newline, coordinates are root pixels. No text copies; return values of FUNCTION ignored. Do not edit/rebind/dispose the view during iteration.")) ("Results and errors" (:p "Number of visited lines.")) ("Example" (:code-block "lisp" "(lut:map-visible-text-lines (lut:make-widget 'lut:text-view :text \"abc\") (lambda (line start end x y) (list line start end x y)))"))))
(:entry "symbol/maximum" :names ("MAXIMUM") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: SLIDER: Upper inclusive bound. (valid values real)." :sections (("Signature" (:code-block "lisp" "(maximum lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: SLIDER: Upper inclusive bound. (valid values real).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:slider))) (lut:maximum w))"))))
(:entry "symbol/minimum" :names ("MINIMUM") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: SLIDER: Lower inclusive bound. (valid values real)." :sections (("Signature" (:code-block "lisp" "(minimum lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: SLIDER: Lower inclusive bound. (valid values real).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:slider))) (lut:minimum w))"))))
(:entry "symbol/modal-p" :names ("MODAL-P") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: DIALOG: Block input to the owner while this native dialog is open. (valid values boolean)." :sections (("Signature" (:code-block "lisp" "(modal-p lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: DIALOG: Block input to the owner while this native dialog is open. (valid values boolean).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:dialog))) (lut:modal-p w))"))))
(:entry "symbol/model-branch-p" :names ("MODEL-BRANCH-P") :kind :function :kind-name "Function" :package "LUT" :summary "MODEL is live, INDEX visible. Whether row has children, including when collapsed." :sections (("Signature" (:code-block "lisp" "(model-branch-p model index)")) ("Arguments and valid values" (:p "MODEL is live, INDEX visible. Whether row has children, including when collapsed.")) ("Results and errors" (:p "Boolean.")) ("Example" (:code-block "lisp" "(lut:model-branch-p (lut:make-vector-model '(a)) 0)"))))
(:entry "symbol/model-contains-key-p" :names ("MODEL-CONTAINS-KEY-P") :kind :function :kind-name "Function" :package "LUT" :summary "Whether KEY still exists, including hidden/filtered tree rows." :sections (("Signature" (:code-block "lisp" "(model-contains-key-p model key)")) ("Arguments and valid values" (:p "MODEL is live. Includes keys hidden by filtering or tree collapse; use MODEL-INDEX for visible membership.")) ("Results and errors" (:p "Generalized boolean.")) ("Example" (:code-block "lisp" "(lut:model-contains-key-p (lut:make-vector-model '(a)) 'a)"))))
(:entry "symbol/model-count" :names ("MODEL-COUNT") :kind :function :kind-name "Function" :package "LUT" :summary "Number of currently visible rows; must not materialize row strings." :sections (("Signature" (:code-block "lisp" "(model-count model)")) ("Arguments and valid values" (:p "MODEL is live. Return the number of visible rows without formatting row data.")) ("Results and errors" (:p "Nonnegative integer.")) ("Example" (:code-block "lisp" "(lut:model-count (lut:make-vector-model '(a b)))"))))
(:entry "symbol/model-depth" :names ("MODEL-DEPTH") :kind :function :kind-name "Function" :package "LUT" :summary "MODEL is live, INDEX visible. Tree rows supply depth; ordinary rows return 0; projections forward source depth." :sections (("Signature" (:code-block "lisp" "(model-depth model index)")) ("Arguments and valid values" (:p "MODEL is live, INDEX visible. Tree rows supply depth; ordinary rows return 0; projections forward source depth.")) ("Results and errors" (:p "Nonnegative integer.")) ("Example" (:code-block "lisp" "(lut:model-depth (lut:make-vector-model '(a)) 0)"))))
(:entry "symbol/model-index" :names ("MODEL-INDEX") :kind :function :kind-name "Function" :package "LUT" :summary "Visible index of KEY, or NIL. Implement for efficient lazy-model lookup." :sections (("Signature" (:code-block "lisp" "(model-index model key)")) ("Arguments and valid values" (:p "MODEL is live; KEY is an EQUAL stable identity. Function models scan keys unless an INDEX callback is supplied.")) ("Results and errors" (:p "Visible zero-based index, including 0, or NIL for hidden/missing keys.")) ("Example" (:code-block "lisp" "(lut:model-index (lut:make-vector-model '(a b)) 'b)"))))
(:entry "symbol/model-item" :names ("MODEL-ITEM") :kind :function :kind-name "Function" :package "LUT" :summary "Application item at a zero-based visible INDEX." :sections (("Signature" (:code-block "lisp" "(model-item model index)")) ("Arguments and valid values" (:p "MODEL is live; INDEX is a valid visible zero-based index. Returns original application object, not a copy.")) ("Results and errors" (:p "Application item; invalid index signals.")) ("Example" (:code-block "lisp" "(lut:model-item (lut:make-vector-model '(a b)) 0)"))))
(:entry "symbol/model-key" :names ("MODEL-KEY") :kind :function :kind-name "Function" :package "LUT" :summary "Stable non-NIL EQUAL identity at visible INDEX." :sections (("Signature" (:code-block "lisp" "(model-key model index)")) ("Arguments and valid values" (:p "MODEL is live; INDEX is a valid visible index. Key is immutable, unique, non-NIL and stable across reorderings.")) ("Results and errors" (:p "Original key object.")) ("Example" (:code-block "lisp" "(lut:model-key (lut:make-vector-model '(a b)) 0)"))))
(:entry "symbol/model-revision" :names ("MODEL-REVISION") :kind :function :kind-name "Function" :package "LUT" :summary "MODEL is a data model. Independent monotonically increasing generation after explicit notifications/committed updates." :sections (("Signature" (:code-block "lisp" "(model-revision lut-docs::object)")) ("Arguments and valid values" (:p "MODEL is a data model. Independent monotonically increasing generation after explicit notifications/committed updates.")) ("Results and errors" (:p "Nonnegative integer.")) ("Example" (:code-block "lisp" "(lut:model-revision (lut:make-vector-model nil))"))))
(:entry "symbol/move-page" :names ("MOVE-PAGE") :kind :function :kind-name "Function" :package "LUT" :summary "Move PAGE from SOURCE notebook to TARGET at insertion boundary INDEX (0..target count), preserving caption and selecting PAGE. Same-window only." :sections (("Signature" (:code-block "lisp" "(move-page source page target index)")) ("Arguments and valid values" (:p "SOURCE and TARGET are notebooks sharing a root. PAGE must be a child of SOURCE. INDEX is an insertion boundary 0..target child count, before removal. Same-source boundaries adjust for removal. No group/reorder opt-in required for explicit programmatic moves; pointer transfers require matching non-NIL groups. Rejects cycles and invalid indices before mutation.")) ("Results and errors" (:p "PAGE. Emits :CHANGE and :PAGES-CHANGED after structural updates.")) ("Example" (:code-block "lisp" "(lut:move-page source page target 0)"))))
(:entry "symbol/move-text-cursor" :names ("MOVE-TEXT-CURSOR") :kind :function :kind-name "Function" :package "LUT" :summary "Move by character, word, logical line or document. EXTEND preserves the anchor. Return the new character position." :sections (("Signature" (:code-block "lisp" "(move-text-cursor view movement &key extend)")) ("Arguments and valid values" (:p "VIEW is a live entry/text view. MOVEMENT is :LEFT/:RIGHT/:WORD-LEFT/:WORD-RIGHT/:LINE-START/:LINE-END/:DOCUMENT-START/:DOCUMENT-END/:UP/:DOWN. EXTEND preserves the anchor; otherwise the caret and anchor collapse together. Left/right (including word movement) collapse existing selections to the corresponding edge. Vertical moves retain a preferred pixel X across short lines; other moves/manual cursor assignment reset it. Uses shared display geometry and reveals the caret.")) ("Results and errors" (:p "New character position.")) ("Example" (:code-block "lisp" "(lut:move-text-cursor (lut:make-widget 'lut:text-view :text \"alpha beta\") :word-right :extend t)"))))
(:entry "symbol/nodes" :names ("NODES") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: TREE-VIEW: Nested node property lists; expansion is stored in each node. (valid values list)." :sections (("Signature" (:code-block "lisp" "(nodes lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: TREE-VIEW: Nested node property lists; expansion is stored in each node. (valid values list).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:tree-view))) (lut:nodes w))"))))
(:entry "symbol/notify-model-change" :names ("NOTIFY-MODEL-CHANGE") :kind :function :kind-name "Function" :package "LUT" :summary "Publish an externally committed change. Advances revision, then emits :MODEL-CHANGE with that revision." :sections (("Signature" (:code-block "lisp" "(notify-model-change model)")) ("Arguments and valid values" (:p "MODEL is live. Call after application-owned content changes; caller must preserve key uniqueness/identity. Reentrant notifications/mutations rejected. Observer errors propagate after commit.")) ("Results and errors" (:p "MODEL; emits :MODEL-CHANGE with new revision.")) ("Example" (:code-block "lisp" "(lut:notify-model-change (lut:make-vector-model '(a)))"))))
(:entry "symbol/off" :names ("OFF") :kind :function :kind-name "Function" :package "LUT" :summary "Remove matching bindings. NIL EVENT/CALLBACK match any event/callback. Return number removed." :sections (("Signature" (:code-block "lisp" "(off widget &optional event callback)")) ("Arguments and valid values" (:p "WIDGET is an event source. EVENT and CALLBACK are optional; NIL matches all. Disconnects every matching connection, including owner-side bookkeeping and callback references.")) ("Results and errors" (:p "Number of removed connections.")) ("Example" (:code-block "lisp" "(let ((b (lut:make-widget 'lut:button))) (lut:on b :activate (lambda (w p) (declare (ignore w p)))) (lut:off b :activate))"))))
(:entry "symbol/on" :names ("ON") :kind :function :kind-name "Function" :package "LUT" :summary "Register CALLBACK (widget payload). OWNER optionally disconnects this binding when disposed.
Return CALLBACK and, as a second value, a CONNECTION handle for DISCONNECT." :sections (("Signature" (:code-block "lisp" "(on widget event callback &key owner)")) ("Arguments and valid values" (:p "WIDGET is a widget; EVENT is :ACTIVATE, :CHANGE, :TICK, :CONTEXT or an application keyword. CALLBACK is a function or symbol taking (widget payload); registrations are additive and ordered. OWNER optionally is a widget whose disposal disconnects this binding. Use an owner for callbacks capturing transient controls.")) ("Results and errors" (:p "CALLBACK and a CONNECTION handle as a second value.")) ("Example" (:code-block "lisp" "(lut:on (lut:make-widget 'lut:button) :activate (lambda (widget payload) (declare (ignore widget payload)) (print :clicked)))"))))
(:entry "symbol/on-ui" :names ("ON-UI") :kind :macro :kind-name "Macro" :package "LUT" :summary "Execute BODY between frames on the GUI thread. Use ON-WIDGET for owned work." :sections (("Signature" (:code-block "lisp" "(on-ui &body body)")) ("Arguments and valid values" (:p "BODY is code captured as a closure and executed before a subsequent GUI frame. Lexical variables are captured. Paused error screens must resume before draining.")) ("Results and errors" (:p "Queued closure.")) ("Example" (:code-block "lisp" "(lut:on-ui (lut:add-child lut:*window* (lut:make-widget 'lut:label :text \"Live\")))"))))
(:entry "symbol/on-widget" :names ("ON-WIDGET") :kind :macro :kind-name "Macro" :package "LUT" :summary "Queue BODY owned by WIDGET. Disposing the owner cancels pending work and releases the closure." :sections (("Signature" (:code-block "lisp" "(on-widget widget &body body)")) ("Arguments and valid values" (:p "WIDGET is a live owner. BODY is queued as a closure like ON-UI, but pending work is automatically cancelled and released when the owner is disposed.")) ("Results and errors" (:p "The closure and a cancellable job handle as two values.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:label))) (lut:on-widget w (setf (lut:text w) \"Updated\")) (lut:dispose w))"))))
(:entry "symbol/on-window" :names ("ON-WINDOW") :kind :macro :kind-name "Macro" :package "LUT" :summary "Evaluate quoted FORMS in REMOTE's native GUI process. Use for explicit native worker operations; application class/method reloads belong in ON-UI." :sections (("Signature" (:code-block "lisp" "(on-window remote &body forms)")) ("Arguments and valid values" (:p "REMOTE expression returns a handle; BODY forms are quoted and sent for explicit native-operation evaluation in that worker. Lexical parent variables are not captured; ordinary app edits use ON-UI.")) ("Results and errors" (:p "REMOTE.")) ("Example" (:code-block "lisp" "(lut:on-window remote (asdf:load-system \"lut\" :force t))"))))
(:entry "symbol/open-context-menu" :names ("OPEN-CONTEXT-MENU") :kind :function :kind-name "Function" :package "LUT" :summary "Open a pointer-positioned menu. ACTIONS are (caption callback enabled-p) lists or :SEPARATOR (NIL also separates).
Without ACTIONS, ENTRY gets Cut/Copy/Paste/Select all. Callbacks take no arguments." :sections (("Signature" (:code-block "lisp" "(open-context-menu window target event &optional actions)")) ("Arguments and valid values" (:p "WINDOW is root; TARGET is the owner; EVENT provides logical pointer coordinates. ACTIONS optionally lists (caption no-argument-callback enabled-p) records and :SEPARATOR (or NIL) entries. Separators are noninteractive MENU-SEPARATOR widgets and take no keyboard focus. Defaults to entry editing actions. Outside click/Escape dismisses.")) ("Results and errors" (:p "Menu or NIL when no actions apply.")) ("Example" (:code-block "lisp" "(let* ((w (lut:make-widget 'lut:window :width 600 :height 400)) (e (lut:add-child w (lut:make-widget 'lut:entry)))) (lut:open-context-menu w e (lut:make-event :kind :context :x 20 :y 20)))"))))
(:entry "symbol/orientation" :names ("ORIENTATION") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: HEADER-BAR: Default horizontal orientation. (valid values (member :horizontal :vertical)); PANED: Splitter direction. (valid values (member :horizontal :vertical)); BOX: Stack direction. (valid values (member :vertical :horizontal))." :sections (("Signature" (:code-block "lisp" "(orientation lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: HEADER-BAR: Default horizontal orientation. (valid values (member :horizontal :vertical)); PANED: Splitter direction. (valid values (member :horizontal :vertical)); BOX: Stack direction. (valid values (member :vertical :horizontal)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:header-bar))) (lut:orientation w))"))))
(:entry "symbol/parent" :names ("PARENT") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: Managed by ADD-CHILD; do not assign directly. (valid values (or null widget))." :sections (("Signature" (:code-block "lisp" "(parent lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: Managed by ADD-CHILD; do not assign directly. (valid values (or null widget)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:widget))) (lut:parent w))"))))
(:entry "symbol/path-request-dialog" :names ("PATH-REQUEST-DIALOG") :kind :function :kind-name "Function" :package "LUT" :summary "REQUEST is a path-request handle. Native requests are synchronous and expose no portable widget." :sections (("Signature" (:code-block "lisp" "(path-request-dialog lut-docs::handle)")) ("Arguments and valid values" (:p "REQUEST is a path-request handle. Native requests are synchronous and expose no portable widget.")) ("Results and errors" (:p "Active portable dialog or NIL.")) ("Example" (:code-block "lisp" "(lut:path-request-dialog request)"))))
(:entry "symbol/path-request-result" :names ("PATH-REQUEST-RESULT") :kind :function :kind-name "Function" :package "LUT" :summary "REQUEST is a path-request handle. FILE/FOLDER results canonical; SAVE result is a path only, never a written file. Cleared on disposal." :sections (("Signature" (:code-block "lisp" "(path-request-result lut-docs::handle)")) ("Arguments and valid values" (:p "REQUEST is a path-request handle. FILE/FOLDER results canonical; SAVE result is a path only, never a written file. Cleared on disposal.")) ("Results and errors" (:p "Pathname or NIL.")) ("Example" (:code-block "lisp" "(lut:path-request-result request)"))))
(:entry "symbol/path-request-state" :names ("PATH-REQUEST-STATE") :kind :function :kind-name "Function" :package "LUT" :summary "REQUEST is a path-request handle. Completion/cancellation commits before invoking the callback. Window/request disposal cancels pending work silently." :sections (("Signature" (:code-block "lisp" "(path-request-state lut-docs::handle)")) ("Arguments and valid values" (:p "REQUEST is a path-request handle. Completion/cancellation commits before invoking the callback. Window/request disposal cancels pending work silently.")) ("Results and errors" (:p ":PENDING/:ACCEPTED/:CANCELLED.")) ("Example" (:code-block "lisp" "(lut:path-request-state request)"))))
(:entry "symbol/perform-drop" :names ("PERFORM-DROP") :kind :function :kind-name "Function" :package "LUT" :summary "Commit an accepted drop. Return true for success, NIL for rejection. :DROP is emitted after success." :sections (("Signature" (:code-block "lisp" "(perform-drop target session event)")) ("Arguments and valid values" (:p "TARGET passed acceptance; SESSION and EVENT describe release. Override to commit the operation; default true permits an ON :DROP handler to implement it. Errors propagate after drag cleanup; application changes are not rolled back.")) ("Results and errors" (:p "True on success, NIL to reject.")) ("Example" (:code-block "lisp" "(lut:perform-drop target session (lut:make-event :kind :up))"))))
(:entry "symbol/platform-capabilities" :names ("PLATFORM-CAPABILITIES") :kind :function :kind-name "Function" :package "LUT" :summary "Return fresh capability audit records. Native availability requires an eligible primary macOS context; text gaps are explicit." :sections (("Signature" (:code-block "lisp" "(platform-capabilities window)")) ("Arguments and valid values" (:p "WINDOW is a root. Returns fresh audit plists with :NAME and :STATUS. Native menus/pickers are eligible-primary-context capabilities; text shaping/bidi/IME composition/accessibility remain unsupported; Linux/Windows native checks unverified. See docs/platform-integration.md for backend strategies and verification limits.")) ("Results and errors" (:p "Fresh list of audit records.")) ("Example" (:code-block "lisp" "(lut:platform-capabilities (lut:make-widget 'lut:window))"))))
(:entry "symbol/platform-capability" :names ("PLATFORM-CAPABILITY") :kind :function :kind-name "Function" :package "LUT" :summary "Return one copied capability audit record, or NIL for unknown NAME." :sections (("Signature" (:code-block "lisp" "(platform-capability window name)")) ("Arguments and valid values" (:p "WINDOW is a root, NAME a capability keyword. Does not equate committed text input with IME composition support.")) ("Results and errors" (:p "Copied audit record or NIL.")) ("Example" (:code-block "lisp" "(lut:platform-capability (lut:make-widget 'lut:window) :ime-composition)"))))
(:entry "symbol/position-mode" :names ("POSITION-MODE") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: POPOVER: Popup position is in root pixels. (valid values (member :center :absolute)); DIALOG: Centered until dragged, then absolute coordinates. (valid values (member :center :absolute))." :sections (("Signature" (:code-block "lisp" "(position-mode lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: POPOVER: Popup position is in root pixels. (valid values (member :center :absolute)); DIALOG: Centered until dragged, then absolute coordinates. (valid values (member :center :absolute)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:popover))) (lut:position-mode w))"))))
(:entry "symbol/range-fraction" :names ("RANGE-FRACTION") :kind :function :kind-name "Function" :package "LUT" :summary "Return VALUE's clamped fraction in MINIMUM..MAXIMUM. A zero-width range returns zero." :sections (("Signature" (:code-block "lisp" "(range-fraction control)")) ("Arguments and valid values" (:p "CONTROL is a slider/progress/spin control. Bounds enclose VALUE. Zero-length ranges return 0; fractional ranges retain their scale.")) ("Results and errors" (:p "Real in 0..1.")) ("Example" (:code-block "lisp" "(lut:range-fraction (lut:make-widget 'lut:slider :maximum 0.5 :value 0.25))"))))
(:entry "symbol/read-only-p" :names ("READ-ONLY-P") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: DOCUMENT-VIEW: Document views always reject interactive edits; programmatic TEXT refresh is permitted. (valid values boolean); ENTRY: Prevent editing in this view while permitting selection and copying. (valid values boolean); TEXT-BUFFER: Disable editing APIs; programmatic SETF TEXT remains available for application refresh. (valid values boolean)." :sections (("Signature" (:code-block "lisp" "(read-only-p lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: DOCUMENT-VIEW: Document views always reject interactive edits; programmatic TEXT refresh is permitted. (valid values boolean); ENTRY: Prevent editing in this view while permitting selection and copying. (valid values boolean); TEXT-BUFFER: Disable editing APIs; programmatic SETF TEXT remains available for application refresh. (valid values boolean).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:document-view))) (lut:read-only-p w))"))))
(:entry "symbol/redo" :names ("REDO") :kind :function :kind-name "Function" :package "LUT" :summary "Redo an entry or text buffer. Return true when changed." :sections (("Signature" (:code-block "lisp" "(redo entry)")) ("Arguments and valid values" (:p "TARGET is an entry/text-view or text-buffer. Reapplies history unless read-only; shared changes notify all views. A new content edit clears redo history.")) ("Results and errors" (:p "True when changed, NIL when empty.")) ("Example" (:code-block "lisp" "(let ((e (lut:make-widget 'lut:entry))) (lut:replace-selection e \"edit\") (lut:undo e) (lut:redo e))"))))
(:entry "symbol/refresh-command-menu" :names ("REFRESH-COMMAND-MENU") :kind :function :kind-name "Function" :package "LUT" :summary "Refresh live labels, enabled states and shortcuts. Auto native installation waits until an eligible native context exists." :sections (("Signature" (:code-block "lisp" "(refresh-command-menu menu)")) ("Arguments and valid values" (:p "MENU is live. Re-evaluate labels, enabled state, predicate and shortcut data. Auto installation waits for a native context. Group definitions remain fixed.")) ("Results and errors" (:p "MENU.")) ("Example" (:code-block "lisp" "(lut:refresh-command-menu menu)"))))
(:entry "symbol/refresh-commands" :names ("REFRESH-COMMANDS") :kind :function :kind-name "Function" :package "LUT" :summary "Refresh the captions and enabled states of WINDOW's command-bound controls." :sections (("Signature" (:code-block "lisp" "(refresh-commands window)")) ("Arguments and valid values" (:p "WINDOW is a root. Re-evaluates context/predicates for its command-bound controls and synchronizes captions/enabled state. Runs automatically before ordinary input and rendering; call explicitly after external model changes when querying control state immediately.")) ("Results and errors" (:p "WINDOW.")) ("Example" (:code-block "lisp" "(lut:refresh-commands (lut:make-widget 'lut:window))"))))
(:entry "symbol/refresh-items" :names ("REFRESH-ITEMS") :kind :function :kind-name "Function" :package "LUT" :summary "Synchronize tree/table display rows from their models; return W." :sections (("Signature" (:code-block "lisp" "(refresh-items w)")) ("Arguments and valid values" (:p "WIDGET is a tree/table or another widget. Rebuilds display items for tree/table models; other widgets are unchanged.")) ("Results and errors" (:p "WIDGET.")) ("Example" (:code-block "lisp" "(lut:refresh-items (lut:make-widget 'lut:table-view :columns '(\"Name\") :rows '((\"Ada\"))))"))))
(:entry "symbol/remote-alive-p" :names ("REMOTE-ALIVE-P") :kind :function :kind-name "Function" :package "LUT" :summary "Whether the remote native window's worker is still alive." :sections (("Signature" (:code-block "lisp" "(remote-alive-p remote)")) ("Arguments and valid values" (:p "REMOTE is a remote-window handle returned by SPAWN-WINDOW/DETACH-WINDOW. Reader thread updates liveness after EOF/closed.")) ("Results and errors" (:p "Boolean.")) ("Example" (:code-block "lisp" "(lut:remote-alive-p remote)"))))
(:entry "symbol/remove-child" :names ("REMOVE-CHILD") :kind :function :kind-name "Function" :package "LUT" :summary "Detach CHILD for reuse, clearing focus/capture. With :DISPOSE T, destroy its subtree too." :sections (("Signature" (:code-block "lisp" "(remove-child container child &key dispose)")) ("Arguments and valid values" (:p "CONTAINER and CHILD are widgets. No-op if not owned by CONTAINER. Clears focus, capture and drag references. :DISPOSE T destroys the subtree; default NIL keeps it reusable.")) ("Results and errors" (:p "CHILD.")) ("Example" (:code-block "lisp" "(let* ((box (lut:make-widget 'lut:box)) (child (lut:add-child box (lut:make-widget 'lut:label)))) (lut:remove-child box child))"))))
(:entry "symbol/render" :names ("RENDER") :kind :function :kind-name "Function" :package "LUT" :summary "Draw WIDGET using the loaded backend." :sections (("Signature" (:code-block "lisp" "(render widget)")) ("Arguments and valid values" (:p "WIDGET is a visible node. Called inside a drawing frame with a live native context. Define per-class primary methods; the around method clips and renders active descendants.")) ("Results and errors" (:p "Unspecified.")) ("Example" (:code-block "lisp" "(defmethod lut:render ((w counter-label)) (call-next-method))"))))
(:entry "symbol/render-drag-feedback" :names ("RENDER-DRAG-FEEDBACK") :kind :function :kind-name "Function" :package "LUT" :summary "Draw the active drag preview after ordinary content. Override in rendering backends." :sections (("Signature" (:code-block "lisp" "(render-drag-feedback window)")) ("Arguments and valid values" (:p "WINDOW is a root. Backend hook called after all content. Raylib draws target outline, notebook insertion marker and pointer marker. Override for custom previews.")) ("Results and errors" (:p "Unspecified.")) ("Example" (:code-block "lisp" "(defmethod lut:render-drag-feedback ((window my-window)) (call-next-method))"))))
(:entry "symbol/reorderable-p" :names ("REORDERABLE-P") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: NOTEBOOK: Enable pointer tab reordering; disabled by default. (valid values boolean)." :sections (("Signature" (:code-block "lisp" "(reorderable-p lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: NOTEBOOK: Enable pointer tab reordering; disabled by default. (valid values boolean).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:notebook))) (lut:reorderable-p w))"))))
(:entry "symbol/replace-buffer-range" :names ("REPLACE-BUFFER-RANGE") :kind :function :kind-name "Function" :package "LUT" :summary "Replace character range [START,END), remap attached view positions, and notify. ORIGIN optionally places that view's caret at the inserted text's end. Return BUFFER-EDIT or NIL." :sections (("Signature" (:code-block "lisp" "(replace-buffer-range buffer start end string &key origin)")) ("Arguments and valid values" (:p "BUFFER is live. START/END are character indices with 0 <= START <= END <= text length; STRING replaces [START,END). Optional ORIGIN is a live attached view whose caret collapses after inserted text. Other view positions remap; notification callbacks must not reedit the same model synchronously. Read-only returns NIL without changing text/history.")) ("Results and errors" (:p "BUFFER-EDIT for an effective change, NIL for a no-op/read-only refusal. Errors propagate after committed edits remain synchronized.")) ("Example" (:code-block "lisp" "(let ((b (lut:make-text-buffer :text \"abc\"))) (lut:replace-buffer-range b 1 2 \"X\"))"))))
(:entry "symbol/replace-model-items" :names ("REPLACE-MODEL-ITEMS") :kind :function :kind-name "Function" :package "LUT" :summary "Validate and replace a vector model's sequence transactionally, then publish :MODEL-CHANGE." :sections (("Signature" (:code-block "lisp" "(replace-model-items model items)")) ("Arguments and valid values" (:p "MODEL is a live vector model. Validate replacement sequence before committing; preserve selection by stable key; emit :MODEL-CHANGE after commit. Reentrant mutation is rejected.")) ("Results and errors" (:p "MODEL; invalid keys leave previous data intact.")) ("Example" (:code-block "lisp" "(lut:replace-model-items (lut:make-vector-model '(a)) '(b c))"))))
(:entry "symbol/replace-selection" :names ("REPLACE-SELECTION") :kind :function :kind-name "Function" :package "LUT" :summary "Replace selected text when editable and notify listeners. Shared views edit their buffer once." :sections (("Signature" (:code-block "lisp" "(replace-selection entry string)")) ("Arguments and valid values" (:p "ENTRY is an entry/text-view. When editable, STRING replaces its selection. Shared views edit the model and notify all peers once; standalone views keep local history. Read-only leaves text/selection unchanged.")) ("Results and errors" (:p "Unspecified.")) ("Example" (:code-block "lisp" "(let ((e (lut:make-widget 'lut:entry))) (lut:replace-selection e \"Hello\"))"))))
(:entry "symbol/replace-tree-roots" :names ("REPLACE-TREE-ROOTS") :kind :function :kind-name "Function" :package "LUT" :summary "Rebuild a tree from application data; validate all unique keys before commit. Retain expansion for surviving keys." :sections (("Signature" (:code-block "lisp" "(replace-tree-roots model roots)")) ("Arguments and valid values" (:p "MODEL is a tree. ROOTS is a replacement finite sequence, validated transactionally. Surviving expansion and selection keys remain.")) ("Results and errors" (:p "MODEL; emits :MODEL-CHANGE.")) ("Example" (:code-block "lisp" "(lut:replace-tree-roots (lut:make-tree-model '(a) :children (constantly nil)) '(b))"))))
(:entry "symbol/request-path" :names ("REQUEST-PATH") :kind :function :kind-name "Function" :package "LUT" :summary "Request :FILE/:FOLDER/:SAVE. Callback receives one pathname or NIL. Native dialogs are synchronous; fallback dialogs complete later. No file creation or overwrite policy." :sections (("Signature" (:code-block "lisp" "(request-path window callback &key (kind :file) (directory (user-homedir-pathname)) filename (title \"Choose a path\") (native :auto))")) ("Arguments and valid values" (:p "WINDOW live, CALLBACK(path-or-NIL), KIND :FILE/:FOLDER/:SAVE, existing DIRECTORY, optional FILENAME and TITLE. NATIVE :AUTO/T/NIL matches command menus. Primary macOS panels are synchronous; portable dialogs complete later. FILE/FOLDER require existing paths; SAVE returns a filename in an existing directory. No file creation, write or persistence policy.")) ("Results and errors" (:p "PATH-REQUEST; callback may run before return for native panels. Invalid portable input shows in-dialog feedback and remains pending; application callback errors propagate after committed completion.")) ("Example" (:code-block "lisp" "(lut:request-path window #'print :kind :save :filename \"untitled.txt\")"))))
(:entry "symbol/reveal-model-index" :names ("REVEAL-MODEL-INDEX") :kind :function :kind-name "Function" :package "LUT" :summary "Scroll the visible INDEX into view without changing selection." :sections (("Signature" (:code-block "lisp" "(reveal-model-index view index)")) ("Arguments and valid values" (:p "VIEW is model-backed. INDEX is valid and visible in its model. Scrolls without selecting.")) ("Results and errors" (:p "VIEW.")) ("Example" (:code-block "lisp" "(lut:reveal-model-index (lut:make-widget 'lut:model-list-view :model (lut:make-vector-model '(a))) 0)"))))
(:entry "symbol/reveal-page" :names ("REVEAL-PAGE") :kind :function :kind-name "Function" :package "LUT" :summary "Reveal notebook page INDEX without selecting it; return the new tab offset." :sections (("Signature" (:code-block "lisp" "(reveal-page book &optional (index (value book)))")) ("Arguments and valid values" (:p "BOOK is a notebook; optional INDEX defaults to VALUE and must identify a page. Scrolls the tab into view without changing selection.")) ("Results and errors" (:p "New tab offset.")) ("Example" (:code-block "lisp" "(let ((b (lut:with-ui (lut:notebook :items '(\"One\")) (lut:make-widget 'lut:label)))) (lut:reveal-page b 0))"))))
(:entry "symbol/reveal-text-cursor" :names ("REVEAL-TEXT-CURSOR") :kind :function :kind-name "Function" :package "LUT" :summary "Reveal VIEW's caret using shared geometry and its own offsets. VERTICAL NIL preserves vertical scroll. Return VIEW; selection is unchanged." :sections (("Signature" (:code-block "lisp" "(reveal-text-cursor view &key (vertical t))")) ("Arguments and valid values" (:p "VIEW is a live entry/text view. Adjusts its own horizontal/vertical offsets to include the caret rectangle. VERTICAL defaults T; NIL preserves vertical scroll. Selection and content are unchanged. Uses unwrapped display geometry, padding, caret width and allocation.")) ("Results and errors" (:p "VIEW.")) ("Example" (:code-block "lisp" "(lut:reveal-text-cursor (lut:make-widget 'lut:text-view :text \"alpha\" :cursor 5))"))))
(:entry "symbol/row-height" :names ("ROW-HEIGHT") :kind :function :kind-name "Function" :package "LUT" :summary "Styled list/table row height in pixels." :sections (("Signature" (:code-block "lisp" "(row-height w)")) ("Arguments and valid values" (:p "WIDGET has styles; :ROW-HEIGHT must be a positive real pixel extent.")) ("Results and errors" (:p "Positive real.")) ("Example" (:code-block "lisp" "(lut:row-height (lut:make-widget 'lut:list-view))"))))
(:entry "symbol/row-label-function" :names ("ROW-LABEL-FUNCTION") :kind :function :kind-name "Function" :package "LUT" :summary "VIEW is model-backed. Function designator maps an application item to its display string on demand. May be assigned with SETF." :sections (("Signature" (:code-block "lisp" "(row-label-function lut-docs::object)")) ("Arguments and valid values" (:p "VIEW is model-backed. Function designator maps an application item to its display string on demand. May be assigned with SETF.")) ("Results and errors" (:p "Function designator.")) ("Example" (:code-block "lisp" "(lut:row-label-function (lut:make-widget 'lut:model-list-view :model (lut:make-vector-model '(a))))"))))
(:entry "symbol/rows" :names ("ROWS") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: TABLE-VIEW: Rows, each a list of printable cell values. (valid values list)." :sections (("Signature" (:code-block "lisp" "(rows lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: TABLE-VIEW: Rows, each a list of printable cell values. (valid values list).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:table-view))) (lut:rows w))"))))
(:entry "symbol/run" :names ("RUN") :kind :function :kind-name "Function" :package "LUT" :summary "Open WINDOW and run its event loop; FRAMES bounds smoke runs." :sections (("Signature" (:code-block "lisp" "(run window &key frames)")) ("Arguments and valid values" (:p "WINDOW is a root window; FRAMES is NIL for interactive or a positive integer for a bounded run. Requires backend; CCL/macOS bridges to OS main thread. Errors pause interactive runs; bounded runs signal. A nested run spawns a worker.")) ("Results and errors" (:p "Normal loop result, or remote-window for a secondary window.")) ("Example" (:code-block "lisp" "(lut:run (lut:make-widget 'lut:window :width 640 :height 480) :frames 3)"))))
(:entry "symbol/scroll-offset" :names ("SCROLL-OFFSET") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: SUGGESTION-SURFACE: Candidate viewport offset in pixels. (valid values (real 0 *)); SCROLL-VIEW: Vertical scroll in pixels. (valid values (real 0 *)); LIST-VIEW: Vertical scroll in pixels. (valid values (real 0 *))." :sections (("Signature" (:code-block "lisp" "(scroll-offset lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: SUGGESTION-SURFACE: Candidate viewport offset in pixels. (valid values (real 0 *)); SCROLL-VIEW: Vertical scroll in pixels. (valid values (real 0 *)); LIST-VIEW: Vertical scroll in pixels. (valid values (real 0 *)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:suggestion-surface))) (lut:scroll-offset w))"))))
(:entry "symbol/scroll-tabs" :names ("SCROLL-TABS") :kind :function :kind-name "Function" :package "LUT" :summary "Scroll NOTEBOOK's header by DELTA pixels and return its clamped offset, without changing selection." :sections (("Signature" (:code-block "lisp" "(scroll-tabs book delta)")) ("Arguments and valid values" (:p "BOOK is a notebook; DELTA is a real pixel distance. Positive scrolls right; selection is unchanged. Offset clamps to the current overflow range.")) ("Results and errors" (:p "New tab offset.")) ("Example" (:code-block "lisp" "(lut:scroll-tabs (lut:make-widget 'lut:notebook) 96)"))))
(:entry "symbol/select-all" :names ("SELECT-ALL") :kind :function :kind-name "Function" :package "LUT" :summary "Select all text." :sections (("Signature" (:code-block "lisp" "(select-all entry)")) ("Arguments and valid values" (:p "ENTRY is an entry/text-view; selects 0 through text length.")) ("Results and errors" (:p "ENTRY.")) ("Example" (:code-block "lisp" "(lut:select-all (lut:make-widget 'lut:entry :text \"Hello\"))"))))
(:entry "symbol/select-line" :names ("SELECT-LINE") :kind :function :kind-name "Function" :package "LUT" :summary "Select the logical display line at POSITION, including its terminating newline. Return VIEW." :sections (("Signature" (:code-block "lisp" "(select-line view &optional (position (cursor view)))")) ("Arguments and valid values" (:p "VIEW is a live entry/text view. Optional POSITION defaults to cursor and must index DISPLAY-TEXT. Selects the logical line including its terminating newline; final empty lines select an empty range. Reveals the caret; read-only views permit selection.")) ("Results and errors" (:p "VIEW.")) ("Example" (:code-block "lisp" "(lut:select-line (lut:make-widget 'lut:text-view :text \"alpha\") 2)"))))
(:entry "symbol/select-model-index" :names ("SELECT-MODEL-INDEX") :kind :function :kind-name "Function" :package "LUT" :summary "Select visible INDEX; EXTEND forms an anchored range, TOGGLE adds/removes, both add the range." :sections (("Signature" (:code-block "lisp" "(select-model-index selection index &key extend toggle)")) ("Arguments and valid values" (:p "SELECTION is live, INDEX visible. EXTEND selects anchored range; TOGGLE adds/removes a row; both add the range. Only :MULTIPLE honors these flags. Range materialization O(range).")) ("Results and errors" (:p "SELECTION; emits :SELECTION-CHANGE for changed keys/focus/anchor.")) ("Example" (:code-block "lisp" "(lut:select-model-index (lut:make-selection-model (lut:make-vector-model '(a b))) 1)"))))
(:entry "symbol/select-page" :names ("SELECT-PAGE") :kind :function :kind-name "Function" :package "LUT" :summary "Select a valid child INDEX and emit :CHANGE with that index." :sections (("Signature" (:code-block "lisp" "(select-page stack index)")) ("Arguments and valid values" (:p "STACK is a stack/notebook; INDEX an integer in 0 through child-count minus one. Emits :CHANGE with INDEX; invalid indices signal ERROR.")) ("Results and errors" (:p "Selected index.")) ("Example" (:code-block "lisp" "(let ((s (lut:with-ui (lut:stack) (lut:make-widget 'lut:label)))) (lut:select-page s 0))"))))
(:entry "symbol/select-word" :names ("SELECT-WORD") :kind :function :kind-name "Function" :package "LUT" :summary "Select the display run at POSITION, preserving read-only policy. Return VIEW." :sections (("Signature" (:code-block "lisp" "(select-word view &optional (position (cursor view)))")) ("Arguments and valid values" (:p "VIEW is a live entry/text view. Optional POSITION defaults to its cursor and must index DISPLAY-TEXT. Selects the containing character run with anchor at start and caret at end, then reveals the caret. Read-only views permit selection; display overrides should preserve indices.")) ("Results and errors" (:p "VIEW.")) ("Example" (:code-block "lisp" "(lut:select-word (lut:make-widget 'lut:text-view :text \"alpha beta\") 2)"))))
(:entry "symbol/selected-keys" :names ("SELECTED-KEYS") :kind :function :kind-name "Function" :package "LUT" :summary "Copy the selection's stable keys, including temporarily hidden keys." :sections (("Signature" (:code-block "lisp" "(selected-keys selection)")) ("Arguments and valid values" (:p "SELECTION is a selection model. Returned list is copied; immutable application key objects retain identity.")) ("Results and errors" (:p "Fresh list of selected visible/hidden keys.")) ("Example" (:code-block "lisp" "(lut:selected-keys (lut:make-selection-model (lut:make-vector-model '(a))))"))))
(:entry "symbol/selected-text" :names ("SELECTED-TEXT") :kind :function :kind-name "Function" :package "LUT" :summary "Return the selected substring." :sections (("Signature" (:code-block "lisp" "(selected-text entry)")) ("Arguments and valid values" (:p "ENTRY is an entry/text-view; an empty selection returns an empty string.")) ("Results and errors" (:p "Selected substring.")) ("Example" (:code-block "lisp" "(let ((e (lut:make-widget 'lut:entry :text \"abc\"))) (lut:select-all e) (lut:selected-text e))"))))
(:entry "symbol/selection" :names ("SELECTION") :kind :function :kind-name "Function" :package "LUT" :summary "Return sorted start and end selection indices as two values." :sections (("Signature" (:code-block "lisp" "(selection entry)")) ("Arguments and valid values" (:p "ENTRY is an entry or text-view. Indices are zero-based character boundaries, not UTF-8 bytes.")) ("Results and errors" (:p "Two values: sorted start and end indices.")) ("Example" (:code-block "lisp" "(let ((e (lut:make-widget 'lut:entry :text \"abc\"))) (lut:select-all e) (lut:selection e))"))))
(:entry "symbol/selection-anchor" :names ("SELECTION-ANCHOR") :kind :function :kind-name "Function" :package "LUT" :summary "SELECTION is a selection model. Range anchor retains identity through reordering." :sections (("Signature" (:code-block "lisp" "(selection-anchor lut-docs::object)")) ("Arguments and valid values" (:p "SELECTION is a selection model. Range anchor retains identity through reordering.")) ("Results and errors" (:p "Stable key or NIL.")) ("Example" (:code-block "lisp" "(lut:selection-anchor (lut:make-selection-model (lut:make-vector-model '(a))))"))))
(:entry "symbol/selection-contains-p" :names ("SELECTION-CONTAINS-P") :kind :function :kind-name "Function" :package "LUT" :summary "SELECTION is a selection model; KEY compared under EQUAL." :sections (("Signature" (:code-block "lisp" "(selection-contains-p selection key)")) ("Arguments and valid values" (:p "SELECTION is a selection model; KEY compared under EQUAL.")) ("Results and errors" (:p "Boolean.")) ("Example" (:code-block "lisp" "(lut:selection-contains-p (lut:make-selection-model (lut:make-vector-model '(a))) 'a)"))))
(:entry "symbol/selection-focus" :names ("SELECTION-FOCUS") :kind :function :kind-name "Function" :package "LUT" :summary "SELECTION is a selection model. Focus may be temporarily hidden by filtering/collapse." :sections (("Signature" (:code-block "lisp" "(selection-focus lut-docs::object)")) ("Arguments and valid values" (:p "SELECTION is a selection model. Focus may be temporarily hidden by filtering/collapse.")) ("Results and errors" (:p "Stable focused key or NIL.")) ("Example" (:code-block "lisp" "(lut:selection-focus (lut:make-selection-model (lut:make-vector-model '(a))))"))))
(:entry "symbol/set-model-query" :names ("SET-MODEL-QUERY") :kind :function :kind-name "Function" :package "LUT" :summary "Set item predicate and stable ordering comparator. NIL disables either. Builds before committing; O(source rows)." :sections (("Signature" (:code-block "lisp" "(set-model-query model &key (predicate (projection-predicate model)) (lessp (projection-lessp model)))")) ("Arguments and valid values" (:p "MODEL is a projection. Omitted callbacks remain; NIL disables filtering/sorting. Explicit query errors leave previous snapshot intact. A failed automatic source refresh disposes the projection to prevent stale index use.")) ("Results and errors" (:p "MODEL; publishes :MODEL-CHANGE.")) ("Example" (:code-block "lisp" "(lut:set-model-query (lut:make-projection-model (lut:make-vector-model '(1 2))) :predicate #'oddp)"))))
(:entry "symbol/set-text-presentation" :names ("SET-TEXT-PRESENTATION") :kind :function :kind-name "Function" :package "LUT" :summary "Transactionally replace supplied presentation collections; omitted collections remain. Records are copied. Return VIEW." :sections (("Signature" (:code-block "lisp" "(set-text-presentation view &key (runs nil runs-p) (decorations nil decorations-p) (links nil links-p) (images nil images-p))")) ("Arguments and valid values" (:p "VIEW is a live styled/document view. Supplied RUNS/DECORATIONS/LINKS/IMAGES replace those collections; omitted collections remain. Records are copied and validated transactionally. Runs/links are disjoint half-open character intervals; decorations may overlap and use :UNDERLINE/:BACKGROUND/:GUTTER/:ANNOTATION. Images/links require DOCUMENT-VIEW. Images occupy U+FFFC at :POSITION with :SOURCE and positive :WIDTH/:HEIGHT (height <= line-height). See docs/text-presentation.md for schemas and edit remapping.")) ("Results and errors" (:p "VIEW; emits :PRESENTATION-CHANGE after commit.")) ("Example" (:code-block "lisp" "(lut:set-text-presentation (lut:make-widget 'lut:styled-text-view :text \"abc\") :runs '((:start 0 :end 3 :style (:foreground :red))))"))))
(:entry "symbol/set-tree-expanded" :names ("SET-TREE-EXPANDED") :kind :function :kind-name "Function" :package "LUT" :summary "Set KEY's expansion, rebuild visible rows and notify. Hidden descendant selections remain valid." :sections (("Signature" (:code-block "lisp" "(set-tree-expanded model key expanded)")) ("Arguments and valid values" (:p "MODEL is a live tree. KEY exists in the whole tree; EXPANDED is interpreted as boolean. Rebuilds visible row metadata; collapsed selections remain valid.")) ("Results and errors" (:p "MODEL; emits :MODEL-CHANGE.")) ("Example" (:code-block "lisp" "(lut:set-tree-expanded (lut:make-tree-model '(a) :children (constantly nil)) 'a t)"))))
(:entry "symbol/show-anchored-surface" :names ("SHOW-ANCHORED-SURFACE") :kind :function :kind-name "Function" :package "LUT" :summary "Show nonmodal SURFACE at OWNER's caret or RECTANGLE (root X Y W H), preserving owner focus. Return SURFACE." :sections (("Signature" (:code-block "lisp" "(show-anchored-surface owner surface &key rectangle)")) ("Arguments and valid values" (:p "OWNER is live in the active input scope; SURFACE is an unparented anchored/suggestion surface. RECTANGLE is optional root (X Y W H); otherwise entries follow their caret, other owners their bounds. Clamps/flips in the current window, keeps owner focus and follows geometry each frame. Application candidates/help content remain external data.")) ("Results and errors" (:p "SURFACE. A shown surface may be reanchored; dismissal happens first.")) ("Example" (:code-block "lisp" "(let* ((w (lut:make-widget 'lut:window)) (e (lut:add-child w (lut:make-widget 'lut:entry)))) (lut:show-anchored-surface e (lut:make-widget 'lut:suggestion-surface :items '(\"One\" \"Two\"))))"))))
(:entry "symbol/show-dialog" :names ("SHOW-DIALOG") :kind :function :kind-name "Function" :package "LUT" :summary "Show DIALOG and return it. Native backends use separate windows; the core uses overlays." :sections (("Signature" (:code-block "lisp" "(show-dialog window dialog)")) ("Arguments and valid values" (:p "WINDOW owns DIALOG, which must currently have no parent. Pushes modal overlay and clears focus/capture. Drag empty surface/title to move; crossing root bounds detaches when enabled.")) ("Results and errors" (:p "DIALOG.")) ("Example" (:code-block "lisp" "(lut:show-dialog (lut:make-widget 'lut:window) (lut:make-widget 'lut:dialog :width 300 :height 180))"))))
(:entry "symbol/sort-table" :names ("SORT-TABLE") :kind :function :kind-name "Function" :package "LUT" :summary "Stable-sort TABLE rows by the printed cell in zero-based COLUMN; emit :CHANGE with current selection." :sections (("Signature" (:code-block "lisp" "(sort-table table column &key descending)")) ("Arguments and valid values" (:p "TABLE is a table-view; COLUMN is a valid zero-based column index. DESCENDING boolean defaults NIL. Compares printed cells lexically, retaining equal-key order.")) ("Results and errors" (:p "TABLE.")) ("Example" (:code-block "lisp" "(lut:sort-table (lut:make-widget 'lut:table-view :columns '(\"Name\") :rows '((\"Z\") (\"A\"))) 0)"))))
(:entry "symbol/source" :names ("SOURCE") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: IMAGE: Image file pathname; NIL draws nothing. (valid values (or null string pathname))." :sections (("Signature" (:code-block "lisp" "(source lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: IMAGE: Image file pathname; NIL draws nothing. (valid values (or null string pathname)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:image))) (lut:source w))"))))
(:entry "symbol/spacing" :names ("SPACING") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: GRID: Gap between rows and columns. (valid values (real 0 *)); BOX: Space between children. (valid values (real 0 *))." :sections (("Signature" (:code-block "lisp" "(spacing lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: GRID: Gap between rows and columns. (valid values (real 0 *)); BOX: Space between children. (valid values (real 0 *)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:grid))) (lut:spacing w))"))))
(:entry "symbol/spawn-window" :names ("SPAWN-WINDOW") :kind :function :kind-name "Function" :package "LUT" :summary "Open WINDOW in a native worker process. Its objects and event callbacks stay in this REPL.
Parent GUI frames service IPC. POSITION is an optional (screen-x screen-y) list." :sections (("Signature" (:code-block "lisp" "(spawn-window window &key position (style-source *active-window*) (flags '(:window-resizable)))")) ("Arguments and valid values" (:p "WINDOW is a root window. POSITION optionally is (screen-x screen-y), real coordinates. STYLE-SOURCE defaults to the currently active root and propagates app styles; an explicitly supplied theme remains an override. Uses *WORKER-COMMAND*, the local ASDF checkout and Quicklisp setup if present. Primary loop services IPC. Keep returned handle.")) ("Results and errors" (:p "REMOTE-WINDOW.")) ("Example" (:code-block "lisp" "(lut:on-ui (lut:spawn-window (lut:make-widget 'lut:window :text \"Second\" :width 400 :height 300)))"))))
(:entry "symbol/start" :names ("START") :kind :function :kind-name "Function" :package "LUT" :summary "Launch on the OS main thread; subsequent starts create native workers inheriting the prior root's app styles." :sections (("Signature" (:code-block "lisp" "(start window &key frames wait)")) ("Arguments and valid values" (:p "WINDOW is root; FRAMES optional positive frame count; WAIT boolean controls binding runner wait. First launch uses the OS main-thread runner; subsequent launches spawn native workers.")) ("Results and errors" (:p "Runner result or remote-window.")) ("Example" (:code-block "lisp" "(lut:start (lut:make-widget 'lut:window :text \"Live\" :width 640 :height 480))"))))
(:entry "symbol/state-style" :names ("STATE-STYLE") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. (valid values list)." :sections (("Signature" (:code-block "lisp" "(state-style lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: State overrides: plist mapping :HOVER/:PRESSED/:DISABLED/:FOCUS to token plists. (valid values list).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:widget))) (lut:state-style w))"))))
(:entry "symbol/step" :names ("STEP") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: SLIDER: Increment for wheel and keyboard. (valid values (real (0) *))." :sections (("Signature" (:code-block "lisp" "(step lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: SLIDER: Increment for wheel and keyboard. (valid values (real (0) *)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:slider))) (lut:step w))"))))
(:entry "symbol/stop" :names ("STOP") :kind :function :kind-name "Function" :package "LUT" :summary "Request stop after current frame." :sections (("Signature" (:code-block "lisp" "(stop )")) ("Arguments and valid values" (:p "No arguments. Requests the primary event loop stop after the current frame. Loop teardown requests closure of all worker windows, releases library-owned roots and clears pending work; application-owned primary trees remain reusable.")) ("Results and errors" (:p "No meaningful value.")) ("Example" (:code-block "lisp" "(lut:stop)"))))
(:entry "symbol/style" :names ("STYLE") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: Property list overriding inherited theme tokens. (valid values list)." :sections (("Signature" (:code-block "lisp" "(style lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: Property list overriding inherited theme tokens. (valid values list).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:widget))) (lut:style w))"))))
(:entry "symbol/style-rules" :names ("STYLE-RULES") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WINDOW: Ordered rules: (:CLASS class :STATE state-or-NIL :STYLE token-plist). Later rules win. (valid values list)." :sections (("Signature" (:code-block "lisp" "(style-rules lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WINDOW: Ordered rules: (:CLASS class :STATE state-or-NIL :STYLE token-plist). Later rules win. (valid values list).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:window))) (lut:style-rules w))"))))
(:entry "symbol/style-source" :names ("STYLE-SOURCE") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WINDOW: Optional application window whose styles, selectors and theme are inherited across native windows. (valid values (or null window))." :sections (("Signature" (:code-block "lisp" "(style-source lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WINDOW: Optional application window whose styles, selectors and theme are inherited across native windows. (valid values (or null window)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:window))) (lut:style-source w))"))))
(:entry "symbol/style-value" :names ("STYLE-VALUE") :kind :function :kind-name "Function" :package "LUT" :summary "Resolve local state/base, inherited overrides, class/state rules, root/application themes, then defaults.
STYLE-SOURCE propagates application styling across native windows. Later matching rules win within a root." :sections (("Signature" (:code-block "lisp" "(style-value w key &optional default)")) ("Arguments and valid values" (:p "WIDGET is a widget; KEY a style token keyword; DEFAULT used only when no style/theme/default token exists. Local state/base styles precede ancestor overrides, root class/state rules, root theme and defaults.")) ("Results and errors" (:p "Resolved token, including explicit NIL.")) ("Example" (:code-block "lisp" "(lut:style-value (lut:make-widget 'lut:entry :style '(:font-size 24)) :font-size)"))))
(:entry "symbol/tab-at-position" :names ("TAB-AT-POSITION") :kind :function :kind-name "Function" :package "LUT" :summary "Return the visible tab index at root coordinates X/Y, or NIL for arrows, body or empty space." :sections (("Signature" (:code-block "lisp" "(tab-at-position book x y)")) ("Arguments and valid values" (:p "BOOK is a notebook. X/Y are root coordinates. Navigation buttons, body and empty space return NIL; hidden tabs are not hit.")) ("Results and errors" (:p "Visible zero-based page index or NIL.")) ("Example" (:code-block "lisp" "(lut:tab-at-position (lut:make-widget 'lut:notebook) 10 10)"))))
(:entry "symbol/tab-group" :names ("TAB-GROUP") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: NOTEBOOK: Equal non-NIL groups permit transfers between reorderable notebooks in one window. (valid values (or null symbol string))." :sections (("Signature" (:code-block "lisp" "(tab-group lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: NOTEBOOK: Equal non-NIL groups permit transfers between reorderable notebooks in one window. (valid values (or null symbol string)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:notebook))) (lut:tab-group w))"))))
(:entry "symbol/tab-offset" :names ("TAB-OFFSET") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: NOTEBOOK: Horizontal tab-strip scroll offset in pixels; clamped during layout. (valid values (real 0 *))." :sections (("Signature" (:code-block "lisp" "(tab-offset lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: NOTEBOOK: Horizontal tab-strip scroll offset in pixels; clamped during layout. (valid values (real 0 *)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:notebook))) (lut:tab-offset w))"))))
(:entry "symbol/table-columns" :names ("TABLE-COLUMNS") :kind :function :kind-name "Function" :package "LUT" :summary "VIEW is a model table, constructed with a nonempty :TABLE-COLUMNS list. Treat list/column definitions as immutable." :sections (("Signature" (:code-block "lisp" "(table-columns lut-docs::object)")) ("Arguments and valid values" (:p "VIEW is a model table, constructed with a nonempty :TABLE-COLUMNS list. Treat list/column definitions as immutable.")) ("Results and errors" (:p "Column definitions.")) ("Example" (:code-block "lisp" "(lut:table-columns table)"))))
(:entry "symbol/text" :names ("TEXT") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: EXPANDER: Header caption. (valid values string); DIALOG: Dialog title. (valid values string); TEXT-BUFFER: Shared contents; use range edits or SETF TEXT rather than mutating the returned string. (valid values string); LABEL: Displayed text. (valid values string); WINDOW: Native title. (valid values string)." :sections (("Signature" (:code-block "lisp" "(text lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: EXPANDER: Header caption. (valid values string); DIALOG: Dialog title. (valid values string); TEXT-BUFFER: Shared contents; use range edits or SETF TEXT rather than mutating the returned string. (valid values string); LABEL: Displayed text. (valid values string); WINDOW: Native title. (valid values string).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:expander))) (lut:text w))"))))
(:entry "symbol/text-decorations" :names ("TEXT-DECORATIONS") :kind :function :kind-name "Function" :package "LUT" :summary "Return copied decoration records." :sections (("Signature" (:code-block "lisp" "(text-decorations view)")) ("Arguments and valid values" (:p "VIEW is a styled/document view. Returns copied (:START :END :KIND :COLOR :TEXT) records; intervals may overlap, and points may be empty. Opaque application values retain identity.")) ("Results and errors" (:p "Fresh list of decoration plists.")) ("Example" (:code-block "lisp" "(lut:text-decorations (lut:make-widget 'lut:styled-text-view))"))))
(:entry "symbol/text-length" :names ("TEXT-LENGTH") :kind :function :kind-name "Function" :package "LUT" :summary "Character count of a string, label/view or buffer, without flattening shared storage." :sections (("Signature" (:code-block "lisp" "(text-length target)")) ("Arguments and valid values" (:p "TARGET is a string, label/view or text buffer. Counts Common Lisp characters; shared buffers do not flatten.")) ("Results and errors" (:p "Nonnegative character count.")) ("Example" (:code-block "lisp" "(lut:text-length (lut:make-text-buffer :text \"abc\"))"))))
(:entry "symbol/text-line-count" :names ("TEXT-LINE-COUNT") :kind :function :kind-name "Function" :package "LUT" :summary "Logical line count, including the empty final line after a newline; empty text has one line." :sections (("Signature" (:code-block "lisp" "(text-line-count target)")) ("Arguments and valid values" (:p "TARGET is a string, label/view or text buffer. Newline delimits logical lines. Empty text has one line; trailing newline adds an empty line.")) ("Results and errors" (:p "Positive integer.")) ("Example" (:code-block "lisp" "(lut:text-line-count (lut:make-text-buffer))"))))
(:entry "symbol/text-line-range" :names ("TEXT-LINE-RANGE") :kind :function :kind-name "Function" :package "LUT" :summary "Return START and END excluding newline for zero-based logical LINE; reject invalid lines." :sections (("Signature" (:code-block "lisp" "(text-line-range target line)")) ("Arguments and valid values" (:p "TARGET is a string, label/view or text buffer; LINE is a valid zero-based logical line. Excludes the newline. Invalid indices signal ERROR.")) ("Results and errors" (:p "Two character indices: START and exclusive END.")) ("Example" (:code-block "lisp" "(lut:text-line-range (lut:make-text-buffer :text \"abc\") 0)"))))
(:entry "symbol/text-offset" :names ("TEXT-OFFSET") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: ENTRY: Horizontal text viewport offset in pixels. (valid values (real 0 *))." :sections (("Signature" (:code-block "lisp" "(text-offset lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: ENTRY: Horizontal text viewport offset in pixels. (valid values (real 0 *)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:entry))) (lut:text-offset w))"))))
(:entry "symbol/text-point-position" :names ("TEXT-POINT-POSITION") :kind :function :kind-name "Function" :package "LUT" :summary "Return nearest display character insertion position at root coordinates PX/PY; clamp outside text." :sections (("Signature" (:code-block "lisp" "(text-point-position view px py)")) ("Arguments and valid values" (:p "VIEW is an entry/text view. PX/PY are root pixel coordinates. Returns nearest insertion position using character midpoints; clamps to first/last logical line and line bounds. DISPLAY-TEXT overrides should preserve character indexing.")) ("Results and errors" (:p "Display character index.")) ("Example" (:code-block "lisp" "(lut:text-point-position (lut:make-widget 'lut:text-view :text \"abc\") 8 8)"))))
(:entry "symbol/text-position-line" :names ("TEXT-POSITION-LINE") :kind :function :kind-name "Function" :package "LUT" :summary "Return the zero-based logical line containing character POSITION, including EOF." :sections (("Signature" (:code-block "lisp" "(text-position-line target position)")) ("Arguments and valid values" (:p "TARGET is a string, label/view or text buffer; POSITION is a character insertion index including EOF. A newline position belongs to its preceding line.")) ("Results and errors" (:p "Zero-based logical line.")) ("Example" (:code-block "lisp" "(lut:text-position-line (lut:make-text-buffer :text \"abc\") 3)"))))
(:entry "symbol/text-position-rectangle" :names ("TEXT-POSITION-RECTANGLE") :kind :function :kind-name "Function" :package "LUT" :summary "Return caret X, Y, WIDTH, HEIGHT in root pixels for a display character position. No wrapping/shaping." :sections (("Signature" (:code-block "lisp" "(text-position-rectangle view position)")) ("Arguments and valid values" (:p "VIEW is an entry/text view. POSITION indexes DISPLAY-TEXT, including EOF. Geometry uses unwrapped character advances, effective styles, allocation and independent pixel scroll offsets. No shaping/bidi/grapheme support.")) ("Results and errors" (:p "Four values: root X, Y, styled caret width, line height.")) ("Example" (:code-block "lisp" "(lut:text-position-rectangle (lut:make-widget 'lut:text-view :text \"abc\") 1)"))))
(:entry "symbol/text-presentation-revision" :names ("TEXT-PRESENTATION-REVISION") :kind :function :kind-name "Function" :package "LUT" :summary "Return the presentation generation, independent of content revision." :sections (("Signature" (:code-block "lisp" "(text-presentation-revision view)")) ("Arguments and valid values" (:p "VIEW is a styled/document view. Presentation generation is independent of shared buffer/content revision. Explicit invalidation and automatic edit remapping advance it.")) ("Results and errors" (:p "Nonnegative integer.")) ("Example" (:code-block "lisp" "(lut:text-presentation-revision (lut:make-widget 'lut:styled-text-view))"))))
(:entry "symbol/text-range" :names ("TEXT-RANGE") :kind :function :kind-name "Function" :package "LUT" :summary "Copy the half-open character range [START,END); indexed queries never flatten the buffer." :sections (("Signature" (:code-block "lisp" "(text-range target start &optional (end (text-length target)))")) ("Arguments and valid values" (:p "TARGET is a string, label/view or text buffer. 0 <= START <= END <= length. END defaults to length. Copies only the requested range from indexed storage.")) ("Results and errors" (:p "Fresh string.")) ("Example" (:code-block "lisp" "(lut:text-range (lut:make-text-buffer :text \"abc\") 1 3)"))))
(:entry "symbol/text-runs" :names ("TEXT-RUNS") :kind :function :kind-name "Function" :package "LUT" :summary "Return copied style-run records; opaque application data retains identity." :sections (("Signature" (:code-block "lisp" "(text-runs view)")) ("Arguments and valid values" (:p "VIEW is a styled/document view. Returns copied records (:START :END :STYLE). Supported overrides: :FONT, :FONT-SIZE, :FOREGROUND, :BACKGROUND. Ranges are disjoint; use SET-TEXT-PRESENTATION to replace.")) ("Results and errors" (:p "Fresh list of run plists.")) ("Example" (:code-block "lisp" "(lut:text-runs (lut:make-widget 'lut:styled-text-view))"))))
(:entry "symbol/text-style-at" :names ("TEXT-STYLE-AT") :kind :function :kind-name "Function" :package "LUT" :summary "Return application run overrides at POSITION; document links default to the accent foreground." :sections (("Signature" (:code-block "lisp" "(text-style-at view position)")) ("Arguments and valid values" (:p "VIEW is styled; POSITION is a valid model/display character position including EOF. Returns run overrides and default accent foreground for a link. Display transforms must preserve indices. This does not infer syntax or code.")) ("Results and errors" (:p "Copied override plist.")) ("Example" (:code-block "lisp" "(lut:text-style-at (lut:make-widget 'lut:styled-text-view :text \"abc\") 0)"))))
(:entry "symbol/text-width" :names ("TEXT-WIDTH") :kind :function :kind-name "Function" :package "LUT" :summary "Measure a full string using the active font backend." :sections (("Signature" (:code-block "lisp" "(text-width widget string)")) ("Arguments and valid values" (:p "WIDGET selects the font backend; STRING is measured as a complete string. Core estimates; raylib label methods use MeasureTextEx and a loaded font in an active window.")) ("Results and errors" (:p "Non-negative pixel width.")) ("Example" (:code-block "lisp" "(lut:text-width (lut:make-widget 'lut:widget) \"Hello\")"))))
(:entry "symbol/text-word-range" :names ("TEXT-WORD-RANGE") :kind :function :kind-name "Function" :package "LUT" :summary "Return the character run containing POSITION (EOF uses the preceding character). Runs are word, whitespace or punctuation." :sections (("Signature" (:code-block "lisp" "(text-word-range target position)")) ("Arguments and valid values" (:p "TARGET is a string, label/view or buffer; POSITION is a valid character index including EOF. Returns the containing raw-text run: alphanumeric/underscore, space/tab/newline/return/page, or punctuation. EOF uses the preceding character; empty text gives 0/0. This is not Unicode word breaking or language syntax.")) ("Results and errors" (:p "Two indices: START and exclusive END.")) ("Example" (:code-block "lisp" "(lut:text-word-range (lut:make-text-buffer :text \"alpha_beta!\") 2)"))))
(:entry "symbol/theme" :names ("THEME") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WINDOW: Inherited theme property list. (valid values list)." :sections (("Signature" (:code-block "lisp" "(theme lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WINDOW: Inherited theme property list. (valid values list).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:window))) (lut:theme w))"))))
(:entry "symbol/tooltip-text" :names ("TOOLTIP-TEXT") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: Optional help shown while the pointer hovers over this widget. (valid values (or null string))." :sections (("Signature" (:code-block "lisp" "(tooltip-text lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: Optional help shown while the pointer hovers over this widget. (valid values (or null string)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:widget))) (lut:tooltip-text w))"))))
(:entry "symbol/tree-expanded-p" :names ("TREE-EXPANDED-P") :kind :function :kind-name "Function" :package "LUT" :summary "MODEL is a tree; KEY is an application identity." :sections (("Signature" (:code-block "lisp" "(tree-expanded-p model key)")) ("Arguments and valid values" (:p "MODEL is a tree; KEY is an application identity.")) ("Results and errors" (:p "Boolean.")) ("Example" (:code-block "lisp" "(lut:tree-expanded-p (lut:make-tree-model '(a) :children (constantly nil)) 'a)"))))
(:entry "symbol/tree-rows" :names ("TREE-ROWS") :kind :function :kind-name "Function" :package "LUT" :summary "Return flattened visible (node depth) pairs, respecting each node's :OPEN value." :sections (("Signature" (:code-block "lisp" "(tree-rows tree)")) ("Arguments and valid values" (:p "TREE is a tree-view. NODES are lists of (:TEXT string :CHILDREN nodes :OPEN boolean) property lists.")) ("Results and errors" (:p "Visible (node depth) pairs.")) ("Example" (:code-block "lisp" "(lut:tree-rows (lut:make-widget 'lut:tree-view :nodes '((:text \"Root\"))))"))))
(:entry "symbol/ui-scale" :names ("UI-SCALE") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WINDOW: Application UI zoom; layout, geometry and dispatched events remain in logical UI units. (valid values (real (0) *))." :sections (("Signature" (:code-block "lisp" "(ui-scale lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WINDOW: Application UI zoom; layout, geometry and dispatched events remain in logical UI units. (valid values (real (0) *)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:window))) (lut:ui-scale w))"))))
(:entry "symbol/ui-to-device" :names ("UI-TO-DEVICE") :kind :function :kind-name "Function" :package "LUT" :summary "Convert logical UI coordinates to native window coordinates. OS backing-pixel DPI remains the backend's responsibility." :sections (("Signature" (:code-block "lisp" "(ui-to-device window x y)")) ("Arguments and valid values" (:p "WINDOW is a root with positive UI-SCALE. X/Y are logical UI coordinates; conversion does not apply OS backing-pixel DPI.")) ("Results and errors" (:p "Two native-window coordinates.")) ("Example" (:code-block "lisp" "(lut:ui-to-device (lut:make-widget 'lut:window :ui-scale 2) 10 20)"))))
(:entry "symbol/unbind-command" :names ("UNBIND-COMMAND") :kind :function :kind-name "Function" :package "LUT" :summary "Disconnect BINDING idempotently. Restore the control's previous label/enabled state by default; clear all endpoint/context references." :sections (("Signature" (:code-block "lisp" "(unbind-command binding &key (restore-p t))")) ("Arguments and valid values" (:p "BINDING is a command binding. Idempotently disconnects activation/shortcut handlers and clears endpoints, context, providers and saved state. RESTORE-P defaults T and restores the previous control label/enabled state; NIL leaves it disabled.")) ("Results and errors" (:p "BINDING.")) ("Example" (:code-block "lisp" "(lut:unbind-command binding)"))))
(:entry "symbol/undo" :names ("UNDO") :kind :function :kind-name "Function" :package "LUT" :summary "Undo an entry or text buffer. All histories store ranges; shared views use their buffer. Return true when changed." :sections (("Signature" (:code-block "lisp" "(undo entry)")) ("Arguments and valid values" (:p "TARGET is an entry/text-view or text-buffer. All histories store changed ranges; the character budget counts removed plus inserted text. Shared views use model history. Undo restores stored selection in the invoking view when available; peers remap their positions. Read-only refuses. Changed shared models notify all attached views.")) ("Results and errors" (:p "True if an edit was restored, NIL if history is empty.")) ("Example" (:code-block "lisp" "(let ((e (lut:make-widget 'lut:entry :text \"before\"))) (setf (lut:text e) \"after\") (lut:undo e))"))))
(:entry "symbol/validate-slot" :names ("VALIDATE-SLOT") :kind :function :kind-name "Function" :package "LUT" :summary "Validate a proposed live slot update before assignment; signal an error to reject it." :sections (("Signature" (:code-block "lisp" "(validate-slot widget slot value)")) ("Arguments and valid values" (:p "WIDGET receives a proposed SLOT symbol and VALUE before SETF mutation. Methods must return normally to accept or signal to reject. Use :AROUND and CALL-NEXT-METHOD to extend invariants.")) ("Results and errors" (:p "Validated value by convention.")) ("Example" (:code-block "lisp" "(lut:validate-slot (lut:make-widget 'lut:slider) 'lut:value 50)"))))
(:entry "symbol/value" :names ("VALUE") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: SUGGESTION-SURFACE: Highlighted candidate index, or NIL. (valid values (or null (integer 0 *))); FONT-CHOOSER: Selected TrueType/OpenType font file. (valid values (or null string pathname)); COLOR-CHOOSER: Four integer channels, each 0..255. (valid values list); FILE-CHOOSER: Chosen file pathname. (valid values (or null pathname)); EXPANDER: Whether content is expanded. (valid values boolean); PANED: Fraction of available space assigned to the first pane. (valid values (real 0 1)); STACK: Visible zero-based page index. (valid values (integer 0 *)); LIST-VIEW: Selected zero-based index, or NIL. (valid values (or null (integer 0 *))); SLIDER: Current number, clamped to bounds by input. (valid values real); CHECK-BUTTON: Checked state. (valid values boolean)." :sections (("Signature" (:code-block "lisp" "(value lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: SUGGESTION-SURFACE: Highlighted candidate index, or NIL. (valid values (or null (integer 0 *))); FONT-CHOOSER: Selected TrueType/OpenType font file. (valid values (or null string pathname)); COLOR-CHOOSER: Four integer channels, each 0..255. (valid values list); FILE-CHOOSER: Chosen file pathname. (valid values (or null pathname)); EXPANDER: Whether content is expanded. (valid values boolean); PANED: Fraction of available space assigned to the first pane. (valid values (real 0 1)); STACK: Visible zero-based page index. (valid values (integer 0 *)); LIST-VIEW: Selected zero-based index, or NIL. (valid values (or null (integer 0 *))); SLIDER: Current number, clamped to bounds by input. (valid values real); CHECK-BUTTON: Checked state. (valid values boolean).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:suggestion-surface))) (lut:value w))"))))
(:entry "symbol/vertical-offset" :names ("VERTICAL-OFFSET") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: ENTRY: Vertical multiline text viewport offset in pixels. (valid values (real 0 *))." :sections (("Signature" (:code-block "lisp" "(vertical-offset lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: ENTRY: Vertical multiline text viewport offset in pixels. (valid values (real 0 *)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:entry))) (lut:vertical-offset w))"))))
(:entry "symbol/view-buffer" :names ("VIEW-BUFFER") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: ENTRY: Optional shared text model; NIL keeps standalone entry editing. (valid values (or null text-buffer))." :sections (("Signature" (:code-block "lisp" "(view-buffer lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: ENTRY: Optional shared text model; NIL keeps standalone entry editing. (valid values (or null text-buffer)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:entry))) (lut:view-buffer w))"))))
(:entry "symbol/view-model" :names ("VIEW-MODEL") :kind :function :kind-name "Function" :package "LUT" :summary "VIEW is a model-backed list/tree/table. Model binding is fixed at construction with :MODEL; model remains application-owned." :sections (("Signature" (:code-block "lisp" "(view-model lut-docs::object)")) ("Arguments and valid values" (:p "VIEW is a model-backed list/tree/table. Model binding is fixed at construction with :MODEL; model remains application-owned.")) ("Results and errors" (:p "DATA-MODEL, or NIL after source/view disposal.")) ("Example" (:code-block "lisp" "(lut:view-model (lut:make-widget 'lut:model-list-view :model (lut:make-vector-model '(a))))"))))
(:entry "symbol/view-selection" :names ("VIEW-SELECTION") :kind :function :kind-name "Function" :package "LUT" :summary "VIEW is model-backed. Optional :SELECTION must use the same model. Views own a default selection; supplied selections remain application-owned." :sections (("Signature" (:code-block "lisp" "(view-selection lut-docs::object)")) ("Arguments and valid values" (:p "VIEW is model-backed. Optional :SELECTION must use the same model. Views own a default selection; supplied selections remain application-owned.")) ("Results and errors" (:p "SELECTION-MODEL or NIL after view disposal.")) ("Example" (:code-block "lisp" "(lut:view-selection (lut:make-widget 'lut:model-list-view :model (lut:make-vector-model '(a))))"))))
(:entry "symbol/visible-model-range" :names ("VISIBLE-MODEL-RANGE") :kind :function :kind-name "Function" :package "LUT" :summary "Return half-open visible indices including partial rows. Zero-height, missing or disposed models return 0,0." :sections (("Signature" (:code-block "lisp" "(visible-model-range view)")) ("Arguments and valid values" (:p "VIEW is model-backed; fixed :ROW-HEIGHT. Clamps scroll offset. Missing/disposed model or zero-height viewport yields 0,0.")) ("Results and errors" (:p "Two half-open visible indices including partial rows.")) ("Example" (:code-block "lisp" "(lut:visible-model-range (lut:make-widget 'lut:model-list-view :model (lut:make-vector-model '(a))))"))))
(:entry "symbol/visible-p" :names ("VISIBLE-P") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: NIL excludes this subtree from layout, drawing and input. (valid values boolean)." :sections (("Signature" (:code-block "lisp" "(visible-p lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: NIL excludes this subtree from layout, drawing and input. (valid values boolean).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:widget))) (lut:visible-p w))"))))
(:entry "symbol/walk-widgets" :names ("WALK-WIDGETS") :kind :function :kind-name "Function" :package "LUT" :summary "Call FUNCTION in preorder, including ROOT." :sections (("Signature" (:code-block "lisp" "(walk-widgets root function)")) ("Arguments and valid values" (:p "ROOT is a widget. FUNCTION takes one widget. Visits root, children and window overlays in preorder; avoid structural mutation during traversal.")) ("Results and errors" (:p "Unspecified.")) ("Example" (:code-block "lisp" "(lut:walk-widgets (lut:make-widget 'lut:window) (lambda (node) (print (class-of node))))"))))
(:entry "symbol/widget-state" :names ("WIDGET-STATE") :kind :function :kind-name "Function" :package "LUT" :summary "Return current style state, with priority disabled, pressed, hover, focus, normal." :sections (("Signature" (:code-block "lisp" "(widget-state w)")) ("Arguments and valid values" (:p "WIDGET is a widget. Priority is inherited disabled, pressed, hover, focused, normal.")) ("Results and errors" (:p ":DISABLED/:PRESSED/:HOVER/:FOCUS/:NORMAL.")) ("Example" (:code-block "lisp" "(lut:widget-state (lut:make-widget 'lut:button :enabled-p nil))"))))
(:entry "symbol/width" :names ("WIDTH") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: Preferred width; containers allocate available width. (valid values (real 0 *))." :sections (("Signature" (:code-block "lisp" "(width lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: Preferred width; containers allocate available width. (valid values (real 0 *)).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:widget))) (lut:width w))"))))
(:entry "symbol/window-commands" :names ("WINDOW-COMMANDS") :kind :function :kind-name "Function" :package "LUT" :summary "Return distinct commands with present bindings in WINDOW, in registration order. Includes disabled commands." :sections (("Signature" (:code-block "lisp" "(window-commands window)")) ("Arguments and valid values" (:p "WINDOW is a root. Returns distinct commands with present bindings, in first-registration order, including unavailable commands. Detached controls are excluded unless another present binding registers the command. Useful for application-built command palettes.")) ("Results and errors" (:p "Fresh list of commands.")) ("Example" (:code-block "lisp" "(lut:window-commands (lut:make-widget 'lut:window))"))))
(:entry "symbol/with-ui" :names ("WITH-UI") :kind :macro :kind-name "Macro" :package "LUT" :summary "Build a tree: (with-ui (box :spacing 4) (make-widget 'label :text \"Hi\"))." :sections (("Signature" (:code-block "lisp" "(with-ui (class &rest initargs) &body children)")) ("Arguments and valid values" (:p "CLASS is an unevaluated class name. INITARGS are evaluated once. Each BODY form must return a widget, adopted in order.")) ("Results and errors" (:p "The constructed container.")) ("Example" (:code-block "lisp" "(lut:with-ui (lut:box :spacing 4) (lut:make-widget 'lut:label :text \"Hi\"))"))))
(:entry "symbol/with-ui-scissor" :names ("WITH-UI-SCISSOR") :kind :macro :kind-name "Macro" :package "LUT" :summary "Render BODY under a logical-coordinate scissor; callers restore an outer clip when nesting." :sections (("Signature" (:code-block "lisp" "(with-ui-scissor (x y width height) &body body)")) ("Arguments and valid values" (:p "Raylib backend only, active drawing context. Rectangle is logical. Ensures native scissor ends on unwind; caller must restore an outer scissor when nesting, as with raylib scopes.")) ("Results and errors" (:p "BODY values.")) ("Example" (:code-block "lisp" "(lut:with-ui-scissor (10 20 100 40) (lut:render widget))"))))
(:entry "symbol/x" :names ("X") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: Allocated horizontal position. (valid values real)." :sections (("Signature" (:code-block "lisp" "(x lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: Allocated horizontal position. (valid values real).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:widget))) (lut:x w))"))))
(:entry "symbol/y" :names ("Y") :kind :function :kind-name "Function" :package "LUT" :summary "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: Allocated vertical position. (valid values real)." :sections (("Signature" (:code-block "lisp" "(y lut-docs::widget)")) ("Arguments and valid values" (:p "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: WIDGET: Allocated vertical position. (valid values real).")) ("Results and errors" (:p "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged.")) ("Example" (:code-block "lisp" "(let ((w (lut:make-widget 'lut:widget))) (lut:y w))"))))
(:entry "type/buffer-edit" :names ("BUFFER-EDIT") :kind :class :kind-name "Type" :package "LUT" :summary "Committed character-range replacement; carries endpoints, revision and optional originating view." :sections (("Description" (:p "See the functions accepting or returning this type."))))
(:entry "type/command-binding" :names ("COMMAND-BINDING") :kind :class :kind-name "Type" :package "LUT" :summary "Command/control/shortcut binding handle; endpoint and context references are cleared on unbinding or disposal." :sections (("Description" (:p "See the functions accepting or returning this type."))))
(:entry "type/command-menu" :names ("COMMAND-MENU") :kind :class :kind-name "Type" :package "LUT" :summary "Owned per-window command menu handle. Groups contain :LABEL and :COMMANDS; :SEPARATOR/NIL entries separate actions. Dispose detaches native/drawn UI." :sections (("Description" (:p "See the functions accepting or returning this type."))))
(:entry "type/connection" :names ("CONNECTION") :kind :class :kind-name "Type" :package "LUT" :summary "Event connection handle returned as ON's second value; DISCONNECT clears its references." :sections (("Description" (:p "See the functions accepting or returning this type."))))
(:entry "type/data-column" :names ("DATA-COLUMN") :kind :class :kind-name "Type" :package "LUT" :summary "Shared immutable column/cell factory definition created by MAKE-DATA-COLUMN." :sections (("Description" (:p "See the functions accepting or returning this type."))))
(:entry "type/data-model" :names ("DATA-MODEL") :kind :class :kind-name "Type" :package "LUT" :summary "Keyed application data. Keys are non-NIL, immutable, unique under EQUAL and stable across reorderings." :sections (("Description" (:p "See the functions accepting or returning this type."))))
(:entry "type/drag-session" :names ("DRAG-SESSION") :kind :class :kind-name "Type" :package "LUT" :summary "Pending or active in-window drag; widget/payload references are released after terminal callbacks." :sections (("Description" (:p "See the functions accepting or returning this type."))))
(:entry "type/model-list-view" :names ("MODEL-LIST-VIEW") :kind :class :kind-name "Type" :package "LUT" :summary "Virtual, fixed-height data rows; MODEL and optional SELECTION are application-owned. No row widgets or ITEMS strings." :sections (("Description" (:p "See the functions accepting or returning this type."))))
(:entry "type/model-table-view" :names ("MODEL-TABLE-VIEW") :kind :class :kind-name "Type" :package "LUT" :summary "Virtual equal-width columns with application cell factories and text-editor commit/cancel hooks." :sections (("Description" (:p "See the functions accepting or returning this type."))))
(:entry "type/model-tree-view" :names ("MODEL-TREE-VIEW") :kind :class :kind-name "Type" :package "LUT" :summary "Keyed tree rows with indentation and expansion; requires a tree model." :sections (("Description" (:p "See the functions accepting or returning this type."))))
(:entry "type/path-request" :names ("PATH-REQUEST") :kind :class :kind-name "Type" :package "LUT" :summary "One file/folder/save request. Callback receives pathname on acceptance or NIL on cancellation; no file is written." :sections (("Description" (:p "See the functions accepting or returning this type."))))
(:entry "type/remote-window" :names ("REMOTE-WINDOW") :kind :class :kind-name "Type" :package "LUT" :summary "Native worker handle returned by SPAWN-WINDOW and DETACH-WINDOW. Root/process/reader references are cleared after closure." :sections (("Description" (:p "See the functions accepting or returning this type."))))
(:entry "type/selection-model" :names ("SELECTION-MODEL") :kind :class :kind-name "Type" :package "LUT" :summary "Independent keyed :NONE/:SINGLE/:MULTIPLE selection created by MAKE-SELECTION-MODEL; source remains application-owned." :sections (("Description" (:p "See the functions accepting or returning this type."))))
(:entry "type/unsupported-capability" :names ("UNSUPPORTED-CAPABILITY") :kind :class :kind-name "Type" :package "LUT" :summary "Backend capability error condition; CAPABILITY initarg identifies the unavailable operation." :sections (("Description" (:p "See the functions accepting or returning this type."))))
(:entry "variable/*api*" :names ("*API*") :kind :variable :kind-name "Variable" :package "LUT" :summary "Declarative class metadata used by the docset generator." :sections (("Description" (:p "Declarative class metadata used by the docset generator.")) ("Example" (:code-block "lisp" "lut:*api*"))))
(:entry "variable/*dark-theme*" :names ("*DARK-THEME*") :kind :variable :kind-name "Variable" :package "LUT" :summary "Public library state." :sections (("Description" (:p "Public library state.")) ("Example" (:code-block "lisp" "lut:*dark-theme*"))))
(:entry "variable/*light-theme*" :names ("*LIGHT-THEME*") :kind :variable :kind-name "Variable" :package "LUT" :summary "Public library state." :sections (("Description" (:p "Public library state.")) ("Example" (:code-block "lisp" "lut:*light-theme*"))))
(:entry "variable/*window*" :names ("*WINDOW*") :kind :variable :kind-name "Variable" :package "LUT" :summary "Most recently started active window; cleared on disposal/teardown." :sections (("Description" (:p "Most recently started active window; cleared on disposal/teardown.")) ("Example" (:code-block "lisp" "lut:*window*"))))
(:entry "variable/*worker-command*" :names ("*WORKER-COMMAND*") :kind :variable :kind-name "Variable" :package "LUT" :summary "Executable and startup flags for a worker. Override for other implementations or deployed images." :sections (("Description" (:p "Executable and startup flags for a worker. Override for other implementations or deployed images.")) ("Example" (:code-block "lisp" "lut:*worker-command*"))))
