("event/model-change" :names (":MODEL-CHANGE") :kind :event :kind-name "Event" :package "LUT" :summary "DATA-MODEL: new MODEL-REVISION after committed data/query/tree updates. Source changes refresh projections and reconcile key selections. Reentrant writes are rejected; observer errors propagate after commit and may prevent later notifications." :position 177011)
