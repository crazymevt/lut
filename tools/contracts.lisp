(defpackage #:lut-docs (:use #:cl) (:export #:generate))
(in-package #:lut-docs)
(defparameter *contracts*
 '(
   (lut:make-text-buffer "TEXT is a string; READ-ONLY-P controls editing APIs, not programmatic SETF TEXT. History limits bound shared range records; the character budget counts removed plus inserted text, not full-buffer size. Keep this nonvisual model outside the visual child tree." "A shared TEXT-BUFFER." "(lut:make-text-buffer :text \"Shared text\" :history-limit 100)")
   (lut:buffer-revision "BUFFER is a text buffer. Revision increases once per effective content edit, including undo/redo and SETF TEXT; no-op edits do not increment it." "Nonnegative integer." "(lut:buffer-revision (lut:make-text-buffer))")
   (lut:editable-p "TARGET is an entry/text view or text buffer. Requires a live target, a false local READ-ONLY-P, and (for shared views) a live writable buffer. Enabled/visible UI policy is separate." "Boolean." "(lut:editable-p (lut:make-widget 'lut:text-view :read-only-p t))")
   (lut:can-undo-p "TARGET is an entry/view or text buffer. Reports available history and effective read-only policy. Shared views use model history." "Boolean." "(lut:can-undo-p (lut:make-text-buffer))")
   (lut:can-redo-p "TARGET is an entry/view or text buffer. Reports available redo history and effective read-only policy." "Boolean." "(lut:can-redo-p (lut:make-text-buffer))")
   (lut:replace-buffer-range "BUFFER is live. START/END are character indices with 0 <= START <= END <= text length; STRING replaces [START,END). Optional ORIGIN is a live attached view whose caret collapses after inserted text. Other view positions remap; notification callbacks must not reedit the same model synchronously. Read-only returns NIL without changing text/history." "BUFFER-EDIT for an effective change, NIL for a no-op/read-only refusal. Errors propagate after committed edits remain synchronized." "(let ((b (lut:make-text-buffer :text \"abc\"))) (lut:replace-buffer-range b 1 2 \"X\"))")
   (lut:edit-start "EDIT is a BUFFER-EDIT notification record. Retaining a record with a non-NIL origin intentionally retains that view." "Start character index." "(lut:edit-start edit)")
   (lut:edit-old-end "EDIT is a BUFFER-EDIT notification record. Retaining a record with a non-NIL origin intentionally retains that view." "Exclusive old end character index." "(lut:edit-old-end edit)")
   (lut:edit-new-end "EDIT is a BUFFER-EDIT notification record. Retaining a record with a non-NIL origin intentionally retains that view." "Exclusive new end character index." "(lut:edit-new-end edit)")
   (lut:edit-revision "EDIT is a BUFFER-EDIT notification record. Retaining a record with a non-NIL origin intentionally retains that view." "Committed buffer revision." "(lut:edit-revision edit)")
   (lut:edit-origin "EDIT is a BUFFER-EDIT notification record. Retaining a record with a non-NIL origin intentionally retains that view." "Originating view or NIL." "(lut:edit-origin edit)")
   (lut:make-command "ID is a symbol/string/NIL, LABEL a string, ACTION a function designator taking (command context). ENABLED-P is the master boolean. ENABLED-WHEN is an optional pure predicate with the same arguments. SHORTCUT is a normalized keyword or exact key/modifier plist." "A nonvisual COMMAND; keep it outside the visual child tree." "(lut:make-command :hello \"Hello\" (lambda (command context) (declare (ignore command context)) (print :hello)) :shortcut :f6)")
   (lut:command-available-p "COMMAND is a command; CONTEXT is application data. Requires a live/enabled command, an action and a true predicate result. Rechecked before every invocation." "Boolean." "(lut:command-available-p (lut:make-command :hello \"Hello\" (lambda (c context) (declare (ignore c context)))) nil)")
   (lut:invoke-command "COMMAND is a command. Rechecks availability with CONTEXT, then calls its action exactly once. Direct programmatic invocation has no window/modal policy; bindings enforce UI policy. Errors propagate." "Executed-p and the primary action result; unavailable returns NIL/NIL. A NIL result can still have executed-p T." "(lut:invoke-command (lut:make-command :hello \"Hello\" (lambda (c context) (declare (ignore c context)) :done)) nil)")
   (lut:bind-command "WINDOW and COMMAND must be live. WIDGET optionally identifies a button/menu button; a control may have one active binding. CONTEXT defaults to WINDOW; CONTEXT-FUNCTION optionally takes WINDOW to obtain dynamic data. SHORTCUT-P defaults T. Binding owns label/enabled state until unbound. Detached controls are inactive until adopted by WINDOW. Existing activation handlers are retained." "COMMAND-BINDING. On registration errors, connections and references are rolled back." "(let* ((w (lut:make-widget 'lut:window)) (b (lut:add-child w (lut:make-widget 'lut:button))) (c (lut:make-command :hello \"Hello\" (lambda (c context) (declare (ignore c context)))))) (lut:bind-command w c :widget b))")
   (lut:unbind-command "BINDING is a command binding. Idempotently disconnects activation/shortcut handlers and clears endpoints, context, providers and saved state. RESTORE-P defaults T and restores the previous control label/enabled state; NIL leaves it disabled." "BINDING." "(lut:unbind-command binding)")
   (lut:command-binding-active-p "BINDING is a command binding. Read-only public accessor; false after unbinding or endpoint disposal." "Boolean." "(lut:command-binding-active-p binding)")
   (lut:refresh-commands "WINDOW is a root. Re-evaluates context/predicates for its command-bound controls and synchronizes captions/enabled state. Runs automatically before ordinary input and rendering; call explicitly after external model changes when querying control state immediately." "WINDOW." "(lut:refresh-commands (lut:make-widget 'lut:window))")
   (lut:window-commands "WINDOW is a root. Returns distinct commands with present bindings, in first-registration order, including unavailable commands. Detached controls are excluded unless another present binding registers the command. Useful for application-built command palettes." "Fresh list of commands." "(lut:window-commands (lut:make-widget 'lut:window))")
   (lut:scroll-tabs "BOOK is a notebook; DELTA is a real pixel distance. Positive scrolls right; selection is unchanged. Offset clamps to the current overflow range." "New tab offset." "(lut:scroll-tabs (lut:make-widget 'lut:notebook) 96)")
   (lut:reveal-page "BOOK is a notebook; optional INDEX defaults to VALUE and must identify a page. Scrolls the tab into view without changing selection." "New tab offset." "(let ((b (lut:with-ui (lut:notebook :items '(\"One\")) (lut:make-widget 'lut:label)))) (lut:reveal-page b 0))")
   (lut:tab-at-position "BOOK is a notebook. X/Y are root coordinates. Navigation buttons, body and empty space return NIL; hidden tabs are not hit." "Visible zero-based page index or NIL." "(lut:tab-at-position (lut:make-widget 'lut:notebook) 10 10)")
   (lut:current-drag "WINDOW is a root. Includes pending sessions; returns NIL after termination." "DRAG-SESSION or NIL." "(lut:current-drag (lut:make-widget 'lut:window))")
   (lut:drag-data "SOURCE is a widget; EVENT is pointer down. Override this generic to offer arbitrary in-process data without mutating the widget tree." "Two values: payload and offered-p. NIL payload is valid when offered-p is true." "(lut:drag-data (lut:make-widget 'lut:button) (lut:make-event :kind :down))")
   (lut:accepts-drop-p "TARGET is a live widget; SESSION is a drag; EVENT supplies the root coordinates. Pure acceptance predicate, default NIL. Ancestors are tried from deepest to root." "Generalized boolean." "(lut:accepts-drop-p target session (lut:make-event :kind :move))")
   (lut:perform-drop "TARGET passed acceptance; SESSION and EVENT describe release. Override to commit the operation; default true permits an ON :DROP handler to implement it. Errors propagate after drag cleanup; application changes are not rolled back." "True on success, NIL to reject." "(lut:perform-drop target session (lut:make-event :kind :up))")
   (lut:begin-drag "SOURCE must be enabled/visible/live in an input root; EVENT must be :DOWN. Cancels the previous session, then arms a thresholded drag with PAYLOAD." "New pending session." "(let* ((w (lut:make-widget 'lut:window)) (b (lut:add-child w (lut:make-widget 'lut:button)))) (lut:begin-drag b :data (lut:make-event :kind :down)))")
   (lut:cancel-drag "WINDOW is a root. Cancels pending/active drag, releasing capture. Active sessions emit :DRAG-LEAVE then :DRAG-END. Safe when none exists." "True when cancelled, otherwise NIL." "(lut:cancel-drag (lut:make-widget 'lut:window))")
   (lut:render-drag-feedback "WINDOW is a root. Backend hook called after all content. Raylib draws target outline, notebook insertion marker and pointer marker. Override for custom previews." "Unspecified." "(defmethod lut:render-drag-feedback ((window my-window)) (call-next-method))")
   (lut:move-page "SOURCE and TARGET are notebooks sharing a root. PAGE must be a child of SOURCE. INDEX is an insertion boundary 0..target child count, before removal. Same-source boundaries adjust for removal. No group/reorder opt-in required for explicit programmatic moves; pointer transfers require matching non-NIL groups. Rejects cycles and invalid indices before mutation." "PAGE. Emits :CHANGE and :PAGES-CHANGED after structural updates." "(lut:move-page source page target 0)")
   (lut:drag-source "SESSION is a DRAG-SESSION. Read-only public accessor. Source/payload/target references are cleared after completion callbacks." "Source widget." "(lut:drag-source session)")
   (lut:drag-payload "SESSION is a DRAG-SESSION. Read-only public accessor. Source/payload/target references are cleared after completion callbacks." "Arbitrary payload." "(lut:drag-payload session)")
   (lut:drag-target "SESSION is a DRAG-SESSION. Read-only public accessor. Source/payload/target references are cleared after completion callbacks." "Accepted target widget or NIL." "(lut:drag-target session)")
   (lut:drag-state "SESSION is a DRAG-SESSION. Read-only public accessor. Source/payload/target references are cleared after completion callbacks." "One of :PENDING, :DRAGGING, :DROPPED, :REJECTED, :CANCELLED." "(lut:drag-state session)")
   (lut:drag-x "SESSION is a DRAG-SESSION. Read-only public accessor. Source/payload/target references are cleared after completion callbacks." "Latest root X coordinate." "(lut:drag-x session)")
   (lut:drag-y "SESSION is a DRAG-SESSION. Read-only public accessor. Source/payload/target references are cleared after completion callbacks." "Latest root Y coordinate." "(lut:drag-y session)")
   (lut:display-text "WIDGET is a label or entry. Returns the visible string, which can differ from TEXT for masked/formatted widgets. Override this generic to preserve common selection and rendering." "A string with compatible character boundaries." "(lut:display-text (lut:make-widget 'lut:entry :text \"Visible\"))")
   (lut:bind-key "WINDOW is a root; KEY is a normalized keyword such as :CONTROL-S or :F1; FUNCTION takes no arguments. Modal dialogs suspend root actions. OWNER optionally disconnects the shortcut on disposal." "Callback and connection handle, as for ON." "(let ((w (lut:make-widget 'lut:window))) (lut:bind-key w :control-s (lambda () (print :save)) :owner w))")
   (lut:undo "TARGET is an entry/text-view or text-buffer. Shared views use model history. Undo restores stored selection in the invoking view when available; peers remap their positions. Read-only refuses. Changed shared models notify all attached views." "True if an edit was restored, NIL if history is empty." "(let ((e (lut:make-widget 'lut:entry :text \"before\"))) (setf (lut:text e) \"after\") (lut:undo e))")
   (lut:redo "TARGET is an entry/text-view or text-buffer. Reapplies history unless read-only; shared changes notify all views. A new content edit clears redo history." "True when changed, NIL when empty." "(let ((e (lut:make-widget 'lut:entry))) (lut:replace-selection e \"edit\") (lut:undo e) (lut:redo e))")
   (lut:disposed-p "WIDGET is a widget. Reports whether DISPOSE has destroyed it. The managed setter rejects state changes; use DISPOSE, not SETF, and never revive a disposed tree." "Boolean." "(let ((w (lut:make-widget 'lut:widget))) (lut:dispose w) (lut:disposed-p w))")
   (lut:dispose "WIDGET is a widget subtree or command-binding handle (which is unbound). Idempotently destroys it, detaches ownership, clears focus/capture, connections, callbacks, standard model data and owned queued work. Cannot be revived. Define DISPOSE :BEFORE/:AFTER methods for custom resources; invoke on the GUI thread while running." "WIDGET. Cleanup runs even if a subclass disposal method signals." "(let* ((w (lut:make-widget 'lut:box)) (child (lut:add-child w (lut:make-widget 'lut:entry)))) (lut:dispose child) (lut:disposed-p child))")
   (lut:off "WIDGET is an event source. EVENT and CALLBACK are optional; NIL matches all. Disconnects every matching connection, including owner-side bookkeeping and callback references." "Number of removed connections." "(let ((b (lut:make-widget 'lut:button))) (lut:on b :activate (lambda (w p) (declare (ignore w p)))) (lut:off b :activate))")
   (lut:disconnect "CONNECTION is ON's second return value. Idempotently removes both source and owner registrations, marks it inactive and clears callback/source/owner references. Skipped if disconnected during an emission." "CONNECTION." "(let* ((w (lut:make-widget 'lut:button)) (c (nth-value 1 (lut:on w :activate (lambda (w p) (declare (ignore w p))))))) (lut:disconnect c))")
   (lut:on-widget "WIDGET is a live owner. BODY is queued as a closure like ON-UI, but pending work is automatically cancelled and released when the owner is disposed." "The closure and a cancellable job handle as two values." "(let ((w (lut:make-widget 'lut:label))) (lut:on-widget w (setf (lut:text w) \"Updated\")) (lut:dispose w))")
   (lut:cancel-ui "HANDLE is ENQUEUE-UI/ON-UI/ON-WIDGET's second value, or a queued function object. Cancels matching pending jobs and releases function/owner references. Already executing work finishes normally." "Number of cancelled jobs." "(let ((job (nth-value 1 (lut:enqueue-ui (lambda () :unused))))) (lut:cancel-ui job))")
   (lut:dismiss-dialog "DIALOG is a dialog with its current ownership intact. Removes an in-window modal overlay or closes its detached native host. Prefer this over capturing the original root in response callbacks." "DIALOG; native closure is asynchronous." "(let* ((w (lut:make-widget 'lut:window)) (d (lut:make-widget 'lut:dialog))) (lut:show-dialog w d) (lut:dismiss-dialog d))")
   (lut:make-widget "CLASS is a widget class symbol; INITARGS are the documented keyword initargs for that class. Invalid types signal TYPE-ERROR; inconsistent numeric bounds signal ERROR." "A new widget." "(lut:make-widget 'lut:button :text \"Hello\")")
   (lut:with-ui "CLASS is an unevaluated class name. INITARGS are evaluated once. Each BODY form must return a widget, adopted in order." "The constructed container." "(lut:with-ui (lut:box :spacing 4) (lut:make-widget 'lut:label :text \"Hi\"))")
   (lut:defwidget "NAME is a class symbol; SUPERS a list of widget superclasses; DOCUMENTATION a string. SLOTS are (name initform type documentation) lists. Initargs use matching keywords. SETF validates before assignment. Re-evaluation uses standard CLOS class redefinition." "The class name." "(lut:defwidget counter-label (lut:label) \"Live counter.\" ((tally 0 (integer 0 *) \"Non-negative count.\")))")
   (lut:add-child "CONTAINER and CHILD are widgets. Reparents CHILD. Rejects cycles and disposed nodes before changing ownership." "CHILD." "(let ((box (lut:make-widget 'lut:box))) (lut:add-child box (lut:make-widget 'lut:button)))")
   (lut:remove-child "CONTAINER and CHILD are widgets. No-op if not owned by CONTAINER. Clears focus, capture and drag references. :DISPOSE T destroys the subtree; default NIL keeps it reusable." "CHILD." "(let* ((box (lut:make-widget 'lut:box)) (child (lut:add-child box (lut:make-widget 'lut:label)))) (lut:remove-child box child))")
   (lut:walk-widgets "ROOT is a widget. FUNCTION takes one widget. Visits root, children and window overlays in preorder; avoid structural mutation during traversal." "Unspecified." "(lut:walk-widgets (lut:make-widget 'lut:window) (lambda (node) (print (class-of node))))")
   (lut:find-widget "ROOT is a widget; ID is a string, symbol or NIL compared with EQUAL. Prefer unique non-NIL identifiers." "First matching widget or NIL." "(let ((w (lut:with-ui (lut:box) (lut:make-widget 'lut:entry :id :name)))) (lut:find-widget w :name))")
   (lut:on "WIDGET is a widget; EVENT is :ACTIVATE, :CHANGE, :TICK, :CONTEXT or an application keyword. CALLBACK is a function or symbol taking (widget payload); registrations are additive and ordered. OWNER optionally is a widget whose disposal disconnects this binding. Use an owner for callbacks capturing transient controls." "CALLBACK and a CONNECTION handle as a second value." "(lut:on (lut:make-widget 'lut:button) :activate (lambda (widget payload) (declare (ignore widget payload)) (print :clicked)))")
   (lut:emit "WIDGET is a widget; EVENT a keyword; PAYLOAD defaults to NIL. Calls handlers synchronously in registration order. Handler errors propagate." "Unspecified." "(let ((b (lut:make-widget 'lut:button))) (lut:on b :activate (lambda (w p) (declare (ignore w p)) :ok)) (lut:emit b :activate))")
   (lut:layout "WIDGET is a widget; X/Y are real coordinates; WIDTH/HEIGHT non-negative pixel extents. Updates allocation and lays out container children. Override methods for custom layout." "WIDGET." "(lut:layout (lut:make-widget 'lut:box) 0 0 640 480)")
   (lut:hit-test "WIDGET is a widget; PX/PY real root coordinates. Excludes hidden, disabled, inactive and clipped descendants." "Deepest eligible widget, or NIL." "(let ((b (lut:make-widget 'lut:button))) (lut:hit-test b 10 10))")
   (lut:focus "WINDOW is the owning root; WIDGET is an enabled visible focusable descendant or NIL. Invalid targets signal ERROR." "The new focused widget or NIL." "(let* ((w (lut:make-widget 'lut:window)) (e (lut:add-child w (lut:make-widget 'lut:entry)))) (lut:focus w e))")
   (lut:make-event "KIND is :DOWN/:MOVE/:UP/:WHEEL/:KEY/:TEXT/:CONTEXT/:GESTURE. X/Y/DELTA real; KEY a keyword or NIL; TEXT string; SHIFT-P/CONTROL-P/ALT-P/SUPER-P boolean. BASE-KEY is the original key before aliases such as :COPY; native input populates it, synthetic events may supply it. Defaults: coordinates/delta 0, text empty, keys/modifiers NIL." "A normalized event." "(lut:make-event :kind :text :text \"Ελληνικά\")")
   (lut:dispatch "WINDOW is a root window; EVENT a MAKE-EVENT value. Dispatches modal input, gestures, context menus and keyboard edits. Use ON-UI from another thread." "Target widget or NIL; handlers may return other values." "(lut:dispatch (lut:make-widget 'lut:window) (lut:make-event :kind :key :key :tab))")
   (lut:handle-event "WIDGET is an extension receiver; EVENT a normalized event. Define a specialized method and return non-NIL to consume before default dispatch." "True if consumed, NIL otherwise." "(lut:handle-event (lut:make-widget 'lut:spin-button) (lut:make-event :kind :key :key :up))")
   (lut:selection "ENTRY is an entry or text-view. Indices are zero-based character boundaries, not UTF-8 bytes." "Two values: sorted start and end indices." "(let ((e (lut:make-widget 'lut:entry :text \"abc\"))) (lut:select-all e) (lut:selection e))")
   (lut:select-all "ENTRY is an entry/text-view; selects 0 through text length." "ENTRY." "(lut:select-all (lut:make-widget 'lut:entry :text \"Hello\"))")
   (lut:selected-text "ENTRY is an entry/text-view; an empty selection returns an empty string." "Selected substring." "(let ((e (lut:make-widget 'lut:entry :text \"abc\"))) (lut:select-all e) (lut:selected-text e))")
   (lut:replace-selection "ENTRY is an entry/text-view. When editable, STRING replaces its selection. Shared views edit the model and notify all peers once; standalone views keep local history. Read-only leaves text/selection unchanged." "Unspecified." "(let ((e (lut:make-widget 'lut:entry))) (lut:replace-selection e \"Hello\"))")
   (lut:clipboard-text "WIDGET identifies backend context. Core uses an in-memory clipboard; raylib entries use the OS clipboard, requiring an active native window. SETF accepts a string." "Clipboard string." "(let ((w (lut:make-widget 'lut:widget))) (setf (lut:clipboard-text w) \"Copied\") (lut:clipboard-text w))")
   (lut:style-value "WIDGET is a widget; KEY a style token keyword; DEFAULT used only when no style/theme/default token exists. Local state/base styles precede ancestor overrides, root class/state rules, root theme and defaults." "Resolved token, including explicit NIL." "(lut:style-value (lut:make-widget 'lut:entry :style '(:font-size 24)) :font-size)")
   (lut:widget-state "WIDGET is a widget. Priority is inherited disabled, pressed, hover, focused, normal." ":DISABLED/:PRESSED/:HOVER/:FOCUS/:NORMAL." "(lut:widget-state (lut:make-widget 'lut:button :enabled-p nil))")
   (lut:row-height "WIDGET has styles; :ROW-HEIGHT must be a positive real pixel extent." "Positive real." "(lut:row-height (lut:make-widget 'lut:list-view))")
   (lut:line-height "WIDGET has styles; :LINE-HEIGHT must be a positive real pixel extent." "Positive real." "(lut:line-height (lut:make-widget 'lut:text-view))")
   (lut:text-width "WIDGET selects the font backend; STRING is measured as a complete string. Core estimates; raylib label methods use MeasureTextEx and a loaded font in an active window." "Non-negative pixel width." "(lut:text-width (lut:make-widget 'lut:widget) \"Hello\")")
   (lut:range-fraction "CONTROL is a slider/progress/spin control. Bounds enclose VALUE. Zero-length ranges return 0; fractional ranges retain their scale." "Real in 0..1." "(lut:range-fraction (lut:make-widget 'lut:slider :maximum 0.5 :value 0.25))")
   (lut:active-children "WIDGET is a container. Stack exposes its selected child; collapsed expander exposes none; ordinary containers expose visible children." "List of widgets." "(lut:active-children (lut:make-widget 'lut:stack))")
   (lut:select-page "STACK is a stack/notebook; INDEX an integer in 0 through child-count minus one. Emits :CHANGE with INDEX; invalid indices signal ERROR." "Selected index." "(let ((s (lut:with-ui (lut:stack) (lut:make-widget 'lut:label)))) (lut:select-page s 0))")
   (lut:tree-rows "TREE is a tree-view. NODES are lists of (:TEXT string :CHILDREN nodes :OPEN boolean) property lists." "Visible (node depth) pairs." "(lut:tree-rows (lut:make-widget 'lut:tree-view :nodes '((:text \"Root\"))))")
   (lut:refresh-items "WIDGET is a tree/table or another widget. Rebuilds display items for tree/table models; other widgets are unchanged." "WIDGET." "(lut:refresh-items (lut:make-widget 'lut:table-view :columns '(\"Name\") :rows '((\"Ada\"))))")
   (lut:sort-table "TABLE is a table-view; COLUMN is a valid zero-based column index. DESCENDING boolean defaults NIL. Compares printed cells lexically, retaining equal-key order." "TABLE." "(lut:sort-table (lut:make-widget 'lut:table-view :columns '(\"Name\") :rows '((\"Z\") (\"A\"))) 0)")
   (lut:group-radios "RADIOS are radio-button instances. Mutates each GROUP to the same list; subsequent activation enforces exclusivity." "The radio list." "(lut:group-radios (lut:make-widget 'lut:radio-button) (lut:make-widget 'lut:radio-button))")
   (lut:validate-slot "WIDGET receives a proposed SLOT symbol and VALUE before SETF mutation. Methods must return normally to accept or signal to reject. Use :AROUND and CALL-NEXT-METHOD to extend invariants." "Validated value by convention." "(lut:validate-slot (lut:make-widget 'lut:slider) 'lut:value 50)")
   (lut:show-dialog "WINDOW owns DIALOG, which must currently have no parent. Pushes modal overlay and clears focus/capture. Drag empty surface/title to move; crossing root bounds detaches when enabled." "DIALOG." "(lut:show-dialog (lut:make-widget 'lut:window) (lut:make-widget 'lut:dialog :width 300 :height 180))")
   (lut:close-dialog "WINDOW is a root. Removes its top overlay and clears focus. Does not close native worker windows; use CLOSE-WINDOW for their handles." "Removed dialog or NIL." "(lut:close-dialog (lut:make-widget 'lut:window))")
   (lut:open-context-menu "WINDOW is root; TARGET is the owner; EVENT provides pointer coordinates. ACTIONS optionally lists (caption no-argument-callback enabled-p) records. Defaults to entry editing actions. Outside click/Escape dismisses." "Menu or NIL when no actions apply." "(let* ((w (lut:make-widget 'lut:window :width 600 :height 400)) (e (lut:add-child w (lut:make-widget 'lut:entry)))) (lut:open-context-menu w e (lut:make-event :kind :context :x 20 :y 20)))")
   (lut:choose-file "WINDOW is root; CALLBACK receives pathname on Choose. DIRECTORY defaults to user home and must be a directory pathname. Dialog supports explicit path, directory listing and navigation; file errors propagate." "Chooser dialog." "(lut:choose-file (lut:make-widget 'lut:window) (lambda (path) (print path)))")
   (lut:choose-color "WINDOW is root; CALLBACK receives a fresh RGBA byte list. INITIAL must have four integer channels in 0..255, default (0 0 0 255)." "Chooser dialog." "(lut:choose-color (lut:make-widget 'lut:window) (lambda (rgba) (print rgba)) :initial '(20 40 60 255))")
   (lut:choose-font "WINDOW is root; CALLBACK receives font pathname and positive integer size. INITIAL is NIL/string/pathname. Applying requires an existing file." "Chooser dialog." "(lut:choose-font (lut:make-widget 'lut:window) (lambda (path size) (print (list path size))))")
   (lut:run "WINDOW is a root window; FRAMES is NIL for interactive or a positive integer for a bounded run. Requires backend; CCL/macOS bridges to OS main thread. Errors pause interactive runs; bounded runs signal. A nested run spawns a worker." "Normal loop result, or remote-window for a secondary window." "(lut:run (lut:make-widget 'lut:window :width 640 :height 480) :frames 3)")
   (lut:start "WINDOW is root; FRAMES optional positive frame count; WAIT boolean controls binding runner wait. First launch uses the OS main-thread runner; subsequent launches spawn native workers." "Runner result or remote-window." "(lut:start (lut:make-widget 'lut:window :text \"Live\" :width 640 :height 480))")
   (lut:stop "No arguments. Requests the primary event loop stop after the current frame. Loop teardown requests closure of all worker windows, releases library-owned roots and clears pending work; application-owned primary trees remain reusable." "No meaningful value." "(lut:stop)")
   (lut:render "WIDGET is a visible node. Called inside a drawing frame with a live native context. Define per-class primary methods; the around method clips and renders active descendants." "Unspecified." "(defmethod lut:render ((w counter-label)) (call-next-method))")
   (lut:frame-step "WINDOW is the primary root; DT is elapsed seconds. Requires active raylib context. Drains REPL edits and remote IPC, emits :TICK, lays out, handles input and draws." "Unspecified." "(lut:frame-step window 0.016)")
   (lut:enqueue-ui "FUNCTION is a no-argument closure. Queues FIFO across threads; result is not transported. OWNER optionally cancels pending work when disposed. Failed jobs are not retried; later jobs remain queued." "FUNCTION and a cancellable job handle as a second value." "(lut:enqueue-ui (lambda () (setf (lut:text lut:*window*) \"Edited live\")))")
   (lut:on-ui "BODY is code captured as a closure and executed before a subsequent GUI frame. Lexical variables are captured. Paused error screens must resume before draining." "Queued closure." "(lut:on-ui (lut:add-child lut:*window* (lut:make-widget 'lut:label :text \"Live\")))")
   (lut:spawn-window "WINDOW is a root window. POSITION optionally is (screen-x screen-y), real coordinates. STYLE-SOURCE defaults to the currently active root and propagates app styles; an explicitly supplied theme remains an override. Uses *WORKER-COMMAND*, the local ASDF checkout and Quicklisp setup if present. Primary loop services IPC. Keep returned handle." "REMOTE-WINDOW." "(lut:on-ui (lut:spawn-window (lut:make-widget 'lut:window :text \"Second\" :width 400 :height 300)))")
   (lut:detach-window "DIALOG is an in-window dialog. Transfers its original objects to a new root and opens a native worker. Parent callbacks remain in the original Lisp. Drag beyond root bounds invokes this automatically when enabled." "REMOTE-WINDOW." "(let ((d (lut:make-widget 'lut:dialog :width 300 :height 200))) (lut:show-dialog lut:*window* d) (lut:on-ui (lut:detach-window d)))")
   (lut:remote-alive-p "REMOTE is a remote-window handle returned by SPAWN-WINDOW/DETACH-WINDOW. Reader thread updates liveness after EOF/closed." "Boolean." "(lut:remote-alive-p remote)")
   (lut:close-window "REMOTE is a live or closed remote-window handle. Requests native worker closure; completion is asynchronous. :DISPOSE defaults T and destroys the tree on closure. NIL preserves the tree for reuse, but always clears handle/registry references." "REMOTE." "(lut:close-window remote)")
   (lut:evaluate-in-window "REMOTE is a handle; FORMS is a list of trusted Lisp forms. Explicitly evaluates on worker main thread before its next frame, for native operations. Application methods/classes/source reloads belong in ON-UI. Not an untrusted-data API." "REMOTE." "(lut:evaluate-in-window remote '((asdf:load-system \"lut\" :force t)))")
   (lut:on-window "REMOTE expression returns a handle; BODY forms are quoted and sent for explicit native-operation evaluation in that worker. Lexical parent variables are not captured; ordinary app edits use ON-UI." "REMOTE." "(lut:on-window remote (asdf:load-system \"lut\" :force t))")))
