(defpackage #:lut-docs (:use #:cl) (:export #:generate))
(in-package #:lut-docs)
(defparameter *platform-contracts*
 '((lut:ui-to-device "WINDOW is a root with positive UI-SCALE. X/Y are logical UI coordinates; conversion does not apply OS backing-pixel DPI." "Two native-window coordinates." "(lut:ui-to-device (lut:make-widget 'lut:window :ui-scale 2) 10 20)")
   (lut:device-to-ui "WINDOW is a root with positive UI-SCALE. X/Y are native-window coordinates; layout and ordinary DISPATCH remain logical." "Two logical UI coordinates." "(lut:device-to-ui (lut:make-widget 'lut:window :ui-scale 2) 20 40)")
   (lut:dispatch-device-event "WINDOW is live. EVENT uses native-window coordinates. Copies and converts X/Y once, preserving wheel counts, timestamps, text and modifiers. Original event is unchanged." "DISPATCH result." "(lut:dispatch-device-event (lut:make-widget 'lut:window :ui-scale 2) (lut:make-event :kind :move :x 20 :y 40))")
   (lut:install-command-menu "WINDOW is live, with at most one installed handle. GROUPS are copied (:LABEL string :COMMANDS (command :SEPARATOR command ...)) plists; NIL also separates. CONTEXT defaults WINDOW. NATIVE :AUTO upgrades in eligible primary macOS contexts, NIL always draws, T requires an eligible native context. Commands remain application-owned. Native labels/enabled/shortcuts update each frame; supported equivalents replace drawn bindings." "Window-owned COMMAND-MENU. Dispose removes native/drawn UI and bindings; context-close restores prior native menu." "(lut:install-command-menu window (list (list :label \"File\" :commands (list command :separator command))))")
   (lut:command-menu-backend "MENU is a command menu handle. Context-sensitive; native integration requires active primary macOS context. Workers retain drawn fallback." ":DRAWN or :NATIVE." "(lut:command-menu-backend menu)")
   (lut:command-menu-bar "MENU is a command menu. Its ordinary MENU-BAR child participates in application layout and is hidden while native." "Fallback menu-bar, or NIL after disposal." "(lut:command-menu-bar menu)")
   (lut:refresh-command-menu "MENU is live. Re-evaluate labels, enabled state, predicate and shortcut data. Auto installation waits for a native context. Group definitions remain fixed." "MENU." "(lut:refresh-command-menu menu)")
   (lut:request-path "WINDOW live, CALLBACK(path-or-NIL), KIND :FILE/:FOLDER/:SAVE, existing DIRECTORY, optional FILENAME and TITLE. NATIVE :AUTO/T/NIL matches command menus. Primary macOS panels are synchronous; portable dialogs complete later. FILE/FOLDER require existing paths; SAVE returns a filename in an existing directory. No file creation, write or persistence policy." "PATH-REQUEST; callback may run before return for native panels. Invalid portable input shows in-dialog feedback and remains pending; application callback errors propagate after committed completion." "(lut:request-path window #'print :kind :save :filename \"untitled.txt\")")
   (lut:path-request-state "REQUEST is a path-request handle. Completion/cancellation commits before invoking the callback. Window/request disposal cancels pending work silently." ":PENDING/:ACCEPTED/:CANCELLED." "(lut:path-request-state request)")
   (lut:path-request-result "REQUEST is a path-request handle. FILE/FOLDER results canonical; SAVE result is a path only, never a written file. Cleared on disposal." "Pathname or NIL." "(lut:path-request-result request)")
   (lut:path-request-dialog "REQUEST is a path-request handle. Native requests are synchronous and expose no portable widget." "Active portable dialog or NIL." "(lut:path-request-dialog request)")
   (lut:cancel-path-request "REQUEST is a pending portable request; completed requests are unchanged. Dismisses/disposes UI, clears owner/callback references, then calls callback once with NIL. Native panels complete synchronously; no async native cancellation API." "REQUEST." "(lut:cancel-path-request request)")
   (lut:platform-capabilities "WINDOW is a root. Returns fresh audit plists with :NAME and :STATUS. Native menus/pickers are eligible-primary-context capabilities; text shaping/bidi/IME composition/accessibility remain unsupported; Linux/Windows native checks unverified. See docs/platform-integration.md for backend strategies and verification limits." "Fresh list of audit records." "(lut:platform-capabilities (lut:make-widget 'lut:window))")
   (lut:platform-capability "WINDOW is a root, NAME a capability keyword. Does not equate committed text input with IME composition support." "Copied audit record or NIL." "(lut:platform-capability (lut:make-widget 'lut:window) :ime-composition)")
   (lut:begin-ui-scissor "Raylib backend only, active drawing context. X/Y/WIDTH/HEIGHT are logical UI units; converts using active root scale, rounding outward. Application drawing callbacks inherit that scale." "Begins native scissor; pair with RL:END-SCISSOR-MODE." "(lut:begin-ui-scissor 10 20 100 40)")
   (lut:with-ui-scissor "Raylib backend only, active drawing context. Rectangle is logical. Ensures native scissor ends on unwind; caller must restore an outer scissor when nesting, as with raylib scopes." "BODY values." "(lut:with-ui-scissor (10 20 100 40) (lut:render widget))")))
(defparameter *data-contracts*
 '((lut:make-function-model "COUNT is an integer or zero-argument function; ITEM and KEY map visible index to item/key; INDEX optionally maps key to index. Keys must be unique, non-NIL and stable under EQUAL. No row materialization; caller publishes external changes." "Application-owned DATA-MODEL." "(lut:make-function-model :count 1000000 :item #'princ-to-string)")
   (lut:make-vector-model "ITEMS is a sequence; KEY maps each item to an immutable unique non-NIL EQUAL key. Copies sequence structure, not items; validates duplicates before construction." "Application-owned DATA-MODEL." "(lut:make-vector-model '(a b c))")
   (lut:replace-model-items "MODEL is a live vector model. Validate replacement sequence before committing; preserve selection by stable key; emit :MODEL-CHANGE after commit. Reentrant mutation is rejected." "MODEL; invalid keys leave previous data intact." "(lut:replace-model-items (lut:make-vector-model '(a)) '(b c))")
   (lut:model-count "MODEL is live. Return the number of visible rows without formatting row data." "Nonnegative integer." "(lut:model-count (lut:make-vector-model '(a b)))")
   (lut:model-item "MODEL is live; INDEX is a valid visible zero-based index. Returns original application object, not a copy." "Application item; invalid index signals." "(lut:model-item (lut:make-vector-model '(a b)) 0)")
   (lut:model-key "MODEL is live; INDEX is a valid visible index. Key is immutable, unique, non-NIL and stable across reorderings." "Original key object." "(lut:model-key (lut:make-vector-model '(a b)) 0)")
   (lut:model-index "MODEL is live; KEY is an EQUAL stable identity. Function models scan keys unless an INDEX callback is supplied." "Visible zero-based index, including 0, or NIL for hidden/missing keys." "(lut:model-index (lut:make-vector-model '(a b)) 'b)")
   (lut:model-contains-key-p "MODEL is live. Includes keys hidden by filtering or tree collapse; use MODEL-INDEX for visible membership." "Generalized boolean." "(lut:model-contains-key-p (lut:make-vector-model '(a)) 'a)")
   (lut:model-revision "MODEL is a data model. Independent monotonically increasing generation after explicit notifications/committed updates." "Nonnegative integer." "(lut:model-revision (lut:make-vector-model nil))")
   (lut:notify-model-change "MODEL is live. Call after application-owned content changes; caller must preserve key uniqueness/identity. Reentrant notifications/mutations rejected. Observer errors propagate after commit." "MODEL; emits :MODEL-CHANGE with new revision." "(lut:notify-model-change (lut:make-vector-model '(a)))")
   (lut:make-projection-model "SOURCE is live. PREDICATE receives item; LESSP compares two items. Callbacks are pure. Filtering is O(n), sorting stable O(n log n), O(n) index storage. Owns neither source nor items." "Sorted/filtered DATA-MODEL retaining original keys/items." "(lut:make-projection-model (lut:make-vector-model '(3 1 2)) :lessp #'<)")
   (lut:set-model-query "MODEL is a projection. Omitted callbacks remain; NIL disables filtering/sorting. Explicit query errors leave previous snapshot intact. A failed automatic source refresh disposes the projection to prevent stale index use." "MODEL; publishes :MODEL-CHANGE." "(lut:set-model-query (lut:make-projection-model (lut:make-vector-model '(1 2))) :predicate #'oddp)")
   (lut:make-tree-model "ROOTS is a finite sequence. KEY maps item to stable key; CHILDREN maps item to finite child sequence. Validates all keys including collapsed nodes. Initially collapsed; O(all nodes) metadata, no row widgets." "Application-owned tree DATA-MODEL." "(lut:make-tree-model '(a) :children (constantly nil))")
   (lut:replace-tree-roots "MODEL is a tree. ROOTS is a replacement finite sequence, validated transactionally. Surviving expansion and selection keys remain." "MODEL; emits :MODEL-CHANGE." "(lut:replace-tree-roots (lut:make-tree-model '(a) :children (constantly nil)) '(b))")
   (lut:set-tree-expanded "MODEL is a live tree. KEY exists in the whole tree; EXPANDED is interpreted as boolean. Rebuilds visible row metadata; collapsed selections remain valid." "MODEL; emits :MODEL-CHANGE." "(lut:set-tree-expanded (lut:make-tree-model '(a) :children (constantly nil)) 'a t)")
   (lut:tree-expanded-p "MODEL is a tree; KEY is an application identity." "Boolean." "(lut:tree-expanded-p (lut:make-tree-model '(a) :children (constantly nil)) 'a)")
   (lut:model-depth "MODEL is live, INDEX visible. Tree rows supply depth; ordinary rows return 0; projections forward source depth." "Nonnegative integer." "(lut:model-depth (lut:make-vector-model '(a)) 0)")
   (lut:model-branch-p "MODEL is live, INDEX visible. Whether row has children, including when collapsed." "Boolean." "(lut:model-branch-p (lut:make-vector-model '(a)) 0)")
   (lut:make-selection-model "MODEL is live, MODE is :NONE/:SINGLE/:MULTIPLE. Selection is independent of widgets; tracks stable keys and prunes deleted keys while retaining hidden ones." "Application-owned SELECTION-MODEL." "(lut:make-selection-model (lut:make-vector-model '(a b)) :mode :multiple)")
   (lut:selected-keys "SELECTION is a selection model. Returned list is copied; immutable application key objects retain identity." "Fresh list of selected visible/hidden keys." "(lut:selected-keys (lut:make-selection-model (lut:make-vector-model '(a))))")
   (lut:selection-focus "SELECTION is a selection model. Focus may be temporarily hidden by filtering/collapse." "Stable focused key or NIL." "(lut:selection-focus (lut:make-selection-model (lut:make-vector-model '(a))))")
   (lut:selection-anchor "SELECTION is a selection model. Range anchor retains identity through reordering." "Stable key or NIL." "(lut:selection-anchor (lut:make-selection-model (lut:make-vector-model '(a))))")
   (lut:selection-contains-p "SELECTION is a selection model; KEY compared under EQUAL." "Boolean." "(lut:selection-contains-p (lut:make-selection-model (lut:make-vector-model '(a))) 'a)")
   (lut:select-model-index "SELECTION is live, INDEX visible. EXTEND selects anchored range; TOGGLE adds/removes a row; both add the range. Only :MULTIPLE honors these flags. Range materialization O(range)." "SELECTION; emits :SELECTION-CHANGE for changed keys/focus/anchor." "(lut:select-model-index (lut:make-selection-model (lut:make-vector-model '(a b))) 1)")
   (lut:clear-model-selection "SELECTION is live. Clear keys, focus and anchor. No event if already clear." "SELECTION." "(lut:clear-model-selection (lut:make-selection-model (lut:make-vector-model '(a))))")
   (lut:handle-selection-event "SELECTION is live, EVENT normalized. Pointer :DOWN uses supplied INDEX; keyboard Up/Down/Home/End uses current visible order. Shift extends, Ctrl/Cmd toggles. Independent of views." "Handled-p." "(lut:handle-selection-event (lut:make-selection-model (lut:make-vector-model '(a))) (lut:make-event :kind :key :key :end))")
   (lut:view-model "VIEW is a model-backed list/tree/table. Model binding is fixed at construction with :MODEL; model remains application-owned." "DATA-MODEL, or NIL after source/view disposal." "(lut:view-model (lut:make-widget 'lut:model-list-view :model (lut:make-vector-model '(a))))")
   (lut:view-selection "VIEW is model-backed. Optional :SELECTION must use the same model. Views own a default selection; supplied selections remain application-owned." "SELECTION-MODEL or NIL after view disposal." "(lut:view-selection (lut:make-widget 'lut:model-list-view :model (lut:make-vector-model '(a))))")
   (lut:row-label-function "VIEW is model-backed. Function designator maps an application item to its display string on demand. May be assigned with SETF." "Function designator." "(lut:row-label-function (lut:make-widget 'lut:model-list-view :model (lut:make-vector-model '(a))))")
   (lut:visible-model-range "VIEW is model-backed; fixed :ROW-HEIGHT. Clamps scroll offset. Missing/disposed model or zero-height viewport yields 0,0." "Two half-open visible indices including partial rows." "(lut:visible-model-range (lut:make-widget 'lut:model-list-view :model (lut:make-vector-model '(a))))")
   (lut:map-visible-model-rows "VIEW is model-backed. FUNCTION receives INDEX KEY ITEM X Y WIDTH HEIGHT for visible rows only, without building row widgets/ITEMS strings." "Visited row count." "(lut:map-visible-model-rows (lut:make-widget 'lut:model-list-view :model (lut:make-vector-model '(a))) (lambda (&rest row) row))")
   (lut:reveal-model-index "VIEW is model-backed. INDEX is valid and visible in its model. Scrolls without selecting." "VIEW." "(lut:reveal-model-index (lut:make-widget 'lut:model-list-view :model (lut:make-vector-model '(a))) 0)")
   (lut:make-data-column "Non-NIL ID, string TITLE, GETTER(item), FORMATTER(value); optional CELL-FACTORY(item,value) returns string or :TEXT/:FOREGROUND/:BACKGROUND plist. SETTER(item,text) enables editing. EDITOR-FACTORY(view,key,column,value) returns unparented entry. Treat definitions as immutable." "Shared DATA-COLUMN description." "(lut:make-data-column :id :name :title \"Name\" :getter #'identity)")
   (lut:data-column-title "COLUMN is a data column. Treat the returned title as immutable." "Title string." "(lut:data-column-title (lut:make-data-column :id :name :title \"Name\"))")
   (lut:data-column-id "COLUMN is a data column. Immutable application identity used in edit events." "Original column ID." "(lut:data-column-id (lut:make-data-column :id :name))")
   (lut:table-columns "VIEW is a model table, constructed with a nonempty :TABLE-COLUMNS list. Treat list/column definitions as immutable." "Column definitions." "(lut:table-columns table)")
   (lut:active-column "VIEW is a model table. SETF requires a valid zero-based column index; Left/Right and pointer input navigate." "Column index." "(lut:active-column table)")
   (lut:cell-presentation "VIEW is a model table; INDEX and COLUMN-INDEX valid. Invokes getter/formatter or cell factory only for requested cell." "Fresh presentation plist with string :TEXT and optional colors." "(lut:cell-presentation table 0 0)")
   (lut:cell-editor "VIEW is a model table. A view creates at most one entry editor, regardless of model size." "Active entry or NIL." "(lut:cell-editor table)")
   (lut:begin-cell-edit "VIEW is a live model table. Defaults to focused row and active column. Columns without a setter are read-only. Editor factory must return live unparented entry. Emits :CELL-EDIT-START." "Entry, or NIL when unavailable/read-only." "(lut:begin-cell-edit table)")
   (lut:commit-cell-edit "VIEW is a live model table. Setter validates/applies original item and entry text. Errors leave editor open; no rollback of application mutations. Closes editor, notifies underlying source (refreshing projections), emits :CELL-EDIT-COMMIT." "Committed-p." "(lut:commit-cell-edit table)")
   (lut:cancel-cell-edit "VIEW is a model table. Closes/disposes editor without setter; reason defaults :CANCEL. Restores table focus when appropriate, emits :CELL-EDIT-CANCEL. Idempotent." "Cancelled-p." "(lut:cancel-cell-edit table)")))
(defparameter *contracts*
 '(
   (lut:set-text-presentation "VIEW is a live styled/document view. Supplied RUNS/DECORATIONS/LINKS/IMAGES replace those collections; omitted collections remain. Records are copied and validated transactionally. Runs/links are disjoint half-open character intervals; decorations may overlap and use :UNDERLINE/:BACKGROUND/:GUTTER/:ANNOTATION. Images/links require DOCUMENT-VIEW. Images occupy U+FFFC at :POSITION with :SOURCE and positive :WIDTH/:HEIGHT (height <= line-height). See docs/text-presentation.md for schemas and edit remapping." "VIEW; emits :PRESENTATION-CHANGE after commit." "(lut:set-text-presentation (lut:make-widget 'lut:styled-text-view :text \"abc\") :runs '((:start 0 :end 3 :style (:foreground :red))))")
   (lut:invalidate-text-presentation "VIEW is live and styled. Increments presentation generation and clears line metrics/preferred navigation X after external font/presentation state changes. Does not edit content or history." "New revision; emits :PRESENTATION-CHANGE." "(lut:invalidate-text-presentation (lut:make-widget 'lut:styled-text-view))")
   (lut:text-presentation-revision "VIEW is a styled/document view. Presentation generation is independent of shared buffer/content revision. Explicit invalidation and automatic edit remapping advance it." "Nonnegative integer." "(lut:text-presentation-revision (lut:make-widget 'lut:styled-text-view))")
   (lut:text-runs "VIEW is a styled/document view. Returns copied records (:START :END :STYLE). Supported overrides: :FONT, :FONT-SIZE, :FOREGROUND, :BACKGROUND. Ranges are disjoint; use SET-TEXT-PRESENTATION to replace." "Fresh list of run plists." "(lut:text-runs (lut:make-widget 'lut:styled-text-view))")
   (lut:text-decorations "VIEW is a styled/document view. Returns copied (:START :END :KIND :COLOR :TEXT) records; intervals may overlap, and points may be empty. Opaque application values retain identity." "Fresh list of decoration plists." "(lut:text-decorations (lut:make-widget 'lut:styled-text-view))")
   (lut:text-style-at "VIEW is styled; POSITION is a valid model/display character position including EOF. Returns run overrides and default accent foreground for a link. Display transforms must preserve indices. This does not infer syntax or code." "Copied override plist." "(lut:text-style-at (lut:make-widget 'lut:styled-text-view :text \"abc\") 0)")
   (lut:document-links "VIEW is a document view. Returns copied (:START :END :TARGET) records; opaque targets keep identity. Activation emits :LINK, with application-owned routing." "Fresh list of link plists." "(lut:document-links (lut:make-widget 'lut:document-view))")
   (lut:document-images "VIEW is a document view. Returns copied (:POSITION :SOURCE :WIDTH :HEIGHT :ALT) records. Images occupy one U+FFFC character; plaintext selection retains that character. Sources use the backend file image cache." "Fresh list of image plists." "(lut:document-images (lut:make-widget 'lut:document-view))")
   (lut:document-hit-test "VIEW is a document view. PX/PY are root pixels. Uses the same style/image advances as drawing. Links hit their text cells, images their explicit centered pixel rectangle; gutter/outside content returns NIL." "Two values: :IMAGE/:LINK and copied record, or :TEXT and character index; NIL if outside." "(lut:document-hit-test (lut:make-widget 'lut:document-view :text \"abc\") 10 10)")
   (lut:show-anchored-surface "OWNER is live in the active input scope; SURFACE is an unparented anchored/suggestion surface. RECTANGLE is optional root (X Y W H); otherwise entries follow their caret, other owners their bounds. Clamps/flips in the current window, keeps owner focus and follows geometry each frame. Application candidates/help content remain external data." "SURFACE. A shown surface may be reanchored; dismissal happens first." "(let* ((w (lut:make-widget 'lut:window)) (e (lut:add-child w (lut:make-widget 'lut:entry)))) (lut:show-anchored-surface e (lut:make-widget 'lut:suggestion-surface :items '(\"One\" \"Two\"))))")
   (lut:dismiss-anchored-surface "SURFACE is anchored. Removes it and releases owner/input-scope/pointer references, restoring owner focus if focus was inside help content. REASON defaults :DISMISS. Candidates/content stay available for reuse. Owner disposal also disposes its shown surface." "SURFACE. Idempotent; explicit dismissal emits :DISMISS once per shown session. Disposal clears quietly." "(lut:dismiss-anchored-surface (lut:make-widget 'lut:anchored-surface))")
   (lut:accept-suggestion "SURFACE is a shown suggestion surface. INDEX defaults to VALUE and must identify a candidate. Dismisses before emitting :ACCEPT with the original item; unavailable/empty returns NIL. No automatic insertion, ranking or language lookup." "Accepted-p." "(lut:accept-suggestion (lut:make-widget 'lut:suggestion-surface))")
   (lut:text-length "TARGET is a string, label/view or text buffer. Counts Common Lisp characters; shared buffers do not flatten." "Nonnegative character count." "(lut:text-length (lut:make-text-buffer :text \"abc\"))")
   (lut:text-range "TARGET is a string, label/view or text buffer. 0 <= START <= END <= length. END defaults to length. Copies only the requested range from indexed storage." "Fresh string." "(lut:text-range (lut:make-text-buffer :text \"abc\") 1 3)")
   (lut:text-line-count "TARGET is a string, label/view or text buffer. Newline delimits logical lines. Empty text has one line; trailing newline adds an empty line." "Positive integer." "(lut:text-line-count (lut:make-text-buffer))")
   (lut:text-line-range "TARGET is a string, label/view or text buffer; LINE is a valid zero-based logical line. Excludes the newline. Invalid indices signal ERROR." "Two character indices: START and exclusive END." "(lut:text-line-range (lut:make-text-buffer :text \"abc\") 0)")
   (lut:text-position-line "TARGET is a string, label/view or text buffer; POSITION is a character insertion index including EOF. A newline position belongs to its preceding line." "Zero-based logical line." "(lut:text-position-line (lut:make-text-buffer :text \"abc\") 3)")
   (lut:text-position-rectangle "VIEW is an entry/text view. POSITION indexes DISPLAY-TEXT, including EOF. Geometry uses unwrapped character advances, effective styles, allocation and independent pixel scroll offsets. No shaping/bidi/grapheme support." "Four values: root X, Y, styled caret width, line height." "(lut:text-position-rectangle (lut:make-widget 'lut:text-view :text \"abc\") 1)")
   (lut:text-point-position "VIEW is an entry/text view. PX/PY are root pixel coordinates. Returns nearest insertion position using character midpoints; clamps to first/last logical line and line bounds. DISPLAY-TEXT overrides should preserve character indexing." "Display character index." "(lut:text-point-position (lut:make-widget 'lut:text-view :text \"abc\") 8 8)")
   (lut:invalidate-text-geometry "VIEW is a live label/entry/text view. Standard text/font/style changes invalidate automatically. Call after changing external state used by custom text measurement methods." "VIEW, after clearing measured line caches." "(lut:invalidate-text-geometry (lut:make-widget 'lut:text-view))")
   (lut:map-visible-text-lines "VIEW is a label/entry/text view. FUNCTION receives LINE START END X Y for each vertically intersecting logical line; END excludes newline, coordinates are root pixels. No text copies; return values of FUNCTION ignored. Do not edit/rebind/dispose the view during iteration." "Number of visited lines." "(lut:map-visible-text-lines (lut:make-widget 'lut:text-view :text \"abc\") (lambda (line start end x y) (list line start end x y)))")
   (lut:text-word-range "TARGET is a string, label/view or buffer; POSITION is a valid character index including EOF. Returns the containing raw-text run: alphanumeric/underscore, space/tab/newline/return/page, or punctuation. EOF uses the preceding character; empty text gives 0/0. This is not Unicode word breaking or language syntax." "Two indices: START and exclusive END." "(lut:text-word-range (lut:make-text-buffer :text \"alpha_beta!\") 2)")
   (lut:select-word "VIEW is a live entry/text view. Optional POSITION defaults to its cursor and must index DISPLAY-TEXT. Selects the containing character run with anchor at start and caret at end, then reveals the caret. Read-only views permit selection; display overrides should preserve indices." "VIEW." "(lut:select-word (lut:make-widget 'lut:text-view :text \"alpha beta\") 2)")
   (lut:select-line "VIEW is a live entry/text view. Optional POSITION defaults to cursor and must index DISPLAY-TEXT. Selects the logical line including its terminating newline; final empty lines select an empty range. Reveals the caret; read-only views permit selection." "VIEW." "(lut:select-line (lut:make-widget 'lut:text-view :text \"alpha\") 2)")
   (lut:move-text-cursor "VIEW is a live entry/text view. MOVEMENT is :LEFT/:RIGHT/:WORD-LEFT/:WORD-RIGHT/:LINE-START/:LINE-END/:DOCUMENT-START/:DOCUMENT-END/:UP/:DOWN. EXTEND preserves the anchor; otherwise the caret and anchor collapse together. Left/right (including word movement) collapse existing selections to the corresponding edge. Vertical moves retain a preferred pixel X across short lines; other moves/manual cursor assignment reset it. Uses shared display geometry and reveals the caret." "New character position." "(lut:move-text-cursor (lut:make-widget 'lut:text-view :text \"alpha beta\") :word-right :extend t)")
   (lut:reveal-text-cursor "VIEW is a live entry/text view. Adjusts its own horizontal/vertical offsets to include the caret rectangle. VERTICAL defaults T; NIL preserves vertical scroll. Selection and content are unchanged. Uses unwrapped display geometry, padding, caret width and allocation." "VIEW." "(lut:reveal-text-cursor (lut:make-widget 'lut:text-view :text \"alpha\" :cursor 5))")
   (lut:advance-text-selection "WINDOW is a root; SECONDS is nonnegative elapsed time. Native/controller frames call this automatically. Advances captured selection autoscroll outside content edges with bounded speed and a 0.1-second maximum step, then hit-tests using shared geometry. Stationary pointers keep scrolling. Zero time does not scroll. Invalid/hidden/disabled/modal-blocked captures cancel." "True if offsets changed, otherwise NIL." "(lut:advance-text-selection (lut:make-widget 'lut:window) 0.016)")
   (lut:cancel-text-selection "WINDOW is a root. Clears its text-selection gesture/capture without changing the selected range. FORGET-CLICKS also clears repeated-click metadata. Idempotent; independent drag-and-drop capture is preserved." "True if a text-selection gesture existed, otherwise NIL." "(lut:cancel-text-selection (lut:make-widget 'lut:window) :forget-clicks t)")
   (lut:make-text-buffer "TEXT is a string; READ-ONLY-P controls editing APIs, not programmatic SETF TEXT. History limits bound shared range records; the character budget counts removed plus inserted text, not full-buffer size. Keep this nonvisual model outside the visual child tree." "A shared TEXT-BUFFER." "(lut:make-text-buffer :text \"Shared text\" :history-limit 100)")
   (lut:buffer-revision "BUFFER is a text buffer. Revision increases once per effective content edit, including undo/redo and SETF TEXT; no-op edits do not increment it." "Nonnegative integer." "(lut:buffer-revision (lut:make-text-buffer))")
   (lut:editable-p "TARGET is an entry/text view or text buffer. Requires a live target, a false local READ-ONLY-P, and (for shared views) a live writable buffer. Enabled/visible UI policy is separate." "Boolean." "(lut:editable-p (lut:make-widget 'lut:text-view :read-only-p t))")
   (lut:can-undo-p "TARGET is an entry/view or text buffer. Reports available history and effective read-only policy. Shared views use model history." "Boolean." "(lut:can-undo-p (lut:make-text-buffer))")
   (lut:can-redo-p "TARGET is an entry/view or text buffer. Reports available redo history and effective read-only policy." "Boolean." "(lut:can-redo-p (lut:make-text-buffer))")
   (lut:replace-buffer-range "BUFFER is live. START/END are character indices with 0 <= START <= END <= text length; STRING replaces [START,END). Optional ORIGIN is a live attached view whose caret collapses after inserted text. Other view positions remap; notification callbacks must not reedit the same model synchronously. Read-only returns NIL without changing text/history." "BUFFER-EDIT for an effective change, NIL for a no-op/read-only refusal. Errors propagate after committed edits remain synchronized." "(let ((b (lut:make-text-buffer :text \"abc\"))) (lut:replace-buffer-range b 1 2 \"X\"))")
   (lut:edit-start "EDIT is a BUFFER-EDIT notification record. Retaining a record with a non-NIL origin intentionally retains that view." "Start character index." "(lut:edit-start edit)")
