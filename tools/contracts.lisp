(defpackage #:lui-docs (:use #:cl) (:export #:generate))
(in-package #:lui-docs)
(defparameter *contracts*
 '((lui:display-text "WIDGET is a label or entry. Returns the visible string, which can differ from TEXT for masked/formatted widgets. Override this generic to preserve common selection and rendering." "A string with compatible character boundaries." "(lui:display-text (lui:make-widget 'lui:entry :text \"Visible\"))")
   (lui:bind-key "WINDOW is a root; KEY is a normalized keyword such as :CONTROL-S or :F1; FUNCTION takes no arguments. Modal dialogs suspend root actions. OWNER optionally disconnects the shortcut on disposal." "Callback and connection handle, as for ON." "(let ((w (lui:make-widget 'lui:window))) (lui:bind-key w :control-s (lambda () (print :save)) :owner w))")
   (lui:undo "ENTRY is an entry/text-view. Restores the prior text and selection, bounded by HISTORY-LIMIT and HISTORY-CHARACTER-LIMIT, and emits :CHANGE." "True if an edit was restored, NIL if history is empty." "(let ((e (lui:make-widget 'lui:entry :text \"before\"))) (setf (lui:text e) \"after\") (lui:undo e))")
   (lui:redo "ENTRY is an entry/text-view. Reapplies a previously undone edit and emits :CHANGE. A new edit clears redo history." "True when changed, NIL when empty." "(let ((e (lui:make-widget 'lui:entry))) (lui:replace-selection e \"edit\") (lui:undo e) (lui:redo e))")
   (lui:disposed-p "WIDGET is a widget. Reports whether DISPOSE has destroyed it. The managed setter rejects state changes; use DISPOSE, not SETF, and never revive a disposed tree." "Boolean." "(let ((w (lui:make-widget 'lui:widget))) (lui:dispose w) (lui:disposed-p w))")
   (lui:dispose "WIDGET is a widget subtree. Idempotently destroys it, detaches ownership, clears focus/capture, connections, callbacks, standard model data and owned queued work. Cannot be revived. Define DISPOSE :BEFORE/:AFTER methods for custom resources; invoke on the GUI thread while running." "WIDGET. Cleanup runs even if a subclass disposal method signals." "(let* ((w (lui:make-widget 'lui:box)) (child (lui:add-child w (lui:make-widget 'lui:entry)))) (lui:dispose child) (lui:disposed-p child))")
   (lui:off "WIDGET is an event source. EVENT and CALLBACK are optional; NIL matches all. Disconnects every matching connection, including owner-side bookkeeping and callback references." "Number of removed connections." "(let ((b (lui:make-widget 'lui:button))) (lui:on b :activate (lambda (w p) (declare (ignore w p)))) (lui:off b :activate))")
   (lui:disconnect "CONNECTION is ON's second return value. Idempotently removes both source and owner registrations, marks it inactive and clears callback/source/owner references. Skipped if disconnected during an emission." "CONNECTION." "(let* ((w (lui:make-widget 'lui:button)) (c (nth-value 1 (lui:on w :activate (lambda (w p) (declare (ignore w p))))))) (lui:disconnect c))")
   (lui:on-widget "WIDGET is a live owner. BODY is queued as a closure like ON-UI, but pending work is automatically cancelled and released when the owner is disposed." "The closure and a cancellable job handle as two values." "(let ((w (lui:make-widget 'lui:label))) (lui:on-widget w (setf (lui:text w) \"Updated\")) (lui:dispose w))")
   (lui:cancel-ui "HANDLE is ENQUEUE-UI/ON-UI/ON-WIDGET's second value, or a queued function object. Cancels matching pending jobs and releases function/owner references. Already executing work finishes normally." "Number of cancelled jobs." "(let ((job (nth-value 1 (lui:enqueue-ui (lambda () :unused))))) (lui:cancel-ui job))")
   (lui:dismiss-dialog "DIALOG is a dialog with its current ownership intact. Removes an in-window modal overlay or closes its detached native host. Prefer this over capturing the original root in response callbacks." "DIALOG; native closure is asynchronous." "(let* ((w (lui:make-widget 'lui:window)) (d (lui:make-widget 'lui:dialog))) (lui:show-dialog w d) (lui:dismiss-dialog d))")
   (lui:make-widget "CLASS is a widget class symbol; INITARGS are the documented keyword initargs for that class. Invalid types signal TYPE-ERROR; inconsistent numeric bounds signal ERROR." "A new widget." "(lui:make-widget 'lui:button :text \"Hello\")")
   (lui:with-ui "CLASS is an unevaluated class name. INITARGS are evaluated once. Each BODY form must return a widget, adopted in order." "The constructed container." "(lui:with-ui (lui:box :spacing 4) (lui:make-widget 'lui:label :text \"Hi\"))")
   (lui:defwidget "NAME is a class symbol; SUPERS a list of widget superclasses; DOCUMENTATION a string. SLOTS are (name initform type documentation) lists. Initargs use matching keywords. SETF validates before assignment. Re-evaluation uses standard CLOS class redefinition." "The class name." "(lui:defwidget counter-label (lui:label) \"Live counter.\" ((tally 0 (integer 0 *) \"Non-negative count.\")))")
   (lui:add-child "CONTAINER and CHILD are widgets. Reparents CHILD. Rejects cycles and disposed nodes before changing ownership." "CHILD." "(let ((box (lui:make-widget 'lui:box))) (lui:add-child box (lui:make-widget 'lui:button)))")
   (lui:remove-child "CONTAINER and CHILD are widgets. No-op if not owned by CONTAINER. Clears focus, capture and drag references. :DISPOSE T destroys the subtree; default NIL keeps it reusable." "CHILD." "(let* ((box (lui:make-widget 'lui:box)) (child (lui:add-child box (lui:make-widget 'lui:label)))) (lui:remove-child box child))")
   (lui:walk-widgets "ROOT is a widget. FUNCTION takes one widget. Visits root, children and window overlays in preorder; avoid structural mutation during traversal." "Unspecified." "(lui:walk-widgets (lui:make-widget 'lui:window) (lambda (node) (print (class-of node))))")
   (lui:find-widget "ROOT is a widget; ID is a string, symbol or NIL compared with EQUAL. Prefer unique non-NIL identifiers." "First matching widget or NIL." "(let ((w (lui:with-ui (lui:box) (lui:make-widget 'lui:entry :id :name)))) (lui:find-widget w :name))")
   (lui:on "WIDGET is a widget; EVENT is :ACTIVATE, :CHANGE, :TICK, :CONTEXT or an application keyword. CALLBACK is a function or symbol taking (widget payload); registrations are additive and ordered. OWNER optionally is a widget whose disposal disconnects this binding. Use an owner for callbacks capturing transient controls." "CALLBACK and a CONNECTION handle as a second value." "(lui:on (lui:make-widget 'lui:button) :activate (lambda (widget payload) (declare (ignore widget payload)) (print :clicked)))")
   (lui:emit "WIDGET is a widget; EVENT a keyword; PAYLOAD defaults to NIL. Calls handlers synchronously in registration order. Handler errors propagate." "Unspecified." "(let ((b (lui:make-widget 'lui:button))) (lui:on b :activate (lambda (w p) (declare (ignore w p)) :ok)) (lui:emit b :activate))")
   (lui:layout "WIDGET is a widget; X/Y are real coordinates; WIDTH/HEIGHT non-negative pixel extents. Updates allocation and lays out container children. Override methods for custom layout." "WIDGET." "(lui:layout (lui:make-widget 'lui:box) 0 0 640 480)")
   (lui:hit-test "WIDGET is a widget; PX/PY real root coordinates. Excludes hidden, disabled, inactive and clipped descendants." "Deepest eligible widget, or NIL." "(let ((b (lui:make-widget 'lui:button))) (lui:hit-test b 10 10))")
   (lui:focus "WINDOW is the owning root; WIDGET is an enabled visible focusable descendant or NIL. Invalid targets signal ERROR." "The new focused widget or NIL." "(let* ((w (lui:make-widget 'lui:window)) (e (lui:add-child w (lui:make-widget 'lui:entry)))) (lui:focus w e))")
   (lui:make-event "KIND is :DOWN/:MOVE/:UP/:WHEEL/:KEY/:TEXT/:CONTEXT/:GESTURE. X/Y/DELTA real; KEY a keyword or NIL; TEXT string; SHIFT-P boolean. Defaults: coordinates/delta 0, text empty, key/shift NIL." "A normalized event." "(lui:make-event :kind :text :text \"Ελληνικά\")")
   (lui:dispatch "WINDOW is a root window; EVENT a MAKE-EVENT value. Dispatches modal input, gestures, context menus and keyboard edits. Use ON-UI from another thread." "Target widget or NIL; handlers may return other values." "(lui:dispatch (lui:make-widget 'lui:window) (lui:make-event :kind :key :key :tab))")
   (lui:handle-event "WIDGET is an extension receiver; EVENT a normalized event. Define a specialized method and return non-NIL to consume before default dispatch." "True if consumed, NIL otherwise." "(lui:handle-event (lui:make-widget 'lui:spin-button) (lui:make-event :kind :key :key :up))")
   (lui:selection "ENTRY is an entry or text-view. Indices are zero-based character boundaries, not UTF-8 bytes." "Two values: sorted start and end indices." "(let ((e (lui:make-widget 'lui:entry :text \"abc\"))) (lui:select-all e) (lui:selection e))")
   (lui:select-all "ENTRY is an entry/text-view; selects 0 through text length." "ENTRY." "(lui:select-all (lui:make-widget 'lui:entry :text \"Hello\"))")
   (lui:selected-text "ENTRY is an entry/text-view; an empty selection returns an empty string." "Selected substring." "(let ((e (lui:make-widget 'lui:entry :text \"abc\"))) (lui:select-all e) (lui:selected-text e))")
   (lui:replace-selection "ENTRY is editable; STRING replaces the selected range, collapses the selection at its end and emits :CHANGE with all resulting text." "Unspecified." "(let ((e (lui:make-widget 'lui:entry))) (lui:replace-selection e \"Hello\"))")
   (lui:clipboard-text "WIDGET identifies backend context. Core uses an in-memory clipboard; raylib entries use the OS clipboard, requiring an active native window. SETF accepts a string." "Clipboard string." "(let ((w (lui:make-widget 'lui:widget))) (setf (lui:clipboard-text w) \"Copied\") (lui:clipboard-text w))")
   (lui:style-value "WIDGET is a widget; KEY a style token keyword; DEFAULT used only when no style/theme/default token exists. Local state/base styles precede ancestor overrides, root class/state rules, root theme and defaults." "Resolved token, including explicit NIL." "(lui:style-value (lui:make-widget 'lui:entry :style '(:font-size 24)) :font-size)")
   (lui:widget-state "WIDGET is a widget. Priority is inherited disabled, pressed, hover, focused, normal." ":DISABLED/:PRESSED/:HOVER/:FOCUS/:NORMAL." "(lui:widget-state (lui:make-widget 'lui:button :enabled-p nil))")
   (lui:row-height "WIDGET has styles; :ROW-HEIGHT must be a positive real pixel extent." "Positive real." "(lui:row-height (lui:make-widget 'lui:list-view))")
   (lui:line-height "WIDGET has styles; :LINE-HEIGHT must be a positive real pixel extent." "Positive real." "(lui:line-height (lui:make-widget 'lui:text-view))")
   (lui:text-width "WIDGET selects the font backend; STRING is measured as a complete string. Core estimates; raylib label methods use MeasureTextEx and a loaded font in an active window." "Non-negative pixel width." "(lui:text-width (lui:make-widget 'lui:widget) \"Hello\")")
   (lui:range-fraction "CONTROL is a slider/progress/spin control. Bounds enclose VALUE. Zero-length ranges return 0; fractional ranges retain their scale." "Real in 0..1." "(lui:range-fraction (lui:make-widget 'lui:slider :maximum 0.5 :value 0.25))")
   (lui:active-children "WIDGET is a container. Stack exposes its selected child; collapsed expander exposes none; ordinary containers expose visible children." "List of widgets." "(lui:active-children (lui:make-widget 'lui:stack))")
   (lui:select-page "STACK is a stack/notebook; INDEX an integer in 0 through child-count minus one. Emits :CHANGE with INDEX; invalid indices signal ERROR." "Selected index." "(let ((s (lui:with-ui (lui:stack) (lui:make-widget 'lui:label)))) (lui:select-page s 0))")
   (lui:tree-rows "TREE is a tree-view. NODES are lists of (:TEXT string :CHILDREN nodes :OPEN boolean) property lists." "Visible (node depth) pairs." "(lui:tree-rows (lui:make-widget 'lui:tree-view :nodes '((:text \"Root\"))))")
   (lui:refresh-items "WIDGET is a tree/table or another widget. Rebuilds display items for tree/table models; other widgets are unchanged." "WIDGET." "(lui:refresh-items (lui:make-widget 'lui:table-view :columns '(\"Name\") :rows '((\"Ada\"))))")
   (lui:sort-table "TABLE is a table-view; COLUMN is a valid zero-based column index. DESCENDING boolean defaults NIL. Compares printed cells lexically, retaining equal-key order." "TABLE." "(lui:sort-table (lui:make-widget 'lui:table-view :columns '(\"Name\") :rows '((\"Z\") (\"A\"))) 0)")
   (lui:group-radios "RADIOS are radio-button instances. Mutates each GROUP to the same list; subsequent activation enforces exclusivity." "The radio list." "(lui:group-radios (lui:make-widget 'lui:radio-button) (lui:make-widget 'lui:radio-button))")
   (lui:validate-slot "WIDGET receives a proposed SLOT symbol and VALUE before SETF mutation. Methods must return normally to accept or signal to reject. Use :AROUND and CALL-NEXT-METHOD to extend invariants." "Validated value by convention." "(lui:validate-slot (lui:make-widget 'lui:slider) 'lui:value 50)")
   (lui:show-dialog "WINDOW owns DIALOG, which must currently have no parent. Pushes modal overlay and clears focus/capture. Drag empty surface/title to move; crossing root bounds detaches when enabled." "DIALOG." "(lui:show-dialog (lui:make-widget 'lui:window) (lui:make-widget 'lui:dialog :width 300 :height 180))")
   (lui:close-dialog "WINDOW is a root. Removes its top overlay and clears focus. Does not close native worker windows; use CLOSE-WINDOW for their handles." "Removed dialog or NIL." "(lui:close-dialog (lui:make-widget 'lui:window))")
   (lui:open-context-menu "WINDOW is root; TARGET is the owner; EVENT provides pointer coordinates. ACTIONS optionally lists (caption no-argument-callback enabled-p) records. Defaults to entry editing actions. Outside click/Escape dismisses." "Menu or NIL when no actions apply." "(let* ((w (lui:make-widget 'lui:window :width 600 :height 400)) (e (lui:add-child w (lui:make-widget 'lui:entry)))) (lui:open-context-menu w e (lui:make-event :kind :context :x 20 :y 20)))")
   (lui:choose-file "WINDOW is root; CALLBACK receives pathname on Choose. DIRECTORY defaults to user home and must be a directory pathname. Dialog supports explicit path, directory listing and navigation; file errors propagate." "Chooser dialog." "(lui:choose-file (lui:make-widget 'lui:window) (lambda (path) (print path)))")
   (lui:choose-color "WINDOW is root; CALLBACK receives a fresh RGBA byte list. INITIAL must have four integer channels in 0..255, default (0 0 0 255)." "Chooser dialog." "(lui:choose-color (lui:make-widget 'lui:window) (lambda (rgba) (print rgba)) :initial '(20 40 60 255))")
   (lui:choose-font "WINDOW is root; CALLBACK receives font pathname and positive integer size. INITIAL is NIL/string/pathname. Applying requires an existing file." "Chooser dialog." "(lui:choose-font (lui:make-widget 'lui:window) (lambda (path size) (print (list path size))))")
   (lui:run "WINDOW is a root window; FRAMES is NIL for interactive or a positive integer for a bounded run. Requires backend; CCL/macOS bridges to OS main thread. Errors pause interactive runs; bounded runs signal. A nested run spawns a worker." "Normal loop result, or remote-window for a secondary window." "(lui:run (lui:make-widget 'lui:window :width 640 :height 480) :frames 3)")
   (lui:start "WINDOW is root; FRAMES optional positive frame count; WAIT boolean controls binding runner wait. First launch uses the OS main-thread runner; subsequent launches spawn native workers." "Runner result or remote-window." "(lui:start (lui:make-widget 'lui:window :text \"Live\" :width 640 :height 480))")
   (lui:stop "No arguments. Requests the primary event loop stop after the current frame. Loop teardown requests closure of all worker windows, releases library-owned roots and clears pending work; application-owned primary trees remain reusable." "No meaningful value." "(lui:stop)")
   (lui:render "WIDGET is a visible node. Called inside a drawing frame with a live native context. Define per-class primary methods; the around method clips and renders active descendants." "Unspecified." "(defmethod lui:render ((w counter-label)) (call-next-method))")
   (lui:frame-step "WINDOW is the primary root; DT is elapsed seconds. Requires active raylib context. Drains REPL edits and remote IPC, emits :TICK, lays out, handles input and draws." "Unspecified." "(lui:frame-step window 0.016)")
   (lui:enqueue-ui "FUNCTION is a no-argument closure. Queues FIFO across threads; result is not transported. OWNER optionally cancels pending work when disposed. Failed jobs are not retried; later jobs remain queued." "FUNCTION and a cancellable job handle as a second value." "(lui:enqueue-ui (lambda () (setf (lui:text lui:*window*) \"Edited live\")))")
   (lui:on-ui "BODY is code captured as a closure and executed before a subsequent GUI frame. Lexical variables are captured. Paused error screens must resume before draining." "Queued closure." "(lui:on-ui (lui:add-child lui:*window* (lui:make-widget 'lui:label :text \"Live\")))")
   (lui:spawn-window "WINDOW is a root window. POSITION optionally is (screen-x screen-y), real coordinates. STYLE-SOURCE defaults to the currently active root and propagates app styles; an explicitly supplied theme remains an override. Uses *WORKER-COMMAND*, the local ASDF checkout and Quicklisp setup if present. Primary loop services IPC. Keep returned handle." "REMOTE-WINDOW." "(lui:on-ui (lui:spawn-window (lui:make-widget 'lui:window :text \"Second\" :width 400 :height 300)))")
   (lui:detach-window "DIALOG is an in-window dialog. Transfers its original objects to a new root and opens a native worker. Parent callbacks remain in the original Lisp. Drag beyond root bounds invokes this automatically when enabled." "REMOTE-WINDOW." "(let ((d (lui:make-widget 'lui:dialog :width 300 :height 200))) (lui:show-dialog lui:*window* d) (lui:on-ui (lui:detach-window d)))")
   (lui:remote-alive-p "REMOTE is a remote-window handle returned by SPAWN-WINDOW/DETACH-WINDOW. Reader thread updates liveness after EOF/closed." "Boolean." "(lui:remote-alive-p remote)")
   (lui:close-window "REMOTE is a live or closed remote-window handle. Requests native worker closure; completion is asynchronous. :DISPOSE defaults T and destroys the tree on closure. NIL preserves the tree for reuse, but always clears handle/registry references." "REMOTE." "(lui:close-window remote)")
   (lui:evaluate-in-window "REMOTE is a handle; FORMS is a list of trusted Lisp forms. Explicitly evaluates on worker main thread before its next frame, for native operations. Application methods/classes/source reloads belong in ON-UI. Not an untrusted-data API." "REMOTE." "(lui:evaluate-in-window remote '((asdf:load-system \"lui\" :force t)))")
   (lui:on-window "REMOTE expression returns a handle; BODY forms are quoted and sent for explicit native-operation evaluation in that worker. Lexical parent variables are not captured; ordinary app edits use ON-UI." "REMOTE." "(lui:on-window remote (asdf:load-system \"lui\" :force t))")))
