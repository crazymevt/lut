(in-package #:lut-docs)
(defun signatures ()
 (let ((result (make-hash-table)) (*package* (find-package :lut)) (*read-eval* nil))
   (dolist (file '("src/core.lisp" "src/cell-grid.lisp" "src/measurement.lisp" "src/widgets.lisp" "src/styles.lisp" "src/input.lisp"
                  "src/text-buffers.lisp" "src/text-history.lisp" "src/text-index.lisp" "src/text-geometry.lisp" "src/text-selection.lisp" "src/text-presentation.lisp" "src/anchored-surfaces.lisp" "src/commands.lisp" "src/data-models.lisp" "src/data-views.lisp" "src/platform.lisp" "src/notebook.lisp" "src/drag-and-drop.lisp" "src/interactions.lisp" "src/raylib.lisp" "src/presentation-raylib.lisp" "src/data-raylib.lisp" "src/windows.lisp"))
     (with-open-file (in (asdf:system-relative-pathname "lut" file))
       (loop for form = (read in nil :eof) until (eq form :eof)
             when (and (consp form) (member (first form) '(defun defmacro defgeneric)) (symbolp (second form)))
               do (setf (gethash (second form) result) (third form)))))
   (dolist (name '(lut:drag-source lut:drag-payload lut:drag-target lut:drag-state lut:drag-x lut:drag-y))
     (setf (gethash name result) '(session)))
   (dolist (name '(lut:edit-start lut:edit-old-end lut:edit-new-end lut:edit-revision lut:edit-origin))
     (setf (gethash name result) '(edit)))
   (setf (gethash 'lut:command-binding-active-p result) '(binding))
   (dolist (name '(lut:command-menu-backend lut:command-menu-bar lut:path-request-state lut:path-request-result lut:path-request-dialog))
     (setf (gethash name result) '(handle)))
   (dolist (name '(lut:model-revision lut:selection-focus lut:selection-anchor
                  lut:view-model lut:view-selection lut:row-label-function lut:table-columns lut:active-column
                  lut:data-column-id lut:data-column-title))
     (setf (gethash name result) '(object)))
   (setf (gethash 'lut:make-event result) '(&key kind x y key base-key text delta shift-p control-p alt-p super-p timestamp click-count)) result))
(defun inherited-slots (name)
 (let ((record (assoc name lut:*api*)))
   (remove-duplicates (append (fourth record) (mapcan #'inherited-slots (copy-list (second record))))
                      :key #'first :from-end t)))
(defun accessor-records (symbol)
 (loop for record in lut:*api* for slot = (find symbol (fourth record) :key #'first)
       when slot collect (list (first record) slot)))
(defun printed (value)
 (let ((*package* (find-package :lut)) (*print-case* :downcase)) (prin1-to-string value)))
(defun event-accessor-p (symbol) (search "EVENT-" (symbol-name symbol)))
(defun function-contract (symbol)
 (or (assoc symbol *platform-contracts*) (assoc symbol *data-contracts*) (assoc symbol *contracts*)
     (let ((records (accessor-records symbol)))
       (when records
         (let ((class (caar records)))
           (list symbol
             (format nil "WIDGET must be an instance of one of these classes. SETF validates the declared type and class invariants before mutation: ~{~a~^; ~}."
               (loop for (owner slot) in records collect
                 (format nil "~a: ~a (valid values ~a)" owner (fourth slot) (printed (third slot)))))
             "Current slot value. SETF returns the assigned value; invalid edits leave the slot unchanged."
             (format nil "(let ((w (lut:make-widget 'lut:~(~a~)))) (lut:~(~a~) w))" class symbol)))))
     (when (event-accessor-p symbol)
       (list symbol "EVENT is a normalized event returned by MAKE-EVENT. This accessor also supports SETF. See MAKE-EVENT for field types and valid KIND values."
         "The named event field." (format nil "(lut:~(~a~) (lut:make-event :kind :key :key :tab))" symbol)))
     (error "Missing API contract for ~s" symbol)))
(defun validate-example (string)
 (with-input-from-string (in string)
   (let ((*read-eval* nil) (*package* (find-package :lut)))
     (loop for form = (read in nil :eof) until (eq form :eof)))))
(defun generate (&optional (directory (asdf:system-relative-pathname "lut" "docs/docset/")))
 "Generate and validate the complete exported API docset. Missing function contracts or unreadable examples are errors."
 (let ((entries nil) (signatures (signatures)) (class-names (mapcar #'first lut:*api*)))
   (dolist (record (reverse lut:*api*))
     (destructuring-bind (name supers description slots) record
       (declare (ignore slots))
       (push `(:entry ,(format nil "class/~(~a~)" name) :names (,(symbol-name name)) :kind :class :kind-name "Class"
               :package "LUT" :summary ,description
               :sections (("Description" (:p ,description)) ("Superclasses" (:p ,(printed supers)))
                 ("Initargs, defaults and valid values"
                   ,@(loop for (slot init type doc) in (inherited-slots name) collect
                     `(:p ,(format nil ":~(~a~) — ~a Valid values: ~a. Default form: ~a. Accessor: ~a."
                                    slot doc (printed type) (printed init) (printed slot)))))
                 ("Example" (:code-block "lisp" ,(format nil "(lut:make-widget 'lut:~(~a~))" name))))) entries)))
   (do-external-symbols (symbol :lut)
     (unless (member symbol class-names)
       (cond
         ((boundp symbol)
          (push `(:entry ,(format nil "variable/~(~a~)" symbol) :names (,(symbol-name symbol))
                  :kind :variable :kind-name "Variable" :package "LUT"
                  :summary ,(or (documentation symbol 'variable) "Public library state.")
                  :sections (("Description" (:p ,(or (documentation symbol 'variable) "Public library state.")))
                    ("Example" (:code-block "lisp" ,(format nil "lut:~(~a~)" symbol))))) entries))
         ((fboundp symbol)
          (destructuring-bind (name args returns example) (function-contract symbol)
            (declare (ignore name)) (validate-example example)
            (let ((kind (if (macro-function symbol) :macro :function)))
              (push `(:entry ,(format nil "symbol/~(~a~)" symbol) :names (,(symbol-name symbol))
                      :kind ,kind :kind-name ,(if (eq kind :macro) "Macro" "Function") :package "LUT"
                      :summary ,(or (documentation symbol 'function) args)
                      :sections (("Signature" (:code-block "lisp"
                                    ,(format nil "(~(~a~) ~{~a~^ ~})" symbol
                                      (mapcar #'printed (or (gethash symbol signatures)
                                        (when (or (accessor-records symbol) (event-accessor-p symbol)) '(widget)))))))
                                 ("Arguments and valid values" (:p ,args))
                                 ("Results and errors" (:p ,returns)) ("Example" (:code-block "lisp" ,example)))) entries))))
         ((find-class symbol nil)
          (push `(:entry ,(format nil "type/~(~a~)" symbol) :names (,(symbol-name symbol)) :kind :class
                  :kind-name "Type" :package "LUT" :summary ,(cond ((eq symbol 'lut:remote-window)
                    "Native worker handle returned by SPAWN-WINDOW and DETACH-WINDOW. Root/process/reader references are cleared after closure.")
                    ((eq symbol 'lut:buffer-edit) "Committed character-range replacement; carries endpoints, revision and optional originating view.")
                    ((eq symbol 'lut:command-binding) "Command/control/shortcut binding handle; endpoint and context references are cleared on unbinding or disposal.")
                    ((eq symbol 'lut:drag-session) "Pending or active in-window drag; widget/payload references are released after terminal callbacks.")
                    ((eq symbol 'lut:connection) "Event connection handle returned as ON's second value; DISCONNECT clears its references.")
                    (t (or (documentation symbol 'type) "Backend capability error condition; CAPABILITY initarg identifies the unavailable operation.")))
                  :sections (("Description" (:p "See the functions accepting or returning this type.")))) entries)))))
   (dolist (event '(("edit" "TEXT-BUFFER: BUFFER-EDIT after text and all attached view positions have been synchronized. Then the buffer and each still-attached live view emit :CHANGE with the new text. Reentrant edits to this buffer are rejected; queue follow-up edits.")
                    ("history-overflow" "Standalone entry or shared TEXT-BUFFER: plist :OPERATION (:EDIT/:UNDO/:REDO), :STACK (:UNDO/:REDO), :CHARACTERS and :LIMIT after a committed range record exceeds a positive character budget and positive record limit. The destination stack is empty. Zero limits and ordinary eviction of older records are silent. Shared buffers notify after :EDIT/:CHANGE under the same reentrancy guard; standalone entries notify before the operation's :CHANGE, when applicable. Errors propagate without rolling back committed content/history.")
                    ("model-change" "DATA-MODEL: new MODEL-REVISION after committed data/query/tree updates. Source changes refresh projections and reconcile key selections. Reentrant writes are rejected; observer errors propagate after commit and may prevent later notifications.")
                    ("model-disposing" "DATA-MODEL: NIL while beginning disposal. Views detach; source disposal disposes dependent projections/selections. All active disposal handlers are attempted before cleanup; the first observer error is then propagated. Recursive disposal is idempotent.")
                    ("grid-resize" "CELL-GRID: (columns rows) after storage resize; overlap survives and selection clears. Callbacks may fill cells but should not recursively resize.")
                    ("raw-key / raw-text" "Focused captured widget: normalized EVENT before window key handlers and commands; modal, popup and drag handling retain precedence. Release and passthrough events do not emit raw events.")
                    ("text-input" "Uncaptured CELL-GRID: normalized text EVENT, containing committed EVENT-TEXT.")
                    ("selection-change" "SELECTION-MODEL and MODEL-LIST-VIEW/TREE/TABLE: copied list of stable selected keys, including hidden keys. Key/focus/anchor changes notify; missing keys are pruned on model changes.")
                    ("cell-edit-start" "MODEL-TABLE-VIEW: plist :KEY :COLUMN :OLD-VALUE after entry creation/focus. Application column factories and setters supply presentation/edit policy.")
                    ("cell-edit-commit" "MODEL-TABLE-VIEW: plist :KEY :COLUMN :OLD-VALUE :TEXT after setter success, editor disposal and underlying source notification. Setter errors leave editor open. Observer errors do not roll back data.")
                    ("cell-edit-cancel" "MODEL-TABLE-VIEW: plist :KEY :COLUMN :REASON after editor disposal without setter. Reasons include :CANCEL/:REPLACE/:MODEL-CHANGE/:SELECTION/:VIEWPORT/:DISPOSE. Disposal uses ordinary disposed-widget event suppression.")
                    ("presentation-change" "STYLED-TEXT-VIEW/DOCUMENT-VIEW: presentation revision after an explicit SET-TEXT-PRESENTATION, INVALIDATE-TEXT-PRESENTATION or gutter-width update. Content edits remap/drop records quietly before existing content notifications; they do not emit this event.")
                    ("link" "DOCUMENT-VIEW: the original application :TARGET from a link record after a collapsed single pointer click. Drag/double-click selection does not activate links. LUT does not open URLs or route application navigation.")
                    ("accept" "SUGGESTION-SURFACE: original candidate object after dismissal; no automatic text edit or command execution. Observer errors propagate after dismissal and can prevent later notifications.")
                    ("dismiss" "ANCHORED-SURFACE: reason keyword (:DISMISS/:ACCEPT/:ESCAPE/:OUTSIDE/:REANCHOR/:MODAL/:OWNER-UNAVAILABLE/:OWNER-DETACHED/:DISPOSE) after owner/scope/capture references are released. Explicit dismissal emits once per shown session; disposal clears quietly under disposed-widget event suppression. Errors do not roll back dismissal.")
                    ("drag-start" "Source: DRAG-SESSION after the movement threshold. No drag lifecycle events are emitted for an ordinary click.")
                    ("drag-enter" "Accepted target: DRAG-SESSION when entering this target. DRAG-TARGET identifies it.")
                    ("drag-over" "Accepted target: DRAG-SESSION on movement and release. DRAG-X/Y are current root coordinates.")
                    ("drag-leave" "Previous target: DRAG-SESSION when leaving or finishing; DRAG-TARGET can be NIL during a transition.")
                    ("drop" "Successful target: DRAG-SESSION after PERFORM-DROP returns true, with state :DROPPED. Rejected drops do not emit this event.")
                    ("drag-end" "Source: DRAG-SESSION with :DROPPED/:REJECTED/:CANCELLED. Source, target and payload references are cleared after terminal callbacks.")
                    ("pages-changed" "Source and destination notebooks (once for reorder): plist :PAGE :SOURCE :TARGET :OLD-INDEX :INDEX after MOVE-PAGE. The transferred page is selected; caption and identity are preserved.")
                    ("activate" "Button, check, toggle, radio: NIL. Entry: NIL on Enter. Check state changes before activation.")
                    ("change" "Entry: complete string; slider/spin: new real; check/radio/switch: boolean; list/table/stack/notebook: zero-based integer index.")
                    ("tick" "Root window: elapsed seconds as a non-negative real, before layout/input/render.")
                    ("gesture" "Normalized input KIND :GESTURE is delivered through HANDLE-EVENT at the pointer target. EVENT-KEY is :TAP/:DOUBLETAP/:HOLD/:DRAG/:SWIPE-LEFT/:SWIPE-RIGHT/:SWIPE-UP/:SWIPE-DOWN/:PINCH-IN/:PINCH-OUT. DELTA is hold seconds or pinch angle in degrees, otherwise zero. Worker windows forward the same event fields. Devices/backend may expose a subset.")
                    ("key" "Root window: normalized :KEY event before widget dispatch. BIND-KEY consumes a shortcut by setting EVENT-KEY to NIL. Modal dialogs suspend BIND-KEY actions.")
                    ("context-close" "Root window: NIL, while its native context is still current. Release owned GPU/audio resources here; native teardown continues even if a handler signals. CPU widget trees remain usable for a later START.")
                    ("context" "Target widget: normalized EVENT with pointer X/Y. A registered handler replaces the default entry context menu.")))
     (push `(:entry ,(concatenate 'string "event/" (first event)) :names (,(concatenate 'string ":" (string-upcase (first event))))
             :kind :event :kind-name "Event" :package "LUT" :summary ,(second event)
             :sections (("Payload and ordering" (:p ,(second event)))
               ("Callback contract" (:p "Callbacks take (widget payload), execute on the GUI/controller thread, and propagate errors to the event loop."))
               ("Example" (:code-block "lisp" ,(format nil "(lut:on widget :~a (lambda (widget payload) (declare (ignore widget)) (print payload)))" (first event)))))) entries))
   (docset:write-docset directory '(:id "lut" :title "LUT — Lisp User Toolkit" :packages ("LUT") :toc ())
                         (sort entries #'string< :key #'second))
   (let ((issues (docset:check-docset directory)))
     (unless (zerop issues) (error "Docset has ~d issues." issues))) directory))
