(load (merge-pathnames "bootstrap.lisp" *load-truename*))
(unless (find-package :ql)
  (load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname))))
(uiop:symbol-call :ql :quickload '("lut/demo" "lut/raylib") :silent t)
(let ((root (lut-demo:make-app)) (frame 0))
  (lut:on root :tick
    (lambda (window dt)
      (declare (ignore dt))
      (incf frame)
      ;; Each example gets three frames on each tab, including actual rendering.
      (let ((index (floor (1- frame) 6)) (phase (mod (1- frame) 6)))
        (when (< index (length (lut-demo:demo-names)))
          (when (= phase 0)
            (let ((catalog (lut:find-widget window :catalog)))
              (setf (lut:value catalog) index)
              (lut:emit catalog :change index))
            (lut:select-page (lut:find-widget window :tabs) 0))
          (when (= phase 3) (lut:select-page (lut:find-widget window :tabs) 1))
          (when (and (zerop index) (= phase 2))
            (rl:take-screenshot "/tmp/lut-demo-demo.png"))
          (when (and (zerop index) (= phase 5))
            (rl:take-screenshot "/tmp/lut-demo-code.png"))
          (when (and (= phase 2) (string= (nth index (lut-demo:demo-names)) "Views / Styled text"))
            (let ((target (rl:load-render-texture (round (lut:width window)) (round (lut:height window)))))
              (unwind-protect
                (progn
                  (rl:with-texture-mode (target)
                    (rl:clear-background (lut:style-value window :background)) (lut::render-window window))
                  (let ((image (rl:load-image-from-texture (rl:render-texture-texture target))))
                    (unwind-protect
                      (progn (rl:image-flip-vertical image) (assert (rl:export-image image "/tmp/lut-demo-styled-text.png")))
                      (rl:unload-image image))))
                (rl:unload-render-texture target))))
          (when (and (= phase 2) (string= (nth index (lut-demo:demo-names)) "Foundations / Cell grid and key capture"))
            (rl:take-screenshot "/tmp/lut-demo-foundations.png"))
          (when (and (= phase 5) (string= (nth index (lut-demo:demo-names)) "Foundations / Cell grid and key capture"))
            (rl:take-screenshot "/tmp/lut-demo-foundation-code.png"))))))
  (unwind-protect (lut:run root :frames (* 6 (length (lut-demo:demo-names))))
    (lut:dispose root))
  (assert (= frame (* 6 (length (lut-demo:demo-names)))))
  (format t "PASS: rendered all ~d demos and their Code tabs over ~d native frames.~%"
          (length (lut-demo:demo-names)) frame))
