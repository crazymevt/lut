(defpackage #:lut-demo-tests (:use #:cl) (:export #:run-tests))
(in-package #:lut-demo-tests)

(defun key (root widget key)
  (lut:focus root widget)
  (lut:dispatch root (lut:make-event :kind :key :key key)))

(defun run-tests ()
  (styled-text-tests)
  (let* ((root (lut-demo:make-app))
         (catalog (lut:find-widget root :catalog))
         (tabs (lut:find-widget root :tabs))
         (source (lut:find-widget root :source))
         (page (lut:find-widget root :demo-page)))
    (unwind-protect
         (progn
           (assert (>= (length (lut-demo:demo-names)) 32))
           (assert (= (length (lut-demo:demo-names)) (length (remove-duplicates (lut-demo:demo-names) :test #'string=))))
           (assert (equal '("Demo" "Code") (lut:items tabs)))
           (assert (= 2 (length (lut:children (lut:find-widget root :panes)))))
           ;; Traverse the actual catalog keyboard path. Each sample must build,
           ;; replace its predecessor, and expose readable, executable source.
           (loop for example in lut-demo::*examples* for index from 0 do
             (when (plusp index) (key root catalog :down))
             (assert (= index (lut:value catalog)))
             (assert (= 2 (length (lut:children page))))
             (assert (string= (lut:text source) (lut-demo::source-text example)))
             (dolist (size '((1180 780) (800 600)))
               (lut:layout root 0 0 (first size) (second size))
               (assert (plusp (lut:width catalog)))
               (assert (< (lut:x catalog) (lut:x tabs)))
               (assert (plusp (lut:height page)))
               ;; New foundation entries extend beyond the initial viewport.
               (let ((top (* index (lut:row-height catalog))) (offset (lut:scroll-offset catalog)))
                 (assert (<= offset top))
                 (assert (<= (+ top (lut:row-height catalog)) (+ offset (lut:height catalog))))))
             (let* ((*package* (find-package :lut-demo))
                    (builder (eval (read-from-string (lut:text source))))
                    (widget (funcall builder root)))
               (assert (typep widget 'lut:widget))
               (lut:dispose widget))
             (let ((old (second (lut:children page))))
               (lut-demo::show-example root example)
               (assert (lut:disposed-p old))))
           ;; Wheel browsing can move away from selection at unchanged size.
           (lut:scroll-to catalog 0)
           (lut:layout root 0 0 800 600)
           (assert (zerop (lut:scroll-offset catalog)))
           ;; The catalog scrollbar drags through the ordinary input path and
           ;; never selects a row, even when released outside the window.
           (let ((selection (lut:value catalog)) (code (lut:text source)))
             (multiple-value-bind (sx sy sw sh travel) (lut::scrollbar-bounds catalog)
               (assert (plusp travel))
               (lut:dispatch root (lut:make-event :kind :down :x (+ sx (/ sw 2)) :y (+ sy (/ sh 2))))
               (assert (eq :scrollbar (first (lut::interaction-state root))))
               (lut:dispatch root (lut:make-event :kind :move :x (+ sx (/ sw 2)) :y 1000))
               (lut:dispatch root (lut:make-event :kind :up :x (+ sx (/ sw 2)) :y 1000))
               (assert (= (lut::scrollbar-range catalog) (lut:scroll-offset catalog)))
               (assert (null (lut::interaction-state root)))
               (assert (null (lut::pressed-widget root)))
               (assert (= selection (lut:value catalog)))
               (assert (string= code (lut:text source))))
             (lut:dispatch root (lut:make-event :kind :wheel :x (+ (lut:x catalog) 10) :y 100 :delta 1))
             (assert (< (lut:scroll-offset catalog) (lut::scrollbar-range catalog)))
             (lut:scroll-to catalog 0)
             (let ((sx (nth-value 0 (lut::scrollbar-bounds catalog))))
               (lut:dispatch root (lut:make-event :kind :down :x (+ sx 2) :y (- (lut:height catalog) 2)))
               (lut:dispatch root (lut:make-event :kind :up :x (+ sx 2) :y (- (lut:height catalog) 2)))
               (assert (plusp (lut:scroll-offset catalog))))
             (assert (= selection (lut:value catalog))))
           ;; A tab change uses LUT input, and feature changes retain that tab.
           (key root tabs :right)
           (assert (= 1 (lut:value tabs)))
           (key root catalog :up)
           (assert (= 1 (lut:value tabs)))
           (let ((before (lut:text source)))
             (key root source :select-all)
             (key root source :copy)
             (assert (string= before (lut:clipboard-text source))))
           (lut:select-page tabs 0)
           (lut-demo::show-example root (first lut-demo::*examples*))
           (let ((button (lut:find-widget root :counter)))
             (key root button :enter)
             (assert (string= "Clicked 1 times" (lut:text button))))
           (lut-demo::show-example root (nth 6 lut-demo::*examples*))
           (key root (lut:find-widget root :slider) :right)
           (assert (= 36 (lut:value (lut:find-widget root :progress))))
           ;; Tabs intentionally contrast a static label with an editable page.
           (lut-demo::show-example root (find "Layouts / Tabs" lut-demo::*examples*
                                              :key #'lut-demo::example-name :test #'string=))
           (let ((sample (second (lut:children page))))
             (assert (typep (first (lut:children sample)) 'lut:label))
             (assert (plusp (length (lut:text (first (lut:children sample))))))
             (key root sample :right)
             (assert (= 1 (lut:value sample)))
             (assert (typep (second (lut:children sample)) 'lut:entry)))
           (lut-demo::show-example root (find "Features / Dialog" lut-demo::*examples* :key #'lut-demo::example-name :test #'string=))
           (key root (second (lut:children page)) :enter)
           (let* ((dialog (first (lut::overlays root)))
                  (close (second (lut:children dialog))))
             (assert (typep dialog 'lut:dialog))
             (assert (lut:detach-on-drag-p dialog))
             (key root close :enter)
             (assert (null (lut::overlays root))))
           (format t "PASS: ~d demos, executable matching source, keyboard navigation, resize, disposal, source copy, counter, slider, dialog.~%" (length (lut-demo:demo-names))))
      (lut:dispose root)))
  t)

(defun styled-text-tests ()
 (let* ((example (find "Views / Styled text" lut-demo::*examples* :key #'lut-demo::example-name :test #'string=))
        (root (lut:make-widget 'lut:window :width 800 :height 600))
        (box (lut:add-child root (funcall (lut-demo::example-builder example) root)))
        (view (lut:find-widget box :styled-editor))
        (highlight (lut:find-widget box :styled-highlight))
        (bold (lut:find-widget box :styled-bold))
        (italic (lut:find-widget box :styled-italic))
        (sizes (lut:find-widget box :styled-sizes))
        (lines (lut:find-widget box :styled-lines))
        (reset (lut:find-widget box :styled-reset))
        (sample (lut:text view)))
   (unwind-protect
     (progn
       (assert (typep view 'lut:styled-text-view))
       (assert (lut:text-runs view)) (assert (= 44 (lut:gutter-width view)))
       (assert (find :underline (lut:text-decorations view) :key (lambda (r) (getf r :kind))))
       (assert (getf (lut:text-style-at view (search "defun" sample)) :bold))
       (assert (getf (lut:text-style-at view 0) :italic))
       (assert (= 14 (getf (lut:text-style-at view 0) :font-size)))
       (assert (= 24 (getf (lut:text-style-at view (search "42" sample)) :font-size)))
       (setf (lut:value highlight) nil) (lut:emit highlight :change nil)
       (assert (every (lambda (r) (null (getf (getf r :style) :foreground))) (lut:text-runs view)))
       (dolist (toggle (list bold italic sizes))
         (setf (lut:value toggle) nil) (lut:emit toggle :change nil))
       (assert (null (lut:text-runs view)))
       (assert (every (lambda (r) (eq :gutter (getf r :kind))) (lut:text-decorations view)))
       (setf (lut:value lines) nil) (lut:emit lines :change nil)
       (assert (zerop (lut:gutter-width view))) (assert (null (lut:text-decorations view)))
       (setf (lut:value highlight) t) (lut:emit highlight :change t)
       (dolist (toggle (list bold italic sizes))
         (setf (lut:value toggle) t) (lut:emit toggle :change t))
       (lut:focus root view) (lut:select-all view)
       (lut:replace-selection view "(defun answer () 42)")
       (assert (equal (lut:style-value view :accent) (getf (lut:text-style-at view 1) :foreground)))
       (assert (equal '(217 119 6 255) (getf (lut:text-style-at view (search "42" (lut:text view))) :foreground)))
       (lut:undo view) (assert (string= sample (lut:text view)))
       (lut:redo view) (assert (string= "(defun answer () 42)" (lut:text view)))
       (lut:emit reset :activate)
       (assert (string= sample (lut:text view)))
       (assert (zerop (lut:cursor view))) (assert (zerop (lut:anchor view)))
       (assert (lut:text-runs view)))
     (lut:dispose root))))
