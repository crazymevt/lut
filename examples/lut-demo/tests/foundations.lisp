(in-package #:lut-demo-tests)

(defun show-foundation (root name)
 (let* ((name (concatenate 'string "Foundations / " name))
        (index (position name (lut-demo:demo-names) :test #'string=))
        (catalog (lut:find-widget root :catalog)))
   (assert index)
   (setf (lut:value catalog) index) (lut:emit catalog :change index)
   (lut:layout root 0 0 1180 780)))
(defun press-demo (root id)
 (let ((button (lut:find-widget root id)))
   (assert button)
   (handler-case (key root button :enter)
     (error (condition) (error "Demo control ~s: ~a" id condition)))))

(defun foundation-tests ()
 (let ((root (lut-demo:make-app)))
   (unwind-protect
     (progn
       (show-foundation root "Shared commands")
       (press-demo root :command-first) (press-demo root :command-second)
       (lut:dispatch root (lut:make-event :kind :key :key :f6))
       (assert (string= "Count: 3" (lut:text (lut:find-widget root :command-count))))
       (press-demo root :command-allowed)
       (lut:dispatch root (lut:make-event :kind :key :key :f6))
       (assert (string= "Count: 3" (lut:text (lut:find-widget root :command-count))))
       (assert (not (lut:enabled-p (lut:find-widget root :command-first))))
       (let ((command (first (lut:window-commands root))))
         (assert command)
         (show-foundation root "Shared text and history")
         (assert (null (lut:window-commands root)))
         (assert (null (lut::command-links command))))
       (let* ((left (lut:find-widget root :shared-left)) (right (lut:find-widget root :shared-right))
              (original (lut:text left)) (buffer (lut:view-buffer left)))
         (lut:focus root left) (lut:select-all left)
         (lut:dispatch root (lut:make-event :kind :text :text "Shared replacement"))
         (assert (string= "Shared replacement" (lut:text right)))
         (press-demo root :shared-undo) (assert (string= original (lut:text right)))
         (press-demo root :shared-redo) (assert (string= "Shared replacement" (lut:text left)))
         (press-demo root :shared-lock) (assert (lut:read-only-p right))
         (show-foundation root "Indexed text and selection")
         (assert (null (lut::buffer-views buffer))))
       (let ((view (lut:find-widget root :indexed-view)))
         (assert (= 20000 (lut:text-line-count view)))
         (press-demo root :indexed-last) (assert (= (lut:text-length view) (lut:cursor view)))
         (press-demo root :indexed-word) (assert (string= "Line" (lut:selected-text view))))
       (show-foundation root "Document presentation")
       (assert (lut:text-runs (lut:find-widget root :document-view)))
       (press-demo root :suggestion-show)
       (let ((popup (first (lut::overlays root))))
         (assert (typep popup 'lut:suggestion-surface))
         (lut:accept-suggestion popup 1)
         (assert (search "beta" (lut:text (lut:find-widget root :suggestion-editor)))))
       ;; Switching away with a visible suggestion must release its anchor.
       (press-demo root :suggestion-show)
       (let ((popup (first (lut::overlays root))))
         (show-foundation root "Virtual data and selection")
         (assert (null (lut::overlays root))) (assert (null (lut::anchor-owner popup))))
       (press-demo root :virtual-last)
       (let* ((view (lut:find-widget root :virtual-view)) (model (lut:view-model view)))
         (assert (= 1000000 (lut:model-count model)))
         (assert (equal '(999999) (lut:selected-keys (lut:view-selection view))))
         (assert (plusp (lut:scroll-offset view)))
         (assert (null (lut:children view))))
       (show-foundation root "Editable model table")
       (let ((table (lut:find-widget root :editable-table)))
         (lut:begin-cell-edit table 0 0)
         (setf (lut:text (lut:cell-editor table)) "Zeta")
         (lut:commit-cell-edit table)
         (press-demo root :table-sort)
         (assert (string= "Zeta" (getf (lut:model-item (lut:view-model table) 0) :name))))
       (show-foundation root "Keyed tree model")
       (let* ((view (lut:find-widget root :keyed-tree)) (model (lut:view-model view)))
         (assert (= 4 (lut:model-count model)))
         (lut:select-model-index (lut:view-selection view) 2)
         (assert (equal '(:tests) (lut:selected-keys (lut:view-selection view))))
         (press-demo root :tree-toggle) (assert (= 1 (lut:model-count model)))
         (press-demo root :tree-toggle) (assert (= 4 (lut:model-count model))))
       (show-foundation root "Platform integration")
       (press-demo root :platform-zoom) (assert (= 5/4 (lut:ui-scale root)))
       (press-demo root :platform-zoom) (assert (= 2 (lut:ui-scale root)))
       (press-demo root :platform-zoom) (assert (= 1 (lut:ui-scale root)))
       (press-demo root :platform-menu)
       (let ((menu (first (lut::overlays root))))
         (assert (typep menu 'lut:context-menu))
         (assert (typep (second (lut:children menu)) 'lut:menu-separator))
         (key root (car (last (lut:children menu))) :enter)
         (assert (= 5/4 (lut:ui-scale root)))
         (setf (lut:ui-scale root) 1))
       (press-demo root :platform-picker)
       (assert (lut::overlays root))
       (let ((request (first (lut::platform-resources root))))
         (lut:cancel-path-request request) (assert (null (lut::platform-resources root))))
       (assert (null (lut::overlays root)))
       (show-foundation root "Notebook composition")
       (let* ((left (lut:find-widget root :composition-left)) (right (lut:find-widget root :composition-right))
              (draft (first (lut:children left))))
         (assert (not (lut:request-page-close left draft)))
         (press-demo root :composition-move)
         (assert (eq right (lut:parent draft)))
         (press-demo root :composition-clear)
         (assert (lut:request-page-close right draft)) (assert (lut:disposed-p draft)))
       (show-foundation root "Measured and flow layout")
       (let* ((flow (lut:find-widget root :measured-flow))
              (narrow (nth-value 1 (lut:measure flow :vertical 220))) (wide (nth-value 1 (lut:measure flow :vertical 700))))
         (assert (> narrow wide)))
       (let ((prose (lut:find-widget root :measured-prose)))
         (let ((before (length (lut:text prose))))
           (press-demo root :measured-grow) (assert (> (length (lut:text prose)) before))))
       (show-foundation root "Wrapped document blocks")
       (let ((document (lut:find-widget root :wrapped-document)) (composer (lut:find-widget root :wrapped-composer)))
         (assert (typep document 'lut:wrapped-document-view))
         (assert (= 150 (lut:max-height composer)))
         (assert (> (nth-value 1 (lut:measure document :vertical 200)) (nth-value 1 (lut:measure document :vertical 650)))))
       (show-foundation root "Scrolling and follow-end")
       (let ((view (lut:find-widget root :follow-view)))
         (assert (lut:follow-end-distance view))
         (press-demo root :follow-append) (assert (search "Message 31" (lut:text view)))
         (press-demo root :follow-pause) (assert (null (lut:follow-end-distance view)))
         (press-demo root :follow-first) (assert (zerop (lut:vertical-offset view)))
         (press-demo root :follow-resume) (assert (lut:follow-end-distance view)))
       (show-foundation root "Application adapters")
       (assert (search "Launcher:" (lut:text (lut:find-widget root :adapter-status))))
       ;; Inspecting the demo must not launch a URI or change native state.
       (assert (string= "https://example.com" (lut:text (lut:find-widget root :adapter-uri))))
       (show-foundation root "Cell grid and key capture")
       (let ((grid (lut:find-widget root :cell-grid)))
         (press-demo root :cell-capture) (assert (lut:keys-captured-p grid))
         (lut:dispatch root (lut:make-event :kind :text :text "Hi"))
         (assert (char= #\H (getf (lut:grid-cell grid 0 1) :character)))
         (assert (char= #\i (getf (lut:grid-cell grid 1 1) :character)))
         (lut:dispatch root (lut:make-event :kind :key :key :tab :base-key :tab))
         (assert (eq grid (lut:focused-widget root)))
         (lut:dispatch root (lut:make-event :kind :key :key :f12))
         (assert (not (lut:keys-captured-p grid)))
         (lut:select-grid-cells grid 0 1 1 1)
         (press-demo root :cell-copy) (assert (string= "Hi" (lut:clipboard-text grid)))
         (press-demo root :cell-capture)
         (show-foundation root "Shared commands")
         (assert (lut:disposed-p grid)) (assert (null (lut::key-capture grid))))
       (format t "PASS: foundation commands, shared/indexed text, presentation, virtual models, table editing, platform, composition, measurement, wrapping, follow-end, adapters and cell capture.~%"))
     (lut:dispose root)))
 t)
