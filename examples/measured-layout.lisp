(in-package #:lut-examples)
(export 'measured-layout)
(defun measured-layout ()
 "Content-sized labels, wrapping control rows and bounded expansion. Resize to compare narrow and wide layouts."
 (let* ((root (lut:make-widget 'lut:window :text "Measured layout foundation" :width 760 :height 540 :content-layout :fill))
        (body (lut:add-child root (lut:make-widget 'lut:measured-box :id :measured-body :spacing 12)))
        (heading (lut:add-child body (lut:make-widget 'lut:label :text "Content measurement and flow layout" :style '(:wrap-text t :font-size 24 :line-height 32))))
        (short "Resize the window: these controls wrap into rows and the prose requests its actual painted height. Existing editors still use explicit size requests.")
        (prose (lut:add-child body (lut:make-widget 'lut:label :id :measured-prose :text short :hexpand t :style '(:wrap-text t))))
        (flow (lut:add-child body (lut:make-widget 'lut:flow-box :id :measured-actions :hexpand t :column-spacing 8 :row-spacing 8)))
        (extra nil))
   (declare (ignore heading))
   (lut:add-child flow (action "Longer prose" (lambda ()
     (setf (lut:text prose) (concatenate 'string short " Content measurement reacts to text, style and width changes without changing geometry during a query. Widget allocation happens only in layout.")))))
   (lut:add-child flow (action "Reset prose" (lambda () (setf (lut:text prose) short))))
   (lut:add-child flow (action "Hide/show extra control" (lambda () (setf (lut:visible-p extra) (not (lut:visible-p extra))))))
   (setf extra (lut:add-child flow (lut:make-widget 'lut:button :text "Extra control")))
   (lut:add-child flow (lut:make-widget 'lut:button :text "Disabled still takes space" :enabled-p nil))
   (let ((row (lut:add-child body (lut:make-widget 'lut:measured-box :orientation :horizontal :hexpand t :spacing 8))))
     (lut:add-child row (lut:make-widget 'lut:button :text "Bounded expander" :hexpand t :max-width 260))
     (lut:add-child row (lut:make-widget 'lut:button :text "Shares remaining width" :hexpand t)))
   (lut:add-child body (lut:make-widget 'lut:drawing-area :vexpand t :hexpand t :min-height 0
     :draw-function (lambda (w)
       (rl:draw-rectangle (lut:x w) (lut:y w) (lut:width w) (lut:height w) (lut:style-value w :surface)))))
   (lut:add-child body (lut:make-widget 'lut:label :text "Measured layouts are opt-in. Selectable/editor reflow and rich document blocks remain on the roadmap."
      :hexpand t :style '(:wrap-text t))) root))
