(in-package #:lut-examples)
(export 'data-models)
(defclass data-model-window (lut:window) ((models :initarg :models :accessor owned-data-models)))
(defmethod lut:dispose :after ((root data-model-window))
 (dolist (model (owned-data-models root)) (lut:dispose model)) (setf (owned-data-models root) nil))
(defun data-models ()
 "A million lazy rows, keyed selection, a collapsible tree, and a sorted/filtered editable table."
 (let* ((lazy (lut:make-function-model :count 1000000 :item (lambda (i) (format nil "Lazy row ~d" i))
                 :index (lambda (key) (when (and (integerp key) (<= 0 key) (< key 1000000)) key))))
        (selection (lut:make-selection-model lazy :mode :multiple))
        (source (lut:make-vector-model
                  (loop for i below 100 collect (list :id i :name (format nil "Task ~2,'0d" i) :priority (mod i 5)))
                  :key (lambda (item) (getf item :id))))
        (projection (lut:make-projection-model source))
        (tree (lut:make-tree-model
                '((:id :all :name "Application data" :children
                    ((:id :tasks :name "Tasks") (:id :notes :name "Notes") (:id :archive :name "Archive"))))
                :key (lambda (item) (getf item :id)) :children (lambda (item) (getf item :children))))
        (root (make-instance 'data-model-window :text "Data models and selection" :width 1100 :height 620
                              :models (list selection lazy projection source tree)))
        (panes (lut:make-widget 'lut:box :orientation :horizontal :height 440))
        (list (lut:make-widget 'lut:model-list-view :id :lazy-data :model lazy :selection selection :width 290 :height 420))
        (tree-view (lut:make-widget 'lut:model-tree-view :id :tree-data :model tree :width 240 :height 420
                    :row-label-function (lambda (item) (getf item :name))))
        (table (lut:make-widget 'lut:model-table-view :id :table-data :model projection :width 490 :height 420
                 :table-columns (list
                   (lut:make-data-column :id :id :title "ID" :getter (lambda (item) (getf item :id)))
                   (lut:make-data-column :id :name :title "Task (editable)" :getter (lambda (item) (getf item :name))
                     :setter (lambda (item text) (setf (getf item :name) text)))
                   (lut:make-data-column :id :priority :title "Priority" :getter (lambda (item) (getf item :priority))
                     :cell-factory (lambda (item value) (declare (ignore item))
                       (list :text (princ-to-string value) :foreground (if (> value 2) :red :blue)))))))
        (tools (lut:make-widget 'lut:header-bar :height 44))
        (status (lut:make-widget 'lut:label :id :data-status :text "Ctrl/Cmd toggles rows; Shift extends ranges. Right/Left expand/collapse tree.")))
   (lut:set-tree-expanded tree :all t)
   (lut:add-child root (lut:make-widget 'lut:label :text "Lazy models, stable identity, independent selection and editable cells"))
   (lut:add-child root panes)
   (dolist (view (list list tree-view table)) (lut:add-child panes view))
   (lut:add-child root tools)
   (lut:add-child tools (action "Last lazy row" (lambda ()
     (lut:select-model-index selection 999999) (lut:reveal-model-index list 999999))))
   (lut:add-child tools (action "Sort tasks Z-A" (lambda ()
     (lut:set-model-query projection :lessp (lambda (a b) (string> (getf a :name) (getf b :name)))))))
   (lut:add-child tools (action "High priority" (lambda ()
     (lut:set-model-query projection :predicate (lambda (item) (> (getf item :priority) 2))))))
   (lut:add-child tools (action "Show all" (lambda () (lut:set-model-query projection :predicate nil))))
   (lut:add-child root status)
   (lut:add-child root (lut:make-widget 'lut:label :text "Table: click a Task cell, Enter edits/commits, Escape cancels. Left/Right changes column."))
   (lut:on list :selection-change (lambda (view keys) (declare (ignore view))
     (setf (lut:text status) (format nil "Stable selected lazy keys: ~s" keys))) :owner root)
   (lut:on table :cell-edit-commit (lambda (view event) (declare (ignore view))
     (setf (lut:text status) (format nil "Application committed ~s" event))) :owner root)
   root))
