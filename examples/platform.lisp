(in-package #:lut-examples)
(export 'platform-integration)
(defclass platform-example-window (lut:window) ((commands :initform nil :accessor example-platform-commands)))
(defmethod lut:dispose :after ((root platform-example-window))
 (dolist (command (example-platform-commands root)) (lut:dispose command)) (setf (example-platform-commands root) nil))
(defun platform-integration ()
 "Command menus, path-only native/portable pickers, UI zoom, and an honest capability audit."
 (let* ((root (make-instance 'platform-example-window :text "Platform integration" :width 760 :height 560))
        (status (lut:make-widget 'lut:label :text "Choose a path; the application decides what to read or save." :height 60))
        (capabilities (lut:make-widget 'lut:label :height 100))
        (zoom (lut:make-widget 'lut:header-bar :height 44))
        (input (lut:make-widget 'lut:entry :text "Select and edit me at any UI scale." :height 40)))
   (labels ((choose (kind &optional (native :auto))
              (lut:request-path root (lambda (path) (setf (lut:text status)
                (if path (format nil "Selected ~a (no file was written)" path) "Selection cancelled.")))
                :kind kind :filename (when (eq kind :save) "untitled.txt") :native native))
            (command (id label kind shortcut)
              (let ((c (lut:make-command id label (lambda (c context) (declare (ignore c context)) (choose kind)) :shortcut shortcut)))
                (push c (example-platform-commands root)) c)))
     (lut:install-command-menu root (list (list :label "File" :commands
       (list (command :open "Open file…" :file :control-o) (command :folder "Choose folder…" :folder :control-shift-o)
             :separator (command :save "Choose save path…" :save :control-s)))))
     (lut:add-child root (lut:make-widget 'lut:label :text "Native adapters with portable fallbacks"))
     (lut:add-child root input)
     (lut:on input :context (lambda (w event)
       (lut:open-context-menu root w event
         (list (list "Open file…" (lambda () (choose :file)) t) :separator
               (list "Choose folder…" (lambda () (choose :folder)) t)
               (list "Choose save path…" (lambda () (choose :save)) t)))) :owner root)
     (lut:add-child root (action "Open file (automatic adapter)" (lambda () (choose :file))))
     (lut:add-child root (action "Choose folder (automatic adapter)" (lambda () (choose :folder))))
     (lut:add-child root (action "Choose save path (automatic adapter)" (lambda () (choose :save))))
     (lut:add-child root (action "Portable file picker" (lambda () (choose :file nil))))
     (lut:add-child root zoom)
     (dolist (scale '(1 5/4 3/2 2))
       (let ((scale scale)) (lut:add-child zoom (lut:make-widget 'lut:button :width 130
         :text (format nil "~d% UI" (round (* 100 scale)))))))
     (loop for button in (lut:children zoom) for scale in '(1 5/4 3/2 2) do
       (let ((scale scale)) (lut:on button :activate (lambda (b p) (declare (ignore b p)) (setf (lut:ui-scale root) scale)) :owner root)))
     (lut:add-child root status) (lut:add-child root capabilities)
     (lut:on root :tick (lambda (w dt) (declare (ignore dt))
       (setf (lut:text capabilities) (format nil "Menus: ~a. Pickers: ~a. UI: ~d%.~%Shaping, bidi, IME composition, accessibility: unsupported.~%Linux/Windows native adapters: unverified."
         (getf (lut:platform-capability w :menus) :status) (getf (lut:platform-capability w :path-pickers) :status)
         (round (* 100 (lut:ui-scale w)))))) :owner root)
     root)))
