(defpackage #:lut-gtk-demo (:use #:cl) (:export #:demo #:demo-names #:test-demos #:browser #:*demos*))
(in-package #:lut-gtk-demo)
(defvar *demos* nil)
(defclass demo-window (lut:window)
 ((model :initform nil :accessor model) (resources :initform nil :accessor resources) (native-resources :initform nil :accessor native-resources)))
(defun dispose-demo-resources (resources)
 (let ((failure nil))
  (dolist (resource resources) (handler-case (lut:dispose resource) (error (e) (unless failure (setf failure e)))))
  (when failure (error failure))))
(defmethod lut:dispose :after ((root demo-window))
 (let ((owned (append (native-resources root) (resources root))))
  (setf (resources root) nil (native-resources root) nil (model root) nil)
  (dispose-demo-resources owned)))
(defmethod initialize-instance :after ((root demo-window) &key)
 (lut:on root :context-close (lambda (w payload) (declare (ignore w payload))
   (let ((old (native-resources root))) (setf (native-resources root) nil)
     (dispose-demo-resources old))) :owner root))
(defun control (root id) (or (lut:find-widget root id) (error "Missing demo control ~a" id)))
(defun node (class id &rest args) (apply #'lut:make-widget class :id id args))
(defun app (title &rest children)
 (let ((w (lut:make-widget 'demo-window :text title :width 720 :height 600)))
   (mapc (lambda (child) (lut:add-child w child)) children) w))
(defun action (id title fn)
 (let ((button (node 'lut:button id :text title)))
   (lut:on button :activate (lambda (w e) (declare (ignore w e)) (funcall fn))) button))
(defun press (root id)
 (lut:focus root (control root id)) (lut:dispatch root (lut:make-event :kind :key :key :enter)))
(defmacro defdemo (name description builder &body test)
 `(progn
   (setf *demos* (remove ,name *demos* :key #'first :test #'string=))
   (push (list ,name ,description (lambda () ,builder) (lambda (root) ,@test)) *demos*)))
(defun demo-names () "Return runnable GTK demo adaptation names, sorted alphabetically."
 (sort (mapcar #'first *demos*) #'string<))
(defun demo (name)
 "Build the runnable LUT adaptation NAME. Every registry entry includes its own behavioral test."
 (let ((record (find name *demos* :key #'first :test #'string=)))
   (unless record (error "Unknown demo ~s; available: ~{~a~^, ~}" name (demo-names)))
   (let* ((root (funcall (third record)))
          (viewport (node 'lut:scroll-view :demo-viewport :height (lut:height root))))
    ;; Long control panels remain reachable at any native window size.
    (dolist (child (copy-list (lut:children root)))
     (lut:remove-child root child) (lut:add-child viewport child))
    (lut:add-child root viewport) (setf (lut:content-layout root) :fill) root)))
(defun test-demos ()
 "Run every registered behavioral test without a display; report each result."
 (check-coverage)
 (dolist (name (demo-names))
   (let* ((record (find name *demos* :key #'first :test #'string=)) (root (demo name)))
     (lut:layout root 0 0 (lut:width root) (lut:height root))
     (unwind-protect (funcall (fourth record) root) (lut:dispose root))
     (format t "GTK adaptation ~a: passed~%" name)))
 (format t "~d GTK demo behavioral checks passed.~%" (length *demos*)) t)
(defdemo "search_entry" "Filtering a list model while typing."
 (let ((field (node 'lut:entry :search))
       (list (node 'lut:list-view :results :height 240 :items '("Apple" "Apricot" "Banana"))))
   (lut:on field :change (lambda (w query) (declare (ignore w))
     (setf (lut:items list) (remove-if-not (lambda (s) (search query s :test #'char-equal))
                                                       '("Apple" "Apricot" "Banana")))))
   (app "Search entry" field list))
 (lut:focus root (control root :search)) (lut:dispatch root (lut:make-event :kind :text :text "Ap"))
 (assert (equal '("Apple" "Apricot") (lut:items (control root :results)))))
