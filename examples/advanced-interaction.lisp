(in-package #:lut-examples)
(export 'advanced-interaction)
(defclass composition-window (lut:window)
 ((controller :initform (lut:make-drag-controller) :reader composition-controller)
  (peer :initform nil :accessor composition-peer)))
(defmethod lut:dispose :before ((root composition-window))
 (when (composition-peer root) (lut:dispose (composition-peer root)) (setf (composition-peer root) nil))
 (lut:dispose (composition-controller root)))
(defclass composition-card (lut:button) ())
(defmethod lut:drag-data ((card composition-card) event)
 (declare (ignore event)) (values card t))
(defun composition-book (controller root caption)
 (lut:register-drag-window controller root)
 (let ((book (lut:make-widget 'lut:notebook :height 190 :closable-p t :reorderable-p t
              :tab-group :composition :items (list caption "Protected" "Notes"))))
   (dolist (text '("Drag headers within this window. Peer transfer uses keyboard/programmatic APIs." "Clear this badge before closing." "Reusable page content."))
     (lut:add-child book (lut:make-widget 'lut:label :text text)))
   (setf (lut:tab-badge (second (lut:children book))) "protected")
   (lut:on book :page-close-request (lambda (w request) (declare (ignore w))
     (when (lut:tab-badge (lut:close-request-page request)) (setf (lut:close-request-veto-p request) t))) :owner book)
   (lut:on book :page-closed (lambda (w request) (declare (ignore w)) (lut:dispose (lut:close-request-page request))) :owner book)
   book))
(defun advanced-interaction ()
 "Tab close/veto/badges, peer transfer, keyboard/pointer drops, stationary edge scrolling, pane composition and OS file drops."
 (let* ((root (make-instance 'composition-window :text "Advanced interaction" :width 1000 :height 850))
        (controller (composition-controller root))
        (books (lut:add-child root (lut:make-widget 'lut:paned :height 190)))
        (left (lut:add-child books (composition-book controller root "Left")))
        (right (lut:add-child books (composition-book controller root "Right")))
        (toolbar (lut:add-child root (lut:make-widget 'lut:header-bar :height 48)))
        (status (lut:make-widget 'lut:label :text "Tab closes request application approval. File drops only report paths." :height 55))
        (card (lut:add-child root (lut:make-widget 'composition-card :text "Drag this card to Split, or click for keyboard drag" :height 42)))
        (split (lut:add-child root (lut:make-widget 'lut:split-drop-zone :height 90 :split-edge :right)))
        (scroll (lut:add-child root (lut:make-widget 'lut:scroll-view :height 130)))
        (files (lut:add-child root (lut:make-widget 'lut:drop-zone :height 80
          :drop-predicate (lambda (w s e) (declare (ignore w e)) (typep (lut:drag-payload s) 'lut:os-drop))
          :drop-function (lambda (w s e) (declare (ignore w e))
            (setf (lut:text status) (format nil "OS paths: ~s" (lut:os-drop-data (lut:drag-payload s)))) t)))))
   (declare (ignore right))
   (lut:add-child split (lut:make-widget 'lut:label :text "Split: drop a card here to compose a paned container"))
   (lut:add-child files (lut:make-widget 'lut:label :text "Drop files from Finder here (incoming paths only; no files are read)"))
   (lut:add-child root status)
   (lut:add-child toolbar (action "Clear protected badges" (lambda ()
     (dolist (window (lut::drag-windows controller))
       (lut:walk-widgets window (lambda (node) (setf (lut:tab-badge node) nil)))))))
   (lut:add-child toolbar (action "Open peer window" (lambda ()
     (unless (and (composition-peer root) (not (lut:disposed-p (composition-peer root))))
       (let ((peer (lut:make-widget 'lut:window :text "Peer for keyboard/programmatic transfers" :width 600 :height 350 :content-layout :fill)))
         (lut:add-child peer (composition-book controller peer "Peer"))
         (setf (composition-peer root) peer) (lut:spawn-window peer))))))
   (lut:on card :activate (lambda (w payload) (declare (ignore payload))
     (lut:begin-keyboard-drag w w) (lut:keyboard-drag-to root split)
     (setf (lut:text status) "Keyboard drag: Tab cycles zones, arrows move, Enter drops, Escape cancels.")) :owner root)
   (dotimes (i 18)
     (let ((i i))
       (let ((zone (lut:add-child scroll (lut:make-widget 'lut:drop-zone :height 40
         :drop-predicate (lambda (w s e) (declare (ignore w e)) (typep (lut:drag-payload s) 'composition-card))
         :drop-function (lambda (w s e) (declare (ignore w s e)) (setf (lut:text status) (format nil "Dropped on row ~d" i)) t)))))
         (lut:add-child zone (lut:make-widget 'lut:label :text (format nil "Drop row ~d; hold near an edge to scroll" i))))))
   (lut:select-page left 0) root))
