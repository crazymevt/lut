(in-package #:lut-gtk-demo)
(defun path-tokens (text)
 (let ((tokens nil) (i 0) (n (length text)))
   (labels ((digit () (and (< i n) (digit-char-p (char text i))))
            (sign () (when (and (< i n) (find (char text i) "+-")) (incf i))))
     (loop while (< i n) for ch = (char text i) do
       (cond ((find ch '(#\Space #\Tab #\Newline #\Return #\,)) (incf i))
             ((alpha-char-p ch) (push ch tokens) (incf i))
             (t (let ((start i))
                  (sign) (loop while (digit) do (incf i))
                  (when (and (< i n) (char= (char text i) #\.)) (incf i) (loop while (digit) do (incf i)))
                  (when (and (< i n) (find (char text i) "eE")) (incf i) (sign) (loop while (digit) do (incf i)))
                  (when (= start i) (error "Invalid path character ~a" ch))
                  (let ((*read-eval* nil))
                    (let ((value (read-from-string text t nil :start start :end i)))
                      (unless (realp value) (error "Invalid coordinate")) (push value tokens))))))))
   (nreverse tokens)))
(defun bezier-point (a b c d u)
 (labels ((component (axis)
            (+ (* (expt (- 1 u) 3) (funcall axis a)) (* 3 (expt (- 1 u) 2) u (funcall axis b))
               (* 3 (- 1 u) u u (funcall axis c)) (* u u u (funcall axis d)))))
   (point (component #'first) (component #'second))))
(defun flatten-path (text &optional (samples 12))
 "Flatten SVG M/L/H/V/C/S/Q/T/Z paths into separate contours, including relative and repeated commands."
 (let ((tokens (path-tokens text)) (command nil) (current '(0 0)) (start '(0 0))
       (control nil) (previous nil) (contour nil) (contours nil))
   (labels ((next-number () (unless (and tokens (numberp (first tokens))) (error "Missing coordinate for ~a" command)) (pop tokens))
            (coordinate () (let ((p (point (next-number) (next-number))))
                             (if (lower-case-p command) (mapcar #'+ current p) p)))
            (line-to (p) (push p contour) (setf current p))
            (finish () (when contour (push (nreverse contour) contours) (setf contour nil)))
            (cubic (b c end)
              (let ((from current))
                (loop for i from 1 to samples do (line-to (bezier-point from b c end (/ i samples)))))
              (setf control c)))
     (loop while tokens do
       (when (characterp (first tokens)) (setf command (pop tokens)))
       (unless command (error "Path needs an initial command"))
       (let ((relative (lower-case-p command)))
         (case (char-upcase command)
           (#\M (let ((p (coordinate))) (finish) (setf start p) (line-to p)
                  (setf command (if relative #\l #\L))))
           (#\L (line-to (coordinate)) (setf control nil))
           (#\H (let ((x (next-number))) (line-to (point (if relative (+ x (first current)) x) (second current)))))
           (#\V (let ((y (next-number))) (line-to (point (first current) (if relative (+ y (second current)) y)))))
           (#\C (let ((b (coordinate)) (c (coordinate)) (end (coordinate))) (cubic b c end)))
           (#\S (let ((b (if (and control (find previous "CcSs"))
                             (mapcar (lambda (p c) (- (* 2 p) c)) current control) current))
                       (c (coordinate)) (end (coordinate))) (cubic b c end)))
           ((#\Q #\T)
            (let* ((q (if (char= (char-upcase command) #\Q) (coordinate)
                         (if (and control (find previous "QqTt"))
                             (mapcar (lambda (p c) (- (* 2 p) c)) current control) current)))
                   (end (coordinate))
                   (b (point-lerp current q 2/3)) (c (point-lerp end q 2/3)))
              (cubic b c end) (setf control q)))
           (#\Z (line-to start) (finish) (setf command nil control nil))
           (otherwise (error "Unsupported path command ~a" command))))
       (setf previous command)) (finish)) (nreverse contours)))
(defun path-length (points)
 (loop for (a b) on points while b sum (distance a b)))
(defvar *world-paths* nil)
(defun world-paths ()
 (or *world-paths*
     (setf *world-paths*
       (mapcar (lambda (contour) (mapcar (lambda (p) (point (* 0.4 (first p)) (* 0.4 (second p)))) contour))
         (flatten-path (uiop:read-file-string (asdf:system-relative-pathname "lut" "examples/assets/path-world.txt")))))))
(defun world-point (progress)
 (let* ((paths (world-paths)) (lengths (mapcar #'path-length paths))
        (remaining (* (clamp progress 0 1) (reduce #'+ lengths))))
   (loop for p in paths for length in lengths
         when (<= remaining length) return (path-point p (/ remaining (max 0.0001 length)))
         do (decf remaining length) finally (return (caar paths)))))
(defun world-operations () (loop for path in (world-paths) collect (op :polyline path 1 :gray)))
(defdemo "path_explorer_demo" "Editable relative/absolute line and Bezier contours with control samples, stroke width and validation."
 (let* ((root (graphic-root "Path explorer" :path_explorer_demo
   (lambda (c) (let ((r (scene-root c)))
     (loop for path in (state r :paths) append
       (cons (op :polyline path (state r :stroke) :blue)
             (when (state r :points) (loop for p in path collect (op :circle (first p) (second p) 2 :red)))))))
   :controls '((:stroke "Stroke width" 1 20 3)) :height 220))
        (code (node 'lut:entry :path-code :text "M 40 180 C 120 10 300 10 380 180 L 40 180 Z")))
   (setf (state root :paths) (flatten-path (lut:text code))) (lut:add-child root code)
   (add-action root :points "Show sample points" (lambda () (setf (state root :points) (not (state root :points)))))
   (add-action root :apply "Apply path" (lambda () (handler-case
     (progn (setf (state root :paths) (flatten-path (lut:text code))) (status root "Valid path"))
     (error (e) (status root (princ-to-string e)))))) root)
 (set-entry (control root :path-code) "m 10 20 l 30 0 l 0 40 z") (press root :apply)
 (assert (equal '(40 60) (third (first (state root :paths)))) )
 (press root :points) (assert (find :circle (operations root) :key #'first))
 (set-entry (control root :path-code) "M nope") (press root :apply) (assert (not (string= "Valid path" (lut:text (control root :status))))))
(defun shape-path (root)
 (let ((r (state root :radius 100)))
   (loop for i below 10 for angle = (+ (- (/ pi 2)) (* i (/ pi 5)))
         for radius = (if (evenp i) r (* r 0.45))
         collect (point (+ 320 (* radius (cos angle))) (+ 160 (* radius (sin angle)))))))
(defdemo "path_fill" "Complex closed-path fill/stroke with adjustable geometry and exportable path data."
 (let ((root (graphic-root "Path fill and stroke" :path_fill
   (lambda (c) (let* ((r (scene-root c)) (points (shape-path r)))
     (append (when (state r :fill t) (list (op :polygon points :gold)))
       (list (op :polyline (append points (list (first points))) (state r :stroke) :maroon)))))
   :controls '((:radius "Radius" 30 140 100) (:stroke "Stroke width" 1 30 4)))))
   (setf (state root :fill) t)
   (add-action root :fill "Toggle fill" (lambda () (setf (state root :fill) (not (state root :fill))))) root)
 (assert (eq :polygon (caar (operations root)))) (press root :fill)
 (assert (= 1 (length (operations root))))
 (set-number root :radius 60) (assert (near 60 (distance '(320 160) (first (shape-path root))))))
(defdemo "path_spinner" "Animated curved-path spinner with adjustable width and round endpoints."
 (graphic-root "Path spinner" :path_spinner
   (lambda (c) (let* ((r (scene-root c)) (time (state r :time))
                     (points (loop for i from 0 to 36 for a = (+ time (* i (/ pi 24)))
                              collect (point (+ 320 (* 80 (cos a))) (+ 160 (* 80 (sin a)))))))
     (list (op :polyline points (state r :stroke) :skyblue)
           (op :circle (caar points) (cadar points) (/ (state r :stroke) 2) :skyblue)
           (op :circle (first (car (last points))) (second (car (last points))) (/ (state r :stroke) 2) :skyblue))))
   :controls '((:stroke "Stroke width" 1 30 10)))
 (assert (= 37 (length (second (first (operations root)))))) (check-animation root))
(defdemo "path_walk" "Objects move by distance along the original complex world-map contours, with speed/population controls."
 (graphic-root "World path walk" :path_walk
   (lambda (c) (let ((r (scene-root c)))
     (append (world-operations) (loop for i below (round (state r :count))
       for p = (world-point (mod (+ (* (state r :time) (state r :speed)) (/ i (state r :count))) 1))
       collect (op :circle (first p) (second p) 4 :red)))))
   :controls '((:speed "Speed" 0.01 0.5 0.1) (:count "Walkers" 1 30 8)))
 (assert (> (length (world-paths)) 100))
 (assert (= 8 (count :circle (operations root) :key #'first))) (check-animation root))
(defun sweep-intersections (x)
 (loop for path in (world-paths) append
   (loop for (a b) on path while b
     when (and (/= (first a) (first b)) (<= (min (first a) (first b)) x) (< x (max (first a) (first b))))
     collect (point x (lerp (second a) (second b) (/ (- x (first a)) (- (first b) (first a))))))))
(defdemo "path_sweep" "Sweep-line intersections against the original world-map contours."
 (graphic-root "Path sweep" :path_sweep
   (lambda (c) (let* ((r (scene-root c)) (x (state r :x)))
     (append (world-operations) (list (op :line x 0 x 310 2 :red))
       (loop for p in (sweep-intersections x) collect (op :circle (first p) (second p) 3 :maroon)))))
   :controls '((:x "Sweep position" 0 640 320)))
 (let ((hits (sweep-intersections 320))) (assert (plusp (length hits))) (assert (every (lambda (p) (= 320 (first p))) hits))))
(defun wave-path () (loop for x from 20 to 620 by 5 collect (point x (+ 160 (* 60 (sin (/ x 70)))))))
(defun text-along-path (root)
 (let* ((path (wave-path)) (text (state root :phrase "Common Lisp follows paths")))
   (loop for char across text for i from 0
     for u = (clamp (+ (state root :offset 0) (* 0.025 i)) 0 0.999)
     for p = (path-point path u) for q = (path-point path (+ u 0.001))
     collect (op :text (string char) (first p) (second p) 24 (if (evenp i) :blue :maroon)
                 (* (/ 180 pi) (atan (- (second q) (second p)) (- (first q) (first p))))))))
(defdemo "path_text" "Text glyphs follow a curved baseline with tangent rotation and variable offset."
 (let* ((root (graphic-root "Text along a path" :path_text
                (lambda (c) (cons (op :polyline (wave-path) 1 :gray) (text-along-path (scene-root c))))
                :controls '((:offset "Text offset" 0 0.3 0))))
        (entry (node 'lut:entry :phrase :text "Common Lisp follows paths")))
   (setf (state root :phrase) (lut:text entry)) (changed entry (lambda (w text) (declare (ignore w)) (setf (state root :phrase) text)) root)
   (lut:add-child root entry) root)
 (edit root :phrase "Lisp") (assert (= 4 (length (text-along-path root))))
 (let ((before (text-along-path root))) (set-number root :offset 0.2) (assert (not (equalp before (text-along-path root))))))
(defun maze-route ()
 (loop for row below 7 append
   (if (evenp row) (list (point 20 (+ 20 (* row 40))) (point 620 (+ 20 (* row 40))))
       (list (point 620 (+ 20 (* row 40))) (point 20 (+ 20 (* row 40)))))))
(defdemo "path_maze" "Pointer maze checks distance from a narrow route and resets progress when leaving the corridor."
 (graphic-root "Path maze" :path_maze
   (lambda (c) (let ((r (scene-root c)))
     (append (list (op :polyline (maze-route) 18 :lightgray) (op :circle 20 20 10 :green)
                   (op :circle 620 260 10 :red))
       (when (state r :pointer) (list (op :circle (first (state r :pointer)) (second (state r :pointer)) 5 :blue))))))
   :input (lambda (r c e) (when (member (lut:event-kind e) '(:move :down))
     (let ((p (point (- (lut:event-x e) (lut:x c)) (- (lut:event-y e) (lut:y c)))))
       (setf (state r :pointer) p)
       (if (< (path-distance p (maze-route)) 9)
           (progn (setf (state r :on-path) t) (when (< (distance p '(620 260)) 12) (setf (state r :won) t)))
           (setf (state r :on-path) nil (state r :won) nil)))) t))
 (let ((c (control root :canvas)))
   (lut:handle-event c (lut:make-event :kind :move :x (+ 100 (lut:x c)) :y (+ 20 (lut:y c)))) (assert (state root :on-path))
   (lut:handle-event c (lut:make-event :kind :move :x (+ 100 (lut:x c)) :y (+ 40 (lut:y c)))) (assert (not (state root :on-path)))))
