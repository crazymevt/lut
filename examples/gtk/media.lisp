(in-package #:lui-gtk-demo)
(defclass icon-paintable (lui:widget)
 ((phase :initform 0 :accessor icon-phase) (foreground :initform :black :accessor icon-foreground)
  (background :initform :gold :accessor icon-background) (emblem :initform nil :accessor icon-emblem)))
(defun icon-operations (icon x y size)
 (let ((radius (* size 0.45)))
  (append (list (op :circle x y radius (icon-background icon)))
   (loop for blade below 3 for a = (+ (icon-phase icon) (* blade (/ (* 2 pi) 3)))
    collect (op :polygon
     (append (list (point x y))
      (loop for i from 0 to 10 for angle = (+ a (* (/ pi 3) (/ i 10)))
       collect (point (+ x (* radius 0.85 (cos angle))) (+ y (* radius 0.85 (sin angle)))))) (icon-foreground icon)))
   (list (op :circle x y (* size 0.12) (icon-background icon))
         (op :circle x y (* size 0.07) (icon-foreground icon)))
   (when (icon-emblem icon)
    (list (op :circle (+ x (* size 0.3)) (+ y (* size 0.3)) (* size 0.17) :green)
          (op :text "✓" (+ x (* size 0.22)) (+ y (* size 0.2)) (* size 0.2) :white))))))
(defun paintable-demo (kind)
 (let* ((icon (make-instance 'icon-paintable))
        (r (graphic-root "Paintable" kind
          (lambda (c) (let ((r (scene-root c)))
           (append (icon-operations (state r :icon) 160 150 220)
                   (icon-operations (state r :icon) 430 110 100)
                   (icon-operations (state r :icon) 540 180 50))))
          :controls (when (eq kind :paintable_mediastream) '((:position "Position (seconds)" 0 10 0))))))
  (own r icon) (setf (state r :icon) icon (state r :duration) 10)
  (when (member kind '(:paintable_animated :paintable_mediastream))
   (lui:on r :tick (lambda (w dt) (declare (ignore w dt))
    (setf (icon-phase icon) (* 2 pi (/ (mod (state r :time) 10) 10))
          (state r :position) (mod (state r :time) 10))) :owner icon))
  (when (eq kind :paintable_mediastream)
   (changed (control r :position) (lambda (w v) (declare (ignore w))
    (setf (state r :time) v (state r :position) v (icon-phase icon) (* 2 pi (/ v 10)))) icon))
  (when (eq kind :paintable_emblem)
   (setf (icon-emblem icon) t)
   (add-action r :emblem "Toggle emblem" (lambda () (setf (icon-emblem icon) (not (icon-emblem icon))))))
  (when (eq kind :paintable_symbolic)
   (add-action r :palette "Theme colors" (lambda ()
    (setf (lui:theme r) (if (eq (lui:theme r) lui:*dark-theme*) lui:*light-theme* lui:*dark-theme*)
          (icon-foreground icon) (lui:style-value r :foreground) (icon-background icon) (lui:style-value r :accent))))) r))
(defun paintable-check (root)
 (assert (= 18 (length (operations root))))
 (let ((icon (state root :icon))) (lui:dispose root) (assert (lui:disposed-p icon))))
(defdemo "paintable" "Reusable intrinsic-independent vector paintable is displayed at three sizes and shares one owned drawing model."
 (paintable-demo :paintable) (paintable-check root))
(defdemo "paintable_animated" "One animated paintable invalidates three differently sized views, with play/pause and restart."
 (paintable-demo :paintable_animated) (check-animation root) (paintable-check root))
(defdemo "paintable_emblem" "Composed paintable overlays a toggleable emblem on the same icon at several sizes."
 (paintable-demo :paintable_emblem) (assert (= 24 (length (operations root))))
 (press root :emblem) (assert (= 18 (length (operations root)))))
(defdemo "paintable_mediastream" "Procedural paintable acts as a seekable ten-second looping media stream with pause, position and restart."
 (paintable-demo :paintable_mediastream)
 (set-number root :position 5) (assert (near pi (icon-phase (state root :icon))))
 (tick root 1) (assert (near 6 (state root :position)))
 (press root :pause) (tick root 2) (assert (near 6 (state root :position))))
(defdemo "paintable_symbolic" "Symbolic paintable derives foreground/accent colors from the active application theme."
 (paintable-demo :paintable_symbolic)
 (press root :palette) (assert (equal (icon-foreground (state root :icon)) (lui:style-value root :foreground)))
 (assert (not (equal :black (icon-foreground (state root :icon))))))
(defclass video-frames (lui:widget)
 ((directory :initarg :directory :initform nil :accessor frame-directory)
  (audio :initarg :audio :initform nil :accessor frame-audio)
  (files :initarg :files :accessor frame-files) (fps :initarg :fps :reader frame-rate)))
(defmethod lui:dispose :after ((resource video-frames))
 (when (frame-directory resource)
  (uiop:delete-directory-tree (frame-directory resource) :validate t :if-does-not-exist :ignore))
 (setf (frame-files resource) nil (frame-directory resource) nil (frame-audio resource) nil))
(defun decode-video (path)
 "FFmpeg is optional at runtime; cap one clip at 600 640px frames (60 seconds)."
 (unless (probe-file path) (error "Video file does not exist: ~a" path))
 (let ((directory (merge-pathnames (format nil "lui-video-~36r/" (random (expt 36 16))) (uiop:temporary-directory)))
       (success nil))
  (ensure-directories-exist directory)
  (unwind-protect
   (progn
    (uiop:run-program (list "ffmpeg" "-nostdin" "-v" "error" "-i" (namestring (pathname path)) "-an"
                       "-vf" "fps=10,scale=640:-2" "-frames:v" "600" (namestring (merge-pathnames "frame-%06d.png" directory)))
                      :output nil :error-output :string)
    ;; An absent audio stream is legitimate. FFmpeg reports that case with nonzero status.
    (uiop:run-program (list "ffmpeg" "-nostdin" "-v" "error" "-i" (namestring (pathname path))
                       "-vn" "-t" "60" "-acodec" "pcm_s16le" "-ar" "44100" "-ac" "2"
                       (namestring (merge-pathnames "audio.wav" directory)))
                     :output nil :error-output :string :ignore-error-status t)
    (let ((files (sort (directory (merge-pathnames "frame-*.png" directory)) #'string< :key #'namestring)))
     (unless files (error "No video frames decoded."))
     (prog1 (make-instance 'video-frames :directory directory :files (coerce files 'vector) :fps 10
               :audio (probe-file (merge-pathnames "audio.wav" directory)))
      (setf success t))))
   (unless success (uiop:delete-directory-tree directory :validate t :if-does-not-exist :ignore)))))
(defun load-video (root)
 (handler-case
  (let ((resource (funcall (state root :decoder #'decode-video) (lui:text (control root :path)))))
   (let ((music (state root :music-resource)))
    (when music (lui:dispose music)
     (setf (native-resources root) (remove music (native-resources root)) (state root :music-resource) nil)))
   (let ((old (state root :video)))
    (when old (lui:dispose old) (setf (resources root) (remove old (resources root)))))
   (setf (state root :video) (own root resource) (state root :time) 0
         (state root :duration) (/ (length (frame-files resource)) (frame-rate resource)))
   (status root (format nil "~d frames; ~,1f seconds; ~a" (length (frame-files resource)) (state root :duration)
     (if (frame-audio resource) "audio available" "silent video"))))
  (error (e) (status root (princ-to-string e)))))
(defun video-position (root)
 (let ((duration (state root :duration 0)))
  (if (plusp duration)
   (if (state root :loop t) (mod (state root :time) duration) (min (state root :time) (- duration 0.0001))) 0)))
(defdemo "video_player" "Load real video through optional FFmpeg; bounded decoded frames, play/pause, seek, looping and deterministic temporary-file cleanup with synchronized audio when present."
 (let ((r (graphic-root "Video player" :video_player
  (lambda (c) (let* ((r (scene-root c)) (video (state r :video)))
   (if video (let ((index (min (1- (length (frame-files video))) (floor (* (video-position r) (frame-rate video))))))
              (append (list (op :image (aref (frame-files video) index) 0 0 640 340))
                (when (frame-audio video) (list (op :sound (frame-audio video) (video-position r) (state r :running) (state r :volume 0.7))))))
       (list (op :text "Load a video to begin (FFmpeg required)" 20 100 22 :black)))))
  :controls '((:seek "Seek fraction" 0 1 0) (:volume "Volume" 0 1 0.7)))))
  (lui:add-child r (node 'lui:entry :path :text (namestring (asdf:system-relative-pathname "lui" "examples/assets/demo.webm"))))
  (changed (control r :seek) (lambda (w v) (declare (ignore w)) (setf (state r :time) (* v (state r :duration 0)))) r)
  (add-action r :load "Load video" (lambda () (load-video r)))
  (add-action r :loop "Toggle loop" (lambda () (setf (state r :loop) (not (state r :loop t))))) r)
 (setf (state root :decoder) (lambda (path) (declare (ignore path))
  (make-instance 'video-frames :files (vector (sample-image) (sample-image)) :fps 2)))
 (press root :load) (assert (= 1 (state root :duration)))
 (set-number root :seek 0.5) (assert (= 0.5 (video-position root)))
 (tick root 0.75) (assert (= 0.25 (video-position root)))
 (press root :loop) (assert (< 0.99 (video-position root) 1))
 (let ((video (state root :video))) (lui:dispose root) (assert (null (frame-files video)))))
(defun paginate-text (text &optional (lines-per-page 48) (columns 78))
 (let ((lines (loop for line in (list-of-strings text) append
              (if (zerop (length line)) (list "")
               (loop for start from 0 below (length line) by columns collect (subseq line start (min (length line) (+ start columns))))))))
  (or (loop for start from 0 below (length lines) by lines-per-page collect (subseq lines start (min (length lines) (+ start lines-per-page))))
      (list (list "")))))
(defun print-pdf (text path first-page last-page)
 (let* ((pages (paginate-text text)) (count (length pages)))
  (unless (<= 1 first-page last-page count) (error "Page range must be within 1..~d." count))
  (unless (every (lambda (c) (< (char-code c) 256)) text) (error "PDF standard font requires Latin-1 text."))
  (pdf:with-document ()
   (loop for page in pages for number from 1 when (<= first-page number last-page) do
    (pdf:with-page ()
     (pdf:in-text-mode
      (pdf:set-font (pdf:get-font "Courier") 10)
      (loop for line in page for y from 780 downto 50 by 15 do
       (pdf:set-text-matrix 1 0 0 1 48 y) (pdf:draw-text line))
      (pdf:set-text-matrix 1 0 0 1 48 30) (pdf:draw-text (format nil "Page ~d / ~d" number count)))))
   (pdf:write-document path))))
(defdemo "printing" "Paginated editable document preview and real PDF export with page range, wrapping and page numbers using portable CL-PDF."
 (let ((r (app "Printing" (node 'lui:text-view :source :height 210 :text (format nil "LUI printing demo~%~%Edit this document, preview pages and export a PDF."))
               (node 'lui:entry :path :text (namestring (merge-pathnames "lui-print.pdf" (user-homedir-pathname))))
               (node 'lui:spin-button :first :minimum 1 :maximum 10000 :value 1)
               (node 'lui:spin-button :last :minimum 1 :maximum 10000 :value 1)
               (node 'lui:label :preview :height 110) (labeled :status "Ready"))))
  (add-action r :preview-button "Preview selected page" (lambda ()
   (let* ((pages (paginate-text (lui:text (control r :source)))) (index (1- (round (lui:value (control r :first))))))
    (if (< -1 index (length pages))
     (setf (lui:text (control r :preview)) (format nil "Page ~d of ~d~%~{~a~%~}" (1+ index) (length pages) (nth index pages)))
     (status r "Page out of range")))))
  (add-action r :export "Export PDF" (lambda ()
   (handler-case (progn (print-pdf (lui:text (control r :source)) (lui:text (control r :path))
                           (round (lui:value (control r :first))) (round (lui:value (control r :last)))) (status r "PDF exported"))
    (error (e) (status r (princ-to-string e)))))) r)
 (edit root :source (format nil "~{~a~%~}" (loop for i below 100 collect (format nil "Line ~d" i))))
 (assert (= 3 (length (paginate-text (lui:text (control root :source))))))
 (set-number root :first 2) (set-number root :last 2) (press root :preview-button)
 (assert (search "Page 2 of 3" (lui:text (control root :preview))))
 (uiop:with-temporary-file (:pathname path :keep nil)
  (edit root :path (namestring path)) (press root :export)
  (with-open-file (in path :element-type '(unsigned-byte 8))
   (assert (equal '(37 80 68 70 45) (loop repeat 5 collect (read-byte in)))))))
