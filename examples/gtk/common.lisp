(in-package #:lut-gtk-demo)
(defun state (root key &optional default) (getf (model root) key default))
(defun (setf state) (value root key &optional default) (declare (ignore default)) (setf (getf (model root) key) value))
(defun own (root resource) (push resource (resources root)) resource)
(defun add-action (root id caption function &optional owner)
 (let ((button (node 'lut:button id :text caption)))
   (lut:on button :activate (lambda (w payload) (declare (ignore w payload)) (funcall function)) :owner (or owner root))
   (lut:add-child root button)))
(defun changed (widget callback &optional owner) (lut:on widget :change callback :owner owner))
(defun edit (root id string)
 (let ((entry (control root id))) (lut:focus root entry) (lut:select-all entry)
   (lut:dispatch root (lut:make-event :kind :text :text string))))
(defun tick (root seconds) (lut:emit root :tick seconds))
(defun set-entry (entry string)
 (let ((lut::*record-history* nil)) (setf (lut:text entry) string)))
(defun status (root string) (setf (lut:text (control root :status)) string))
(defun labeled (id caption &rest args) (apply #'node 'lut:label id :text caption args))
(defun choose-index (root id index)
 (let ((list (control root id))) (setf (lut:value list) index) (lut:emit list :change index)))
(defun set-number (root id value)
 (let ((slider (control root id))) (setf (lut:value slider) value) (lut:emit slider :change value)))
(defun list-of-strings (lines)
 (with-input-from-string (s lines) (loop for line = (read-line s nil) while line collect line)))
(defun search-name (string)
 (remove-if (lambda (char) (find char '(#\Space #\Tab #\Newline #\Return #\_ #\-)))
            (string-downcase string)))
(defun demo-match-score (query name)
 "Rank exact, prefix, substring, then compact ordered-subsequence matches."
 (let* ((needle (search-name query)) (haystack (search-name name))
        (length (length needle)) (direct (search needle haystack)))
   (cond ((zerop length) 0)
         ((string= needle haystack) 0)
         (direct (+ (if (zerop direct) 100 200) (* 2 direct) (length haystack)))
         (t (let ((next 0) (start nil) (end 0))
              (loop for char across needle for index = (position char haystack :start next) do
                (unless index (return-from demo-match-score nil))
                (unless start (setf start index))
                (setf end index next (1+ index)))
              (+ 1000 (* 8 (- (1+ (- end start)) length)) (* 2 start) (length haystack)))))))
(defun fuzzy-demo-names (query)
 (mapcar #'car
   (stable-sort (loop for name in (demo-names) for score = (demo-match-score query name)
                      when score collect (cons name score)) #'< :key #'cdr)))
(defun browser ()
 "Interactive fuzzy-search launcher for the registered GTK demo ports. Run with LUT/RAYLIB."
 (let* ((query (node 'lut:entry :query)) (list (node 'lut:list-view :demos :height 380 :items (demo-names)))
        (info (labeled :description "Select a demo" :height 90 :style '(:wrap-text t))) (root (app "LUT GTK demo suite" query list info)))
   (changed query (lambda (w text) (declare (ignore w))
     (let ((matches (fuzzy-demo-names text)))
       (setf (lut:items list) matches (lut:value list) (when matches 0)
             (lut:scroll-offset list) 0
             (lut:text info) (if matches
                 (second (find (first matches) *demos* :key #'first :test #'string=))
                 "No demos match your search.")))) root)
   (changed list (lambda (w index)
     (let ((record (find (nth index (lut:items w)) *demos* :key #'first :test #'string=)))
       (setf (lut:text info) (second record)))) root)
   (add-action root :run "Open selected demo" (lambda ()
     (when (lut:value list) (lut:start (demo (nth (lut:value list) (lut:items list)))))))
   (lut:on query :activate (lambda (w payload) (declare (ignore w payload))
     (lut:emit (control root :run) :activate nil)) :owner root)
   root))
(defclass scene (lut:drawing-area lut:button)
 ((root :initarg :root :accessor scene-root) (kind :initarg :kind :reader scene-kind)
  (painter :initarg :painter :reader painter) (input :initarg :input :initform nil :accessor scene-input)))
(defmethod initialize-instance :after ((w scene) &key)
 (when (scene-input w)
  (lut:on w :context (lambda (sender e) (lut:handle-event sender e)) :owner w)))
(defmethod lut:dispose :after ((w scene)) (setf (scene-root w) nil (scene-input w) nil))
(defgeneric paint-operations (scene))
(defmethod paint-operations ((w scene)) (funcall (painter w) w))
(defun scene (root kind painter &key input (height 340))
 (let ((w (make-instance 'scene :id :canvas :root root :kind kind :painter painter :input input :height height)))
   (setf (lut:draw-function w) (lambda (w)
     (unless (find-package :lut-gtk-demo-native) (asdf:load-system "lut/gtk-demo-native"))
     (uiop:symbol-call :lut-gtk-demo-native :paint w))) w))
(defmethod lut:handle-event ((w scene) event)
 (when (scene-input w) (funcall (scene-input w) (scene-root w) w event)))
(defun op (kind &rest args) (cons kind args))
(defun operations (root) (paint-operations (control root :canvas)))
(defun clamp (number low high) (max low (min high number)))
(defun near (a b &optional (epsilon 0.001)) (< (abs (- a b)) epsilon))
(defun point (x y) (list x y))
(defun distance (a b) (sqrt (+ (expt (- (first a) (first b)) 2) (expt (- (second a) (second b)) 2))))
(defun lerp (a b t0) (+ a (* (- b a) t0)))
(defun point-lerp (a b t0) (list (lerp (first a) (first b) t0) (lerp (second a) (second b) t0)))
(defun path-point (points progress)
 (let* ((lengths (loop for (a b) on points while b collect (distance a b)))
        (remaining (* (clamp progress 0 1) (reduce #'+ lengths :initial-value 0))))
   (loop for (a b) on points for length in lengths
         when (<= remaining length) return (point-lerp a b (if (zerop length) 0 (/ remaining length)))
         do (decf remaining length) finally (return (car (last points))))))
(defun point-segment-distance (p a b)
 (let* ((dx (- (first b) (first a))) (dy (- (second b) (second a))) (den (+ (* dx dx) (* dy dy)))
        (u (if (zerop den) 0 (clamp (/ (+ (* (- (first p) (first a)) dx) (* (- (second p) (second a)) dy)) den) 0 1))))
   (distance p (point-lerp a b u))))
(defun path-distance (p path)
 (loop for (a b) on path while b minimize (point-segment-distance p a b)))
(defun bind-text (root &rest entries)
 (let ((guard nil))
   (dolist (entry entries)
     (changed entry (lambda (sender text)
       (unless guard (let ((guard t))
         (dolist (other entries) (unless (eq sender other) (set-entry other text)))))) root))))
