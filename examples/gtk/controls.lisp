(in-package #:lui-gtk-demo)
(defdemo "assistant" "Four-page guided operation with required data, optional preferences, confirmation, progress and cancellation."
 (let* ((pages (node 'lui:stack :pages :height 240)) (name (node 'lui:entry :name))
        (option (node 'lui:check-button :backup :text "Create backup"))
        (progress (node 'lui:progress-bar :progress :value 0 :maximum 1))
        (root (app "Assistant" pages (labeled :status "Enter a name to continue"))))
   (setf (state root :phase) :input)
   (lui:add-child pages (lui:with-ui (lui:box) (labeled :instruction "A name is required") name))
   (lui:add-child pages (lui:with-ui (lui:box) (labeled :optional "Optional settings") option))
   (lui:add-child pages (lui:with-ui (lui:box) (labeled :confirmation "Review, then Apply")))
   (lui:add-child pages (lui:with-ui (lui:box) progress))
   (add-action root :back "Back" (lambda () (when (> (lui:value pages) 0) (lui:select-page pages (1- (lui:value pages))))))
   (let ((next (add-action root :next "Next" (lambda ()
                 (when (and (< (lui:value pages) 2) (plusp (length (lui:text name))))
                   (lui:select-page pages (1+ (lui:value pages)))
                   (status root (format nil "Ready for ~a; backup ~a" (lui:text name) (lui:value option))))))))
     (setf (lui:enabled-p next) nil)
     (changed name (lambda (w text) (declare (ignore w)) (setf (lui:enabled-p next) (plusp (length text)))) root))
   (add-action root :apply "Apply" (lambda () (when (= 2 (lui:value pages))
     (setf (state root :phase) :applying (lui:value progress) 0) (lui:select-page pages 3))))
   (add-action root :cancel "Cancel" (lambda () (setf (state root :phase) :cancelled) (status root "Cancelled")))
   (lui:on root :tick (lambda (w dt) (declare (ignore w))
     (when (eq (state root :phase) :applying)
       (setf (lui:value progress) (min 1 (+ (lui:value progress) (* 0.5 dt))))
       (when (= 1 (lui:value progress)) (setf (state root :phase) :complete) (status root "Complete")))) :owner root) root)
 (assert (not (lui:enabled-p (control root :next))))
 (edit root :name "Ada") (press root :next) (press root :next) (press root :apply)
 (tick root 1) (assert (near 0.5 (lui:value (control root :progress))))
 (tick root 1) (assert (eq :complete (state root :phase)))
 (press root :cancel) (assert (eq :cancelled (state root :phase))))
(defun editor-application (title)
 (let* ((path (node 'lui:entry :path :text (namestring (merge-pathnames "lui-demo.txt" (user-homedir-pathname)))))
        (body (node 'lui:text-view :document :height 280))
        (menu (node 'lui:menu-bar :menu :height 48))
        (root (app title menu path body (labeled :status "Ready"))))
   (labels ((new () (set-entry body "") (setf (state root :dirty) nil) (status root "New document"))
            (save () (with-open-file (out (lui:text path) :direction :output :if-exists :supersede :if-does-not-exist :create)
                       (write-string (lui:text body) out))
                     (setf (state root :dirty) nil) (status root "Saved"))
            (open-file () (set-entry body (uiop:read-file-string (lui:text path)))
                         (setf (state root :dirty) nil) (status root "Opened")))
     (dolist (spec (list (list :new "New" #'new) (list :open "Open" #'open-file) (list :save "Save" #'save)))
       (lui:add-child menu (action (first spec) (second spec) (third spec))))
     (lui:bind-key root :control-n #'new :owner root)
     (lui:bind-key root :control-o #'open-file :owner root)
     (lui:bind-key root :control-s #'save :owner root))
   (changed body (lambda (w text) (declare (ignore w))
     (setf (state root :dirty) t) (status root (format nil "Modified: ~d characters" (length text)))) root)
   (add-action root :about "About" (lambda ()
     (let ((d (node 'lui:dialog :about-dialog :text "About" :width 360 :height 180)))
       (lui:add-child d (labeled :about-text "A portable CLOS document application"))
       (lui:add-child d (action :close-about "Close" (lambda () (lui:dismiss-dialog d)))) (lui:show-dialog root d)))) root))
(defun editor-behavior (root)
 (uiop:with-temporary-file (:pathname path)
   (set-entry (control root :path) (namestring path))
   (edit root :document "A saved document") (assert (state root :dirty)) (press root :save)
   (assert (string= "A saved document" (uiop:read-file-string path)))
   (press root :new) (assert (string= "" (lui:text (control root :document)))) (press root :open)
   (assert (string= "A saved document" (lui:text (control root :document))))
   (lui:dispatch root (lui:make-event :kind :key :key :control-n))
   (assert (string= "" (lui:text (control root :document))))))
(defdemo "application_demo" "Document application with menus, file IO, dirty state, about dialog and keyboard actions."
 (editor-application "Application")
 (editor-behavior root) (press root :about)
 (assert (typep (lui::input-root root) 'lui:dialog)))
(defun build-description (description)
 "Build a tree from portable Lisp data, analogous to GTK Builder's XML tree. No reader evaluation."
 (destructuring-bind (class initargs &rest children) description
   (unless (member class '(lui:box lui:header-bar lui:button lui:label lui:entry lui:text-view))
     (error "Unknown builder class ~s" class))
   (let ((widget (apply #'lui:make-widget class initargs)))
     (dolist (child children) (lui:add-child widget (build-description child))) widget)))
(defdemo "builder" "Declarative UI tree with action wiring and status/help/about menus."
 (let* ((description '(lui:box (:id :built :height 220)
                      (lui:header-bar (:height 48) (lui:button (:id :bold :text "Bold"))
                        (lui:button (:id :help :text "Help")))
                      (lui:text-view (:id :content :text "Built from data" :height 130))))
        (root (app "Builder" (build-description description) (labeled :status "Ready"))))
   (lui:on (control root :bold) :activate (lambda (w p) (declare (ignore w p))
     (setf (lui:style (control root :content)) '(:foreground :maroon)) (status root "Bold action")) :owner root)
   (lui:on (control root :help) :activate (lambda (w p) (declare (ignore w p))
     (status root "Toolbar buttons are connected after the tree is built.")) :owner root) root)
 (assert (string= "Built from data" (lui:text (control root :content))))
 (press root :bold) (assert (eq :maroon (lui:style-value (control root :content) :foreground)))
 (press root :help) (assert (search "connected" (lui:text (control root :status)))))
(defun undo-demo (multiline)
 (let* ((field (node (if multiline 'lui:text-view 'lui:entry) :editor :text "Original" :height (if multiline 300 36)))
        (enabled (node 'lui:check-button :enable :text "Enable undo" :value t))
        (root (app "Undo and redo" field enabled (labeled :status "Ctrl+Z / Ctrl+Shift+Z / Ctrl+Y"))))
   (changed enabled (lambda (w v) (declare (ignore w)) (setf (lui:history-limit field) (if v 100 0))
     (unless v (setf (lui::undo-history field) nil (lui::redo-history field) nil))) root)
   (add-action root :undo "Undo" (lambda () (lui:undo field)))
   (add-action root :redo "Redo" (lambda () (lui:redo field))) root))
(defun undo-behavior (root)
 (edit root :editor "First") (edit root :editor "Second") (press root :undo)
 (assert (string= "First" (lui:text (control root :editor)))) (press root :redo)
 (assert (string= "Second" (lui:text (control root :editor)))) (press root :undo)
 (edit root :editor "Branch") (assert (not (lui:redo (control root :editor)))))
(defdemo "entry_undo" "Entry undo/redo with enable toggle and standard key accelerators." (undo-demo nil) (undo-behavior root))
(defdemo "textundo" "Multiline buffer undo/redo with bounded history and branching edits." (undo-demo t) (undo-behavior root))
(defdemo "errorstates" "Input-validation dialog with dynamic error styling and confirmation gating."
 (let* ((name (node 'lui:entry :name)) (details (node 'lui:entry :details))
        (more (node 'lui:switch :more :text "Require details"))
        (level (node 'lui:slider :level :minimum 0 :maximum 10 :value 0))
        (root (app "Input validation" name more details level (labeled :status "Name is required"))))
   (labels ((validate ()
              (let ((bad-name (zerop (length (lui:text name))))
                    (bad-details (and (lui:value more) (< (length (lui:text details)) 5))))
                (setf (lui:style name) (when bad-name '(:border-color :red))
                      (lui:style details) (when bad-details '(:border-color :red))
                      (lui:enabled-p (control root :submit)) (not (or bad-name bad-details)))
                (status root (if (or bad-name bad-details) "Correct the highlighted fields" "Valid")))))
     (add-action root :submit "Submit" (lambda () (setf (state root :accepted) (list (lui:text name) (lui:text details) (lui:value level)))))
     (dolist (w (list name details more level)) (changed w (lambda (w v) (declare (ignore w v)) (validate)) root))
     (validate)) root)
 (assert (not (lui:enabled-p (control root :submit)))) (edit root :name "Ada")
 (press root :more) (assert (not (lui:enabled-p (control root :submit))))
 (edit root :details "Details supplied") (press root :submit) (assert (state root :accepted)))
(defdemo "read_more" "Collapsed text preview expands to full content and can be collapsed again."
 (let* ((text (format nil "First line~%Second line~%Third line~%Fourth line~%Fifth line"))
        (body (node 'lui:text-view :body :text text :height 70))
        (root (app "Read more" body)))
   (setf (state root :expanded) nil)
   (add-action root :toggle "Read more / less" (lambda ()
     (setf (state root :expanded) (not (state root :expanded))
           (lui:height body) (if (state root :expanded) 220 70)))) root)
 (press root :toggle) (assert (= 220 (lui:height (control root :body))))
 (press root :toggle) (assert (= 70 (lui:height (control root :body)))))
(defdemo "revealer" "Animated reveal/hide with reversible progress and content clipping."
 (let* ((panel (node 'lui:box :reveal :height 0))
        (root (app "Revealer" panel)))
   (lui:add-child panel (labeled :message "Revealed content"))
   (setf (state root :target) 0 (state root :progress) 0)
   (add-action root :toggle "Reveal / hide" (lambda () (setf (state root :target) (- 1 (state root :target)))))
   (lui:on root :tick (lambda (w dt) (declare (ignore w))
     (let* ((p (state root :progress)) (target (state root :target)) (delta (* dt 2)))
       (setf (state root :progress) (if (< p target) (min target (+ p delta)) (max target (- p delta)))
             (lui:height panel) (* 160 (state root :progress))))) :owner root) root)
 (press root :toggle) (tick root 0.25) (assert (= 80 (lui:height (control root :reveal))))
 (press root :toggle) (tick root 0.25) (assert (zerop (lui:height (control root :reveal)))))
(defdemo "sidebar" "Navigation sidebar automatically selects stack pages."
 (let* ((pages (node 'lui:stack :pages :height 300))
        (list (node 'lui:list-view :navigation :items '("General" "Network" "Appearance") :height 120))
        (root (app "Stack sidebar" list pages)))
   (dolist (title (lui:items list)) (lui:add-child pages (labeled (intern (string-upcase title) :keyword) title)))
   (changed list (lambda (w index) (declare (ignore w)) (lui:select-page pages index)) root) root)
 (choose-index root :navigation 2) (assert (= 2 (lui:value (control root :pages))))
 (assert (eq :appearance (lui:id (first (lui:active-children (control root :pages)))))))
(defdemo "shortcuts" "Shortcut help overlay grouped by application and editing actions."
 (let ((root (editor-application "Shortcut help")))
   (add-action root :show-shortcuts "Keyboard shortcuts" (lambda ()
     (let ((d (node 'lui:dialog :shortcuts :text "Keyboard shortcuts" :width 480 :height 300)))
       (lui:add-child d (node 'lui:table-view :bindings :height 180 :columns '("Key" "Action")
         :rows '(("Ctrl+N" "New") ("Ctrl+O" "Open") ("Ctrl+S" "Save") ("Ctrl+Z" "Undo") ("Ctrl+Y" "Redo"))))
       (lui:add-child d (action :close "Close" (lambda () (lui:dismiss-dialog d)))) (lui:show-dialog root d)))) root)
 (press root :show-shortcuts)
 (assert (= 5 (length (lui:rows (control (lui::input-root root) :bindings))))))
(defdemo "shortcut_triggers" "Single-key, chord and ordered key-sequence shortcut triggers with timeout."
 (let ((root (app "Shortcut triggers" (labeled :status "Try F1, Ctrl+S, or G then G"))))
   (setf (state root :actions) nil (state root :prefix) nil (state root :elapsed) 0)
   (flet ((record (name) (push name (state root :actions)) (status root (symbol-name name))))
     (lui:bind-key root :f1 (lambda () (record :help)) :owner root)
     (lui:bind-key root :control-s (lambda () (record :save)) :owner root)
     (lui:on root :key (lambda (w event) (declare (ignore w))
       (when (eq (lui:event-key event) :g)
         (if (and (state root :prefix) (< (state root :elapsed) 1))
             (progn (record :top) (setf (state root :prefix) nil))
             (setf (state root :prefix) t (state root :elapsed) 0)))) :owner root))
   (lui:on root :tick (lambda (w dt) (declare (ignore w)) (incf (state root :elapsed) dt)) :owner root) root)
 (dolist (key '(:f1 :control-s :g :g)) (lui:dispatch root (lui:make-event :kind :key :key key)))
 (assert (equal '(:top :save :help) (state root :actions)))
 (lui:dispatch root (lui:make-event :kind :key :key :g)) (tick root 2)
 (lui:dispatch root (lui:make-event :kind :key :key :g)) (assert (= 3 (length (state root :actions)))))
