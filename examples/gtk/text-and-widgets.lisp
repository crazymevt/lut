(in-package #:lui-gtk-demo)
(defclass password-field (lui:entry) ((revealed :initform nil :accessor revealed)))
(defmethod lui:display-text ((w password-field))
 (if (revealed w) (lui:text w) (make-string (length (lui:text w)) :initial-element #\*)))
(defmethod lui:handle-event ((w password-field) e)
 (and (not (revealed w)) (eq (lui:event-kind e) :key) (member (lui:event-key e) '(:copy :cut))))
(defdemo "password_entry" "Masked password, explicit reveal, paste-only hidden context menu and Caps Lock key-state warning."
 (let* ((field (node 'password-field :password)) (show (node 'lui:check-button :show :text "Show password"))
        (root (app "Password entry" field show (labeled :status "Password is hidden"))))
   (changed show (lambda (w v) (declare (ignore w)) (setf (revealed field) v)) root)
   (lui:on root :key (lambda (w e) (declare (ignore w))
     (when (eq (lui:event-key e) :caps-lock)
       (setf (state root :caps-lock) (not (state root :caps-lock)))
       (status root (if (state root :caps-lock) "Caps Lock is on" "Caps Lock is off")))) :owner root)
   (lui:on field :context (lambda (w event)
     (lui:open-context-menu root w event
       (list (list "Paste" (lambda () (lui:replace-selection w (lui:clipboard-text w))))
             (list "Select all" (lambda () (lui:select-all w)))))) :owner root) root)
 (edit root :password "secret")
 (assert (string= "******" (lui:display-text (control root :password))))
 (press root :show) (assert (string= "secret" (lui:display-text (control root :password))))
 (lui:dispatch root (lui:make-event :kind :key :key :caps-lock)) (assert (state root :caps-lock)))
(defdemo "textview" "Two editable views sharing one buffer, plus text styling and embedded action controls."
 (let* ((a (node 'lui:text-view :first :text (format nil "Shared buffer~%Edit either view.") :height 180))
        (b (node 'lui:text-view :second :text (lui:text a) :height 180))
        (bold (node 'lui:toggle-button :bold :text "Highlight text"))
        (root (app "Multiple text views" a bold b (labeled :status "Both views share text"))))
   (bind-text root a b)
   (changed bold (lambda (w active) (declare (ignore w))
     (dolist (view (list a b)) (setf (lui:style view) (when active '(:foreground :maroon))))) root)
   (add-action root :embedded "Embedded action" (lambda () (status root "Embedded control activated"))) root)
 (edit root :first "Shared edit") (assert (string= "Shared edit" (lui:text (control root :second))))
 (edit root :second "Other direction") (assert (string= "Other direction" (lui:text (control root :first))))
 (press root :bold) (assert (eq :maroon (lui:style-value (control root :second) :foreground)))
 (press root :embedded) (assert (search "activated" (lui:text (control root :status)))))
(defdemo "textscroll" "Bounded 1000-line live log follows the end until automatic scrolling is disabled."
 (let* ((view (node 'lui:text-view :log :height 280 :history-limit 0))
        (follow (node 'lui:check-button :follow :text "Follow output" :value t))
        (root (app "Automatic scrolling" view follow)))
   (setf (state root :lines) 0)
   (lui:on root :tick (lambda (w dt) (declare (ignore w dt))
     (incf (state root :lines))
     (let ((old-cursor (lui:cursor view)))
       (push (format nil "Log line ~d~%" (state root :lines)) (state root :log-lines))
       (when (> (length (state root :log-lines)) 1000)
        (setf (cdr (nthcdr 999 (state root :log-lines))) nil))
       (set-entry view (format nil "~{~a~}" (reverse (state root :log-lines))))
       (setf (lui:cursor view) (if (lui:value follow) (length (lui:text view)) (min old-cursor (length (lui:text view))))))) :owner root) root)
 (tick root 1) (tick root 1)
 (assert (= (length (lui:text (control root :log))) (lui:cursor (control root :log))))
 (press root :follow) (let ((old (lui:cursor (control root :log)))) (tick root 1) (assert (= old (lui:cursor (control root :log)))))
 (dotimes (i 1005) (tick root 0.01))
 (assert (= 1000 (length (state root :log-lines))))
 (assert (null (lui::undo-history (control root :log)))))
(defdemo "tagged_entry" "Composite entry with removable tags and ordinary embedded buttons."
 (let* ((entry (node 'lui:entry :entry)) (tags (node 'lui:header-bar :tags :height 50))
        (root (app "Tagged entry" tags entry)))
   (setf (state root :tags) nil)
   (labels ((refresh ()
              (dolist (child (copy-list (lui:children tags))) (lui:dispose child))
              (dolist (tag (state root :tags))
                (lui:add-child tags (action (intern (string-upcase tag) :keyword) (concatenate 'string tag " x")
                  (lambda () (setf (state root :tags) (remove tag (state root :tags) :test #'string=)) (refresh)))))))
     (add-action root :add "Add tag" (lambda ()
       (let ((tag (string-trim '(#\Space) (lui:text entry))))
         (when (plusp (length tag)) (pushnew tag (state root :tags) :test #'string=) (set-entry entry "") (refresh)))))) root)
 (edit root :entry "Lisp") (press root :add) (assert (equal '("Lisp") (state root :tags)))
 (press root :lisp) (assert (null (state root :tags))))
(defdemo "headerbar" "Centered title with independently sized leading and trailing header actions."
 (let* ((bar (node 'lui:header-bar :header :height 50))
        (root (app "Header bar" bar (labeled :status "Document"))))
   (lui:add-child bar (action :back "Back" (lambda () (status root "Back"))))
   (lui:add-child bar (labeled :title "Centered document title" :width 320))
   (lui:add-child bar (action :forward "Next" (lambda () (status root "Next"))))
   (add-action root :subtitle "Toggle subtitle" (lambda ()
     (setf (state root :subtitle) (not (state root :subtitle)))
     (setf (lui:text (control root :title)) (if (state root :subtitle) "Document / subtitle" "Document")))) root)
 (press root :back) (assert (string= "Back" (lui:text (control root :status))))
 (press root :forward) (assert (string= "Next" (lui:text (control root :status))))
 (press root :subtitle) (assert (search "subtitle" (lui:text (control root :title)))))
(defdemo "infobar" "Information, warning and error bars with response actions and dismissal."
 (let* ((bars (node 'lui:box :bars :height 280)) (root (app "Info bars" bars (labeled :status "Waiting for response"))))
   (dolist (spec '((:information "Information" :skyblue) (:warning "Warning" :gold) (:error "Error" (250 128 114 255))))
     (destructuring-bind (id caption color) spec
       (let ((bar (node 'lui:header-bar id :height 60 :style (list :surface color))))
         (lui:add-child bar (labeled nil caption))
         (lui:add-child bar (action (intern (concatenate 'string "RESPOND-" (symbol-name id)) :keyword) "Respond"
           (lambda () (status root caption))))
         (lui:add-child bar (action (intern (concatenate 'string "DISMISS-" (symbol-name id)) :keyword) "Dismiss"
           (lambda () (lui:dispose bar))))
         (lui:add-child bars bar)))) root)
 (press root :respond-warning) (assert (string= "Warning" (lui:text (control root :status))))
 (press root :dismiss-warning) (assert (null (lui:find-widget root :warning))))
(defdemo "listbox_controls" "Settings list with switches, numeric controls and dropdown selection."
 (let* ((sound (node 'lui:switch :sound :text "Sound" :value t))
        (volume (node 'lui:slider :volume :value 50))
        (mode (node 'lui:dropdown :mode :items '("Automatic" "Light" "Dark") :value 0))
        (root (app "Settings controls" sound volume mode (labeled :status "Sound enabled"))))
   (changed sound (lambda (w v) (declare (ignore w)) (status root (if v "Sound enabled" "Sound muted"))) root)
   (changed volume (lambda (w v) (declare (ignore w)) (setf (state root :volume) v)) root)
   (changed mode (lambda (w v) (declare (ignore w)) (setf (lui:theme root) (if (= v 2) lui:*dark-theme* lui:*light-theme*))) root) root)
 (press root :sound) (assert (not (lui:value (control root :sound))))
 (set-number root :volume 75) (assert (= 75 (state root :volume)))
 (choose-index root :mode 2) (assert (eq lui:*dark-theme* (lui:theme root))))
(defdemo "pickers" "File, color and font chooser dialogs with previewed results."
 (let ((root (app "Pickers" (labeled :status "Choose a value"))))
   (add-action root :file "Choose file" (lambda () (lui:choose-file root (lambda (path) (setf (state root :file) path) (status root (namestring path))))))
   (add-action root :color "Choose color" (lambda () (lui:choose-color root (lambda (rgba)
     (setf (state root :color) rgba (lui:style (control root :status)) (list :foreground rgba))))))
   (add-action root :font "Choose font" (lambda () (lui:choose-font root (lambda (path size)
     (setf (state root :font) (list path size) (lui:style (control root :status)) (list :font path :font-size size)))
     :initial (asdf:system-relative-pathname "lui" "assets/NotoSans-Regular.ttf")))) root)
 (press root :color)
 (let* ((dialog (lui::input-root root)) (first (first (lui:children dialog))))
   (setf (lui:value first) 80) (lui:emit first :change 80)
   (lui::activate (car (last (lui:children dialog)))))
 (assert (= 80 (first (state root :color))))
 (press root :font) (let ((dialog (lui::input-root root))) (lui::activate (car (last (lui:children dialog)))))
 (assert (probe-file (first (state root :font)))))
(defun view-link (root uri)
 (setf (state root :uri) uri) (status root (format nil "Link activated: ~a" uri)))
(defdemo "links" "Hyperlinks with overridable activation callbacks and visited state."
 (let ((root (app "Links" (labeled :status "Choose a link"))))
   (dolist (spec '((:gtk "GTK documentation" "https://docs.gtk.org/gtk4/")
                   (:lisp "Common Lisp" "https://common-lisp.net/")
                   (:local "Application action" "app:about")))
     (destructuring-bind (id title uri) spec
       (add-action root id title (lambda ()
         (view-link root uri) (setf (lui:style (control root id)) '(:foreground :purple)))))) root)
 (press root :gtk) (assert (string= "https://docs.gtk.org/gtk4/" (state root :uri)))
 (assert (eq :purple (lui:style-value (control root :gtk) :foreground)))
 (press root :local) (assert (string= "app:about" (state root :uri))))
(defdemo "hypertext" "Interactive linked text sections with navigation, embedded actions and history."
 (let* ((view (node 'lui:text-view :page :height 280 :text "Welcome. Choose a linked section below."))
        (root (app "Hypertext" view (labeled :status "Home"))))
   (setf (state root :history) nil)
   (dolist (spec '((:intro "Introduction" "Common Lisp applications compose CLOS widgets.")
                  (:details "Details" "Callbacks and styles can be changed while the program is running.")))
     (destructuring-bind (id title body) spec
       (add-action root id title (lambda ()
         (push (lui:text view) (state root :history)) (set-entry view body) (status root title)))))
   (add-action root :back "Back" (lambda () (when (state root :history) (set-entry view (pop (state root :history)))))) root)
 (let ((home (lui:text (control root :page))))
   (press root :details) (assert (search "Callbacks" (lui:text (control root :page))))
   (press root :back) (assert (string= home (lui:text (control root :page))))))
