(defpackage #:lut-gtk-demo-native (:use #:cl) (:export #:paint))
(in-package #:lut-gtk-demo-native)
(defun draw-image (source x y width height &optional (filter :bilinear))
 (let* ((key (list (namestring (pathname source)) (file-write-date source)))
        (texture (or (cdr (assoc key lut::*texture-cache* :test #'equal))
                     (let ((texture (rl:load-texture source)))
                       (unless (rl:is-texture-valid texture) (error "Image failed: ~a" source))
                       (push (cons key texture) lut::*texture-cache*) texture))))
   (pushnew texture lut::*used-textures* :test #'eq)
   (rl:set-texture-filter texture filter)
   (rl:draw-texture-pro texture (rl:rect 0 0 (rl:texture-width texture) (rl:texture-height texture))
                       (rl:rect x y width height) (rl:vec2 0 0) 0 :white)))
(defclass shader-resource (lut:widget)
 ((source :initarg :source :reader shader-source) (shader :initarg :shader :accessor resource-shader)))
(defmethod lut:dispose :after ((r shader-resource))
 (when (resource-shader r) (rl:unload-shader (resource-shader r)) (setf (resource-shader r) nil)))
(defun shader-for (root source)
 (let ((old (lut-gtk-demo::state root :shader-resource)))
   (when (or (null old) (lut:disposed-p old) (not (string= source (shader-source old))))
     (when old
       (setf (lut-gtk-demo::native-resources root) (remove old (lut-gtk-demo::native-resources root)))
       (unless (lut:disposed-p old) (lut:dispose old)))
     (let ((shader (rl:load-shader-from-memory nil source)))
       (unless (rl:is-shader-valid shader) (error "Shader compilation failed."))
       (setf old (make-instance 'shader-resource :source source :shader shader))
       (push old (lut-gtk-demo::native-resources root))
       (setf (lut-gtk-demo::state root :shader-resource) old)))
   (resource-shader old)))
(defun uniform (shader name values type)
 (let ((location (rl:get-shader-location shader name)))
   (when (>= location 0)
     (cffi:with-foreign-object (p :float (length values))
       (loop for value in values for i from 0 do (setf (cffi:mem-aref p :float i) (float value 1.0)))
       (rl:set-shader-value shader location p type)))))

(defun canvas-font (canvas size &optional path)
 (let ((old (lut:style canvas)))
  (unwind-protect
   (progn (setf (lut:style canvas) (list* :font-size size (if path (list* :font path old) old)))
    (lut::widget-font canvas))
   (setf (lut:style canvas) old))))
(defun set-native-cursor (canvas cursor)
 (let ((root (lut::root-of canvas)))
  (if (eq root lut::*primary-window*) (rl:set-mouse-cursor cursor)
   (unless (eq cursor (lut-gtk-demo::state root :last-native-cursor))
    (let ((remote (bt:with-lock-held (lut::*remote-lock*)
                   (find root lut::*remote-windows* :key #'lut::remote-window-root))))
     (when remote (lut:evaluate-in-window remote (list (list 'rl:set-mouse-cursor cursor)))
      (setf (lut-gtk-demo::state root :last-native-cursor) cursor)))))))
(defparameter *text-gradient-shader*
 "#version 330
in vec2 fragTexCoord;in vec4 fragColor;uniform sampler2D texture0;
uniform float iTime;out vec4 finalColor;
void main(){float a=texture(texture0,fragTexCoord).a;vec3 color=0.5+0.5*cos(gl_FragCoord.x*0.012+iTime+vec3(0,2,4));finalColor=vec4(color,a)*fragColor;}")
(defun rich-font-path (style)
 (asdf:system-relative-pathname "lut"
  (format nil "assets/NotoSans-~a.ttf" (cond ((and (getf style :bold) (getf style :italic)) "BoldItalic")
                                           ((getf style :bold) "Bold") ((getf style :italic) "Italic") (t "Regular")))))
(defun rich-text (canvas spans x y width ox oy)
 (let ((px x) (py y) (row-height 0))
  (dolist (span spans)
   (let* ((style (getf span :style)) (size (getf style :size 22)) (color (getf style :color :black))
          (font (canvas-font canvas size (rich-font-path style))))
    (loop for char across (getf span :text) for string = (string char)
     for advance = (rl:vector2-x (rl:measure-text-ex font string size 0)) do
      (when (or (char= char #\Newline) (> (+ px advance) (+ x width)))
       (setf px x) (incf py (max (+ size 4) row-height)) (setf row-height 0))
      (setf row-height (max row-height (+ size 4)))
      (unless (char= char #\Newline)
       (rl:draw-text-ex font string (rl:vec2 (+ ox px) (+ oy py)) size 0 color)
       (when (getf style :underline) (rl:draw-line-ex (rl:vec2 (+ ox px) (+ oy py size)) (rl:vec2 (+ ox px advance) (+ oy py size)) 1 color))
       (when (getf style :strike) (rl:draw-line-ex (rl:vec2 (+ ox px) (+ oy py (* size 0.6))) (rl:vec2 (+ ox px advance) (+ oy py (* size 0.6))) 1 color))
       (incf px advance)))))))

(defvar *music-users* 0)
(defvar *own-audio-device* nil)
(defclass music-resource (lut:widget)
 ((path :initarg :path :reader music-path) (stream :initarg :stream :accessor music-stream)
  (started :initform nil :accessor music-started-p) (playing :initform nil :accessor music-playing-p)))
(defmethod lut:dispose :after ((resource music-resource))
 (when (music-stream resource)
  (rl:stop-music-stream (music-stream resource)) (rl:unload-music-stream (music-stream resource))
  (setf (music-stream resource) nil) (decf *music-users*)
  (when (and (zerop *music-users*) *own-audio-device*)
   (rl:close-audio-device) (setf *own-audio-device* nil))))
(defun play-soundtrack (canvas path position playing volume)
 (let* ((root (lut-gtk-demo::scene-root canvas)) (old (lut-gtk-demo::state root :music-resource)))
  (when (or (null old) (lut:disposed-p old) (not (equal path (music-path old))))
   (when old (lut:dispose old)
    (setf (lut-gtk-demo::native-resources root) (remove old (lut-gtk-demo::native-resources root))))
   (unless (rl:is-audio-device-ready) (rl:init-audio-device)
    (setf *own-audio-device* (rl:is-audio-device-ready)))
   (unless (rl:is-audio-device-ready) (error "No audio output device is available."))
   (let ((stream (rl:load-music-stream path)))
    (unless (rl:is-music-valid stream)
     (when (and (zerop *music-users*) *own-audio-device*)
      (rl:close-audio-device) (setf *own-audio-device* nil))
     (error "Could not load soundtrack ~a" path))
    (incf *music-users*)
    (setf old (make-instance 'music-resource :path path :stream stream)
          (lut-gtk-demo::state root :music-resource) old)
    (push old (lut-gtk-demo::native-resources root))))
  (let ((stream (music-stream old)))
   (rl:set-music-volume stream volume)
   (cond ((and playing (not (music-playing-p old)))
          (if (music-started-p old) (rl:resume-music-stream stream) (rl:play-music-stream stream))
          (setf (music-started-p old) t))
         ((and (not playing) (music-playing-p old)) (rl:pause-music-stream stream)))
   (setf (music-playing-p old) playing)
   (when (> (abs (- position (rl:get-music-time-played stream))) 0.2) (rl:seek-music-stream stream position))
   (rl:update-music-stream stream))))
(defun paint (canvas)
 (let ((ox (lut:x canvas)) (oy (lut:y canvas)))
   (labels ((paint-op (operation)
      (destructuring-bind (kind &rest args) operation
       (case kind
        (:rect (destructuring-bind (x y w h color) args (rl:draw-rectangle (+ ox x) (+ oy y) w h color)))
        (:circle (destructuring-bind (x y radius color) args (rl:draw-circle (+ ox x) (+ oy y) radius color)))
        (:ellipse (destructuring-bind (x y rx ry color) args (rl:draw-ellipse (+ ox x) (+ oy y) rx ry color)))
        (:line (destructuring-bind (x1 y1 x2 y2 thick color) args
                 (rl:draw-line-ex (rl:vec2 (+ ox x1) (+ oy y1)) (rl:vec2 (+ ox x2) (+ oy y2)) thick color)))
        (:polyline (destructuring-bind (points thick color) args
                     (loop for (a b) on points while b do (paint-op (list :line (first a) (second a) (first b) (second b) thick color)))))
        (:polygon (destructuring-bind (points color) args
                    (let ((center (list (/ (reduce #'+ points :key #'first) (length points))
                                        (/ (reduce #'+ points :key #'second) (length points)))))
                      (loop for a in points for b in (append (rest points) (list (first points))) do
                        (rl:draw-triangle (rl:vec2 (+ ox (first center)) (+ oy (second center)))
                          (rl:vec2 (+ ox (first b)) (+ oy (second b))) (rl:vec2 (+ ox (first a)) (+ oy (second a))) color)))))
        (:text (destructuring-bind (text x y size color &optional (angle 0)) args
                 (rl:draw-text-pro (canvas-font canvas size) text (rl:vec2 (+ ox x) (+ oy y)) (rl:vec2 0 0)
                                    angle size 0 color)))
        (:tabbed-text (destructuring-bind (text decimal right) args
          (let ((font (canvas-font canvas 22)))
           (loop for line in (lut-gtk-demo::list-of-strings text) for y from 30 by 38 do
            (loop for field in (lut-gtk-demo::tab-fields line) for column from 0
                  for width = (rl:vector2-x (rl:measure-text-ex font field 22 0))
                  for x = (case column (0 20) (1 (- decimal (rl:vector2-x (rl:measure-text-ex font (subseq field 0 (position #\. field)) 22 0)))) (t (- right width))) do
             (rl:draw-text-ex font field (rl:vec2 (+ ox x) (+ oy y)) 22 0 :black)))
          (dolist (x (list decimal right)) (rl:draw-line-ex (rl:vec2 (+ ox x) oy) (rl:vec2 (+ ox x) (+ oy 220)) 1 :lightgray)))))
        (:sound (apply #'play-soundtrack canvas args))
        (:cursor (set-native-cursor canvas (first args)))
        (:font-text (destructuring-bind (text x y size color path spacing filter) args
                     (let ((font (canvas-font canvas size path)))
                      (rl:set-texture-filter (rl:font-texture font) filter)
                      (rl:draw-text-ex font text (rl:vec2 (+ ox x) (+ oy y)) size spacing color))))
        (:rich-text (destructuring-bind (spans x y width) args (rich-text canvas spans x y width ox oy)))
        (:gradient-text (destructuring-bind (text x y size angle time) args
           (let ((shader (shader-for (lut-gtk-demo::scene-root canvas) *text-gradient-shader*)))
            (uniform shader "iTime" (list time) :float)
            (rl:with-shader-mode (shader)
             (rl:draw-text-pro (canvas-font canvas size) text (rl:vec2 (+ ox x) (+ oy y)) (rl:vec2 0 0) angle size 0 :white)))))
        (:gradient (destructuring-bind (x y w h top bottom) args
                     (rl:draw-rectangle-gradient-v (+ ox x) (+ oy y) w h top bottom)))
        (:image (destructuring-bind (source x y w h &optional filter) args
                  (draw-image source (+ ox x) (+ oy y) w h (or filter :bilinear))))
        (:pixels (destructuring-bind (pixels columns x y size) args
                   (loop for color in pixels for i from 0 do
                     (rl:draw-rectangle (+ ox x (* size (mod i columns))) (+ oy y (* size (floor i columns))) size size color))))
        (:blend (destructuring-bind (mode operations) args
                  (rl:with-blend-mode (mode) (mapc #'paint-op operations))))
        (:shader (destructuring-bind (source time width height &optional image) args
                   (let ((shader (shader-for (lut-gtk-demo::scene-root canvas) source)))
                     (uniform shader "iTime" (list time) :float)
                     (uniform shader "iResolution" (list width height 1) :vec3)
                     (rl:with-shader-mode (shader)
                       (if image (draw-image image ox oy width height) (rl:draw-rectangle ox oy width height :white))))))
        (otherwise (error "Unknown scene operation ~s" kind))))))
     (let ((operations (lut-gtk-demo::paint-operations canvas)))
       (setf (lut:text canvas) (format nil "~{~a~}" (loop for op in operations append
        (case (first op) ((:text :font-text :gradient-text :tabbed-text) (list (second op)))
         (:rich-text (mapcar (lambda (span) (getf span :text)) (second op)))))))
       (mapc #'paint-op operations)))))
(defmethod lut:render ((w lut-gtk-demo::virtual-list))
 (lut-gtk-demo::synchronize-view w)
 (let ((extent (lut-gtk-demo::row-extent w)) (horizontal (eq (lut-gtk-demo::view-orientation w) :horizontal)))
   (loop for (index item) in (lut-gtk-demo::visible-rows w)
     for offset = (- (* index extent) (lut:scroll-offset w))
     for x = (+ (lut:x w) (if horizontal offset 0))
     for y = (+ (lut:y w) (if horizontal 0 offset)) do
       (when (member index (lut-gtk-demo::selected-indices w))
         (rl:draw-rectangle x y (if horizontal extent (lut:width w))
                            (if horizontal (lut:height w) extent) (lut:style-value w :accent)))
       (lut::draw-string w (lut-gtk-demo::item-text item) (+ x (lut:style-value w :padding)) y
                        (when (listp item) (getf item :color))))))
