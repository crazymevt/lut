(in-package #:lui-gtk-demo)
(defparameter *transfer-types* '("Text" "Image" "Color" "File"))
(defun transfer-payload (root)
 (let ((kind (or (lui:value (control root :type)) 0)))
  (case kind
   (0 (list :text (lui:text (control root :source))))
   (1 (list :image (namestring (sample-image))))
   (2 (list :color '(180 40 100 255)))
   (3 (list :file (lui:text (control root :source)))))))
(defun serialize-transfer (payload) (format nil "LUI-TRANSFER-1 ~s" payload))
(defun parse-transfer (text)
 (when (> (length text) 65536) (error "Transfer is too large."))
 (let ((prefix "LUI-TRANSFER-1 "))
  (if (and (>= (length text) (length prefix)) (string= prefix text :end2 (length prefix)))
   (let ((*read-eval* nil))
    (multiple-value-bind (data end) (read-from-string text nil nil :start (length prefix))
     (unless (and (= end (length text)) (listp data) (= (length data) 2)
                  (case (first data)
                   ((:text :image :file) (stringp (second data)))
                   (:color (and (listp (second data)) (= 4 (length (second data)))
                                (every (lambda (v) (typep v '(integer 0 255))) (second data))))))
      (error "Invalid transfer payload.")) data))
   (list :text text))))
(defun accept-transfer (root payload)
 (setf (state root :received) payload)
 (set-entry (control root :target) (if (stringp (second payload)) (second payload) (princ-to-string (second payload))))
 (status root (format nil "Received ~a" (first payload))))
(defdemo "clipboard" "Copy/paste and pointer drag of text, image/file paths and RGBA colors; portable tagged text carries non-text clipboard data."
 (let* ((r (app "Clipboard" (node 'lui:dropdown :type :items *transfer-types* :value 0)
               (node 'lui:entry :source :text "Copy text or a file pathname")
               (node 'lui:entry :target) (labeled :status "Select a source type"))))
  (lui:add-child r (scene r :clipboard
   (lambda (c) (let ((received (state (scene-root c) :received)))
    (append (list (op :rect 10 10 240 100 :skyblue) (op :text "Drag source to target →" 20 40 18 :black)
                  (op :rect 300 10 300 150 :lightgray))
     (when received (case (first received)
      (:color (list (op :rect 320 30 180 100 (second received))))
      (:image (when (probe-file (second received)) (list (op :image (second received) 320 30 180 100)))))))))
   :height 180 :input (lambda (root canvas event)
    (let ((x (- (lui:event-x event) (lui:x canvas))))
     (case (lui:event-kind event)
      (:down (when (< x 250) (setf (state root :drag-payload) (transfer-payload root))))
      (:up (when (and (> x 300) (state root :drag-payload)) (accept-transfer root (state root :drag-payload)))
           (setf (state root :drag-payload) nil)))))))
  (add-action r :copy "Copy source" (lambda () (setf (lui:clipboard-text (control r :source)) (serialize-transfer (transfer-payload r)))))
  (add-action r :paste "Paste clipboard" (lambda ()
   (handler-case (accept-transfer r (parse-transfer (lui:clipboard-text (control r :source))))
    (error (e) (status r (princ-to-string e)))))) r)
 (edit root :source "Hello λ") (press root :copy) (press root :paste)
 (assert (equal '(:text "Hello λ") (state root :received)))
 (choose-index root :type 2) (press root :copy) (press root :paste)
 (assert (equal '(:color (180 40 100 255)) (state root :received)))
 (let ((c (control root :canvas)))
  (choose-index root :type 1)
  (lui:handle-event c (lui:make-event :kind :down :x (+ (lui:x c) 40)))
  (lui:handle-event c (lui:make-event :kind :up :x (+ (lui:x c) 350)))
  (assert (eq :image (first (state root :received))))))
(defun canvas-item-at (root p)
 (find-if (lambda (item) (< (distance p (getf item :position)) 55)) (reverse (state root :objects))))
(defun dnd-input (root c e)
 (let* ((p (point (- (lui:event-x e) (lui:x c)) (- (lui:event-y e) (lui:y c))))
        (item (canvas-item-at root p)))
  (case (lui:event-kind e)
   (:down (setf (state root :selected) item (state root :drag) item))
   (:move (when (state root :drag) (setf (getf (state root :drag) :position)
     (point (clamp (first p) 55 (max 55 (- (lui:width c) 55)))
            (clamp (second p) 55 (max 55 (- (lui:height c) 55)))))))
   (:up (setf (state root :drag) nil))
   (:wheel (when item (incf (getf item :angle) (* 0.1 (lui:event-delta e)))))
   (:context (when item
    (setf (state root :selected) item)
    (lui:open-context-menu root c e
     (list (list "Rotate 45°" (lambda () (incf (getf item :angle) (/ pi 4))))
           (list "Recolor" (lambda () (setf (getf item :color) :green))))))))))
(defdemo "dnd" "Canvas items support drag movement, selection, wheel rotation and reusable context actions for rotation/recoloring."
 (let ((r (graphic-root "Drag and drop" :dnd
  (lambda (c) (loop for item in (state (scene-root c) :objects) append
   (let ((p (getf item :position)))
    (list (op :polygon (mapcar (lambda (v) (transformed v (getf item :angle) 1 (first p) (second p)))
                               '((-45 -35) (45 -35) (45 35) (-45 35))) (getf item :color))
          (op :text (getf item :text) (- (first p) 35) (- (second p) 10) 16 :black))))) :input #'dnd-input)))
  (setf (state r :objects) (list (list :text "Drag me" :position '(120 120) :angle 0 :color :gold)
                               (list :text "Rotate me" :position '(360 160) :angle 0 :color :skyblue))) r)
 (let ((c (control root :canvas)))
  (dolist (spec '((:down 120 120) (:move 220 180) (:up 220 180)))
   (destructuring-bind (kind x y) spec (lui:handle-event c (lui:make-event :kind kind :x (+ x (lui:x c)) :y (+ y (lui:y c))))))
 (assert (equal '(220 180) (getf (first (state root :objects)) :position)))
 (assert (null (state root :drag))))
 (let ((c (control root :canvas)))
  ;; Actual dispatch captures the scene even while the pointer leaves its bounds.
  (lui:dispatch root (lui:make-event :kind :down :x (+ (lui:x c) 220) :y (+ (lui:y c) 180)))
  (lui:dispatch root (lui:make-event :kind :move :x (+ (lui:x c) 250) :y (+ (lui:y c) (lui:height c) 50)))
  (lui:dispatch root (lui:make-event :kind :up :x (+ (lui:x c) 250) :y (+ (lui:y c) (lui:height c) 50)))
  (assert (null (state root :drag)))
  (let* ((p (getf (first (state root :objects)) :position))
         (x (+ (lui:x c) (first p))) (y (+ (lui:y c) (second p))))
   (assert (= (- (lui:height c) 55) (second p)))
   (lui:dispatch root (lui:make-event :kind :context :x x :y y))
   (let* ((menu (first (slot-value root 'lui::overlays))) (recolor (second (lui:children menu))))
    (assert (typep menu 'lui:context-menu))
    (lui:focus root recolor) (lui:dispatch root (lui:make-event :kind :key :key :enter)))
   (assert (eq :green (getf (first (state root :objects)) :color))))))
(defparameter *cursor-names* '("Default" "Arrow" "I-beam" "Crosshair" "Hand" "Resize EW" "Resize NS" "Resize NWSE" "Resize NESW" "Resize all" "Not allowed"))
(defparameter *cursor-values* '(:default :arrow :ibeam :crosshair :pointing-hand :resize-ew :resize-ns :resize-nwse :resize-nesw :resize-all :not-allowed))
(defdemo "cursors" "Select and preview all raylib system cursor shapes; choice applies to the native top-level window."
 (let ((r (app "Cursors" (node 'lui:dropdown :cursor :items *cursor-names* :value 0) (labeled :status "Move over the preview"))))
  (setf (state r :cursor) :default)
  (changed (control r :cursor) (lambda (w index) (declare (ignore w)) (setf (state r :cursor) (nth index *cursor-values*))) r)
  (lui:add-child r (scene r :cursors (lambda (c) (let ((r (scene-root c)))
   (list (op :cursor (state r :cursor)) (op :text (format nil "Cursor: ~a" (state r :cursor)) 40 70 24 :black)))))) r)
 (choose-index root :cursor 4) (assert (eq :pointing-hand (second (first (operations root))))))
(defun gesture-input (root canvas e)
 (let ((p (point (- (lui:event-x e) (lui:x canvas)) (- (lui:event-y e) (lui:y canvas)))))
  (case (lui:event-kind e)
   (:down (setf (state root :origin) p (state root :last) p (state root :held) 0 (state root :holding) t (state root :long) nil))
   (:move (when (state root :holding) (setf (state root :last) p)))
   (:up (when (and (state root :holding) (> (distance (state root :origin) p) 30))
          (setf (state root :swipe) (mapcar #'- p (state root :origin))))
        (setf (state root :holding) nil))
   (:wheel (setf (state root :zoom) (clamp (+ (state root :zoom 1) (* 0.1 (lui:event-delta e))) 0.2 3)))
   (:gesture
    (case (lui:event-key e)
     (:hold (setf (state root :long) t (state root :held) (lui:event-delta e)))
     ((:swipe-left :swipe-right :swipe-up :swipe-down) (setf (state root :swipe) (lui:event-key e)))
     ((:pinch-in :pinch-out)
      (setf (state root :zoom) (clamp (+ (state root :zoom 1) (if (eq :pinch-in (lui:event-key e)) -0.02 0.02)) 0.2 3)
            (state root :rotation) (* pi (/ (lui:event-delta e) 180))))))
   (:key (case (lui:event-key e) (:left (decf (state root :rotation 0) 0.1)) (:right (incf (state root :rotation 0) 0.1)))))))
(defdemo "gestures" "Pointer and native raylib gestures: long press, swipes, pinch zoom/angle, wheel zoom and arrow rotation with visible feedback."
 (let ((r (graphic-root "Gestures" :gestures
  (lambda (c) (let* ((r (scene-root c)) (angle (state r :rotation 0)) (zoom (state r :zoom 1)))
   (list (op :polygon (mapcar (lambda (p) (transformed p angle zoom 320 150)) '((-65 -40) (65 -40) (65 40) (-65 40)))
             (if (state r :long) :orange :skyblue))
         (op :text (format nil "Swipe ~a; zoom ~,1f; hold ~,1fs" (state r :swipe) zoom (state r :held 0)) 20 270 18 :black))))
  :input #'gesture-input)))
  (setf (state r :zoom) 1)
  (lui:on r :tick (lambda (w dt) (declare (ignore w)) (when (state r :holding)
   (incf (state r :held) dt)
   (when (and (>= (state r :held) 0.7) (< (distance (state r :origin) (state r :last)) 8)) (setf (state r :long) t)))) :owner r) r)
 (let ((c (control root :canvas)))
  (lui:handle-event c (lui:make-event :kind :down :x (lui:x c) :y (lui:y c))) (tick root 0.8)
  (assert (state root :long))
  (lui:handle-event c (lui:make-event :kind :up :x (+ 100 (lui:x c)) :y (lui:y c)))
  (assert (equal '(100 0) (state root :swipe)))
  (lui:handle-event c (lui:make-event :kind :wheel :delta 1)) (assert (> (state root :zoom) 1))
  (lui:handle-event c (lui:make-event :kind :gesture :key :pinch-out :delta 90))
  (assert (near (/ pi 2) (state root :rotation)))))
(defdemo "iconscroll" "Virtualized icon-grid scrolling benchmark with configurable speed, automatic wrapping, pause and measured frame count."
 (let* ((v (model-view :icons 10000 (lambda (i) (format nil "~a  Icon ~d" (nth (mod i 4) '("◆" "●" "■" "★")) i))))
        (r (app "Icon scroll benchmark" v (node 'lui:slider :speed :minimum 0 :maximum 2000 :value 400)
                (labeled :status "Running"))))
  (setf (state r :running) t (state r :frames) 0)
  (lui:on r :tick (lambda (w dt) (declare (ignore w))
   (when (state r :running)
    (incf (state r :frames))
    (setf (lui:scroll-offset v) (mod (+ (lui:scroll-offset v) (* dt (lui:value (control r :speed))))
                                  (max 1 (- (* (model-count v) (lui:row-height v)) (lui:height v)))))
    (status r (format nil "~d frames; ~d visible of ~d" (state r :frames) (length (visible-rows v)) (model-count v))))) :owner r)
  (add-action r :pause "Pause / resume" (lambda () (setf (state r :running) (not (state r :running))))) r)
 (tick root 1) (assert (= 400 (lui:scroll-offset (control root :icons))))
 (assert (< (length (visible-rows (control root :icons))) 30))
 (press root :pause) (tick root 1) (assert (= 1 (state root :frames))))
(defun icon-edit-rebuild (root)
 (let ((v (control root :icons)))
  (setf (lui:items v) (mapcar (lambda (row) (format nil "~a  ~a" (first row) (second row))) (state root :rows)))))
(defdemo "iconview_edit" "Editable icon labels with selection, rename, model reordering, insertion and deletion."
 (let* ((v (node 'lui:list-view :icons :items nil :height 250))
        (r (app "Editable icons" v (node 'lui:entry :name :text "New label") (labeled :status "Select an icon"))))
  (setf (state r :rows) (copy-tree '(("◆" "Red") ("●" "Green") ("■" "Blue") ("★" "Yellow"))))
  (icon-edit-rebuild r)
  (changed v (lambda (w index) (declare (ignore w)) (set-entry (control r :name) (second (nth index (state r :rows))))) r)
  (add-action r :rename "Rename" (lambda ()
   (when (lui:value v) (setf (second (nth (lui:value v) (state r :rows))) (lui:text (control r :name))) (icon-edit-rebuild r))))
  (add-action r :up "Move earlier" (lambda () (let ((i (lui:value v)))
   (when (and i (> i 0)) (rotatef (nth i (state r :rows)) (nth (1- i) (state r :rows)))
    (decf (lui:value v)) (icon-edit-rebuild r)))))
  (add-action r :add "Add icon" (lambda () (setf (state r :rows) (append (state r :rows) (list (list "◆" (lui:text (control r :name)))))) (icon-edit-rebuild r)))
  (add-action r :delete "Delete selected" (lambda ()
   (when (lui:value v) (setf (state r :rows) (loop for row in (state r :rows) for i from 0 unless (= i (lui:value v)) collect row)
                            (lui:value v) nil) (icon-edit-rebuild r)))) r)
 (choose-index root :icons 1) (edit root :name "Renamed") (press root :rename) (press root :up)
 (assert (equal '("●" "Renamed") (first (state root :rows))))
 (press root :delete) (assert (= 3 (length (state root :rows)))))
