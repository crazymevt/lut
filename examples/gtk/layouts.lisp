(in-package #:lui-gtk-demo)
;; Cassowary computes sizes; no toolkit/implementation-specific layout solver.
(defun solve-buttons (width gap ratio)
 (let ((solver (org.shirakumo.classowary:make-solver)))
  (org.shirakumo.classowary:with-variables (left right) solver
   (org.shirakumo.classowary:constrain solver (>= left 40))
   (org.shirakumo.classowary:constrain solver (>= right 40))
   (org.shirakumo.classowary:constrain-with solver `(= (+ ,left ,right) ,(- width gap 32)))
   (org.shirakumo.classowary:constrain-with solver `(= ,left (* ,ratio ,right)))
   (org.shirakumo.classowary:update-variables solver)
   (list (org.shirakumo.classowary:value left) (org.shirakumo.classowary:value right)))))
(defun vfl-gap (string)
 "Parse the demo's equal-width, two-button H: VFL production. Reject other grammars."
 (let* ((prefix "H:|-[button1(==button2)]-") (suffix "-[button2]-|")
        (end (- (length string) (length suffix))))
  (unless (and (>= end (length prefix)) (string= prefix string :end2 (length prefix))
               (string= suffix string :start2 end)) (error "Expected ~aNUMBER~a" prefix suffix))
  (let ((gap (parse-integer string :start (length prefix) :end end)))
   (unless (<= 0 gap 200) (error "Spacing must be 0..200.")) gap)))
(defun constraint-description (string)
 (let ((*read-eval* nil))
  (multiple-value-bind (data end) (read-from-string string)
   (unless (and (every (lambda (c) (find c '(#\Space #\Newline #\Tab))) (subseq string end))
                (listp data) (= 4 (length data)) (eq (first data) :gap) (eq (third data) :ratio)
                (realp (second data)) (<= 0 (second data) 200)
                (realp (fourth data)) (<= 0.2 (fourth data) 5))
    (error "Use (:gap NUMBER-0..200 :ratio NUMBER-0.2..5).")) data)))
(defun constraint-demo (kind)
 (let ((root (app "Constraint layout")))
  (setf (state root :gap) 12 (state root :ratio) 1)
  (lui:add-child root (scene root kind
   (lambda (canvas)
    (let* ((r (scene-root canvas)) (width (max 640 (lui:width canvas)))
           (sizes (solve-buttons width (state r :gap) (state r :ratio)))
           (a (first sizes)) (b (second sizes)) (gap (state r :gap)))
     (setf (state r :sizes) sizes)
     (list (op :rect 16 30 a 70 :skyblue) (op :rect (+ 16 a gap) 30 b 70 :orange)
           (op :text "Button 1" 24 52 18 :black) (op :text "Button 2" (+ 24 a gap) 52 18 :black)
           (op :rect 16 130 (- width 32) 70 :lightgray)
           (op :text "Guide maintains spacing; resize the window" 24 150 18 :black))))
   :input (when (eq kind :constraints_interactive)
    (lambda (r canvas event)
     (case (lui:event-kind event)
      (:down (setf (state r :dragging) t)) (:up (setf (state r :dragging) nil))
      (:move (when (state r :dragging)
       (let* ((total (- (max 640 (lui:width canvas)) 32 (state r :gap)))
              (left (clamp (- (lui:event-x event) (lui:x canvas) 16) 100 (- total 100))))
        (setf (state r :ratio) (/ left (- total left)))))))))))
  (when (member kind '(:constraints_vfl :constraints_builder))
   (lui:add-child root (node 'lui:entry :source :text
     (if (eq kind :constraints_vfl) "H:|-[button1(==button2)]-12-[button2]-|" "(:gap 12 :ratio 1)")))
   (add-action root :apply "Apply constraints" (lambda ()
    (handler-case
     (let* ((text (lui:text (control root :source)))
            (data (if (eq kind :constraints_vfl) (list :gap (vfl-gap text) :ratio 1) (constraint-description text))))
      (solve-buttons (max 640 (lui:width (control root :canvas))) (getf data :gap) (getf data :ratio))
      (setf (state root :gap) (getf data :gap) (state root :ratio) (getf data :ratio)) (status root "Constraints applied"))
     (error (e) (status root (princ-to-string e)))))))
  (lui:add-child root (labeled :status (if (eq kind :constraints_interactive) "Drag the vertical edge" "Resize the window"))) root))
(defun constraint-check (root)
 (operations root)
 (destructuring-bind (a b) (state root :sizes) (assert (near a b)))
 (let ((c (control root :canvas)))
  (lui:layout c 0 0 900 340) (operations root)
  (assert (near 856 (reduce #'+ (state root :sizes))))))
(defdemo "constraints" "Cassowary solves equal widths, minimum sizes and a spacer guide; resizing recomputes geometry."
 (constraint-demo :constraints) (constraint-check root))
(defdemo "constraints_interactive" "Drag the common button edge to update Cassowary constraints while preserving total width and minima."
 (constraint-demo :constraints_interactive) (constraint-check root)
 (let ((c (control root :canvas)))
  (lui:handle-event c (lui:make-event :kind :down))
  (lui:handle-event c (lui:make-event :kind :move :x 250))
  (lui:handle-event c (lui:make-event :kind :up)) (operations root)
  (assert (< (first (state root :sizes)) (second (state root :sizes))))))
(defdemo "constraints_vfl" "Editable two-button VFL specification with equal-width constraints, explicit spacing and parse errors."
 (constraint-demo :constraints_vfl) (constraint-check root)
 (edit root :source "H:|-[button1(==button2)]-40-[button2]-|") (press root :apply)
 (assert (= 40 (state root :gap)))
 (edit root :source "invalid") (press root :apply) (assert (= 40 (state root :gap))))
(defdemo "constraints_builder" "Safe declarative layout data constructs spacing/ratio constraints and rejects invalid or executable input."
 (constraint-demo :constraints_builder) (constraint-check root)
 (edit root :source "(:gap 30 :ratio 2)") (press root :apply) (operations root)
 (assert (near (* 2 (second (state root :sizes))) (first (state root :sizes)))))
(defun cube-ops (angle)
 (let* ((vertices (loop for z in '(-1 1) append (loop for y in '(-1 1) append (loop for x in '(-1 1) collect (list x y z)))))
        (points (mapcar (lambda (p) (project-3d p angle (* angle 0.7) 90)) vertices)))
  (loop for face in '((0 1 3 2) (4 6 7 5) (0 4 5 1) (2 3 7 6) (0 2 6 4) (1 5 7 3))
        for color in '(:red :orange :green :blue :purple :gold) append
   (let ((p (mapcar (lambda (i) (let ((v (nth i points))) (point (first v) (second v)))) face)))
    (list (op :polygon p color) (op :polyline (append p (list (first p))) 2 :black))))))
(defdemo "fixed" "Manually positioned cube faces projected from rotating 3D coordinates, with animation pause/reset."
 (graphic-root "Fixed cube" :fixed (lambda (c) (cube-ops (state (scene-root c) :time))))
 (assert (= 12 (length (operations root)))) (check-animation root))
(defdemo "fixed2" "Rotation and scaling of a child-like panel around its center, with live transform controls."
 (graphic-root "Fixed transformations" :fixed2
  (lambda (c) (let* ((r (scene-root c)) (angle (+ (state r :angle) (state r :time))) (scale (state r :scale)))
   (list (op :polygon (mapcar (lambda (p) (transformed p angle scale 320 160)) '((-90 -40) (90 -40) (90 40) (-90 40))) :skyblue)
         (op :text "Transformed child" 260 155 18 :black (* 180 (/ angle pi))))))
  :controls '((:angle "Rotation" 0 6.28 0) (:scale "Scale" 0.2 2 1)))
 (set-number root :scale 2) (assert (= 2 (state root :scale))) (check-animation root))
(defun grid-circle-positions (progress)
 (loop for i below 12 collect
  (point-lerp (point (+ 100 (* 120 (mod i 4))) (+ 60 (* 90 (floor i 4))))
              (nth i (regular-points 320 160 135 12)) progress)))
(defun transition-demo ()
 (let ((r (graphic-root "Layout manager transition" :layoutmanager
  (lambda (c) (loop for p in (grid-circle-positions (state (scene-root c) :progress 0)) for i from 1 append
   (list (op :circle (first p) (second p) 24 :skyblue) (op :text (princ-to-string i) (- (first p) 8) (- (second p) 10) 20 :black)))))))
  (setf (state r :progress) 0 (state r :target) 0)
  (add-action r :transition "Grid / circle" (lambda () (setf (state r :target) (- 1 (state r :target)))))
  (lui:on r :tick (lambda (w dt) (declare (ignore w))
   (let ((p (state r :progress)) (target (state r :target)))
    (setf (state r :progress) (if (< p target) (min target (+ p dt)) (max target (- p dt)))))) :owner r) r))
(defdemo "layoutmanager" "Custom grid/circle layout interpolates child positions and reverses transitions on demand."
 (transition-demo) (press root :transition) (tick root 0.5) (assert (near 0.5 (state root :progress)))
 (press root :transition) (tick root 1) (assert (zerop (state root :progress))))
(defdemo "layoutmanager2" "Icons laid out on a projected sphere; arrow keys rotate the sphere around two axes."
 (let ((r (graphic-root "Sphere layout" :layoutmanager2
  (lambda (c) (let ((r (scene-root c)))
   (loop for i below 60 for z = (- 1 (* 2 (/ (+ i 0.5) 60))) for theta = (* i 2.399963)
         for radius = (sqrt (- 1 (* z z))) for p = (project-3d (list (* radius (cos theta)) (* radius (sin theta)) z)
                                                                   (state r :yaw 0) (state r :pitch 0) 130)
         collect (op :circle (first p) (second p) 8 :orange)))))))
  (dolist (spec '((:left :yaw -0.1) (:right :yaw 0.1) (:up :pitch -0.1) (:down :pitch 0.1)))
   (destructuring-bind (key axis delta) spec
    (lui:bind-key r key (lambda () (incf (state r axis 0) delta)) :owner r))) r)
 (let ((before (operations root))) (lui:dispatch root (lui:make-event :kind :key :key :right))
  (assert (not (equalp before (operations root))))) (assert (= 60 (length (operations root)))))
(defclass overlay-layout (lui:widget) ((decorative :initarg :decorative :initform nil :reader decorative-p)))
(defmethod lui:layout :after ((w overlay-layout) x y width height)
 (let ((children (lui:children w)))
  (when children (lui:layout (first children) x y width height))
  (loop for c in (rest children) for i from 0 do
   (lui:layout c (+ x (max 0 (- width 210))) (+ y 16 (* i 46)) 190 38))))
(defun overlay-demo (decorative)
 (let* ((container (make-instance 'overlay-layout :id :overlay :height 340 :decorative decorative))
        (text (node 'lui:text-view :document :height 340 :text "An editable document below the overlay. Select text, scroll, or type here."))
        (r (app "Overlays" container)))
  (lui:add-child container text)
  (lui:add-child container (labeled :badge "Overlay decoration" :style '(:background :gold :foreground :black)))
  (unless decorative
   (let ((button (node 'lui:button :overlay-action :text "Add annotation")))
    (lui:on button :activate (lambda (w e) (declare (ignore w e)) (setf (lui:text text) (concatenate 'string (lui:text text) " [annotation]"))) :owner r)
    (lui:add-child container button)))
  (add-action r :toggle "Show / hide overlay" (lambda () (setf (lui:visible-p (control r :badge)) (not (lui:visible-p (control r :badge)))))) r))
(defdemo "overlay" "Editable scrollable document with independently positioned overlay action and visibility control."
 (overlay-demo nil) (press root :overlay-action) (assert (search "annotation" (lui:text (control root :document))))
 (press root :toggle) (assert (not (lui:visible-p (control root :badge)))))
(defdemo "overlay_decorative" "Decorative overlay does not take focus; the underlying document remains editable."
 (overlay-demo t) (edit root :document "Editable under decoration")
 (assert (string= "Editable under decoration" (lui:text (control root :document)))))
(defdemo "sizegroup" "Two form columns share a computed label width; changing a label recomputes the group."
 (let ((r (app "Size groups")))
  (dolist (spec '((:name "Name") (:address "Address") (:city "City")))
   (let ((row (node 'lui:header-bar nil :height 40)))
    (lui:add-child row (labeled (first spec) (second spec) :width 180))
    (lui:add-child row (node 'lui:entry (intern (format nil "~a-ENTRY" (first spec)) :keyword))) (lui:add-child r row)))
  (add-action r :resize "Use longer label" (lambda ()
   (setf (lui:text (control r :address)) "Street and apartment address")
   (let ((width (* 11 (loop for id in '(:name :address :city) maximize (length (lui:text (control r id)))))))
    (dolist (id '(:name :address :city)) (setf (lui:width (control r id)) width))))) r)
 (press root :resize) (assert (= (lui:width (control root :name)) (lui:width (control root :address))))
 (assert (> (lui:width (control root :name)) 180)))
