(in-package #:lut-gtk-demo)
(defparameter *upstream-demos*
 '("application_demo" "assistant" "builder" "clipboard" "combobox" "constraints" "constraints_interactive" "constraints_vfl" "constraints_builder" "css_accordion" "css_basics" "css_blendmodes" "css_multiplebgs" "css_pixbufs" "css_shadows" "cursors" "dialog" "dnd" "drawingarea" "editable_cells" "entry_completion" "entry_undo" "errorstates" "expander" "filtermodel" "fishbowl" "fixed" "fixed2" "flowbox" "fontrendering" "font_features" "frames" "gears" "gestures" "glarea" "headerbar" "hypertext" "iconscroll" "iconview" "iconview_edit" "image_filtering" "image_scaling" "images" "infobar" "layoutmanager" "layoutmanager2" "links" "listbox" "listbox_controls" "list_store" "listview_applauncher" "listview_clocks" "listview_colors" "listview_filebrowser" "listview_minesweeper" "listview_selections" "listview_settings" "listview_settings2" "listview_ucd" "listview_weather" "listview_words" "markup" "mask" "overlay" "overlay_decorative" "paint" "paintable" "paintable_animated" "paintable_emblem" "paintable_mediastream" "paintable_symbolic" "panes" "password_entry" "path_explorer_demo" "path_fill" "path_maze" "path_spinner" "path_sweep" "path_text" "path_walk" "peg_solitaire" "pickers" "printing" "read_more" "revealer" "rotated_text" "scale" "search_entry" "shadertoy" "shortcuts" "shortcut_triggers" "sidebar" "sizegroup" "sliding_puzzle" "spinbutton" "spinner" "stack" "tabs" "tagged_entry" "textmask" "textundo" "textview" "textscroll" "themes" "theming_style_classes" "transparent" "tree_store" "video_player"))
(defun coverage-text ()
 (let ((done (length (intersection *upstream-demos* (demo-names) :test #'string=))))
 (with-output-to-string (out)
  (format out "# GTK demo suite coverage~%~%Reference: [GTK 4.20.2 manifest](https://gitlab.gnome.org/GNOME/gtk/-/blob/4.20.2/demos/gtk-demo/meson.build).~%~%Generated by `(lut-gtk-demo::write-coverage)` from the runnable registry.~%~%~d of ~d entries have runnable adaptations with individual behavioral tests; ~d entries lack a runnable adaptation.~%This counts runnable behavior, not exact GTK rendering or platform parity.~%The description records the behavior implemented by each adaptation.~%~%Load `lut/gtk-demo`, then `(lut-gtk-demo:demo \"stack\")`.~%Load `lut/raylib` and pass the result to `lut:start`.~%Run `(asdf:test-system \"lut/gtk-demo-tests\")` for all behavioral checks.~%~%| Upstream source | Runnable behavior |~%| --- | --- |~%" done (length *upstream-demos*) (- (length *upstream-demos*) done))
  (dolist (name *upstream-demos*)
   (let ((record (find name *demos* :key #'first :test #'string=)))
    (format out "| `~a.c` | ~a |~%" name (if record (substitute #\/ #\| (second record)) "Pending")))))))
(defun write-coverage ()
 (with-open-file (out (asdf:system-relative-pathname "lut" "examples/gtk-demo-coverage.md") :direction :output :if-exists :supersede)
  (write-string (coverage-text) out)))
(defun check-coverage ()
 (assert (= 108 (length *upstream-demos*) (length *demos*)))
 (assert (null (set-exclusive-or (demo-names) *upstream-demos* :test #'string=)))
 (assert (string= (coverage-text) (uiop:read-file-string (asdf:system-relative-pathname "lut" "examples/gtk-demo-coverage.md"))) ()
  "Demo coverage is stale; run (lut-gtk-demo::write-coverage)."))
