(in-package #:lui-gtk-demo)
(defun markup-color (name)
 (or (cdr (assoc name '(("red" . :red) ("blue" . :blue) ("green" . :green) ("black" . :black)
                       ("purple" . :purple) ("orange" . :orange)) :test #'string-equal))
     (when (and (= 7 (length name)) (char= #\# (char name 0)))
      (append (loop for i from 1 below 7 by 2 collect (parse-integer name :start i :end (+ i 2) :radix 16)) '(255)))
     (error "Unsupported color ~a" name)))
(defun markup-spans (source)
 "Parse XML with XMLS; only the documented formatting tags/attributes are accepted."
 (when (or (> (length source) 65536) (search "<!" source)) (error "Markup is too large or contains a declaration."))
 (let ((tree (xmls:parse (concatenate 'string "<markup>" source "</markup>") :compress-whitespace nil)))
  (unless tree (error "Malformed markup."))
  (labels ((visit (node style depth)
    (when (> depth 32) (error "Markup nesting exceeds 32."))
    (if (stringp node) (list (list :text node :style style))
     (let ((tag (xmls:node-name node)) (next (copy-list style)))
      (cond ((string= tag "b") (setf (getf next :bold) t))
            ((string= tag "i") (setf (getf next :italic) t))
            ((string= tag "u") (setf (getf next :underline) t))
            ((string= tag "s") (setf (getf next :strike) t))
            ((string= tag "big") (setf (getf next :size) 30))
            ((string= tag "small") (setf (getf next :size) 14))
            ((not (member tag '("span" "markup") :test #'string=)) (error "Unsupported tag ~a" tag)))
      (dolist (attr (xmls:node-attrs node))
       (cond ((string= (first attr) "foreground") (setf (getf next :color) (markup-color (second attr))))
             ((string= (first attr) "size") (let ((size (parse-integer (second attr))))
               (unless (<= 8 size 96) (error "Size must be 8..96.")) (setf (getf next :size) size)))
             (t (error "Unsupported attribute ~a" (first attr)))))
      (mapcan (lambda (child) (visit child next (1+ depth))) (xmls:node-children node))))))
   (visit tree '(:size 22 :color :black) 0))))
(defdemo "markup" "Live XML markup editor with nested color, size, bold, italic, underline/strike spans, entity decoding and validation errors."
 (let ((r (app "Markup" (node 'lui:text-view :source :height 160
  :text "<big>Rich <span foreground='blue'>text</span></big> &amp; <b>bold</b>, <i>italic</i>, <u>underline</u>"))))
  (setf (state r :spans) (markup-spans (lui:text (control r :source))))
  (lui:add-child r (scene r :markup (lambda (c) (list (op :rich-text (state (scene-root c) :spans) 20 30 600))) :height 200))
  (lui:add-child r (labeled :status "Edit source and apply"))
  (add-action r :apply "Apply markup" (lambda ()
   (handler-case (progn (setf (state r :spans) (markup-spans (lui:text (control r :source)))) (status r "Markup applied"))
    (error (e) (status r (princ-to-string e)))))) r)
 (edit root :source "<span size='32' foreground='#ff0000'>Red &amp; <u>large</u></span>") (press root :apply)
 (assert (= 2 (length (state root :spans))))
 (assert (= 32 (getf (getf (first (state root :spans)) :style) :size)))
 (assert (getf (getf (second (state root :spans)) :style) :underline))
 (edit root :source "<bogus>bad</bogus>") (press root :apply)
 (assert (search "Unsupported" (lui:text (control root :status)))))
(defun font-file () (asdf:system-relative-pathname "lui" "assets/NotoSans-Regular.ttf"))
(defun font-tables (path)
 (with-open-file (in path :element-type '(unsigned-byte 8))
  (labels ((u16 () (+ (ash (read-byte in) 8) (read-byte in)))
           (u32 () (loop repeat 4 for result = (read-byte in) then (+ (ash result 8) (read-byte in)) finally (return result)))
           (tag () (map 'string #'code-char (loop repeat 4 collect (read-byte in)))))
   (u32) (let ((count (u16))) (file-position in 12)
    (loop repeat count collect (let ((name (tag))) (u32) (list name (u32) (u32))))))))
(defun opentype-features (path)
 (let ((tables (font-tables path)))
  (remove-duplicates
   (loop for table in tables when (member (first table) '("GSUB" "GPOS") :test #'string=) append
    (with-open-file (in path :element-type '(unsigned-byte 8))
     (flet ((u16 () (+ (ash (read-byte in) 8) (read-byte in))))
      (file-position in (+ (second table) 6))
      (let ((base (+ (second table) (u16))))
       (file-position in base)
       (loop repeat (u16) collect (prog1 (map 'string #'code-char (loop repeat 4 collect (read-byte in))) (u16)))))))
   :test #'string=)))
(defun font-axes (path)
 (let ((table (assoc "fvar" (font-tables path) :test #'string=)))
  (when table (with-open-file (in path :element-type '(unsigned-byte 8))
   (labels ((u16 () (+ (ash (read-byte in) 8) (read-byte in)))
            (u32 () (loop repeat 4 for r = (read-byte in) then (+ (ash r 8) (read-byte in)) finally (return r)))
            (fixed () (let ((v (u32))) (/ (if (logbitp 31 v) (- v #x100000000) v) 65536.0))))
    (file-position in (+ 4 (second table)))
    (let ((offset (u16))) (u16)
     (let ((count (u16)) (size (u16)))
      (loop for i below count collect (progn (file-position in (+ (second table) offset (* i size)))
       (list :tag (map 'string #'code-char (loop repeat 4 collect (read-byte in)))
             :minimum (fixed) :default (fixed) :maximum (fixed)))))))))))
(defdemo "font_features" "OpenType explorer reads real GSUB/GPOS feature tags and variable-font axis ranges; raylib preview explicitly reports shaping limitations."
 (let* ((features (opentype-features (font-file)))
        (r (app "OpenType font explorer" (node 'lui:entry :path :text (namestring (font-file)))
                (node 'lui:entry :sample :text "office affine 0123456789")
                (node 'lui:list-view :features :items features :height 150)
                (labeled :axes (format nil "Axes: ~a" (or (font-axes (font-file)) "static font")))
                (labeled :status "Feature application requires a shaping backend; raylib displays unshaped text." :height 60))))
  (setf (state r :features) features)
  (add-action r :load "Inspect font" (lambda ()
   (handler-case (let ((path (lui:text (control r :path))))
    (setf (state r :features) (opentype-features path) (lui:items (control r :features)) (state r :features)
          (lui:text (control r :axes)) (format nil "Axes: ~a" (or (font-axes path) "static font"))))
    (error (e) (status r (princ-to-string e))))))
  (lui:add-child r (scene r :font_features (lambda (c) (let ((r (scene-root c)))
   (list (op :font-text (lui:text (control r :sample)) 20 40 32 :black (lui:text (control r :path)) 0 :bilinear)))) :height 100)) r)
 (assert (find "liga" (state root :features) :test #'string=))
 (assert (null (font-axes (font-file))))
 (edit root :sample "Hello λ") (assert (string= "Hello λ" (second (first (operations root))))))
(defdemo "fontrendering" "Font file, size, letter spacing and nearest/bilinear raster filtering controls with grid-alignment comparison; Cairo hinting modes are unavailable."
 (let ((r (graphic-root "Font rendering" :fontrendering
  (lambda (c) (let* ((r (scene-root c)) (text (lui:text (control r :sample)))
                    (path (lui:text (control r :path))) (size (state r :size)) (spacing (state r :spacing)))
   (list (op :font-text text 20 40 size :black path spacing (if (state r :nearest) :point :bilinear))
         (op :font-text text 20.5 130.5 size :maroon path spacing (if (state r :nearest) :point :bilinear)))))
  :controls '((:size "Font size" 8 96 32) (:spacing "Letter spacing" 0 12 0)))))
  (lui:add-child r (node 'lui:entry :sample :text "The quick brown fox — λ 0123456789"))
  (lui:add-child r (node 'lui:entry :path :text (namestring (font-file))))
  (add-action r :filter "Nearest / bilinear" (lambda () (setf (state r :nearest) (not (state r :nearest))))) r)
 (set-number root :size 48) (assert (= 48 (fifth (first (operations root)))) )
 (press root :filter) (assert (eq :point (car (last (first (operations root)))))))
(defun mask-demo (animated)
 (let ((r (graphic-root (if animated "Animated text mask" "Gradient text mask") (if animated :mask :textmask)
  (lambda (c) (let ((r (scene-root c)))
   (list (op :gradient-text (lui:text (control r :sample)) 30 50 (state r :size) 0 (if animated (state r :time) 0))
         (op :gradient-text (lui:text (control r :sample)) 30 150 (state r :size) 0 (if animated (+ 1 (state r :time)) 0)))))
  :controls '((:size "Text size" 20 90 54)))))
  (lui:add-child r (node 'lui:entry :sample :text "Lisp power!")) r))
(defdemo "mask" "Animated rainbow gradient clipped by real font glyph alpha, with editable text, size and pause controls."
 (mask-demo t) (check-animation root)
 (edit root :sample "Mask λ") (assert (string= "Mask λ" (second (first (operations root))))))
(defdemo "textmask" "Static multicolor gradient fills repeated glyph masks at scalable font sizes."
 (mask-demo nil) (set-number root :size 72) (assert (= 72 (fifth (first (operations root))))))
(defdemo "rotated_text" "Text transformed around a circle plus an independently rotated label, with adjustable angle, size and editable Unicode text."
 (let ((r (graphic-root "Rotated text" :rotated_text
  (lambda (c) (let* ((r (scene-root c)) (angle (state r :angle)) (text (lui:text (control r :sample))))
   (append (loop for i below 8 for a = (+ angle (* i 45)) for radians = (* pi (/ a 180))
    collect (op :text text (+ 180 (* 100 (cos radians))) (+ 150 (* 100 (sin radians))) (state r :size) :maroon a))
    (list (op :text text 440 150 (state r :size) :blue angle)))))
  :controls '((:angle "Angle" 0 360 0) (:size "Font size" 8 40 20)))))
  (lui:add-child r (node 'lui:entry :sample :text "I ♥ Lisp")) r)
 (let ((before (operations root))) (set-number root :angle 90) (assert (not (equalp before (operations root)))))
 (assert (= 9 (length (operations root)))))
