(in-package #:lui-gtk-demo)
(defparameter *completion-words* '("GNOME" "gnominious" "Gnomonic projection" "Gnosophy" "total" "totally" "toto" "tottery" "totterer" "Tottenham hotspurs" "totipotent" "totem pole" "totalitarianism" "total eclipse" "zombie" "aæx" "aæy" "aæz"))
(defdemo "entry_completion" "Case-insensitive prefix completion, Unicode suggestions, keyboard selection and acceptance with freely editable entry text."
 (let* ((entry (node 'lui:entry :completion)) (matches (node 'lui:list-view :matches :height 220))
        (r (app "Entry completion" entry matches (labeled :status "Type a prefix"))))
  (changed entry (lambda (w text) (declare (ignore w))
   (setf (lui:items matches) (remove-if-not (lambda (word) (and (<= (length text) (length word))
                                                      (string-equal text word :end2 (length text)))) *completion-words*)
         (lui:value matches) nil)) r)
  (add-action r :accept "Accept selected suggestion" (lambda ()
   (when (lui:value matches) (set-entry entry (nth (lui:value matches) (lui:items matches))) (status r (lui:text entry))))) r)
 (edit root :completion "gno") (assert (= 4 (length (lui:items (control root :matches)))) )
 (choose-index root :matches 2) (press root :accept) (assert (string= "Gnomonic projection" (lui:text (control root :completion)))))
(defdemo "combobox" "Icon choices, hierarchical grouped choices, and editable custom values demonstrate selection models independently of their display."
 (let* ((choice (node 'lui:dropdown :icons :items '("◆ Red" "● Green" "■ Blue") :value 0))
        (tree (node 'lui:tree-view :groups :height 170 :nodes
           (copy-tree '((:text "Europe" :open t :children ((:text "Berlin") (:text "Paris")))
                        (:text "America" :children ((:text "Boston") (:text "Lima")))))))
        (entry (node 'lui:combo-box :editable :items '("Berlin" "Paris" "Boston" "Lima") :text "Berlin"))
        (r (app "Combo boxes" choice tree entry (labeled :status "Select or type a custom value"))))
  (changed entry (lambda (w text) (declare (ignore w)) (status r text)) r)
  (changed choice (lambda (w index) (status r (nth index (lui:items w)))) r) r)
 (choose-index root :icons 1) (assert (search "Green" (lui:text (control root :status))))
 (edit root :editable "Custom city") (assert (string= "Custom city" (lui:text (control root :status)))))
(defdemo "expander" "Error summary expands into a scrollable, selectable details report; expansion adjusts the preferred top-level height."
 (let* ((e (node 'lui:expander :details :text "Details" :height 300))
        (r (app "Error details" (labeled :summary "Something went wrong" :style '(:font-size 28))
                (labeled nil "Expand the report for the full story") e)))
  (lui:add-child e (node 'lui:text-view :report :height 260
   :text (format nil "Operation failed.~%~%Context: portable GUI example~%No data was lost.~%~{Diagnostic ~d: retry is safe.~%~}" (loop for i below 20 collect i))))
  (changed e (lambda (w expanded) (declare (ignore w)) (setf (lui:height r) (if expanded 460 200)))) r)
 (let ((e (control root :details)))
  (assert (null (lui:active-children e)))
  (lui:handle-event e (lui:make-event :kind :down :x (lui:x e) :y (lui:y e)))
  (assert (= 460 (lui:height root))) (assert (lui:active-children e))))
(defun pane-demo ()
 (let* ((outer (node 'lui:paned :outer :orientation :vertical :height 400 :value 0.6))
        (inner (node 'lui:paned :inner :height 240 :value 0.5))
        (r (app "Paned controls" outer (labeled :status "Drag either splitter"))))
  (lui:add-child inner (node 'lui:text-view :left :text "Left: select and edit"))
  (lui:add-child inner (node 'lui:text-view :right :text "Right: independent viewport"))
  (lui:add-child outer inner) (lui:add-child outer (node 'lui:text-view :bottom :text "Bottom pane"))
  (add-action r :equal "Equal split" (lambda () (setf (lui:value outer) 0.5 (lui:value inner) 0.5)))
  (add-action r :collapse "Collapse left / restore" (lambda () (setf (lui:value inner) (if (zerop (lui:value inner)) 0.5 0)))) r))
(defdemo "panes" "Nested horizontal/vertical paned editors with independent text selection, draggable dividers, collapse and equalize actions."
 (pane-demo) (press root :collapse) (assert (zerop (lui:value (control root :inner))))
 (press root :equal) (lui:layout root 0 0 720 600)
 (assert (near (lui:width (control root :left)) (lui:width (control root :right)))))
(defun tab-fields (line) (uiop:split-string line :separator '(#\Tab)))
(defdemo "tabs" "Editable tab-separated text uses left, decimal-point and right-aligned tab stops with adjustable positions."
 (let ((r (graphic-root "Text tab stops" :tabs
  (lambda (c) (let ((r (scene-root c)))
   (list (op :tabbed-text (lui:text (control r :source)) (state r :decimal) (state r :right)))))
  :controls '((:decimal "Decimal stop" 100 350 200) (:right "Right stop" 360 620 560)))))
  (lui:add-child r (node 'lui:text-view :source :height 110
     :text (format nil "one~c2.0~cthree~%four~c5.555~csix~%seven~c88.88~cnine" #\Tab #\Tab #\Tab #\Tab #\Tab #\Tab))) r)
 (assert (= 3 (length (list-of-strings (lui:text (control root :source))))))
 (set-number root :decimal 240) (assert (= 240 (third (first (operations root)))) )
 (assert (equal '("a" "12.30" "end") (tab-fields (format nil "a~c12.30~cend" #\Tab #\Tab)))))
(defdemo "spinbutton" "Bounded numeric spin input plus custom hexadecimal, time-of-day and month formats with validated text parsing."
 (let ((r (app "Spin buttons" (node 'lui:spin-button :number :minimum -10 :maximum 10 :value 0 :step 0.5)
               (node 'lui:spin-button :hex :minimum 0 :maximum 255 :value 32)
               (node 'lui:entry :hex-input :text "20")
               (node 'lui:spin-button :time :minimum 0 :maximum 1439 :value 570 :step 15)
               (node 'lui:spin-button :month :minimum 1 :maximum 12 :value 1)
               (labeled :formatted "") (labeled :status "Edit hex, then apply"))))
  (labels ((refresh () (setf (lui:text (control r :formatted))
    (format nil "Hex ~2,'0X; time ~2,'0d:~2,'0d; month ~a"
     (round (lui:value (control r :hex))) (floor (lui:value (control r :time)) 60) (mod (round (lui:value (control r :time))) 60)
     (nth (1- (round (lui:value (control r :month)))) '("January" "February" "March" "April" "May" "June" "July" "August" "September" "October" "November" "December"))))))
   (dolist (id '(:hex :time :month)) (changed (control r id) (lambda (w v) (declare (ignore w v)) (refresh)) r))
   (add-action r :apply "Apply hexadecimal" (lambda ()
    (handler-case (let ((number (parse-integer (lui:text (control r :hex-input)) :radix 16)))
     (unless (<= 0 number 255) (error "Hex must be 00..FF.")) (set-number r :hex number) (status r "Valid hexadecimal"))
     (error (e) (status r (princ-to-string e)))))) (refresh)) r)
 (edit root :hex-input "FF") (press root :apply) (assert (= 255 (lui:value (control root :hex))))
 (set-number root :time 615) (assert (search "10:15" (lui:text (control root :formatted)))))
(defdemo "scale" "Shared numeric adjustment, fractional scales, marked value snapping and configurable selection bounds."
 (let* ((slider (node 'lui:slider :scale :minimum 0 :maximum 0.5 :step 0.01 :value 0.1))
        (progress (node 'lui:progress-bar :progress :maximum 0.5 :value 0.1))
        (r (app "Scales" slider progress (node 'lui:check-button :snap :text "Snap to marks")
                (labeled :marks "Marks: 0   0.125   0.25   0.375   0.5") (labeled :status "0.1"))))
  (changed slider (lambda (w v)
   (let ((value (if (lui:value (control r :snap)) (* 0.125 (round v 0.125)) v)))
    (setf (lui:value w) value (lui:value progress) value) (status r (format nil "Value: ~,3f" value)))) r) r)
 (setf (lui:value (control root :snap)) t) (set-number root :scale 0.18)
 (assert (= 0.125 (lui:value (control root :progress))))
 (set-number root :scale 0.49) (assert (= 0.5 (lui:value (control root :progress)))))
(defclass message-row (lui:box) ())
(defun refresh-messages (root)
 (let* ((container (control root :messages)) (query (lui:text (control root :query)))
        (rows (sort (copy-list (state root :messages)) (if (state root :reverse) #'> #'<) :key (lambda (m) (getf m :time)))))
  (dolist (child (copy-list (lui:children container))) (lui:dispose child))
  (dolist (message rows)
   (when (or (search query (getf message :text) :test #'char-equal) (search query (getf message :author) :test #'char-equal))
    (let ((row (make-instance 'message-row :height 140)))
     (lui:add-child row (labeled nil (format nil "~a  — ~d minutes ago" (getf message :author) (getf message :time))))
     (lui:add-child row (labeled nil (getf message :text)))
     (let ((button (node 'lui:button nil :height 28 :text (if (getf message :star) "Starred" "Star"))))
      (lui:on button :activate (lambda (w e) (declare (ignore e))
       (setf (getf message :star) (not (getf message :star)) (lui:text w) (if (getf message :star) "Starred" "Star"))) :owner row)
      (lui:add-child row button)) (lui:add-child container row))))))
(defdemo "listbox" "Composite message rows include author, timestamp, body and favorite action; filtering/sorting rebuilds and disposes row widgets."
 (let ((r (app "Complex list box" (node 'lui:entry :query)
               (node 'lui:scroll-view :messages :height 390) (labeled :status "Search author or message"))))
  (setf (state r :messages) (copy-tree '((:author "Ada" :time 2 :text "The release is ready.")
                                       (:author "Grace" :time 5 :text "Please review the editor.")
                                       (:author "Alan" :time 12 :text "I added keyboard shortcuts.")
                                       (:author "Ada" :time 30 :text "Portable interfaces matter."))))
  (changed (control r :query) (lambda (w v) (declare (ignore w v)) (refresh-messages r)) r)
  (add-action r :sort "Reverse time order" (lambda () (setf (state r :reverse) (not (state r :reverse))) (refresh-messages r)))
  (refresh-messages r) r)
 (let ((old (first (lui:children (control root :messages)))))
  (edit root :query "Ada") (assert (lui:disposed-p old)))
 (assert (= 2 (length (lui:children (control root :messages)))))
 (press root :sort) (assert (search "30" (lui:text (first (lui:children (first (lui:children (control root :messages)))))))))
(defclass animated-stack (lui:stack)
 ((previous :initform nil :accessor previous-page) (progress :initform 1 :accessor transition-progress)))
(defmethod lui:active-children ((w animated-stack))
 (let ((current (nth (lui:value w) (lui:children w))))
  (if (and (previous-page w) (< (transition-progress w) 1)) (list (previous-page w) current) (list current))))
(defmethod lui:layout :after ((w animated-stack) x y width height)
 (when (and (previous-page w) (< (transition-progress w) 1))
  (lui:layout (previous-page w) (- x (* width (transition-progress w))) y width height)
  (lui:layout (nth (lui:value w) (lui:children w)) (+ x (* width (- 1 (transition-progress w)))) y width height)))
(defmethod lui:dispose :after ((w animated-stack)) (setf (previous-page w) nil))
(defun switch-animated-page (stack index)
 (unless (= index (lui:value stack))
  (setf (previous-page stack) (nth (lui:value stack) (lui:children stack)) (transition-progress stack) 0)
  (lui:select-page stack index)))
(defdemo "stack" "Stack switcher drives three live pages with reversible slide geometry, adjustable transition duration and independent page state."
 (let* ((s (make-instance 'animated-stack :id :pages :height 280))
        (r (app "Stack transitions" (node 'lui:dropdown :page :items '("Welcome" "Editor" "Settings") :value 0) s
                (node 'lui:slider :duration :minimum 0.1 :maximum 2 :value 0.5))))
  (lui:add-child s (labeled :welcome "Welcome to stack transitions" :style '(:background :skyblue)))
  (lui:add-child s (node 'lui:text-view :editor :text "This buffer survives page changes."))
  (lui:add-child s (node 'lui:check-button :setting :text "Persistent option"))
  (changed (control r :page) (lambda (w index) (declare (ignore w)) (switch-animated-page s index)) r)
  (lui:on r :tick (lambda (w dt) (declare (ignore w))
   (setf (transition-progress s) (min 1 (+ (transition-progress s) (/ dt (lui:value (control r :duration))))))
   (when (= 1 (transition-progress s)) (setf (previous-page s) nil))) :owner s) r)
 (choose-index root :page 1) (tick root 0.25) (lui:layout root 0 0 720 600)
 (assert (near 0.5 (transition-progress (control root :pages))))
 (assert (= 2 (length (lui:active-children (control root :pages)))))
 (tick root 1) (assert (= 1 (length (lui:active-children (control root :pages)))))
 (edit root :editor "Preserved text") (choose-index root :page 0) (tick root 1) (choose-index root :page 1) (tick root 1)
 (assert (string= "Preserved text" (lui:text (control root :editor)))))
(defdemo "themes" "Application palette inheritance across text, editable controls, selection, progress, disabled actions and per-control accents."
 (let ((r (app "Theme preview" (labeled :title "Application-wide inherited styling" :style '(:font-size 26))
               (node 'lui:entry :entry :text "Editable text and selection")
               (node 'lui:check-button :check :text "Checked option" :value t)
               (node 'lui:slider :scale :value 0.5)
               (node 'lui:progress-bar :progress :value 0.5)
               (node 'lui:button :disabled :text "Disabled action" :enabled-p nil)
               (node 'lui:button :override :text "Local accent" :style '(:foreground :maroon)))))
  (changed (control r :scale) (lambda (w value) (declare (ignore w)) (setf (lui:value (control r :progress)) value)) r)
  (add-action r :theme "Light / dark" (lambda () (setf (lui:theme r) (if (eq (lui:theme r) lui:*dark-theme*) lui:*light-theme* lui:*dark-theme*))))
  (add-action r :font "Larger application text" (lambda () (setf (lui:style r) '(:font-size 24 :line-height 30 :row-height 34)))) r)
 (press root :theme) (assert (eq lui:*dark-theme* (lui:theme root)))
 (assert (equal (lui:style-value root :foreground) (lui:style-value (control root :entry) :foreground)))
 (press root :font) (assert (= 24 (lui:style-value (control root :entry) :font-size)))
 (assert (eq :maroon (lui:style-value (control root :override) :foreground))))
(defun parse-style-data (source)
 (let ((*read-eval* nil))
  (multiple-value-bind (data end) (read-from-string source)
   (unless (and (listp data) (evenp (length data))
                (every (lambda (c) (find c '(#\Space #\Newline #\Tab))) (subseq source end))
                (loop for (key value) on data by #'cddr always (and (member key '(:font-size :padding :foreground :background :border-width :border-radius))
                                                                 (or (numberp value) (keywordp value) (listp value)))))
    (error "Expected a style token property list."))
   (lui::validate-style data) data)))
(defdemo "css_basics" "Live style-source editor applies validated portable style tokens atomically, with inheritance, local overrides, reset and parse-error feedback."
 (let ((r (app "Style basics" (node 'lui:text-view :source :height 140 :text "(:font-size 24 :padding 12 :foreground :blue)")
               (labeled :sample "Inherited sample")
               (node 'lui:entry :entry :text "Inherited editable control")
               (labeled :local "Local color override" :style '(:foreground :maroon))
               (labeled :status "Portable style tokens replace CSS syntax"))))
  (add-action r :apply "Apply style" (lambda ()
   (handler-case (let ((data (parse-style-data (lui:text (control r :source)))))
    (setf (lui:style r) data) (status r "Style applied"))
    (error (e) (status r (princ-to-string e))))))
  (add-action r :reset "Reset style" (lambda () (setf (lui:style r) nil))) r)
 (press root :apply) (assert (= 24 (lui:style-value (control root :entry) :font-size)))
 (edit root :source "(:font-size -2)") (press root :apply)
 (assert (= 24 (lui:style-value (control root :sample) :font-size)))
 (assert (eq :maroon (lui:style-value (control root :local) :foreground)))
 (press root :reset) (assert (= 18 (lui:style-value (control root :sample) :font-size))))
(defun entry-dialog (root)
 (let ((d (node 'lui:dialog :dialog :text "Edit personal details" :width 430 :height 280)))
  (lui:add-child d (labeled nil "Drag the title; drag outside to detach"))
  (lui:add-child d (node 'lui:entry :dialog-name :text (state root :name "Ada")))
  (lui:add-child d (node 'lui:entry :dialog-address :text (state root :address "London")))
  (let ((save (node 'lui:button :accept :text "Apply")) (cancel (node 'lui:button :cancel :text "Cancel")))
   (lui:on save :activate (lambda (w e) (declare (ignore w e))
    (setf (state root :name) (lui:text (lui:find-widget d :dialog-name))
          (state root :address) (lui:text (lui:find-widget d :dialog-address)))
    (status root (format nil "~a — ~a" (state root :name) (state root :address))) (lui:dismiss-dialog d)) :owner d)
   (lui:on cancel :activate (lambda (w e) (declare (ignore w e)) (lui:dismiss-dialog d)) :owner d)
   (lui:add-child d save) (lui:add-child d cancel)) (lui:show-dialog root d) d))
(defun overlay-control (root id)
 (or (loop for d in (slot-value root 'lui::overlays) thereis (lui:find-widget d id)) (error "Missing dialog control ~a" id)))
(defun press-dialog (root id)
 (lui:focus root (overlay-control root id)) (lui:dispatch root (lui:make-event :kind :key :key :enter)))
(defdemo "dialog" "Modal editable details dialog applies or cancels changes, remembers committed values, supports title dragging and native detachment."
 (let ((r (app "Dialogs" (labeled :status "Waiting"))))
  (add-action r :open "Edit details" (lambda () (entry-dialog r)))
  (add-action r :message "Show message" (lambda ()
   (let ((d (node 'lui:dialog :text "Message" :width 360 :height 180)))
    (lui:add-child d (labeled nil "A reusable modal message dialog"))
    (let ((b (node 'lui:button :close-message :text "Close")))
     (lui:on b :activate (lambda (w e) (declare (ignore w e)) (lui:dismiss-dialog d)) :owner d) (lui:add-child d b))
    (lui:show-dialog r d)))) r)
 (press root :open)
 (let ((field (overlay-control root :dialog-name))) (lui:focus root field) (lui:select-all field)
  (lui:dispatch root (lui:make-event :kind :text :text "Grace")))
 (press-dialog root :accept) (assert (string= "Grace" (state root :name)))
 (press root :open) (assert (string= "Grace" (lui:text (overlay-control root :dialog-name))))
 (press-dialog root :cancel) (assert (null (slot-value root 'lui::overlays))))
