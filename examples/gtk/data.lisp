(in-package #:lui-gtk-demo)
(defclass virtual-list (lui:list-view)
 ((count :initarg :count :initform 0 :accessor model-count)
  (item :initarg :item :initform nil :accessor item-function)
  (selection-mode :initarg :selection-mode :initform :single :accessor selection-mode)
  (selected :initform nil :accessor selected-indices)
  (orientation :initarg :orientation :initform :vertical :accessor view-orientation)))
(defmethod lui:dispose :after ((w virtual-list)) (setf (item-function w) nil (selected-indices w) nil))
(defun model-item (view index) (funcall (item-function view) index))
(defun item-text (item) (if (stringp item) item (getf item :text "")))
(defun row-extent (view) (if (eq (view-orientation view) :horizontal) 140 (lui:row-height view)))
(defun visible-rows (view)
 (let* ((extent (row-extent view))
        (start (floor (lui:scroll-offset view) extent))
        (size (if (eq (view-orientation view) :horizontal) (lui:width view) (lui:height view)))
        (end (min (model-count view) (+ start 2 (ceiling size extent)))))
   (loop for i from start below end collect (list i (model-item view i)))))
(defun synchronize-view (view)
 (setf (lui:items view) (mapcar (lambda (r) (item-text (second r))) (visible-rows view))))
(defmethod lui:layout :after ((w virtual-list) x y width height)
 (declare (ignore x y width height)) (synchronize-view w))
(defun model-select (view index &optional extend)
 (unless (or (eq (selection-mode view) :none) (not (< -1 index (model-count view))))
   (setf (lui:value view) index)
   (if (and extend (eq (selection-mode view) :multiple))
       (if (member index (selected-indices view)) (setf (selected-indices view) (remove index (selected-indices view)))
           (push index (selected-indices view)))
       (setf (selected-indices view) (list index)))
   (lui:emit view :change index)))
(defmethod lui:handle-event ((w virtual-list) e)
 (case (lui:event-kind e)
   (:wheel
    (let ((size (if (eq (view-orientation w) :horizontal) (lui:width w) (lui:height w))))
      (setf (lui:scroll-offset w) (clamp (- (lui:scroll-offset w) (* (lui:event-delta e) (row-extent w)))
                                      0 (max 0 (- (* (row-extent w) (model-count w)) size))))) t)
   (:up
    (model-select w (floor (+ (lui:scroll-offset w)
                (if (eq (view-orientation w) :horizontal) (- (lui:event-x e) (lui:x w)) (- (lui:event-y e) (lui:y w))))
                           (row-extent w)) (lui:event-shift-p e)) t)
   (:key (when (member (lui:event-key e) '(:up :down :home :end))
           (model-select w (case (lui:event-key e) (:home 0) (:end (1- (model-count w)))
              (:up (max 0 (1- (or (lui:value w) 0)))) (:down (min (1- (model-count w)) (1+ (or (lui:value w) -1)))))) t))))
(defclass flow (lui:grid) ())
(defmethod lui:layout :after ((w flow) x y width height)
 (declare (ignore height))
 (let* ((columns (max 1 (floor width 120))) (cell-width (/ width columns)) (cell-height 52))
   (setf (lui:columns w) columns (lui:height w) (* cell-height (ceiling (length (lui:children w)) columns)))
   (loop for child in (lui:children w) for i from 0 do
     (lui:layout child (+ x (* (mod i columns) cell-width)) (+ y (* (floor i columns) cell-height))
                 (max 0 (- cell-width 4)) (- cell-height 4)))))
(defun model-view (id count item &rest options)
 (apply #'make-instance 'virtual-list :id id :count count :item item :height 280 options))
(defun bug-table ()
 (node 'lui:table-view :bugs :height 260 :columns '("Fixed" "ID" "Severity" "Description" "Progress")
   :rows (copy-tree '((nil 60482 "Normal" "Drawing issue" 0) (t 60620 "Critical" "Crash during save" 100)
                     (nil 50214 "High" "Slow scrolling" 25) (nil 52877 "Low" "Label alignment" 60)))))
(defdemo "list_store" "Mutable bug-list model with toggles, sortable columns, progress and activity updates."
 (let* ((table (bug-table)) (root (app "Bug list" table (labeled :status "Select a bug"))))
   (add-action root :toggle "Toggle fixed" (lambda ()
     (when (lui:value table)
       (let* ((rows (copy-tree (lui:rows table))) (row (nth (lui:value table) rows)))
         (setf (first row) (not (first row)) (fifth row) (if (first row) 100 0) (lui:rows table) rows)))))
   (lui:on root :tick (lambda (w dt) (declare (ignore w))
     (setf (state root :activity) (mod (+ (state root :activity 0) dt) 1))) :owner table) root)
 (choose-index root :bugs 0) (press root :toggle)
 (assert (first (first (lui:rows (control root :bugs)))))
 (lui:sort-table (control root :bugs) 1)
 (assert (= 50214 (second (first (lui:rows (control root :bugs)))))))
(defdemo "filtermodel" "Filtered table with computed columns that are not stored in the source model."
 (let* ((query (node 'lui:entry :query)) (table (bug-table))
        (root (app "Filter model" query table)))
   (setf (state root :source) (copy-tree (lui:rows table)))
   (changed query (lambda (w text) (declare (ignore w))
     (setf (lui:rows table) (loop for row in (state root :source)
       when (search text (fourth row) :test #'char-equal)
       collect (list (first row) (second row) (third row) (fourth row)
                     (format nil "~a (~d%)" (if (first row) "Done" "Open") (fifth row)))))) root) root)
 (edit root :query "save") (assert (= 1 (length (lui:rows (control root :bugs)))))
 (assert (string= "Done (100%)" (fifth (first (lui:rows (control root :bugs)))))))
(defun table-cell-edit (root table row column)
 (let* ((popup (node 'lui:popover :cell-editor :width 300 :height 130 :x (lui:x table)
                    :y (+ (lui:y table) (* (1+ row) (lui:row-height table)))))
        (entry (node 'lui:entry :cell-value :text (princ-to-string (nth column (nth row (lui:rows table)))))))
   (lui:add-child popup entry)
   (lui:add-child popup (action :apply-cell "Apply" (lambda ()
     (let ((rows (copy-tree (lui:rows table))))
       (setf (nth column (nth row rows)) (lui:text entry) (lui:rows table) rows))
     (lui:dismiss-dialog popup))))
   (lui:show-dialog root popup) (lui:focus root entry)))
(defdemo "editable_cells" "Editable shopping-list cells, add/remove rows and numeric progress data."
 (let* ((table (node 'lui:table-view :shopping :columns '("Item" "Quantity" "Progress") :height 260
                    :rows (copy-tree '(("Milk" "2" "20%") ("Bread" "1" "0%") ("Apples" "6" "100%")))))
        (column (node 'lui:dropdown :column :items '("Item" "Quantity" "Progress") :value 0))
        (root (app "Editable cells" table column)))
   (changed table (lambda (w row) (table-cell-edit root w row (lui:value column))) root)
   (add-action root :add "Add item" (lambda () (setf (lui:rows table) (append (lui:rows table) '(("New item" "1" "0%"))))))
   (add-action root :remove "Remove selected" (lambda ()
     (when (lui:value table)
       (setf (lui:rows table) (loop for row in (lui:rows table) for i from 0 unless (= i (lui:value table)) collect row)
             (lui:value table) nil)))) root)
 (choose-index root :shopping 0)
 (let ((popup (lui::input-root root)))
   (lui:select-all (control popup :cell-value)) (lui:replace-selection (control popup :cell-value) "Oat milk")
   (lui::activate (control popup :apply-cell)))
 (assert (string= "Oat milk" (caar (lui:rows (control root :shopping)))))
 (press root :add) (assert (= 4 (length (lui:rows (control root :shopping)))))
 (press root :remove) (assert (= 3 (length (lui:rows (control root :shopping))))))
(defdemo "tree_store" "Hierarchical holiday-card planner with grouped contacts and editable sending state."
 (let* ((tree (node 'lui:tree-view :tree :height 300 :nodes
    '((:text "Family" :open t :children ((:text "Alex" :send t) (:text "Pat" :send nil)))
      (:text "Friends" :open t :children ((:text "Sam" :send t) (:text "Jo" :send nil))))))
        (root (app "Holiday card planner" tree (labeled :status "Select a contact"))))
   (add-action root :toggle "Toggle send card" (lambda ()
     (when (lui:value tree)
       (let ((node (first (nth (lui:value tree) (lui:tree-rows tree)))))
         (unless (getf node :children)
           (setf (getf node :send) (not (getf node :send)))
           (status root (format nil "~a: ~a" (getf node :text) (if (getf node :send) "Send" "Do not send")))))))) root)
 (choose-index root :tree 1) (press root :toggle)
 (assert (not (getf (first (nth 1 (lui:tree-rows (control root :tree)))) :send)))
 (lui:handle-event (control root :tree) (lui:make-event :kind :down :x 8 :y 8))
 (assert (= 4 (length (lui:tree-rows (control root :tree))))))
(defun color-value (index)
 (list (ldb (byte 8 16) index) (ldb (byte 8 8) index) (ldb (byte 8 0) index) 255))
(defun color-item (index)
 (list :text (format nil "#~6,'0x" index) :color (color-value index)))
(defdemo "listview_colors" "Virtual color model up to 16,777,216 rows with channel ordering and multiple selection."
 (let* ((size (node 'lui:dropdown :size :items '("256" "4096" "16777216") :value 0))
        (order (node 'lui:dropdown :order :items '("RGB" "BGR") :value 0))
        (view (model-view :colors 256 (lambda (i) (color-item i)) :selection-mode :multiple))
        (root (app "Virtual colors" size order view (labeled :status "Select colors; Shift extends selection"))))
   (flet ((update ()
            (setf (model-count view) (nth (lui:value size) '(256 4096 16777216))
              (item-function view) (lambda (i)
                (color-item (if (zerop (lui:value order)) i
                  (+ (ash (ldb (byte 8 0) i) 16) (logand i #xff00) (ldb (byte 8 16) i))))))
            (setf (lui:scroll-offset view) 0)))
     (changed size (lambda (w v) (declare (ignore w v)) (update)) root)
     (changed order (lambda (w v) (declare (ignore w v)) (update)) root))
   (changed view (lambda (w index) (status root (format nil "~a; ~d selected" (item-text (model-item w index))
                                                                      (length (selected-indices w))))) root) root)
 (choose-index root :size 2) (assert (= 16777216 (model-count (control root :colors))))
 (model-select (control root :colors) 10) (model-select (control root :colors) 20 t)
 (assert (= 2 (length (selected-indices (control root :colors)))))
 (assert (< (length (visible-rows (control root :colors))) 30))
 (choose-index root :order 1) (assert (equal '(255 0 0 255) (getf (model-item (control root :colors) 255) :color))))
(defdemo "flowbox" "Responsive color-button flow with filtering, sorting and selection."
 (let* ((query (node 'lui:entry :query)) (flow (node 'flow :flow :height 2000))
        (scroll (node 'lui:scroll-view :scroller :height 300))
        (root (app "Flow box" query scroll (labeled :status "Select a color"))))
   (lui:add-child scroll flow) (setf (state root :reverse) nil)
   (labels ((refresh ()
              (dolist (child (copy-list (lui:children flow))) (lui:dispose child))
              (let ((indices (loop for i below 665 when (search (lui:text query) (format nil "Color ~3,'0d" i) :test #'char-equal) collect i)))
                (when (state root :reverse) (setf indices (reverse indices)))
                (dolist (i indices)
                  (let ((b (action nil (format nil "Color ~3,'0d" i) (lambda () (setf (state root :selected) i)))))
                    (setf (lui:style b) (list :surface (color-value (* i 20000)))) (lui:add-child flow b))))))
     (changed query (lambda (w text) (declare (ignore w text)) (refresh)) root)
     (add-action root :sort "Reverse order" (lambda () (setf (state root :reverse) (not (state root :reverse))) (refresh))) (refresh)) root)
 (assert (= 665 (length (lui:children (control root :flow)))))
 (edit root :query "Color 00") (assert (= 10 (length (lui:children (control root :flow)))))
 (lui:layout (control root :flow) 0 0 240 300) (assert (= 2 (lui:columns (control root :flow))))
 (press root :sort) (assert (string= "Color 009" (lui:text (first (lui:children (control root :flow)))))))
(defun directory-entries (directory)
 (sort (append (uiop:subdirectories directory) (uiop:directory-files directory)) #'string-lessp :key #'namestring))
(defun file-browser (title icons-only)
 (let* ((path (node 'lui:entry :path :text (namestring (asdf:system-source-directory "lui"))))
        (pages (node 'lui:stack :views :height 320)) (icons (node 'flow :icons :height 1200))
        (scroll (node 'lui:scroll-view :icon-scroll :height 300))
        (view (model-view :files 0 (lambda (i) (declare (ignore i)) "")))
        (root (app title path pages (labeled :status "Choose a file or open a directory"))))
   (lui:add-child scroll icons) (lui:add-child pages view) (lui:add-child pages scroll)
   (labels ((browse ()
              (let* ((dir (uiop:ensure-directory-pathname (lui:text path))) (entries (directory-entries dir)))
                (setf (state root :directory) dir (state root :entries) entries (model-count view) (length entries)
                      (item-function view) (lambda (i) (namestring (nth i (state root :entries)))))
                (dolist (child (copy-list (lui:children icons))) (lui:dispose child))
                (dolist (file entries)
                  (lui:add-child icons (action nil (file-namestring file) (lambda ()
                    (if (uiop:directory-pathname-p file) (progn (set-entry path (namestring file)) (browse))
                        (progn (setf (state root :selected) file) (status root (namestring file)))))))))))
     (add-action root :browse "Browse" #'browse)
     (add-action root :up "Parent directory" (lambda () (set-entry path (namestring (uiop:pathname-parent-directory-pathname (state root :directory)))) (browse)))
     (add-action root :open "Open selected directory" (lambda ()
       (when (lui:value view) (let ((p (nth (lui:value view) (state root :entries))))
         (if (uiop:directory-pathname-p p) (progn (set-entry path (namestring p)) (browse))
             (progn (setf (state root :selected) p) (status root (namestring p))))))))
     (unless icons-only (add-action root :presentation "List / icons" (lambda () (lui:select-page pages (- 1 (lui:value pages))))))
     (when icons-only (lui:select-page pages 1)) (browse)) root))
(defun file-browser-test (root)
 (set-entry (control root :path) (namestring (asdf:system-relative-pathname "lui" "examples/gtk/")))
 (press root :browse) (assert (plusp (length (state root :entries))))
 (assert (every #'probe-file (state root :entries)))
 (press root :up) (assert (equal (asdf:system-relative-pathname "lui" "examples/") (state root :directory))))
(defdemo "iconview" "File/directory icons with navigation and file activation." (file-browser "Icon view" t) (file-browser-test root))
(defdemo "listview_filebrowser" "File browser with list/icon presentations sharing one directory model."
 (file-browser "File browser" nil) (file-browser-test root)
 (press root :presentation) (assert (= 1 (lui:value (control root :views)))))
(defdemo "listview_selections" "Dropdown, editable completion and multi-selection list models."
 (let* ((drop (node 'lui:dropdown :dropdown :items '("One" "Two" "Three") :value 0))
        (combo (node 'lui:combo-box :completion :items '("One" "Two" "Three")))
        (view (model-view :selection 20 (lambda (i) (format nil "Choice ~d" i)) :selection-mode :multiple))
        (root (app "Selection models" drop combo view (labeled :status "Choose values"))))
   (changed drop (lambda (w i) (declare (ignore w)) (set-entry combo (nth i (lui:items drop)))) root)
   (changed view (lambda (w i) (declare (ignore i)) (status root (format nil "~d selected" (length (selected-indices w))))) root) root)
 (choose-index root :dropdown 2) (assert (string= "Three" (lui:text (control root :completion))))
 (model-select (control root :selection) 1) (model-select (control root :selection) 3 t)
 (assert (equal '(3 1) (selected-indices (control root :selection)))))
(defparameter *settings-data*
 '(("Appearance" "theme" "Light") ("Appearance" "font-size" "18") ("Editor" "tab-width" "4")
   ("Editor" "line-numbers" "true") ("Network" "proxy" "") ("Network" "timeout" "30")))
(defun settings-viewer (sectioned)
 (let* ((query (node 'lui:entry :query))
        (tree (node 'lui:tree-view :sections :height 100 :nodes
                    '((:text "Appearance") (:text "Editor") (:text "Network"))))
        (table (node 'lui:column-view :settings :height 220 :columns '("Section" "Key" "Value")))
        (value (node 'lui:entry :value)) (root (app "Settings viewer" query tree table value)))
   (setf (state root :data) (copy-tree *settings-data*) (state root :sectioned) sectioned)
   (labels ((refresh ()
              (setf (lui:rows table) (remove-if-not (lambda (row)
                (and (or sectioned (null (state root :section)) (string= (state root :section) (first row)))
                     (search (lui:text query) (format nil "~{~a~^ ~}" row) :test #'char-equal))) (state root :data)))))
     (changed query (lambda (w v) (declare (ignore w v)) (refresh)) root)
     (changed tree (lambda (w i) (setf (state root :section) (getf (first (nth i (lui:tree-rows w))) :text)) (refresh)) root)
     (changed table (lambda (w i) (set-entry value (third (nth i (lui:rows w))))) root)
     (add-action root :apply "Apply setting" (lambda ()
       (when (lui:value table) (setf (third (nth (lui:value table) (lui:rows table))) (lui:text value)) (refresh))))
     (refresh)) root))
(defun settings-test (root)
 (edit root :query "tab-width") (assert (= 1 (length (lui:rows (control root :settings)))))
 (choose-index root :settings 0) (edit root :value "8") (press root :apply)
 (assert (string= "8" (third (first (lui:rows (control root :settings)))))))
(defdemo "listview_settings" "Settings hierarchy with editable, sortable and filterable columns."
 (settings-viewer nil) (settings-test root))
(defdemo "listview_settings2" "Flattened, section-preserving settings search and value editing."
 (settings-viewer t) (settings-test root) (edit root :query "")
 (assert (= 6 (length (lui:rows (control root :settings))))))
(defdemo "listview_ucd" "Virtual Unicode-character database with codepoint/name/block columns and navigation."
 (let* ((view (model-view :characters 33796 (lambda (i)
                (let* ((code (+ 32 i)) (char (code-char code)))
                  (format nil "U+~4,'0X | ~a | ~a" code (or char #\?) (or (and char (char-name char)) "Unnamed"))))))
        (query (node 'lui:entry :code :text "03BB"))
        (root (app "Unicode characters" query view (labeled :status "Choose a character"))))
   (add-action root :jump "Jump to hexadecimal codepoint" (lambda ()
     (let ((code (parse-integer (lui:text query) :radix 16)))
       (unless (<= 32 code (+ 31 (model-count view))) (error "Codepoint outside this dataset"))
       (model-select view (- code 32)) (setf (lui:scroll-offset view) (* (- code 32) (lui:row-height view))))))
   (changed view (lambda (w i) (status root (item-text (model-item w i)))) root) root)
 (press root :jump) (assert (= (- #x3bb 32) (lui:value (control root :characters))))
 (assert (search "03BB" (lui:text (control root :status))))
 (assert (< (length (visible-rows (control root :characters))) 30)))
(defparameter *portable-words* '("alpha" "alphabet" "application" "apple" "apricot" "array" "banana" "binary" "buffer"
 "callback" "canvas" "character" "class" "closure" "color" "common" "compiler" "control" "data" "demo" "dialog" "document"
 "editable" "editor" "filter" "function" "garbage" "grid" "image" "keyboard" "lambda" "layout" "library" "lisp" "list"
 "macro" "memory" "model" "mouse" "notebook" "object" "package" "paint" "parent" "portable" "property" "render" "scroll"
 "selection" "snapshot" "source" "stack" "string" "style" "table" "text" "theme" "tree" "unicode" "value" "view" "widget" "window"))
(defdemo "listview_words" "Searchable dictionary with portable built-in data and optional dictionary-file loading."
 (let* ((query (node 'lui:entry :query)) (path (node 'lui:entry :dictionary))
        (view (model-view :words 0 (lambda (i) (declare (ignore i)) "")))
        (root (app "Words" query path view (labeled :status "Portable dictionary"))))
   (setf (state root :words) (copy-list *portable-words*))
   (labels ((refresh ()
              (setf (state root :filtered) (remove-if-not (lambda (s) (search (lui:text query) s :test #'char-equal)) (state root :words))
                    (model-count view) (length (state root :filtered))
                    (item-function view) (lambda (i) (nth i (state root :filtered))))
              (status root (format nil "~d words" (model-count view)))))
     (changed query (lambda (w v) (declare (ignore w v)) (refresh)) root)
     (add-action root :load "Load dictionary file" (lambda ()
       (setf (state root :words) (list-of-strings (uiop:read-file-string (lui:text path)))) (refresh))) (refresh)) root)
 (edit root :query "app") (assert (= 2 (model-count (control root :words))))
 (uiop:with-temporary-file (:pathname path)
   (with-open-file (s path :direction :output :if-exists :supersede) (format s "apple~%apply~%zebra~%"))
   (set-entry (control root :dictionary) (namestring path)) (press root :load)
   (assert (= 2 (model-count (control root :words))))))
(defdemo "listview_weather" "Virtual hourly weather dataset with city selection and horizontal non-selectable forecast cards."
 (let* ((city (node 'lui:dropdown :city :items '("London" "Paris" "Tokyo" "New York") :value 0))
        (view (model-view :forecast 70000 (lambda (i)
           (format nil "Hour ~d~%~d C~%~a" (mod i 24) (round (+ 15 (* 8 (sin (/ i 5)))))
                   (nth (mod i 4) '("Clear" "Cloudy" "Rain" "Wind")))) :selection-mode :none :orientation :horizontal))
        (root (app "Sample weather forecast" city view (labeled :status "London"))))
   (changed city (lambda (w i) (status root (nth i (lui:items w)))) root) root)
 (choose-index root :city 2) (assert (string= "Tokyo" (lui:text (control root :status))))
 (model-select (control root :forecast) 4) (assert (null (lui:value (control root :forecast))))
 (assert (= 70000 (model-count (control root :forecast)))))
(defdemo "listview_clocks" "Live world-time clocks with offset selection and shared time updates."
 (let* ((offset (node 'lui:dropdown :offset :items '("UTC" "New York -5" "Paris +1" "Tokyo +9") :value 0))
        (view (model-view :clocks 4 (lambda (i) (declare (ignore i)) "")))
        (root (app "World clocks" offset view (labeled :status "UTC"))))
   (setf (state root :now) (get-universal-time))
   (setf (item-function view) (lambda (i)
     (multiple-value-bind (s m h) (decode-universal-time (floor (state root :now)) (nth i '(0 5 -1 -9)))
       (format nil "~a  ~2,'0d:~2,'0d:~2,'0d" (nth i '("UTC" "New York" "Paris" "Tokyo")) h m s))))
   (lui:on root :tick (lambda (w dt) (declare (ignore w)) (incf (state root :now) dt)) :owner view)
   (changed offset (lambda (w i) (status root (nth i (lui:items w)))) root) root)
 (let ((before (model-item (control root :clocks) 0))) (tick root 1)
   (assert (not (string= before (model-item (control root :clocks) 0)))))
 (choose-index root :offset 3) (assert (search "Tokyo" (lui:text (control root :status)))))
(defdemo "listview_applauncher" "Selectable application model launches ordinary LUI application builders in native windows."
 (let* ((view (model-view :applications 3 (lambda (i) (nth i '("Editor" "Clock" "Tasks")))))
        (root (app "Application launcher" view (labeled :status "Select an application"))))
   (setf (state root :launch) (lambda (index)
     (asdf:load-system "lui/examples")
     (lui:start (uiop:symbol-call :lui-examples (nth index '(:editor :clock :todo))))))
   (add-action root :launch "Launch" (lambda ()
     (when (lui:value view) (funcall (state root :launch) (lui:value view))
       (status root (item-text (model-item view (lui:value view))))))) root)
 (setf (state root :launch) (lambda (i) (setf (state root :launched) i)))
 (model-select (control root :applications) 2) (press root :launch)
 (assert (= 2 (state root :launched))) (assert (string= "Tasks" (lui:text (control root :status)))))
(defmethod lui:render :before ((w virtual-list))
 (declare (ignore w))
 (unless (find-package :lui-gtk-demo-native) (asdf:load-system "lui/gtk-demo-native")))
