(in-package #:lut-examples)
(export 'cell-grid-demo)
(defun cell-grid-demo ()
 "Simulated terminal-style grid, without an emulator or PTY. F12 releases capture."
 (let* ((root (lut:make-widget 'lut:window :text "Cell grid primitives" :width 700 :height 420))
        (status (lut:add-child root (lut:make-widget 'lut:label :text "Capture: F12 releases; drag selects, Alt-drag selects a rectangle.")))
        (grid (lut:add-child root (lut:make-widget 'lut:cell-grid :height 280
                                   :style '(:font-size 16 :surface (20 23 30 255) :foreground (220 230 240 255)))))
        (column 0) (row 2))
   (lut:on grid :grid-resize (lambda (widget size)
     (declare (ignore size))
     (let ((banner "Simulated grid: type here; no shell is running."))
       (when (plusp (lut:grid-rows widget))
         (loop for c below (min (length banner) (lut:grid-columns widget))
               do (lut:set-grid-cell widget c 0 (char banner c) :bold t :underline t))))
     (setf column 0 row (min 2 (max 0 (1- (lut:grid-rows widget)))))))
   (lut:on grid :raw-key (lambda (widget event)
     (declare (ignore widget)) (setf (lut:text status) (format nil "Captured ~s; F12 releases." (lut:event-key event)))))
   (lut:on grid :raw-text (lambda (widget event)
     (when (and (plusp (lut:grid-columns widget)) (plusp (lut:grid-rows widget)))
       (loop for character across (lut:event-text event) do
         (when (and (>= (char-code character) 32) (not (<= 127 (char-code character) 159)))
           (lut:set-grid-cell widget column row character)
           (incf column)
           (when (= column (lut:grid-columns widget))
             (setf column 0 row (mod (1+ row) (lut:grid-rows widget)))))))))
   (lut:add-child root (action "Capture keys" (lambda () (lut:focus root grid) (lut:capture-keys grid))))
   (lut:add-child root (action "Copy selection" (lambda () (lut:copy-grid-selection grid))))
   root))
