(in-package #:lut-examples)
(export 'application-adapters)
(defun application-adapters ()
 "Explicit launch actions and native maximize/restore; persistence belongs to the application."
 (let* ((root (lut:make-widget 'lut:window :text "Application adapters" :width 620 :height 360))
        (uri (lut:add-child root (lut:make-widget 'lut:entry :text "https://example.com")))
        (status (lut:add-child root (lut:make-widget 'lut:label :text "Choose an action." :height 60))))
   (flet ((action-button (title function)
            (lut:add-child root (action title (lambda ()
              (handler-case (funcall function)
                (error (condition) (setf (lut:text status) (princ-to-string condition)))))))))
     (action-button "Open URI in default application" (lambda ()
       (multiple-value-bind (submitted backend) (lut:launch-uri (lut:text uri))
         (setf (lut:text status) (format nil "Submitted: ~s via ~a" submitted backend)))))
     (action-button "Maximize" (lambda () (lut:set-window-state root :maximized)))
     (action-button "Restore" (lambda () (lut:set-window-state root :normal)))
     (action-button "Show normal size" (lambda ()
       (multiple-value-bind (width height) (lut:normal-window-size root)
         (setf (lut:text status) (format nil "State: ~a; normal size: ~,1f by ~,1f" (lut:window-state root) width height)))))) root))
