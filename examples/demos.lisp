(defpackage #:lut-examples (:use #:cl) (:export #:hello-world #:todo #:editor #:drawing #:clock #:adwaita #:gallery #:drag-tabs))
(in-package #:lut-examples)
(defun action (title function)
 (let ((b (lut:make-widget 'lut:button :text title)))
   (lut:on b :activate (lambda (w e) (declare (ignore w e)) (funcall function))) b))
(defun hello-world ()
 (let* ((w (lut:make-widget 'lut:window :text "Hello World" :width 640 :height 300))
        (label (lut:make-widget 'lut:label :text "Welcome to LUT")))
   (lut:add-child w label)
   (lut:add-child w (action "Hello" (lambda () (setf (lut:text label) "Hello from Common Lisp!")))) w))
(defun todo ()
 (let* ((w (lut:make-widget 'lut:window :text "Tasks" :width 640 :height 640))
        (input (lut:make-widget 'lut:entry))
        (tasks (lut:make-widget 'lut:scroll-view :height 450)))
   (lut:add-child w input)
   (lut:add-child w (action "Add task" (lambda ()
     (unless (zerop (length (lut:text input)))
       (lut:add-child tasks (lut:make-widget 'lut:check-button :text (lut:text input)))
       (lut:select-all input) (lut:replace-selection input "")))))
   (lut:add-child w tasks) w))
(defun editor ()
 (let* ((w (lut:make-widget 'lut:window :text "Editor" :width 800 :height 660))
        (path (lut:make-widget 'lut:entry :text (namestring (merge-pathnames "notes.txt" (user-homedir-pathname)))))
        (field (lut:make-widget 'lut:text-view :height 440))
        (status (lut:make-widget 'lut:label :text "Enter a path; Open or Save.")))
   (labels ((report-action (fn)
              (handler-case (progn (funcall fn) (setf (lut:text status) "Done"))
                (error (e) (setf (lut:text status) (princ-to-string e))))))
     (lut:add-child w path)
     (lut:add-child w (action "Open" (lambda () (report-action
       (lambda () (let ((content (uiop:read-file-string (lut:text path))))
                    (lut:select-all field) (lut:replace-selection field content)))))))
     (lut:add-child w (action "Save" (lambda () (report-action
       (lambda () (with-open-file (out (lut:text path) :direction :output :if-exists :supersede)
                    (write-string (lut:text field) out)))))))
     (lut:add-child w field) (lut:add-child w status)) w))
(defun drawing ()
 (lut:with-ui (lut:window :text "Drawing" :width 640 :height 480)
   (lut:make-widget 'lut:drawing-area :height 420
     :draw-function (lambda (area)
       (rl:draw-circle (+ (lut:x area) 130) (+ (lut:y area) 130) 80 :skyblue)
       (rl:draw-rectangle (+ (lut:x area) 250) (+ (lut:y area) 60) 160 160 :orange)))))
(defun clock ()
 (let ((w (lut:make-widget 'lut:window :text "Clock" :width 640 :height 240))
       (face (lut:make-widget 'lut:label)))
   (lut:add-child w face)
   (lut:on w :tick (lambda (w dt) (declare (ignore w dt))
     (multiple-value-bind (sec min hour) (decode-universal-time (get-universal-time))
       (setf (lut:text face) (format nil "~2,'0d:~2,'0d:~2,'0d" hour min sec))))) w))
(defun adwaita ()
 (let ((w (hello-world)))
   (setf (lut:text w) "Theme inheritance")
   (lut:add-child w (action "Toggle light/dark" (lambda ()
     (setf (lut:theme w) (if (eq (lut:theme w) lut:*dark-theme*) lut:*light-theme* lut:*dark-theme*))))) w))
(defun gallery ()
 (let ((w (adwaita)))
   (setf (lut:height w) 720)
   (lut:add-child w (lut:make-widget 'lut:entry :text "Select and edit this text"))
   (lut:add-child w (lut:make-widget 'lut:slider :value 40))
   (lut:add-child w (lut:make-widget 'lut:list-view :height 180 :items (loop for i below 50 collect (format nil "Row ~d" i))))
   (lut:add-child w (action "Dialog" (lambda ()
     (let ((d (lut:make-widget 'lut:dialog :width 320 :height 180)))
       (lut:add-child d (lut:make-widget 'lut:label :text "Modal dialog"))
       (lut:add-child d (action "Close" (lambda () (lut:dismiss-dialog d))))
       (lut:show-dialog w d))))) w))

(defun drag-tabs ()
 "Two grouped notebooks demonstrate reusable in-window tab reordering and transfer."
 (let* ((root (lut:make-widget 'lut:window :text "Drag notebook tabs" :width 800 :height 430))
        (panes (lut:make-widget 'lut:paned :height 280))
        (left (lut:make-widget 'lut:notebook :id :left-tabs :reorderable-p t :tab-group :sample
                              :items '("One" "Two")))
        (right (lut:make-widget 'lut:notebook :id :right-tabs :reorderable-p t :tab-group :sample
                               :items '("Three")))
        (status (lut:make-widget 'lut:label :text "Escape cancels a drag.")))
   (lut:add-child root (lut:make-widget 'lut:label :text "Drag a tab within a strip or into the other strip."))
   (lut:add-child root panes)
   (lut:add-child panes left) (lut:add-child panes right)
   (dolist (caption '("First page" "Second page"))
     (lut:add-child left (lut:make-widget 'lut:entry :text caption)))
   (lut:add-child right (lut:make-widget 'lut:entry :text "Third page"))
   (lut:add-child root status)
   (dolist (book (list left right))
     (lut:on book :pages-changed (lambda (w change)
       (declare (ignore w change))
       (setf (lut:text status) (format nil "Left: ~d pages; right: ~d pages."
                               (length (lut:children left)) (length (lut:children right))))))) root))
