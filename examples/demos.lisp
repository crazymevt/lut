(defpackage #:lui-examples (:use #:cl) (:export #:hello-world #:todo #:editor #:drawing #:clock #:adwaita #:gallery))
(in-package #:lui-examples)
(defun action (title function)
 (let ((b (lui:make-widget 'lui:button :text title)))
   (lui:on b :activate (lambda (w e) (declare (ignore w e)) (funcall function))) b))
(defun hello-world ()
 (let* ((w (lui:make-widget 'lui:window :text "Hello World" :width 640 :height 300))
        (label (lui:make-widget 'lui:label :text "Welcome to LUI")))
   (lui:add-child w label)
   (lui:add-child w (action "Hello" (lambda () (setf (lui:text label) "Hello from Common Lisp!")))) w))
(defun todo ()
 (let* ((w (lui:make-widget 'lui:window :text "Tasks" :width 640 :height 640))
        (input (lui:make-widget 'lui:entry))
        (tasks (lui:make-widget 'lui:scroll-view :height 450)))
   (lui:add-child w input)
   (lui:add-child w (action "Add task" (lambda ()
     (unless (zerop (length (lui:text input)))
       (lui:add-child tasks (lui:make-widget 'lui:check-button :text (lui:text input)))
       (lui:select-all input) (lui:replace-selection input "")))))
   (lui:add-child w tasks) w))
(defun editor ()
 (let* ((w (lui:make-widget 'lui:window :text "Editor" :width 800 :height 660))
        (path (lui:make-widget 'lui:entry :text (namestring (merge-pathnames "notes.txt" (user-homedir-pathname)))))
        (field (lui:make-widget 'lui:text-view :height 440))
        (status (lui:make-widget 'lui:label :text "Enter a path; Open or Save.")))
   (labels ((report-action (fn)
              (handler-case (progn (funcall fn) (setf (lui:text status) "Done"))
                (error (e) (setf (lui:text status) (princ-to-string e))))))
     (lui:add-child w path)
     (lui:add-child w (action "Open" (lambda () (report-action
       (lambda () (let ((content (uiop:read-file-string (lui:text path))))
                    (lui:select-all field) (lui:replace-selection field content)))))))
     (lui:add-child w (action "Save" (lambda () (report-action
       (lambda () (with-open-file (out (lui:text path) :direction :output :if-exists :supersede)
                    (write-string (lui:text field) out)))))))
     (lui:add-child w field) (lui:add-child w status)) w))
(defun drawing ()
 (lui:with-ui (lui:window :text "Drawing" :width 640 :height 480)
   (lui:make-widget 'lui:drawing-area :height 420
     :draw-function (lambda (area)
       (rl:draw-circle (+ (lui:x area) 130) (+ (lui:y area) 130) 80 :skyblue)
       (rl:draw-rectangle (+ (lui:x area) 250) (+ (lui:y area) 60) 160 160 :orange)))))
(defun clock ()
 (let ((w (lui:make-widget 'lui:window :text "Clock" :width 640 :height 240))
       (face (lui:make-widget 'lui:label)))
   (lui:add-child w face)
   (lui:on w :tick (lambda (w dt) (declare (ignore w dt))
     (multiple-value-bind (sec min hour) (decode-universal-time (get-universal-time))
       (setf (lui:text face) (format nil "~2,'0d:~2,'0d:~2,'0d" hour min sec))))) w))
(defun adwaita ()
 (let ((w (hello-world)))
   (setf (lui:text w) "Theme inheritance")
   (lui:add-child w (action "Toggle light/dark" (lambda ()
     (setf (lui:theme w) (if (eq (lui:theme w) lui:*dark-theme*) lui:*light-theme* lui:*dark-theme*))))) w))
(defun gallery ()
 (let ((w (adwaita)))
   (setf (lui:height w) 720)
   (lui:add-child w (lui:make-widget 'lui:entry :text "Select and edit this text"))
   (lui:add-child w (lui:make-widget 'lui:slider :value 40))
   (lui:add-child w (lui:make-widget 'lui:list-view :height 180 :items (loop for i below 50 collect (format nil "Row ~d" i))))
   (lui:add-child w (action "Dialog" (lambda ()
     (let ((d (lui:make-widget 'lui:dialog :width 320 :height 180)))
       (lui:add-child d (lui:make-widget 'lui:label :text "Modal dialog"))
       (lui:add-child d (action "Close" (lambda () (lui:dismiss-dialog d))))
       (lui:show-dialog w d))))) w))
