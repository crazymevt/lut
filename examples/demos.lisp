(defpackage #:lut-examples (:use #:cl) (:export #:hello-world #:todo #:editor #:drawing #:clock #:adwaita #:gallery #:drag-tabs #:overflow-tabs #:command-actions #:shared-text #:indexed-text #:standalone-history #:text-selection))
(in-package #:lut-examples)
(defun action (title function)
 (let ((b (lut:make-widget 'lut:button :text title)))
   (lut:on b :activate (lambda (w e) (declare (ignore w e)) (funcall function))) b))
(defun hello-world ()
 (let* ((w (lut:make-widget 'lut:window :text "Hello World" :width 640 :height 300))
        (label (lut:make-widget 'lut:label :text "Welcome to LUT")))
   (lut:add-child w label)
   (lut:add-child w (action "Hello" (lambda () (setf (lut:text label) "Hello from Common Lisp!")))) w))
(defun todo ()
 (let* ((w (lut:make-widget 'lut:window :text "Tasks" :width 640 :height 640))
        (input (lut:make-widget 'lut:entry))
        (tasks (lut:make-widget 'lut:scroll-view :height 450)))
   (lut:add-child w input)
   (lut:add-child w (action "Add task" (lambda ()
     (unless (zerop (length (lut:text input)))
       (lut:add-child tasks (lut:make-widget 'lut:check-button :text (lut:text input)))
       (lut:select-all input) (lut:replace-selection input "")))))
   (lut:add-child w tasks) w))
(defun editor ()
 (let* ((w (lut:make-widget 'lut:window :text "Editor" :width 800 :height 660))
        (path (lut:make-widget 'lut:entry :text (namestring (merge-pathnames "notes.txt" (user-homedir-pathname)))))
        (field (lut:make-widget 'lut:text-view :height 440))
        (status (lut:make-widget 'lut:label :text "Enter a path; Open or Save.")))
   (labels ((report-action (fn)
              (handler-case (progn (funcall fn) (setf (lut:text status) "Done"))
                (error (e) (setf (lut:text status) (princ-to-string e))))))
     (lut:add-child w path)
     (lut:add-child w (action "Open" (lambda () (report-action
       (lambda () (let ((content (uiop:read-file-string (lut:text path))))
                    (lut:select-all field) (lut:replace-selection field content)))))))
     (lut:add-child w (action "Save" (lambda () (report-action
       (lambda () (with-open-file (out (lut:text path) :direction :output :if-exists :supersede)
                    (write-string (lut:text field) out)))))))
     (lut:add-child w field) (lut:add-child w status)) w))
(defun drawing ()
 (lut:with-ui (lut:window :text "Drawing" :width 640 :height 480)
   (lut:make-widget 'lut:drawing-area :height 420
     :draw-function (lambda (area)
       (rl:draw-circle (+ (lut:x area) 130) (+ (lut:y area) 130) 80 :skyblue)
       (rl:draw-rectangle (+ (lut:x area) 250) (+ (lut:y area) 60) 160 160 :orange)))))
(defun clock ()
 (let ((w (lut:make-widget 'lut:window :text "Clock" :width 640 :height 240))
       (face (lut:make-widget 'lut:label)))
   (lut:add-child w face)
   (lut:on w :tick (lambda (w dt) (declare (ignore w dt))
     (multiple-value-bind (sec min hour) (decode-universal-time (get-universal-time))
       (setf (lut:text face) (format nil "~2,'0d:~2,'0d:~2,'0d" hour min sec))))) w))
(defun adwaita ()
 (let ((w (hello-world)))
   (setf (lut:text w) "Theme inheritance")
   (lut:add-child w (action "Toggle light/dark" (lambda ()
     (setf (lut:theme w) (if (eq (lut:theme w) lut:*dark-theme*) lut:*light-theme* lut:*dark-theme*))))) w))
(defun gallery ()
 (let ((w (adwaita)))
   (setf (lut:height w) 720)
   (lut:add-child w (lut:make-widget 'lut:entry :text "Select and edit this text"))
   (lut:add-child w (lut:make-widget 'lut:slider :value 40))
   (lut:add-child w (lut:make-widget 'lut:list-view :height 180 :items (loop for i below 50 collect (format nil "Row ~d" i))))
   (lut:add-child w (action "Dialog" (lambda ()
     (let ((d (lut:make-widget 'lut:dialog :width 320 :height 180)))
       (lut:add-child d (lut:make-widget 'lut:label :text "Modal dialog"))
       (lut:add-child d (action "Close" (lambda () (lut:dismiss-dialog d))))
       (lut:show-dialog w d))))) w))

(defun drag-tabs ()
 "Two grouped notebooks demonstrate reusable in-window tab reordering and transfer."
 (let* ((root (lut:make-widget 'lut:window :text "Drag notebook tabs" :width 800 :height 430))
        (panes (lut:make-widget 'lut:paned :height 280))
        (left (lut:make-widget 'lut:notebook :id :left-tabs :reorderable-p t :tab-group :sample
                              :items '("One" "Two")))
        (right (lut:make-widget 'lut:notebook :id :right-tabs :reorderable-p t :tab-group :sample
                               :items '("Three")))
        (status (lut:make-widget 'lut:label :text "Escape cancels a drag.")))
   (lut:add-child root (lut:make-widget 'lut:label :text "Drag a tab within a strip or into the other strip."))
   (lut:add-child root panes)
   (lut:add-child panes left) (lut:add-child panes right)
   (dolist (caption '("First page" "Second page"))
     (lut:add-child left (lut:make-widget 'lut:entry :text caption)))
   (lut:add-child right (lut:make-widget 'lut:entry :text "Third page"))
   (lut:add-child root status)
   (dolist (book (list left right))
     (lut:on book :pages-changed (lambda (w change)
       (declare (ignore w change))
       (setf (lut:text status) (format nil "Left: ~d pages; right: ~d pages."
                               (length (lut:children left)) (length (lut:children right))))))) root))

(defun overflow-tabs ()
 "Many pages demonstrate overflow navigation together with grouped tab dragging."
 (let* ((root (drag-tabs)) (left (lut:find-widget root :left-tabs)))
   (setf (lut:text root) "Notebook overflow")
   (dotimes (i 12)
     (lut:add-child left (lut:make-widget 'lut:entry :text (format nil "Extra page ~d" (1+ i)))))
   (setf (lut:items left) (append (lut:items left)
                            (loop for i below 12 collect (format nil "Extra ~d" (1+ i))))) root))

(defun command-actions ()
 "One context-sensitive action shared by a toolbar button, menu button and F6."
 (let* ((root (lut:make-widget 'lut:window :text "Shared commands" :width 600 :height 320))
        (model (list :count 0 :allowed t))
        (toggle (lut:add-child root (lut:make-widget 'lut:check-button :id :allow-command
                                                   :text "Enable the shared action" :value t)))
        (toolbar (lut:add-child root (lut:make-widget 'lut:button :id :command-button)))
        (menu (lut:add-child root (lut:make-widget 'lut:menu-bar :height 52)))
        (menu-item (lut:add-child menu (lut:make-widget 'lut:button :id :command-menu :width 220)))
        (status (lut:add-child root (lut:make-widget 'lut:label :id :command-status :text "Count: 0. Click either action or press F6.")))
        (command (lut:make-command :increment "Increment (F6)"
                   (lambda (command context)
                     (declare (ignore command))
                     (setf (lut:text status) (format nil "Count: ~d" (incf (getf context :count)))))
                   :enabled-when (lambda (command context) (declare (ignore command)) (getf context :allowed))
                   :shortcut :f6)))
   (lut:bind-command root command :widget toolbar :context model)
   (lut:bind-command root command :widget menu-item :context model :shortcut-p nil)
   (lut:on toggle :change (lambda (w value)
     (declare (ignore w)) (setf (getf model :allowed) value) (lut:refresh-commands root))) root))

(defun shared-text ()
 "Two independent views share text and history; read-only is a per-view policy."
 (let* ((root (lut:make-widget 'lut:window :text "Shared text buffer" :width 800 :height 500))
        (buffer (lut:make-text-buffer :text (format nil "Shared buffer~%Edit either view; cursor and scrolling are independent.")))
        (panes (lut:make-widget 'lut:paned :height 300))
        (a (lut:make-widget 'lut:text-view :id :first-view :view-buffer buffer))
        (b (lut:make-widget 'lut:text-view :id :second-view :view-buffer buffer))
        (tools (lut:make-widget 'lut:header-bar :height 52))
        (undo (lut:make-widget 'lut:button :id :buffer-undo :width 100))
        (redo (lut:make-widget 'lut:button :id :buffer-redo :width 100))
        (read-only (lut:make-widget 'lut:check-button :id :peer-read-only :text "Right view read-only" :width 250))
        (status (lut:make-widget 'lut:label :text "Revision: 0")))
   (lut:add-child root (lut:make-widget 'lut:label :text "Two views, one buffer and undo history."))
   (lut:add-child root panes) (lut:add-child panes a) (lut:add-child panes b)
   (lut:add-child root tools) (lut:add-child tools undo) (lut:add-child tools redo) (lut:add-child tools read-only)
   (lut:add-child root status)
   (lut:bind-command root
     (lut:make-command :undo "Undo" (lambda (command view) (declare (ignore command)) (lut:undo view))
                       :enabled-when (lambda (command view) (declare (ignore command)) (lut:can-undo-p view)))
     :widget undo :context a :shortcut-p nil)
   (lut:bind-command root
     (lut:make-command :redo "Redo" (lambda (command view) (declare (ignore command)) (lut:redo view))
                       :enabled-when (lambda (command view) (declare (ignore command)) (lut:can-redo-p view)))
     :widget redo :context a :shortcut-p nil)
   (lut:on read-only :change (lambda (w value) (declare (ignore w)) (setf (lut:read-only-p b) value)))
   (lut:on buffer :edit (lambda (w edit) (declare (ignore w))
     (setf (lut:text status) (format nil "Revision: ~d" (lut:edit-revision edit)))) :owner root) root))

(defun indexed-text ()
 "Large shared buffer with indexed EOF navigation and range edits."
 (let* ((root (lut:make-widget 'lut:window :text "Indexed text viewport" :width 850 :height 540))
        (buffer (lut:make-text-buffer :text (with-output-to-string (out)
                   (dotimes (i 50000) (format out "Line ~d: αβγ — shared indexed text.~%" i)))))
        (view (lut:make-widget 'lut:text-view :id :indexed-view :view-buffer buffer :height 380))
        (tools (lut:make-widget 'lut:header-bar :height 44))
        (last (lut:make-widget 'lut:button :id :indexed-end :text "Go to EOF" :width 140))
        (append (lut:make-widget 'lut:button :id :indexed-append :text "Append line" :width 150))
        (status (lut:make-widget 'lut:label)))
   (labels ((refresh ()
              (setf (lut:text status) (format nil "~d characters, ~d lines, revision ~d"
                       (lut:text-length buffer) (lut:text-line-count buffer) (lut:buffer-revision buffer))))
            (reveal-end ()
              (setf (lut:cursor view) (lut:text-length buffer)
                    (slot-value view 'lut::anchor) (lut:cursor view))
              (lut:focus root view)))
     (lut:add-child root (lut:make-widget 'lut:label :text "50,000 lines; scroll or edit without flattening the model."))
     (lut:add-child root view) (lut:add-child root tools)
     (lut:add-child tools last) (lut:add-child tools append) (lut:add-child root status)
     (lut:on last :activate (lambda (w p) (declare (ignore w p)) (reveal-end)))
     (lut:on append :activate (lambda (w p) (declare (ignore w p))
       (let ((end (lut:text-length buffer)))
         (lut:replace-buffer-range buffer end end (format nil "Added at EOF~%"))) (reveal-end)))
     (lut:on buffer :edit (lambda (w edit) (declare (ignore w edit)) (refresh)) :owner root)
     (refresh)) root))

(defun standalone-history ()
 "Standalone range undo/redo with application-owned feedback for oversized edits."
 (let* ((root (lut:make-widget 'lut:window :text "Standalone range history" :width 800 :height 360))
        (view (lut:make-widget 'lut:text-view :id :history-view :text "Small edits retain undo in a large document."
                               :history-character-limit 8 :height 160))
        (tools (lut:make-widget 'lut:header-bar :height 44))
        (small (lut:make-widget 'lut:button :id :history-small :text "Insert x" :width 110))
        (large (lut:make-widget 'lut:button :id :history-large :text "Insert over budget" :width 200))
        (undo (lut:make-widget 'lut:button :id :history-undo :width 90))
        (redo (lut:make-widget 'lut:button :id :history-redo :width 90))
        (status (lut:make-widget 'lut:label :id :history-status)) (notice ""))
   (labels ((refresh ()
              (setf (lut:text status) (format nil "Undo: ~a. Redo: ~a. ~a"
                 (if (lut:can-undo-p view) "yes" "no") (if (lut:can-redo-p view) "yes" "no") notice)))
            (insert (string) (setf notice "") (lut:replace-selection view string) (lut:focus root view)))
     (lut:add-child root (lut:make-widget 'lut:label :text "Standalone history budget: 8 removed + inserted characters per stack."))
     (lut:add-child root view) (lut:add-child root tools)
     (dolist (button (list small large undo redo)) (lut:add-child tools button))
     (lut:add-child root status)
     (lut:on small :activate (lambda (w p) (declare (ignore w p)) (insert "x")))
     (lut:on large :activate (lambda (w p) (declare (ignore w p)) (insert "(over budget)")))
     (lut:bind-command root (lut:make-command :undo "Undo" (lambda (c v) (declare (ignore c)) (lut:undo v))
                              :enabled-when (lambda (c v) (declare (ignore c)) (lut:can-undo-p v)))
                       :widget undo :context view :shortcut-p nil)
     (lut:bind-command root (lut:make-command :redo "Redo" (lambda (c v) (declare (ignore c)) (lut:redo v))
                              :enabled-when (lambda (c v) (declare (ignore c)) (lut:can-redo-p v)))
                       :widget redo :context view :shortcut-p nil)
     (lut:on view :history-overflow (lambda (w payload) (declare (ignore w))
       (setf notice (format nil "~d-character edit not retained (budget ~d)."
                         (getf payload :characters) (getf payload :limit))) (refresh)) :owner root)
     (lut:on view :change (lambda (w text) (declare (ignore w text)) (refresh)) :owner root)
     (refresh)) root))

(defun text-selection ()
 "Word/line navigation and selection with independent shared-buffer viewports."
 (let* ((root (lut:make-widget 'lut:window :text "Text selection and navigation" :width 940 :height 600))
        (buffer (lut:make-text-buffer :text (with-output-to-string (out)
                   (dotimes (i 200) (format out "Line ~d: αβγ_words, punctuation! Drag across this long line to scroll horizontally.~%" i)))))
        (panes (lut:make-widget 'lut:paned :height 350))
        (view (lut:make-widget 'lut:text-view :id :selection-view :view-buffer buffer))
        (peer (lut:make-widget 'lut:text-view :id :selection-peer :view-buffer buffer :read-only-p t))
        (tools (lut:make-widget 'lut:header-bar :height 44))
        (word (lut:make-widget 'lut:button :id :select-word :text "Select word" :width 140))
        (line (lut:make-widget 'lut:button :id :select-line :text "Select line" :width 140))
        (end (lut:make-widget 'lut:button :id :selection-end :text "Go to end" :width 140))
        (top (lut:make-widget 'lut:button :id :selection-top :text "Go to top" :width 140))
        (status (lut:make-widget 'lut:label :id :selection-status)) (last-state nil))
   (lut:add-child root (lut:make-widget 'lut:label :text "Ctrl/Alt+Left/Right: words. Shift extends. Home/End: logical line. Ctrl+Home/End: document." :style '(:font-size 16)))
   (lut:add-child root (lut:make-widget 'lut:label :text "Double click: word/run. Triple click: line. Hold a selection beyond a pane edge to scroll. Right pane is read-only." :style '(:font-size 16)))
   (lut:add-child root panes) (lut:add-child panes view) (lut:add-child panes peer)
   (lut:add-child root tools) (dolist (button (list word line end top)) (lut:add-child tools button))
   (lut:add-child root status)
   (lut:on word :activate (lambda (w p) (declare (ignore w p)) (lut:select-word view) (lut:focus root view)))
   (lut:on line :activate (lambda (w p) (declare (ignore w p)) (lut:select-line view) (lut:focus root view)))
   (lut:on end :activate (lambda (w p) (declare (ignore w p)) (lut:move-text-cursor view :document-end) (lut:focus root view)))
   (lut:on top :activate (lambda (w p) (declare (ignore w p)) (lut:move-text-cursor view :document-start) (lut:focus root view)))
   (lut:on root :tick (lambda (w dt) (declare (ignore w dt))
     (let ((state (append (multiple-value-list (lut:selection view)) (multiple-value-list (lut:selection peer)))))
       (unless (equal state last-state)
         (setf last-state state (lut:text status) (format nil "Left selection ~d..~d. Right selection ~d..~d." (first state) (second state) (third state) (fourth state)))))))
   root))
