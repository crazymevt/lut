(in-package #:lut)

(defun pointer-captured-p (widget)
  "True when WIDGET owns the active pointer gesture in its live input scope."
  (let ((root (root-of widget)))
    (and (typep root 'window) (eq widget (slot-value root 'pressed-widget))
         (live-input-widget-p widget root))))
(defun capture-pointer (widget)
  "Capture MOVE/UP for WIDGET until release, detachment, disposal or a modal change."
  (let ((root (root-of widget)))
    (unless (and (typep root 'window) (live-input-widget-p widget root))
      (error "Pointer capture requires a live widget in the current input scope."))
    (let ((old (slot-value root 'pressed-widget)))
      (when (and old (not (eq old widget))) (setf (pressed-p old) nil)))
    (cancel-drag root)
    (setf (slot-value root 'pressed-widget) widget (pressed-p widget) t)) widget)
(defun release-pointer (widget)
  "Release WIDGET's capture without disturbing another widget's gesture."
  (let ((root (root-of widget)))
    (when (and (typep root 'window) (eq widget (slot-value root 'pressed-widget)))
      (setf (slot-value root 'pressed-widget) nil (pressed-p widget) nil))) widget)
(defun text-selection-active-p (view)
  (let ((root (root-of view)))
    (and (typep root 'window) (eq view (first (slot-value root 'text-selection-state))))))
(defun suppress-cursor-reveal (view)
  "Keep the current viewport until the next cursor movement."
  (setf (last-cursor view) (cursor view)) view)
(defun handle-text-pointer-event (view event)
  "Apply standard selection/drag handling to an externally managed text view."
  (check-type view entry)
  (unless (member (event-kind event) '(:down :move :up)) (error "Expected a pointer selection event."))
  (let ((root (root-of view)))
    (unless (and (typep root 'window) (live-input-widget-p view root)) (error "Invalid text pointer target."))
    (dispatch-base root event)) t)
(defun row-at-position (view x y)
  "Return the row at root coordinates, or NIL outside the view's viewport/items."
  (when (contains-point-p view x y) (hover-row-at-point view x y)))

(defclass resize-handle (widget)
  ((axis :initarg :resize-axis :initform :horizontal :reader resize-axis)
   (origin :initform nil :accessor resize-origin)))
(defmethod initialize-instance :after ((handle resize-handle) &key)
  (unless (member (resize-axis handle) '(:horizontal :vertical)) (error "Invalid resize axis.")))
(defmethod pointer-cursor ((handle resize-handle) x y &key captured-p)
  (declare (ignore x y captured-p))
  (if (eq (resize-axis handle) :horizontal) :resize-ew :resize-ns))
(defmethod handle-event ((handle resize-handle) event)
  (case (event-kind event)
    (:down (capture-pointer handle)
           (setf (resize-origin handle) (list (event-x event) (event-y event)))
           (emit handle :resize-start event) t)
    (:move (when (and (pointer-captured-p handle) (resize-origin handle))
             (emit handle :resize
               (list :x (event-x event) :y (event-y event)
                     :dx (- (event-x event) (first (resize-origin handle)))
                     :dy (- (event-y event) (second (resize-origin handle)))))) t)
    (:up (let ((active (pointer-captured-p handle)))
           (release-pointer handle) (setf (resize-origin handle) nil)
           (when active (emit handle :resize-end event))) t)))

;; Application callbacks supply semantics and optional painting; the notebook
;; owns geometry, clipping, cancellation, tooltip and pointer/drag arbitration.
(defstruct notebook-action label function draw-function (width 26) (enabled-p t))
(defgeneric page-action (book page))
(defgeneric (setf page-action) (action book page))
(defmethod page-action ((book notebook) page)
  (when (member page (children book)) (slot-value page 'page-tab-action)))
(defmethod (setf page-action) (action (book notebook) page)
  (unless (member page (children book)) (error "Action page must belong to the notebook."))
  (unless (or (null action)
              (and (notebook-action-p action) (stringp (notebook-action-label action))
                   (functionp (notebook-action-function action))
                   (or (null (notebook-action-draw-function action)) (functionp (notebook-action-draw-function action)))
                   (typep (notebook-action-width action) '(real (0) *))))
    (error "Invalid notebook action."))
  (setf (slot-value page 'page-tab-action) action
        (tab-reveal-p book) t) action)
(defmethod tab-action-width ((book notebook) index)
  (let ((action (page-action book (nth index (children book)))))
    (if action (notebook-action-width action) 0)))
(defun tab-strip-rectangle (book)
  (multiple-value-bind (nominal left viewport) (tab-strip-geometry book)
    (declare (ignore nominal)) (list left (y book) viewport (style-value book :title-height))))
(defun tab-rectangle (book index)
  "Return a tab's un-clipped root rectangle; hit testing excludes strip arrows."
  (unless (and (typep index '(integer 0 *)) (< index (length (children book)))) (error "Invalid tab index."))
  (list (+ (first (tab-strip-rectangle book)) (tab-start book index) (- (tab-offset book)))
        (y book) (tab-width-at book index) (style-value book :title-height)))
(defun tab-action-rectangle (book index)
  (let ((extra (tab-action-width book index)))
    (when (plusp extra)
      (destructuring-bind (x y width height) (tab-rectangle book index)
        (let* ((close (if (closable-p book) (min width height) 0))
               (action-width (min extra (max 0 (- width close)))))
          (when (plusp action-width)
            (list (- (+ x width) close action-width) y action-width height)))))))
(defun notebook-action-at (book event)
  (let ((index (tab-at-position book (event-x event) (event-y event))))
    (when index
      (let ((box (tab-action-rectangle book index)))
        (when (and box (contains-rectangle-point-p box (event-x event) (event-y event)))
          (values (nth index (children book)) (page-action book (nth index (children book)))))))))
(defun contains-rectangle-point-p (box x y)
  (and (<= (first box) x) (< x (+ (first box) (third box)))
       (<= (second box) y) (< y (+ (second box) (fourth box)))))
(defmethod drag-data :around ((book notebook) event)
  (unless (notebook-action-at book event) (call-next-method)))
(defmethod handle-event :around ((book notebook) event)
  (multiple-value-bind (page action) (notebook-action-at book event)
    (case (event-kind event)
      (:move
       (when (or action (slot-value book 'action-tooltip-active))
         (unless (slot-value book 'action-tooltip-active)
           (setf (slot-value book 'action-tooltip-original) (tooltip-text book)))
         (setf (tooltip-text book) (if action (notebook-action-label action) (slot-value book 'action-tooltip-original))
               (slot-value book 'action-tooltip-active) (not (null action))))
       (if (and (slot-value book 'action-press) (pointer-captured-p book)) t (call-next-method)))
      (:down
       (setf (slot-value book 'action-press) nil)
       (if action
           (progn (capture-pointer book)
                  (when (notebook-action-enabled-p action) (setf (slot-value book 'action-press) (list page action))) t)
           (call-next-method)))
      (:up
       (let ((press (slot-value book 'action-press)) (captured (pointer-captured-p book)))
         (setf (slot-value book 'action-press) nil)
         (if press
             (progn
               (release-pointer book)
               (when (and captured (eq page (first press)) (eq action (second press)) (notebook-action-enabled-p action))
                 (funcall (notebook-action-function action) book page)) t)
             (if action t (call-next-method)))))
      (otherwise (call-next-method)))))
(defmethod dispose :before ((book notebook))
  (setf (slot-value book 'action-press) nil (slot-value book 'action-tooltip-original) nil))

(defmethod handle-event ((view list-view) event)
  (case (event-kind event)
    (:key (when (and (eq (event-key event) :enter) (value view) (< (value view) (length (items view))))
            (emit view :activate (value view)) t))
    (:up
     (let* ((root (root-of view))
            (row (when (and (pointer-captured-p view)
                            (eq view (input-hit-test root (event-x event) (event-y event))))
                   (row-at-position view (event-x event) (event-y event)))))
       (dispatch-base root event)
       (when row (emit view :activate row))) t)))

(defmethod dispose :after ((view entry))
  (setf (slot-value view 'horizontal-extent-cache) nil))
(defun text-caret-rectangle (view)
  "Caret paint geometry; selection and line metrics remain unchanged."
  (multiple-value-bind (x y width height) (text-position-rectangle view (cursor view))
    (values x y width (if (eq (style-value view :caret-height) :font)
                         (min height (style-value view :font-size)) height))))
