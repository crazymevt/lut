(in-package #:lut)
(defstruct (buffer-edit (:constructor %make-buffer-edit) (:conc-name edit-))
 "Committed character-range replacement. Notifications carry the current revision and optional originating view."
 start old-end new-end revision origin)
(defvar *record-buffer-history* t)
(defun make-text-buffer (&key (text "") read-only-p (history-limit 100) (history-character-limit 262144) history-retain-newest-p)
 "Make a nonvisual shared text/history model. Views retain independent cursor/selection/scroll state.
HISTORY-RETAIN-NEWEST-P keeps the newest record over a positive character budget; zero history limits still disable retention."
 (make-widget 'text-buffer :text text :read-only-p read-only-p
              :history-limit history-limit :history-character-limit history-character-limit
              :history-retain-newest-p history-retain-newest-p))
(defmethod initialize-instance :after ((buffer text-buffer) &key)
 (let ((initial (slot-value buffer 'text)))
   (setf (slot-value buffer 'text-root) (index-string initial)
         (slot-value buffer 'text) (copy-seq initial))))
(defmethod text :around ((buffer text-buffer))
 (unless (slot-value buffer 'text-snapshot-p)
   (setf (slot-value buffer 'text) (index-substring (slot-value buffer 'text-root) 0 (text-length buffer))
         (slot-value buffer 'text-snapshot-p) t))
 (call-next-method))
(defun buffer-revision (buffer)
 "Return BUFFER's monotonically increasing content revision."
 (slot-value buffer 'revision))
(defun editing-model (target)
 (etypecase target
   (text-buffer target)
   (entry (or (view-buffer target) target))))
(defgeneric editable-p (target)
 (:documentation "Whether an entry/view or buffer permits edits. Read-only views still allow navigation, selection and copy."))
(defmethod editable-p ((target t))
 "Whether an entry/view or buffer permits edits. Read-only views still allow navigation, selection and copy."
 (and (not (disposed-p target)) (not (read-only-p target))
      (or (not (typep target 'entry)) (null (view-buffer target))
          (and (not (disposed-p (view-buffer target))) (not (read-only-p (view-buffer target))))) t))
(defgeneric can-undo-p (target)
 (:documentation "Whether TARGET can currently undo; shared views query shared history and their own read-only policy."))
(defmethod can-undo-p ((target t))
 "Whether TARGET can currently undo; shared views query shared history and their own read-only policy."
 (and (editable-p target) (undo-history (editing-model target)) t))
(defgeneric can-redo-p (target)
 (:documentation "Whether TARGET can currently redo."))
(defmethod can-redo-p ((target t))
 "Whether TARGET can currently redo."
 (and (editable-p target) (redo-history (editing-model target)) t))
(defmethod text :around ((view entry))
 ;; During initialization this also lets cursor validation see the model's text.
 (let ((buffer (and (slot-boundp view 'view-buffer) (view-buffer view))))
   (if buffer (text buffer) (call-next-method))))
(defun attach-buffer-view (view buffer &key quiet)
 (let ((old (view-buffer view)))
   (unless (eq old buffer)
     (cancel-view-text-selection view)
     (when buffer (validate-slot view 'text (text buffer)))
     (let ((previous (copy-seq (text view))))
       (when old (setf (slot-value old 'buffer-views) (remove view (buffer-views old))))
       (setf (slot-value view 'view-buffer) buffer
             (slot-value view 'text-root) nil (slot-value view 'indexed-string) nil
             (slot-value view 'geometry-cache) nil)
       (when buffer
         (setf (slot-value buffer 'buffer-views) (append (buffer-views buffer) (list view))))
       (let* ((contents (if buffer (text buffer) previous)) (length (length contents)))
         (setf (slot-value view 'text) (if buffer "" contents)
               (slot-value view 'cursor) (min (cursor view) length)
               (slot-value view 'anchor) (min (slot-value view 'anchor) length)
               (slot-value view 'undo-history) nil (slot-value view 'redo-history) nil
               (slot-value view 'last-cursor) -1)
         (when buffer (setf (slot-value view 'text-offset) 0 (slot-value view 'vertical-offset) 0))
         (when buffer (reset-text-presentation view))
         (unless (or quiet (string= previous contents)) (emit view :change contents)))))) buffer)
(defmethod (setf view-buffer) :around (buffer (view entry))
 (check-type buffer (or null text-buffer))
 (ensure-live view) (when buffer (ensure-live buffer))
 (validate-slot view 'view-buffer buffer)
 (attach-buffer-view view buffer))
(defmethod validate-slot :before ((view entry) slot value)
 (declare (ignore view))
 (when (and (eq slot 'view-buffer) value) (check-type value text-buffer) (ensure-live value)))
(defmethod initialize-instance :after ((view entry) &key)
 (let ((buffer (view-buffer view)))
   (when buffer
     (setf (slot-value view 'view-buffer) nil)
     (attach-buffer-view view buffer :quiet t))))
(defmethod dispose :before ((view entry)) (attach-buffer-view view nil :quiet t))
(defmethod dispose :before ((buffer text-buffer))
 (dolist (view (copy-list (buffer-views buffer)))
   (attach-buffer-view view nil :quiet t)
   ;; A destroyed model leaves safe read-only snapshots in surviving views.
   (setf (slot-value view 'read-only-p) t)))
(defmethod dispose :after ((buffer text-buffer))
 (setf (slot-value buffer 'buffer-views) nil (slot-value buffer 'undo-history) nil
       (slot-value buffer 'redo-history) nil (slot-value buffer 'text) ""
       (slot-value buffer 'text-root) nil (slot-value buffer 'text-snapshot-p) t))
(defun remap-text-position (position start old-end new-end)
 (cond ((< position start) position)
       ((> position old-end) (+ position (- new-end old-end)))
       (t new-end)))
(defparameter *builtin-text-validators*
 (list (find-method #'validate-slot nil (list (find-class 't) (find-class 't) (find-class 't)))
       (find-method #'validate-slot '(:before) (list (find-class 'widget) (find-class 't) (find-class 't)))
       (find-method #'validate-slot nil (list (find-class 'entry) (find-class 't) (find-class 't)))
       (find-method #'validate-slot '(:before) (list (find-class 'entry) (find-class 't) (find-class 't)))))
(defun full-text-validator-p (object)
 ;; Built-in TEXT validators are no-ops. Custom class/slot/string methods keep
 ;; receiving an actual proposed string before any content/history mutation.
 (some (lambda (method) (not (member method *builtin-text-validators*)))
       (compute-applicable-methods #'validate-slot (list object 'text ""))))
(defun emit-text-change (object buffer)
 ;; Do not construct a compatibility string unless somebody requests one.
 (when (has-handler-p object :change) (emit object :change (text buffer))))
(defun commit-buffer-edit (buffer start end replacement &key origin collapse-origin selection force history-direction history-entry)
 (ensure-live buffer) (check-type replacement string)
 (when (buffer-notifying-p buffer) (error "Queue edits made in buffer change callbacks instead of editing reentrantly."))
 (unless (and (typep start '(integer 0 *)) (typep end '(integer 0 *))
              (<= start end (text-length buffer))) (error "Invalid text buffer edit range."))
 (when origin
   (unless (and (typep origin 'entry) (not (disposed-p origin)) (eq (view-buffer origin) buffer))
     (error "Edit origin must be a live view of this buffer.")))
 (unless (or force (and (editable-p buffer) (or (null origin) (editable-p origin))))
   (return-from commit-buffer-edit nil))
 (let* ((removed (text-range buffer start end))
        (new-root (replace-index-range (slot-value buffer 'text-root) start end replacement))
        (new-length (node-size new-root))
        (new-end (+ start (length replacement))))
   (when (string= removed replacement)
     (when (and origin collapse-origin)
       (setf (cursor origin) new-end (slot-value origin 'anchor) new-end))
     (return-from commit-buffer-edit nil))
   ;; Preserve extensible text invariants before changing any model/view state.
   (let ((validators (remove-if-not #'full-text-validator-p (cons buffer (copy-list (buffer-views buffer))))))
     (when validators
       (let ((new (index-substring new-root 0 new-length)))
         (dolist (object validators) (validate-slot object 'text new)))))
   (let ((overflow-record nil) (overflow-stack nil)
         (record (when *record-buffer-history*
                   (%make-buffer-history-entry :start start :removed removed
                     :inserted (copy-seq replacement) :before-cursor (when origin (cursor origin))
                     :before-anchor (when origin (slot-value origin 'anchor))))))
     ;; Move history only after all validation has succeeded. Replaying a range
     ;; keeps the inverse payload and captures the invoking view's current selection.
     (when history-direction
       (let ((from (if (eq history-direction :undo) 'undo-history 'redo-history))
             (to (if (eq history-direction :undo) 'redo-history 'undo-history))
             (inverse (copy-buffer-history-entry history-entry)))
         (if (eq history-direction :undo)
             (setf (buffer-history-entry-after-cursor inverse) (when origin (cursor origin))
                   (buffer-history-entry-after-anchor inverse) (when origin (slot-value origin 'anchor)))
             (setf (buffer-history-entry-before-cursor inverse) (when origin (cursor origin))
                   (buffer-history-entry-before-anchor inverse) (when origin (slot-value origin 'anchor))))
         (setf (slot-value buffer to) (bounded-buffer-history buffer (cons inverse (slot-value buffer to)))
               (slot-value buffer from) (rest (slot-value buffer from))
               overflow-record inverse overflow-stack (if (eq history-direction :undo) :redo :undo))))
     (let* ((views (copy-list (buffer-views buffer)))
            (revision (incf (slot-value buffer 'revision)))
            (edit (%make-buffer-edit :start start :old-end end :new-end new-end :revision revision :origin origin)))
       (setf (slot-value buffer 'text-root) new-root
             (slot-value buffer 'text) "" (slot-value buffer 'text-snapshot-p) nil)
       ;; All views are consistent before any application notification is emitted.
       (dolist (view views)
         (when (and (not (disposed-p view)) (eq (view-buffer view) buffer))
           (if (eq view origin) (cancel-view-text-selection view)
               (remap-view-text-selection view start end new-end))
           (remap-text-presentation view start end new-end)
           (setf (slot-value view 'text) ""
                 (slot-value view 'cursor) (remap-text-position (cursor view) start end new-end)
                 (slot-value view 'anchor) (remap-text-position (slot-value view 'anchor) start end new-end))
           (when (and (eq view origin) collapse-origin)
             (setf (slot-value view 'cursor) new-end (slot-value view 'anchor) new-end))
           (when (and (eq view origin) selection)
             (setf (slot-value view 'cursor) (min (first selection) new-length)
                   (slot-value view 'anchor) (min (second selection) new-length)))))
       (when record
         (setf (buffer-history-entry-after-cursor record) (when origin (cursor origin))
               (buffer-history-entry-after-anchor record) (when origin (slot-value origin 'anchor))
               (undo-history buffer) (bounded-buffer-history buffer (cons record (undo-history buffer)))
               (redo-history buffer) nil
               overflow-record record overflow-stack :undo))
       (let ((overflow (history-overflow-payload buffer overflow-record (or history-direction :edit) overflow-stack)))
         (setf (slot-value buffer 'buffer-notifying-p) t)
         (unwind-protect
           (progn
             (emit buffer :edit edit) (emit-text-change buffer buffer)
             (dolist (view views)
               (when (and (not (disposed-p view)) (eq (view-buffer view) buffer)) (emit-text-change view buffer)))
             (emit-history-overflow buffer overflow))
           (setf (slot-value buffer 'buffer-notifying-p) nil))) edit))))
(defun replace-buffer-range (buffer start end string &key origin)
 "Replace character range [START,END), remap attached view positions, and notify. ORIGIN optionally places that view's caret at the inserted text's end. Return BUFFER-EDIT or NIL."
 (commit-buffer-edit buffer start end string :origin origin :collapse-origin t))
(defun replace-buffer-text (buffer string &key origin force selection)
 (check-type string string)
 (multiple-value-bind (start end replacement) (text-difference (text buffer) string)
   (commit-buffer-edit buffer start end replacement :origin origin :force force :selection selection)))
(defmethod (setf text) :around (string (buffer text-buffer))
 (replace-buffer-text buffer string :force t) string)
(defun set-buffer-view-text (view string)
 (replace-buffer-text (view-buffer view) string :origin view :force t) string)
(defun restore-buffer-history (target direction)
 (let* ((buffer (editing-model target)) (origin (when (typep target 'entry) target))
        (from (if (eq direction :undo) 'undo-history 'redo-history))
        (entry (first (slot-value buffer from))))
   (when (and entry (editable-p target))
     (when (buffer-notifying-p buffer) (error "Cannot undo/redo during buffer notification."))
     (let* ((undo-p (eq direction :undo)) (start (buffer-history-entry-start entry))
            (removed (if undo-p (buffer-history-entry-inserted entry) (buffer-history-entry-removed entry)))
            (inserted (if undo-p (buffer-history-entry-removed entry) (buffer-history-entry-inserted entry)))
            (cursor (if undo-p (buffer-history-entry-before-cursor entry) (buffer-history-entry-after-cursor entry)))
            (anchor (if undo-p (buffer-history-entry-before-anchor entry) (buffer-history-entry-after-anchor entry)))
            (*record-buffer-history* nil))
       (commit-buffer-edit buffer start (+ start (length removed)) inserted :origin origin
         :history-direction direction :history-entry entry
         :selection (when (and origin cursor anchor) (list cursor anchor)))) t)))
