(in-package #:lut)

(defun paint-control-icon (w icon cx cy &optional (size 14) ink)
 (let* ((r (/ size 2)) (color (or ink (style-value w (if (eq (widget-state w) :disabled) :disabled-color :foreground)))))
   (flet ((line (x1 y1 x2 y2)
            (rl:draw-line-ex (rl:vec2 (+ cx x1) (+ cy y1)) (rl:vec2 (+ cx x2) (+ cy y2)) 1.5 color)))
     (case icon
       (:search (rl:draw-circle-lines (round (- cx 1)) (round (- cy 1)) (* r 0.65) color)
                (line (* r 0.35) (* r 0.35) r r))
       (:clear (line -4 -4 4 4) (line -4 4 4 -4))
       (:minus (line -4 0 4 0))
       (:plus (line -4 0 4 0) (line 0 -4 0 4))
       (:previous (line 2 -4 -2 0) (line -2 0 2 4))
       (:next (line -2 -4 2 0) (line 2 0 -2 4))
       (:calendar
        (line -6 -5 6 -5) (line -6 6 6 6) (line -6 -5 -6 6) (line 6 -5 6 6)
        (line -6 -1 6 -1) (line -3 -7 -3 -3) (line 3 -7 3 -3)
        (rl:draw-circle (- cx 2) (+ cy 2) 1 color) (rl:draw-circle (+ cx 2) (+ cy 2) 1 color))))))

(defmethod render ((w spin-button))
 (paint-surface w (style-value w :surface))
 (let* ((size (min 32 (/ (width w) 2)))
        (side (max 0 (min 26 (- (height w) 8) (- size 4))))
        (cy (+ (y w) (/ (height w) 2)))
        (caption (princ-to-string (value w))))
   (with-drawing-clip ((+ (x w) size) (y w) (max 0 (- (width w) (* 2 size))) (height w))
     (draw-string w caption (+ (x w) (/ (- (width w) (text-width w caption)) 2))
                  (+ (y w) (/ (- (height w) (style-value w :font-size)) 2))
                  (when (eq (widget-state w) :disabled) (style-value w :disabled-color))))
   (loop for icon in '(:minus :plus)
         for cx in (list (+ (x w) (/ size 2)) (- (+ (x w) (width w)) (/ size 2))) do
     (when (and (not (eq (widget-state w) :disabled))
                (or (and (hovered-p w) (eq (spin-hover w) icon))
                    (and (pressed-p w) (eq (spin-press w) icon))))
       (paint-rounded w (- cx (/ side 2)) (- cy (/ side 2)) side side 0.6
                      (style-value w (if (and (pressed-p w) (eq (spin-press w) icon)) :pressed-color :hover-color))))
     (with-drawing-clip ((- cx (/ size 2)) (y w) size (height w))
       (paint-control-icon w icon cx cy)))))

(defun paint-action-spot (w x y width height &optional selected)
 (when (or selected (eq (widget-state w) :pressed) (eq (widget-state w) :hover))
   (paint-rounded w x y width height 0.6
      (style-value w (if (eq (widget-state w) :pressed) :pressed-color :hover-color)))))

(defun paint-exterior-focus (w)
 (when (and (style-value w :focus-outline-p) (visible-p w) (not (disposed-p w))
            (typep (root-of w) 'window) (focus-visible-p (root-of w))
            (let ((focused (focused-widget (root-of w))))
              (or (eq focused w) (and (typep w 'search-control) (member focused (children w))))))
   (with-drawing-clip ((- (x w) 4) (- (y w) 4) (+ (width w) 8) (+ (height w) 8))
     (rl:draw-rectangle-rounded-lines-ex
       (rl:rect (- (x w) 3) (- (y w) 3) (+ (width w) 6) (+ (height w) 6))
       (resolved-roundness w (+ (width w) 6) (+ (height w) 6)) 16 2 (style-value w :focus-color)))))
(defmethod render :around ((w date-picker))
 (prog1 (call-next-method) (paint-exterior-focus w)))
(defmethod render :around ((w search-control))
 (prog1 (call-next-method) (paint-exterior-focus w)))

(defmethod render ((w date-picker))
 ;; Field controls retain a neutral surface on hover and press.
 (paint-surface w (style-value w :surface))
 (let* ((fw (picker-field-width w))
        (top (+ (y w) (/ (- (height w) (style-value w :font-size)) 2)))
        (separator (if (typep w 'time-picker) ":" "-")))
   (dotimes (field 3)
     (let ((left (+ (x w) (* field fw))) (caption (picker-field-string w field)))
       (with-drawing-clip (left (+ (y w) 3) fw (max 0 (- (height w) 6)))
         (when (and (= field (picker-field w)) (typep (root-of w) 'window)
                    (eq w (focused-widget (root-of w))))
           (paint-rounded w (+ left 4) (+ (y w) 5) (max 0 (- fw 8)) (max 0 (- (height w) 10)) 0.5
                          (style-value w :hover-color)))
         (draw-string w caption (+ left (max 0 (/ (- fw (text-width w caption)) 2))) top
                      (when (eq (widget-state w) :disabled) (style-value w :disabled-color))))
       (when (< field 2)
         (draw-string w separator (- (+ left fw) (/ (text-width w separator) 2)) top
                      (style-value w :muted-color)))))
   (loop for icon in (if (typep w 'time-picker) '(:minus :plus) '(:minus :plus :calendar))
         for index from 0 for left = (+ (x w) (* 3 fw) (* index 24)) do
     (let ((hot (and (hovered-p w) (eq icon (picker-hover w)))))
       (when (or hot (and (pressed-p w) (eq icon (picker-press w))))
         (paint-rounded w (+ left 1) (+ (y w) 5) 22 (max 0 (- (height w) 10)) 0.6
           (style-value w (if (and (pressed-p w) (eq icon (picker-press w))) :pressed-color :hover-color))))
       (paint-control-icon w icon (+ left 12) (+ (y w) (/ (height w) 2)))))
   (when (picker-twelve-hour-p w)
     (let* ((left (+ (x w) (* 3 fw) 48))
            (caption (if (< (first (clock-time w)) 12) "AM" "PM")))
       (when (and (typep (root-of w) 'window) (eq w (focused-widget (root-of w))) (= (picker-field w) 3))
         (paint-rounded w (+ left 2) (+ (y w) 5) 38 (max 0 (- (height w) 10)) 0.5 (style-value w :hover-color)))
       (draw-string w caption (+ left (/ (- 44 (text-width w caption)) 2)) top (style-value w :muted-color))))))

(defmethod render ((w picker-calendar-popup)) (paint-surface w (style-value w :surface)))
(defmethod render ((w calendar-day-button))
 (let ((side (max 0 (- (min (width w) (height w)) 2))))
   (when (plusp side)
     (when (or (value w) (member (widget-state w) '(:hover :pressed)))
       (paint-rounded w (+ (x w) (/ (- (width w) side) 2)) (+ (y w) (/ (- (height w) side) 2)) side side 0.7
                      (if (value w) (style-value w :accent) (surface-color w))))
     (paint-caption w 0 :center (when (value w) (style-value w :on-accent))))))
(defmethod render ((w calendar-nav-button))
 (paint-action-spot w (x w) (y w) (width w) (height w))
 (paint-control-icon w (if (string= (text w) "<") :previous :next)
                     (+ (x w) (/ (width w) 2)) (+ (y w) (/ (height w) 2))))

(defmethod render ((w search-submit-button))
 (paint-action-spot w (x w) (y w) (width w) (height w))
 (paint-control-icon w :search (+ (x w) (/ (width w) 2)) (+ (y w) (/ (height w) 2))))
(defmethod render ((w search-clear-button))
 (unless (zerop (text-length (parent w))) (paint-action-spot w (x w) (y w) (width w) (height w)))
 (paint-control-icon w :clear (+ (x w) (/ (width w) 2)) (+ (y w) (/ (height w) 2)) 14
                      (when (zerop (text-length (parent w))) (style-value w :border-color))))

(defmethod render ((w search-control))
 (paint-surface w)
 (multiple-value-bind (x y width height) (scroll-viewport w)
   (with-drawing-clip (x y width height)
     (paint-text w)
     (when (zerop (text-length w))
       (draw-string w (search-hint w) x (+ (y w) (text-top-inset w)) (style-value w :muted-color))))))

(defun paint-spinner-arc (cx cy radius start sweep color thickness)
 (loop for i below 48
       for a = (+ start (* sweep (/ i 48)))
       for b = (+ start (* sweep (/ (1+ i) 48))) do
   (rl:draw-line-ex (rl:vec2 (+ cx (* radius (cos a))) (+ cy (* radius (sin a))))
                   (rl:vec2 (+ cx (* radius (cos b))) (+ cy (* radius (sin b)))) thickness color))
 (dolist (a (list start (+ start sweep)))
   (rl:draw-circle (+ cx (* radius (cos a))) (+ cy (* radius (sin a))) (/ thickness 2) color)))
(defmethod render ((w activity-indicator))
 (when (activity-running-p w)
   (let* ((diameter (min 20 (width w) (height w)))
          (radius (max 0 (- (/ diameter 2) 2)))
          (cx (+ (x w) (/ (width w) 2))) (cy (+ (y w) (/ (height w) 2)))
          (phase (* 2 pi (/ (get-internal-real-time) internal-time-units-per-second 1.2)))
          (sweep (+ pi (* 0.65 pi (sin (* phase 0.6))))))
     (when (plusp radius)
       (paint-spinner-arc cx cy radius 0 (* 2 pi) (style-value w :border-color) 2)
       (paint-spinner-arc cx cy radius phase sweep (indicator-color w) 2)))))

(defmethod render ((w icon-toggle-button))
 (if (null (icon-source w)) (call-next-method)
     (progn
       (paint-button-surface w (if (value w) (selected-toggle-color w) (surface-color w)))
       ;; Use the shared texture cache without creating transient widget children.
       (let* ((key (list (namestring (pathname (icon-source w))) (file-write-date (icon-source w))))
              (texture (or (cdr (assoc key *texture-cache* :test #'equal))
                           (let ((tex (rl:load-texture (icon-source w))))
                             (unless (rl:is-texture-valid tex) (error "Could not load icon ~a" (icon-source w)))
                             (push (cons key tex) *texture-cache*) tex)))
              (pad (style-value w :padding))
              (scale (max 0 (min (/ (max 0 (- (width w) (* 2 pad))) (rl:texture-width texture))
                                 (/ (max 0 (- (height w) (* 2 pad) (button-depth w))) (rl:texture-height texture))))))
         (pushnew texture *used-textures* :test #'eq)
         (when (plusp scale)
           (rl:draw-texture-ex texture
             (rl:vec2 (+ (x w) (/ (- (width w) (* scale (rl:texture-width texture))) 2))
                      (+ (y w) (/ (- (height w) (* scale (rl:texture-height texture))) 2) (button-caption-offset w)))
             0 scale (if (eq (widget-state w) :disabled) (style-value w :disabled-color) :white)))))))
