(in-package #:lut)

(defwidget wrapped-text-view (styled-text-view)
 "Editable character-wrapped text sharing visual rows across painting and interaction."
 ((word-wrap-p nil boolean "Prefer whitespace boundaries; long words still split by character. Source positions and whitespace remain intact.")
  (wrapped-codepoints-cache nil t "Internal glyph set keyed by text root and presentation revision.")
  (wrapped-upstream-p nil boolean "Internal soft-boundary caret affinity.")))
(defwidget wrapped-document-view (document-view wrapped-text-view)
 "Read-only wrapped document with variable row metrics and block images."
 ((paragraph-spacing 0 (real 0 *) "Additional pixels after each logical paragraph.")))
(defstruct visual-row start end top height advances)

(defgeneric build-wrapped-rows (view offered-width))
(defmethod build-wrapped-rows ((view wrapped-text-view) offered-width)
 ;; Rebuild on demand: no retained copies of buffers or stale font/allocation keys.
 ;; Rows retain only insertion advances. Character wrapping preserves all spaces.
 (let* ((root (display-index view))
        (available (max 1 (- offered-width (text-left-padding view) (style-value view :padding))))
        (glyph-advances (make-array (node-size root) :initial-element 0))
        (prefix-advances nil) (rows nil) (top 0) (start 0) (position 0)
        (advances (list 0)) (used 0) (tall (line-height view)))
   (loop for from from 0 below (node-size root) by 256 do
     (let ((at from))
       (map-text-range-advances view (index-substring root from (min (node-size root) (+ from 256))) from
         (lambda (advance) (setf (aref glyph-advances at) (max 0 advance)) (incf at)))))
   (when (word-wrap-p view)
     (setf prefix-advances (make-array (1+ (node-size root)) :initial-element 0))
     (dotimes (i (node-size root))
       (setf (aref prefix-advances (1+ i)) (+ (aref prefix-advances i) (aref glyph-advances i)))))
   (labels ((finish (end)
              (push (make-visual-row :start start :end end :top top :height tall
                       :advances (coerce (reverse advances) 'vector)) rows)
              (incf top tall)
              (setf start end advances (list 0) used 0 tall (line-height view)))
            (paragraph-gap ()
              (when (typep view 'wrapped-document-view) (incf top (paragraph-spacing view)))))
     (loop while (< position (node-size root))
           for character = (index-character root position) do
       (if (char= character #\Newline)
           (progn
             (unless (and (= position start) rows (plusp position)
                          (typep view 'wrapped-document-view)
                          (interval-at (presentation-images view) (1- position)))
               (finish position))
             (paragraph-gap) (incf position) (setf start position))
           (let* ((image (interval-at (presentation-images view) position))
                  (block (and image (typep view 'wrapped-document-view)))
                  (advance (aref glyph-advances position))
                  (font-size (or (getf (text-style-at view position) :font-size)
                                 (style-value view :font-size))))
             (when (and (word-wrap-p view) (> position start) (not image)
                        (not (find character '(#\Space #\Tab)))
                        (find (index-character root (1- position)) '(#\Space #\Tab #\Newline)))
               (let* ((end (loop for i from position below (node-size root)
                                 when (find (index-character root i) '(#\Space #\Tab #\Newline)) return i
                                 finally (return (node-size root))))
                      (word-width (- (aref prefix-advances end) (aref prefix-advances position))))
                 (when (> (+ used word-width) available) (finish position))))
             (when (and (> position start) (or block (> (+ used advance) available))) (finish position))
             (incf used advance) (push used advances)
             (setf tall (max tall font-size (if image (getf image :height) 0)))
             (incf position)
             (when block (finish position)))))
     ;; Do not add a phantom row after a terminal image, but preserve trailing newline.
     (when (or (> position start) (null rows)
               (and (plusp position) (char= (index-character root (1- position)) #\Newline)))
       (finish position)))
   (coerce (nreverse rows) 'vector)))
(defun wrapped-rows (view &optional (offered-width (width view)))
 (let* ((root (display-index view))
        (key (list (word-wrap-p view) offered-width (text-metric-key view) (text-left-padding view)
                   (style-value view :padding) (line-height view)
                   (when (typep view 'wrapped-document-view) (paragraph-spacing view))))
        (cache (slot-value view 'geometry-cache))
        (wrapped (remove-if-not (lambda (entry) (and (consp entry) (eq (first entry) :wrapped)
                                                    (eq root (second entry)))) cache))
        (hit (find key wrapped :key #'third :test #'equal)))
   (if hit (fourth hit)
       (let ((rows (build-wrapped-rows view offered-width)))
         ;; Parent allocation and scrollbar negotiation visit window/pane widths,
         ;; each with/without a bar. Retain four layouts for the current text root.
         (setf (slot-value view 'geometry-cache)
           (append (list (list :wrapped root key rows))
                   (subseq wrapped 0 (min 3 (length wrapped)))
                   (remove-if (lambda (entry) (and (consp entry) (eq (first entry) :wrapped))) cache)))
         rows))))
(defmethod (setf text-offset) :around (value (view wrapped-text-view))
 (check-type value (real 0 *)) (call-next-method 0 view))
(defun wrapped-position-row (rows position)
 ;; A soft boundary belongs to the following row; EOF belongs to the last row.
 (loop with previous = nil for row across rows do
   (when (< position (visual-row-start row)) (return-from wrapped-position-row previous))
   (when (< position (visual-row-end row)) (return-from wrapped-position-row row))
   (setf previous row)
   finally (return previous)))

(defmethod text-position-rectangle ((view wrapped-text-view) position)
 (unless (and (integerp position) (<= 0 position (node-size (display-index view))))
   (error "Invalid display text position."))
 (let* ((row (wrapped-view-position-row view position))
        (column (min (- position (visual-row-start row)) (1- (length (visual-row-advances row))))))
   (values (+ (x view) (text-left-padding view) (aref (visual-row-advances row) column))
     (- (+ (y view) (style-value view :padding) (visual-row-top row)) (vertical-offset view))
     (style-value view :caret-width) (visual-row-height row))))
(defmethod text-point-position ((view wrapped-text-view) px py)
 (check-type px real) (check-type py real)
 (let* ((rows (wrapped-rows view))
        (local-y (+ (- py (y view) (style-value view :padding)) (vertical-offset view)))
        (row (or (find-if (lambda (r) (< local-y (+ (visual-row-top r) (visual-row-height r)))) rows)
                 (aref rows (1- (length rows)))))
        (local-x (- px (x view) (text-left-padding view)))
        (advances (visual-row-advances row)))
   (+ (visual-row-start row)
      (loop for i from 0 below (1- (length advances))
            when (< local-x (/ (+ (aref advances i) (aref advances (1+ i))) 2)) return i
            finally (return (1- (length advances)))))))
(defmethod map-visible-text-lines ((view wrapped-text-view) function)
 (let ((count 0) (pad (style-value view :padding)))
   (loop for row across (wrapped-rows view) for i from 0
         for top = (- (+ (y view) pad (visual-row-top row)) (vertical-offset view))
         when (and (< top (- (+ (y view) (height view)) pad))
                   (> (+ top (visual-row-height row)) (+ (y view) pad))) do
           (funcall function i (visual-row-start row) (visual-row-end row)
                    (+ (x view) (text-left-padding view)) top)
           (incf count)) count))
(defmethod visible-line-fragment ((view wrapped-text-view) root line)
 (declare (ignore root))
 (let ((row (aref (wrapped-rows view) line)))
   (values (visual-row-start row) (visual-row-end row) 0)))
(defmethod text-row-range ((view wrapped-text-view) position)
 (let ((row (wrapped-view-position-row view position)))
   (values (visual-row-start row) (visual-row-end row))))
(defmethod text-range-width ((view wrapped-text-view) start end)
 (let* ((row (wrapped-position-row (wrapped-rows view) start)) (adv (visual-row-advances row)))
   (- (aref adv (min (- end (visual-row-start row)) (1- (length adv))))
      (aref adv (- start (visual-row-start row))))))
(defmethod text-content-height ((view wrapped-text-view))
 (let* ((rows (wrapped-rows view)) (last (aref rows (1- (length rows)))))
   (+ (visual-row-top last) (visual-row-height last))))
(defmethod measure ((view wrapped-text-view) axis &optional for-size)
 (let ((pad (+ (text-left-padding view) (style-value view :padding))))
   (if (eq axis :horizontal)
       (values pad (max pad (layout-width-hint view)))
       (let* ((rows (wrapped-rows view (or for-size (width view))))
              (last (aref rows (1- (length rows))))
              (height (+ (* 2 (style-value view :padding)) (visual-row-top last) (visual-row-height last))))
         (values (+ (* 2 (style-value view :padding)) (line-height view)) height)))))
(defmethod layout :after ((view wrapped-text-view) x y width height)
 (declare (ignore x y width height))
 (setf (text-offset view) 0)
 (setf (vertical-offset view) (min (vertical-offset view)
   (max 0 (- (+ (* 2 (style-value view :padding)) (text-content-height view)) (height view))))))

(defun wrapped-view-position-row (view position)
 (let ((rows (wrapped-rows view)))
   (or (when (and *text-caret-affinity* (wrapped-upstream-p view) (= position (cursor view)))
         (find-if (lambda (row) (and (< (visual-row-start row) position) (= position (visual-row-end row)))) rows))
       (wrapped-position-row rows position))))
(defmethod (setf cursor) :after (position (view wrapped-text-view))
 (declare (ignore position)) (setf (slot-value view 'wrapped-upstream-p) nil))
(defmethod finish-text-navigation ((view wrapped-text-view) movement)
 (when (eq movement :line-end) (setf (slot-value view 'wrapped-upstream-p) t)))
(defmethod text-vertical-position ((view wrapped-text-view) position goal direction)
 (let* ((rows (wrapped-rows view)) (row (wrapped-view-position-row view position))
        (index (position row rows))
        (target (aref rows (max 0 (min (1- (length rows)) (+ index direction))))))
   (text-point-position view (+ (x view) (text-left-padding view) goal)
     (- (+ (y view) (style-value view :padding) (visual-row-top target) (/ (visual-row-height target) 2))
        (vertical-offset view)))))

(defmethod dispose :after ((view wrapped-text-view))
 (setf (slot-value view 'wrapped-codepoints-cache) nil))
