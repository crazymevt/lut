(in-package #:lut)
(defmethod (setf focused-widget) :around (new-value (window window))
 (let ((old (focused-widget window)))
   (prog1 (call-next-method)
     (when (and old (not (eq old new-value))) (setf (key-capture old) nil)))))
(defun keys-captured-p (widget)
 "Whether WIDGET has a capture configuration. Capture operates only while focused and live."
 (ensure-live widget) (not (null (key-capture widget))))
(defun capture-keys (widget &key (release-key :f12) passthrough)
 "Capture focused key/text events as :RAW-KEY/:RAW-TEXT before window handlers. RELEASE-KEY is mandatory; PASSTHROUGH lists shortcut specs that retain normal routing."
 (ensure-live widget)
 (unless (focusable-p widget) (error "Capture requires a focusable widget."))
 (unless release-key (error "Capture requires a release key."))
 (validate-command-shortcut release-key)
 (dolist (shortcut passthrough)
   (unless shortcut (error "Empty passthrough shortcut.")) (validate-command-shortcut shortcut))
 (setf (key-capture widget) (list (copy-tree release-key) (copy-tree passthrough))) widget)
(defun release-keys (widget)
 "Clear WIDGET's key capture configuration. Return WIDGET."
 (setf (key-capture widget) nil) widget)
(defun dispatch-key-capture (window event)
 (let ((widget (focused-widget window)))
   (when (and widget (not (disposed-p widget)) (key-capture widget)
              (live-input-widget-p widget window) (member (event-kind event) '(:key :text)))
     (destructuring-bind (release passthrough) (key-capture widget)
       (cond ((and (eq (event-kind event) :key) (command-shortcut-matches-p release event))
              (release-keys widget) t)
             ((and (eq (event-kind event) :key)
                   (some (lambda (spec) (command-shortcut-matches-p spec event)) passthrough)) nil)
             (t (setf (focus-visible-p window) t)
                (emit widget (if (eq (event-kind event) :key) :raw-key :raw-text) event) t))))))

(defwidget cell-grid (widget) "Fixed-cell presentation surface; no emulator, PTY or scrollback model."
 ((grid-data #2A() array "Internal row-major cell storage, resized by layout.")
  (grid-cell-width 10 (real (0) *) "Internal logical cell width; use SET-GRID-CELL-METRICS.")
  (grid-cell-height 20 (real (0) *) "Internal logical cell height; use SET-GRID-CELL-METRICS.")
  (grid-selection nil list "Internal inclusive endpoints and rectangular flag.")))
(defun grid-columns (grid) "Allocated complete columns." (array-dimension (grid-data grid) 1))
(defun grid-rows (grid) "Allocated complete rows." (array-dimension (grid-data grid) 0))
(defun grid-cell-metrics (grid) "Return logical cell width and height." (values (grid-cell-width grid) (grid-cell-height grid)))
(defun resize-cell-grid (grid)
 (let ((columns (floor (width grid) (grid-cell-width grid)))
       (rows (floor (height grid) (grid-cell-height grid))))
   (unless (and (= columns (grid-columns grid)) (= rows (grid-rows grid)))
     (let ((data (make-array (list rows columns) :initial-element nil)) (old (grid-data grid)))
       (dotimes (r (min rows (grid-rows grid)))
         (dotimes (c (min columns (grid-columns grid))) (setf (aref data r c) (aref old r c))))
       (setf (grid-data grid) data (grid-selection grid) nil)
       (emit grid :grid-resize (list columns rows))))) grid)
(defmethod layout :after ((grid cell-grid) x y width height)
 (declare (ignore x y width height)) (unless (disposed-p grid) (resize-cell-grid grid)))
(defun set-grid-cell-metrics (grid width height)
 "Set positive logical cell dimensions, resizing immediately and preserving overlapping cells."
 (ensure-live grid) (check-type width (real (0) *)) (check-type height (real (0) *))
 (setf (grid-cell-width grid) width (grid-cell-height grid) height) (resize-cell-grid grid))
(defun check-grid-cell (grid column row)
 (ensure-live grid)
 (unless (and (typep column '(integer 0 *)) (typep row '(integer 0 *))
              (< column (grid-columns grid)) (< row (grid-rows grid))) (error "Cell outside grid.")))
(defun grid-cell (grid column row)
 "Return a copied cell plist (:CHARACTER :FOREGROUND :BACKGROUND :BOLD :UNDERLINE); NIL denotes a blank default cell."
 (check-grid-cell grid column row) (copy-tree (aref (grid-data grid) row column)))
(defun grid-color-p (color)
 (or (null color) (and (listp color) (= (length color) 4) (every (lambda (v) (typep v '(integer 0 255))) color))))
(defun set-grid-cell (grid column row character &key foreground background bold underline)
 "Replace a cell with one character and optional RGBA colours, synthetic bold and underline. Colours are copied."
 (check-grid-cell grid column row) (check-type character character)
 (unless (and (>= (char-code character) 32) (not (<= 127 (char-code character) 159))) (error "Control character is not a cell glyph."))
 (unless (and (grid-color-p foreground) (grid-color-p background)) (error "Colours must be NIL or four RGBA bytes."))
 (check-type bold boolean) (check-type underline boolean)
 (setf (aref (grid-data grid) row column)
       (list :character character :foreground (copy-list foreground) :background (copy-list background) :bold bold :underline underline))
 (invalidate-widget grid) grid)
(defun grid-point-cell (grid px py &key clamp)
 "Map root logical coordinates to column,row; outside returns NIL,NIL unless CLAMP. Empty grids return NIL,NIL."
 (ensure-live grid)
 (let ((c (floor (- px (x grid)) (grid-cell-width grid))) (r (floor (- py (y grid)) (grid-cell-height grid))))
   (when (and (plusp (grid-columns grid)) (plusp (grid-rows grid))
              (or clamp (and (<= 0 c) (< c (grid-columns grid)) (<= 0 r) (< r (grid-rows grid)))))
     (values (max 0 (min c (1- (grid-columns grid)))) (max 0 (min r (1- (grid-rows grid))))))))
(defun select-grid-cells (grid column1 row1 column2 row2 &key rectangular)
 "Select inclusive cell endpoints, in either direction. RECTANGULAR selects a rectangle; default uses row-major order."
 (check-grid-cell grid column1 row1) (check-grid-cell grid column2 row2) (check-type rectangular boolean)
 (setf (grid-selection grid) (list column1 row1 column2 row2 rectangular)) grid)
(defun clear-grid-selection (grid) "Clear cell selection." (setf (grid-selection grid) nil) grid)
(defun grid-cell-selected-p (grid column row)
 (when (grid-selection grid)
   (destructuring-bind (c1 r1 c2 r2 rectangular) (grid-selection grid)
     (if rectangular (and (<= (min c1 c2) column (max c1 c2)) (<= (min r1 r2) row (max r1 r2)))
         (let ((a (+ c1 (* r1 (grid-columns grid)))) (b (+ c2 (* r2 (grid-columns grid)))))
           (<= (min a b) (+ column (* row (grid-columns grid))) (max a b)))))))
(defun grid-selected-text (grid)
 "Copy selected characters in row order, joining rows with newlines; preserve spaces, no trailing newline."
 (ensure-live grid)
 (with-output-to-string (out)
   (let ((first-row t))
     (dotimes (r (grid-rows grid))
       (let ((columns (loop for c below (grid-columns grid) when (grid-cell-selected-p grid c r) collect c)))
         (when columns
           (unless first-row (terpri out)) (setf first-row nil)
           (dolist (c columns) (write-char (getf (aref (grid-data grid) r c) :character #\Space) out))))))))
(defun copy-grid-selection (grid)
 "Copy selected cell text through the clipboard API and return the string."
 (setf (clipboard-text grid) (grid-selected-text grid)))
(defmethod handle-event ((grid cell-grid) event)
 (case (event-kind event)
   (:down (multiple-value-bind (c r) (grid-point-cell grid (event-x event) (event-y event))
            (when c (select-grid-cells grid c r c r :rectangular (event-alt-p event)))) t)
   (:move (when (and (pressed-p grid) (grid-selection grid))
            (multiple-value-bind (c r) (grid-point-cell grid (event-x event) (event-y event) :clamp t)
              (when c (setf (third (grid-selection grid)) c (fourth (grid-selection grid)) r)))) t)
   (:up t)
   (:key (when (and (member (event-key event) '(:c :copy :control-c)) (or (event-control-p event) (event-super-p event)))
           (copy-grid-selection grid) t))
   (:text (emit grid :text-input event) t)))
(defmethod dispose :after ((grid cell-grid))
 (setf (grid-data grid) #2A() (grid-selection grid) nil (key-capture grid) nil))
