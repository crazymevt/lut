(in-package #:lut)

(defclass model-list-view (list-view)
 ((model :initarg :model :reader view-model)
  (selection :initarg :selection :initform nil :reader view-selection)
  (own-selection-p :initform nil :accessor own-selection-p)
  (label-function :initarg :row-label-function :initform #'princ-to-string :accessor row-label-function))
 (:documentation "Virtual, fixed-height data rows; MODEL and optional SELECTION are application-owned. No row widgets or ITEMS strings."))
(defclass model-tree-view (model-list-view) () (:documentation "Keyed tree rows with indentation and expansion; requires a tree model."))
(defgeneric model-header-height (view))
(defmethod model-header-height ((view model-list-view)) 0)
(defun model-viewport-height (view) (max 0 (- (height view) (model-header-height view))))
(defun model-scroll-limit (view)
 (if (or (null (view-model view)) (disposed-p (view-model view))) 0
     (max 0 (- (* (model-count (view-model view)) (row-height view)) (model-viewport-height view)))))
(defun clamp-model-viewport (view)
 (setf (scroll-offset view) (max 0 (min (scroll-offset view) (model-scroll-limit view)))) view)
(defun visible-model-range (view)
 "Return half-open visible indices including partial rows. Zero-height, missing or disposed models return 0,0."
 (clamp-model-viewport view)
 (let ((model (view-model view)) (rh (row-height view)))
   (if (or (null model) (disposed-p model) (zerop (model-viewport-height view))) (values 0 0)
       (values (min (model-count model) (floor (scroll-offset view) rh))
               (min (model-count model) (ceiling (+ (scroll-offset view) (model-viewport-height view)) rh))))))
(defun map-visible-model-rows (view function)
 "Call FUNCTION with (INDEX KEY ITEM X Y WIDTH HEIGHT) only for visible rows. Return visited count."
 (multiple-value-bind (start end) (visible-model-range view)
   (loop for index from start below end do
     (funcall function index (model-key (view-model view) index) (model-item (view-model view) index)
       (x view) (- (+ (y view) (model-header-height view) (* index (row-height view))) (scroll-offset view))
       (width view) (row-height view))) (- end start)))
(defun reveal-model-index (view index)
 "Scroll the visible INDEX into view without changing selection."
 (check-model-index (view-model view) index)
 (let ((top (* index (row-height view))))
   (setf (scroll-offset view) (max 0 (min top (max (scroll-offset view) (- (+ top (row-height view)) (model-viewport-height view)))))))
 (clamp-model-viewport view))
(defun sync-model-view (view)
 (let* ((model (view-model view)) (selection (view-selection view)))
   (setf (value view) (when (and model selection (not (disposed-p model)) (not (disposed-p selection)) (selection-focus selection))
                      (model-index model (selection-focus selection)))))
 (clamp-model-viewport view))
(defmethod initialize-instance :after ((view model-list-view) &key)
 (unless (and (slot-boundp view 'model) (typep (view-model view) 'data-model)) (error "Model views require :MODEL."))
 (ensure-live (view-model view))
 ;; Validate subclass contracts before installing source-owned callbacks, so
 ;; failed construction cannot leave an unreachable view subscribed forever.
 (when (and (typep view 'model-tree-view) (not (typep (view-model view) 'tree-model)))
   (error "A model-tree-view requires a tree model."))
 (when (typep view 'model-table-view)
   (unless (and (slot-boundp view 'table-columns) (table-columns view) (listp (table-columns view))
                (every (lambda (c) (typep c 'data-column)) (table-columns view)))
     (error "A model table requires a nonempty list of data columns."))
   (unless (= (length (table-columns view)) (length (remove-duplicates (table-columns view) :key #'data-column-id :test #'equal)))
     (error "Table column identities must be unique.")))
 (unless (view-selection view)
   (setf (slot-value view 'selection) (make-selection-model (view-model view)) (own-selection-p view) t))
 (unless (and (typep (view-selection view) 'selection-model) (not (disposed-p (view-selection view)))
              (eq (selection-source (view-selection view)) (view-model view))) (error "Selection must use the view's model."))
 (on (view-model view) :model-change (lambda (m r) (declare (ignore m r)) (sync-model-view view)) :owner view)
 (on (view-model view) :model-disposing (lambda (m p) (declare (ignore m p))
   (unwind-protect (when (typep view 'model-table-view) (cancel-cell-edit view :model-change))
     (setf (slot-value view 'model) nil (value view) nil (scroll-offset view) 0))) :owner view)
 (on (view-selection view) :selection-change (lambda (s keys) (declare (ignore s))
   (sync-model-view view) (emit view :selection-change keys)) :owner view)
 (sync-model-view view))
(defmethod layout :after ((view model-list-view) x y width height)
 (declare (ignore x y width height)) (clamp-model-viewport view))
(defun model-row-at-point (view px py)
 (when (and (contains-point-p view px py) (>= py (+ (y view) (model-header-height view))))
   (let ((index (floor (+ (- py (y view) (model-header-height view)) (scroll-offset view)) (row-height view))))
     (when (and (view-model view) (not (disposed-p (view-model view))) (< -1 index (model-count (view-model view)))) index))))
(defun select-view-index (view index event)
 (let ((selection (view-selection view)))
   (when (and selection (not (disposed-p selection)))
     (handle-selection-event selection event :index index)
     (sync-model-view view) (reveal-model-index view index))))
(defmethod hover-row-at-point ((view model-list-view) px py)
 (model-row-at-point view px py))
(defmethod handle-event ((view model-list-view) event)
 (let ((model (view-model view)) (kind (event-kind event)))
   (unless (and model (not (disposed-p model))) (return-from handle-event t))
   (case kind
     (:wheel (setf (scroll-offset view) (max 0 (- (scroll-offset view) (* (event-delta event) (row-height view)))))
             (clamp-model-viewport view) t)
     (:down
      (let ((index (model-row-at-point view (event-x event) (event-y event))))
        (when index (select-view-index view index event))) t)
     ;; Consume UP so the legacy list ITEMS path cannot overwrite keyed selection.
     (:up t)
     (:key
      (when (and (view-selection view) (not (disposed-p (view-selection view)))
                 (member (event-key event) '(:up :down :home :end)))
        (handle-selection-event (view-selection view) event)
        (sync-model-view view)
        (when (value view) (reveal-model-index view (value view))) t)))))
(defmethod handle-event ((view model-tree-view) event)
 (let* ((model (view-model view)) (key (and (view-selection view) (selection-focus (view-selection view)))))
   (cond ((and model (eq (event-kind event) :key) key (member (event-key event) '(:left :right)))
          (set-tree-expanded model key (eq (event-key event) :right)) t)
         ((and model (eq (event-kind event) :down)
               (let ((i (model-row-at-point view (event-x event) (event-y event))))
                 (when (and i (model-branch-p model i)
                            (< (event-x event) (+ (x view) (style-value view :padding) (* 16 (1+ (model-depth model i))))))
                   (let ((key (model-key model i))) (set-tree-expanded model key (not (tree-expanded-p model key)))) t))) t)
         (t (call-next-method)))))
(defmethod dispose :after ((view model-list-view))
 (when (and (own-selection-p view) (view-selection view)) (dispose (view-selection view)))
 (setf (slot-value view 'model) nil (slot-value view 'selection) nil (row-label-function view) nil))

(defstruct (data-column (:constructor %make-data-column))
 "Shared immutable column/cell factory definition created by MAKE-DATA-COLUMN."
 id title getter formatter setter editor-factory cell-factory)
(defun make-data-column (&key id (title "") (getter #'identity) (formatter #'princ-to-string) setter editor-factory cell-factory)
 "Column ID/TITLE, GETTER(item), FORMATTER(value), optional SETTER(item,text), EDITOR-FACTORY(view,key,column,value), CELL-FACTORY(item,value)."
 (unless (and id (stringp title) getter formatter) (error "Columns require a non-NIL identity, string title, getter and formatter."))
 (%make-data-column :id id :title (copy-seq title) :getter getter :formatter formatter :setter setter
                    :editor-factory editor-factory :cell-factory cell-factory))
(defclass model-table-view (model-list-view)
 ((table-columns :initarg :table-columns :reader table-columns)
  (min-column-width :initarg :min-column-width :initform 0 :reader table-min-column-width)
  (horizontal-offset :initform 0 :accessor table-horizontal-offset)
  (active-column :initform 0 :accessor active-column)
  (edit-state :initform nil :accessor table-edit-state))
 (:documentation "Virtual equal-width columns with application cell factories and text-editor commit/cancel hooks."))
(defun model-table-column-width (view)
 (max (table-min-column-width view) (/ (width view) (length (table-columns view)))))
(defmethod model-header-height ((view model-table-view)) (row-height view))
(defun cell-editor (view) "The active cell entry widget, or NIL." (first (table-edit-state view)))
(defun cell-presentation (view index column-index)
 "Return a fresh (:TEXT string :FOREGROUND color :BACKGROUND color) cell description; factories return a string or this plist."
 (let* ((column (nth column-index (table-columns view))) (item (model-item (view-model view) index)))
   (unless column (error "Column index out of range."))
   (let* ((value (funcall (data-column-getter column) item))
          (result (if (data-column-cell-factory column) (funcall (data-column-cell-factory column) item value)
                      (funcall (data-column-formatter column) value))))
     (cond ((stringp result) (list :text (copy-seq result)))
           ((and (listp result) (evenp (length result)) (stringp (getf result :text)))
            (let ((copy (copy-tree result))) (setf (getf copy :text) (copy-seq (getf result :text))) copy))
           (t (error "Cell factories must return a string or a presentation plist with :TEXT."))))))
(defun layout-cell-editor (view)
 (when (cell-editor view)
   (destructuring-bind (editor key column old) (table-edit-state view)
     (declare (ignore old))
     (let ((index (and (view-model view) (model-index (view-model view) key)))
           (c (position column (table-columns view) :test #'eq)))
       (if (and index c)
           (let* ((cw (model-table-column-width view))
                  (py (- (+ (y view) (model-header-height view) (* index (row-height view))) (scroll-offset view))))
             (if (and (>= py (+ (y view) (model-header-height view))) (<= (+ py (row-height view)) (+ (y view) (height view))))
                 (layout editor (+ (x view) (* c cw) (- (table-horizontal-offset view))) py cw (row-height view))
                 (cancel-cell-edit view :viewport)))
           (cancel-cell-edit view :model-change))))))
(defun begin-cell-edit (view &optional (index (value view)) (column-index (active-column view)))
 "Create at most one entry editor. Returns editor, or NIL for an unselected/read-only cell. No database policy."
 (ensure-live view)
 (let ((column (nth column-index (table-columns view))))
   (unless (and index column (data-column-setter column)) (return-from begin-cell-edit nil))
   (check-model-index (view-model view) index)
   (cancel-cell-edit view :replace)
   (let* ((key (model-key (view-model view) index)) (item (model-item (view-model view) index))
          (old (funcall (data-column-getter column) item))
          (editor (if (data-column-editor-factory column)
                      (funcall (data-column-editor-factory column) view key column old)
                      (make-widget 'entry :text (funcall (data-column-formatter column) old)))))
     (unless (and (typep editor 'entry) (not (disposed-p editor)) (null (parent editor))) (error "Editor factories must return an unparented live entry."))
     (setf (active-column view) column-index)
     (reveal-model-index view index)
     (add-child view editor)
     (setf (table-edit-state view) (list editor key column old))
     (layout-cell-editor view)
     (when (cell-editor view)
       (when (typep (root-of view) 'window) (focus (root-of view) editor))
       (select-all editor)
       (emit view :cell-edit-start (list :key key :column (data-column-id column) :old-value old)))
     (cell-editor view))))
(defun close-cell-editor (view)
 (let ((editor (cell-editor view)) (root (root-of view)))
   (setf (table-edit-state view) nil)
   (when editor
     (let ((restore (and (typep root 'window) (eq editor (focused-widget root)))))
       (dispose editor)
       (when (and restore (not (disposed-p view)) (live-input-widget-p view root)) (focus root view))))))
(defun commit-cell-edit (view)
 "Call the column setter with original item and entry text, then notify model and emit :CELL-EDIT-COMMIT. Setter errors leave the editor open."
 (ensure-live view)
 (when (cell-editor view)
   (destructuring-bind (editor key column old) (table-edit-state view)
     (let* ((model (view-model view)) (index (and model (model-index model key))) (text (text editor))
            (source (loop for m = model then (projection-source m) while (typep m 'projection-model) finally (return m))))
       (unless index (cancel-cell-edit view :model-change) (return-from commit-cell-edit nil))
       (ensure-model-mutable model)
       (ensure-model-mutable source)
       (funcall (data-column-setter column) (model-item model index) text)
       (close-cell-editor view)
       (notify-model-change source)
       (emit view :cell-edit-commit (list :key key :column (data-column-id column) :old-value old :text text)) t))))
(defun cancel-cell-edit (view &optional (reason :cancel))
 "Dispose the editor without calling a setter. Emit :CELL-EDIT-CANCEL with key, column and reason."
 (when (cell-editor view)
   (let ((state (table-edit-state view)))
     (close-cell-editor view)
     (emit view :cell-edit-cancel (list :key (second state) :column (data-column-id (third state)) :reason reason)) t)))
(defmethod initialize-instance :after ((view model-table-view) &key)
 (unless (typep (table-min-column-width view) '(real 0 *)) (error "Minimum column width must be nonnegative."))
 (setf (slot-value view 'table-columns) (copy-list (table-columns view)))
 (on (view-model view) :model-change (lambda (m r) (declare (ignore m r)) (cancel-cell-edit view :model-change)) :owner view))
(defmethod validate-slot :before ((view model-table-view) slot value)
 (when (and (eq slot 'active-column) (not (and (integerp value) (<= 0 value) (< value (length (table-columns view))))))
   (error "Column index out of range.")))
(defmethod (setf active-column) :before (value (view model-table-view)) (validate-slot view 'active-column value))
(defmethod layout :after ((view model-table-view) x y width height)
 (declare (ignore x y height))
 (setf (table-horizontal-offset view)
       (max 0 (min (table-horizontal-offset view) (- (* (length (table-columns view)) (model-table-column-width view)) width))))
 (layout-cell-editor view))
(defmethod handle-event :around ((editor entry) event)
 ;; Factory-produced entry subclasses get the same commit/cancel keys as the
 ;; default editor without requiring an application subclass or key binding.
 (let ((table (parent editor)))
   (if (and (typep table 'model-table-view) (eq editor (cell-editor table)) (eq (event-kind event) :key))
       (case (event-key event) (:enter (commit-cell-edit table) t) (:escape (cancel-cell-edit table) t)
         (otherwise (call-next-method)))
       (call-next-method))))
(defmethod handle-event ((view model-table-view) event)
 (case (event-kind event)
   (:down
    (cancel-cell-edit view :selection)
    (when (contains-point-p view (event-x event) (event-y event))
      (setf (active-column view) (min (1- (length (table-columns view)))
        (floor (+ (- (event-x event) (x view)) (table-horizontal-offset view))
               (max 1 (model-table-column-width view))))))
    (call-next-method))
   (:wheel (cancel-cell-edit view :viewport)
     (if (event-shift-p event)
         (progn (scroll-to view (- (table-horizontal-offset view) (* 40 (event-delta event))) :axis :horizontal) t)
         (call-next-method)))
   (:key
    (case (event-key event)
      ((:left :right) (setf (active-column view) (max 0 (min (1- (length (table-columns view)))
        (+ (active-column view) (if (eq (event-key event) :left) -1 1)))))
       (let* ((cw (model-table-column-width view)) (left (* (active-column view) cw))
              (offset (table-horizontal-offset view)))
         (scroll-to view (cond ((< left offset) left)
                               ((> (+ left cw) (+ offset (width view))) (- (+ left cw) (width view)))
                               (t offset)) :axis :horizontal)) t)
      ((:enter :f2) (begin-cell-edit view) t)
      (:escape (cancel-cell-edit view) t)
      (otherwise (call-next-method))))
   (otherwise (call-next-method))))
(defmethod dispose :before ((view model-table-view)) (cancel-cell-edit view :dispose))
(defmethod dispose :after ((view model-table-view)) (setf (slot-value view 'table-columns) nil))
