(in-package #:lut)
;; Immutable AVL rope. Leaves own at most 1024 characters and local newline
;; offsets; branches aggregate length/newline count. Split/join copy paths only.
(defstruct (text-node (:constructor %text-node))
 left right string breaks (size 0) (lines 0) (depth 0))
(defun node-size (n) (if n (text-node-size n) 0))
(defun node-lines (n) (if n (text-node-lines n) 0))
(defun node-depth (n) (if n (text-node-depth n) 0))
(defun text-leaf (string)
 (unless (zerop (length string))
   (let ((breaks (coerce (loop for c across string for i from 0 when (char= c #\Newline) collect i) 'vector)))
     (%text-node :string string :breaks breaks :size (length string) :lines (length breaks) :depth 1))))
(defun text-branch (a b)
 (cond ((null a) b) ((null b) a)
       (t (%text-node :left a :right b :size (+ (node-size a) (node-size b))
                     :lines (+ (node-lines a) (node-lines b)) :depth (1+ (max (node-depth a) (node-depth b)))))))
(defun balance-text (a b)
 (cond
   ((> (node-depth a) (1+ (node-depth b)))
    (let ((l (text-node-left a)) (r (text-node-right a)))
      (if (>= (node-depth l) (node-depth r))
          (text-branch l (text-branch r b))
          (text-branch (text-branch l (text-node-left r)) (text-branch (text-node-right r) b)))))
   ((> (node-depth b) (1+ (node-depth a)))
    (let ((l (text-node-left b)) (r (text-node-right b)))
      (if (>= (node-depth r) (node-depth l))
          (text-branch (text-branch a l) r)
          (text-branch (text-branch a (text-node-left l)) (text-branch (text-node-right l) r)))))
   (t (text-branch a b))))
(defun join-text (a b)
 (cond ((null a) b) ((null b) a)
       ((> (node-depth a) (1+ (node-depth b)))
        (balance-text (text-node-left a) (join-text (text-node-right a) b)))
       ((> (node-depth b) (1+ (node-depth a)))
        (balance-text (join-text a (text-node-left b)) (text-node-right b)))
       (t (text-branch a b))))
(defun index-string (string &optional (start 0) (end (length string)))
 (let ((n (- end start)))
   (if (<= n 1024) (text-leaf (subseq string start end))
       (let ((mid (+ start (floor n 2))))
         (text-branch (index-string string start mid) (index-string string mid end))))))
(defun split-text (node position)
 (cond ((zerop position) (values nil node))
       ((= position (node-size node)) (values node nil))
       ((text-node-string node)
        (values (text-leaf (subseq (text-node-string node) 0 position))
                (text-leaf (subseq (text-node-string node) position))))
       (t (let ((left (text-node-left node)) (right (text-node-right node)))
            (if (< position (node-size left))
                (multiple-value-bind (a b) (split-text left position) (values a (join-text b right)))
                (multiple-value-bind (a b) (split-text right (- position (node-size left)))
                  (values (join-text left a) b)))))))
(defun replace-index-range (node start end replacement)
 (multiple-value-bind (a tail) (split-text node start)
   (multiple-value-bind (removed b) (split-text tail (- end start))
     (declare (ignore removed)) (join-text (join-text a (index-string replacement)) b))))
(defun index-substring (node start end)
 (let ((result (make-string (- end start))) (out 0))
   (labels ((visit (n base)
              (when (and n (< base end) (> (+ base (node-size n)) start))
                (if (text-node-string n)
                    (let* ((lo (max 0 (- start base))) (hi (min (node-size n) (- end base))))
                      (replace result (text-node-string n) :start1 out :start2 lo :end2 hi)
                      (incf out (- hi lo)))
                    (progn (visit (text-node-left n) base)
                           (visit (text-node-right n) (+ base (node-size (text-node-left n)))))))))
     (visit node 0)) result))
(defun index-newline (node ordinal)
 (if (text-node-string node) (aref (text-node-breaks node) ordinal)
     (let ((left (text-node-left node)))
       (if (< ordinal (node-lines left)) (index-newline left ordinal)
           (+ (node-size left) (index-newline (text-node-right node) (- ordinal (node-lines left))))))))
(defun index-position-line (node position)
 (cond ((null node) 0)
       ((text-node-string node)
        (let ((breaks (text-node-breaks node)) (lo 0) (hi (node-lines node)))
          (loop while (< lo hi) for mid = (floor (+ lo hi) 2)
                do (if (< (aref breaks mid) position) (setf lo (1+ mid)) (setf hi mid))) lo))
       ((<= position (node-size (text-node-left node))) (index-position-line (text-node-left node) position))
       (t (+ (node-lines (text-node-left node))
             (index-position-line (text-node-right node) (- position (node-size (text-node-left node))))))))
(defgeneric target-text-index (target)
 (:documentation "Return the immutable LUT index of a text source or view; external storage views may specialize."))
(defmethod target-text-index ((target t))
 (etypecase target
   (text-buffer (slot-value target 'text-root))
   (string (index-string target))
   (label
    (if (and (typep target 'entry) (view-buffer target)) (target-text-index (view-buffer target))
        (let ((string (text target)))
          (unless (eq string (slot-value target 'indexed-string))
            (setf (slot-value target 'indexed-string) string (slot-value target 'text-root) (index-string string)))
          (slot-value target 'text-root))))))
(defun text-length (target)
 "Character count of a string, label/view or buffer, without flattening shared storage."
 (if (stringp target) (length target) (node-size (target-text-index target))))
(defun text-range (target start &optional (end (text-length target)))
 "Copy the half-open character range [START,END); indexed queries never flatten the buffer."
 (unless (and (integerp start) (integerp end) (<= 0 start end (text-length target)))
   (error "Invalid text range."))
 (if (stringp target) (subseq target start end) (index-substring (target-text-index target) start end)))
(defun text-line-count (target)
 "Logical line count, including the empty final line after a newline; empty text has one line."
 (1+ (node-lines (target-text-index target))))
(defun text-line-range (target line)
 "Return START and END excluding newline for zero-based logical LINE; reject invalid lines."
 (let ((root (target-text-index target)))
   (unless (and (integerp line) (<= 0 line (node-lines root))) (error "Invalid text line."))
   (values (if (zerop line) 0 (1+ (index-newline root (1- line))))
           (if (= line (node-lines root)) (node-size root) (index-newline root line)))))
(defun text-position-line (target position)
 "Return the zero-based logical line containing character POSITION, including EOF."
 (unless (and (integerp position) (<= 0 position (text-length target))) (error "Invalid text position."))
 (index-position-line (target-text-index target) position))
