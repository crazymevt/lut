(in-package #:lut)
(defclass drag-session ()
 ((source :initarg :source :reader drag-source)
  (payload :initarg :payload :reader drag-payload)
  (target :initform nil :reader drag-target)
  (state :initform :pending :reader drag-state)
  (start-x :initarg :x) (start-y :initarg :y)
  (x :initarg :x :reader drag-x) (y :initarg :y :reader drag-y))
 (:documentation "One in-window drag. Source, payload and target are available during callbacks and cleared after completion."))
(defstruct notebook-tab source page)
(defun current-drag (window)
 "Return WINDOW's pending/active session, or NIL. Sessions do not cross native windows."
 (slot-value window 'drag-context))
(defgeneric drag-data (source event)
 (:documentation "On pointer down, return (values payload T) to arm a drag from SOURCE; NIL second value declines."))
(defmethod drag-data ((source widget) event) (declare (ignore event)) (values nil nil))
(defgeneric accepts-drop-p (target session event)
 (:documentation "Return true if TARGET accepts SESSION at EVENT. Called during movement and again before dropping; do not mutate the tree here."))
(defmethod accepts-drop-p ((target widget) session event) (declare (ignore session event)) nil)
(defgeneric perform-drop (target session event)
 (:documentation "Commit an accepted drop. Return true for success, NIL for rejection. :DROP is emitted after success."))
(defmethod perform-drop ((target widget) session event) (declare (ignore session event)) t)
(defgeneric render-drag-feedback (window)
 (:documentation "Draw the active drag preview after ordinary content. Override in rendering backends."))
(defmethod render-drag-feedback ((window widget)) nil)
(defun live-input-widget-p (widget window)
 (and widget (eq (root-of widget) window)
      (loop for w = widget then (parent w) while w
            always (and (not (disposed-p w)) (visible-p w) (enabled-p w)
                        (or (null (parent w))
                            (member w (active-children (parent w)))
                            (and (typep (parent w) 'window)
                                 (member w (slot-value (parent w) 'overlays))))))
      (loop for w = widget then (parent w) while w thereis (eq w (input-root window)))))
(defun begin-drag (source payload event)
 "Arm a drag from SOURCE using EVENT's start coordinates. Movement past :DRAG-THRESHOLD starts it; return the session."
 (let ((window (root-of source)))
   (unless (and (typep window 'window) (live-input-widget-p source window)
                (eq (event-kind event) :down))
     (error "A drag needs a live input source and a pointer-down event."))
   (cancel-drag window)
   (setf (slot-value window 'drag-context)
         (make-instance 'drag-session :source source :payload payload :x (event-x event) :y (event-y event)))))
(defun finish-drag (window session state)
 ;; Detach before callbacks: handlers may remove widgets or open another drag.
 (when (eq session (current-drag window)) (setf (slot-value window 'drag-context) nil))
 (let ((source (drag-source session)) (target (drag-target session))
       (active (eq (drag-state session) :dragging)))
   (setf (slot-value session 'state) state)
   (when active
     (let ((pressed (slot-value window 'pressed-widget)))
       (when pressed (setf (pressed-p pressed) nil)))
     (setf (slot-value window 'pressed-widget) nil))
   (unwind-protect
     (when active
       (unwind-protect (when target (emit target :drag-leave session))
         (when source (emit source :drag-end session))))
     (setf (slot-value session 'source) nil (slot-value session 'target) nil
           (slot-value session 'payload) nil))) t)
(defmethod cancel-drag ((window window))
 (let ((session (current-drag window)))
   (when session
     (let ((pressed (slot-value window 'pressed-widget)))
       (when pressed (setf (pressed-p pressed) nil)))
     (setf (slot-value window 'pressed-widget) nil)
     (finish-drag window session :cancelled))))
(defun within-subtree-p (widget subtree)
 (loop for w = widget then (parent w) while w thereis (eq w subtree)))
(defmethod cancel-subtree-drag ((window window) subtree)
 (let ((session (current-drag window)))
   (when (and session
              (or (within-subtree-p (drag-source session) subtree)
                  (within-subtree-p (drag-target session) subtree)
                  (let ((data (drag-payload session)))
                    (or (and (typep data 'widget) (within-subtree-p data subtree))
                        (and (notebook-tab-p data) (within-subtree-p (notebook-tab-page data) subtree))))))
     (cancel-drag window))))
(defun arm-pointer-drag (window event target)
 (unless (slot-value window 'interaction-state)
   (loop for source = target then (parent source) while source do
     (multiple-value-bind (payload offered) (drag-data source event)
       (when offered (begin-drag source payload event) (return))))))
(defun drag-drop-target (window session event)
 (loop for target = (hit-test (input-root window) (event-x event) (event-y event)) then (parent target)
       while target
       when (and (live-input-widget-p target window) (accepts-drop-p target session event)) return target))
(defun update-drag-target (window session event)
 (let ((target (drag-drop-target window session event)) (old (drag-target session)))
   (when (eq session (current-drag window))
     (unless (eq old target)
       (setf (slot-value session 'target) nil)
       (when old (emit old :drag-leave session))
       (when (and (eq session (current-drag window)) (live-input-widget-p target window))
         (setf (slot-value session 'target) target)
         (emit target :drag-enter session)))
     (when (and (eq session (current-drag window)) (drag-target session))
       (drag-target-motion (drag-target session) session event)
       (emit (drag-target session) :drag-over session)))))
(defun dispatch-drag (window event)
 "Handle a pending/active drag before normal input. Return true to consume EVENT."
 (let ((session (current-drag window)) (kind (event-kind event)))
   (when session
     (handler-case
       (cond
         ((or (not (live-input-widget-p (drag-source session) window))
              (and (eq kind :key) (eq (event-key event) :escape)))
          (cancel-drag window) t)
         ((member kind '(:move :up))
          (setf (slot-value session 'x) (event-x event) (slot-value session 'y) (event-y event))
          (when (and (eq kind :move) (eq (drag-state session) :pending)
                     (>= (+ (expt (- (drag-x session) (slot-value session 'start-x)) 2)
                            (expt (- (drag-y session) (slot-value session 'start-y)) 2))
                         (expt (style-value (drag-source session) :drag-threshold) 2)))
            (setf (slot-value session 'state) :dragging)
            (let ((pressed (slot-value window 'pressed-widget)))
              (when pressed (setf (pressed-p pressed) nil)))
            (setf (slot-value window 'pressed-widget) (drag-source session))
            (emit (drag-source session) :drag-start session))
          (cond
            ((not (eq session (current-drag window))) t)
            ((eq (drag-state session) :dragging)
             (update-drag-target window session event)
             (when (and (eq kind :up) (eq session (current-drag window)))
               (let ((target (drag-target session)) (state :rejected))
                 ;; Commit may reparent a widget. Avoid cancellation by ownership hooks.
                 (setf (slot-value window 'drag-context) nil)
                 (unwind-protect
                   (when (and (live-input-widget-p target window)
                              (accepts-drop-p target session event)
                              (perform-drop target session event))
                     (setf state :dropped (slot-value session 'state) :dropped)
                     (emit target :drop session))
                   ;; Keep :dragging until FINISH-DRAG can emit terminal events.
                   (setf (slot-value session 'state) :dragging)
                   (finish-drag window session state)))) t)
            ((eq kind :up) (finish-drag window session :cancelled) nil)))
         ((eq (drag-state session) :dragging) t))
       (error (condition)
         (when (member (drag-state session) '(:pending :dragging))
           (ignore-errors (finish-drag window session :cancelled)))
         (error condition))))))
(defun notebook-header-p (book event)
 (and (contains-point-p book (event-x event) (event-y event))
      (< (event-y event) (+ (y book) (style-value book :title-height)))))
(defun notebook-drop-index (book x)
 (multiple-value-bind (tab left) (tab-strip-geometry book)
   (if (zerop (length (children book))) 0
       (max 0 (min (length (children book))
                   (floor (+ 0.5 (/ (+ (- x left) (tab-offset book)) tab))))))))
(defmethod drag-data ((book notebook) event)
 (let ((index (tab-at-position book (event-x event) (event-y event))))
   (when (and (reorderable-p book) index)
     (values (make-notebook-tab :source book :page (nth index (children book))) t))))
(defgeneric drag-target-motion (target session event))
(defmethod drag-target-motion ((target widget) session event) (declare (ignore session event)) nil)
(defmethod drag-target-motion ((book notebook) session event)
 (when (and (notebook-tab-p (drag-payload session)) (eq (event-kind event) :move))
   (multiple-value-bind (tab left viewport button) (tab-strip-geometry book)
     (declare (ignore tab))
     (when (plusp button)
       (let ((step (/ (style-value book :tab-scroll-step) 8)) (edge (min 14 (/ viewport 3))))
         (cond ((< (event-x event) (+ left edge)) (scroll-tabs book (- step)))
               ((>= (event-x event) (- (+ left viewport) edge)) (scroll-tabs book step))))))))
(defmethod accepts-drop-p ((book notebook) session event)
 (let ((data (drag-payload session)))
   (and (notebook-tab-p data) (reorderable-p book) (tab-strip-position-p book (event-x event) (event-y event))
        (reorderable-p (notebook-tab-source data))
        (eq (parent (notebook-tab-page data)) (notebook-tab-source data))
        (not (within-subtree-p book (notebook-tab-page data)))
        (or (eq book (notebook-tab-source data))
            (and (tab-group book) (equal (tab-group book) (tab-group (notebook-tab-source data))))))))
(defun notebook-titles (book)
 (loop for page in (children book) for i from 0 collect
   (or (nth i (items book)) (and (typep page 'label) (text page)) "Page")))
(defun insert-at (list value index)
 (append (subseq list 0 index) (list value) (nthcdr index list)))
(defun move-page (source page target index)
 "Move PAGE from SOURCE notebook to TARGET at insertion boundary INDEX (0..target count), preserving caption and selecting PAGE. Same-window only."
 (ensure-live source) (ensure-live page) (ensure-live target)
 (unless (and (typep source 'notebook) (typep target 'notebook) (eq (parent page) source)
              (typep index '(integer 0 *)) (<= index (length (children target)))
              (eq (root-of source) (root-of target)) (not (within-subtree-p target page)))
   (error "Invalid notebook page transfer."))
 (let* ((old-index (position page (children source)))
        (source-titles (notebook-titles source)) (title (nth old-index source-titles))
        (selected (nth (value source) (children source)))
        (root (root-of source)) (focused (and (typep root 'window) (focused-widget root)))
        (destination (if (and (eq source target) (> index old-index)) (1- index) index)))
   (remove-child source page)
   (setf (items source) (append (subseq source-titles 0 old-index) (nthcdr (1+ old-index) source-titles)))
   (let ((titles (notebook-titles target)))
     (add-child target page)
     (setf (children target) (insert-at (remove page (children target)) page destination)
           (items target) (insert-at titles title destination)))
   (unless (eq source target)
     (setf (value source) (or (position selected (children source))
                             (max 0 (min old-index (1- (length (children source)))))))
     (emit source :change (value source)))
   (select-page target destination)
   (when (and focused (within-subtree-p focused page) (typep root 'window)
              (live-input-widget-p focused root)) (focus root focused))
   (let ((change (list :page page :source source :target target :old-index old-index :index destination)))
     (emit source :pages-changed change)
     (unless (eq source target) (emit target :pages-changed change))) page))
(defmethod perform-drop ((book notebook) session event)
 (let ((data (drag-payload session)))
   (if (notebook-tab-p data)
       (progn (move-page (notebook-tab-source data) (notebook-tab-page data) book
                         (notebook-drop-index book (event-x event))) t)
       (call-next-method))))
