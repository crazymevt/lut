        (size (max 0 (min (style-value w :font-size) (- (height w) (* 2 pad))
                          (- (width w) (* 2 pad)))))
        (ix (- (+ (x w) (width w)) size pad))
        (iy (+ (y w) (/ (- (height w) size) 2))))
   (paint-caption w (+ size pad) :left)
   (paint-rounded w ix iy size size 0.25 (style-value w :border-color))
   (paint-rounded w (+ ix 2) (+ iy 2) (- size 4) (- size 4) 0.25
     (if (value w) (indicator-color w) (surface-color w)))
   (when (and (value w) (>= size 12))
     (let ((color (style-value w :on-accent)))
       (rl:draw-line-ex (rl:vec2 (+ ix (* size 0.22)) (+ iy (* size 0.5)))
         (rl:vec2 (+ ix (* size 0.43)) (+ iy (* size 0.72))) 2 color)
       (rl:draw-line-ex (rl:vec2 (+ ix (* size 0.43)) (+ iy (* size 0.72)))
         (rl:vec2 (+ ix (* size 0.8)) (+ iy (* size 0.28))) 2 color)))))
(defun selected-toggle-color (w)
 "Blend selected surfaces toward the themed interaction color."
 (let ((base (indicator-color w)) (state (widget-state w)))
   (if (member state '(:hover :pressed))
       (let ((overlay (style-value w (if (eq state :pressed) :pressed-color :hover-color)))
             (amount (if (eq state :pressed) 0.35 0.18)))
         (mapcar (lambda (a b) (round (+ (* a (- 1 amount)) (* b amount)))) base overlay))
       base)))
(defmethod render ((w toggle-button))
 (paint-button-surface w (if (value w) (selected-toggle-color w) (surface-color w)))
 (paint-caption w 0 :center (when (value w) (style-value w :on-accent))
   (button-caption-offset w)))
(defmethod render ((w switch))
 (let* ((pad (min (style-value w :padding) (/ (height w) 4) (/ (width w) 4)))
        (h (max 0 (min 22 (- (height w) (* 2 pad)) (/ (- (width w) (* 2 pad)) 2))))
        (tw (* 2 h)) (tx (- (+ (x w) (width w)) pad tw))
        (ty (+ (y w) (/ (- (height w) h) 2))))
   (paint-caption w (+ tw pad) :left)
   (paint-rounded w tx ty tw h 1 (if (value w) (indicator-color w) (style-value w :border-color)))
   (paint-rounded w (+ tx 3 (if (value w) h 0)) (+ ty 3) (- h 6) (- h 6) 1
     (style-value w :on-accent))))
(defmethod render ((w radio-button))
 (let* ((pad (min (style-value w :padding) (/ (height w) 4) (/ (width w) 4)))
        (size (max 0 (min 20 (- (height w) (* 2 pad)) (- (width w) (* 2 pad)))))
        (ix (- (+ (x w) (width w)) size pad)) (iy (+ (y w) (/ (- (height w) size) 2))))
   (paint-caption w (+ size pad) :left)
   (paint-rounded w ix iy size size 1 (style-value w :border-color))
   (paint-rounded w (+ ix 2) (+ iy 2) (- size 4) (- size 4) 1 (surface-color w))
   (when (value w)
     (paint-rounded w (+ ix 5) (+ iy 5) (- size 10) (- size 10) 1 (indicator-color w)))))
(defmethod render ((w slider))
 (let* ((h (min 6 (height w))) (ty (+ (y w) (/ (- (height w) h) 2)))
        (fraction (range-fraction w))
        (diameter (max 0 (min 18 (height w) (width w))))
        (cx (+ (x w) (* (width w) fraction))))
   (paint-rounded w (x w) ty (width w) h 1 (style-value w :border-color))
   (paint-rounded w (x w) ty (* (width w) fraction) h 1 (indicator-color w))
   (paint-rounded w (max (x w) (min (- (+ (x w) (width w)) diameter) (- cx (/ diameter 2))))
     (+ (y w) (/ (- (height w) diameter) 2)) diameter diameter 1 (indicator-color w))))
(defmethod render ((w progress-bar))
 (let ((h (min 6 (height w))) (fraction (range-fraction w)))
   (with-drawing-clip ((x w) (y w) (width w) (height w))
     (paint-rounded w (x w) (+ (y w) (/ (- (height w) h) 2)) (width w) h 1 (style-value w :border-color))
     (when (plusp fraction)
       (paint-rounded w (x w) (+ (y w) (/ (- (height w) h) 2)) (* (width w) fraction) h 1 (indicator-color w))))))
(defun paint-row-state (w index py)
 (cond ((eql index (value w)) (paint-row-selection w py))
       ((and (eql index (hovered-row w)) (not (eq (widget-state w) :disabled)))
        (paint-row-selection w py (style-value w (if (eq (widget-state w) :pressed) :pressed-color :hover-color))))))
(defun paint-vertical-scrollbar (w)
 (when (and (not (typep (parent w) 'scroll-container)) (plusp (scrollbar-range w)))
   (multiple-value-bind (sx sy sw sh travel) (scrollbar-bounds w)
     (declare (ignore travel))
     (paint-rounded w sx (y w) sw (height w) 1 (style-value w :surface))
     (paint-rounded w sx sy sw sh 1 (style-value w :border-color)))))
(defmethod render ((w list-view))
 (paint-list-surface w)
 (flet ((rows ()
          (loop for item in (items w) for i from 0
                for py = (- (+ (y w) (* i (row-height w))) (scroll-offset w))
                do (paint-row-state w i py)
                   (draw-string w item (+ (x w) (style-value w :padding)) (row-text-y w py)
                     (when (eql i (value w)) (style-value w :on-accent))))))
   (if (and (scrollbar-view-p w) (plusp (scrollbar-range w)))
       (multiple-value-bind (sx sy sw sh travel) (scrollbar-bounds w)
         (declare (ignore sy sw sh travel))
         (let ((clip (intersect-rectangles *clip* (list (x w) (y w) (max 0 (- sx (x w))) (height w)))))
           (with-ui-scissor ((first clip) (second clip) (third clip) (fourth clip)) (rows))
           (apply #'begin-ui-scissor *clip*))
         (paint-vertical-scrollbar w))
       (rows))))
(defmethod render ((w drawing-area)) (when (draw-function w) (funcall (draw-function w) w)))
(defmethod render ((w scroll-view)) (paint-vertical-scrollbar w))
(defmethod render ((w dialog))
 (paint-surface w (style-value w :background))
 (unless (or (native-p w) (typep w 'popover) (typep w 'context-menu))
   (draw-string w (text w) (+ (x w) (style-value w :padding)) (y w))))
(defmethod render ((book vertical-notebook))
 (let* ((strip (vertical-tab-width book))
        (clip (intersect-rectangles *clip* (list (x book) (y book) strip (height book)))))
   (with-ui-scissor ((first clip) (second clip) (third clip) (fourth clip))
     (rl:draw-rectangle (x book) (y book) strip (height book) (style-value book :surface))
     (loop for page in (children book) for i from 0
           for top = (+ (y book) (* i (row-height book)) (- (tab-offset book)))
           when (and (< top (+ (y book) (height book))) (> (+ top (row-height book)) (y book))) do
             (cond ((= i (value book))
                    (rl:draw-rectangle (x book) top strip (row-height book) (style-value book :accent)))
                   ((and (hovered-p book) (eql i (hovered-row book)))
                    (rl:draw-rectangle (x book) top strip (row-height book) (style-value book :hover-color))))
             (draw-string book (fit-caption book (or (nth i (items book)) "Page")
                                 (max 0 (- strip (* 2 (style-value book :padding)))))
                          (+ (x book) (style-value book :padding))
                          (+ top (max 0 (/ (- (row-height book) (style-value book :font-size)) 2)))
                          (when (= i (value book)) (style-value book :on-accent)))))))

(defmethod render ((w notebook))
 (multiple-value-bind (nominal left viewport button) (tab-strip-geometry w)
   (declare (ignore nominal))
   (let ((clip (intersect-rectangles *clip* (list left (y w) viewport (style-value w :title-height)))))
     (with-ui-scissor ((first clip) (second clip) (third clip) (fourth clip))
       (loop with px = (+ left (- (tab-offset w)))
             with text-y = (+ (y w) (max 0 (/ (- (style-value w :title-height) (style-value w :font-size)) 2)))
             for page in (children w) for tab in (tab-widths w) for i from 0 do
         (when (and (< px (+ left viewport)) (> (+ px tab) left))
           (rl:draw-rectangle px (y w) tab (style-value w :title-height)
             (style-value w (cond ((= i (value w)) :accent)
                                  ((and (hovered-p w) (eql i (hovered-row w))) :hover-color)
                                  (t :surface))))
           (draw-string w (fit-caption w (tab-caption w i)
                                      (max 0 (- tab (* 2 (style-value w :padding)) (tab-action-width w i)
                                        (if (closable-p w) (style-value w :title-height) 0))))
                          (+ px (style-value w :padding)) text-y
                          (when (= i (value w)) (style-value w :on-accent)))
           (when (closable-p w)
             ;; Geometry keeps the close mark visible with every caption font.
             (let* ((cell (min tab (style-value w :title-height)))
                    (cx (- (+ px tab) (/ cell 2)))
                    (cy (+ (y w) (/ (style-value w :title-height) 2)))
                    (radius (min 4 (/ cell 5)))
                    (color (style-value w (if (= i (value w)) :on-accent :foreground))))
               (rl:draw-line-ex (rl:vec2 (- cx radius) (- cy radius)) (rl:vec2 (+ cx radius) (+ cy radius)) 1.5 color)
               (rl:draw-line-ex (rl:vec2 (- cx radius) (+ cy radius)) (rl:vec2 (+ cx radius) (- cy radius)) 1.5 color))))
         (incf px tab))))
   (begin-ui-scissor (first *clip*) (second *clip*)
                         (third *clip*) (fourth *clip*))
   (when (plusp button)
     (dolist (right '(nil t))
       (let* ((px (if right (+ left viewport) (x w)))
              (enabled (if right (< (tab-offset w) (tab-scroll-limit w)) (plusp (tab-offset w)))))
         (rl:draw-rectangle px (y w) button (style-value w :title-height) (style-value w :surface))
         (draw-string w (if right ">" "<") (+ px (/ button 3)) (y w)
                      (style-value w (if enabled :foreground :disabled-color))))))))
(defmethod render-drag-feedback ((window window))
 (let ((session (visible-drag window)))
   (when (and session (eq (drag-state session) :dragging))
     (let ((target (drag-target session)) (source (drag-source session)))
       (when target
         (let ((clip (list 0 0 (width window) (height window))))
           (loop for node = target then (parent node) while node do
             (setf clip (intersect-rectangles clip (list (x node) (y node) (width node) (height node)))))
           (with-ui-scissor ((first clip) (second clip)
                                  (third clip) (fourth clip))
             (rl:draw-rectangle-rounded-lines-ex
               (rl:rect (x target) (y target) (width target) (height target))
               (resolved-roundness target) 12 2 (style-value target :focus-color))
             (when (and (typep target 'notebook) (notebook-tab-p (drag-payload session)))
               (let ((px (tab-insertion-position target (notebook-drop-index target (drag-x session)))))
                 (rl:draw-rectangle px (y target) 2 (style-value target :title-height)
                                    (style-value target :focus-color)))))))
       ;; A small pointer marker remains visible even over a rejected target.
       (rl:draw-circle (drag-x session) (drag-y session) 4
                      (style-value source (if target :accent :disabled-color)))))))
(defmethod render ((w expander))
 (draw-string w (concatenate 'string (if (value w) "- " "+ ") (text w)) (x w) (y w)))
(defmethod render ((w tree-view)) (refresh-items w) (call-next-method))
(defmethod render ((w table-view))
 (paint-list-surface w)
 (let ((cw (/ (width w) (max 1 (length (columns w))))) (rh (row-height w)))
   (loop for title in (columns w) for c from 0 do
     (draw-string w title (+ (x w) (* c cw) (style-value w :padding)) (row-text-y w (y w))))
   (loop for row in (rows w) for i from 0 for py = (- (+ (y w) rh (* i rh)) (scroll-offset w))
         when (>= py (+ (y w) rh)) do
           (paint-row-state w i py)
           (loop for cell in row for c from 0 do
             (draw-string w (princ-to-string cell) (+ (x w) (* c cw) (style-value w :padding)) (row-text-y w py)
               (when (eql i (value w)) (style-value w :on-accent)))))))
(defun fit-caption (w string available)
 "Find a fitting prefix with logarithmically many measurements."
 (cond ((<= (text-width w string) available) string)
       ((> (text-width w "...") available) "")
       (t (let ((lo 0) (hi (length string)))
            (loop while (< lo hi) for mid = (ceiling (+ lo hi) 2)
                  do (if (<= (text-width w (concatenate 'string (subseq string 0 mid) "...")) available)
                         (setf lo mid) (setf hi (1- mid))))
            (concatenate 'string (subseq string 0 lo) "...")))))
(defun paint-selection-indicator (w)
 (let* ((sx (selection-button-x w)) (sw (selection-button-width w))
        (cx (+ sx (/ sw 2))) (cy (+ (y w) (/ (height w) 2)))
        (pad (min 8 (/ (height w) 4))))
   (when (and (>= sw 16) (>= (height w) 12))
     (rl:draw-line-ex (rl:vec2 sx (+ (y w) pad))
       (rl:vec2 sx (- (+ (y w) (height w)) pad)) 1 (style-value w :border-color))
     (let ((direction (if (expanded-p w) -1 1)) (color (style-value w :foreground)))
       (rl:draw-line-ex (rl:vec2 (- cx 4) (- cy (* direction 2)))
         (rl:vec2 cx (+ cy (* direction 2))) 2 color)
       (rl:draw-line-ex (rl:vec2 cx (+ cy (* direction 2)))
         (rl:vec2 (+ cx 4) (- cy (* direction 2))) 2 color)))))
(defmethod render ((w dropdown))
 (paint-button-surface w)
 (let* ((pad (style-value w :padding))
        (available (max 0 (- (width w) (* 2 pad) (selection-button-width w))))
        (caption (or (and (value w) (nth (value w) (items w))) "Choose...")))
   (draw-string w (fit-caption w caption available) (+ (x w) pad)
     (+ (y w) (max 0 (/ (- (height w) (style-value w :font-size)) 2)))))
 (paint-selection-indicator w))
(defmethod render ((w combo-box))
 (paint-surface w)
 (paint-rounded w (selection-button-x w) (y w) (selection-button-width w) (height w)
   (style-value w :border-radius)
   (style-value w (if (eq (widget-state w) :disabled) :disabled-color :hover-color)))
 (let ((clip (intersect-rectangles *clip* (list (x w) (y w)
                     (max 0 (- (width w) (selection-button-width w))) (height w)))))
   (with-ui-scissor ((first clip) (second clip) (third clip) (fourth clip))
     (paint-text w)))
 ;; Nested raylib scissor scopes disable clipping on exit; restore the widget
 ;; clip before painting its indicator and the outer method's focus outline.
 (begin-ui-scissor (first *clip*) (second *clip*)
   (third *clip*) (fourth *clip*))
 (paint-selection-indicator w))
(defmethod render ((w image))
 (when (source w)
   (let* ((key (list (namestring (pathname (source w))) (file-write-date (source w))))
          (texture (or (cdr (assoc key *texture-cache* :test #'equal))
                       (let ((tex (rl:load-texture (source w))))
                         (unless (rl:is-texture-valid tex) (error "Could not load image ~a" (source w)))
                         (push (cons key tex) *texture-cache*) tex)))
          (scale (min (or (max-image-scale w) most-positive-single-float)
                      (/ (width w) (rl:texture-width texture)) (/ (height w) (rl:texture-height texture)))))
     (pushnew texture *used-textures* :test #'eq)
     (rl:draw-texture-ex texture (rl:vec2 (x w) (y w)) 0 scale :white))))
(defvar *event-sink* nil)
(defun poll-input (w)
 ;; Clicking the owner's title bar can focus it without a content mouse event.
 (when (rl:is-window-focused)
   (let ((blocker (modal-blocker w))) (when blocker (focus-modal blocker))))
 (let ((mx (/ (rl:get-mouse-x) (ui-scale w))) (my (/ (rl:get-mouse-y) (ui-scale w)))
       (shift (or (rl:is-key-down :left-shift) (rl:is-key-down :right-shift)))
       (control (or (rl:is-key-down :left-control) (rl:is-key-down :right-control)))
       (alt (or (rl:is-key-down :left-alt) (rl:is-key-down :right-alt)))
       (super (or (rl:is-key-down :left-super) (rl:is-key-down :right-super))))
   (flet ((send (kind &key key (base-key key) (text "") (delta 0) drop-data)
            (let ((event (make-event :kind kind :drop-data drop-data :x mx :y my :key key :base-key base-key :text text :delta delta
                                    :shift-p shift :control-p control :alt-p alt :super-p super
                                    :timestamp (/ (get-internal-real-time) internal-time-units-per-second))))
              (if *event-sink* (funcall *event-sink* event) (dispatch w event)))))
     (when (rl:is-file-dropped)
       (let ((files (rl:load-dropped-files)))
         (unwind-protect
           (send :os-drop :drop-data
             (loop for i below (rl:file-path-list-count files) collect
               (cffi:foreign-string-to-lisp (cffi:mem-aref (rl:file-path-list-paths files) :pointer i)
                                            :encoding :utf-8)))
           (rl:unload-dropped-files files))))
     (when (rl:is-mouse-button-pressed :left) (send :down))
     (let ((pointer (list mx my shift control alt super (layout-revision w))))
       (when (or (not (equal pointer *last-polled-pointer*))
                 (slot-value w 'pressed-widget) (slot-value w 'drag-context)
                 (some (lambda (overlay) (and (typep overlay 'context-menu) (hover-pending overlay)))
                       (slot-value w 'overlays)))
         (setf *last-polled-pointer* pointer)
         (send :move)))
     (when (rl:is-mouse-button-released :left) (send :up))
     (when (rl:is-mouse-button-pressed :right) (send :context))
     (let ((gesture (rl:enum-keyword 'rl:gesture (rl:get-gesture-detected))))
      (when (and gesture (not (eq gesture :none)))
       (send :gesture :key gesture :delta
        (case gesture (:hold (rl:get-gesture-hold-duration))
         ((:pinch-in :pinch-out) (rl:get-gesture-pinch-angle)) (t 0)))))
     (let ((wheel (rl:get-mouse-wheel-move))) (unless (zerop wheel) (send :wheel :delta wheel)))
     (dolist (key '(:tab :left :right :up :down :home :end :backspace :delete :enter :space :escape))
       (when (or (rl:is-key-pressed key) (rl:is-key-pressed-repeat key)) (send :key :key key)))
     (let ((control (or control super))
           (field (focused-widget w)))
       (when (and control (or (typep field 'entry) (typep field 'cell-grid)
                              (and field (key-capture field)) *event-sink*))
         (when (rl:is-key-pressed :a) (send :key :key :select-all :base-key :a))
         (when (rl:is-key-pressed :z) (send :key :key (if shift :redo :undo) :base-key :z))
         (when (rl:is-key-pressed :y) (send :key :key :redo :base-key :y))
         (when (rl:is-key-pressed :c) (send :key :key :copy :base-key :c))
         (when (rl:is-key-pressed :x) (send :key :key :cut :base-key :x))
         (when (rl:is-key-pressed :v) (send :key :key :paste :base-key :v)))
       (loop for code = (rl:get-key-pressed) until (zerop code)
             for key = (ignore-errors (rl:enum-keyword 'rl:keyboard-key code))
             when (and key (not (member key '(:tab :left :right :up :down :home :end :backspace :delete :enter :space :escape)))
                       (not (and control (member key '(:a :c :x :v :z :y)))))
             do (send :key :base-key key :key (if control
                  (intern (concatenate 'string (if shift "CONTROL-SHIFT-" "CONTROL-") (symbol-name key)) :keyword) key)))
       (loop for code = (rl:get-char-pressed) until (zerop code)
             for char = (code-char code)
             when (and char (not control)) do (send :text :text (string char)))))))
(defun frame-step (w dt)
 "One frame, called by name so redefinition takes effect immediately."
 ;; The binding's paused error screen owns event polling while paused. Restore
 ;; manual dispatch on resume, without changing RUN/START's public error policy.
 (handler-bind ((error (lambda (condition) (declare (ignore condition))
                        (when (and *event-backend-p* (not *signal-run-errors*) (not *frame-limit-p*))
                          (native-event-call "LUTSetManualEvents" 0)
                          (setf *manual-event-dispatch* nil)))))
 (when (and *event-backend-p* (not *manual-event-dispatch*))
   (native-event-call "LUTSetManualEvents" 1) (setf *manual-event-dispatch* t))
 (let ((frame-start (rl:get-time)) (*font-file-stamps* (make-hash-table :test #'equal)))
 (when *last-controller-time* (setf dt (max 0 (- frame-start *last-controller-time*))))
 (setf *last-controller-time* frame-start *controller-frame-dt* dt)
 (setf *used-fonts* nil *used-textures* nil)
 (incf *controller-turns*)
 (let ((focus (rl:is-window-focused)))
   (unless (eq focus *last-native-focus*)
     (unless (eq *last-native-focus* :unknown) (incf *native-focus-changes*))
     (setf *last-native-focus* focus)))
 (drain-ui-queue)
 (run-ui-deadlines)
 (when *event-backend-p*
   (setf *native-damage-p* (plusp (native-event-call "LUTConsumeDamage")))
   (when *native-damage-p* (incf *native-exposes*)))
 (when (fboundp 'open-pending-dialogs) (open-pending-dialogs w))
 (unless (equal *native-title* (text w))
   (rl:set-window-title (text w)) (setf *native-title* (text w)))
 (when (fboundp 'pump-remote-windows) (pump-remote-windows))
 (sync-native-window-state w)
 (emit w :tick dt)
 (when (disposed-p w) (return-from frame-step nil))
 (unless *event-backend-p* (refresh-platform-integration w))
 (layout-window-if-needed w (/ (rl:get-screen-width) (ui-scale w)) (/ (rl:get-screen-height) (ui-scale w)))
 (unless (rl:is-window-focused) (cancel-text-selection w :forget-clicks t))
 (poll-input w)
 (let ((key (list (rl:get-mouse-x) (rl:get-mouse-y) (focused-widget w) (layout-revision w))))
   (when (or (not *event-backend-p*) (not (equal key *controller-pointer-key*)))
     (update-native-cursor (window-pointer-cursor w
       (/ (rl:get-mouse-x) (ui-scale w)) (/ (rl:get-mouse-y) (ui-scale w))))
     (setf *controller-pointer-key* key)))
 (advance-text-selection w dt)
 (advance-drag w dt)
 (when (or (not *event-backend-p*)
           (not (equal (controller-cache-key w) *controller-cache-key*))
           (legacy-tick-delay w) (window-has-dynamic-content-p w))
   (prepare-window-cache w)
   (setf *controller-cache-key* (controller-cache-key w)))
 (if (window-needs-present-p w)
     (progn
       (rl:with-drawing ((style-value w :background))
         (let ((*composite-window-cache* (render-identity w))) (render-window w)))
       (note-window-presented w))
     (unless *event-backend-p*
       ;; Service queued UI work/timers at the normal cadence, but do not redraw
       ;; or swap unchanged buffers. Sleep yields the CPU rather than busy-waiting.
       (sleep (max 0 (- *idle-poll-interval* (- (rl:get-time) frame-start))))
       (rl:poll-input-events)))
 (sweep-native-resources)
 (when *event-backend-p* (controller-wait w)))))
(defun render-window (w)
 ;; Input and command refresh can change content after layout: use a fresh pass.
 (let ((*font-discovery-pass* (make-hash-table :test #'eq)))
 (refresh-platform-integration w)
 (update-anchored-surfaces w)
 (refresh-commands w)
 (when (and (eql *composite-window-cache* (render-identity w)) (draw-window-cache w))
   (return-from render-window w))
 (let ((*render-ui-scale* (ui-scale w)))
 (rl:with-mode-2d ((rl:make-camera-2d :zoom (coerce (* *render-ui-scale* (backing-pixel-scale)) 'single-float)))
 (render w)
 (dolist (d (reverse (slot-value w 'overlays))) (render d))
 (render-drag-feedback w)))))
(defvar *signal-run-errors* nil
 "Internal synchronous START policy; direct RUN and asynchronous START retain their pause behavior.")
(defmethod run ((w window) &key frames)
 "Run on OS main thread. Loop exit closes secondary workers and releases library-owned references."
 (ensure-live w)
 (when *active-window* (return-from run (spawn-window w)))
 (with-native-logging
 (let ((*active-window* w) (*native-title* nil) (*native-cursor* nil) (*font-cache* nil) (*texture-cache* nil)
       (*window-tile-caches* (make-hash-table))
       (*font-stamp-cache* (make-hash-table :test #'equal))
       (*last-polled-pointer* nil)
       (*event-backend-p* (native-event-backend-p)) (*native-damage-p* t)
       (*controller-cache-key* nil) (*controller-pointer-key* nil)
       (*frame-limit-p* frames) (*controller-turns* 0) (*native-waits* 0)
       (*native-focus-changes* 0) (*native-exposes* 0) (*last-native-focus* :unknown)
       (*manual-event-dispatch* nil)
       (*last-controller-time* nil) (*controller-frame-dt* 0)
       (*used-fonts* nil) (*used-textures* nil) (*retired-targets* nil) (count 0))
   (unless *event-backend-p*
     (format *error-output* "~&LUT: polling compatibility backend. Build with make event-backend-build in LUT for native event waiting.~%"))
   (setf *controller-running-p* t *primary-window* w)
   (unwind-protect
     (rl:with-window ((round (* (nth-value 0 (normal-window-size w)) (ui-scale w))) (round (* (nth-value 1 (normal-window-size w)) (ui-scale w))) (text w)
                     :flags (append '(:window-resizable :window-highdpi :vsync-hint)
                                    (unless (initial-focus-p w) '(:window-unfocused))) :exit-key :null)
       #+darwin (install-cocoa-titlebar-zoom)
       (when *event-backend-p*
         (native-event-call "LUTSetManualEvents" 1) (setf *manual-event-dispatch* t)
         (install-ui-wake (lambda () (cffi:foreign-funcall "LUTWakeEvents" :void))))
       (unwind-protect
         (progn
         (emit w :context-open)
         (if (close-request-handler w)
             ;; Raylib's GAME-LOOP closes before calling the frame function.
             ;; Keep its stop flag, but let the application veto OS close.
             (progn
               (unless (or frames *signal-run-errors*)
                 (error "A close-request handler requires synchronous START or FRAMES."))
               (setf rl::*stop-requested* nil)
               (loop until (or rl::*stop-requested*
                               (and (rl:window-should-close)
                                    (funcall (close-request-handler w) w)))
                     do (frame-step w (rl:get-frame-time))
                        (when (and frames (>= (incf count) frames)) (rl:stop))))
             (rl:game-loop (dt :on-error (if (or frames *signal-run-errors*) :signal :pause))
               (frame-step w dt)
               (when (and frames (>= (incf count) frames)) (rl:stop)))))
         (when *event-backend-p*
           (install-ui-wake nil) (native-event-call "LUTSetManualEvents" 0))
         (unwind-protect (progn (cancel-drag w) (emit w :context-close))
         (unwind-protect (release-platform-context w)
         (when (fboundp 'shutdown-native-windows) (shutdown-native-windows))
         (release-all-window-caches)
         (flush-retired-targets)
         (mapc (lambda (pair) (rl:unload-font (cdr pair))) *font-cache*)
         (mapc (lambda (pair) (rl:unload-texture (cdr pair))) *texture-cache*)))))
     (setf *controller-running-p* nil *primary-window* nil *window* nil rl:*last-error* nil)
     (cancel-all-ui-jobs) (clear-ui-deadlines)))))
(defun start (window &key frames wait)
 "Launch on the OS main thread; subsequent starts create native workers inheriting the prior root's app styles.
WAIT waits for a primary launch and re-signals its errors on the caller after native cleanup, instead of pausing the loop. Asynchronous launches keep the runner's error handling. Worker launches return a handle immediately, even with WAIT."
 (let ((source *window*))
   (setf *window* window)
   (if (or *active-window* (rl:running-p)) (spawn-window window :style-source source)
       (if wait
           (let ((failure nil))
             (let ((result
                     (rl:run (lambda ()
                               (let ((*signal-run-errors* t))
                                 ;; Capture inside the binding runner, which otherwise
                                 ;; records and swallows errors. Cleanup finishes before
                                 ;; this handler transfers the original condition.
                                 (handler-case (run window :frames frames)
                                   (error (condition) (setf failure condition))))) :wait t)))
               (when failure (error failure)) result))
           (rl:run (lambda () (run window :frames frames)) :wait nil)))))
(defun stop () "Request stop and wake a sleeping native loop." (prog1 (rl:stop) (wake-ui)))
(defmethod clipboard-text :around ((w widget))
 (if (rl:is-window-ready) (rl:get-clipboard-text) (call-next-method)))
(defmethod (setf clipboard-text) :around (string (w widget))
 (if (rl:is-window-ready) (progn (rl:set-clipboard-text string) string) (call-next-method)))
#+(and ccl darwin)
(defmethod run :around ((w window) &key frames)
 (declare (ignore frames))
 ;; CCL's listener is not Cocoa's OS main thread. The bindings only bridge SBCL.
 (if (eq ccl:*current-process* ccl::*initial-process*) (call-next-method)
     (let ((signal-errors *signal-run-errors*) failure result)
       (ccl::call-in-initial-process
         (lambda ()
           ;; Special bindings do not cross CCL process boundaries. Preserve the
           ;; synchronous launcher policy when bridging onto Cocoa's thread.
           (let ((*signal-run-errors* signal-errors))
             (handler-case (setf result (call-next-method)) (error (e) (setf failure e))))))
       (when failure (error failure)) result)))

(defun trim-retained-resources (cache used limit release)
 ;; Keep warm atlases across cached frames; only evict cold entries over a bound.
 (if (<= (length cache) limit) cache
     (let ((count 0))
       (delete-if (lambda (entry)
                    (if (or (< count limit) (member (cdr entry) used :test #'eq))
                        (progn (incf count) nil)
                        (progn (funcall release (cdr entry)) t))) cache))))
(defun sweep-native-resources ()
 "Release stale resources after GPU drawing flushes. Retained windows keep bounded warm caches."
 (flush-retired-targets)
 (if (and *active-window* (cache-enabled-p *active-window*))
     (setf *font-cache* (trim-retained-resources *font-cache* *used-fonts* *retained-font-cache-limit* #'rl:unload-font)
           *texture-cache* (trim-retained-resources *texture-cache* *used-textures* *retained-texture-cache-limit* #'rl:unload-texture))
     (progn
       (setf *font-cache* (delete-if (lambda (entry) (unless (member (cdr entry) *used-fonts* :test #'eq)
                                                     (rl:unload-font (cdr entry)) t)) *font-cache*))
       (setf *texture-cache* (delete-if (lambda (entry) (unless (member (cdr entry) *used-textures* :test #'eq)
                                                        (rl:unload-texture (cdr entry)) t)) *texture-cache*)))))

(defun retire-render-target (target)
 (when target (pushnew target *retired-targets* :test #'eq)))
(defun flush-retired-targets ()
 (mapc #'rl:unload-render-texture *retired-targets*) (setf *retired-targets* nil))

(defmethod os-drag-capabilities ((window window))
 (list :incoming t :outgoing nil :mime-types (list "application/x-lut-file-path-list")
       :status :file-paths-only :scope :raylib-window :hover-feedback nil))

(defmethod render ((bar viewport-scrollbar)) (paint-viewport-scrollbar bar))

(defmethod render ((handle resize-handle))
  (let ((color (style-value handle (if (member (widget-state handle) '(:hover :pressed)) :accent :border-color))))
    (if (eq (resize-axis handle) :horizontal)
        (rl:draw-rectangle (+ (x handle) (/ (width handle) 2)) (y handle) 1 (height handle) color)
        (rl:draw-rectangle (x handle) (+ (y handle) (/ (height handle) 2)) (width handle) 1 color))))
(defmethod render :after ((book notebook))
  (destructuring-bind (left top width height) (tab-strip-rectangle book)
    (with-drawing-clip (left top width height)
      (loop for page in (children book) for index from 0
            for action = (page-action book page) for box = (tab-action-rectangle book index)
            when (and action box) do
              (if (notebook-action-draw-function action)
                  (funcall (notebook-action-draw-function action) book page action box)
                  (draw-string book (fit-caption book (notebook-action-label action) (third box))
                               (first box) (+ top (/ (- height (style-value book :font-size)) 2))
                               (style-value book (if (notebook-action-enabled-p action) :foreground :disabled-color))))))))
