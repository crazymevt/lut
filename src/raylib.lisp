(in-package #:lut)
(defvar *font-coverage-probe* nil)
(cffi:defcallback native-log :void ((level :int) (message :string) (arguments :pointer))
 ;; Native stdout may carry an editor's framed REPL protocol. Format the C
 ;; varargs before sending diagnostics through Lisp's capturable error stream.
 ;; Never unwind a Lisp stream error (e.g. a REPL output limit) through C.
 (handler-case
   (cffi:with-foreign-object (buffer :char 4096)
     (cffi:foreign-funcall "vsnprintf" :pointer buffer :size 4096
       :string message :pointer arguments :int)
     (unless (and *font-coverage-probe* (search "Requested codepoints glyphs found" message))
       (format *error-output* "~&raylib (~d): ~a~%" level
         (cffi:foreign-string-to-lisp buffer))))
   (error () nil)))
(defmacro with-native-logging (&body body)
 `(progn
    (rl:set-trace-log-callback (cffi:callback native-log))
    (unwind-protect (progn ,@body)
      (rl:set-trace-log-callback (cffi:null-pointer)))))
(defvar *ui-lock* (bt:make-lock "LUT REPL queue"))
(defvar *ui-queue* nil)
(defvar *draining-jobs* nil)
(defstruct ui-job function owner (active-p t))
(defun enqueue-ui (function &key owner)
 "Queue FUNCTION for the next frame. OWNER optionally cancels it on disposal.
Return FUNCTION and, as a second value, a cancellable job handle."
 (check-type function function) (when owner (ensure-live owner))
 (let ((job (make-ui-job :function function :owner owner)))
   (bt:with-lock-held (*ui-lock*) (push job *ui-queue*)) (values function job)))
(defmacro on-ui (&body body)
 "Execute BODY between frames on the GUI thread. Use ON-WIDGET for owned work."
 `(enqueue-ui (lambda () ,@body)))
(defmacro on-widget (widget &body body)
 "Queue BODY owned by WIDGET. Disposing the owner cancels pending work and releases the closure."
 `(enqueue-ui (lambda () ,@body) :owner ,widget))
(defun clear-ui-job (job)
 (setf (ui-job-active-p job) nil (ui-job-function job) nil (ui-job-owner job) nil))
(defun cancel-ui (handle)
 "Cancel a queued job handle or every pending occurrence of FUNCTION; return count. Running jobs finish normally."
 (let ((count 0))
   (bt:with-lock-held (*ui-lock*)
     (dolist (job (remove-duplicates (append *ui-queue* *draining-jobs*)))
       (when (and (ui-job-active-p job) (or (eq handle job) (eq handle (ui-job-function job))))
         (clear-ui-job job) (incf count)))
     (setf *ui-queue* (remove-if-not #'ui-job-active-p *ui-queue*))) count))
(defun cancel-owner-jobs (owner)
 (bt:with-lock-held (*ui-lock*)
   (dolist (job (append *ui-queue* *draining-jobs*))
     (when (eq owner (ui-job-owner job)) (clear-ui-job job)))
   (setf *ui-queue* (remove-if-not #'ui-job-active-p *ui-queue*))))
(defun cancel-all-ui-jobs ()
 (bt:with-lock-held (*ui-lock*)
   (mapc #'clear-ui-job *ui-queue*) (setf *ui-queue* nil)))
(defun drain-ui-queue ()
 (let ((jobs (bt:with-lock-held (*ui-lock*)
               (prog1 (nreverse *ui-queue*) (setf *ui-queue* nil)))))
   (bt:with-lock-held (*ui-lock*) (setf *draining-jobs* jobs))
   (unwind-protect
     (loop for remaining on jobs for job = (first remaining)
           for function = (bt:with-lock-held (*ui-lock*)
                            (let ((fn (and (ui-job-active-p job)
                                          (or (null (ui-job-owner job)) (not (disposed-p (ui-job-owner job))))
                                          (ui-job-function job))))
                              (clear-ui-job job) fn))
           do (when function
                (handler-case (funcall function)
                  (error (e)
                    (bt:with-lock-held (*ui-lock*)
                      (setf *ui-queue* (append *ui-queue* (reverse (remove-if-not #'ui-job-active-p (rest remaining))))))
                    (error e)))))
     (bt:with-lock-held (*ui-lock*) (setf *draining-jobs* nil)))))
(defvar *window* nil "Most recently started active window; cleared on disposal/teardown.")
(defvar *primary-window* nil "Active primary root; cleared on disposal/teardown.")
(defmethod dispose :after ((w widget))
 (cancel-owner-jobs w)
 (when (eq w *window*) (setf *window* nil))
 (when (eq w *primary-window*) (setf *primary-window* nil) (rl:stop)))

(defvar *font-cache* nil)
(defvar *texture-cache* nil)
(defvar *used-fonts* nil)
(defvar *used-textures* nil)
(defvar *retired-targets* nil)
(defvar *controller-running-p* nil)
(defvar *clip* nil)
(defvar *active-window* nil)
(defvar *native-title* nil)
(defun font-codepoints (w)
 (let ((codes (loop for i from 32 below 127 collect i)))
   (walk-widgets (root-of w)
     (lambda (node)
       (flet ((include-text (s) (when (stringp s)
                 (loop for c across s unless (< (char-code c) 32) do (pushnew (char-code c) codes)))))
         (dolist (record *api*)
           (when (and (typep node (first record)) (find 'text (fourth record) :key #'first))
             (include-text (text node))))
         (when (or (typep node 'list-view) (typep node 'combo-box) (typep node 'notebook))
           (mapc #'include-text (items node)))
         (when (typep node 'table-view) (mapc #'include-text (columns node))))))
   (sort codes #'<)))
(defun load-covered-font (path size codes)
 "Probe once on a cache miss, then omit unavailable glyphs from the atlas."
 (labels ((load-codes (requested)
            (cffi:with-foreign-object (points :int (length requested))
              (loop for code in requested for i from 0 do (setf (cffi:mem-aref points :int i) code))
              (let ((font (rl:load-font-ex path size points (length requested))))
                (unless (rl:is-font-valid font) (error "Could not load font ~a" path)) font))))
   (let* ((*font-coverage-probe* t) (probe (load-codes codes))
          (supported (remove-if-not
             (lambda (code) (= code (rl:glyph-info-value (rl:get-glyph-info probe code)))) codes)))
     (if (equal codes supported) probe
         (unwind-protect
             (if supported (load-codes supported)
                 (error "Font ~a has none of the requested glyphs." path))
           (rl:unload-font probe))))))
(defun widget-font (w)
 (let* ((path (or (style-value w :font) (asdf:system-relative-pathname "lut" "assets/NotoSans-Regular.ttf")))
        (size (round (style-value w :font-size))) (codes (font-codepoints w))
        (key (list (namestring (pathname path)) size codes (file-write-date path)))
        (hit (assoc key *font-cache* :test #'equal)))
   (let ((font (or (cdr hit)
       (let ((font (load-covered-font path size codes)))
         (push (cons key font) *font-cache*) font))))
     (pushnew font *used-fonts* :test #'eq) font)))
(defmethod text-width ((w label) string)
 (rl:vector2-x (rl:measure-text-ex (widget-font w) string
                   (style-value w :font-size) (style-value w :font-spacing))))
(defmethod text-width ((w notebook) string)
 (if *active-window*
     (rl:vector2-x (rl:measure-text-ex (widget-font w) string
                     (style-value w :font-size) (style-value w :font-spacing)))
     (call-next-method)))
(defun draw-string (w string px py &optional color)
 (rl:draw-text-ex (widget-font w) string (rl:vec2 px py)
   (style-value w :font-size) (style-value w :font-spacing) (or color (style-value w :foreground))))
(defun paint-text (w)
 (let* ((pad (style-value w :padding)) (lh (line-height w))
        (editable (typep w 'entry)) (offset (if editable (text-offset w) 0))
        (available (max 1 (- (width w) (* 2 pad) (if (typep w 'combo-box) (selection-button-width w) 0)))))
   (when (and (typep w 'text-view) (/= (last-cursor w) (cursor w)))
     (let* ((line (count #\Newline (display-text w) :end (cursor w))) (cy (* line lh))
            (view-height (max lh (- (height w) (* 2 pad)))))
       (setf (vertical-offset w) (max 0 (min (vertical-offset w) cy)))
       (when (> (+ cy lh) (+ (vertical-offset w) view-height))
         (setf (vertical-offset w) (- (+ cy lh) view-height)))))
   (when editable (setf (last-cursor w) (cursor w)))
   (when editable
     (let* ((start (or (position #\Newline (display-text w) :end (cursor w) :from-end t) -1))
            (cx (text-width w (subseq (display-text w) (1+ start) (cursor w)))))
       (setf offset (max 0 (min offset cx)))
       (when (> (- cx offset) available) (setf offset (- cx available)))
       (setf (text-offset w) offset)))
   (loop for (start end) in (text-lines (display-text w)) for row from 0
         for px = (- (+ (x w) pad) offset) for py = (- (+ (y w) pad (* row lh)) (if editable (vertical-offset w) 0))
         for string = (subseq (display-text w) start end)
         do (when editable
              (multiple-value-bind (a b) (selection w)
                (let ((lo (max a start)) (hi (min b end)))
                  (when (< lo hi)
                    (let ((left (text-width w (subseq (display-text w) start lo)))
                          (right (text-width w (subseq (display-text w) start hi))))
                      (rl:draw-rectangle (+ px left) py (- right left) lh (style-value w :accent)))))))
            (draw-string w string px py)
            (when (and editable (<= start (cursor w) end)
                       (and (typep (root-of w) 'window) (eq w (focused-widget (root-of w)))))
              (rl:draw-rectangle (+ px (text-width w (subseq (display-text w) start (cursor w)))) py
                (style-value w :caret-width) lh (style-value w :foreground))))))
(defun surface-color (w)
 (let ((state (widget-state w)))
   (loop for node = w then (parent node) while node do
     (multiple-value-bind (v found) (property (getf (state-style node) state) :surface)
       (when found (return-from surface-color v))))
   (dolist (root (style-roots w))
     (when (typep root 'window)
       (dolist (rule (reverse (style-rules root)))
         (when (and (typep w (getf rule :class 'widget)) (eq state (getf rule :state)))
           (multiple-value-bind (v found) (property (getf rule :style) :surface)
             (when found (return-from surface-color v))))))))
 (case (widget-state w) (:disabled (style-value w :disabled-color))
   (:pressed (style-value w (if (typep w 'entry) :surface :pressed-color))) (:hover (style-value w (if (typep w 'entry) :surface :hover-color)))
   (otherwise (style-value w :surface))))
(defun resolved-roundness (w &optional (width (width w)) (height (height w))
                                      (proportion (style-value w :border-radius)))
 "Convert the styled pixel cap to raylib's shorter-side proportion."
 (let ((side (min width height)))
   (if (plusp side)
       (min proportion (/ (* 2 (style-value w :max-border-radius)) side))
       0)))
(defun paint-surface (w &optional color)
 (rl:draw-rectangle-rounded (rl:rect (x w) (y w) (width w) (height w))
   (resolved-roundness w) 12 (or color (surface-color w)))
 (let ((border (style-value w :border-width)))
   (when (plusp border)
     (rl:draw-rectangle-rounded-lines-ex (rl:rect (x w) (y w) (width w) (height w))
       (resolved-roundness w) 12 border (style-value w :border-color)))))
(defmethod render :around ((w widget))
 (when (and (visible-p w) (not (disposed-p w)))
   (let* ((bounds (list (x w) (y w) (width w) (height w)))
          (clip (intersect-rectangles bounds (or *clip* bounds)))
          (*clip* clip))
     (when (and (plusp (third clip)) (plusp (fourth clip)))
       (rl:with-scissor-mode ((round (first clip)) (round (second clip)) (round (third clip)) (round (fourth clip)))
         (call-next-method)
         (when (and (typep (root-of w) 'window) (eq w (focused-widget (root-of w)))
                    (focus-visible-p (root-of w)))
           ;; Elevated faces need an inner ring so focus cannot cover their
           ;; highlight or lower shadow. Check/switch indicators use the usual ring.
           (let* ((elevated (or (typep w 'dropdown)
                               (and (typep w 'button)
                                    (or (not (typep w 'check-button))
                                        (and (typep w 'toggle-button) (not (typep w 'switch)))))))
                  (depth (if elevated (button-depth w) 0))
                  (inset (if (plusp depth) 4 1))
                  (fw (max 0 (- (width w) (* 2 inset))))
                  (fh (max 0 (- (if (typep w 'expander) (line-height w) (height w)) depth (* 2 inset)))))
             (when (and (plusp fw) (plusp fh))
               (rl:draw-rectangle-rounded-lines-ex
                 (rl:rect (+ (x w) inset)
                          (+ (y w) inset (if (and elevated (button-depressed-p w)) depth 0)) fw fh)
                 (resolved-roundness w fw fh) 12 2 (style-value w :focus-color))))))
       (dolist (child (active-children w)) (render child))))))
(defun intersect-rectangles (a b)
 (let ((left (max (first a) (first b))) (top (max (second a) (second b))))
   (list left top (max 0 (- (min (+ (first a) (third a)) (+ (first b) (third b))) left))
                  (max 0 (- (min (+ (second a) (fourth a)) (+ (second b) (fourth b))) top)))))
(defmethod render ((w widget)) nil)
(defun wrapped-label-lines (w)
 "Return label lines wrapped to the padded width; preserve explicit newlines."
 (let* ((pad (style-value w :padding)) (available (max 1 (- (width w) (* 2 pad))))
        (string (display-text w)) (result nil))
   (dolist (bounds (text-lines string))
     (let ((line ""))
       (dolist (word (uiop:split-string (subseq string (first bounds) (second bounds))
                                       :separator '(#\Space #\Tab)))
         (let ((candidate (if (zerop (length line)) word (concatenate 'string line " " word))))
           (when (and (plusp (length line)) (> (text-width w candidate) available))
             (push line result) (setf candidate word))
           (setf line candidate)))
       (push line result)))
   (nreverse result)))
(defun paint-wrapped-label (w)
 (loop for line in (wrapped-label-lines w) for row from 0 do
   (draw-string w line (+ (x w) (style-value w :padding))
     (+ (y w) (style-value w :padding) (* row (line-height w))))))
(defmethod render ((w label))
 (if (style-value w :wrap-text) (paint-wrapped-label w) (paint-text w)))
(defun paint-caption (w &optional (right-space 0) (alignment :center) color (offset 0))
 "Paint each caption line, preserving multiline labels and indicator space."
 (let* ((string (display-text w)) (lines (text-lines string))
        (pad (style-value w :padding)) (lh (line-height w))
        (block-height (+ (style-value w :font-size) (* (max 0 (1- (length lines))) lh)))
        (top (+ (y w) (max 0 (/ (- (height w) block-height) 2)))))
   (loop for (start end) in lines for row from 0
         for line = (subseq string start end) do
     (draw-string w line
       (+ (x w) (if (eq alignment :left) pad
                    (max pad (/ (- (width w) right-space (text-width w line)) 2))))
       (+ top offset (* row lh)) color))))
(defun paint-rounded (w x y width height radius color)
 (when (and (plusp width) (plusp height))
   (rl:draw-rectangle-rounded (rl:rect x y width height) (resolved-roundness w width height radius) 12 color)))
(defun indicator-color (w)
 (style-value w (if (eq (widget-state w) :disabled) :disabled-color :accent)))
(defun button-depth (w)
 (if (eq (widget-state w) :disabled) 0
     (min (style-value w :button-depth) (/ (height w) 4))))
(defun button-depressed-p (w)
 (or (eq (widget-state w) :pressed)
     (and (typep w 'toggle-button) (value w))
     (and (typep w 'dropdown) (expanded-p w))))
(defun button-caption-offset (w)
 (* (button-depth w) (if (button-depressed-p w) 0.5 -0.5)))
(defun paint-button-surface (w &optional color)
 "Keep elevation inside the hit rectangle; pressed faces sink into its shadow."
 (let* ((depth (button-depth w)) (down (button-depressed-p w))
        (fy (+ (y w) (if down depth 0))) (fh (- (height w) depth))
        (border (style-value w :border-width)))
   (if (zerop depth)
       (paint-surface w color)
       (progn
         (paint-rounded w (x w) (y w) (width w) (height w)
           (style-value w :border-radius) (style-value w :button-shadow))
         (paint-rounded w (x w) fy (width w) fh
           (style-value w :border-radius) (or color (surface-color w)))
         (when (plusp border)
           (rl:draw-rectangle-rounded-lines-ex (rl:rect (x w) fy (width w) fh)
             (resolved-roundness w (width w) fh) 12 border (style-value w :border-color)))
         (unless down
           (let ((inset (max 2 (* 0.5 fh (resolved-roundness w (width w) fh)))))
             (when (> (width w) (* 2 inset))
               (rl:draw-line-ex (rl:vec2 (+ (x w) inset) (+ fy 1))
                 (rl:vec2 (- (+ (x w) (width w)) inset) (+ fy 1))
                 1 (style-value w :button-highlight)))))))))
(defmethod render ((w button))
 (paint-button-surface w)
 (paint-caption w 0 :center nil (button-caption-offset w)))
(defmethod render ((w entry)) (paint-surface w) (paint-text w))
(defmethod render ((w check-button))
 (paint-surface w)
 (let* ((pad (style-value w :padding))
        (size (max 0 (min (style-value w :font-size) (- (height w) (* 2 pad))
                          (- (width w) (* 2 pad)))))
        (ix (- (+ (x w) (width w)) size pad))
        (iy (+ (y w) (/ (- (height w) size) 2))))
   (paint-caption w (+ size pad) :left)
   (paint-rounded w ix iy size size 0.25 (style-value w :border-color))
   (paint-rounded w (+ ix 2) (+ iy 2) (- size 4) (- size 4) 0.25
     (if (value w) (indicator-color w) (surface-color w)))
   (when (and (value w) (>= size 12))
     (let ((color (style-value w :on-accent)))
       (rl:draw-line-ex (rl:vec2 (+ ix (* size 0.22)) (+ iy (* size 0.5)))
         (rl:vec2 (+ ix (* size 0.43)) (+ iy (* size 0.72))) 2 color)
       (rl:draw-line-ex (rl:vec2 (+ ix (* size 0.43)) (+ iy (* size 0.72)))
         (rl:vec2 (+ ix (* size 0.8)) (+ iy (* size 0.28))) 2 color)))))
(defun selected-toggle-color (w)
 "Blend selected surfaces toward the themed interaction color."
 (let ((base (indicator-color w)) (state (widget-state w)))
   (if (member state '(:hover :pressed))
       (let ((overlay (style-value w (if (eq state :pressed) :pressed-color :hover-color)))
             (amount (if (eq state :pressed) 0.35 0.18)))
         (mapcar (lambda (a b) (round (+ (* a (- 1 amount)) (* b amount)))) base overlay))
       base)))
(defmethod render ((w toggle-button))
 (paint-button-surface w (if (value w) (selected-toggle-color w) (surface-color w)))
 (paint-caption w 0 :center (when (value w) (style-value w :on-accent))
   (button-caption-offset w)))
(defmethod render ((w switch))
 (paint-surface w)
 (let* ((pad (style-value w :padding))
        (h (max 0 (min 22 (- (height w) (* 2 pad)) (/ (- (width w) (* 2 pad)) 2))))
        (tw (* 2 h)) (tx (- (+ (x w) (width w)) pad tw))
        (ty (+ (y w) (/ (- (height w) h) 2))))
   (paint-caption w (+ tw pad) :left)
   (paint-rounded w tx ty tw h 1 (if (value w) (indicator-color w) (style-value w :border-color)))
   (paint-rounded w (+ tx 3 (if (value w) h 0)) (+ ty 3) (- h 6) (- h 6) 1
     (style-value w :on-accent))))
(defmethod render ((w radio-button))
 (paint-surface w)
 (let* ((pad (style-value w :padding))
        (size (max 0 (min 20 (- (height w) (* 2 pad)) (- (width w) (* 2 pad)))))
        (ix (- (+ (x w) (width w)) size pad)) (iy (+ (y w) (/ (- (height w) size) 2))))
   (paint-caption w (+ size pad) :left)
   (paint-rounded w ix iy size size 1 (style-value w :border-color))
   (paint-rounded w (+ ix 2) (+ iy 2) (- size 4) (- size 4) 1 (surface-color w))
   (when (value w)
     (paint-rounded w (+ ix 5) (+ iy 5) (- size 10) (- size 10) 1 (indicator-color w)))))
(defmethod render ((w slider))
 (let* ((h (min 6 (height w))) (ty (+ (y w) (/ (- (height w) h) 2)))
        (fraction (range-fraction w))
        (diameter (max 0 (min 18 (height w) (width w))))
        (cx (+ (x w) (* (width w) fraction))))
   (paint-rounded w (x w) ty (width w) h 1 (style-value w :border-color))
   (paint-rounded w (x w) ty (* (width w) fraction) h 1 (indicator-color w))
   (paint-rounded w (max (x w) (min (- (+ (x w) (width w)) diameter) (- cx (/ diameter 2))))
     (+ (y w) (/ (- (height w) diameter) 2)) diameter diameter 1 (indicator-color w))))
(defmethod render ((w progress-bar))
 (paint-surface w)
 (paint-rounded w (x w) (y w) (* (width w) (range-fraction w)) (height w)
   (style-value w :border-radius) (indicator-color w)))
(defun row-text-y (w py)
 (+ py (max 0 (/ (- (row-height w) (style-value w :font-size)) 2))))
(defun paint-row-selection (w py &optional (color (style-value w :accent)))
 (let ((inset (max 2 (style-value w :border-width))))
   (paint-rounded w (+ (x w) inset) (+ py 2)
     (max 0 (- (width w) (* 2 inset))) (max 0 (- (row-height w) 4))
     (style-value w :border-radius) color)))
(defun paint-list-surface (w)
 (paint-surface w (style-value w (if (eq (widget-state w) :disabled) :disabled-color :surface))))
(defun paint-row-state (w index py)
 (cond ((eql index (value w)) (paint-row-selection w py))
       ((and (eql index (hovered-row w)) (not (eq (widget-state w) :disabled)))
        (paint-row-selection w py (style-value w (if (eq (widget-state w) :pressed) :pressed-color :hover-color))))))
(defmethod render ((w list-view))
 (paint-list-surface w)
 (loop for item in (items w) for i from 0
       for py = (- (+ (y w) (* i (row-height w))) (scroll-offset w))
       do (paint-row-state w i py)
          (draw-string w item (+ (x w) (style-value w :padding)) (row-text-y w py)
            (when (eql i (value w)) (style-value w :on-accent)))))
(defmethod render ((w drawing-area)) (when (draw-function w) (funcall (draw-function w) w)))
(defmethod render ((w scroll-view))
 (when (plusp (scroll-range w))
   (multiple-value-bind (sx sy sw sh travel) (scrollbar-bounds w)
     (declare (ignore travel))
     (paint-rounded w sx (y w) sw (height w) 1 (style-value w :surface))
     (paint-rounded w sx sy sw sh 1 (style-value w :border-color)))))
(defmethod render ((w dialog))
 (paint-surface w (style-value w :background))
 (unless (or (native-p w) (typep w 'popover) (typep w 'context-menu))
   (draw-string w (text w) (+ (x w) (style-value w :padding)) (y w))))
(defmethod render ((w notebook))
 (multiple-value-bind (tab left viewport button) (tab-strip-geometry w)
   (let ((clip (intersect-rectangles *clip* (list left (y w) viewport (style-value w :title-height)))))
     (rl:with-scissor-mode ((round (first clip)) (round (second clip)) (round (third clip)) (round (fourth clip)))
       (loop for page in (children w) for i from 0
             for px = (+ left (* i tab) (- (tab-offset w)))
             when (and (< px (+ left viewport)) (> (+ px tab) left)) do
         (rl:draw-rectangle px (y w) tab (style-value w :title-height)
           (if (= i (value w)) (style-value w :accent) (surface-color w)))
         (draw-string w (fit-caption w (or (nth i (items w)) "Page")
                                    (max 0 (- tab (* 2 (style-value w :padding)))))
                        (+ px (style-value w :padding)) (y w)
                        (when (= i (value w)) (style-value w :on-accent))))))
   (rl:begin-scissor-mode (round (first *clip*)) (round (second *clip*))
                         (round (third *clip*)) (round (fourth *clip*)))
   (when (plusp button)
     (dolist (right '(nil t))
       (let* ((px (if right (+ left viewport) (x w)))
              (enabled (if right (< (tab-offset w) (tab-scroll-limit w)) (plusp (tab-offset w)))))
         (rl:draw-rectangle px (y w) button (style-value w :title-height) (style-value w :surface))
         (draw-string w (if right ">" "<") (+ px (/ button 3)) (y w)
                      (style-value w (if enabled :foreground :disabled-color))))))))
(defmethod render-drag-feedback ((window window))
 (let ((session (current-drag window)))
   (when (and session (eq (drag-state session) :dragging))
     (let ((target (drag-target session)) (source (drag-source session)))
       (when target
         (let ((clip (list 0 0 (width window) (height window))))
           (loop for node = target then (parent node) while node do
             (setf clip (intersect-rectangles clip (list (x node) (y node) (width node) (height node)))))
           (rl:with-scissor-mode ((round (first clip)) (round (second clip))
                                  (round (third clip)) (round (fourth clip)))
             (rl:draw-rectangle-rounded-lines-ex
               (rl:rect (x target) (y target) (width target) (height target))
               (resolved-roundness target) 12 2 (style-value target :focus-color))
             (when (and (typep target 'notebook) (notebook-tab-p (drag-payload session)))
               (let ((px (tab-insertion-position target (notebook-drop-index target (drag-x session)))))
                 (rl:draw-rectangle px (y target) 2 (style-value target :title-height)
                                    (style-value target :focus-color)))))))
       ;; A small pointer marker remains visible even over a rejected target.
       (rl:draw-circle (drag-x session) (drag-y session) 4
                      (style-value source (if target :accent :disabled-color)))))))
(defmethod render ((w expander))
 (draw-string w (concatenate 'string (if (value w) "- " "+ ") (text w)) (x w) (y w)))
(defmethod render ((w tree-view)) (refresh-items w) (call-next-method))
(defmethod render ((w table-view))
 (paint-list-surface w)
 (let ((cw (/ (width w) (max 1 (length (columns w))))) (rh (row-height w)))
   (loop for title in (columns w) for c from 0 do
     (draw-string w title (+ (x w) (* c cw) (style-value w :padding)) (row-text-y w (y w))))
   (loop for row in (rows w) for i from 0 for py = (- (+ (y w) rh (* i rh)) (scroll-offset w))
         when (>= py (+ (y w) rh)) do
           (paint-row-state w i py)
           (loop for cell in row for c from 0 do
             (draw-string w (princ-to-string cell) (+ (x w) (* c cw) (style-value w :padding)) (row-text-y w py)
               (when (eql i (value w)) (style-value w :on-accent)))))))
(defmethod render ((w spin-button))
 (paint-surface w)
 (draw-string w "-" (+ (x w) (style-value w :padding)) (y w))
 (let ((caption (princ-to-string (value w))))
   (draw-string w caption (+ (x w) (/ (- (width w) (text-width w caption)) 2)) (y w)))
 (draw-string w "+" (- (+ (x w) (width w)) (style-value w :padding) (text-width w "+")) (y w)))
(defun fit-caption (w string available)
 "Find a fitting prefix with logarithmically many measurements."
 (cond ((<= (text-width w string) available) string)
       ((> (text-width w "...") available) "")
       (t (let ((lo 0) (hi (length string)))
            (loop while (< lo hi) for mid = (ceiling (+ lo hi) 2)
                  do (if (<= (text-width w (concatenate 'string (subseq string 0 mid) "...")) available)
                         (setf lo mid) (setf hi (1- mid))))
            (concatenate 'string (subseq string 0 lo) "...")))))
(defun paint-selection-indicator (w)
 (let* ((sx (selection-button-x w)) (sw (selection-button-width w))
        (cx (+ sx (/ sw 2))) (cy (+ (y w) (/ (height w) 2)))
        (pad (min 8 (/ (height w) 4))))
   (when (and (>= sw 16) (>= (height w) 12))
     (rl:draw-line-ex (rl:vec2 sx (+ (y w) pad))
       (rl:vec2 sx (- (+ (y w) (height w)) pad)) 1 (style-value w :border-color))
     (let ((direction (if (expanded-p w) -1 1)) (color (style-value w :foreground)))
       (rl:draw-line-ex (rl:vec2 (- cx 4) (- cy (* direction 2)))
         (rl:vec2 cx (+ cy (* direction 2))) 2 color)
       (rl:draw-line-ex (rl:vec2 cx (+ cy (* direction 2)))
         (rl:vec2 (+ cx 4) (- cy (* direction 2))) 2 color)))))
(defmethod render ((w dropdown))
 (paint-button-surface w)
 (let* ((pad (style-value w :padding))
        (available (max 0 (- (width w) (* 2 pad) (selection-button-width w))))
        (caption (or (and (value w) (nth (value w) (items w))) "Choose...")))
   (draw-string w (fit-caption w caption available) (+ (x w) pad)
     (+ (y w) (max 0 (/ (- (height w) (style-value w :font-size)) 2)))))
 (paint-selection-indicator w))
(defmethod render ((w combo-box))
 (paint-surface w)
 (paint-rounded w (selection-button-x w) (y w) (selection-button-width w) (height w)
   (style-value w :border-radius)
   (style-value w (if (eq (widget-state w) :disabled) :disabled-color :hover-color)))
 (let ((clip (intersect-rectangles *clip* (list (x w) (y w)
                     (max 0 (- (width w) (selection-button-width w))) (height w)))))
   (rl:with-scissor-mode ((round (first clip)) (round (second clip)) (round (third clip)) (round (fourth clip)))
     (paint-text w)))
 ;; Nested raylib scissor scopes disable clipping on exit; restore the widget
 ;; clip before painting its indicator and the outer method's focus outline.
 (rl:begin-scissor-mode (round (first *clip*)) (round (second *clip*))
   (round (third *clip*)) (round (fourth *clip*)))
 (paint-selection-indicator w))
(defmethod render ((w image))
 (when (source w)
   (let* ((key (list (namestring (pathname (source w))) (file-write-date (source w))))
          (texture (or (cdr (assoc key *texture-cache* :test #'equal))
                       (let ((tex (rl:load-texture (source w))))
                         (unless (rl:is-texture-valid tex) (error "Could not load image ~a" (source w)))
                         (push (cons key tex) *texture-cache*) tex)))
          (scale (min (/ (width w) (rl:texture-width texture)) (/ (height w) (rl:texture-height texture)))))
     (pushnew texture *used-textures* :test #'eq)
     (rl:draw-texture-ex texture (rl:vec2 (x w) (y w)) 0 scale :white))))
(defvar *event-sink* nil)
(defun poll-input (w)
 ;; Clicking the owner's title bar can focus it without a content mouse event.
 (when (rl:is-window-focused)
   (let ((blocker (modal-blocker w))) (when blocker (focus-modal blocker))))
 (let ((mx (rl:get-mouse-x)) (my (rl:get-mouse-y))
       (shift (or (rl:is-key-down :left-shift) (rl:is-key-down :right-shift)))
       (control (or (rl:is-key-down :left-control) (rl:is-key-down :right-control)))
       (alt (or (rl:is-key-down :left-alt) (rl:is-key-down :right-alt)))
       (super (or (rl:is-key-down :left-super) (rl:is-key-down :right-super))))
   (flet ((send (kind &key key (base-key key) (text "") (delta 0))
            (let ((event (make-event :kind kind :x mx :y my :key key :base-key base-key :text text :delta delta
                                    :shift-p shift :control-p control :alt-p alt :super-p super)))
              (if *event-sink* (funcall *event-sink* event) (dispatch w event)))))
     (when (rl:is-mouse-button-pressed :left) (send :down))
     (send :move)
     (when (rl:is-mouse-button-released :left) (send :up))
     (when (rl:is-mouse-button-pressed :right) (send :context))
     (let ((gesture (rl:enum-keyword 'rl:gesture (rl:get-gesture-detected))))
      (when (and gesture (not (eq gesture :none)))
       (send :gesture :key gesture :delta
        (case gesture (:hold (rl:get-gesture-hold-duration))
         ((:pinch-in :pinch-out) (rl:get-gesture-pinch-angle)) (t 0)))))
     (let ((wheel (rl:get-mouse-wheel-move))) (unless (zerop wheel) (send :wheel :delta wheel)))
     (dolist (key '(:tab :left :right :up :down :home :end :backspace :delete :enter :space :escape))
       (when (or (rl:is-key-pressed key) (rl:is-key-pressed-repeat key)) (send :key :key key)))
     (let ((control (or control super))
           (field (focused-widget w)))
       (when (and control (or (typep field 'entry) *event-sink*))
         (when (rl:is-key-pressed :a) (send :key :key :select-all :base-key :a))
         (when (rl:is-key-pressed :z) (send :key :key (if shift :redo :undo) :base-key :z))
         (when (rl:is-key-pressed :y) (send :key :key :redo :base-key :y))
         (when (rl:is-key-pressed :c) (send :key :key :copy :base-key :c))
         (when (rl:is-key-pressed :x) (send :key :key :cut :base-key :x))
         (when (rl:is-key-pressed :v) (send :key :key :paste :base-key :v)))
       (loop for code = (rl:get-key-pressed) until (zerop code)
             for key = (ignore-errors (rl:enum-keyword 'rl:keyboard-key code))
             when (and key (not (member key '(:tab :left :right :up :down :home :end :backspace :delete :enter :space :escape)))
                       (not (and control (member key '(:a :c :x :v :z :y)))))
             do (send :key :base-key key :key (if control
                  (intern (concatenate 'string (if shift "CONTROL-SHIFT-" "CONTROL-") (symbol-name key)) :keyword) key)))
       (loop for code = (rl:get-char-pressed) until (zerop code)
             for char = (code-char code)
             when (and char (not control)) do (send :text :text (string char)))))))
(defun frame-step (w dt)
 "One frame, called by name so redefinition takes effect immediately."
 (setf *used-fonts* nil *used-textures* nil)
 (drain-ui-queue)
 (when (fboundp 'open-pending-dialogs) (open-pending-dialogs w))
 (unless (equal *native-title* (text w))
   (rl:set-window-title (text w)) (setf *native-title* (text w)))
 (when (fboundp 'pump-remote-windows) (pump-remote-windows))
 (emit w :tick dt)
 (when (disposed-p w) (return-from frame-step nil))
 (layout-window w (rl:get-screen-width) (rl:get-screen-height))
 (poll-input w)
 (rl:with-drawing ((style-value w :background)) (render-window w))
 (sweep-native-resources))
(defun render-window (w)
 (refresh-commands w)
 (render w)
 (dolist (d (reverse (slot-value w 'overlays))) (render d))
 (render-drag-feedback w))
(defmethod run ((w window) &key frames)
 "Run on OS main thread. Loop exit closes secondary workers and releases library-owned references."
 (ensure-live w)
 (when *active-window* (return-from run (spawn-window w)))
 (with-native-logging
 (let ((*active-window* w) (*native-title* nil) (*font-cache* nil) (*texture-cache* nil)
       (*used-fonts* nil) (*used-textures* nil) (*retired-targets* nil) (count 0))
   (setf *controller-running-p* t *primary-window* w)
   (unwind-protect
     (rl:with-window ((round (width w)) (round (height w)) (text w)
                     :flags '(:window-resizable :vsync-hint) :exit-key :null)
       (unwind-protect
         (rl:game-loop (dt :on-error (if frames :signal :pause))
           (frame-step w dt)
           (when (and frames (>= (incf count) frames)) (rl:stop)))
         (unwind-protect (progn (cancel-drag w) (emit w :context-close))
         (when (fboundp 'shutdown-native-windows) (shutdown-native-windows))
         (flush-retired-targets)
         (mapc (lambda (pair) (rl:unload-font (cdr pair))) *font-cache*)
         (mapc (lambda (pair) (rl:unload-texture (cdr pair))) *texture-cache*))))
     (setf *controller-running-p* nil *primary-window* nil *window* nil rl:*last-error* nil)
     (cancel-all-ui-jobs)))))
(defun start (window &key frames wait)
 "Launch on the OS main thread; subsequent starts create native workers inheriting the prior root's app styles."
 (let ((source *window*))
   (setf *window* window)
   (if (or *active-window* (rl:running-p)) (spawn-window window :style-source source)
       (rl:run (lambda () (run window :frames frames)) :wait wait))))
(defun stop () "Request stop after current frame." (rl:stop))
(defmethod clipboard-text ((w entry)) (if (rl:is-window-ready) (rl:get-clipboard-text) (call-next-method)))
(defmethod (setf clipboard-text) (string (w entry))
 (if (rl:is-window-ready) (progn (rl:set-clipboard-text string) string) (call-next-method)))
#+(and ccl darwin)
(defmethod run :around ((w window) &key frames)
 (declare (ignore frames))
 ;; CCL's listener is not Cocoa's OS main thread. The bindings only bridge SBCL.
 (if (eq ccl:*current-process* ccl::*initial-process*) (call-next-method)
     (let (failure result)
       (ccl::call-in-initial-process
         (lambda () (handler-case (setf result (call-next-method)) (error (e) (setf failure e)))))
       (when failure (error failure)) result)))

(defun sweep-native-resources ()
 "Release stale atlas/texture versions only after the frame's GPU drawing has flushed."
 (flush-retired-targets)
 (setf *font-cache*
   (delete-if (lambda (entry) (unless (member (cdr entry) *used-fonts* :test #'eq)
                               (rl:unload-font (cdr entry)) t)) *font-cache*))
 (setf *texture-cache*
   (delete-if (lambda (entry) (unless (member (cdr entry) *used-textures* :test #'eq)
                               (rl:unload-texture (cdr entry)) t)) *texture-cache*)))

(defun retire-render-target (target)
 (when target (pushnew target *retired-targets* :test #'eq)))
(defun flush-retired-targets ()
 (mapc #'rl:unload-render-texture *retired-targets*) (setf *retired-targets* nil))
