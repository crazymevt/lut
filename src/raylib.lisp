(in-package #:lut)
;; Declare dynamically bound renderer state before compiling its consumers.
(defvar *event-backend-p* nil)
(defvar *native-damage-p* nil)
(defvar *controller-cache-key* nil)
(defvar *controller-pointer-key* nil)
(defvar *frame-limit-p* nil)
(defvar *controller-turns* 0)
(defvar *native-waits* 0)
(defvar *native-focus-changes* 0)
(defvar *native-exposes* 0)
(defvar *last-native-focus* :unknown)
(defvar *manual-event-dispatch* nil)
(defvar *signal-run-errors* nil)
(defvar *clip* nil)
(defvar *active-window* nil)
(defvar *window-tile-caches* nil)
(defvar *composite-window-cache* nil)
(defvar *tile-dynamic-surfaces* nil)
(defvar *last-polled-pointer* nil)
(defvar *last-controller-time* nil)
(defvar *font-file-stamps* nil)
(defvar *font-stamp-cache* nil)
(defparameter *font-stamp-check-interval* internal-time-units-per-second
 "Native font hot-reload checks run at most once per second per path, not every frame.")
(defun cached-font-file-stamp (path)
 (if (null *font-stamp-cache*) (ignore-errors (file-write-date path))
     (let* ((now (get-internal-real-time)) (entry (gethash path *font-stamp-cache*)))
       (if (and entry (< (- now (car entry)) *font-stamp-check-interval*)) (cdr entry)
           (let ((stamp (ignore-errors (file-write-date path))))
             ;; Bound paths retained after repeated font/settings changes.
             (when (>= (hash-table-count *font-stamp-cache*) 128) (clrhash *font-stamp-cache*))
             (setf (gethash path *font-stamp-cache*) (cons now stamp)) stamp)))))
(defun font-file-stamp (path)
 (if *font-file-stamps*
     (multiple-value-bind (value present) (gethash path *font-file-stamps*)
       (if present value (setf (gethash path *font-file-stamps*) (cached-font-file-stamp path))))
     (cached-font-file-stamp path)))
(defparameter *idle-poll-interval* (/ 1.0 30)
 "Idle input/queued-work latency is bounded to about 33 ms. Active/dynamic rendering keeps its normal cadence.")
(defparameter *retained-font-cache-limit* 32)
(defparameter *retained-texture-cache-limit* 128)
(defvar *controller-frame-dt* 0)
(defun render-widget-node (widget)
 (let ((surface (and *tile-dynamic-surfaces* (gethash (render-identity widget) *tile-dynamic-surfaces*))))
   (if surface
       (with-ui-scissor ((first *clip*) (second *clip*) (third *clip*) (fourth *clip*))
         (draw-cached-region (car surface) (cdr surface)))
       (render widget))))
(defun widget-ui-scale (widget)
 (let ((root (root-of widget))) (if (typep root 'window) (ui-scale root) 1)))
(defun backing-pixel-scale ()
 "The native framebuffer has DPI scaling; render textures use their own pixels."
 (if (and *active-window* (rl:is-window-ready)
          (zerop (cffi:foreign-funcall "rlGetActiveFramebuffer" :unsigned-int)))
     (max 1 (/ (rl:get-render-width) (max 1 (rl:get-screen-width))))
     1))
(defun widget-raster-scale (widget)
 "Font atlases use backing pixels; layout, camera and input stay in window units.
The camera applies DPI; raylib handles native scissor rectangle conversion."
 ;; Keep native atlas metrics stable while taking off-screen snapshots too.
 (* (widget-ui-scale widget)
    (if (and *active-window* (rl:is-window-ready))
        (max 1 (rl:vector2-x (rl:get-window-scale-dpi)))
        1)))
(defvar *font-coverage-probe* nil)
(cffi:defcallback native-log :void ((level :int) (message :string) (arguments :pointer))
 ;; Native stdout may carry an editor's framed REPL protocol. Format the C
 ;; varargs before sending diagnostics through Lisp's capturable error stream.
 ;; Never unwind a Lisp stream error (e.g. a REPL output limit) through C.
 (handler-case
   (cffi:with-foreign-object (buffer :char 4096)
     (cffi:foreign-funcall "vsnprintf" :pointer buffer :size 4096
       :string message :pointer arguments :int)
     (unless (and *font-coverage-probe* (search "Requested codepoints glyphs found" message))
       (format *error-output* "~&raylib (~d): ~a~%" level
         (cffi:foreign-string-to-lisp buffer))))
   (error () nil)))
(defmacro with-native-logging (&body body)
 `(progn
    (rl:set-trace-log-callback (cffi:callback native-log))
    (unwind-protect (progn ,@body)
      (rl:set-trace-log-callback (cffi:null-pointer)))))
(defvar *ui-lock* (bt:make-lock "LUT REPL queue"))
(defvar *ui-queue* nil)
(defvar *draining-jobs* nil)
(defstruct ui-job function owner (active-p t))
(defun enqueue-ui (function &key owner)
 "Queue FUNCTION for the next frame. OWNER optionally cancels it on disposal.
Return FUNCTION and, as a second value, a cancellable job handle."
 (check-type function function) (when owner (ensure-live owner))
 (let ((job (make-ui-job :function function :owner owner)))
   (bt:with-lock-held (*ui-lock*) (when owner (ensure-live owner)) (push job *ui-queue*))
   (when (fboundp 'wake-ui) (wake-ui)) (values function job)))
(defmacro on-ui (&body body)
 "Execute BODY between frames on the GUI thread. Use ON-WIDGET for owned work."
 `(enqueue-ui (lambda () ,@body)))
(defmacro on-widget (widget &body body)
 "Queue BODY owned by WIDGET. Disposing the owner cancels pending work and releases the closure."
 `(enqueue-ui (lambda () ,@body) :owner ,widget))
(defun clear-ui-job (job)
 (setf (ui-job-active-p job) nil (ui-job-function job) nil (ui-job-owner job) nil))
(defun cancel-ui (handle)
 "Cancel a queued job handle or every pending occurrence of FUNCTION; return count. Running jobs finish normally."
 (let ((count 0))
   (bt:with-lock-held (*ui-lock*)
     (dolist (job (remove-duplicates (append *ui-queue* *draining-jobs*)))
       (when (and (ui-job-active-p job) (or (eq handle job) (eq handle (ui-job-function job))))
         (clear-ui-job job) (incf count)))
     (setf *ui-queue* (remove-if-not #'ui-job-active-p *ui-queue*))) count))
(defun cancel-owner-jobs (owner)
 (bt:with-lock-held (*ui-lock*)
   (dolist (job (append *ui-queue* *draining-jobs*))
     (when (eq owner (ui-job-owner job)) (clear-ui-job job)))
   (setf *ui-queue* (remove-if-not #'ui-job-active-p *ui-queue*))))
(defun cancel-all-ui-jobs ()
 (bt:with-lock-held (*ui-lock*)
   (mapc #'clear-ui-job *ui-queue*) (setf *ui-queue* nil)))
(defun drain-ui-queue ()
 (let ((jobs (bt:with-lock-held (*ui-lock*)
               (prog1 (nreverse *ui-queue*) (setf *ui-queue* nil)))))
   (bt:with-lock-held (*ui-lock*) (setf *draining-jobs* jobs))
   (unwind-protect
     (loop for remaining on jobs for job = (first remaining)
           for function = (bt:with-lock-held (*ui-lock*)
                            (let ((fn (and (ui-job-active-p job)
                                          (or (null (ui-job-owner job)) (not (disposed-p (ui-job-owner job))))
                                          (ui-job-function job))))
                              (clear-ui-job job) fn))
           do (when function
                (handler-case (funcall function)
                  (error (e)
                    (bt:with-lock-held (*ui-lock*)
                      (setf *ui-queue* (append *ui-queue* (reverse (remove-if-not #'ui-job-active-p (rest remaining))))))
                    (error e)))))
     (bt:with-lock-held (*ui-lock*) (setf *draining-jobs* nil)))))
(defvar *window* nil "Most recently started active window; cleared on disposal/teardown.")
(defvar *primary-window* nil "Active primary root; cleared on disposal/teardown.")
(defmethod dispose :after ((w widget))
 (cancel-owner-jobs w)
 (when (fboundp 'cancel-owner-deadlines) (cancel-owner-deadlines w))
 (when (eq w *window*) (setf *window* nil))
 (when (eq w *primary-window*) (setf *primary-window* nil) (rl:stop)))

(defvar *font-cache* nil)
(defvar *texture-cache* nil)
(defvar *used-fonts* nil)
(defvar *used-textures* nil)
(defvar *retired-targets* nil)
(defvar *controller-running-p* nil)
(defvar *native-title* nil)
(defvar *native-cursor* nil)
(defun update-native-cursor (cursor)
  ;; Raylib allocates a system cursor on each non-default call.
  (unless (eq cursor *native-cursor*)
    (rl:set-mouse-cursor cursor)
    (setf *native-cursor* cursor)))
(defvar *font-codepoints-cache* nil)
(defvar *text-run-font* nil)
(defvar *font-discovery-pass* nil
 "Window glyph sets shared for one layout or render pass; never retained between passes.")
(defgeneric scan-wrapped-codepoints (view root))
(defmethod scan-wrapped-codepoints ((view wrapped-text-view) root)
 (let ((codes (make-hash-table)))
   (loop for start from 0 below (node-size root) by 256 do
     (loop for c across (index-substring root start (min (node-size root) (+ start 256)))
           unless (< (char-code c) 32) do (setf (gethash (char-code c) codes) t)))
   (sort (loop for code being the hash-keys of codes collect code) #'<)))
(defun wrapped-font-codepoints (view)
 (let* ((root (display-index view)) (revision (presentation-revision view))
        (cache (slot-value view 'wrapped-codepoints-cache)))
   (if (and cache (eq root (first cache)) (= revision (second cache))) (third cache)
       (let ((codes (scan-wrapped-codepoints view root)))
         ;; Keep glyph discovery independent of row layout and font loading.
         (setf (slot-value view 'wrapped-codepoints-cache) (list root revision codes))
         codes))))
(defmethod layout :around ((w window) x y width height)
 (declare (ignore x y width height))
 (let ((*font-discovery-pass* (or *font-discovery-pass* (make-hash-table :test #'eq))))
   (call-next-method)))
(defmethod map-visible-text-lines :around ((view label) function)
 ;; Each visible-line query is one measurement pass. Do not retain discovery
 ;; across application callbacks that may edit text or change the widget tree.
 (let ((*font-discovery-pass* (or *font-discovery-pass* (make-hash-table :test #'eq))))
   (call-next-method)))
(defun font-codepoints (w)
 (let ((root (root-of w)))
   (or (and *font-discovery-pass* (gethash root *font-discovery-pass*))
       (let ((codes (discover-font-codepoints root)))
         (when *font-discovery-pass* (setf (gethash root *font-discovery-pass*) codes))
         codes))))
(defgeneric discover-font-codepoints (w))
(defmethod discover-font-codepoints ((w widget))
 (let ((codes (make-hash-table :test #'eql))
       ;; Resolve only text-bearing classes once, rather than interpreting every
       ;; API class's type specifier again for every node in the widget tree.
       (text-classes (loop for record in *api*
                           when (find 'text (fourth record) :key #'first)
                             collect (find-class (first record)))))
   (loop for i from 32 below 127 do (setf (gethash i codes) t))
   (walk-widgets (root-of w)
     (lambda (node)
       (flet ((include-text (s) (when (stringp s)
                 (loop for c across s unless (< (char-code c) 32) do (setf (gethash (char-code c) codes) t)))))
         (dolist (class text-classes)
           (when (typep node class)
             (if (typep node 'entry)
                 (let ((root (display-index node)))
                   (if (typep node 'wrapped-text-view)
                       (dolist (code (wrapped-font-codepoints node)) (setf (gethash code codes) t))
                       (map-visible-text-lines node (lambda (line start end x y)
                         (declare (ignore line x y))
                         (include-text (index-substring root start (min end (+ start 256))))))))
                 (include-text (text node)))))
         (when (or (typep node 'list-view) (typep node 'combo-box) (typep node 'notebook))
           (mapc #'include-text (items node)))
         (when (typep node 'table-view) (mapc #'include-text (columns node))))))
   (sort (loop for code being the hash-keys of codes collect code) #'<)))
(defmethod build-wrapped-rows :around ((view wrapped-text-view) offered-width)
 (declare (ignore offered-width))
 (let* ((root (root-of view))
        (*font-codepoints-cache* (if (assoc root *font-codepoints-cache*) *font-codepoints-cache*
                                    (acons root (font-codepoints view) *font-codepoints-cache*))))
   (call-next-method)))
(defun load-covered-font (path size codes)
 "Probe once on a cache miss, then omit unavailable glyphs from the atlas."
 (labels ((load-codes (requested)
            (cffi:with-foreign-object (points :int (length requested))
              (loop for code in requested for i from 0 do (setf (cffi:mem-aref points :int i) code))
              (let ((font (rl:load-font-ex path size points (length requested))))
                (unless (rl:is-font-valid font) (error "Could not load font ~a" path)) font))))
   (let* ((*font-coverage-probe* t) (probe (load-codes codes))
          (supported (remove-if-not
             (lambda (code) (= code (rl:glyph-info-value (rl:get-glyph-info probe code)))) codes)))
     (if (equal codes supported) probe
         (unwind-protect
             (if supported (load-codes supported)
                 (error "Font ~a has none of the requested glyphs." path))
           (rl:unload-font probe))))))
(defstruct (font-glyph-set (:constructor %make-font-glyph-set (codes members signature)))
 codes members signature)
(defgeneric build-font-glyph-set (codes signature))
(defmethod build-font-glyph-set (codes signature)
 (let ((members (make-hash-table :test #'eql)))
   (dolist (code codes) (setf (gethash code members) t))
   (%make-font-glyph-set codes members signature)))
(defgeneric font-glyph-member-p (set code))
(defmethod font-glyph-member-p ((set font-glyph-set) code)
 (gethash code (font-glyph-set-members set)))
(defgeneric font-glyph-signature (codes))
(defmethod font-glyph-signature (codes)
 (loop with hash = 5381 for code in codes
       do (setf hash (logand #xffffffffffffffff (+ (* hash 33) code)))
       finally (return hash)))
(defun intern-font-glyph-set (codes)
 ;; Full content comparison is confined to a fresh discovery/extension, never
 ;; each draw/measurement. Retained atlases own canonical sets across passes.
 (or (and *font-discovery-pass* (gethash codes *font-discovery-pass*))
     (let* ((signature (font-glyph-signature codes))
            (set (or (loop for entry in *font-cache*
                           for candidate = (third (car entry))
                           when (and (font-glyph-set-p candidate)
                                     (= signature (font-glyph-set-signature candidate))
                                     (equal codes (font-glyph-set-codes candidate))) return candidate)
                     (build-font-glyph-set codes signature))))
       (when *font-discovery-pass* (setf (gethash codes *font-discovery-pass*) set))
       set)))
(defun widget-glyph-set (w string)
 (let* ((root (root-of w))
        (repertoire (style-value w :font-glyphs nil))
        (codes (if repertoire
                   (sort (remove-duplicates (map 'list #'char-code repertoire)) #'<)
                   (or (cdr (assoc root *font-codepoints-cache*)) (font-codepoints w))))
        (base (intern-font-glyph-set codes))
        (missing (make-hash-table :test #'eql)))
   ;; Already-covered text examines only STRING, not the window-wide code list.
   (loop for c across (or string "") for code = (char-code c)
         unless (or (< code 32) (font-glyph-member-p base code))
           do (setf (gethash code missing) t))
   (if (zerop (hash-table-count missing)) base
       (let* ((extra (sort (loop for code being the hash-keys of missing collect code) #'<))
              (extensions (when *font-discovery-pass*
                            (or (gethash :glyph-extensions *font-discovery-pass*)
                                (setf (gethash :glyph-extensions *font-discovery-pass*)
                                      (make-hash-table :test #'equal)))))
              (key (list base extra)))
         (or (and extensions (gethash key extensions))
             ;; MERGE may mutate both inputs: neither the canonical base nor
             ;; EXTRA (part of the extension-cache key) may be handed to it.
             (let ((set (intern-font-glyph-set
                          (merge 'list (copy-list (font-glyph-set-codes base)) (copy-list extra) #'<))))
               (when extensions (setf (gethash key extensions) set)) set))))))
(defun lookup-widget-font (w set &key (path (or (style-value w :font) (asdf:system-relative-pathname "lut" "assets/NotoSans-Regular.ttf")))
                                     (font-size (style-value w :font-size)))
 (let* ((size (max 1 (round (* font-size (widget-raster-scale w)))))
        ;; Settings select a new path/size key; avoid filesystem checks on hot lookups.
        ;; EQUAL compares the set structure by identity, not its large code list.
        (key (list (namestring (pathname path)) size set (font-file-stamp path)))
        (hit (assoc key *font-cache* :test #'equal))
        (font (or (cdr hit)
                  (let ((font (load-covered-font path size (font-glyph-set-codes set))))
                    (push (cons key font) *font-cache*) font))))
   (pushnew font *used-fonts* :test #'eq) font))
(defun widget-font (w &optional string)
 (when (and *text-run-font* (eq w (first *text-run-font*))
            (every (lambda (c) (or (< (char-code c) 32)
                                  (font-glyph-member-p (third *text-run-font*) (char-code c))))
                   (or string "")))
   (return-from widget-font (second *text-run-font*)))
 (lookup-widget-font w (widget-glyph-set w string)))
(defun expand-display-tabs (w string)
 (if (find #\Tab string)
     (with-output-to-string (out)
       (loop for character across string do
         (if (char= character #\Tab) (write-string (make-string (style-value w :tab-size 4) :initial-element #\Space) out)
             (write-char character out)))) string))
(defmethod text-width ((w label) string)
 (rl:vector2-x (rl:measure-text-ex (widget-font w string) (expand-display-tabs w string)
                   (style-value w :font-size) (style-value w :font-spacing))))
(defmethod text-width ((w notebook) string)
 (if *active-window*
     (rl:vector2-x (rl:measure-text-ex (widget-font w string) string
                     (style-value w :font-size) (style-value w :font-spacing)))
     (call-next-method)))
(defun draw-string (w string px py &optional color)
 (let ((font (widget-font w string)) (display (expand-display-tabs w string))
       (foreground (or color (style-value w :foreground)))
       (raster-scale (widget-raster-scale w)))
   ;; Snap to backing pixels, preserving half-window-unit origins on Retina.
   (setf px (/ (round (* px raster-scale)) raster-scale)
         py (/ (round (* py raster-scale)) raster-scale))
   (flet ((draw (x y)
            (rl:draw-text-ex font display (rl:vec2 x y) (style-value w :font-size) (style-value w :font-spacing) foreground)
            (when (style-value w :bold)
              (rl:draw-text-ex font display (rl:vec2 (+ x 0.6) y) (style-value w :font-size) (style-value w :font-spacing) foreground))))
     (if (style-value w :italic)
         (progn
           (cffi:foreign-funcall "rlPushMatrix" :void)
           (unwind-protect
                (progn
                  (cffi:foreign-funcall "rlTranslatef" :float (float (+ px 3)) :float (float py) :float 0.0 :void)
                  (cffi:with-foreign-object (matrix :float 16)
                    (dotimes (i 16) (setf (cffi:mem-aref matrix :float i) (if (member i '(0 5 10 15)) 1.0 0.0)))
                    (setf (cffi:mem-aref matrix :float 4) -0.18)
                    (cffi:foreign-funcall "rlMultMatrixf" :pointer matrix :void))
                  (draw 0 0))
             (cffi:foreign-funcall "rlPopMatrix" :void)))
         (draw px py)))))
(defmethod map-text-run-advances :around ((w label) string function)
 (let* ((set (widget-glyph-set w string))
        (font (lookup-widget-font w set))
        (*text-run-font* (list w font set)))
   (call-next-method)))
(defmethod text-character-advance ((w label) character)
 (+ (text-width w (string character)) (style-value w :font-spacing)))
(defmethod text-metric-spacing ((w label)) (style-value w :font-spacing))
(defmethod text-metric-key ((w label))
 (append (call-next-method)
         (list *active-window* (widget-raster-scale w))))
(defun paint-text (w)
 ;; Labels historically overflow their allocation, including tiny allocations.
 ;; Keep viewport clipping/fragment iteration specific to editable controls.
 (unless (typep w 'entry)
   (let ((string (display-text w)) (pad (style-value w :padding)))
     (loop for (start end) in (text-lines string) for row from 0 do
       (draw-string w (subseq string start end) (+ (x w) pad)
                    (+ (y w) pad (* row (line-height w))))))
   (return-from paint-text nil))
 (let* ((*font-codepoints-cache* (list (cons (root-of w) (font-codepoints w))))
        (lh (text-line-box-height w)) (editable (typep w 'entry)))
   (when (and editable (/= (last-cursor w) (cursor w))
              (not (let ((root (root-of w)))
                     (and (typep root 'window) (eq w (first (slot-value root 'text-selection-state)))))))
     (reveal-text-cursor w))
   (let ((root (display-index w)))
     (map-visible-text-lines w
       (lambda (line start end px py)
         (declare (ignore start end))
         (multiple-value-bind (a b advance) (visible-line-fragment w root line)
           (let ((draw-x (+ px advance)))
             (when editable
               (multiple-value-bind (lo hi) (selection w)
                 (setf lo (max a lo) hi (min b hi))
                 (when (< lo hi)
                   (multiple-value-bind (left) (text-position-rectangle w lo)
                     (multiple-value-bind (right) (text-position-rectangle w hi)
                       (rl:draw-rectangle left py (- right left) lh (style-value w :accent)))))))
             (draw-string w (index-substring root a b) draw-x py)
             (when (and editable (<= a (cursor w) b)
                        (typep (root-of w) 'window) (eq w (focused-widget (root-of w))))
               (paint-text-caret w)))))))))
(defun current-drawing-clip ()
  "Return a copy of the current logical drawing clip, or NIL outside rendering."
  (copy-list *clip*))
(defmacro with-drawing-clip ((x y width height) &body body)
  "Intersect a logical clip with its parent; restore native clipping even on errors."
  `(let* ((requested (list ,x ,y ,width ,height))
          (previous *clip*) (*clip* (if previous (intersect-rectangles previous requested) requested)))
     (unwind-protect
          (when (and (plusp (third *clip*)) (plusp (fourth *clip*)))
            (with-ui-scissor ((first *clip*) (second *clip*) (third *clip*) (fourth *clip*)) ,@body))
       (when previous (apply #'begin-ui-scissor previous)))))
(defun paint-text-caret (view)
  (multiple-value-bind (x y width height) (text-caret-rectangle view)
    (multiple-value-bind (vx vy vw vh) (scroll-viewport view)
      (with-drawing-clip (vx vy vw vh)
        (when (and (plusp width) (plusp height))
          (rl:draw-rectangle x y width height (style-value view :foreground)))))))
(defmethod render :around ((dialog dialog))
  (when (and (visible-p dialog) (not (disposed-p dialog)) (not (native-p dialog)))
    (let ((root (root-of dialog)) (backdrop (style-value dialog :backdrop-color))
          (shadow (style-value dialog :shadow-color)) (spread (style-value dialog :shadow-spread)))
      (when (and backdrop (typep root 'window))
        (rl:draw-rectangle (x root) (y root) (width root) (height root) backdrop))
      (when shadow
        (loop for radius from spread downto 1 do
          (let ((width (+ (width dialog) (* 2 radius))) (height (+ (height dialog) (* 2 radius))))
            (rl:draw-rectangle-rounded
              (rl:rect (- (x dialog) radius) (+ (- (y dialog) radius) (style-value dialog :shadow-offset)) width height)
              (/ (* 2 (+ 8 radius)) (max 1 (min width height))) 16 shadow))))))
  (call-next-method))
(defmethod render :around ((w widget))
 (when (and (visible-p w) (not (disposed-p w)))
   (let* ((bounds (list (x w) (y w) (width w) (height w)))
          (clip (intersect-rectangles bounds (or *clip* bounds)))
          (*clip* clip))
     (when (and (plusp (third clip)) (plusp (fourth clip)))
       (with-ui-scissor ((first clip) (second clip) (third clip) (fourth clip))
         (call-next-method)
         (when (and (style-value w :focus-outline-p)
                    (not (typep w '(or date-picker search-control search-submit-button search-clear-button vertical-notebook selection-list context-menu-item)))
                    (typep (root-of w) 'window) (eq w (focused-widget (root-of w)))
                    (focus-visible-p (root-of w)))
           ;; Elevated faces need an inner ring so focus cannot cover their
           ;; highlight or lower shadow. Check/switch indicators use the usual ring.
           (let* ((elevated (or (typep w 'dropdown)
                               (and (typep w 'button)
                                    (or (not (typep w 'check-button))
                                        (and (typep w 'toggle-button) (not (typep w 'switch)))))))
                  (depth (if elevated (button-depth w) 0))
                  ;; Dropdown captions fill the face: keep focus at its perimeter.
                  (inset (if (and (plusp depth) (not (typep w 'dropdown))) 4 1))
                  (fw (max 0 (- (width w) (* 2 inset))))
                  (fh (max 0 (- (if (typep w 'expander) (line-height w) (height w)) depth (* 2 inset)))))
             (when (and (plusp fw) (plusp fh))
               (rl:draw-rectangle-rounded-lines-ex
                 (rl:rect (+ (x w) inset)
                          (+ (y w) inset (if (and elevated (button-depressed-p w)) depth 0)) fw fh)
                 (resolved-roundness w fw fh) 12 2 (style-value w :focus-color))))))
       (dolist (child (active-children w)) (render-widget-node child))))))
(defmethod render ((w widget)) nil)
(defmethod render ((w panel)) (paint-surface w (style-value w :surface)))
(defmethod render ((w menu-separator))
 (let ((pad (style-value w :padding)))
   (rl:draw-line (+ (x w) pad) (+ (y w) (/ (height w) 2))
                 (max (+ (x w) pad) (- (+ (x w) (width w)) pad)) (+ (y w) (/ (height w) 2))
                 (style-value w :border-color))))
(defun paint-wrapped-label (w)
 (loop for line in (wrapped-label-lines w) for row from 0 do
   (draw-string w line (+ (x w) (style-value w :padding))
     (+ (y w) (style-value w :padding) (* row (line-height w))))))
(defmethod render ((w label))
 (if (style-value w :wrap-text) (paint-wrapped-label w) (paint-text w)))
(defun paint-caption (w &optional (right-space 0) (alignment :center) color (offset 0))
 "Paint each caption line, preserving multiline labels and indicator space."
 (let* ((string (display-text w)) (lines (text-lines string))
        (pad (style-value w :padding)) (lh (line-height w))
        (block-height (+ (style-value w :font-size) (* (max 0 (1- (length lines))) lh)))
        (top (+ (y w) (max 0 (/ (- (height w) block-height) 2)))))
   (loop for (start end) in lines for row from 0
         for line = (subseq string start end) do
     (draw-string w line
       (+ (x w) (if (eq alignment :left) pad
                    (max pad (/ (- (width w) right-space (text-width w line)) 2))))
       (+ top offset (* row lh)) color))))
(defun indicator-color (w)
 (style-value w (if (eq (widget-state w) :disabled) :disabled-color :accent)))
(defun button-depth (w)
 (if (eq (widget-state w) :disabled) 0
     (min (style-value w :button-depth) (/ (height w) 4))))
(defun button-depressed-p (w)
 (or (eq (widget-state w) :pressed)
     (and (typep w 'toggle-button) (value w))
     (and (typep w 'dropdown) (expanded-p w))))
(defun button-caption-offset (w)
 (* (button-depth w) (if (button-depressed-p w) 0.5 -0.5)))
(defun paint-button-surface (w &optional color)
 "Keep elevation inside the hit rectangle; pressed faces sink into its shadow."
 (let* ((depth (button-depth w)) (down (button-depressed-p w))
        (fy (+ (y w) (if down depth 0))) (fh (- (height w) depth))
        (border (style-value w :border-width)))
   (if (zerop depth)
       (paint-surface w color)
       (progn
         (paint-rounded w (x w) (y w) (width w) (height w)
           (style-value w :border-radius) (style-value w :button-shadow))
         (paint-rounded w (x w) fy (width w) fh
           (style-value w :border-radius) (or color (surface-color w)))
         (when (plusp border)
           (rl:draw-rectangle-rounded-lines-ex (rl:rect (x w) fy (width w) fh)
             (resolved-roundness w (width w) fh) 12 border (style-value w :border-color)))
         (unless down
           (let ((inset (max 2 (* 0.5 fh (resolved-roundness w (width w) fh)))))
             (when (> (width w) (* 2 inset))
               (rl:draw-line-ex (rl:vec2 (+ (x w) inset) (+ fy 1))
                 (rl:vec2 (- (+ (x w) (width w)) inset) (+ fy 1))
                 1 (style-value w :button-highlight)))))))))
(defmethod render ((w button))
 (paint-button-surface w)
 (paint-caption w 0 :center nil (button-caption-offset w)))
(defmethod render ((w command-menu-heading))
 ;; Menu headings are text on the menu strip, with a flat hover highlight.
 (when (or (hovered-p w) (pressed-p w)
           (and (eq w (focused-widget (root-of w))) (focus-visible-p (root-of w)))
           (some (lambda (menu) (and (typep menu 'context-menu) (eq (popup-owner menu) w)))
                 (slot-value (root-of w) 'overlays)))
   (rl:draw-rectangle (x w) (y w) (width w) (height w) (style-value w :hover-color)))
 (paint-caption w 0 :center nil 0))
(defmethod render ((w context-menu-item))
 (let* ((root (root-of w))
        (active (and (enabled-p w)
                     (or (hovered-p w) (pressed-p w)
                         (and (eq w (focused-widget root)) (focus-visible-p root)))))
        (color (if (enabled-p w) (style-value w (if active :on-accent :foreground))
                   (style-value w :muted-color (style-value w :foreground))))
        (pad (style-value w :padding))
        (hint (context-item-shortcut-label w))
        (hint-width (if (plusp (length hint)) (text-width w hint) 0))
        (hint-space (if (plusp hint-width) (+ 24 hint-width) 0)))
   (when active
     (paint-rounded w (x w) (y w) (width w) (height w)
                    (style-value w :border-radius) (style-value w :accent)))
   (draw-string w (fit-caption w (text w) (max 0 (- (width w) (* 2 pad) 16 hint-space)))
                (+ (x w) pad) (+ (y w) (/ (- (height w) (style-value w :font-size)) 2)) color)
   (when (plusp hint-width)
     (draw-string w hint (- (+ (x w) (width w)) pad 16 hint-width)
                  (+ (y w) (/ (- (height w) (style-value w :font-size)) 2)) color))
   (when (context-item-submenu-p w)
     (let ((cx (- (+ (x w) (width w)) 12)) (cy (+ (y w) (/ (height w) 2))))
       (rl:draw-line-ex (rl:vec2 (- cx 2) (- cy 4)) (rl:vec2 (+ cx 2) cy) 1.5 color)
       (rl:draw-line-ex (rl:vec2 (+ cx 2) cy) (rl:vec2 (- cx 2) (+ cy 4)) 1.5 color)))))
(defmethod render ((w entry)) (paint-surface w) (paint-text w))
(defmethod render ((w check-button))
