(in-package #:lut)

(defun paint-model-row (view key index py)
 (cond ((and (view-selection view) (selection-contains-p (view-selection view) key)) (paint-row-selection view py))
       ((eql index (hovered-row view)) (paint-row-selection view py (style-value view :hover-color)))))
(defun model-row-color (view key)
 (style-value view (if (and (view-selection view) (selection-contains-p (view-selection view) key)) :on-accent :foreground)))
(defmethod render ((view model-list-view))
 (paint-list-surface view)
 (map-visible-model-rows view
   (lambda (index key item px py width height)
     (declare (ignore width height))
     (paint-model-row view key index py)
     (let ((indent 0) (label (funcall (row-label-function view) item)))
       (when (typep view 'model-tree-view)
         (setf indent (* 16 (1+ (model-depth (view-model view) index))))
         (when (model-branch-p (view-model view) index)
           (draw-string view (if (tree-expanded-p (view-model view) key) "-" "+")
                        (+ px (style-value view :padding) (- indent 16)) (row-text-y view py) (model-row-color view key))))
       (draw-string view label (+ px (style-value view :padding) indent) (row-text-y view py) (model-row-color view key))))))
(defun paint-model-cell (view index key column-index left py cw clip)
 (let* ((presentation (cell-presentation view index column-index))
        (selected (and (view-selection view) (selection-contains-p (view-selection view) key)))
        (cell-clip (intersect-rectangles clip (list left py cw (row-height view)))))
   (with-ui-scissor ((first cell-clip) (second cell-clip) (third cell-clip) (fourth cell-clip))
     (when (and (not selected) (getf presentation :background))
       (rl:draw-rectangle left py cw (row-height view) (getf presentation :background)))
     (draw-string view (getf presentation :text) (+ left (style-value view :padding)) (row-text-y view py)
       (if selected (model-row-color view key) (or (getf presentation :foreground) (model-row-color view key)))))))
(defmethod render ((view model-table-view))
 (paint-list-surface view)
 (let* ((columns (table-columns view)) (cw (model-table-column-width view)) (rh (row-height view))
        (offset (table-horizontal-offset view))
        (start (floor offset (max 1 cw)))
        (end (min (length columns) (ceiling (+ offset (width view)) (max 1 cw))))
        (clip (intersect-rectangles *clip* (list (x view) (+ (y view) rh) (width view) (model-viewport-height view)))))
   (when (and (plusp (third clip)) (plusp (fourth clip)))
     (with-ui-scissor ((first clip) (second clip) (third clip) (fourth clip))
       (map-visible-model-rows view
         (lambda (index key item px py width height)
           (declare (ignore item width height))
           (paint-model-row view key index py)
           (loop for c from start below end do
             (paint-model-cell view index key c (+ px (* c cw) (- offset)) py cw clip)
             (begin-ui-scissor (first clip) (second clip) (third clip) (fourth clip)))))))
   (let ((header (intersect-rectangles *clip* (list (x view) (y view) (width view) rh))))
     (loop for c from start below end for column = (nth c columns)
           for left = (+ (x view) (* c cw) (- offset))
           for cell = (intersect-rectangles header (list left (y view) cw rh)) do
       (with-ui-scissor ((first cell) (second cell) (third cell) (fourth cell))
         (draw-string view (data-column-title column) (+ left (style-value view :padding)) (row-text-y view (y view))))))))
