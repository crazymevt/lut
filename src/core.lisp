(defun make-widget (class &rest initargs) "Construct CLASS with CLOS initargs." (apply #'make-instance class initargs))
(defmacro with-ui ((class &rest initargs) &body children)
 "Build a tree: (with-ui (box :spacing 4) (make-widget 'label :text \"Hi\"))."
 `(let ((node (make-instance ',class ,@initargs)))
    ,@(loop for child in children collect `(add-child node ,child)) node))
(defun walk-widgets (root function)
 "Call FUNCTION in preorder, including ROOT."
 (funcall function root) (dolist (child (children root)) (walk-widgets child function))
 (when (typep root 'window)
   (dolist (overlay (slot-value root 'overlays)) (walk-widgets overlay function))))
(defun add-child (container child)
 "Reparent CHILD, rejecting cycles. Return CHILD."
 (ensure-live container) (ensure-live child)
 (loop for p = container then (parent p) while p
       when (eq p child) do (error "A widget cannot contain itself or an ancestor."))
 (when (parent child) (remove-child (parent child) child))
 (setf (parent child) container (children container) (append (children container) (list child))) child)
(defgeneric cancel-drag (window)
 (:documentation "Cancel a pending or active drag, releasing capture and references. Return whether one existed."))
(defmethod cancel-drag ((window widget)) nil)
(defgeneric cancel-subtree-drag (window subtree))
(defmethod cancel-subtree-drag ((window widget) subtree) (declare (ignore subtree)) nil)
(defgeneric cancel-text-selection (window &key forget-clicks))
(defmethod cancel-text-selection ((window widget) &key forget-clicks) (declare (ignore forget-clicks)) nil)
(defgeneric release-presentation-overlays (root subtree))
(defmethod release-presentation-overlays ((root widget) subtree) (declare (ignore subtree)) nil)
(defgeneric prepare-modal-presentation (root))
(defmethod prepare-modal-presentation ((root widget)) nil)
(defgeneric nonmodal-overlay-p (overlay))
(defmethod nonmodal-overlay-p ((overlay widget)) nil)
(defgeneric reset-text-presentation (view))
(defmethod reset-text-presentation ((view widget)) nil)
(defgeneric remap-text-presentation (view start old-end new-end))
(defmethod remap-text-presentation ((view widget) start old-end new-end)
 (declare (ignore start old-end new-end)) nil)
(defun release-input-references (root subtree)
 (release-presentation-overlays root subtree)
 (cancel-subtree-drag root subtree)
 (let ((nodes nil))
   (walk-widgets subtree (lambda (node) (push node nodes) (setf (hovered-p node) nil (pressed-p node) nil)))
   (when (typep root 'window)
     (when (member (focused-widget root) nodes) (setf (focused-widget root) nil))
     (when (member (slot-value root 'pressed-widget) nodes) (setf (slot-value root 'pressed-widget) nil))
     (when (member (first (slot-value root 'text-selection-state)) nodes) (cancel-text-selection root))
     (when (member (first (slot-value root 'text-click-state)) nodes) (setf (slot-value root 'text-click-state) nil))
     (when (intersection nodes (slot-value root 'interaction-state) :test #'eq)
       (setf (slot-value root 'interaction-state) nil)))))
(defun remove-child (container child &key dispose)
 "Detach CHILD for reuse, clearing focus/capture. With :DISPOSE T, destroy its subtree too."
 (when (eq (parent child) container)
   (release-input-references (root-of container) child)
   (setf (slot-value container 'children) (remove child (children container)))
   (when (typep container 'window)
     (setf (slot-value container 'overlays) (remove child (slot-value container 'overlays))))
   (setf (slot-value child 'parent) nil))
 (when dispose (dispose child)) child)
(defun root-of (widget) (if (parent widget) (root-of (parent widget)) widget))
(defstruct connection source owner event callback (active-p t))
(defun ensure-live (widget)
 (when (disposed-p widget) (error "Widget ~s has been disposed." widget)) widget)
(defun on (widget event callback &key owner)
 "Register CALLBACK (widget payload). OWNER optionally disconnects this binding when disposed.
Return CALLBACK and, as a second value, a CONNECTION handle for DISCONNECT."
 (ensure-live widget) (when owner (ensure-live owner))
 (unless (keywordp event) (error 'type-error :datum event :expected-type 'keyword))
 (unless (or (functionp callback) (symbolp callback))
   (error 'type-error :datum callback :expected-type '(or function symbol)))
 (let ((connection (make-connection :source widget :owner owner :event event :callback callback)))
   (push connection (slot-value widget 'handlers))
   (when owner (push connection (slot-value owner 'connections)))
   (values callback connection)))
(defun disconnect (connection)
 "Idempotently disconnect CONNECTION and clear its source, owner and callback references."
 (when (connection-active-p connection)
   (let ((source (connection-source connection)) (owner (connection-owner connection)))
     (when source (setf (slot-value source 'handlers) (remove connection (slot-value source 'handlers))))
     (when owner (setf (slot-value owner 'connections) (remove connection (slot-value owner 'connections)))))
   (setf (connection-active-p connection) nil (connection-source connection) nil
         (connection-owner connection) nil (connection-callback connection) nil)) connection)
(defun off (widget &optional event callback)
 "Remove matching bindings. NIL EVENT/CALLBACK match any event/callback. Return number removed."
 (let ((count 0))
   (dolist (connection (copy-list (slot-value widget 'handlers)))
     (when (and (or (null event) (eq event (connection-event connection)))
                (or (null callback) (eq callback (connection-callback connection))))
       (disconnect connection) (incf count))) count))
(defun has-handler-p (widget event)
 (some (lambda (c) (and (connection-active-p c) (eq event (connection-event c))))
       (slot-value widget 'handlers)))
(defun emit (widget event &optional payload)
 "Invoke active handlers in registration order; disconnected bindings are skipped even during emission."
 (unless (disposed-p widget)
   (dolist (connection (reverse (copy-list (slot-value widget 'handlers))))
     (when (and (connection-active-p connection) (eq event (connection-event connection)))
       (funcall (connection-callback connection) widget payload)))))
(defgeneric layout (widget x y width height))
(defmethod layout ((w widget) x y width height)
 (setf (x w) x (y w) y (width w) (max 0 width) (height w) (max 0 height)) w)
(defun scroll-content-height (w)
 (let ((visible (remove-if-not #'visible-p (children w))))
   (+ (* 2 (style-value w :padding))
      (loop for c in visible sum (height c))
      (* (max 0 (1- (length visible))) (spacing w)))))
(defun scroll-range (w) (max 0 (- (scroll-content-height w) (height w))))
(defun scrollbar-bounds (w)
 (let* ((size (min (width w) (style-value w :scrollbar-width)))
        (extent (scroll-content-height w))
        (thumb (min (height w) (max 20 (* (height w) (/ (height w) (max 1 extent))))))
        (travel (- (height w) thumb)))
   (values (- (+ (x w) (width w)) size)
           (+ (y w) (* travel (/ (min (scroll-offset w) (scroll-range w)) (max 1 (scroll-range w)))))
           size thumb travel)))
(defun drag-scrollbar (view pointer-y offset)
 (multiple-value-bind (sx sy sw sh travel) (scrollbar-bounds view)
   (declare (ignore sx sy sw sh))
   (setf (scroll-offset view)
         (* (scroll-range view) (max 0 (min 1 (/ (- pointer-y (y view) offset) (max 1 travel))))))))
(defmethod layout :after ((w box) x y width height)
 (declare (ignore height))
 (let* ((pad (style-value w :padding 8))
        (horizontal (eq (orientation w) :horizontal))
        (bar (if (and (typep w 'scroll-view) (plusp (scroll-range w)))
                 (style-value w :scrollbar-width) 0))
        (pos (+ (if horizontal x y) pad)))
   (when (typep w 'scroll-view)
     (setf (scroll-offset w) (min (scroll-offset w) (scroll-range w))))
   (dolist (child (children w))
     (when (visible-p child)
       (let ((cw (if horizontal (width child) (max 0 (- width (* 2 pad) bar))))
             (ch (height child)))
         (layout child (if horizontal pos (+ x pad))
                 (if horizontal (+ y pad) (- pos (if (typep w 'scroll-view) (scroll-offset w) 0))) cw ch)
         (incf pos (+ (if horizontal cw ch) (spacing w))))))))
(defun contains-point-p (w px py)
 (and (<= (x w) px) (< px (+ (x w) (width w)))
      (<= (y w) py) (< py (+ (y w) (height w)))))
(defun hit-test (w px py)
 "Return deepest visible enabled widget inside all ancestor bounds."
 (when (and (not (disposed-p w)) (visible-p w) (enabled-p w) (contains-point-p w px py))
   (or (loop for child in (reverse (active-children w)) thereis (hit-test child px py)) w)))
(define-condition unsupported-capability (error)
 ((capability :initarg :capability :reader capability))
 (:report (lambda (c s) (format s "Backend does not support ~a." (capability c)))))
(defgeneric detach-window (dialog)
 (:documentation "Move DIALOG to a native worker window, retaining its authoritative objects and callbacks in the parent REPL."))
(defgeneric modal-blocker (window) (:documentation "Return the active native modal blocking WINDOW, or NIL."))
(defmethod modal-blocker ((window widget)) nil)
(defgeneric focus-modal (blocker))
(defgeneric present-dialog (window dialog))
(defmethod present-dialog ((window window) (dialog dialog)) dialog)
(defun show-dialog (window dialog)
 "Show DIALOG and return it. Native backends use separate windows; the core uses overlays."
 (ensure-live window) (ensure-live dialog)
 (unless (and (typep dialog 'dialog) (not (eq window dialog)))
   (error "Expected a separate dialog instance."))
 (when (parent dialog) (error "Dialog already belongs to a tree."))
 (when (slot-value window 'pressed-widget) (setf (pressed-p (slot-value window 'pressed-widget)) nil))
 (cancel-drag window)
 (cancel-text-selection window :forget-clicks t)
 (prepare-modal-presentation window)
 (setf (parent dialog) window) (push dialog (slot-value window 'overlays))
 (setf (focused-widget window) nil (slot-value window 'pressed-widget) nil)
 (present-dialog window dialog))
(defgeneric surface-closed (dialog))
(defmethod surface-closed ((d widget)) nil)
(defun close-dialog (window)
 "Close the top overlay, or dismiss the native dialog hosted by WINDOW."
 (let ((d (find-if-not (lambda (overlay) (typep overlay 'tooltip)) (slot-value window 'overlays))))
   (if d (progn (remove-child window d) (surface-closed d) d)
       (let ((native (find-if (lambda (c) (and (typep c 'dialog) (native-p c))) (children window))))
         (when native (dismiss-dialog native)) native))))
(defgeneric render (widget) (:documentation "Draw WIDGET using the loaded backend."))
(defgeneric run (window &key frames) (:documentation "Open WINDOW and run its event loop; FRAMES bounds smoke runs."))
(defun validate-widget (w)
 (dolist (record *api*)
   (when (typep w (first record))
     (dolist (slot (fourth record))
       (validate-slot w (first slot) (slot-value w (first slot)))
       (unless (typep (slot-value w (first slot)) (third slot))
         (error 'type-error :datum (slot-value w (first slot)) :expected-type (third slot))))))
 (when (typep w 'slider)
   (unless (<= (minimum w) (value w) (maximum w))
     (error "Numeric control requires MINIMUM <= VALUE <= MAXIMUM.")))
 w)
(defmethod initialize-instance :after ((w widget) &key)
 (validate-widget w)
 (let ((initial (copy-list (children w))))
   (setf (children w) nil)
   (dolist (child initial) (add-child w child))))

(defun range-fraction (control)
 "Return VALUE's clamped fraction in MINIMUM..MAXIMUM. A zero-width range returns zero."
 (let ((range (- (maximum control) (minimum control))))
   (if (zerop range) 0 (max 0 (min 1 (/ (- (value control) (minimum control)) range))))))
(defmethod validate-slot ((w slider) slot new-value)
 (when (and (slot-boundp w 'value) (slot-boundp w 'minimum) (slot-boundp w 'maximum))
   (let ((lo (if (eq slot 'minimum) new-value (minimum w)))
         (hi (if (eq slot 'maximum) new-value (maximum w)))
         (v (if (eq slot 'value) new-value (value w))))
     (unless (<= lo v hi) (error "Numeric control requires MINIMUM <= VALUE <= MAXIMUM."))))
 new-value)

(defun find-widget (root id)
 "Return the first preorder node whose ID is EQUAL to ID, or NIL."
 (walk-widgets root (lambda (w) (when (equal (id w) id) (return-from find-widget w)))) nil)

(defmethod layout :after ((w window) x y width height)
 (when (eq (content-layout w) :fill)
   (dolist (child (active-children w)) (layout child x y width height))))

(defmethod update-instance-for-redefined-class :after ((w widget) added discarded properties &rest initargs)
 (declare (ignore added discarded properties initargs)) (validate-widget w))

(defgeneric dismiss-dialog (dialog)
 (:documentation "Dismiss DIALOG from its current owner, including a detached native host. Use this in dialog response callbacks."))
(defmethod dismiss-dialog ((d dialog))
 (let ((root (root-of d)))
   (when (and (typep root 'window) (member d (slot-value root 'overlays)))
     (remove-child root d) (surface-closed d))) d)

(defmethod initialize-instance :after ((w window) &key ((:theme supplied-theme) nil supplied-p))
 (declare (ignore supplied-theme)) (setf (theme-explicit-p w) supplied-p))
(defmethod (setf theme) :after (new-theme (w window))
 (declare (ignore new-theme)) (setf (theme-explicit-p w) t))

(defgeneric dispose (widget)
 (:documentation "Destroy a widget subtree idempotently. Clears connections, ownership and input references; subclass before/after methods may release custom resources."))
(defmethod dispose ((w widget)) w)
(defgeneric release-command-links (widget))
(defmethod release-command-links ((widget widget)) nil)
(defun release-widget-references (w)
 (let (failure)
   (handler-case (release-command-links w) (error (e) (setf failure e)))
   (flet ((destroy (child)
            (handler-case (dispose child) (error (e) (unless failure (setf failure e))))))
     (release-input-references (root-of w) w)
     (when (parent w) (remove-child (parent w) w))
     (dolist (child (copy-list (children w))) (destroy child))
     (when (typep w 'window)
       (dolist (overlay (copy-list (slot-value w 'overlays))) (destroy overlay))
       (setf (slot-value w 'overlays) nil (slot-value w 'focused-widget) nil
             (slot-value w 'pressed-widget) nil (slot-value w 'interaction-state) nil
             (slot-value w 'text-selection-state) nil (slot-value w 'text-click-state) nil
             (slot-value w 'style-source) nil (slot-value w 'style-rules) nil (slot-value w 'theme) nil)))
   (dolist (c (append (copy-list (slot-value w 'handlers)) (copy-list (slot-value w 'connections)))) (disconnect c))
   (setf (slot-value w 'tab-badge) nil (slot-value w 'children) nil (slot-value w 'handlers) nil (slot-value w 'connections) nil
         (slot-value w 'style) nil (slot-value w 'state-style) nil)
   (when (or (typep w 'label) (typep w 'window) (typep w 'dialog) (typep w 'expander)) (setf (slot-value w 'text) ""))
   (when (typep w 'entry)
     (setf (slot-value w 'cursor) 0 (slot-value w 'anchor) 0
           (slot-value w 'text-offset) 0 (slot-value w 'vertical-offset) 0 (slot-value w 'navigation-x) nil
           (slot-value w 'undo-history) nil (slot-value w 'redo-history) nil))
   (when (typep w 'popover) (setf (slot-value w 'popup-owner) nil))
   (when (or (typep w 'combo-box) (typep w 'notebook) (typep w 'list-view)) (setf (slot-value w 'items) nil))
   (when (typep w 'image) (setf (slot-value w 'source) nil))
   (when (typep w 'drawing-area) (setf (slot-value w 'draw-function) nil))
   (when (typep w 'table-view) (setf (slot-value w 'rows) nil (slot-value w 'columns) nil))
   (when (typep w 'tree-view) (setf (slot-value w 'nodes) nil))
   (when (typep w 'radio-button)
     (dolist (peer (group w)) (setf (slot-value peer 'group) (remove w (group peer))))
     (setf (slot-value w 'group) nil))
   (when failure (error failure))) w)
(defmethod dispose :around ((w widget))
 (unless (disposed-p w)
   (setf (slot-value w 'disposed-p) t)
   (unwind-protect (call-next-method) (release-widget-references w))) w)

(defmethod validate-slot :before ((w widget) slot value)
 (when (and (eq slot 'disposed-p) (not (eq value (disposed-p w))))
   (error "Disposed state is managed by DISPOSE; it cannot be assigned or reversed.")))
