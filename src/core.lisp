(in-package #:lut)
(defvar *api* nil "Declarative class metadata used by the docset generator.")
(defgeneric validate-slot (widget slot value)
 (:documentation "Validate a proposed live slot update before assignment; signal an error to reject it."))
(defmethod validate-slot ((w t) slot value)
 (declare (ignore w slot)) value)
(defmacro defwidget (name supers documentation slots)
 "Define a documented widget and validated accessors. Re-evaluation updates existing CLOS instances lazily."
 `(progn
     (setf *api* (remove ',name *api* :key #'first))
     (push (list ',name ',supers ,documentation ',slots) *api*)
     (defclass ,name ,supers
       ,(loop for (slot init type doc) in slots
              collect `(,slot :initarg ,(intern (symbol-name slot) :keyword)
                              :initform ,init :accessor ,slot :type ,type :documentation ,doc))
       (:documentation ,documentation))
     ,@(loop for spec in slots for slot = (first spec) for type = (third spec)
             collect `(defmethod (setf ,slot) :before (new-value (object ,name))
                        (unless (typep new-value ',type)
                          (error 'type-error :datum new-value :expected-type ',type))
                        (validate-slot object ',slot new-value)))
     ',name))
