(in-package #:lut)
(defun tab-strip-geometry (book)
 "Return tab width, viewport X/width, navigation width, and total strip extent."
 (let* ((count (length (children book)))
        (preferred (max (style-value book :tab-min-width)
                       (min (style-value book :tab-max-width)
                            (+ (* 2 (style-value book :padding))
                               (loop for title in (items book) repeat count maximize (text-width book title) into size
                                     finally (return (or size 0)))))))
        (overflow (> (* count preferred) (width book)))
        (button (if overflow (min (style-value book :title-height) (/ (width book) 2)) 0))
        (viewport (max 0 (- (width book) (* 2 button))))
        (tab-width (if overflow preferred (/ (width book) (max 1 count)))))
   (values tab-width (+ (x book) button) viewport button (* count tab-width))))
(defun tab-scroll-limit (book)
 (multiple-value-bind (tab x viewport button extent) (tab-strip-geometry book)
   (declare (ignore tab x button)) (max 0 (- extent viewport))))
(defun scroll-tabs (book delta)
 "Scroll NOTEBOOK's header by DELTA pixels and return its clamped offset, without changing selection."
 (setf (tab-reveal-p book) nil
       (tab-offset book) (max 0 (min (tab-scroll-limit book) (+ (tab-offset book) delta)))))
(defun reveal-page (book &optional (index (value book)))
 "Reveal notebook page INDEX without selecting it; return the new tab offset."
 (unless (and (typep index '(integer 0 *)) (< index (length (children book))))
   (error "Page index out of range."))
 (multiple-value-bind (tab x viewport) (tab-strip-geometry book)
   (declare (ignore x))
   (let ((left (* index tab)) (offset (tab-offset book)))
     (setf (tab-offset book)
           (max 0 (min (tab-scroll-limit book)
             (cond ((< left offset) left)
                   ((> (+ left tab) (+ offset viewport))
                    ;; A tab wider than the viewport exposes its beginning.
                    (if (> tab viewport) left (- (+ left tab) viewport)))
                   (t offset))))
           (tab-reveal-p book) nil))))
(defun tab-strip-position-p (book x y)
 (multiple-value-bind (tab left viewport) (tab-strip-geometry book)
   (declare (ignore tab))
   (and (contains-point-p book x y) (< y (+ (y book) (style-value book :title-height)))
        (<= left x) (< x (+ left viewport)))))
(defun tab-at-position (book x y)
 "Return the visible tab index at root coordinates X/Y, or NIL for arrows, body or empty space."
 (when (and (children book) (tab-strip-position-p book x y))
   (multiple-value-bind (tab left) (tab-strip-geometry book)
     (let ((index (floor (+ (- x left) (tab-offset book)) tab)))
       (when (< -1 index (length (children book))) index)))))
(defun tab-insertion-position (book index)
 (multiple-value-bind (tab left viewport) (tab-strip-geometry book)
   (max left (min (+ left (max 0 (- viewport 2))) (+ left (* index tab) (- (tab-offset book)))))))
(defmethod (setf value) :after (value (book notebook))
 (setf (tab-reveal-p book) t)
 (when (< value (length (children book))) (reveal-page book value)))
(defmethod (setf items) :after (items (book notebook))
 (declare (ignore items)) (setf (tab-reveal-p book) t))
(defmethod layout :after ((book notebook) x y width height)
 (declare (ignore x y width height))
 (multiple-value-bind (tab left viewport button extent) (tab-strip-geometry book)
   (declare (ignore tab left viewport button))
   (setf (tab-offset book) (min (tab-offset book) (tab-scroll-limit book)))
   (when (and (children book)
              (or (tab-reveal-p book) (/= (width book) (tab-layout-width book))
                  (/= extent (tab-layout-extent book))))
     (reveal-page book (min (value book) (1- (length (children book))))))
   (setf (tab-layout-width book) (width book) (tab-layout-extent book) extent)))
