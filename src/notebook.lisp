(in-package #:lut)
(defgeneric tab-action-width (book index)
 (:documentation "Extra trailing space before the close control, reserved for application tab actions."))
(defmethod tab-action-width ((book notebook) index) (declare (ignore index)) 0)
(defun tab-content-width (book index)
 (max (style-value book :tab-min-width)
      (+ (* 2 (style-value book :padding)) (text-width book (tab-caption book index))
         (tab-action-width book index)
         (if (closable-p book) (style-value book :title-height) 0))))
(defun tab-strip-geometry (book)
 "Return nominal tab width, viewport X/width, navigation width, and strip extent."
 (let* ((count (length (children book)))
        (content-p (eq (style-value book :tab-sizing) :content))
        (preferred (max (style-value book :tab-min-width)
                        (min (style-value book :tab-max-width)
                             (loop for i below count maximize (tab-content-width book i) into size
                                   finally (return (or size 0))))))
        (extent (if content-p (loop for i below count sum (tab-content-width book i)) (* count preferred)))
        (overflow (> extent (width book)))
        (button (if overflow (min (style-value book :title-height) (/ (width book) 2)) 0))
        (viewport (max 0 (- (width book) (* 2 button))))
        (tab-width (if (or content-p overflow) preferred (/ (width book) (max 1 count)))))
   (values tab-width (+ (x book) button) viewport button (if content-p extent (* count tab-width)))))
(defun tab-widths (book)
 (if (eq (style-value book :tab-sizing) :content)
     (loop for i below (length (children book)) collect (tab-content-width book i))
     (make-list (length (children book)) :initial-element (nth-value 0 (tab-strip-geometry book)))))
(defun tab-width-at (book index)
 (if (eq (style-value book :tab-sizing) :content) (tab-content-width book index)
     (nth-value 0 (tab-strip-geometry book))))
(defun tab-start (book index)
 (if (eq (style-value book :tab-sizing) :content)
     (loop for i below index sum (tab-content-width book i))
     (* index (nth-value 0 (tab-strip-geometry book)))))
(defun tab-scroll-limit (book)
 (multiple-value-bind (tab x viewport button extent) (tab-strip-geometry book)
   (declare (ignore tab x button)) (max 0 (- extent viewport))))
(defun scroll-tabs (book delta)
 "Scroll NOTEBOOK's header by DELTA pixels and return its clamped offset, without changing selection."
 (setf (tab-reveal-p book) nil
       (tab-offset book) (max 0 (min (tab-scroll-limit book) (+ (tab-offset book) delta)))))
(defun reveal-page (book &optional (index (value book)))
 "Reveal notebook page INDEX without selecting it; return the new tab offset."
 (unless (and (typep index '(integer 0 *)) (< index (length (children book))))
   (error "Page index out of range."))
 (multiple-value-bind (tab x viewport) (tab-strip-geometry book)
   (declare (ignore x))
   (let ((left (tab-start book index)) (tab (tab-width-at book index)) (offset (tab-offset book)))
     (setf (tab-offset book)
           (max 0 (min (tab-scroll-limit book)
             (cond ((< left offset) left)
                   ((> (+ left tab) (+ offset viewport))
                    ;; A tab wider than the viewport exposes its beginning.
                    (if (> tab viewport) left (- (+ left tab) viewport)))
                   (t offset))))
           (tab-reveal-p book) nil))))
(defun tab-strip-position-p (book x y)
 (multiple-value-bind (tab left viewport) (tab-strip-geometry book)
   (declare (ignore tab))
   (and (contains-point-p book x y) (< y (+ (y book) (style-value book :title-height)))
        (<= left x) (< x (+ left viewport)))))
(defun tab-at-position (book x y)
 "Return the visible tab index at root coordinates X/Y, or NIL."
 (when (typep book 'vertical-notebook)
   (return-from tab-at-position (vertical-tab-at-position book x y)))
 (when (and (children book) (tab-strip-position-p book x y))
   (multiple-value-bind (tab left) (tab-strip-geometry book)
     (declare (ignore tab))
     (let ((position (+ (- x left) (tab-offset book))))
       (loop with start = 0 for width in (tab-widths book) for i from 0
             when (<= start position) do (when (< position (+ start width)) (return i))
             do (incf start width))))))
(defun tab-insertion-position (book index)
 (multiple-value-bind (tab left viewport) (tab-strip-geometry book)
   (declare (ignore tab))
   (max left (min (+ left (max 0 (- viewport 2))) (+ left (tab-start book index) (- (tab-offset book)))))))
(defmethod (setf value) :after (value (book notebook))
 (setf (tab-reveal-p book) t)
 (when (< value (length (children book))) (reveal-page book value)))
(defmethod (setf items) :after (items (book notebook))
 (declare (ignore items)) (setf (tab-reveal-p book) t))
(defmethod layout :after ((book notebook) x y width height)
 (declare (ignore x y width height))
 (multiple-value-bind (tab left viewport button extent) (tab-strip-geometry book)
   (declare (ignore tab left viewport button))
   (setf (tab-offset book) (min (tab-offset book) (tab-scroll-limit book)))
   (when (and (children book)
              (or (tab-reveal-p book) (/= (width book) (tab-layout-width book))
                  (/= extent (tab-layout-extent book))))
     (reveal-page book (min (value book) (1- (length (children book))))))
   (setf (tab-layout-width book) (width book) (tab-layout-extent book) extent)))

(defclass page-close-request ()
 ((page :initarg :page :reader close-request-page)
  (reason :initarg :reason :reader close-request-reason)
  (veto :initform nil :accessor close-request-veto-p)))
(defun tab-caption (book index)
 (let* ((page (nth index (children book))) (badge (tab-badge page))
        (title (or (nth index (items book)) "Page")))
   (format nil "~a~@[ [~a]~]" title badge)))
(defun tab-close-position-p (book index x)
 (multiple-value-bind (tab left) (tab-strip-geometry book)
   (declare (ignore tab))
   (let ((width (tab-width-at book index)))
     (>= x (- (+ left (tab-start book index) width (- (tab-offset book)))
              (min width (style-value book :title-height)))))))
(defun request-page-close (book page &key (reason :application))
 "Emit :PAGE-CLOSE-REQUEST with a vetoable request. On acceptance detach (do not dispose) PAGE, preserve selection and emit :PAGE-CLOSED. Return T when closed."
 (check-type book notebook) (ensure-live book) (ensure-live page)
 (unless (eq (parent page) book) (error "PAGE must belong to BOOK."))
 (let ((request (make-instance 'page-close-request :page page :reason reason)))
   (emit book :page-close-request request)
   (when (or (close-request-veto-p request) (disposed-p book) (not (eq (parent page) book)))
     (return-from request-page-close nil))
   (let* ((index (position page (children book))) (selected (nth (value book) (children book)))
          (titles (notebook-titles book)))
     (remove-child book page)
     (setf (items book) (append (subseq titles 0 index) (nthcdr (1+ index) titles))
           (value book) (or (position selected (children book))
                            (max 0 (min index (1- (length (children book)))))))
     (emit book :change (value book))
     (emit book :page-closed request) t)))

(defun vertical-tab-width (book)
 (min (width book) (tab-strip-width book)))
(defun vertical-tab-scroll-limit (book)
 (max 0 (- (* (length (children book)) (row-height book)) (height book))))
(defun vertical-tab-at-position (book px py)
 (when (and (contains-point-p book px py) (< px (+ (x book) (vertical-tab-width book))))
   (let ((index (floor (+ (- py (y book)) (tab-offset book)) (row-height book))))
     (when (< -1 index (length (children book))) index))))
(defun reveal-vertical-page (book)
 (let* ((top (* (value book) (row-height book))) (offset (tab-offset book)))
   (setf (tab-offset book)
     (max 0 (min (vertical-tab-scroll-limit book)
       (cond ((< top offset) top)
             ((> (+ top (row-height book)) (+ offset (height book)))
              (- (+ top (row-height book)) (height book)))
             (t offset)))))))
(defmethod (setf value) :after (value (book vertical-notebook))
 (declare (ignore value)) (reveal-vertical-page book))
(defmethod layout :after ((book vertical-notebook) x y width height)
 (let* ((strip (vertical-tab-width book))
        (gap (min (max 0 (- width strip)) (style-value book :padding)))
        (page (first (active-children book))))
   (setf (tab-offset book) (min (tab-offset book) (vertical-tab-scroll-limit book)))
   (when page (layout page (+ x strip gap) y (max 0 (- width strip gap)) height))))
(defun select-vertical-page (book index)
 (when index
   (select-page book index)
   (unless (disposed-p book)
     (layout book (x book) (y book) (width book) (height book)))))
(defun reorder-vertical-page (book from to)
 (let* ((page (nth from (children book))) (selected (nth (value book) (children book)))
        (titles (loop for i below (length (children book)) collect (or (nth i (items book)) "Page")))
        (title (nth from titles))
        (pages (remove page (children book))))
   (setf titles (append (subseq titles 0 from) (nthcdr (1+ from) titles))
         (children book) (append (subseq pages 0 to) (list page) (nthcdr to pages))
         (items book) (append (subseq titles 0 to) (list title) (nthcdr to titles))
         (value book) (position selected (children book)))
   (layout book (x book) (y book) (width book) (height book))
   (emit book :change (value book))
   (emit book :reorder (list from to))))
