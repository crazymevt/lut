(in-package #:lut)

(defclass drag-controller (widget)
 ((windows :initform nil :accessor drag-windows))
 (:documentation "Explicit owner of participating window registrations. All widgets and callbacks stay in the controller Lisp image."))
(defun make-drag-controller () (make-instance 'drag-controller))
(defun register-drag-window (controller window)
 (ensure-live controller) (ensure-live window) (check-type window window)
 (when (and (window-drag-controller window) (not (eq controller (window-drag-controller window))))
   (error "Window already has a drag controller."))
 (unless (typep controller 'drag-controller) (error "Expected a drag controller."))
 (pushnew window (drag-windows controller))
 (setf (window-drag-controller window) controller) window)
(defun cancel-controlled-drags (window)
 (let ((roots (if (window-drag-controller window)
                  (copy-list (drag-windows (window-drag-controller window))) (list window))) (failure nil))
   (dolist (root roots) (handler-case (cancel-drag root) (error (e) (unless failure (setf failure e)))))
   (when failure (error failure))))
(defun unregister-drag-window (controller window)
 (when (eq controller (window-drag-controller window))
   (unwind-protect (cancel-controlled-drags window)
     (setf (window-drag-controller window) nil
           (drag-windows controller) (remove window (drag-windows controller))))) window)
(defmethod dispose :before ((controller drag-controller))
 (let ((failure nil))
   (dolist (root (copy-list (drag-windows controller)))
     (handler-case (unregister-drag-window controller root) (error (e) (unless failure (setf failure e)))))
   (when failure (error failure))))
(defmethod dispose :around ((root window))
 (unwind-protect
   (when (window-drag-controller root) (unregister-drag-window (window-drag-controller root) root))
   (call-next-method)))
(defun transfer-roots-compatible-p (source target)
 (or (eq source target)
     (and (typep source 'window) (typep target 'window)
          (window-drag-controller source)
          (eq (window-drag-controller source) (window-drag-controller target)))))
(defun visible-drag (window)
 (let* ((owner (controlled-drag-owner window)) (session (and owner (current-drag owner))))
   (when (and session (eq window (or (slot-value session 'destination) owner))) session)))
(defun controlled-drag-owner (window)
 (or (and (current-drag window) window)
     (let ((controller (window-drag-controller window)))
       (when controller (find-if #'current-drag (drag-windows controller))))))
(defmethod cancel-subtree-drag :after ((window window) subtree)
 (let ((controller (window-drag-controller window)))
   (when controller
     (dolist (root (drag-windows controller))
       (unless (eq root window)
         (let ((session (current-drag root)))
           (when (and session (within-subtree-p (drag-target session) subtree)) (cancel-drag root))))))))
(defun dispatch-controlled-drag (window event)
 (let* ((owner (controlled-drag-owner window)) (session (and owner (current-drag owner))))
   (when session
     (when (or (modal-blocker owner) (modal-blocker window)
               (not (live-input-widget-p (drag-source session) owner)))
       (cancel-drag owner) (return-from dispatch-controlled-drag t))
     (when (eq (slot-value session 'mode) :keyboard)
       (when (eq (event-kind event) :key)
         (handler-case (dispatch-keyboard-drag owner window session event)
           (error (e) (ignore-errors (cancel-drag owner)) (error e))))
       (return-from dispatch-controlled-drag t))
     ;; Worker events already identify their root. Never interpret them as desktop coordinates.
     (when (and (eq (event-kind event) :move)
                (eq (drag-state session) :dragging)
                (not (contains-point-p window (event-x event) (event-y event))))
       (return-from dispatch-controlled-drag (eq (drag-state session) :dragging)))
     (let ((*drag-owner* owner)) (dispatch-drag owner event window)))))

(defun begin-keyboard-drag (source payload)
 "Start a keyboard drag explicitly. Arrows move in root units, Tab cycles accepted zones, Enter commits and Escape cancels."
 (let* ((root (root-of source))
        (session (begin-drag source payload (make-event :kind :down :x (x source) :y (y source)))))
   (setf (slot-value session 'mode) :keyboard (slot-value session 'state) :dragging)
   (handler-case (emit source :drag-start session)
     (error (e) (finish-drag root session :cancelled) (error e))) session))
(defun keyboard-drag-to (source-window target &optional x y)
 "Aim a keyboard drag at TARGET's center or explicit root X/Y, including a registered peer window."
 (let* ((session (current-drag source-window)) (destination (root-of target)))
   (unless (and session (eq (slot-value session 'mode) :keyboard)
                (transfer-roots-compatible-p source-window destination)
                (live-input-widget-p target destination) (not (modal-blocker destination)))
     (error "Invalid keyboard drag target."))
   (let ((event (make-event :kind :move :x (or x (+ (x target) (/ (width target) 2)))
                           :y (or y (+ (y target) (/ (height target) 2)))))
         (*drag-owner* source-window))
     (dispatch-drag source-window event destination)) session))
(defun dispatch-keyboard-drag (owner window session event)
 (let ((key (event-key event)))
   (cond ((eq key :escape) (cancel-drag owner))
         ((member key '(:enter :space))
          (let* ((target (drag-target session)) (destination (if target (root-of target) window))
                 (*drag-owner* owner))
            (dispatch-drag owner (make-event :kind :up :x (drag-x session) :y (drag-y session)) destination)))
         ((eq key :tab)
          (let ((candidates nil) (controller (window-drag-controller owner)))
            (dolist (root (if controller (drag-windows controller) (list owner)))
              (unless (modal-blocker root)
                (walk-widgets (input-root root) (lambda (node)
                  (let ((probe (make-event :kind :move :x (+ (x node) (/ (width node) 2))
                                          :y (+ (y node) (/ (height node) 2)))))
                    (when (and (live-input-widget-p node root) (accepts-drop-p node session probe))
                      (push node candidates)))))))
            (setf candidates (nreverse candidates))
            (when candidates
              (let* ((index (position (drag-target session) candidates))
                     (next (mod (+ (or index (if (event-shift-p event) 0 -1))
                                   (if (event-shift-p event) -1 1)) (length candidates))))
                (keyboard-drag-to owner (nth next candidates))))))
         ((member key '(:left :right :up :down))
          (let* ((target (drag-target session)) (destination (if target (root-of target) window))
                 (*drag-owner* owner))
            (dispatch-drag owner (make-event :kind :move
              :x (+ (drag-x session) (case key (:left -24) (:right 24) (t 0)))
              :y (+ (drag-y session) (case key (:up -24) (:down 24) (t 0)))) destination))))) t)

(defgeneric drag-autoscroll (widget session seconds)
 (:documentation "Advance drag edge scrolling. Return true when geometry changed; override for custom views."))
(defmethod drag-autoscroll ((widget widget) session seconds) (declare (ignore session seconds)) nil)
(defun drag-edge-step (coordinate start size seconds)
 (let ((edge (min 24 (/ size 3))))
   (cond ((< coordinate (+ start edge)) (* -300 seconds))
         ((>= coordinate (- (+ start size) edge)) (* 300 seconds)) (t 0))))
(defmethod drag-autoscroll ((view scroll-view) session seconds)
 (let ((old (scroll-offset view)))
   (setf (scroll-offset view) (max 0 (min (scroll-range view)
     (+ old (drag-edge-step (drag-y session) (y view) (height view) seconds)))))
   (/= old (scroll-offset view))))
(defmethod drag-autoscroll ((view list-view) session seconds)
 (let ((old (scroll-offset view))
       (count (if (typep view 'model-list-view) (model-count (view-model view)) (length (items view)))))
   (setf (scroll-offset view) (max 0 (min (max 0 (- (* count (row-height view)) (height view)))
     (+ old (drag-edge-step (drag-y session) (y view) (height view) seconds)))))
   (/= old (scroll-offset view))))
(defmethod drag-autoscroll ((book notebook) session seconds)
 (when (tab-strip-position-p book (drag-x session) (drag-y session))
   (multiple-value-bind (tab left viewport) (tab-strip-geometry book)
     (declare (ignore tab))
     (let ((old (tab-offset book)))
       (scroll-tabs book (drag-edge-step (drag-x session) left viewport seconds))
       (/= old (tab-offset book))))))
(defun advance-drag (window seconds)
 "Advance stationary-pointer drag autoscroll; call once per source-window frame with elapsed seconds."
 (check-type seconds (real 0 *))
 (let* ((session (current-drag window)) (target (and session (drag-target session)))
        (destination (or (and session (slot-value session 'destination)) window)))
   (when (and session (eq (drag-state session) :dragging))
     (unless (and (live-input-widget-p (drag-source session) window)
                  (or (null target) (live-input-widget-p target destination))
                  (not (modal-blocker destination)))
       (cancel-drag window) (return-from advance-drag nil))
     (let ((changed nil))
       (loop for node = (hit-test (input-root destination) (drag-x session) (drag-y session)) then (parent node)
             while node do
         (when (drag-autoscroll node session seconds)
           (layout node (x node) (y node) (width node) (height node)) (setf changed t) (return)))
       (when changed
         (let ((*drag-owner* window))
           (update-drag-target destination session (make-event :kind :move :x (drag-x session) :y (drag-y session))))) changed))))

(defwidget drop-zone (box) "Reusable drop surface; predicate and commit callbacks receive (zone session event)."
 ((drop-predicate nil (or null function) "Acceptance callback; NIL rejects.")
  (drop-function nil (or null function) "Commit callback; NIL rejects.")))
(defmethod accepts-drop-p ((zone drop-zone) session event)
 (and (drop-predicate zone) (funcall (drop-predicate zone) zone session event)))
(defmethod perform-drop ((zone drop-zone) session event)
 (and (drop-function zone) (funcall (drop-function zone) zone session event)))
(defmethod dispose :after ((zone drop-zone))
 (setf (drop-predicate zone) nil (drop-function zone) nil))
(defwidget split-drop-zone (drop-zone) "Drop a widget beside this surface using a generic paned container."
 ((split-edge :right (member :left :right :top :bottom) "Side on which the dropped widget is placed.")))
(defun split-drop (target incoming edge &key (ratio 1/2))
 "Replace TARGET in its parent with a PANED containing TARGET and INCOMING. No workspace or persistence model. Return the paned."
 (ensure-live target) (ensure-live incoming)
 (unless (and (member edge '(:left :right :top :bottom)) (typep ratio '(real 0 1))
              (parent target) (not (typep (parent target) 'stack)) (not (typep (parent incoming) 'stack))
              (not (eq target incoming)) (not (within-subtree-p target incoming))
              (not (within-subtree-p incoming target))
              (transfer-roots-compatible-p (root-of target) (root-of incoming)))
   (error "Invalid pane split."))
 (let* ((container (parent target)) (index (position target (children container)))
        (pane (make-widget 'paned :orientation (if (member edge '(:left :right)) :horizontal :vertical) :value ratio)))
   (remove-child container target) (add-child container pane)
   (setf (children container) (insert-at (remove pane (children container)) pane index))
   (dolist (child (if (member edge '(:left :top)) (list incoming target) (list target incoming))) (add-child pane child)) pane))
(defmethod accepts-drop-p ((zone split-drop-zone) session event)
 (declare (ignore event))
 (let ((incoming (drag-payload session)))
   (and (typep incoming 'widget) (not (disposed-p incoming)) (parent zone)
        (not (typep (parent zone) 'stack)) (not (typep (parent incoming) 'stack))
        (not (within-subtree-p zone incoming)) (not (within-subtree-p incoming zone))
        (transfer-roots-compatible-p (root-of zone) (root-of incoming)))))
(defmethod perform-drop ((zone split-drop-zone) session event)
 (when (accepts-drop-p zone session event) (split-drop zone (drag-payload session) (split-edge zone)) t))

(defstruct os-drop (mime "text/uri-list" :type string) data)
(defgeneric os-drag-capabilities (window)
 (:documentation "Explicit OS adapter contract. In-process drags never imply OS MIME interoperability."))
(defmethod os-drag-capabilities ((window widget))
 (list :incoming nil :outgoing nil :mime-types nil :status :unsupported))
(defun dispatch-os-drop (window mime data x y)
 "Deliver copied adapter data at logical root X/Y. Only :DROP is emitted; the OS owns gesture feedback. Return whether committed."
 (ensure-live window) (check-type mime string)
 (unless (and (enabled-p window) (visible-p window) (not (modal-blocker window)))
   (return-from dispatch-os-drop nil))
 (let* ((payload (make-os-drop :mime (copy-seq mime) :data (copy-tree data)))
        (session (make-instance 'drag-session :source window :payload payload :x x :y y))
        (event (make-event :kind :up :x x :y y)) (state :rejected))
   (unwind-protect
     (let ((target (drag-drop-target window session event)))
       (setf (slot-value session 'target) target)
       (when (and (live-input-widget-p target window) (accepts-drop-p target session event)
                  (live-input-widget-p target window) (perform-drop target session event))
         (setf state :dropped (slot-value session 'target) target (slot-value session 'state) state)
         (emit target :drop session) t))
     (setf (slot-value session 'state) state (slot-value session 'source) nil
           (slot-value session 'target) nil (slot-value session 'payload) nil))))
