(in-package #:lut)
(defwidget styled-text-view (text-view) "Unwrapped text with application-supplied character runs and decorations."
 ((gutter-width 0 (real 0 *) "Reserved left gutter width in pixels.")
  (presentation-runs #() vector "Internal disjoint style intervals.")
  (presentation-decorations #() vector "Internal overlapping decoration intervals.")
  (decoration-max-ends #() vector "Internal decoration prefix interval index.")
  (presentation-links #() vector "Internal disjoint application link intervals.")
  (presentation-images #() vector "Internal inline-image character records.")
  (presentation-revision 0 (integer 0 *) "Internal presentation cache generation.")
  (pressed-document-link nil t "Internal link pointer capture.")))
(defwidget document-view (styled-text-view) "Read-only selectable document; applications supply text, links, images and formatting."
 ((read-only-p t boolean "Document views always reject interactive edits; programmatic TEXT refresh is permitted.")
  (history-limit 0 (integer 0 *) "Standalone document refreshes do not retain undo by default; shared models keep their own policy.")))
(defun copy-presentation-record (record)
 (let ((copy (copy-list record)))
   (when (getf copy :style)
    (setf (getf copy :style) (copy-tree (getf copy :style)))
    (when (stringp (getf (getf copy :style) :font))
      (setf (getf (getf copy :style) :font) (copy-seq (getf (getf copy :style) :font)))))
   (when (consp (getf copy :color)) (setf (getf copy :color) (copy-tree (getf copy :color))))
   (dolist (key '(:text :source :alt))
     (when (stringp (getf copy key)) (setf (getf copy key) (copy-seq (getf copy key))))) copy))
(defun record-start (record) (or (getf record :start) (getf record :position)))
(defun record-end (record) (or (getf record :end) (1+ (getf record :position))))
(defun presentation-records (records)
 (loop for record across records collect (copy-presentation-record record)))
(defun text-runs (view) "Return copied style-run records; opaque application data retains identity." (presentation-records (presentation-runs view)))
(defun text-decorations (view) "Return copied decoration records." (presentation-records (presentation-decorations view)))
(defun document-links (view) "Return copied link records; TARGET values retain identity." (presentation-records (presentation-links view)))
(defun document-images (view) "Return copied inline-image records." (presentation-records (presentation-images view)))
(defun text-presentation-revision (view) "Return the presentation generation, independent of content revision." (presentation-revision view))
(defun normalized-presentation (view records kind)
 (check-type records list)
 (let* ((size (text-length view)) (copies (mapcar #'copy-presentation-record records)))
   (dolist (record copies)
     (unless (and (listp record) (evenp (length record))) (error "Presentation records must be plists."))
     (let ((start (record-start record)) (end (record-end record)))
       (unless (and (integerp start) (integerp end) (<= 0 start end size)
                    (or (eq kind :decorations) (< start end))) (error "Invalid presentation range.")))
     (ecase kind
       (:runs
        (validate-style (getf record :style))
        (loop for key in (getf record :style) by #'cddr do
          (unless (member key '(:font :font-size :foreground :background)) (error "Unsupported text run style ~a." key))))
       (:decorations
        (unless (member (getf record :kind) '(:underline :background :gutter :annotation)) (error "Unknown decoration kind."))
        (when (getf record :text) (check-type (getf record :text) string)))
       (:links (unless (typep view 'document-view) (error "Links require a document view.")))
       (:images
        (unless (and (typep view 'document-view) (not (getf record :start)) (not (getf record :end))
                     (integerp (getf record :position))
                     (char= (index-character (target-text-index view) (getf record :position)) (code-char #xfffc))
                     (typep (getf record :source) '(or string pathname))
                     (typep (getf record :width) '(real (0) *)) (typep (getf record :height) '(real (0) *))
                     (or (typep view 'wrapped-document-view) (<= (getf record :height) (line-height view)))
                     (or (null (getf record :alt)) (stringp (getf record :alt))))
          (error "Images require a document replacement character, source and positive pixel dimensions.")))))
   (setf copies (stable-sort copies #'< :key #'record-start))
   (unless (eq kind :decorations)
     (loop for (a b) on copies while b do
       (when (> (record-end a) (record-start b)) (error "Presentation intervals must be disjoint within each collection."))))
   (coerce copies 'vector)))
(defun invalidate-presentation-cache (view)
 (let ((maximum 0))
   (setf (slot-value view 'decoration-max-ends)
     (map 'vector (lambda (record) (setf maximum (max maximum (record-end record) (1+ (record-start record)))))
          (presentation-decorations view))))
 (incf (slot-value view 'presentation-revision))
 (setf (slot-value view 'geometry-cache) nil (slot-value view 'last-cursor) -1
       (slot-value view 'navigation-x) nil))
(defun invalidate-text-presentation (view)
 "Invalidate measurements after external presentation/font changes and emit :PRESENTATION-CHANGE. Return revision."
 (check-type view styled-text-view) (ensure-live view)
 (invalidate-presentation-cache view)
 (emit view :presentation-change (presentation-revision view)) (presentation-revision view))
(defun set-text-presentation (view &key (runs nil runs-p) (decorations nil decorations-p) (links nil links-p) (images nil images-p))
 "Transactionally replace supplied presentation collections; omitted collections remain. Records are copied. Return VIEW."
 (check-type view styled-text-view) (ensure-live view)
 (let ((updates (loop for (slot records supplied kind) in
                      (list (list 'presentation-runs runs runs-p :runs)
                            (list 'presentation-decorations decorations decorations-p :decorations)
                            (list 'presentation-links links links-p :links)
                            (list 'presentation-images images images-p :images))
                     when supplied collect (cons slot (normalized-presentation view records kind)))))
   (dolist (update updates) (setf (slot-value view (car update)) (cdr update)))
   (invalidate-text-presentation view)) view)
(defun interval-at (records position)
 (let ((lo 0) (hi (length records)))
   (loop while (< lo hi) for mid = (floor (+ lo hi) 2) do
     (if (<= (record-start (aref records mid)) position) (setf lo (1+ mid)) (setf hi mid)))
   (when (plusp lo)
     (let ((record (aref records (1- lo)))) (when (< position (record-end record)) record)))))
(defun next-interval-boundary (records position limit)
 (let ((lo 0) (hi (length records)))
   (loop while (< lo hi) for mid = (floor (+ lo hi) 2) do
     (if (<= (record-start (aref records mid)) position) (setf lo (1+ mid)) (setf hi mid)))
   (min limit (if (< lo (length records)) (record-start (aref records lo)) limit)
        (if (and (plusp lo) (> (record-end (aref records (1- lo))) position))
            (record-end (aref records (1- lo))) limit))))
(defun map-text-decorations (view start end function)
 (let* ((records (presentation-decorations view)) (ends (decoration-max-ends view)) (lo 0) (hi (length records)))
   (loop while (< lo hi) for mid = (floor (+ lo hi) 2) do
     (if (<= (aref ends mid) start) (setf lo (1+ mid)) (setf hi mid)))
   (loop for i from lo below (length records) for record = (aref records i)
         while (< (record-start record) end)
         when (> (max (record-end record) (1+ (record-start record))) start) do (funcall function record))))
(defun text-style-at (view position)
 "Return application run overrides at POSITION; document links default to the accent foreground."
 (check-type view styled-text-view)
 (unless (and (integerp position) (<= 0 position (text-length view))) (error "Invalid presentation position."))
 (append (getf (copy-presentation-record (list :style (getf (interval-at (presentation-runs view) position) :style))) :style)
         (when (interval-at (presentation-links view) position) (list :foreground (style-value view :accent)))))
(defun map-presentation-fragments (view start end function)
 (loop with p = start while (< p end) do
   (let* ((image (interval-at (presentation-images view) p))
          (next (if image (1+ p)
                    (min (next-interval-boundary (presentation-runs view) p end)
                         (next-interval-boundary (presentation-links view) p end)
                         (next-interval-boundary (presentation-images view) p end)))))
     (funcall function p next (text-style-at view p) image) (setf p next))))
(defmethod text-left-padding ((view styled-text-view)) (+ (call-next-method) (gutter-width view)))
(defmethod text-metric-key ((view styled-text-view)) (append (call-next-method) (list (presentation-revision view))))
(defmethod map-text-range-advances ((view styled-text-view) string start function)
 (map-presentation-fragments view start (+ start (length string))
   (lambda (a b style image)
     (if image (funcall function (+ (getf image :width) (text-metric-spacing view)))
         (let ((*text-style-context* (cons view style)))
           (map-text-run-advances view (subseq string (- a start) (- b start)) function))))))
(defmethod (setf gutter-width) :after (width (view styled-text-view))
 (declare (ignore width)) (invalidate-text-presentation view))
(defmethod validate-slot :before ((view document-view) slot value)
 (declare (ignore view))
 (when (and (eq slot 'read-only-p) (not value)) (error "Document views are read-only.")))
(defmethod reset-text-presentation ((view styled-text-view))
 (setf (slot-value view 'presentation-runs) #() (slot-value view 'presentation-decorations) #()
       (slot-value view 'presentation-links) #() (slot-value view 'presentation-images) #())
 (invalidate-presentation-cache view))
(defmethod remap-text-presentation ((view styled-text-view) start old-end new-end)
 (let ((delta (- new-end old-end)))
   (dolist (slot '(presentation-runs presentation-decorations presentation-links presentation-images))
     (setf (slot-value view slot)
       (coerce (loop for record across (slot-value view slot)
                     for a = (record-start record) for b = (record-end record)
                     when (or (and (< a start) (<= b start)) (>= a old-end)) collect
                     (let ((copy (copy-presentation-record record)))
                       (when (>= a old-end)
                         (if (getf copy :position) (incf (getf copy :position) delta)
                             (incf (getf copy :start) delta))
                         (when (getf copy :end) (incf (getf copy :end) delta))) copy)) 'vector))))
 (invalidate-presentation-cache view))
(defvar *presentation-edit-context* nil)
(defmethod (setf text) :around (string (view styled-text-view))
 (let ((*presentation-edit-context*
         (when (and (not (view-buffer view)) (stringp string) (not (string= string (text view))))
           (multiple-value-bind (start end inserted) (text-difference (text view) string)
             (list view start end (+ start (length inserted)))))))
   (call-next-method)))
(defmethod (setf text) :after (string (view styled-text-view))
 (declare (ignore string))
 (when (eq view (first *presentation-edit-context*)) (apply #'remap-text-presentation view (rest *presentation-edit-context*))))
(defun document-hit-test (view px py)
 "Return KIND and copied image/link record, or :TEXT and character position."
 (let ((*text-caret-affinity* nil)) (document-hit-test-content view px py)))
(defun document-hit-test-content (view px py)
 "Return KIND and copied record for an inline image/link, or :TEXT and character position. Outside content returns NIL."
 (check-type view document-view)
 (unless (and (contains-point-p view px py) (>= px (+ (x view) (text-left-padding view)))
                (< px (- (+ (x view) (width view)) (style-value view :padding))))
   (return-from document-hit-test-content nil))
 (let* ((position (text-word-point-position view px py)) (root (display-index view)))
   (when (< position (node-size root))
     (multiple-value-bind (cx cy cw lh) (text-position-rectangle view position)
       (declare (ignore cw))
       (let* ((line (index-position-line root position)) (end (nth-value 1 (index-line-range root line)))
              (right (if (< position end) (+ cx (text-range-width view position (1+ position))) cx)))
         (when (and (<= cx px) (< px right) (<= cy py) (< py (+ cy lh)))
           (let ((image (interval-at (presentation-images view) position)) (link (interval-at (presentation-links view) position)))
             (cond ((and image
                         (let ((left (+ cx (if (and (not (typep view 'wrapped-text-view)) (> position (nth-value 0 (index-line-range root line)))) (text-metric-spacing view) 0)))
                               (top (+ cy (max 0 (/ (- lh (getf image :height)) 2)))))
                           (and (<= left px) (< px (+ left (getf image :width)))
                                (<= top py) (< py (+ top (getf image :height))))))
                    (values :image (copy-presentation-record image)))
                   ((and link (not image)) (values :link (copy-presentation-record link)))
                   (t (values :text position))))))))))
(defun document-link-at-point (view px py)
 (multiple-value-bind (kind record) (document-hit-test view px py)
   (case kind (:link record) (:image (interval-at (presentation-links view) (getf record :position))))))
(defmethod handle-event ((view document-view) event)
 (case (event-kind event)
   (:down (let ((record (document-link-at-point view (event-x event) (event-y event))))
            (setf (slot-value view 'pressed-document-link)
                  (when record (list record (event-x event) (event-y event))))) nil)
   (:up
    (let ((pressed (slot-value view 'pressed-document-link)))
      (setf (slot-value view 'pressed-document-link) nil)
      (when pressed
        (let ((record (document-link-at-point view (event-x event) (event-y event))))
          (when (and record (equal record (first pressed))
                     (<= (+ (expt (- (event-x event) (second pressed)) 2) (expt (- (event-y event) (third pressed)) 2)) 25)
                     (= (cursor view) (slot-value view 'anchor)))
            (cancel-text-selection (root-of view)) (emit view :link (getf record :target))
            (return-from handle-event t))))) nil)
   (otherwise (call-next-method))))
(defmethod dispose :around ((view styled-text-view))
 (unwind-protect (call-next-method)
   (reset-text-presentation view) (setf (slot-value view 'pressed-document-link) nil)))
