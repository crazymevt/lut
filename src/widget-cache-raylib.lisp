(in-package #:lut)

(defparameter *window-cache-tile-size* 256)
(defstruct window-tile-state defaults-key (cache (make-render-cache)) ids (last-repaints 0) (repaints 0) (dynamic-paints 0) (frame 0) layout-key (layout-passes 0) present-key (last-present-time 0) (presents 0) ready-p)

(defun release-window-cache (root)
 (when *window-tile-caches*
   (let ((state (gethash (render-identity root) *window-tile-caches*)))
     (when state (dispose (window-tile-state-cache state)) (remhash (render-identity root) *window-tile-caches*)))))
(defun release-all-window-caches ()
 (when *window-tile-caches*
   (maphash (lambda (id state) (declare (ignore id)) (dispose (window-tile-state-cache state))) *window-tile-caches*)
   (clrhash *window-tile-caches*)))
(defmethod window-cache-statistics ((root window))
 (let* ((state (and *window-tile-caches* (gethash (render-identity root) *window-tile-caches*)))
        (cache (and state (window-tile-state-cache state))))
   (list :enabled-p (cache-enabled-p root)
         :tiles (if state (length (window-tile-state-ids state)) 0)
         :repaints (if state (window-tile-state-repaints state) 0)
         :dynamic-paints (if state (window-tile-state-dynamic-paints state) 0)
         :layout-passes (if state (window-tile-state-layout-passes state) 0)
         :presents (if state (window-tile-state-presents state) 0)
         :last-repaints (if state (window-tile-state-last-repaints state) 0)
         :memory-bytes (if cache (loop for region being the hash-values of (render-cache-regions cache)
                                      for target = (cached-region-target region)
                                      when target sum (* 4 (rl:texture-width (rl:render-texture-texture target))
                                                           (rl:texture-height (rl:render-texture-texture target)))) 0))))

(defun layout-window-if-needed (root width height)
 (if (or (not (cache-enabled-p root)) (null *window-tile-caches*))
     (let ((*performing-window-layout* t)) (layout-window root width height))
     (let* ((state (or (gethash (render-identity root) *window-tile-caches*)
                       (setf (gethash (render-identity root) *window-tile-caches*) (make-window-tile-state))))
            (key (list (layout-revision root) width height (ui-scale root)
                       (compute-applicable-methods #'layout (list root 0 0 width height)))))
       (unless (equal key (window-tile-state-layout-key state))
         (let ((*performing-window-layout* t)) (layout-window root width height))
         (incf (window-tile-state-layout-passes state))
         (setf (window-tile-state-layout-key state)
               (list (layout-revision root) width height (ui-scale root)
                     (compute-applicable-methods #'layout (list root 0 0 width height))))))))

(defun window-present-key (root state)
 (list (window-tile-state-repaints state) (width root) (height root) (ui-scale root)
       (rl:is-window-focused) (rl:is-window-minimized)))
(defun window-needs-present-p (root)
 (let ((state (and *window-tile-caches* (gethash (render-identity root) *window-tile-caches*))))
   (or (null state) (not (cache-enabled-p root))
       (not (equal (window-present-key root state) (window-tile-state-present-key state)))
       (rl:is-window-resized)
       ;; Raylib exposes no portable compositor-damage event. A low-frequency
       ;; refresh repairs a lost front buffer without continuous buffer swaps.
       (>= (- (rl:get-time) (window-tile-state-last-present-time state)) 1.0))))
(defun note-window-presented (root)
 (let ((state (and *window-tile-caches* (gethash (render-identity root) *window-tile-caches*))))
   (when state
     (setf (window-tile-state-present-key state) (window-present-key root state)
           (window-tile-state-last-present-time state) (rl:get-time))
     (incf (window-tile-state-presents state)))))

(defun widget-dynamic-p (widget &optional methods)
 (case (cache-mode widget)
   (:dynamic t) (:retained nil)
   (otherwise
    (or (and (typep widget 'drawing-area) (draw-function widget))
        (and (typep widget 'activity-indicator) (activity-running-p widget))
        ;; Existing application renderers may read arbitrary external state.
        ;; Subclasses that only inherit a built-in painter can stay retained.
        ;; Custom painters explicitly opt in and publish their dirty state.
        (and (not (eq (symbol-package (class-name (class-of widget))) (find-package :lut)))
             (some (lambda (method)
                     (some (lambda (specializer)
                             (and (typep specializer 'class)
                                  (not (eq (symbol-package (class-name specializer)) (find-package :lut)))))
                           #+sbcl (sb-mop:method-specializers method)
                           #+ccl (ccl:method-specializers method)))
                   (or methods (compute-applicable-methods #'render (list widget)))))
        (and (typep widget 'notebook)
             (some (lambda (page) (let ((action (page-action widget page)))
                                    (and action (notebook-action-draw-function action)))) (children widget)))))))
(defun widget-paint-bounds (w)
 ;; A modal backdrop affects the complete owner, not just the dialog rectangle.
 (when (and (typep w 'dialog) (style-value w :backdrop-color))
   (let ((root (root-of w)))
     (when (typep root 'window)
       (return-from widget-paint-bounds (list (x root) (y root) (width root) (height root))))))
 (let* ((spread (if (and (typep w 'dialog) (style-value w :shadow-color))
                    (+ (style-value w :shadow-spread) (abs (style-value w :shadow-offset))) 0))
        (margin (max 4 spread)))
   (list (- (x w) margin) (- (y w) margin) (+ (width w) (* 2 margin)) (+ (height w) (* 2 margin)))))
(defun cache-inert-container-p (w)
 (and (eq (cache-mode w) :auto)
      (member (class-name (class-of w)) '(widget box window grid measured-box flow-box stack paned))))
(defun window-paint-records (root frame)
 (let ((records nil) (dynamic nil) (font-stamps (make-hash-table :test #'equal)))
   (labels ((font-stamp (path)
              (when path
                (multiple-value-bind (value present) (gethash path font-stamps)
                  (if present value
                      (setf (gethash path font-stamps) (font-file-stamp path))))))
            (visit (w parent-clip)
              (when (and (visible-p w) (not (disposed-p w)))
                (let* ((inert-p (cache-inert-container-p w))
                       (methods (unless inert-p (compute-applicable-methods #'render (list w))))
                       (dynamic-p (widget-dynamic-p w methods))
                       (bounds (list (x w) (y w) (width w) (height w)))
                       (clip (intersect-rectangles bounds parent-clip))
                       (paint (intersect-rectangles (widget-paint-bounds w) parent-clip)))
                  (when (and (plusp (third paint)) (plusp (fourth paint)) (not inert-p))
                    (let ((font (style-value w :font)) (focused (focused-widget root)))
                      (push (list paint
                              (list (render-identity w) (render-revision w) bounds clip
                                    (widget-state w) (eq focused w) (and (eq focused w) (focus-visible-p root))
                                    (and (typep w 'search-control) (member focused (children w)) (focus-visible-p root) t)
                                    methods
                                    (font-stamp font)
                                    (widget-render-key w) (and dynamic-p frame))) records)))
                  (if dynamic-p
                      (when (and (plusp (third paint)) (plusp (fourth paint))) (push (list w paint) dynamic))
                      (when (and (plusp (third clip)) (plusp (fourth clip)))
                        (dolist (child (active-children w)) (visit child clip))))))))
     (let ((clip (list (x root) (y root) (width root) (height root))))
       (visit root clip)
       (dolist (overlay (reverse (slot-value root 'overlays))) (visit overlay clip))))
   (values (nreverse records) (nreverse dynamic))))
(defun rectangles-overlap-p (a b)
 (and (< (first a) (+ (first b) (third b))) (< (first b) (+ (first a) (third a)))
      (< (second a) (+ (second b) (fourth b))) (< (second b) (+ (second a) (fourth a)))))
(defun paint-cached-window-tile (root bounds surfaces)
 (let ((*clip* bounds) (*tile-dynamic-surfaces* surfaces))
   (with-ui-scissor ((first bounds) (second bounds) (third bounds) (fourth bounds))
     (render-widget-node root)
     (dolist (overlay (reverse (slot-value root 'overlays))) (render-widget-node overlay))
     (render-drag-feedback root))))
(defun prepare-window-cache (root &key (pixel-scale (backing-pixel-scale)))
 ;; Called before BeginDrawing/BeginTextureMode, outside a camera and scissor.
 (unless (and *window-tile-caches* (cache-enabled-p root) (not (disposed-p root))
              ;; Partial composite patches replace opaque tiles. Preserve the
              ;; direct path for translucent root backgrounds rather than
              ;; repeatedly blending them over their previous pixels.
              (let ((background (style-value root :background)))
                (typecase background
                  (list (= (fourth background) 255))
                  (rl:color (= (rl:color-a background) 255))
                  (t (= (rl:color-a (rl:color background)) 255)))))
   (release-window-cache root) (return-from prepare-window-cache nil))
 (refresh-platform-integration root) (update-anchored-surfaces root) (refresh-commands root)
 (let* ((state (or (gethash (render-identity root) *window-tile-caches*)
                   (setf (gethash (render-identity root) *window-tile-caches*) (make-window-tile-state))))
        (frame (incf (window-tile-state-frame state)))
        (paint-records (multiple-value-list (window-paint-records root frame)))
        (records (first paint-records)) (dynamic (second paint-records))
        (surfaces (make-hash-table)) (dynamic-ids nil) (ids nil) (dirty-ids nil)
        (cache (window-tile-state-cache state))
        (context (list (mapcar #'render-revision (style-roots root))
                       (let ((previous (window-tile-state-defaults-key state)))
                         (if (equal previous *style-defaults*) previous
                             (setf (window-tile-state-defaults-key state) (copy-tree *style-defaults*))))
                       (symbol-function 'draw-string) (symbol-function 'paint-surface)
                       (and (slot-value root 'drag-context) frame)))
        (*cache-output-pixel-scale* pixel-scale)
        (*font-discovery-pass* (make-hash-table :test #'eq)))
   (setf (window-tile-state-ready-p state) nil (window-tile-state-last-repaints state) 0)
   ;; Evaluate arbitrary/animated render callbacks once, not once per intersected tile.
   (dolist (record dynamic)
     (destructuring-bind (widget bounds) record
       (let ((id (list :dynamic (render-identity widget))))
         (update-cached-region cache id bounds frame
           (lambda ()
             (let ((*clip* bounds) (*tile-dynamic-surfaces* nil))
               (with-ui-scissor ((first bounds) (second bounds) (third bounds) (fourth bounds)) (render widget))))
           :scale (ui-scale root))
         (incf (window-tile-state-dynamic-paints state))
         (push id dynamic-ids)
         (setf (gethash (render-identity widget) surfaces) (cons cache id)))))
   (loop for y from (y root) below (+ (y root) (height root)) by *window-cache-tile-size* do
     (loop for x from (x root) below (+ (x root) (width root)) by *window-cache-tile-size* do
       (let* ((id (list x y))
              (bounds (list x y (min *window-cache-tile-size* (- (+ (x root) (width root)) x))
                                  (min *window-cache-tile-size* (- (+ (y root) (height root)) y))))
              (key (list context (loop for (paint token) in records when (rectangles-overlap-p bounds paint) collect token))))
         (push id ids)
         (multiple-value-bind (region repainted)
             (update-cached-region cache id bounds key (lambda () (paint-cached-window-tile root bounds surfaces))
                                   :scale (ui-scale root) :background (style-value root :background))
           (declare (ignore region))
           (when repainted (push id dirty-ids) (incf (window-tile-state-last-repaints state)) (incf (window-tile-state-repaints state)))))))
   ;; Removed/resized tiles own no widget references and release textures promptly.
   (let (removed)
     (maphash (lambda (id region)
                (unless (or (eq id :frame) (member id ids :test #'equal) (member id dynamic-ids :test #'equal))
                  (when (cached-region-target region) (rl:unload-render-texture (cached-region-target region)))
                  (push id removed))) (render-cache-regions cache))
     (dolist (id removed) (remhash id (render-cache-regions cache))))
   ;; Patch changed opaque tiles into one retained frame. Idle composition is
   ;; a single texture draw rather than many blend-mode/texture transitions.
   (let* ((bounds (list (x root) (y root) (width root) (height root)))
          (frame-region (gethash :frame (render-cache-regions cache)))
          (target (and frame-region (cached-region-target frame-region)))
          (reuse (and frame-region (cached-region-key frame-region) target
                      (= (rl:texture-width (rl:render-texture-texture target))
                         (ceiling (* (width root) (ui-scale root) pixel-scale)))
                      (= (rl:texture-height (rl:render-texture-texture target))
                         (ceiling (* (height root) (ui-scale root) pixel-scale)))))
          (*preserve-cache-contents* reuse))
     (update-cached-region cache :frame bounds (window-tile-state-repaints state)
       (lambda () (dolist (id (if reuse dirty-ids ids)) (draw-cached-region cache id)))
       :scale (ui-scale root) :background (style-value root :background)))
   (setf (window-tile-state-ids state) (nreverse ids) (window-tile-state-ready-p state) t) state))
(defun draw-window-cache (root)
 (let ((state (and *window-tile-caches* (gethash (render-identity root) *window-tile-caches*))))
   (when (and (cache-enabled-p root) state (window-tile-state-ready-p state))
     (let ((*render-ui-scale* (ui-scale root)))
       (rl:with-mode-2d ((rl:make-camera-2d :zoom (coerce (* *render-ui-scale* (backing-pixel-scale)) 'single-float)))
         (draw-cached-region (window-tile-state-cache state) :frame))) t)))
