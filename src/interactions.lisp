(in-package #:lut)
(defvar *clipboard* "")
(defgeneric clipboard-text (widget) (:documentation "Read clipboard text; the core uses an in-memory clipboard."))
(defgeneric (setf clipboard-text) (text widget))
(defmethod clipboard-text ((w widget)) *clipboard*)
(defmethod (setf clipboard-text) (string (w widget)) (setf *clipboard* string))
(defgeneric handle-event (widget event)
 (:documentation "Widget-specific event extension. Return true to consume EVENT before default dispatch."))
(defmethod handle-event ((w widget) event) (declare (ignore event)) nil)
(defclass context-menu-item (button)
 ((submenu-p :initarg :submenu-p :initform nil :reader context-item-submenu-p)
  (submenu-opener :initform nil :accessor context-item-submenu-opener)))
(defmethod dispose :after ((item context-menu-item))
 (setf (context-item-submenu-opener item) nil))
(defun context-menu-ancestor-p (ancestor menu)
 (loop for node = menu then (let ((owner (popup-owner node)))
                              (and owner (typep (parent owner) 'context-menu) (parent owner)))
       while (typep node 'context-menu) thereis (eq ancestor node)))
(defmethod overlay-input-scope-p ((overlay context-menu) scope)
 (and (typep scope 'context-menu) (context-menu-ancestor-p overlay scope)))
(defun close-context-menu-descendants (menu)
 (let ((window (root-of menu)))
   (loop for top = (input-root window)
         while (and (not (eq top menu)) (context-menu-ancestor-p menu top))
         do (dismiss-dialog top))))
(defun context-menu-child (menu)
 (find-if (lambda (child)
            (and (typep child 'context-menu) (popup-owner child)
                 (eq menu (parent (popup-owner child)))))
          (slot-value (root-of menu) 'overlays)))
(defun show-context-item-submenu (item)
 (let* ((menu (parent item))
        (existing (find-if (lambda (child) (and (typep child 'context-menu) (eq (popup-owner child) item)))
                          (slot-value (root-of item) 'overlays))))
   (when (and (enabled-p item) (context-item-submenu-opener item))
     (setf (slot-value menu 'hover-pending) nil)
     (if existing
         (close-context-menu-descendants existing)
         (progn (close-context-menu-descendants menu)
                (funcall (context-item-submenu-opener item)))))))
(defmethod handle-event ((item context-menu-item) event)
 (when (and (eq (event-kind event) :move) (enabled-p item))
   (let* ((menu (parent item)) (child (context-menu-child menu))
          (time (or (event-timestamp event) (/ (get-internal-real-time) internal-time-units-per-second)))
          (pending (slot-value menu 'hover-pending)))
     ;; Give diagonal travel into an open submenu a short grace period. Native
     ;; polling sends MOVE each frame, so a stationary sibling opens after 200ms.
     (when (and child (not (eq (popup-owner child) item)))
       (unless (and pending (eq item (first pending)))
         (setf pending (list item time) (slot-value menu 'hover-pending) pending))
       (when (< (- time (second pending)) 0.2)
         (return-from handle-event t)))
     (setf (slot-value menu 'hover-pending) nil)
     (if (context-item-submenu-p item) (show-context-item-submenu item)
         (close-context-menu-descendants menu)))
   t))
(defun open-context-menu (window target event &optional actions)
 "Open a pointer-positioned menu. ACTIONS are (caption callback enabled-p submenu-provider) lists or :SEPARATOR (NIL also separates).
A submenu provider takes no arguments and returns actions; its button opens beside the parent menu.
Without ACTIONS, ENTRY gets Cut/Copy/Paste/Select all. Callbacks take no arguments."
 (let* ((actions (or actions (when (typep target 'entry)
                 (list (list "Cut" (lambda () (when (editable-p target)
                                         (setf (clipboard-text target) (selected-text target))
                                         (replace-selection target ""))) (editable-p target))
                       (list "Copy" (lambda () (setf (clipboard-text target) (selected-text target))) t)
                       (list "Paste" (lambda () (when (editable-p target)
                                         (replace-selection target (clipboard-text target)))) (editable-p target))
                       :separator
                       (list "Select all" (lambda () (select-all target)) t)))))
        (pad 4) (row (max 28 (+ 10 (style-value target :font-size))))
        (menu (make-widget 'context-menu :width 220 :height (+ (* 2 pad)
                  (loop for item in actions sum (if (or (null item) (eq item :separator)) 8 row)))
                           :position-mode :absolute :popup-owner target :draggable-p nil :detach-on-drag-p nil :spacing 0 :style '(:padding 4))))
   (unless actions (return-from open-context-menu nil))
   (setf (x menu) (max 0 (min (event-x event) (- (width window) (width menu))))
         (y menu) (max 0 (min (event-y event) (- (height window) (height menu)))))
   (dolist (item actions)
    (if (or (null item) (eq item :separator))
      (add-child menu (make-widget 'menu-separator :height 8 :style '(:padding 8)))
     (destructuring-bind (caption callback &optional (enabled t) submenu) item
       (let ((button (make-widget 'context-menu-item :text caption :height row :enabled-p enabled
                                  :submenu-p (not (null submenu))
                                  :style '(:padding 12 :button-depth 0 :border-width 0 :max-border-radius 4))))
         (when submenu
           (setf (context-item-submenu-opener button)
             (lambda ()
               (let ((child (open-context-menu window target
                              (make-event :kind :context :x (+ (x button) (width button)) :y (y button))
                              (funcall submenu))))
                 (when child
                   (setf (popup-owner child) button)
                   (when (> (+ (x button) (width button) (width child)) (width window))
                     (setf (x child) (max 0 (- (x menu) (width child)))))
                   (layout child (x child) (y child) (width child) (height child)))))))
         (on button :activate (lambda (button payload) (declare (ignore payload))
           (if submenu
             (show-context-item-submenu button)
               (progn
                 (dismiss-dialog menu)
                 ;; Close the menu chain before invoking an application command.
                 (loop while (typep (input-root window) 'context-menu)
                       do (dismiss-dialog (input-root window)))
                 (when (focusable-p target) (focus window target))
                 (when (enabled-p button) (funcall callback))))))
         (add-child menu button)))))
   (show-dialog window menu)
   ;; Measure after attachment so rows inherit the window's actual font/theme.
   ;; Include the same caption inset and arrow reserve used by the renderer.
   (setf (width menu)
         (min (width window)
              (max 220 (+ (* 2 pad)
                          (loop for child in (children menu)
                                when (typep child 'context-menu-item)
                                maximize (+ (text-width child (text child))
                                            (* 2 (style-value child :padding)) 16)
                                  into widest finally (return (or widest 0))))))
         (x menu) (max 0 (min (event-x event) (- (width window) (width menu)))))
   (layout menu (x menu) (y menu) (width menu) (height menu)) menu))
(defun selection-button-width (w) (min 36 (width w)))
(defun selection-button-x (w) (- (+ (x w) (width w)) (selection-button-width w)))
(defun popup-selection (w)
 (let* ((root (root-of w)) (pad 4)
        (popup (make-widget 'popover :style (list :padding pad) :popup-owner w :width (width w) :height (min 300 (+ (* 2 pad) (* (row-height w) (length (items w)))))
                           :x (max 0 (min (x w) (- (width root) (width w))))
                           :y (+ (y w) (height w))))
        (list (make-widget 'selection-list :style '(:padding 8 :border-width 0) :height (max 0 (- (height popup) (* 2 pad))) :items (copy-list (items w)) :value (if (typep w 'combo-box) (position (text w) (items w) :test #'string=) (value w)))))
   (setf (height popup) (min (height popup) (height root))
         (height list) (max 0 (- (height popup) (* 2 pad)))
         (y popup) (max 0 (if (> (+ (y popup) (height popup)) (height root))
                             (- (y w) (height popup)) (y popup))))
   (on list :change (lambda (list index) (declare (ignore list))
     (close-dialog root) (focus root w)
     (if (typep w 'combo-box)
         (progn (select-all w) (replace-selection w (nth index (items w))))
         (progn (setf (value w) index) (emit w :change index)))))
   (add-child popup list) (setf (expanded-p w) t) (show-dialog root popup)
   (focus root list) popup))
(defmethod handle-event ((w selection-list) e)
 (when (eq (event-kind e) :key)
   (case (event-key e)
     ((:up :down)
      (when (items w)
        (setf (value w) (max 0 (min (1- (length (items w)))
          (+ (or (value w) (if (eq (event-key e) :down) -1 1))
             (if (eq (event-key e) :down) 1 -1)))))
        (let ((top (* (value w) (row-height w))))
          (setf (scroll-offset w)
            (max 0 (min top (max (scroll-offset w) (- (+ top (row-height w)) (height w))))))))
      t)
     (:enter (when (value w) (emit w :change (value w))) t))))
(defmethod handle-event ((w dropdown) e)
 (when (or (eq (event-kind e) :down)
           (and (eq (event-kind e) :key) (member (event-key e) '(:space :enter :down))))
   (popup-selection w) t))
(defmethod handle-event ((w notebook) e)
 (cond ((and (eq (event-kind e) :down) (notebook-header-p w e))
        (let ((index (tab-at-position w (event-x e) (event-y e))))
          (if index (if (and (closable-p w) (tab-close-position-p w index (event-x e)))
                        (progn (cancel-drag (root-of w))
                               (request-page-close w (nth index (children w)) :reason :pointer))
                        (select-page w index))
              (multiple-value-bind (tab left viewport button) (tab-strip-geometry w)
                (declare (ignore tab viewport))
                (when (plusp button)
                  (scroll-tabs w (* (style-value w :tab-scroll-step)
                                    (if (< (event-x e) left) -1 1))))))) t)
       ((and (eq (event-kind e) :wheel) (notebook-header-p w e) (plusp (tab-scroll-limit w)))
        (scroll-tabs w (* (- (event-delta e)) (style-value w :tab-scroll-step))) t)
       ((and (eq (event-kind e) :key) (member (event-key e) '(:left :right)))
        (when (children w) (select-page w (mod (+ (value w) (if (eq (event-key e) :left) -1 1))
                                               (length (children w))))) t)))
(defmethod handle-event ((w expander) e)
 (when (and (eq (event-kind e) :down) (< (event-y e) (+ (y w) (line-height w))))
   (setf (value w) (not (value w))) (emit w :change (value w)) t))
(defmethod handle-event ((w tree-view) e)
 (when (eq (event-kind e) :down)
   (let* ((index (floor (+ (- (event-y e) (y w)) (scroll-offset w)) (row-height w)))
          (row (nth (max 0 index) (tree-rows w))))
     (when (and row (getf (first row) :children))
       (let ((node (first row)))
         (if (member :open node) (setf (getf node :open) (not (getf node :open)))
             (nconc node (list :open t))))
       (refresh-items w) t))))
(defmethod handle-event ((w combo-box) e)
 (when (and (items w)
            (or (and (eq (event-kind e) :down) (>= (event-x e) (selection-button-x w)))
                (and (eq (event-kind e) :key) (eq (event-key e) :down))))
   (popup-selection w) t))
(defun ancestor-of-type (w type)
 (loop for node = w then (parent node) while node when (typep node type) return node))
(defgeneric hover-row-at-point (view px py))
(defmethod hover-row-at-point ((w list-view) px py)
 (declare (ignore px))
 (let* ((header (if (typep w 'table-view) (row-height w) 0))
        (local-y (- py (y w) header))
        (index (floor (+ local-y (scroll-offset w)) (row-height w))))
   (when (and (>= local-y 0) (<= 0 index) (< index (length (items w)))) index)))
(defun update-pointer-hover (w target event)
 (setf (hovered-p w) (eq w target))
 (when (or (typep w 'list-view) (typep w 'vertical-notebook) (typep w 'notebook))
   (setf (hovered-row w)
     (when (and (eq w target) (member (event-kind event) '(:move :down :up :wheel :context)))
       (cond ((typep w 'vertical-notebook) (vertical-tab-at-position w (event-x event) (event-y event)))
             ((typep w 'notebook) (tab-at-position w (event-x event) (event-y event)))
             (t (hover-row-at-point w (event-x event) (event-y event))))))))
(defun dispatch (window event)
 "Dispatch input with state updates, generic widget handlers, popup dismissal, context menus and dialog dragging."
 (when (disposed-p window) (return-from dispatch nil))
 (when (eq (event-kind event) :os-drop)
   (return-from dispatch (dispatch-os-drop window "application/x-lut-file-path-list"
     (event-drop-data event) (event-x event) (event-y event))))
 (let ((blocker (modal-blocker window)))
   (when blocker
     (cancel-controlled-drags window)
     (cancel-text-selection window :forget-clicks t)
     (when (member (event-kind event) '(:down :key :text :context)) (focus-modal blocker))
     (return-from dispatch nil)))
 (when (dispatch-anchored-surfaces window event) (return-from dispatch nil))
 (when (dispatch-controlled-drag window event)
   (cancel-text-selection window :forget-clicks t) (return-from dispatch nil))
 (when (member (event-kind event) '(:down :key :text :context))
   (cancel-text-selection window)
   (when (member (event-kind event) '(:key :text :context)) (setf (slot-value window 'text-click-state) nil)))
 (refresh-commands window)
 (when (dispatch-key-capture window event) (return-from dispatch nil))
 (when (eq (event-kind event) :key)
   (setf (focus-visible-p window) t)
   (emit window :key event)
   (unless (event-key event) (return-from dispatch nil)))
 (let* ((root (input-root window)) (target (input-hit-test window (event-x event) (event-y event)))
        (kind (event-kind event)) (pressed (slot-value window 'pressed-widget)))
   (when (and (eq kind :down) (not (typep target 'entry))) (setf (slot-value window 'text-click-state) nil))
   (walk-widgets window (lambda (w) (update-pointer-hover w target event)))
   (dolist (d (slot-value window 'overlays))
     (walk-widgets d (lambda (w) (update-pointer-hover w target event))))
   (when (eq kind :move)
     (dolist (menu (slot-value window 'overlays))
       (when (and (typep menu 'context-menu) (slot-value menu 'hover-pending)
                  (not (eq target (first (slot-value menu 'hover-pending)))))
         (setf (slot-value menu 'hover-pending) nil))))
   (when (and (eq kind :down) (null target)
              (or (typep root 'context-menu) (and (typep root 'popover) (dismiss-on-outside-p root))))
     (close-dialog window) (return-from dispatch nil))
   (when (eq kind :move)
     (setf (slot-value window 'overlays)
       (remove-if (lambda (d) (typep d 'tooltip)) (slot-value window 'overlays)))
     (when (and target (tooltip-text target))
       (let* ((tip (make-widget 'tooltip :style '(:padding 0)))
              (label (make-widget 'label :text (tooltip-text target) :style '(:padding 0))))
         ;; Tooltips inherit the window's text styles, not an icon button's font.
         ;; Establish that ancestry before measuring the actual painted label.
         (setf (parent tip) window)
         (add-child tip label)
         (let* ((horizontal (style-value tip :tooltip-padding-x 8))
                (vertical (style-value tip :tooltip-padding-y 5))
                (content-height (+ (style-value label :font-size)
                                   (* (1- (length (text-lines (text label)))) (line-height label))))
                (tw (min (width window) (+ (* 2 horizontal) (text-width label (text label)))))
                (th (+ (* 2 vertical) content-height)))
           (setf (height label) content-height
                 (width tip) tw (height tip) th
                 (x tip) (max 0 (min (+ 12 (event-x event)) (- (width window) tw)))
                 (y tip) (max 0 (min (+ 16 (event-y event)) (- (height window) th))))
           ;; Pointer input runs after layout; place the label on its first frame.
           (layout tip (x tip) (y tip) tw th))
         (push tip (slot-value window 'overlays)))))
   (when (eq kind :down)
     (when pressed (setf (pressed-p pressed) nil))
     (setf (slot-value window 'pressed-widget) target)
     (when target (setf (pressed-p target) t)
       (when (focusable-p target) (focus window target) (setf (focus-visible-p window) (typep target 'entry))))
     (when (and (typep root 'dialog) (draggable-p root)
                (or (eq target root) (< (event-y event) (+ (y root) (style-value root :title-height))))
                (contains-point-p root (event-x event) (event-y event)))
       (setf (slot-value window 'interaction-state)
             (list :drag root (- (event-x event) (x root)) (- (event-y event) (y root))))
       (return-from dispatch root)))
   (when (eq kind :down) (arm-pointer-drag window event target))
   ;; Scrollbar capture belongs to the scrolling view, before row selection.
   (when (and (eq kind :down) target)
     (let ((view (loop for node = target then (parent node) while node
                       when (and (scrollbar-view-p node) (plusp (scrollbar-range node))
                                 (>= (event-x event) (nth-value 0 (scrollbar-bounds node))))
                         return node)))
       (when (and view (plusp (scrollbar-range view)))
         (multiple-value-bind (sx sy sw sh travel) (scrollbar-bounds view)
           (declare (ignore sw travel))
           (when (>= (event-x event) sx)
             (setf (slot-value window 'interaction-state)
                   (list :scrollbar view (if (<= sy (event-y event) (+ sy sh))
                                            (- (event-y event) sy) (/ sh 2))))
             (setf (slot-value window 'pressed-widget) view)
             (drag-scrollbar view (event-y event) (third (slot-value window 'interaction-state)))
             (return-from dispatch view))))))
   (when (eq (first (slot-value window 'interaction-state)) :scrollbar)
     (destructuring-bind (tag view offset) (slot-value window 'interaction-state)
       (declare (ignore tag))
       (when (eq kind :move) (drag-scrollbar view (event-y event) offset))
       (when (eq kind :up)
         (setf (slot-value window 'interaction-state) nil (slot-value window 'pressed-widget) nil
               (pressed-p view) nil))
       (return-from dispatch view)))
   (when (and (eq kind :move) (eq (first (slot-value window 'interaction-state)) :drag))
     (destructuring-bind (tag d dx dy) (slot-value window 'interaction-state)
       (declare (ignore tag))
       (setf (position-mode d) :absolute (x d) (- (event-x event) dx) (y d) (- (event-y event) dy))
       (when (and (detach-on-drag-p d) (or (< (x d) (x window)) (< (y d) (y window))
                    (> (+ (x d) (width d)) (+ (x window) (width window)))
                    (> (+ (y d) (height d)) (+ (y window) (height window)))))
         (detach-window d) (setf (slot-value window 'interaction-state) nil)))
     (return-from dispatch root))
   (when (eq kind :up)
     (when pressed (setf (pressed-p pressed) nil))
     (when (slot-value window 'interaction-state)
       (setf (slot-value window 'interaction-state) nil) (return-from dispatch root)))
   (when (and (eq kind :move) (typep pressed 'slider) (not (typep pressed 'progress-bar)) (not (typep pressed 'spin-button)))
     (change-number pressed (+ (minimum pressed) (* (- (maximum pressed) (minimum pressed))
                                    (/ (- (event-x event) (x pressed)) (max 1 (width pressed)))))))
   (when (eq kind :context)
     (when target
       (if (has-handler-p target :context) (emit target :context event)
           (open-context-menu window target event)))
     (return-from dispatch target))
   (let ((receiver (cond ((member kind '(:key :text))
                          (and (live-input-widget-p (focused-widget window) window) (focused-widget window)))
                         ((and pressed (member kind '(:move :up))) pressed) (t target))))
     (when (and receiver (handle-event receiver event))
       (when (eq kind :up) (cancel-text-selection window) (setf (slot-value window 'pressed-widget) nil))
       (return-from dispatch receiver)))
   ;; Splitter gestures are captured on the paned ancestor, including its child surfaces.
   (let ((pane (and target (ancestor-of-type target 'paned))))
     (when (and pane (eq kind :down))
       (let* ((horizontal (eq (orientation pane) :horizontal))
              (position (- (if horizontal (event-x event) (event-y event)) (if horizontal (x pane) (y pane))))
              (split (* (if horizontal (width pane) (height pane)) (value pane))))
         (when (<= (abs (- position split)) (style-value pane :padding))
           (setf (slot-value window 'pressed-widget) pane) (return-from dispatch pane)))))
   (when (and (eq kind :move) (typep pressed 'paned))
     (setf (value pressed) (max 0 (min 1
       (if (eq (orientation pressed) :horizontal)
           (/ (- (event-x event) (x pressed)) (max 1 (width pressed)))
           (/ (- (event-y event) (y pressed)) (max 1 (height pressed)))))))
     (emit pressed :change (value pressed)))
   (dispatch-base window event)))
(defun chooser-action (dialog caption callback)
 (let ((button (make-widget 'button :text caption)))
   (on button :activate (lambda (w e) (declare (ignore w e)) (funcall callback)))
   (add-child dialog button)))
(defun choose-file (window callback &key (directory (user-homedir-pathname)))
 "Open a portable directory/file browser. CALLBACK receives the selected pathname."
 (let* ((d (make-widget 'file-chooser :directory directory :width 560 :height 480))
        (path (make-widget 'entry :text (namestring directory)))
        (files (make-widget 'list-view :height 280)))
   (labels ((refresh ()
              (let ((dir (uiop:ensure-directory-pathname (text path))))
                (setf (directory d) dir (items files)
                      (mapcar #'namestring (append (uiop:subdirectories dir) (uiop:directory-files dir)))))))
     (add-child d path) (add-child d files)
     (on files :change (lambda (w index) (setf (text path) (nth index (items w)))))
     (chooser-action d "Browse directory" #'refresh)
     (chooser-action d "Choose" (lambda () (setf (value d) (pathname (text path)))
       (dismiss-dialog d) (funcall callback (value d))))
     (refresh)) (show-dialog window d)))
(defun choose-color (window callback &key (initial '(0 0 0 255)))
 "Open four byte-channel sliders. CALLBACK receives a copied RGBA list on Apply."
 (let ((d (make-widget 'color-chooser :value (copy-list initial) :width 400 :height 300)))
   (dotimes (i 4)
     (let ((index i) (slider (make-widget 'slider :value (nth i initial) :maximum 255)))
       (on slider :change (lambda (w v) (declare (ignore w))
         (setf (value d) (loop for old in (value d) for j from 0 collect (if (= j index) (round v) old)))))
       (add-child d slider)))
   (chooser-action d "Apply color" (lambda () (dismiss-dialog d) (funcall callback (copy-list (value d)))))
   (show-dialog window d)))
(defun choose-font (window callback &key initial)
 "Choose a font file and positive pixel size. CALLBACK receives pathname and size."
 (let* ((d (make-widget 'font-chooser :value initial :width 540 :height 230))
        (path (make-widget 'entry :text (if initial (namestring (pathname initial)) "")))
        (size (make-widget 'spin-button :minimum 1 :maximum 128 :value 18)))
   (add-child d path) (add-child d size)
   (chooser-action d "Apply font" (lambda ()
     (unless (probe-file (text path)) (error "Font file does not exist."))
     (setf (value d) (pathname (text path)) (font-size d) (round (value size)))
     (dismiss-dialog d) (funcall callback (value d) (font-size d))))
   (show-dialog window d)))

(defun spin-action-at (w px py)
 (when (contains-point-p w px py)
   (let ((size (min 32 (/ (width w) 2))))
     (cond ((< px (+ (x w) size)) :minus)
           ((>= px (- (+ (x w) (width w)) size)) :plus)))))
(defmethod handle-event ((w spin-button) e)
 (case (event-kind e)
   (:down (setf (spin-press w) (spin-action-at w (event-x e) (event-y e))) t)
   (:move (setf (spin-hover w) (spin-action-at w (event-x e) (event-y e))) t)
   (:up (let ((action (spin-press w)))
          (setf (spin-press w) nil)
          (when (and action (eq action (spin-action-at w (event-x e) (event-y e))))
            (change-number w (+ (value w) (* (step w) (if (eq action :minus) -1 1)))))) t)
   (:wheel (unless (zerop (event-delta e))
             (change-number w (+ (value w) (* (step w) (signum (event-delta e)))))) t)))
(defmethod handle-event ((w table-view) e)
 (let ((header (row-height w)))
   (cond ((and (eq (event-kind e) :down) (< (event-y e) (+ (y w) header)))
          (when (columns w)
            (sort-table w (min (1- (length (columns w)))
               (max 0 (floor (* (- (event-x e) (x w)) (length (columns w))) (max 1 (width w))))))) t)
         ((and (eq (event-kind e) :up) (eq w (slot-value (root-of w) 'pressed-widget)))
          (let ((index (floor (+ (- (event-y e) (y w) header) (scroll-offset w)) (row-height w))))
            (when (< -1 index (length (rows w))) (setf (value w) index) (emit w :change index))) t))))

(defun layout-window (w &optional (width (width w)) (height (height w)))
 "Lay out root content and overlays, respecting dragged and pointer-positioned surfaces."
 (layout w 0 0 width height)
 (update-anchored-surfaces w)
 (dolist (d (reverse (slot-value w 'overlays)))
   (unless (nonmodal-overlay-p d)
   (layout d (if (eq (position-mode d) :center) (max 0 (/ (- width (width d)) 2)) (x d))
             (if (eq (position-mode d) :center) (max 0 (/ (- height (height d)) 2)) (y d))
             (width d) (height d)))) w)

(defmethod handle-event ((w text-view) e)
 (when (eq (event-kind e) :wheel)
   (let ((extent (+ (* 2 (style-value w :padding)) (text-content-height w))))
     (setf (vertical-offset w) (max 0 (min (max 0 (- extent (height w)))
                               (- (vertical-offset w) (* (line-height w) (event-delta e))))))) t))
(defun bind-key (window key function &key owner)
 "Bind normalized KEY to a no-argument action on WINDOW, outside modal dialogs.
Examples: :CONTROL-S, :CONTROL-SHIFT-S, :F1. Return ON's callback and connection."
 (on window :key (lambda (w event)
   (when (and (eq (input-root w) w) (eq key (event-key event)))
     (funcall function) (setf (event-key event) nil))) :owner owner))

(defmethod handle-event ((book vertical-notebook) event)
 (let* ((index (vertical-tab-at-position book (event-x event) (event-y event)))
        (header (and (contains-point-p book (event-x event) (event-y event))
                     (< (event-x event) (+ (x book) (vertical-tab-width book))))))
   (case (event-kind event)
     (:down (when header
              (setf (vertical-tab-press book) (when (and index (reorderable-p book))
                                               (list index (event-y event) nil)))
              (select-vertical-page book index) t))
     (:move (let ((press (vertical-tab-press book)))
              (when (and press (> (abs (- (event-y event) (second press))) (style-value book :drag-threshold)))
                (setf (third press) t))
              (not (null press))))
     (:up (let ((press (vertical-tab-press book)))
            (setf (vertical-tab-press book) nil)
            (when (and press (reorderable-p book) (third press) index (/= index (first press)))
              (reorder-vertical-page book (first press) index))
            header))
     (:wheel (when header
               (setf (tab-offset book) (max 0 (min (vertical-tab-scroll-limit book)
                 (- (tab-offset book) (* (event-delta event) (row-height book)))))
                     (hovered-row book) (vertical-tab-at-position book (event-x event) (event-y event)))
               t))
     (:key (when (children book)
             (let ((next (case (event-key event)
                           (:up (max 0 (1- (value book))))
                           (:down (min (1- (length (children book))) (1+ (value book))))
                           (:home 0) (:end (1- (length (children book)))))))
               (when next (select-vertical-page book next) t)))))))


(defgeneric pointer-cursor (widget x y &key captured-p)
  (:documentation "Return a native cursor keyword or NIL at logical X/Y. CAPTURED-P means WIDGET owns the pointer gesture. Specialize for custom resize targets."))
(defmethod pointer-cursor ((widget widget) x y &key captured-p)
  (declare (ignore widget x y captured-p)) nil)
(defmethod pointer-cursor ((pane paned) x y &key captured-p)
  (let* ((horizontal (eq (orientation pane) :horizontal))
         (position (- (if horizontal x y) (if horizontal (lut:x pane) (lut:y pane))))
         (split (* (if horizontal (width pane) (height pane)) (value pane))))
    (when (or captured-p (<= (abs (- position split)) (style-value pane :padding)))
      (if horizontal :resize-ew :resize-ns))))
(defun window-pointer-cursor (window x y)
  "Resolve cursor through the active hit target's ancestors or captured widget."
  (let ((pressed (slot-value window 'pressed-widget)))
    (or (if pressed
            (when (live-input-widget-p pressed window)
              (pointer-cursor pressed x y :captured-p t))
            (loop for node = (input-hit-test window x y) then (parent node)
                  while (and node (live-input-widget-p node window))
                  thereis (pointer-cursor node x y)))
        :default)))
