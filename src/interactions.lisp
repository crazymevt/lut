(in-package #:lut)
(defvar *clipboard* "")
(defgeneric clipboard-text (widget) (:documentation "Read clipboard text; the core uses an in-memory clipboard."))
(defgeneric (setf clipboard-text) (text widget))
(defmethod clipboard-text ((w widget)) *clipboard*)
(defmethod (setf clipboard-text) (string (w widget)) (setf *clipboard* string))
(defgeneric handle-event (widget event)
 (:documentation "Widget-specific event extension. Return true to consume EVENT before default dispatch."))
(defmethod handle-event ((w widget) event) (declare (ignore event)) nil)
(defun open-context-menu (window target event &optional actions)
 "Open a pointer-positioned menu. ACTIONS are (caption callback enabled-p) lists.
Without ACTIONS, ENTRY gets Cut/Copy/Paste/Select all. Callbacks take no arguments."
 (let* ((actions (or actions (when (typep target 'entry)
                 (list (list "Cut" (lambda () (setf (clipboard-text target) (selected-text target))
                                                   (replace-selection target "")) t)
                       (list "Copy" (lambda () (setf (clipboard-text target) (selected-text target))) t)
                       (list "Paste" (lambda () (replace-selection target (clipboard-text target))) t)
                       (list "Select all" (lambda () (select-all target)) t)))))
        (pad (style-value target :padding)) (row (row-height target))
        (menu (make-widget 'context-menu :width 220 :height (+ (* 2 pad) (* (length actions) (+ row 4)))
                           :position-mode :absolute :draggable-p nil :detach-on-drag-p nil :spacing 4)))
   (unless actions (return-from open-context-menu nil))
   (setf (x menu) (max 0 (min (event-x event) (- (width window) (width menu))))
         (y menu) (max 0 (min (event-y event) (- (height window) (height menu)))))
   (dolist (item actions)
     (destructuring-bind (caption callback &optional (enabled t)) item
       (let ((button (make-widget 'button :text caption :height row :enabled-p enabled)))
         (on button :activate (lambda (button payload) (declare (ignore button payload))
           (dismiss-dialog menu)
           (when (focusable-p target) (focus window target))
           (funcall callback)))
         (add-child menu button))))
   (show-dialog window menu)
   (layout menu (x menu) (y menu) (width menu) (height menu)) menu))
(defun selection-button-width (w) (min 36 (width w)))
(defun selection-button-x (w) (- (+ (x w) (width w)) (selection-button-width w)))
(defun popup-selection (w)
 (let* ((root (root-of w)) (pad (style-value w :padding))
        (popup (make-widget 'popover :popup-owner w :width (width w) :height (min 300 (+ (* 2 pad) (* (row-height w) (length (items w)))))
                           :x (x w) :y (+ (y w) (height w))))
        (list (make-widget 'selection-list :height (max 0 (- (height popup) (* 2 pad))) :items (copy-list (items w)) :value (if (typep w 'combo-box) (position (text w) (items w) :test #'string=) (value w)))))
   (on list :change (lambda (list index) (declare (ignore list))
     (close-dialog root) (focus root w)
     (if (typep w 'combo-box)
         (progn (select-all w) (replace-selection w (nth index (items w))))
         (progn (setf (value w) index) (emit w :change index)))))
   (add-child popup list) (setf (expanded-p w) t) (show-dialog root popup)
   (focus root list) popup))
(defmethod handle-event ((w selection-list) e)
 (when (eq (event-kind e) :key)
   (case (event-key e)
     ((:up :down)
      (when (items w)
        (setf (value w) (max 0 (min (1- (length (items w)))
          (+ (or (value w) (if (eq (event-key e) :down) -1 1))
             (if (eq (event-key e) :down) 1 -1)))))
        (let ((top (* (value w) (row-height w))))
          (setf (scroll-offset w)
            (max 0 (min top (max (scroll-offset w) (- (+ top (row-height w)) (height w))))))))
      t)
     (:enter (when (value w) (emit w :change (value w))) t))))
(defmethod handle-event ((w dropdown) e)
 (when (or (eq (event-kind e) :down)
           (and (eq (event-kind e) :key) (member (event-key e) '(:space :enter :down))))
   (popup-selection w) t))
(defmethod handle-event ((w notebook) e)
 (cond ((and (eq (event-kind e) :down) (notebook-header-p w e))
        (let ((index (tab-at-position w (event-x e) (event-y e))))
          (if index (select-page w index)
              (multiple-value-bind (tab left viewport button) (tab-strip-geometry w)
                (declare (ignore tab viewport))
                (when (plusp button)
                  (scroll-tabs w (* (style-value w :tab-scroll-step)
                                    (if (< (event-x e) left) -1 1))))))) t)
       ((and (eq (event-kind e) :wheel) (notebook-header-p w e) (plusp (tab-scroll-limit w)))
        (scroll-tabs w (* (- (event-delta e)) (style-value w :tab-scroll-step))) t)
       ((and (eq (event-kind e) :key) (member (event-key e) '(:left :right)))
        (when (children w) (select-page w (mod (+ (value w) (if (eq (event-key e) :left) -1 1))
                                               (length (children w))))) t)))
(defmethod handle-event ((w expander) e)
 (when (and (eq (event-kind e) :down) (< (event-y e) (+ (y w) (line-height w))))
   (setf (value w) (not (value w))) (emit w :change (value w)) t))
(defmethod handle-event ((w tree-view) e)
 (when (eq (event-kind e) :down)
   (let* ((index (floor (+ (- (event-y e) (y w)) (scroll-offset w)) (row-height w)))
          (row (nth (max 0 index) (tree-rows w))))
     (when (and row (getf (first row) :children))
       (let ((node (first row)))
         (if (member :open node) (setf (getf node :open) (not (getf node :open)))
             (nconc node (list :open t))))
       (refresh-items w) t))))
(defmethod handle-event ((w combo-box) e)
 (when (and (items w)
            (or (and (eq (event-kind e) :down) (>= (event-x e) (selection-button-x w)))
                (and (eq (event-kind e) :key) (eq (event-key e) :down))))
   (popup-selection w) t))
(defun ancestor-of-type (w type)
 (loop for node = w then (parent node) while node when (typep node type) return node))
(defun update-pointer-hover (w target event)
 (setf (hovered-p w) (eq w target))
 (when (typep w 'list-view)
   (setf (hovered-row w)
     (when (and (eq w target) (member (event-kind event) '(:move :down :up :wheel :context)))
       (let* ((header (if (typep w 'table-view) (row-height w) 0))
              (local-y (- (event-y event) (y w) header))
              (index (floor (+ local-y (scroll-offset w)) (row-height w))))
         (when (and (>= local-y 0) (<= 0 index) (< index (length (items w)))) index))))))
(defun dispatch (window event)
 "Dispatch input with state updates, generic widget handlers, popup dismissal, context menus and dialog dragging."
 (when (disposed-p window) (return-from dispatch nil))
 (let ((blocker (modal-blocker window)))
   (when blocker
     (cancel-drag window)
     (when (member (event-kind event) '(:down :key :text :context)) (focus-modal blocker))
     (return-from dispatch nil)))
 (when (dispatch-drag window event) (return-from dispatch nil))
 (refresh-commands window)
 (when (eq (event-kind event) :key)
   (setf (focus-visible-p window) t)
   (emit window :key event)
   (unless (event-key event) (return-from dispatch nil)))
 (let* ((root (input-root window)) (target (hit-test root (event-x event) (event-y event)))
        (kind (event-kind event)) (pressed (slot-value window 'pressed-widget)))
   (walk-widgets window (lambda (w) (update-pointer-hover w target event)))
   (dolist (d (slot-value window 'overlays))
     (walk-widgets d (lambda (w) (update-pointer-hover w target event))))
   (when (and (eq kind :down) (null target) (or (typep root 'popover) (typep root 'context-menu)))
     (close-dialog window) (return-from dispatch nil))
   (when (eq kind :move)
     (setf (slot-value window 'overlays)
       (remove-if (lambda (d) (typep d 'tooltip)) (slot-value window 'overlays)))
     (when (and target (tooltip-text target))
       (let* ((pad (style-value target :padding))
              (label (make-widget 'label :text (tooltip-text target)))
              (tw (min (width window) (+ (* 4 pad) (text-width target (tooltip-text target)))))
              (th (+ (* 2 pad) (line-height target)))
              (tip (make-widget 'tooltip :width tw :height th
                     :x (max 0 (min (+ 12 (event-x event)) (- (width window) tw)))
                     :y (max 0 (min (+ 16 (event-y event)) (- (height window) th))))))
         (setf (height label) (line-height target))
         (add-child tip label)
         (setf (parent tip) window)
         ;; Pointer input runs after layout; place the new label before rendering.
         (layout tip (x tip) (y tip) tw th)
         (push tip (slot-value window 'overlays)))))
   (when (eq kind :down)
     (when pressed (setf (pressed-p pressed) nil))
     (setf (slot-value window 'pressed-widget) target)
     (when target (setf (pressed-p target) t)
       (when (focusable-p target) (focus window target) (setf (focus-visible-p window) (typep target 'entry))))
     (when (and (typep root 'dialog) (draggable-p root)
                (or (eq target root) (< (event-y event) (+ (y root) (style-value root :title-height))))
                (contains-point-p root (event-x event) (event-y event)))
       (setf (slot-value window 'interaction-state)
             (list :drag root (- (event-x event) (x root)) (- (event-y event) (y root))))
       (return-from dispatch root)))
   (when (eq kind :down) (arm-pointer-drag window event target))
   ;; Scrollbar capture belongs to the scroll view even while over its children.
   (when (and (eq kind :down) target)
     (let ((view (ancestor-of-type target 'scroll-view)))
       (when (and view (plusp (scroll-range view)))
         (multiple-value-bind (sx sy sw sh travel) (scrollbar-bounds view)
           (declare (ignore sw travel))
           (when (>= (event-x event) sx)
             (setf (slot-value window 'interaction-state)
                   (list :scrollbar view (if (<= sy (event-y event) (+ sy sh))
                                            (- (event-y event) sy) (/ sh 2))))
             (setf (slot-value window 'pressed-widget) view)
             (drag-scrollbar view (event-y event) (third (slot-value window 'interaction-state)))
             (return-from dispatch view))))))
   (when (eq (first (slot-value window 'interaction-state)) :scrollbar)
     (destructuring-bind (tag view offset) (slot-value window 'interaction-state)
       (declare (ignore tag))
       (when (eq kind :move) (drag-scrollbar view (event-y event) offset))
       (when (eq kind :up)
         (setf (slot-value window 'interaction-state) nil (slot-value window 'pressed-widget) nil
               (pressed-p view) nil))
       (return-from dispatch view)))
   (when (and (eq kind :move) (eq (first (slot-value window 'interaction-state)) :drag))
     (destructuring-bind (tag d dx dy) (slot-value window 'interaction-state)
       (declare (ignore tag))
       (setf (position-mode d) :absolute (x d) (- (event-x event) dx) (y d) (- (event-y event) dy))
       (when (and (detach-on-drag-p d) (or (< (x d) (x window)) (< (y d) (y window))
                    (> (+ (x d) (width d)) (+ (x window) (width window)))
                    (> (+ (y d) (height d)) (+ (y window) (height window)))))
         (detach-window d) (setf (slot-value window 'interaction-state) nil)))
     (return-from dispatch root))
   (when (eq kind :up)
     (when pressed (setf (pressed-p pressed) nil))
     (when (slot-value window 'interaction-state)
       (setf (slot-value window 'interaction-state) nil) (return-from dispatch root)))
   (when (and (eq kind :move) (typep pressed 'slider) (not (typep pressed 'progress-bar)) (not (typep pressed 'spin-button)))
     (change-number pressed (+ (minimum pressed) (* (- (maximum pressed) (minimum pressed))
                                    (/ (- (event-x event) (x pressed)) (max 1 (width pressed)))))))
   (when (eq kind :context)
     (when target
       (if (has-handler-p target :context) (emit target :context event)
           (open-context-menu window target event)))
     (return-from dispatch target))
   (let ((receiver (cond ((eq kind :key) (focused-widget window))
                         ((and pressed (member kind '(:move :up))) pressed) (t target))))
     (when (and receiver (handle-event receiver event))
       (when (eq kind :up) (setf (slot-value window 'pressed-widget) nil))
       (return-from dispatch receiver)))
   ;; Splitter gestures are captured on the paned ancestor, including its child surfaces.
   (let ((pane (and target (ancestor-of-type target 'paned))))
     (when (and pane (eq kind :down))
       (let* ((horizontal (eq (orientation pane) :horizontal))
              (position (- (if horizontal (event-x event) (event-y event)) (if horizontal (x pane) (y pane))))
              (split (* (if horizontal (width pane) (height pane)) (value pane))))
         (when (<= (abs (- position split)) (style-value pane :padding))
           (setf (slot-value window 'pressed-widget) pane) (return-from dispatch pane)))))
   (when (and (eq kind :move) (typep pressed 'paned))
     (setf (value pressed) (max 0 (min 1
       (if (eq (orientation pressed) :horizontal)
           (/ (- (event-x event) (x pressed)) (max 1 (width pressed)))
           (/ (- (event-y event) (y pressed)) (max 1 (height pressed)))))))
     (emit pressed :change (value pressed)))
   (dispatch-base window event)))
(defun chooser-action (dialog caption callback)
 (let ((button (make-widget 'button :text caption)))
   (on button :activate (lambda (w e) (declare (ignore w e)) (funcall callback)))
   (add-child dialog button)))
(defun choose-file (window callback &key (directory (user-homedir-pathname)))
 "Open a portable directory/file browser. CALLBACK receives the selected pathname."
 (let* ((d (make-widget 'file-chooser :directory directory :width 560 :height 480))
        (path (make-widget 'entry :text (namestring directory)))
        (files (make-widget 'list-view :height 280)))
   (labels ((refresh ()
              (let ((dir (uiop:ensure-directory-pathname (text path))))
                (setf (directory d) dir (items files)
                      (mapcar #'namestring (append (uiop:subdirectories dir) (uiop:directory-files dir)))))))
     (add-child d path) (add-child d files)
     (on files :change (lambda (w index) (setf (text path) (nth index (items w)))))
     (chooser-action d "Browse directory" #'refresh)
     (chooser-action d "Choose" (lambda () (setf (value d) (pathname (text path)))
       (dismiss-dialog d) (funcall callback (value d))))
     (refresh)) (show-dialog window d)))
(defun choose-color (window callback &key (initial '(0 0 0 255)))
 "Open four byte-channel sliders. CALLBACK receives a copied RGBA list on Apply."
 (let ((d (make-widget 'color-chooser :value (copy-list initial) :width 400 :height 300)))
   (dotimes (i 4)
     (let ((index i) (slider (make-widget 'slider :value (nth i initial) :maximum 255)))
       (on slider :change (lambda (w v) (declare (ignore w))
         (setf (value d) (loop for old in (value d) for j from 0 collect (if (= j index) (round v) old)))))
       (add-child d slider)))
   (chooser-action d "Apply color" (lambda () (dismiss-dialog d) (funcall callback (copy-list (value d)))))
   (show-dialog window d)))
(defun choose-font (window callback &key initial)
 "Choose a font file and positive pixel size. CALLBACK receives pathname and size."
 (let* ((d (make-widget 'font-chooser :value initial :width 540 :height 230))
        (path (make-widget 'entry :text (if initial (namestring (pathname initial)) "")))
        (size (make-widget 'spin-button :minimum 1 :maximum 128 :value 18)))
   (add-child d path) (add-child d size)
   (chooser-action d "Apply font" (lambda ()
     (unless (probe-file (text path)) (error "Font file does not exist."))
     (setf (value d) (pathname (text path)) (font-size d) (round (value size)))
     (dismiss-dialog d) (funcall callback (value d) (font-size d))))
   (show-dialog window d)))

(defmethod handle-event ((w spin-button) e)
 (case (event-kind e)
   (:down (change-number w (+ (value w) (* (step w)
                  (if (< (event-x e) (+ (x w) (/ (width w) 2))) -1 1)))) t)
   (:wheel (unless (zerop (event-delta e))
             (change-number w (+ (value w) (* (step w) (signum (event-delta e)))))) t)))
(defmethod handle-event ((w table-view) e)
 (let ((header (row-height w)))
   (cond ((and (eq (event-kind e) :down) (< (event-y e) (+ (y w) header)))
          (when (columns w)
            (sort-table w (min (1- (length (columns w)))
               (max 0 (floor (* (- (event-x e) (x w)) (length (columns w))) (max 1 (width w))))))) t)
         ((and (eq (event-kind e) :up) (eq w (slot-value (root-of w) 'pressed-widget)))
          (let ((index (floor (+ (- (event-y e) (y w) header) (scroll-offset w)) (row-height w))))
            (when (< -1 index (length (rows w))) (setf (value w) index) (emit w :change index))) t))))

(defun layout-window (w &optional (width (width w)) (height (height w)))
 "Lay out root content and overlays, respecting dragged and pointer-positioned surfaces."
 (layout w 0 0 width height)
 (dolist (d (reverse (slot-value w 'overlays)))
   (layout d (if (eq (position-mode d) :center) (max 0 (/ (- width (width d)) 2)) (x d))
             (if (eq (position-mode d) :center) (max 0 (/ (- height (height d)) 2)) (y d))
             (width d) (height d))) w)

(defmethod handle-event ((w text-view) e)
 (when (eq (event-kind e) :wheel)
   (let ((extent (+ (* 2 (style-value w :padding)) (* (length (text-lines (text w))) (line-height w)))))
     (setf (vertical-offset w) (max 0 (min (max 0 (- extent (height w)))
                               (- (vertical-offset w) (* (line-height w) (event-delta e))))))) t))
(defun bind-key (window key function &key owner)
 "Bind normalized KEY to a no-argument action on WINDOW, outside modal dialogs.
Examples: :CONTROL-S, :CONTROL-SHIFT-S, :F1. Return ON's callback and connection."
 (on window :key (lambda (w event)
   (when (and (eq (input-root w) w) (eq key (event-key event)))
     (funcall function) (setf (event-key event) nil))) :owner owner))
