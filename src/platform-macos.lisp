(in-package #:lut)

;; AppKit lives only in the primary raylib process. Worker roots keep their
;; drawn adapters; no Objective-C pointers or Lisp callbacks cross IPC.
#+darwin
(progn
 (cffi:load-foreign-library "/System/Library/Frameworks/AppKit.framework/AppKit")
 (cffi:load-foreign-library "/usr/lib/libobjc.A.dylib")
 (cffi:defcfun ("objc_getClass" cocoa-class) :pointer (name :string))
 (cffi:defcfun ("sel_registerName" cocoa-selector) :pointer (name :string))
 (cffi:defcfun ("objc_allocateClassPair" cocoa-allocate-class) :pointer (super :pointer) (name :string) (bytes :size))
 (cffi:defcfun ("objc_registerClassPair" cocoa-register-class) :void (class :pointer))
 (cffi:defcfun ("class_addMethod" cocoa-add-method) :uint8 (class :pointer) (selector :pointer) (implementation :pointer) (types :string))
 (defmacro cocoa-send (object selector &rest arguments)
   `(cffi:foreign-funcall "objc_msgSend" :pointer ,object :pointer (cocoa-selector ,selector) ,@arguments))
 ;; NSWindow's title-bar gesture is not reliably provided by GLFW's plain
 ;; window subclass. Intercept only the second title-bar press, before AppKit
 ;; enters its synchronous drag tracking loop. Everything else keeps GLFW's
 ;; original event dispatch. No event monitor, polling or drawing hook.
 (cffi:defcstruct cocoa-point (x :double) (y :double))
 (cffi:defcstruct cocoa-size (width :double) (height :double))
 (cffi:defcstruct cocoa-rect (origin (:struct cocoa-point)) (size (:struct cocoa-size)))
 (defun cocoa-view-frame (view)
   ;; Intel's Objective-C ABI returns NSRect through objc_msgSend_stret;
   ;; Apple Silicon uses ordinary objc_msgSend for all structure returns.
   #+x86-64
   (cffi:with-foreign-object (rect '(:struct cocoa-rect))
     (cffi:foreign-funcall "objc_msgSend_stret" :pointer rect :pointer view
       :pointer (cocoa-selector "frame") :void)
     (cffi:mem-ref rect '(:struct cocoa-rect)))
   #-x86-64 (cocoa-send view "frame" (:struct cocoa-rect)))
 (cffi:defcfun ("object_getClass" cocoa-object-class) :pointer (object :pointer))
 (cffi:defcfun ("class_getMethodImplementation" cocoa-method) :pointer (class :pointer) (selector :pointer))
 (cffi:defcfun ("class_getSuperclass" cocoa-superclass) :pointer (class :pointer))
 (defvar *cocoa-window-dispatch* (make-hash-table))
 (defun cocoa-titlebar-double-click-p (window event)
   (and (= 1 (cocoa-send event "type" :unsigned-long)) ; NSEventTypeLeftMouseDown
        (= 2 (cocoa-send event "clickCount" :long))
        (= 9 (logand 9 (cocoa-send window "styleMask" :unsigned-long))) ; titled + resizable
        (zerop (logand (ash 1 14) (cocoa-send window "styleMask" :unsigned-long))) ; not full screen
        (let* ((point (cocoa-send event "locationInWindow" (:struct cocoa-point)))
               (view (cocoa-send window "contentView" :pointer))
               (rect (cocoa-view-frame view))
               (origin (getf rect 'origin)) (size (getf rect 'size))
               (x (getf point 'x)) (y (getf point 'y)))
          (and (<= (getf origin 'x) x) (< x (+ (getf origin 'x) (getf size 'width)))
               (>= y (+ (getf origin 'y) (getf size 'height)))
               ;; Native traffic lights must keep their own click behavior.
               (let* ((frame-view (cocoa-send view "superview" :pointer))
                      (hit (cocoa-send frame-view "hitTest:" (:struct cocoa-point) point :pointer)))
                 (loop for node = hit then (cocoa-send node "superview" :pointer)
                       until (cffi:null-pointer-p node)
                       never (plusp (cocoa-send node "isKindOfClass:" :pointer (cocoa-class "NSControl") :uint8))))))))
 (cffi:defcallback cocoa-window-send-event :void ((self :pointer) (selector :pointer) (event :pointer))
   ;; Never unwind a Lisp condition through AppKit/GLFW.
   (let ((handled (handler-case
                     (when (cocoa-titlebar-double-click-p self event)
                       (cocoa-send self "zoom:" :pointer (cffi:null-pointer) :void) t)
                   (error (condition) (warn "Title-bar zoom failed: ~A" condition) nil))))
     (unless handled
       (let ((implementation
               (loop for class = (cocoa-object-class self) then (cocoa-superclass class)
                     until (cffi:null-pointer-p class)
                     for method = (gethash (cffi:pointer-address class) *cocoa-window-dispatch*)
                     when method return method)))
         (if implementation
             (cffi:foreign-funcall-pointer implementation ()
               :pointer self :pointer selector :pointer event :void)
             (warn "Missing original native window event dispatcher."))))))
 (defun install-cocoa-titlebar-zoom ()
   ;; Extend GLFW's window class, not an individual window's isa: AppKit may
   ;; already have installed a KVO subclass, which must remain untouched.
   (let* ((window (rl:get-window-handle)) (class (cocoa-class "GLFWWindow"))
          (key (cffi:pointer-address class)) (selector (cocoa-selector "sendEvent:")))
     (when (or (cffi:null-pointer-p class)
               (zerop (cocoa-send window "isKindOfClass:" :pointer class :uint8)))
       (error "Unsupported native window class for title-bar zoom."))
     (unless (gethash key *cocoa-window-dispatch*)
       (let ((original (cocoa-method class selector)))
         ;; Add an override of NSWindow's inherited implementation. Do not
         ;; replace another backend's implementation or change NSWindow itself.
         (unless (plusp (cocoa-add-method class selector (cffi:callback cocoa-window-send-event) "v@:@"))
           (error "Could not install GLFW title-bar event dispatch."))
         (setf (gethash key *cocoa-window-dispatch*) original)))))
 (defun cocoa-string (string) (cocoa-send (cocoa-class "NSString") "stringWithUTF8String:" :string string :pointer))
 (defun cocoa-lisp-string (object)
   (unless (cffi:null-pointer-p object)
     (let ((p (cocoa-send object "UTF8String" :pointer)))
       (unless (cffi:null-pointer-p p) (cffi:foreign-string-to-lisp p :encoding :utf-8)))))
 (defvar *cocoa-menu-actions* (make-hash-table))
 (defvar *cocoa-menu-targets* (make-hash-table))
 (defvar *cocoa-action-sequence* 0)
 (defvar *cocoa-target-class* nil)
 (defvar *native-path-request* nil)
 (defun queue-cocoa-error (menu condition)
   (when (and menu (not (disposed-p menu))) (enqueue-ui (lambda () (error condition)) :owner menu)))
 (cffi:defcallback cocoa-menu-action :void ((self :pointer) (selector :pointer) (sender :pointer))
   (declare (ignore self selector))
   (let* ((tag (cocoa-send sender "tag" :long)) (record (gethash tag *cocoa-menu-actions*)) (menu (first record)) (command (second record)))
     (when (and menu command (not (disposed-p menu)) (not *native-path-request*))
       ;; A command can signal; keep Lisp unwinds out of Objective-C frames.
       (handler-case (enqueue-ui (lambda () (invoke-menu-command menu command)) :owner menu)
         (error (condition) (ignore-errors (queue-cocoa-error menu condition)))))))
 (cffi:defcallback cocoa-menu-update :void ((self :pointer) (selector :pointer) (sender :pointer))
   (declare (ignore selector sender))
   (let ((menu (gethash (cffi:pointer-address self) *cocoa-menu-targets*)))
     (when menu
       (handler-case (update-native-command-menu menu (menu-command-snapshot menu))
         (error (condition) (ignore-errors (queue-cocoa-error menu condition)))))))
 (defun cocoa-command-target-class ()
   (or *cocoa-target-class*
       (setf *cocoa-target-class*
         (let ((class (cocoa-allocate-class (cocoa-class "NSObject") "LUTCommandMenuTarget" 0)))
           (when (cffi:null-pointer-p class) (error "Could not allocate AppKit command target."))
           (unless (and (plusp (cocoa-add-method class (cocoa-selector "lutActivate:") (cffi:callback cocoa-menu-action) "v@:@"))
                        (plusp (cocoa-add-method class (cocoa-selector "menuNeedsUpdate:") (cffi:callback cocoa-menu-update) "v@:@")))
             (error "Could not register AppKit command callbacks."))
           (cocoa-register-class class) class))))
 (defmethod native-platform-available-p ((window window))
   (and (rl:is-window-ready) (rl::main-thread-p) (eq window *active-window*) (not (disposed-p window))))
 (defun cocoa-shortcut (shortcut)
   (let ((mask 0) (key shortcut))
     (if (listp shortcut)
         (setf key (getf shortcut :key) mask (+ (if (getf shortcut :shift) (ash 1 17) 0)
           (if (getf shortcut :control) (ash 1 18) 0) (if (getf shortcut :alt) (ash 1 19) 0) (if (getf shortcut :super) (ash 1 20) 0)))
         (when shortcut
           (let ((name (symbol-name shortcut)))
             (when (and (>= (length name) 8) (string= name "CONTROL-" :end1 8))
               (setf mask (ash 1 20) name (subseq name 8)))
             (when (and (>= (length name) 6) (string= name "SHIFT-" :end1 6))
               (incf mask (ash 1 17)) (setf name (subseq name 6)))
             (setf key (intern name :keyword)))))
     (let ((string (cond ((null key) "")
                        ((= (length (symbol-name key)) 1) (string-downcase (symbol-name key)))
                        (t (case key (:comma ",") (:enter (string #\Return)) (:tab (string #\Tab)) (:space " ") (:escape (string (code-char 27)))
                             (:left (string (code-char #xf702))) (:right (string (code-char #xf703)))
                             (:up (string (code-char #xf700))) (:down (string (code-char #xf701)))
                             (otherwise ""))))))
       (values string mask))))
 (defmethod native-shortcut-supported-p ((command command)) (plusp (length (cocoa-shortcut (command-shortcut command)))))
 (defun cocoa-new-menu (title)
   (let ((menu (cocoa-send (cocoa-send (cocoa-class "NSMenu") "alloc" :pointer) "initWithTitle:" :pointer (cocoa-string title) :pointer)))
     (cocoa-send menu "setAutoenablesItems:" :uint8 0 :void) menu))
 (defmethod activate-native-command-menu ((menu command-menu))
   (let* ((app (cocoa-send (cocoa-class "NSApplication") "sharedApplication" :pointer))
          (previous (cocoa-send app "mainMenu" :pointer)) (native (cocoa-new-menu "LUT"))
          (target (cocoa-send (cocoa-send (cocoa-command-target-class) "alloc" :pointer) "init" :pointer)))
     (cocoa-send previous "retain" :pointer)
     (setf (menu-native-state menu) (list :app app :previous previous :menu native :target target :items nil :tags nil :submenus nil))
     (handler-case
       (progn
         (setf (gethash (cffi:pointer-address target) *cocoa-menu-targets*) menu)
         ;; Preserve the platform application menu (About/Hide/Quit) and restore
         ;; the entire original main menu when this context closes.
         (when (and (not (cffi:null-pointer-p previous)) (plusp (cocoa-send previous "numberOfItems" :long)))
           (let ((item (cocoa-send (cocoa-send previous "itemAtIndex:" :long 0 :pointer) "copy" :pointer)))
             (cocoa-send native "addItem:" :pointer item :void) (cocoa-send item "release" :void)))
         (dolist (group (menu-groups menu))
           (let* ((submenu (cocoa-new-menu (getf group :label)))
                  (item (cocoa-send native "addItemWithTitle:action:keyEquivalent:" :pointer (cocoa-string (getf group :label))
                          :pointer (cffi:null-pointer) :pointer (cocoa-string "") :pointer)))
             (cocoa-send item "setSubmenu:" :pointer submenu :void)
             (cocoa-send submenu "setDelegate:" :pointer target :void)
             (dolist (command (getf group :commands))
               (if (menu-separator-p command)
                   (cocoa-send submenu "addItem:" :pointer (cocoa-send (cocoa-class "NSMenuItem") "separatorItem" :pointer) :void)
                   (let* ((tag (incf *cocoa-action-sequence*))
                          (item (cocoa-send submenu "addItemWithTitle:action:keyEquivalent:" :pointer (cocoa-string (command-label command))
                                  :pointer (cocoa-selector "lutActivate:") :pointer (cocoa-string "") :pointer)))
                     (cocoa-send item "setTarget:" :pointer target :void) (cocoa-send item "setTag:" :long tag :void)
                     (setf (gethash tag *cocoa-menu-actions*) (list menu command))
                     (push tag (getf (menu-native-state menu) :tags))
                     (push (cons command item) (getf (menu-native-state menu) :items)))))
             (cocoa-send submenu "release" :void)))
         (cocoa-send app "setMainMenu:" :pointer native :void) t)
       (error (condition) (release-native-command-menu menu) (error condition)))))
 (defun cocoa-fill-submenu (menu native records)
   (let ((target (getf (menu-native-state menu) :target)))
     (dolist (record records)
       (if (eq record :separator)
         (cocoa-send native "addItem:" :pointer (cocoa-send (cocoa-class "NSMenuItem") "separatorItem" :pointer) :void)
         (let* ((command (getf record :command)) (tag (incf *cocoa-action-sequence*))
                (item (cocoa-send native "addItemWithTitle:action:keyEquivalent:" :pointer (cocoa-string (getf record :label))
                        :pointer (cocoa-selector "lutActivate:") :pointer (cocoa-string "") :pointer)))
           (cocoa-send item "setTarget:" :pointer target :void)
           (cocoa-send item "setTag:" :long tag :void)
           (cocoa-send item "setEnabled:" :uint8 (if (and (getf record :enabled) (not *native-path-request*)) 1 0) :void)
           (setf (gethash tag *cocoa-menu-actions*) (list menu command))
           (push tag (getf (menu-native-state menu) :tags))
           (when (command-submenu command)
             (let ((child (cocoa-new-menu (getf record :label))))
               (cocoa-send item "setSubmenu:" :pointer child :void)
               (cocoa-fill-submenu menu child (getf record :commands))
               (cocoa-send child "release" :void))))))))
 (defmethod update-native-command-menu ((menu command-menu) snapshot)
   (let* ((state (menu-native-state menu))
          (key (list snapshot (not (null *native-path-request*)))))
     ;; Cocoa setters allocate strings and cross FFI. Unchanged command state
     ;; needs no native work, including menu delegate refreshes.
     (when (and state (equal key (getf state :snapshot)))
       (return-from update-native-command-menu menu))
     (when state
       (setf (getf state :snapshot) key)
       (dolist (group snapshot)
         (dolist (record (getf group :commands))
           (when (and record (not (eq record :separator)))
             (dolist (pair (remove-if-not (lambda (pair) (eq (car pair) (getf record :command))) (getf state :items)))
              (let ((item (cdr pair)))
               (unless (command-submenu (getf record :command))
                 (let ((old (assoc (cffi:pointer-address item) (getf state :submenus))))
                   (when old
                     (cocoa-send item "setSubmenu:" :pointer (cffi:null-pointer) :void)
                     (dolist (tag (third old))
                       (remhash tag *cocoa-menu-actions*)
                       (setf (getf state :tags) (remove tag (getf state :tags))))
                     (setf (getf state :submenus) (remove old (getf state :submenus))))))
               (when (command-submenu (getf record :command))
                 (let* ((old (assoc (cffi:pointer-address item) (getf state :submenus))))
                   (unless (and old (equal (second old) (getf record :commands)))
                     (dolist (tag (third old))
                       (remhash tag *cocoa-menu-actions*)
                       (setf (getf (menu-native-state menu) :tags)
                             (remove tag (getf (menu-native-state menu) :tags))))
                     (let ((child (cocoa-new-menu (getf record :label)))
                           (before (copy-list (getf (menu-native-state menu) :tags))))
                       (cocoa-send item "setSubmenu:" :pointer child :void)
                       (cocoa-fill-submenu menu child (getf record :commands))
                       (cocoa-send child "release" :void)
                       (let ((entry (list (cffi:pointer-address item) (getf record :commands)
                                      (set-difference (getf (menu-native-state menu) :tags) before))))
                         (if old (setf (cdr old) (cdr entry))
                           (push entry (getf (menu-native-state menu) :submenus))))))))
               (cocoa-send item "setTitle:" :pointer (cocoa-string (getf record :label)) :void)
               (cocoa-send item "setEnabled:" :uint8 (if (and (getf record :enabled) (not *native-path-request*)) 1 0) :void)
               (multiple-value-bind (key mask) (cocoa-shortcut (getf record :shortcut))
                 (cocoa-send item "setKeyEquivalent:" :pointer (cocoa-string key) :void)
                 (cocoa-send item "setKeyEquivalentModifierMask:" :unsigned-long mask :void)))))))) menu))
 (defmethod release-native-command-menu ((menu command-menu))
   (let ((state (menu-native-state menu)))
     (when state
       (setf (menu-native-state menu) nil)
       (dolist (tag (getf state :tags)) (remhash tag *cocoa-menu-actions*))
       (remhash (cffi:pointer-address (getf state :target)) *cocoa-menu-targets*)
       (when (cffi:pointer-eq (cocoa-send (getf state :app) "mainMenu" :pointer) (getf state :menu))
         (cocoa-send (getf state :app) "setMainMenu:" :pointer (getf state :previous) :void))
       (cocoa-send (getf state :menu) "release" :void)
       (cocoa-send (getf state :target) "release" :void)
       (cocoa-send (getf state :previous) "release" :void))) menu)
 (defun cocoa-path-panel (request)
   (let* ((save (eq (request-kind request) :save))
          (panel (cocoa-send (cocoa-class (if save "NSSavePanel" "NSOpenPanel")) (if save "savePanel" "openPanel") :pointer)))
     (cocoa-send panel "setTitle:" :pointer (cocoa-string (request-title request)) :void)
     (cocoa-send panel "setDirectoryURL:" :pointer
       (cocoa-send (cocoa-class "NSURL") "fileURLWithPath:" :pointer (cocoa-string (namestring (request-directory request))) :pointer) :void)
     (cocoa-send panel "setCanCreateDirectories:" :uint8 0 :void)
     (when (request-filename request) (cocoa-send panel "setNameFieldStringValue:" :pointer (cocoa-string (request-filename request)) :void))
     (unless save
       (cocoa-send panel "setAllowsMultipleSelection:" :uint8 0 :void)
       (cocoa-send panel "setCanChooseFiles:" :uint8 (if (eq (request-kind request) :file) 1 0) :void)
       (cocoa-send panel "setCanChooseDirectories:" :uint8 (if (eq (request-kind request) :folder) 1 0) :void)) panel))
 (defvar *cocoa-panel-runner* nil) ; Internal test seam; production uses AppKit's modal event loop.
 (defmethod run-native-path-request ((request path-request))
   (let* ((*native-path-request* request) (panel (cocoa-path-panel request))
          (response (if *cocoa-panel-runner* (funcall *cocoa-panel-runner* panel) (cocoa-send panel "runModal" :long))))
     (finish-path-request request
       (when (= response 1)
         (let* ((url (cocoa-send panel "URL" :pointer)) (string (cocoa-lisp-string (cocoa-send url "path" :pointer))))
           (unless string (error "Native picker accepted without a file URL."))
           (accepted-request-path request string)))))))
