(in-package #:lut)
(defparameter *style-defaults*
 '(:font nil :font-size 18 :font-spacing 0 :line-height 26 :row-height 30
   :surface (255 255 255 255) :on-accent (255 255 255 255)
   :padding 8 :caret-width 2 :border-width 1 :border-radius 0.3
   :border-color (130 140 160 255) :focus-color (40 120 240 255)
   :hover-color (200 210 225 255) :pressed-color (165 185 220 255)
   :disabled-color (120 125 135 255) :title-height 28)
 "Fallback metrics and appearance tokens; every rendered dimension resolves through styling.")
(defun widget-state (w)
 "Return current style state, with priority disabled, pressed, hover, focus, normal."
 (cond ((loop for node = w then (parent node) while node thereis (not (enabled-p node))) :disabled) ((pressed-p w) :pressed) ((hovered-p w) :hover)
       ((and (typep (root-of w) 'window) (eq (focused-widget (root-of w)) w)) :focus)
       (t :normal)))
(defun property (plist key)
 (loop for (k v) on plist by #'cddr when (eq k key) do (return-from property (values v t)))
 (values nil nil))
(defun style-roots (w)
 (let ((root (root-of w)) (roots nil))
   (loop while (typep root 'window) do
     (when (member root roots) (error "Style source cycle."))
     (push root roots) (setf root (style-source root)))
   (nreverse roots)))
(defun style-value (w key &optional default)
 "Resolve local state/base, inherited overrides, class/state rules, root/application themes, then defaults.
STYLE-SOURCE propagates application styling across native windows. Later matching rules win within a root."
 (let ((state (widget-state w)) (roots (style-roots w)))
   (labels ((lookup (node)
              (multiple-value-bind (v found) (property (getf (state-style node) state) key)
                (when found (return-from style-value v)))
              (multiple-value-bind (v found) (property (style node) key)
                (when found (return-from style-value v)))))
     (loop for node = w then (parent node) while node do (lookup node))
     (dolist (root (rest roots)) (lookup root)))
   (dolist (root roots)
     (dolist (rule (reverse (style-rules root)))
       (when (and (typep w (getf rule :class 'widget))
                  (or (null (getf rule :state)) (eq state (getf rule :state))))
         (multiple-value-bind (v found) (property (getf rule :style) key)
           (when found (return-from style-value v))))))
   (dolist (root roots)
     (multiple-value-bind (v found) (property (theme root) key)
       (when found (return-from style-value v))))
   (multiple-value-bind (v found) (property *style-defaults* key)
     (if found v (multiple-value-bind (color found) (property *light-theme* key)
                   (if found color default))))))
(defun row-height (w) "Styled list/table row height in pixels." (style-value w :row-height))
(defun line-height (w) "Styled text line height in pixels." (style-value w :line-height))
(defun validate-style (tokens)
 (unless (evenp (length tokens)) (error "Styles must be property lists."))
 (loop for (key v) on tokens by #'cddr do
   (case key
     ((:font-size :line-height :row-height :title-height)
      (unless (typep v '(real (0) *)) (error "~a must be positive." key)))
     ((:padding :font-spacing :border-width :caret-width)
      (unless (typep v '(real 0 *)) (error "~a must be non-negative." key)))
     (:border-radius (unless (typep v '(real 0 1)) (error "Border radius must be 0..1.")))
     (:font (unless (typep v '(or null pathname string)) (error "Font must be a pathname, string or NIL."))))) tokens)
(defmethod validate-slot :around ((w widget) slot value)
 (when (eq slot 'style-source)
   (loop for root = value then (style-source root) while root
         when (eq root w) do (error "Style source would form a cycle.")))
 (when (member slot '(style theme)) (validate-style value))
 (when (eq slot 'style-rules)
   (dolist (rule value)
     (unless (and (listp rule) (evenp (length rule))) (error "A style rule must be a property list."))
     (let ((class (getf rule :class 'widget)) (state (getf rule :state)))
       (unless (and (symbolp class) (find-class class nil)) (error "Unknown selector class ~s." class))
       (unless (member state '(nil :normal :hover :pressed :disabled :focus)) (error "Unknown rule state ~s." state)))
     (validate-style (getf rule :style))))
 (when (eq slot 'state-style)
   (unless (evenp (length value)) (error "State styles must be a property list."))
   (loop for (state tokens) on value by #'cddr do
     (unless (member state '(:normal :hover :pressed :disabled :focus)) (error "Unknown state ~s." state))
     (validate-style tokens)))
 (call-next-method))
