(in-package #:lut)
(defstruct remote-window process root reader owner dialog (focused-p nil) (topmost-p nil) (alive-p t) (pending-p nil) (frames 0) (forms nil) (closing-p nil) (write-lock (bt:make-lock "LUT worker writer")) (dispose-on-close-p t) target last-pixels last-size (encoded-frames 0) error)
(defvar *remote-windows* nil)
(defvar *remote-lock* (bt:make-lock "LUT window registry"))
(defvar *forwarded-events* nil)
(defun forward-native-event (event)
 (let ((copy (copy-event event)))
   (multiple-value-bind (x y) (ui-to-device *active-window* (event-x event) (event-y event))
     (setf (event-x copy) x (event-y copy) y))
   (push (event-data copy) *forwarded-events*)))
(defparameter *worker-command*
 (list #+sbcl (namestring sb-ext:*runtime-pathname*)
       #+ccl (first ccl:*command-line-argument-list*)
       #-(or sbcl ccl) "sbcl"
       #+sbcl "--noinform" #+sbcl "--non-interactive"
       #+ccl "--no-init" #+ccl "--batch")
 "Executable and startup flags for a worker. Override for other implementations or deployed images.")
(defun write-message (stream message)
 (with-standard-io-syntax
   (let ((*print-readably* t) (*print-circle* t)) (prin1 message stream) (terpri stream) (finish-output stream))))
(defun read-message (stream)
 (with-standard-io-syntax (let ((*read-eval* nil)) (read stream nil :eof))))
(defun event-data (e)
 (list :kind (event-kind e) :drop-data (copy-tree (event-drop-data e)) :x (event-x e) :y (event-y e) :key (event-key e)
       :text (event-text e) :delta (event-delta e) :shift-p (event-shift-p e)
       :control-p (event-control-p e) :alt-p (event-alt-p e) :super-p (event-super-p e) :base-key (event-base-key e)
       :timestamp (event-timestamp e) :click-count (event-click-count e)))
(defun encode-remote-frame (remote)
 "Render every frame for live code/custom drawing, but PNG-encode only changed pixels.
NIL means keep the worker's existing texture; control/input round trips continue."
 (let* ((root (remote-window-root remote)) (width (max 1 (round (* (width root) (ui-scale root)))))
        (height (max 1 (round (* (height root) (ui-scale root))))) (target (remote-window-target remote)))
   (unless (and target (= width (rl:texture-width (rl:render-texture-texture target)))
                       (= height (rl:texture-height (rl:render-texture-texture target))))
     (when target (retire-render-target target))
     (setf target (rl:load-render-texture width height) (remote-window-target remote) target))
   (rl:with-texture-mode (target)
     (rl:clear-background (style-value root :background)) (render-window root))
   (let ((image (rl:load-image-from-texture (rl:render-texture-texture target))))
     (unwind-protect
       (progn
         (rl:image-flip-vertical image)
         (let* ((size (rl:get-pixel-data-size width height (rl:image-pixel-format image)))
                (pixels (make-array size :element-type '(unsigned-byte 8)))
                (dimensions (list width height)))
           (dotimes (i size) (setf (aref pixels i) (cffi:mem-aref (rl:image-data image) :unsigned-char i)))
           (when (and (equal dimensions (remote-window-last-size remote))
                      (equalp pixels (remote-window-last-pixels remote)))
             (return-from encode-remote-frame nil))
           (cffi:with-foreign-object (length-pointer :int)
             (let ((pointer (rl:export-image-to-memory image ".png" length-pointer)))
               (when (cffi:null-pointer-p pointer) (error "Could not encode native window frame."))
               (unwind-protect
                 (let* ((length (cffi:mem-ref length-pointer :int))
                        (bytes (make-array length :element-type '(unsigned-byte 8))))
                   (dotimes (i length) (setf (aref bytes i) (cffi:mem-aref pointer :unsigned-char i)))
                   (prog1 (cl-base64:usb8-array-to-base64-string bytes)
                     (setf (remote-window-last-pixels remote) pixels (remote-window-last-size remote) dimensions)
                     (incf (remote-window-encoded-frames remote))))
                 (rl:mem-free pointer))))))
       (rl:unload-image image)))))
(defun decode-remote-frame (string)
 (let ((bytes (cl-base64:base64-string-to-usb8-array string)))
   (cffi:with-foreign-object (pointer :unsigned-char (length bytes))
     (dotimes (i (length bytes)) (setf (cffi:mem-aref pointer :unsigned-char i) (aref bytes i)))
     (let ((image (rl:load-image-from-memory ".png" pointer (length bytes))))
       (unwind-protect
         (let ((texture (rl:load-texture-from-image image)))
           (unless (rl:is-texture-valid texture) (error "Could not decode remote frame.")) texture)
         (rl:unload-image image))))))
(defun send-snapshot (remote)
 (when (and (remote-window-alive-p remote) (not (remote-window-closing-p remote)) (not (remote-window-pending-p remote)))
   (handler-case
     (let ((frame (encode-remote-frame remote)))
       (bt:with-lock-held ((remote-window-write-lock remote))
         (unless (remote-window-closing-p remote)
           (write-message (uiop:process-info-input (remote-window-process remote))
             (list :frame frame (prog1 (remote-window-forms remote) (setf (remote-window-forms remote) nil))
                     (text (remote-window-root remote)) (ui-scale (remote-window-root remote))))
           (setf (remote-window-pending-p remote) t))))
     (error (e) (setf (remote-window-error remote) e (remote-window-alive-p remote) nil)
                (ignore-errors (uiop:terminate-process (remote-window-process remote)))))))
(defun remote-alive-p (remote) "Whether the remote native window's worker is still alive." (remote-window-alive-p remote))
(defun lut-windows-active-p (primary-focused-p)
 (or primary-focused-p
     (some (lambda (r) (and (remote-window-alive-p r) (not (remote-window-closing-p r))
                            (remote-window-focused-p r)))
           (bt:with-lock-held (*remote-lock*) (copy-list *remote-windows*)))))
(defun set-modal-window-topmost (remote enabled)
 (unless (eq enabled (remote-window-topmost-p remote))
   (setf (remote-window-topmost-p remote) enabled)
   (evaluate-in-window remote
     (list (if enabled '(rl:set-window-state :window-topmost) '(rl:clear-window-state :window-topmost))))))
(defun sync-modal-window-levels (primary-focused-p)
 (let ((active (not (null (lut-windows-active-p primary-focused-p)))))
   (dolist (remote (bt:with-lock-held (*remote-lock*) (copy-list *remote-windows*)))
     (when (and (remote-window-alive-p remote) (not (remote-window-closing-p remote))
                (remote-window-dialog remote))
       (set-modal-window-topmost remote (and active (modal-p (remote-window-dialog remote))))
       ;; A queued focus request must not reactivate LUT after an app switch.
       (unless active
         (setf (remote-window-forms remote)
               (remove '(rl:set-window-focused) (remote-window-forms remote) :test #'equal)))))))
(defun pump-remote-windows ()
 (sync-modal-window-levels (and *active-window* (rl:is-window-focused)))
 (dolist (remote (bt:with-lock-held (*remote-lock*) (copy-list *remote-windows*)))
   (when (and (not (remote-window-alive-p remote)) (remote-window-target remote))
     (retire-render-target (remote-window-target remote)) (setf (remote-window-target remote) nil))
   (let ((root (remote-window-root remote)))
     (when (and (remote-window-alive-p remote) root (not (disposed-p root)))
       (emit root :tick (if *active-window* (rl:get-frame-time) 0))
       (when (and (eq root (remote-window-root remote)) (not (disposed-p root)))
         (open-pending-dialogs root) (layout-window root)
         (advance-text-selection root (if *active-window* (rl:get-frame-time) 0))
         (advance-drag root (if *active-window* (rl:get-frame-time) 0))
         (send-snapshot remote))))))
(defun spawn-window (window &key position (style-source *active-window*) (flags '(:window-resizable)))
 "Open WINDOW in a native worker process. Its objects and event callbacks stay in this REPL.
Parent GUI frames service IPC. POSITION is an optional (screen-x screen-y) list."
 (check-type window window)
 (when (and style-source (not (eq window style-source)))
   (setf (lut:style-source window) style-source)
   (unless (theme-explicit-p window) (setf (theme window) nil)))
 (let* ((script (asdf:system-relative-pathname "lut" "tools/window-worker.lisp"))
        (root (asdf:system-source-directory "lut"))
        (command (append *worker-command* (list "--load" (namestring script))))
        (process (uiop:launch-program command ;; Inherit the OS stderr descriptor. Editor REPLs can bind
                                      ;; *ERROR-OUTPUT* to a Gray stream; SBCL's process I/O copier
                                      ;; for that stream can stall PROCESS-WAIT during GUI teardown.
                                      :input :stream :output :stream :error-output :interactive
                                      :directory root #+ccl :sharing #+ccl :lock))
        (remote (make-remote-window :process process :root window
                  :topmost-p (not (null (member :window-topmost flags))))))
   (write-message (uiop:process-info-input process) (list :open (list (nth-value 0 (normal-window-size window)) (nth-value 1 (normal-window-size window)) (text window)) position flags (ui-scale window) (native-operation-generation window)))
   (setf (remote-window-pending-p remote) t)
   (bt:with-lock-held (*remote-lock*) (push remote *remote-windows*))
   (setf (remote-window-reader remote)
     (bt:make-thread
       (lambda ()
         (handler-case
           (loop for message = (read-message (uiop:process-info-output process))
                 until (or (eq message :eof) (eq (first message) :closed))
                 do (let ((packet message) (owner (remote-window-root remote)))
                      (when (and *controller-running-p* owner (not (disposed-p owner)))
                        (enqueue-ui (lambda ()
                          (let ((root (remote-window-root remote)))
                            (when (and root (not (disposed-p root)) (not (remote-window-closing-p remote))
                                       (eq (first packet) :input))
                              (accept-native-window-report root (sixth packet))
                              (setf (remote-window-focused-p remote) (fifth packet))
                              (unless (fifth packet) (cancel-text-selection root :forget-clicks t))
                              (layout root 0 0 (/ (second packet) (ui-scale root)) (/ (third packet) (ui-scale root)))
                              (dolist (data (fourth packet)) (dispatch-device-event root (apply #'make-event data)))))
                          (incf (remote-window-frames remote))
                          (setf (remote-window-pending-p remote) nil)) :owner owner))))
           (error (e) (setf (remote-window-error remote) e)))
         (setf (remote-window-alive-p remote) nil)
         (ignore-errors (close (uiop:process-info-input process) :abort t))
         (ignore-errors (close (uiop:process-info-output process) :abort t))
         (handler-case
           (let ((status (uiop:wait-process process)))
             (unless (eql status 0)
               (unless (remote-window-error remote)
                 (setf (remote-window-error remote)
                   (make-condition 'simple-error :format-control "Native worker exited with status ~a."
                                                 :format-arguments (list status))))))
           (error (e) (setf (remote-window-error remote) e)))
         (setf (remote-window-process remote) nil (remote-window-reader remote) nil)
         (if *controller-running-p*
             (enqueue-ui (lambda () (finalize-remote-window remote)))
             (finalize-remote-window remote)))
       :name "LUT native-window IPC")) remote))
(defun close-window (remote &key (dispose t))
 "Request closure of a remote native window; return REMOTE."
 (bt:with-lock-held ((remote-window-write-lock remote))
   (when (and (remote-window-alive-p remote) (not (remote-window-closing-p remote)))
     (setf (remote-window-closing-p remote) t (remote-window-dispose-on-close-p remote) dispose)
     (write-message (uiop:process-info-input (remote-window-process remote)) '(:close)))) remote)
(defmethod modal-blocker ((window window))
 (let ((remote (find-if (lambda (r)
                 (and (eq (remote-window-owner r) window)
                      (remote-window-alive-p r) (not (remote-window-closing-p r))
                      (remote-window-dialog r) (modal-p (remote-window-dialog r))))
                (bt:with-lock-held (*remote-lock*) (copy-list *remote-windows*)))))
   (when remote (or (modal-blocker (remote-window-root remote)) remote))))
(defmethod focus-modal ((remote remote-window))
 ;; Queue focus with the next frame; the worker owns the OS window/context.
 (unless (member '(rl:set-window-focused) (remote-window-forms remote) :test #'equal)
   (push '(rl:set-window-focused) (remote-window-forms remote)))
 remote)
(defun clear-modal-owner-hover (owner)
 (when (typep owner 'window)
   (walk-widgets owner (lambda (w)
     (setf (hovered-p w) nil)
     (when (typep w 'list-view) (setf (hovered-row w) nil))))))
(defmethod (setf modal-p) :after (value (dialog dialog))
 (let ((remote (bt:with-lock-held (*remote-lock*)
                 (find dialog *remote-windows* :key #'remote-window-dialog :test #'eq))))
   (when remote
     (let ((active (not (null (lut-windows-active-p (and *active-window* (rl:is-window-focused)))))))
       (set-modal-window-topmost remote (and value active))
       (when value
         (clear-modal-owner-hover (remote-window-owner remote))
         (when active (focus-modal remote)))))))
(defun native-dialog-p (d)
 (and (typep d 'dialog) (not (typep d 'popover)) (not (typep d 'context-menu)) (not (typep d 'portable-path-dialog))))
(defmethod present-dialog :around ((window window) (dialog dialog))
 (call-next-method)
 (when (and *controller-running-p* (native-dialog-p dialog))
   (layout-window window)
   (detach-window dialog))
 dialog)
(defun open-pending-dialogs (window)
 "Open dialogs queued before the GUI loop without first drawing an overlay."
 (dolist (dialog (reverse (copy-list (slot-value window 'overlays))))
   (when (native-dialog-p dialog)
     (layout-window window) (detach-window dialog))))
(defmethod detach-window ((d dialog))
 (let* ((old-root (root-of d))
        (w (make-widget 'window :text (text d) :width (width d) :height (height d)
             :ui-scale (if (typep old-root 'window) (ui-scale old-root) 1) :content-layout :fill
                        :theme nil :style-source (when (typep old-root 'window) old-root)))
        (pos (when *active-window* (let ((p (rl:get-window-position)))
                 (list (+ (rl:vector2-x p) (x d)) (+ (rl:vector2-y p) (y d)))))))
   ;; Spawn first; retain original ownership if worker startup fails synchronously.
   (let ((remote (spawn-window w :position pos :style-source (when (typep old-root 'window) old-root)
                   :flags (if (modal-p d) '(:window-resizable :window-topmost) '(:window-resizable)))))
     (when (typep old-root 'window)
       (setf (slot-value old-root 'overlays) (remove d (slot-value old-root 'overlays)))
       (setf (focused-widget old-root) nil
             (slot-value old-root 'pressed-widget) nil (pressed-p d) nil))
     (setf (parent d) nil (position-mode d) :absolute (x d) 0 (y d) 0
           (native-p d) t (draggable-p d) nil (detach-on-drag-p d) nil)
     (add-child w d)
     (setf (remote-window-owner remote) old-root (remote-window-dialog remote) d)
     (when (modal-p d) (clear-modal-owner-hover old-root) (focus-modal remote))
     remote)))
(defun worker-main ()
 (with-native-logging
 (let* ((input *standard-input*) (output *standard-output*)
        (*standard-output* *error-output*) (*trace-output* *error-output*)
        (opening (read-message input)))
   (unless (eq (first opening) :open) (error "Expected worker OPEN message."))
   (let* ((w (make-widget 'window :width (first (second opening)) :height (second (second opening))
                              :text (third (second opening)) :ui-scale (or (fifth opening) 1))) (position (third opening))
          (flags (or (fourth opening) '(:window-resizable)))
          (texture nil)
          (*font-cache* nil) (*texture-cache* nil) (*active-window* w)
          (lock (bt:make-lock "LUT worker inbox")) (inbox nil) (closed nil)
          (*forwarded-events* nil) (acknowledge t)
          (reader (bt:make-thread
                    (lambda ()
                      (handler-case
                        (loop for message = (read-message input)
                              do (bt:with-lock-held (lock)
                                   (if (or (eq message :eof) (eq (first message) :close))
                                       (setf closed t) (setf inbox message)))
                              when (or (eq message :eof) (eq (first message) :close)) return nil)
                        (error () (bt:with-lock-held (lock) (setf closed t)))))
                    :name "LUT worker snapshot reader")))
     (declare (ignore reader))
     (setf (native-operation-generation w) (or (sixth opening) 0))
     (rl:with-window ((round (* (width w) (ui-scale w))) (round (* (height w) (ui-scale w))) (text w) :flags (adjoin :window-highdpi flags) :exit-key :null)
       (when position (rl:set-window-position (round (first position)) (round (second position))))
       (unwind-protect
         (loop
           (let ((message (bt:with-lock-held (lock) (prog1 inbox (setf inbox nil)))))
             (when message
               (unless (eq (first message) :frame) (error "Expected worker FRAME message."))
               (setf (ui-scale w) (or (fifth message) 1))
               (dolist (form (third message)) (eval form))
               (unless (equal (text w) (fourth message))
                 (setf (text w) (fourth message)) (rl:set-window-title (text w)))
               (when (second message)
                 (let ((new (decode-remote-frame (second message))))
                   (when texture (rl:unload-texture texture)) (setf texture new)))
               (setf acknowledge t)))
           (when (or (bt:with-lock-held (lock) closed) (rl:window-should-close)) (return))
           (sync-native-window-state w)
           (layout-window w (/ (rl:get-screen-width) (ui-scale w)) (/ (rl:get-screen-height) (ui-scale w)))
           (let ((*event-sink* #'forward-native-event)) (poll-input w))
           (rl:with-drawing (:black)
             (when texture
               (rl:draw-texture-pro texture (rl:rect 0 0 (rl:texture-width texture) (rl:texture-height texture))
                 (rl:rect 0 0 (rl:get-screen-width) (rl:get-screen-height)) (rl:vec2 0 0) 0 :white)))
           (when acknowledge
             (write-message output (list :input (rl:get-screen-width) (rl:get-screen-height) (nreverse *forwarded-events*) (rl:is-window-focused) (native-window-report w)))
             (setf *forwarded-events* nil acknowledge nil)))
         (when texture (rl:unload-texture texture))
         (mapc (lambda (pair) (rl:unload-font (cdr pair))) *font-cache*)
         (mapc (lambda (pair) (rl:unload-texture (cdr pair))) *texture-cache*)))
   (handler-case (write-message output '(:closed)) (stream-error () nil))))))

(defun evaluate-in-window (remote forms)
 "Queue explicit Lisp FORMS for evaluation on the native worker GUI thread before its next snapshot.
This is an intentional REPL evaluation API over private child-process pipes; never pass untrusted forms."
 (bt:with-lock-held ((remote-window-write-lock remote))
   (setf (remote-window-forms remote) (append (remote-window-forms remote) forms))) remote)
(defmacro on-window (remote &body forms)
 "Evaluate quoted FORMS in REMOTE's native GUI process. Use for explicit native worker operations; application class/method reloads belong in ON-UI."
 `(evaluate-in-window ,remote ',forms))

(defmethod dismiss-dialog :after ((d dialog))
 (let ((remote (bt:with-lock-held (*remote-lock*)
                 (find (root-of d) *remote-windows* :key #'remote-window-root :test #'eq))))
   (when remote (close-window remote))))

(defun finalize-remote-window (remote)
 (let ((root (remote-window-root remote)))
   (when root
     (handler-case (if (window-drag-controller root)
                       (unregister-drag-window (window-drag-controller root) root)
                       (cancel-drag root))
       (error (e) (unless (remote-window-error remote) (setf (remote-window-error remote) e)))))
   (when (and (remote-window-target remote) *active-window*)
     (retire-render-target (remote-window-target remote)))
   (setf (remote-window-owner remote) nil (remote-window-dialog remote) nil
         (remote-window-target remote) nil (remote-window-root remote) nil
         (remote-window-forms remote) nil (remote-window-pending-p remote) nil (remote-window-reader remote) nil
         (remote-window-last-pixels remote) nil (remote-window-last-size remote) nil)
   (bt:with-lock-held (*remote-lock*) (setf *remote-windows* (remove remote *remote-windows*)))
   (when (eq root *window*) (setf *window* nil))
   (when (and root (remote-window-dispose-on-close-p remote))
     (handler-case (dispose root) (error (e) (unless (remote-window-error remote) (setf (remote-window-error remote) e)))))) remote)
(defun shutdown-native-windows ()
 (dolist (remote (bt:with-lock-held (*remote-lock*) (copy-list *remote-windows*)))
   (ignore-errors (close-window remote))
   (finalize-remote-window remote)))
(defmethod dispose :after ((w window))
 (dolist (child (bt:with-lock-held (*remote-lock*) (copy-list *remote-windows*)))
   (when (eq w (remote-window-owner child)) (close-window child) (finalize-remote-window child)))
 (let ((remote (bt:with-lock-held (*remote-lock*)
                 (find w *remote-windows* :key #'remote-window-root :test #'eq))))
   (when remote (close-window remote) (finalize-remote-window remote))))
