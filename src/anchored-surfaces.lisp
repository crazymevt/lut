(in-package #:lut)
(defwidget anchored-surface (popover) "Nonmodal in-window content anchored to an owner caret or root rectangle."
 ((anchor-owner nil (or null widget) "Owner; assigned by SHOW-ANCHORED-SURFACE and released on dismissal.")
  (anchor-rectangle nil list "NIL follows an entry caret; otherwise root X Y WIDTH HEIGHT.")
  (dismiss-on-blur-p t boolean "Dismiss when focus moves away from the owner.")
  (anchor-root nil (or null widget) "Internal input scope saved when shown.")
  (anchor-position :below (member :above :below) "Internal resolved placement.")
  (requested-width nil (or null real) "Internal preferred popup width before viewport clamping.")
  (requested-height nil (or null real) "Internal preferred popup height before viewport clamping.")
  (surface-pressed-item nil (or null integer) "Internal suggestion pointer capture.")))
(defwidget suggestion-surface (anchored-surface) "Keyboard/pointer candidate list; acceptance emits the original application item."
 ((items nil list "Application candidates, retained until replaced or disposed.")
  (item-label-function #'princ-to-string (or symbol function) "Pure candidate-to-string function designator.")
  (value nil (or null (integer 0 *)) "Highlighted candidate index, or NIL.")
  (scroll-offset 0 (real 0 *) "Candidate viewport offset in pixels.")))
(defmethod nonmodal-overlay-p ((surface anchored-surface)) t)
(defmethod overlay-input-scope-p ((surface anchored-surface) scope)
 (let ((root (parent surface)) (owner (anchor-owner surface)))
   (and owner (typep root 'window) (eq scope (anchor-root surface))
        (member surface (slot-value root 'overlays)) (live-input-widget-p owner root))))
(defun dismiss-anchored-surface (surface &optional (reason :dismiss))
 "Remove SURFACE, release owner/scope references and emit :DISMISS with REASON once. Return SURFACE."
 (check-type surface anchored-surface) (check-type reason keyword)
 (let* ((root (root-of surface)) (shown (anchor-owner surface))
        (restore (and (typep root 'window) (focused-widget root)
                      (within-subtree-p (focused-widget root) surface))))
   (when (and (typep root 'window) (member surface (slot-value root 'overlays)))
     (remove-child root surface))
   (setf (slot-value surface 'anchor-owner) nil (slot-value surface 'anchor-root) nil
         (slot-value surface 'anchor-rectangle) nil (slot-value surface 'surface-pressed-item) nil)
   (when (and restore shown (focusable-p shown) (live-input-widget-p shown root)) (focus root shown))
   (when shown (emit surface :dismiss reason))) surface)
(defvar *positioning-anchor* nil)
(defun position-anchored-surface (surface)
 (let* ((owner (anchor-owner surface)) (root (and owner (root-of owner))))
   (when (and owner (typep root 'window))
     ;; Match the text painter before anchoring, so edits/resizes cannot leave
     ;; the popup one frame behind a caret that is about to be revealed.
     (when (and (typep owner 'entry) (not (anchor-rectangle surface))
                (not (eq owner (first (slot-value root 'text-selection-state)))))
       (reveal-text-cursor owner :vertical (/= (last-cursor owner) (cursor owner))))
     (let ((rect (or (anchor-rectangle surface)
                     (when (typep owner 'entry) (multiple-value-list (text-position-rectangle owner (cursor owner))))
                     (list (x owner) (y owner) (width owner) (height owner)))))
       (destructuring-bind (rx ry rw rh) rect
         (declare (ignore rw))
         (let* ((sw (min (or (requested-width surface) (width surface)) (width root)))
                (sh (min (or (requested-height surface) (height surface)) (height root)))
                (below (+ ry rh)) (above (- ry sh))
                (flip (and (> (+ below sh) (height root)) (>= ry (- (height root) below)))))
           (setf (slot-value surface 'anchor-position) (if flip :above :below))
           (let ((*positioning-anchor* t))
           (layout surface (max 0 (min rx (- (width root) sw)))
                           (max 0 (min (if flip above below) (- (height root) sh))) sw sh))))))) surface)
(defun show-anchored-surface (owner surface &key rectangle)
 "Show nonmodal SURFACE at OWNER's caret or RECTANGLE (root X Y W H), preserving owner focus. Return SURFACE."
 (check-type owner widget) (check-type surface anchored-surface) (ensure-live owner) (ensure-live surface)
 (let ((root (root-of owner)))
   (unless (and (typep root 'window) (live-input-widget-p owner root)) (error "Anchor owner must belong to the active input scope."))
   (when rectangle
     (unless (and (= (length rectangle) 4) (every #'realp rectangle) (notany #'minusp (cddr rectangle)))
       (error "Anchor rectangle requires root X Y and nonnegative W H.")))
   (when (within-subtree-p owner surface) (error "A surface cannot anchor to itself or its descendants."))
   (when (and (parent surface) (not (anchor-owner surface))) (error "Surface already has another parent."))
   (when (parent surface) (dismiss-anchored-surface surface :reanchor))
   (when (parent surface) (error "Surface already has another parent."))
   (ensure-live surface) (ensure-live owner)
   (unless (live-input-widget-p owner root) (error "Anchor owner left the active input scope."))
   (setf (slot-value surface 'requested-width) (or (requested-width surface) (width surface))
         (slot-value surface 'requested-height) (or (requested-height surface) (height surface)))
   (setf (slot-value surface 'anchor-owner) owner (slot-value surface 'anchor-root) (input-root root)
         (slot-value surface 'anchor-rectangle) (copy-list rectangle)
         (slot-value surface 'parent) root)
   (push surface (slot-value root 'overlays))
   (when (focusable-p owner) (focus root owner))
   (when (typep surface 'suggestion-surface)
     (setf (scroll-offset surface) 0) (reveal-suggestion surface))
   (position-anchored-surface surface)) surface)
(defun update-anchored-surfaces (root)
 (dolist (surface (copy-list (slot-value root 'overlays)))
   (when (typep surface 'anchored-surface)
     (let ((owner (anchor-owner surface)))
       (if (and owner (not (modal-blocker root)) (live-input-widget-p owner root) (eq (anchor-root surface) (input-root root))
                (or (not (dismiss-on-blur-p surface)) (not (focusable-p owner)) (eq owner (focused-widget root))
                    (and (focused-widget root) (within-subtree-p (focused-widget root) surface))))
           (position-anchored-surface surface) (dismiss-anchored-surface surface :owner-unavailable))))) root)
(defun reveal-suggestion (surface)
 (let* ((count (length (items surface))) (index (value surface)) (pad (style-value surface :padding))
        (available (max 1 (- (height surface) (* 2 pad)))))
   (unless (and index (< index count)) (setf (slot-value surface 'value) (when (plusp count) 0) index (value surface)))
   (if index
       (let ((top (* index (row-height surface))))
         (setf (scroll-offset surface) (max 0 (min top (max (scroll-offset surface) (- (+ top (row-height surface)) available))))))
       (setf (scroll-offset surface) 0))))
(defun accept-suggestion (surface &optional (index (value surface)))
 "Dismiss a shown SURFACE before emitting :ACCEPT with the original candidate at INDEX. Return accepted-p."
 (check-type surface suggestion-surface)
 (when (and (anchor-owner surface) (integerp index) (<= 0 index) (< index (length (items surface))))
   (let ((item (nth index (items surface))))
     (dismiss-anchored-surface surface :accept) (emit surface :accept item)) t))
(defun suggestion-at-point (surface px py)
 (let* ((pad (style-value surface :padding)) (local (- py (y surface) pad))
        (index (floor (+ local (scroll-offset surface)) (row-height surface))))
   (when (and (<= (+ (x surface) pad) px) (< px (- (+ (x surface) (width surface)) pad))
              (<= 0 local) (< local (- (height surface) (* 2 pad))) (<= 0 index) (< index (length (items surface)))) index)))
(defun dispatch-anchored-surfaces (root event)
 (update-anchored-surfaces root)
 (let* ((surfaces (remove-if-not (lambda (s) (typep s 'anchored-surface)) (slot-value root 'overlays)))
        (surface (first surfaces)) (kind (event-kind event)))
   (when surface
     (when (and (eq kind :key) (eq (event-key event) :escape))
       (cancel-text-selection root)
       (dismiss-anchored-surface surface :escape) (return-from dispatch-anchored-surfaces t))
     (when (and (typep surface 'suggestion-surface) (eq kind :key)
                (not (or (event-shift-p event) (event-control-p event) (event-alt-p event) (event-super-p event)))
                (let ((focused (focused-widget root)))
                  (and focused (or (eq focused (anchor-owner surface)) (within-subtree-p focused surface))))
                (member (event-key event) '(:up :down :home :end :enter)))
       (let ((count (length (items surface))))
         (case (event-key event)
           (:enter (when (accept-suggestion surface)
                     (cancel-text-selection root) (return-from dispatch-anchored-surfaces t)))
           (otherwise
            (when (plusp count)
              (cancel-text-selection root)
              (setf (value surface) (case (event-key event)
                (:home 0) (:end (1- count))
                (:up (max 0 (1- (or (value surface) 0))))
                (:down (min (1- count) (1+ (or (value surface) -1))))))
              (reveal-suggestion surface) (return-from dispatch-anchored-surfaces t))))))
     (when (and (eq kind :down) (not (contains-point-p surface (event-x event) (event-y event))))
       (dolist (s surfaces) (dismiss-anchored-surface s :outside)))
     (when (and (typep surface 'suggestion-surface) (eq kind :up)
                (not (contains-point-p surface (event-x event) (event-y event))))
       (setf (slot-value surface 'surface-pressed-item) nil))
     (when (and (typep surface 'suggestion-surface) (contains-point-p surface (event-x event) (event-y event))
                (member kind '(:down :move :up :wheel)))
       (when (eq kind :down) (cancel-text-selection root))
       (let ((index (suggestion-at-point surface (event-x event) (event-y event))))
         (case kind
           (:wheel (setf (scroll-offset surface) (max 0 (min
             (max 0 (- (* (length (items surface)) (row-height surface)) (- (height surface) (* 2 (style-value surface :padding)))))
             (- (scroll-offset surface) (* (row-height surface) (event-delta event)))))))
           (:down (setf (slot-value surface 'surface-pressed-item) index)
                  (when index (setf (value surface) index)))
           (:move (when index (setf (value surface) index)))
           (:up (when (and index (eql index (surface-pressed-item surface))) (accept-suggestion surface index))
                (setf (slot-value surface 'surface-pressed-item) nil)))) t))))
(defmethod (setf width) :after (width (surface anchored-surface))
 (unless *positioning-anchor* (setf (slot-value surface 'requested-width) width)))
(defmethod (setf height) :after (height (surface anchored-surface))
 (unless *positioning-anchor* (setf (slot-value surface 'requested-height) height)))
(defmethod (setf items) :around (items (surface suggestion-surface)) (call-next-method (copy-list items) surface))
(defmethod initialize-instance :after ((surface suggestion-surface) &key)
 (setf (slot-value surface 'items) (copy-list (items surface))) (reveal-suggestion surface))
(defmethod (setf items) :after (items (surface suggestion-surface))
 (declare (ignore items)) (reveal-suggestion surface))
(defmethod (setf value) :around (value (surface suggestion-surface))
 (let ((previous (value surface)))
   (prog1 (call-next-method)
     (unless (eql previous value) (reveal-suggestion surface)))))
(defmethod validate-slot :before ((surface suggestion-surface) slot value)
 (when (and (eq slot 'value) value (>= value (length (items surface)))) (error "Invalid suggestion index.")))
(defmethod prepare-modal-presentation ((root window))
 (dolist (surface (copy-list (slot-value root 'overlays)))
   (when (typep surface 'anchored-surface) (dismiss-anchored-surface surface :modal))))
(defmethod release-presentation-overlays ((root window) subtree)
 (dolist (surface (copy-list (slot-value root 'overlays)))
   (when (and (typep surface 'anchored-surface) (anchor-owner surface) (within-subtree-p (anchor-owner surface) subtree))
     (if (disposed-p subtree) (dispose surface) (dismiss-anchored-surface surface :owner-detached)))))
(defmethod dispose :before ((surface anchored-surface)) (dismiss-anchored-surface surface :dispose))
(defmethod dispose :around ((surface anchored-surface))
 (unwind-protect (call-next-method)
   (setf (slot-value surface 'anchor-owner) nil (slot-value surface 'anchor-root) nil
         (slot-value surface 'anchor-rectangle) nil (slot-value surface 'surface-pressed-item) nil)
   (when (typep surface 'suggestion-surface)
     (setf (slot-value surface 'items) nil (slot-value surface 'value) nil
           (slot-value surface 'item-label-function) #'princ-to-string))))
