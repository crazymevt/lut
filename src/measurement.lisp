(in-package #:lut)

(defgeneric measure (widget axis &optional for-size)
 (:documentation "Return minimum and natural logical size on AXIS (:HORIZONTAL/:VERTICAL), without changing geometry. FOR-SIZE optionally constrains the other axis; built-ins support height-for-width, not width-for-height."))
(defmethod validate-slot :after ((w widget) slot value)
 (when (member slot '(min-width max-width min-height max-height))
   (let* ((horizontal (member slot '(min-width max-width)))
          (low-slot (if horizontal 'min-width 'min-height))
          (high-slot (if horizontal 'max-width 'max-height)))
     (when (and (slot-boundp w low-slot) (slot-boundp w high-slot))
       (let ((low (if (eq slot low-slot) value (slot-value w low-slot)))
             (high (if (eq slot high-slot) value (slot-value w high-slot))))
         (when (and high (realp low) (realp high) (> low high))
           (error "Measured minimum must not exceed maximum.")))))))
(defun measured-limit (w axis)
 (if (eq axis :horizontal) (max-width w) (max-height w)))
(defun measured-expand-p (w axis)
 (if (eq axis :horizontal) (hexpand w) (vexpand w)))
(defun bounded-size (size minimum maximum)
 (max minimum (if maximum (min size maximum) size)))
(defvar *measurement-cache* nil
 "Dynamically scoped memo table for one outer layout or standalone measurement query. Never retained by widgets.")
(defmethod layout :around ((w widget) x y width height)
 (let ((*measurement-cache* (or *measurement-cache* (make-hash-table :test #'equal))))
   (call-next-method)))
(defmethod measure :around ((w widget) axis &optional for-size)
 (ensure-live w)
 (unless (member axis '(:horizontal :vertical)) (error "Unknown measurement axis ~s." axis))
 (check-type for-size (or null (real 0 *)))
 (unless (visible-p w) (return-from measure (values 0 0)))
 (let* ((*measurement-cache* (or *measurement-cache* (make-hash-table :test #'equal)))
        (horizontal (eq axis :horizontal))
        (other-minimum (if horizontal (min-height w) (min-width w)))
        (other-maximum (if horizontal (max-height w) (max-width w)))
        (offered (when for-size (bounded-size for-size other-minimum other-maximum)))
        (key (list w axis offered)))
   (multiple-value-bind (cached found) (gethash key *measurement-cache*)
     (when found (return-from measure (values (car cached) (cdr cached)))))
   (multiple-value-bind (minimum natural) (call-next-method w axis offered)
     (unless (and (typep minimum '(real 0 *)) (typep natural '(real 0 *)) (<= minimum natural))
       (error "MEASURE methods must return 0 <= minimum <= natural."))
     (let* ((low (if horizontal (min-width w) (min-height w)))
            (high (measured-limit w axis))
            (request (if horizontal (width-request w) (height-request w)))
            ;; An explicit maximum permits clipping below intrinsic content minima.
            (minimum (if high (min high (max low minimum)) (max low minimum)))
            (natural (bounded-size (or request natural) minimum high)))
       ;; Only successful, validated results enter the memo table.
       (setf (gethash key *measurement-cache*) (cons minimum natural))
       (values minimum natural)))))
(defmethod measure ((w widget) axis &optional for-size)
 (declare (ignore for-size))
 (let ((hint (if (eq axis :horizontal) (layout-width-hint w) (layout-height-hint w))))
   (values 0 hint)))
(defun wrapped-label-lines (w &optional (offered-width (width w)))
 "Return label lines wrapped to the padded width; preserve explicit newlines."
 (let* ((pad (style-value w :padding)) (available (max 1 (- offered-width (* 2 pad))))
        (string (display-text w)) (result nil))
   (dolist (bounds (text-lines string))
     (let ((line ""))
       (dolist (word (uiop:split-string (subseq string (first bounds) (second bounds))
                                       :separator '(#\Space #\Tab)))
         (let ((candidate (if (zerop (length line)) word (concatenate 'string line " " word))))
           (when (and (plusp (length line)) (> (text-width w candidate) available))
             (push line result) (setf candidate word))
           (setf line candidate)))
       (push line result)))
   (nreverse result)))
(defun label-line-widths (w)
 (let ((string (display-text w)))
   (loop for (start end) in (text-lines string) collect (text-width w (subseq string start end)))))
(defmethod measure ((w label) axis &optional for-size)
 (let* ((pad (* 2 (style-value w :padding))) (widths (label-line-widths w))
        (natural (+ pad (reduce #'max widths :initial-value 0)))
        (wrap (style-value w :wrap-text)))
   (if (eq axis :horizontal)
       (values (if wrap
                   (+ pad (loop for word in (uiop:split-string (display-text w) :separator '(#\Space #\Tab #\Newline))
                                maximize (text-width w word) into size finally (return (or size 0))))
                   natural) natural)
       (let* ((lines (if wrap (length (wrapped-label-lines w (or for-size natural))) (length widths)))
              (height (+ pad (* (max 0 (1- lines)) (line-height w))
                        (max (line-height w) (style-value w :font-size)))))
         (values height height)))))
(defmethod measure ((w button) axis &optional for-size)
 (declare (ignore for-size))
 ;; Buttons paint captions, not wrapped-label lines, even with inherited :WRAP-TEXT.
 (let* ((pad (* 2 (style-value w :padding))) (widths (label-line-widths w))
        (size (if (eq axis :horizontal) (+ pad (reduce #'max widths :initial-value 0))
                  (+ pad (style-value w :font-size)
                     (* (max 0 (1- (length widths))) (line-height w)) (style-value w :button-depth)))))
   (values size size)))
(defmethod measure ((w check-button) axis &optional for-size)
 (declare (ignorable for-size))
 (multiple-value-bind (minimum natural) (call-next-method)
   (let ((extra (if (eq axis :horizontal) (+ (style-value w :padding)
                   (cond ((typep w 'switch) 44) ((typep w 'radio-button) 20)
                         ((typep w 'toggle-button) 0) (t (style-value w :font-size)))) 0)))
     (when (and (typep w 'toggle-button) (not (typep w 'switch))) (setf extra 0))
     (values (+ minimum extra) (+ natural extra)))))
(defmethod measure ((w entry) axis &optional for-size)
 (declare (ignore for-size))
 ;; Editors/documents keep explicit requests until visual-line reflow is available.
 (let ((hint (if (eq axis :horizontal) (layout-width-hint w) (layout-height-hint w))))
   (values 0 hint)))

(defwidget measured-box (widget) "Opt-in linear layout using minimum/natural measurement and expansion constraints. Legacy BOX behavior stays explicit-size."
 ((orientation :vertical (member :horizontal :vertical) "Main allocation axis.")
  (spacing 8 (real 0 *) "Gap between visible children.")))
(defwidget panel (measured-box) "Measured container with a retained background and border."
 ())
(defwidget flow-box (widget) "Opt-in horizontal measured controls wrapping into rows; measures height for available width."
 ((column-spacing 8 (real 0 *) "Horizontal gap within each row.")
  (row-spacing 8 (real 0 *) "Vertical gap between rows.")))
(defun sum-with-gaps (sizes gap)
 (+ (reduce #'+ sizes :initial-value 0) (* (max 0 (1- (length sizes))) gap)))
(defun measured-cross-size (child axis available)
 (multiple-value-bind (minimum natural) (measure child axis)
   (bounded-size (if (measured-expand-p child axis) available (min available natural))
                 minimum (measured-limit child axis))))
(defun allocate-measured-sizes (children axis available &optional for-sizes)
 ;; Shrink toward minima proportionally, then distribute surplus among expanders.
 ;; Below total minimum, retain minima and allow ancestor clipping/scroll policy.
 (let* ((pairs (loop for child in children for i from 0 collect
                 (multiple-value-list (measure child axis (nth i for-sizes)))))
        (minimum (reduce #'+ pairs :key #'first :initial-value 0))
        (natural (reduce #'+ pairs :key #'second :initial-value 0))
        (sizes (mapcar #'second pairs)))
   (cond ((< available natural)
          (setf sizes (if (<= natural minimum) (mapcar #'first pairs)
                (loop for (low high) in pairs collect
                  (+ low (* (- high low) (max 0 (/ (- available minimum) (- natural minimum)))))))))
         ((> available natural)
          (let ((remaining (- available natural))
                (indices (loop for child in children for i from 0
                               when (measured-expand-p child axis) collect i)))
            (loop while (and indices (plusp remaining)) do
              (let ((share (/ remaining (length indices))) (next nil))
                (dolist (i indices)
                  (let* ((limit (measured-limit (nth i children) axis))
                         (growth (if limit (max 0 (min share (- limit (nth i sizes)))) share)))
                    (incf (nth i sizes) growth) (decf remaining growth)
                    (when (or (null limit) (< (nth i sizes) limit)) (push i next))))
                (when (= (length next) (length indices)) (setf remaining 0))
                (setf indices (nreverse next))))))) sizes))
(defun measured-box-widths (w width)
 (let ((children (active-children w)) (inner (max 0 (- width (* 2 (style-value w :padding))))))
   (if (eq (orientation w) :horizontal)
       (allocate-measured-sizes children :horizontal (max 0 (- inner (* (max 0 (1- (length children))) (spacing w)))))
       (mapcar (lambda (child) (measured-cross-size child :horizontal inner)) children))))
(defmethod measure ((w measured-box) axis &optional for-size)
 (let* ((children (active-children w)) (pad (* 2 (style-value w :padding)))
        (horizontal (eq (orientation w) :horizontal))
        (widths (when (eq axis :vertical)
                  (measured-box-widths w (or for-size (nth-value 1 (measure w :horizontal))))))
        (pairs (loop for child in children for i from 0 collect
                 (multiple-value-list (measure child axis (when widths (nth i widths)))))))
   (if (eq horizontal (eq axis :horizontal))
       (values (+ pad (sum-with-gaps (mapcar #'first pairs) (spacing w)))
               (+ pad (sum-with-gaps (mapcar #'second pairs) (spacing w))))
       (values (+ pad (reduce #'max pairs :key #'first :initial-value 0))
               (+ pad (reduce #'max pairs :key #'second :initial-value 0))))))
(defmethod layout :after ((w measured-box) x y width height)
 (let* ((children (active-children w)) (pad (style-value w :padding))
        (horizontal (eq (orientation w) :horizontal))
        (widths (measured-box-widths w width))
        (inner-height (max 0 (- height (* 2 pad))))
        (heights (if horizontal
                     (loop for child in children for cw in widths collect
                       (multiple-value-bind (minimum natural) (measure child :vertical cw)
                         (bounded-size (if (vexpand child) inner-height (min natural inner-height))
                                       minimum (max-height child))))
                     (allocate-measured-sizes children :vertical
                       (max 0 (- inner-height (* (max 0 (1- (length children))) (spacing w)))) widths)))
        (position (if horizontal (+ x pad) (+ y pad))))
   (loop for child in children for cw in widths for ch in heights do
     (layout child (if horizontal position (+ x pad)) (if horizontal (+ y pad) position) cw ch)
     (incf position (+ (if horizontal cw ch) (spacing w))))))

(defun flow-rows (w offered-width)
 ;; Keep rows as local child lists; no retained widget/measurement cache.
 (let* ((inner (max 0 (- offered-width (* 2 (style-value w :padding)))))
        (rows nil) (row nil) (used 0))
   (dolist (child (active-children w))
     (multiple-value-bind (minimum natural) (measure child :horizontal)
       (let ((size (max minimum (min inner natural))))
         (when (and row (> (+ used (column-spacing w) size) inner))
           (push (nreverse row) rows) (setf row nil used 0))
         (when row (incf used (column-spacing w)))
         (push child row) (incf used size))))
   (when row (push (nreverse row) rows)) (nreverse rows)))
(defun flow-row-sizes (w row offered-width)
 (let* ((available (max 0 (- offered-width (* 2 (style-value w :padding))
                              (* (max 0 (1- (length row))) (column-spacing w)))))
        (widths (allocate-measured-sizes row :horizontal available))
        (heights (loop for child in row for cw in widths collect (multiple-value-list (measure child :vertical cw)))))
   (values widths heights)))
(defmethod measure ((w flow-box) axis &optional for-size)
 (let ((children (active-children w)) (pad (* 2 (style-value w :padding))))
   (if (eq axis :horizontal)
       (let ((pairs (mapcar (lambda (child) (multiple-value-list (measure child :horizontal))) children)))
         (values (+ pad (reduce #'max pairs :key #'first :initial-value 0))
                 (+ pad (sum-with-gaps (mapcar #'second pairs) (column-spacing w)))))
       (let* ((offered (or for-size (nth-value 1 (measure w :horizontal))))
              (rows (flow-rows w offered))
              (pairs (loop for row in rows collect
                       (multiple-value-bind (widths heights) (flow-row-sizes w row offered)
                         (declare (ignore widths))
                         (list (reduce #'max heights :key #'first :initial-value 0)
                               (reduce #'max heights :key #'second :initial-value 0))))))
         (values (+ pad (sum-with-gaps (mapcar #'first pairs) (row-spacing w)))
                 (+ pad (sum-with-gaps (mapcar #'second pairs) (row-spacing w))))))))
(defmethod layout :after ((w flow-box) x y width height)
 (declare (ignore height))
 (let ((pad (style-value w :padding)) (top (+ y (style-value w :padding))))
   (dolist (row (flow-rows w width))
     (multiple-value-bind (widths heights) (flow-row-sizes w row width)
       (let ((row-height (reduce #'max heights :key #'second :initial-value 0)) (left (+ x pad)))
         (loop for child in row for cw in widths for pair in heights do
           (layout child left top cw
             (if (vexpand child) (bounded-size row-height (first pair) (max-height child)) (second pair)))
           (incf left (+ cw (column-spacing w))))
         (incf top (+ row-height (row-spacing w))))))))
