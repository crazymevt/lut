(in-package #:lut)

(defun scrollbar-view-p (view)
 ;; Closed dropdowns are controls, not row viewports. Specialized tree/table/
 ;; model views also have their own row/header geometry.
 (and (not (typep (parent view) 'scroll-container))
      (or (typep view 'scroll-view)
     (and (typep view 'list-view) (not (typep view '(or dropdown tree-view table-view model-list-view)))))))

(defgeneric scroll-axes (view))
(defmethod scroll-axes ((view widget)) nil)
(defmethod scroll-axes ((view scroll-view)) (when (eq (orientation view) :vertical) '(:vertical)))
(defmethod scroll-axes ((view list-view)) '(:vertical))
(defmethod scroll-axes ((view text-view)) '(:horizontal :vertical))
(defgeneric scroll-geometry (view &optional axis)
 (:documentation "Return content extent, viewport page size and current offset in logical pixels on AXIS (default :VERTICAL), after layout."))
(defmethod scroll-geometry :around ((view widget) &optional (axis :vertical))
 (ensure-live view)
 (unless (member axis (scroll-axes view)) (error "Unsupported scroll axis ~s for ~s." axis view))
 (call-next-method))
(defmethod scroll-geometry ((view scroll-view) &optional (axis :vertical))
 (declare (ignore axis))
 (values (scroll-content-height view) (height view) (scroll-offset view)))
(defmethod scroll-geometry ((view list-view) &optional (axis :vertical))
 (declare (ignore axis))
 (values (* (length (items view)) (row-height view)) (height view) (scroll-offset view)))
(defmethod scroll-geometry ((view model-list-view) &optional (axis :vertical))
 (declare (ignore axis))
 (let ((model (view-model view)))
   (values (* (if (and model (not (disposed-p model))) (model-count model) 0) (row-height view))
           (model-viewport-height view) (scroll-offset view))))
(defmethod scroll-geometry ((view tree-view) &optional (axis :vertical))
 (declare (ignore axis))
 (values (* (length (tree-rows view)) (row-height view)) (height view) (scroll-offset view)))
(defmethod scroll-geometry ((view table-view) &optional (axis :vertical))
 (declare (ignore axis))
 (values (* (length (rows view)) (row-height view)) (max 0 (- (height view) (row-height view))) (scroll-offset view)))
(defmethod scroll-geometry ((view text-view) &optional (axis :vertical))
 (if (eq axis :vertical)
     (values (text-content-height view) (max 0 (- (height view) (* 2 (style-value view :padding)))) (vertical-offset view))
     (let* ((root (display-index view))
            (key (list (text-metric-key view) (style-value view :caret-width)))
            (cache (slot-value view 'horizontal-extent-cache)))
       (unless (and cache (eq root (first cache)) (equal key (second cache)))
         (let ((extent 0))
           (loop for line from 0 to (node-lines root)
                 for metrics = (view-line-metrics view root line)
                 for column = (- (line-metrics-end metrics) (line-metrics-start metrics)) do
             (setf extent (max extent (metric-caret-width view (extend-line-metrics view metrics :column column) column))))
           (setf cache (list root key (+ extent (style-value view :caret-width)))
                 (slot-value view 'horizontal-extent-cache) cache)))
       (values (third cache) (max 0 (- (width view) (text-left-padding view) (style-value view :padding))) (text-offset view)))))
(defmethod scroll-geometry ((view wrapped-text-view) &optional (axis :vertical))
 (if (eq axis :vertical) (call-next-method)
     (let ((page (max 0 (- (width view) (text-left-padding view) (style-value view :padding)))))
       (values page page 0))))

(defgeneric scroll-viewport (view))
(defmethod scroll-viewport ((view widget)) (values (x view) (y view) (width view) (height view)))
(defmethod scroll-viewport ((view text-view))
 (let ((pad (style-value view :padding)))
   (values (+ (x view) (text-left-padding view)) (+ (y view) pad)
           (max 0 (- (width view) (text-left-padding view) pad)) (max 0 (- (height view) (* 2 pad))))))
(defmethod scroll-viewport ((view model-list-view))
 (values (x view) (+ (y view) (model-header-height view)) (width view) (model-viewport-height view)))
(defmethod scroll-viewport ((view table-view))
 (values (x view) (+ (y view) (row-height view)) (width view) (max 0 (- (height view) (row-height view)))))
(defvar *setting-scroll-position* nil)
(defgeneric scroll-to (view offset &key axis)
 (:documentation "Clamp OFFSET on AXIS (default :VERTICAL) to the content range. Relayout scroll-container children immediately. Return VIEW."))
(defmethod scroll-to :around ((view widget) offset &key (axis :vertical))
 (check-type offset real)
 (multiple-value-bind (extent page) (scroll-geometry view axis)
   (let ((*setting-scroll-position* t))
     (call-next-method view (max 0 (min offset (max 0 (- extent page)))) :axis axis))))
(defmethod scroll-to ((view scroll-view) offset &key axis)
 (declare (ignore axis))
 (unless (= offset (scroll-offset view))
   (setf (scroll-offset view) offset)
   (layout view (x view) (y view) (width view) (height view))) view)
(defmethod scroll-to ((view list-view) offset &key axis)
 (declare (ignore axis))
 (unless (= (scroll-offset view) offset)
   (setf (scroll-offset view) offset)
   (layout view (x view) (y view) (width view) (height view))) view)
(defmethod scroll-to ((view text-view) offset &key (axis :vertical))
 (if (eq axis :vertical) (setf (vertical-offset view) offset) (setf (text-offset view) offset))
 (setf (slot-value view 'last-cursor) (cursor view)) view)
(defun reveal-axis-offset (offset page start size)
 (cond ((or (< start offset) (>= size page)) start)
       ((> (+ start size) (+ offset page)) (- (+ start size) page)) (t offset)))
(defgeneric reveal-axis-state (view axis))
(defmethod reveal-axis-state ((view widget) axis)
 (multiple-value-bind (extent page offset) (scroll-geometry view axis)
   (declare (ignore extent)) (values page offset)))
(defmethod reveal-axis-state ((view text-view) axis)
 (if (eq axis :horizontal)
     ;; Revealing a known rectangle needs the page and offset, not the widths
     ;; of unrelated logical lines. Exact extent queries remain explicit.
     (values (nth-value 2 (scroll-viewport view)) (text-offset view))
     (call-next-method)))
(defgeneric reveal-axis-rectangle (view axis start size))
(defmethod reveal-axis-rectangle ((view widget) axis start size)
 (multiple-value-bind (page offset) (reveal-axis-state view axis)
   (scroll-to view (reveal-axis-offset offset page start size) :axis axis)))
(defmethod reveal-axis-rectangle ((view text-view) axis start size)
 (if (and (eq axis :horizontal) (not (typep view 'wrapped-text-view)))
     (multiple-value-bind (page offset) (reveal-axis-state view axis)
       ;; The target supplies its own horizontal bound. Do not call SCROLL-TO:
       ;; its exact document-wide clamp would measure every logical line.
       (setf (text-offset view) (max 0 (reveal-axis-offset offset page start size))
             (slot-value view 'last-cursor) (cursor view)) view)
     (call-next-method)))
(defun reveal-rectangle (view x y width height)
 "Reveal a content-coordinate rectangle in VIEW; oversized rectangles align their leading edge. Return VIEW."
 (check-type x real) (check-type y real)
 (check-type width (real 0 *)) (check-type height (real 0 *))
 ;; Validate the view even when it has a zero-size rectangle/page.
 (scroll-geometry view)
 (dolist (axis (scroll-axes view))
   (reveal-axis-rectangle view axis (if (eq axis :vertical) y x)
                                  (if (eq axis :vertical) height width))) view)

(defun reveal-widget (widget &key (x 0) (y 0) (width (width widget)) (height (height widget)))
 "Reveal WIDGET's allocation-local rectangle through scrollable ancestors, inside out. Return WIDGET."
 (check-type widget widget) (ensure-live widget)
 (check-type x real) (check-type y real) (check-type width (real 0 *)) (check-type height (real 0 *))
 (loop for ancestor = (parent widget) then (parent ancestor) while ancestor do
   (ensure-live ancestor)
   (when (scroll-axes ancestor)
     (multiple-value-bind (vx vy) (scroll-viewport ancestor)
       (dolist (axis (scroll-axes ancestor))
         (multiple-value-bind (page offset) (reveal-axis-state ancestor axis)
           (declare (ignore page))
           ;; Child coordinates change when an inner container is relaid out.
           (let ((start (+ offset (if (eq axis :vertical) (- (+ (y widget) y) vy) (- (+ (x widget) x) vx)))))
             (reveal-axis-rectangle ancestor axis start (if (eq axis :vertical) height width)))))))) widget)

(defgeneric map-range-scroll-rectangles (view start end function))
(defmethod map-range-scroll-rectangles ((view text-view) start end function)
 (let* ((root (display-index view)) (*text-caret-affinity* nil)
        (first (index-position-line root start)) (last (index-position-line root (if (= start end) end (1- end)))))
   (loop for line from first to last do
     (multiple-value-bind (lo hi) (index-line-range root line)
       (let ((a (max lo start)) (b (min hi end)))
         (multiple-value-bind (cx cy cw ch) (text-position-rectangle view a)
           (funcall function cx cy (max cw (text-range-width view a b)) ch)))))))
(defmethod map-range-scroll-rectangles ((view wrapped-text-view) start end function)
 (let ((*text-caret-affinity* nil))
   (loop for row across (wrapped-rows view)
         for lo = (visual-row-start row) for hi = (visual-row-end row)
         when (if (= start end) (eq row (wrapped-position-row (wrapped-rows view) start))
                  (and (< lo end) (>= hi start) (or (> hi start) (= hi lo)
                    (and (= hi start) (< hi (text-length view))
                         (char= (index-character (display-index view) hi) #\Newline))))) do
           (let* ((a (max lo start)) (b (min hi end)) (adv (visual-row-advances row)))
             (funcall function
               (+ (x view) (text-left-padding view) (aref adv (- a lo)))
               (- (+ (y view) (style-value view :padding) (visual-row-top row)) (vertical-offset view))
               (max (style-value view :caret-width) (- (aref adv (- b lo)) (aref adv (- a lo))))
               (visual-row-height row))))))
(defun reveal-text-range (view start end)
 "Reveal half-open display-text range START/END in VIEW and its ancestors, preserving cursor/selection. Return VIEW."
 (check-type view text-view) (ensure-live view)
 (unless (and (integerp start) (integerp end) (<= 0 start end (node-size (display-index view))))
   (error "Invalid display text range."))
 (let ((left nil) (top nil) (right nil) (bottom nil))
   (map-range-scroll-rectangles view start end
     (lambda (x y w h)
       (setf left (if left (min left x) x) top (if top (min top y) y)
             right (if right (max right (+ x w)) (+ x w)) bottom (if bottom (max bottom (+ y h)) (+ y h)))))
   (multiple-value-bind (vx vy vw vh) (scroll-viewport view)
     (let ((cx (+ (- left vx) (text-offset view))) (cy (+ (- top vy) (vertical-offset view))))
       (reveal-rectangle view cx cy (- right left) (- bottom top))
       ;; Propagate only the portion visible in the text viewport. An ancestor
       ;; cannot reveal text clipped by the view's own allocation.
       (let* ((rx (max 0 (- cx (text-offset view)))) (ry (max 0 (- cy (vertical-offset view))))
              (rw (max 0 (min (- vw rx) (- right left)))) (rh (max 0 (min (- vh ry) (- bottom top)))))
         (reveal-widget view :x (+ (- vx (x view)) rx) :y (+ (- vy (y view)) ry) :width rw :height rh))))) view)

(defun follow-end-distance (view)
 "Return requested vertical end distance in pixels, or NIL when following is disabled."
 (check-type view widget) (ensure-live view) (scroll-follow-distance view))
(defun set-follow-end (view enabled &key (distance 0))
 "Enable/disable following at DISTANCE pixels from the vertical end. Apply immediately and after layout. Applications own suspension policy. Return VIEW."
 (check-type enabled boolean) (check-type distance (real 0 *))
 (scroll-geometry view)
 (setf (scroll-follow-distance view) (when enabled distance))
 (when enabled (apply-follow-end view)) view)
(defun apply-follow-end (view)
 (when (and (not *setting-scroll-position*) (scroll-follow-distance view))
   (multiple-value-bind (extent page) (scroll-geometry view)
     (scroll-to view (- extent page (scroll-follow-distance view))))))
(defmethod layout :around ((view scroll-view) x y width height)
 (declare (ignore x y width height)) (prog1 (call-next-method) (apply-follow-end view)))
(defmethod layout :around ((view text-view) x y width height)
 (declare (ignore x y width height)) (prog1 (call-next-method) (apply-follow-end view)))
(defmethod layout :around ((view list-view) x y width height)
 (declare (ignore x y width height))
 (prog1 (call-next-method)
   (when (scrollbar-view-p view)
     (setf (scroll-offset view) (min (scroll-offset view) (scrollbar-range view))))
   (apply-follow-end view)))

(defclass viewport-scrollbar (widget)
  ((view :initarg :view :reader scrollbar-target)
   (axis :initarg :axis :reader scrollbar-axis)
   (grab :initform 0 :accessor scrollbar-grab)))

(defun viewport-scrollbar-geometry (bar)
  (multiple-value-bind (extent page offset)
      (scroll-geometry (scrollbar-target bar) (scrollbar-axis bar))
    (let* ((length (if (eq (scrollbar-axis bar) :vertical) (height bar) (width bar)))
           (thumb (min length (max 24 (* length (/ page (max 1 extent))))))
           (range (max 0 (- extent page))) (travel (max 0 (- length thumb))))
      (values (* travel (/ (min range offset) (max 1 range))) thumb travel range))))

(defmethod handle-event ((bar viewport-scrollbar) event)
  (let* ((view (scrollbar-target bar)) (root (root-of bar))
         (vertical (eq (scrollbar-axis bar) :vertical))
         (position (- (if vertical (event-y event) (event-x event))
                      (if vertical (y bar) (x bar)))))
    (labels ((drag ()
               (multiple-value-bind (start thumb travel range) (viewport-scrollbar-geometry bar)
                 (declare (ignore start thumb))
                 (scroll-to view (* range (/ (- position (scrollbar-grab bar)) (max 1 travel)))
                                :axis (scrollbar-axis bar))
                 (emit view :scroll (scrollbar-axis bar)))))
      (case (event-kind event)
        (:down
         (multiple-value-bind (start thumb) (viewport-scrollbar-geometry bar)
           (setf (scrollbar-grab bar) (if (<= start position (+ start thumb)) (- position start) (/ thumb 2))))
         (setf (slot-value root 'pressed-widget) bar) (drag) t)
        (:move (when (eq (slot-value root 'pressed-widget) bar) (drag)) t)
        (:up t)
        (:wheel
         (multiple-value-bind (extent page offset) (scroll-geometry view (scrollbar-axis bar))
           (declare (ignore extent page))
           (scroll-to view (- offset (* (if (typep view 'text-view) (line-height view) (row-height view))
                                        (event-delta event))) :axis (scrollbar-axis bar))
           (emit view :scroll (scrollbar-axis bar))) t)))))


(defclass scroll-container (widget) ()
  (:documentation "Embed one scrollable child. Reserve horizontal/vertical bars only on overflow; the child owns its offsets."))

(defmethod layout :after ((container scroll-container) x y width height)
  (let ((view (first (children container))))
    (when view
      (unless (second (children container))
        (dolist (axis '(:vertical :horizontal))
          (add-child container (make-widget 'viewport-scrollbar :view view :axis axis :visible-p nil))))
      (let ((vertical (second (children container))) (horizontal (third (children container)))
            (v nil) (h nil) (size (style-value container :scrollbar-width)))
        (dotimes (pass 3)
          (layout view x y (max 0 (- width (if v size 0))) (max 0 (- height (if h size 0))))
          (setf v (and (member :vertical (scroll-axes view))
                       (multiple-value-bind (extent page) (scroll-geometry view :vertical) (> extent page)))
                h (and (member :horizontal (scroll-axes view))
                       (multiple-value-bind (extent page) (scroll-geometry view :horizontal) (> extent page)))))
        (dolist (axis (scroll-axes view))
          (multiple-value-bind (extent page offset) (scroll-geometry view axis)
            (let ((clamped (max 0 (min offset (max 0 (- extent page))))))
              (unless (= offset clamped)
                (scroll-to view clamped :axis axis)
                (emit view :scroll axis)))))
        (setf (visible-p vertical) (not (null v)) (visible-p horizontal) (not (null h)))
        (layout vertical (+ x (width view)) y size (height view))
        (layout horizontal x (+ y (height view)) (width view) size)))))
