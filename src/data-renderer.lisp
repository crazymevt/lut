;;;; Shared native table painter for LUT windows and embedded hosts.
(in-package #:lut)

(defun intersect-rectangles (a b)
 (let ((left (max (first a) (first b))) (top (max (second a) (second b))))
   (list left top (max 0 (- (min (+ (first a) (third a)) (+ (first b) (third b))) left))
                  (max 0 (- (min (+ (second a) (fourth a)) (+ (second b) (fourth b))) top)))))
(defun surface-color (w)
 (let ((state (widget-state w)))
   (loop for node = w then (parent node) while node do
     (multiple-value-bind (v found) (property (getf (state-style node) state) :surface)
       (when found (return-from surface-color v))))
   (dolist (root (style-roots w))
     (when (typep root 'window)
       (dolist (rule (reverse (style-rules root)))
         (when (and (typep w (getf rule :class 'widget)) (eq state (getf rule :state)))
           (multiple-value-bind (v found) (property (getf rule :style) :surface)
             (when found (return-from surface-color v))))))))
 (case (widget-state w) (:disabled (style-value w :disabled-color))
   (:pressed (style-value w (if (typep w 'entry) :surface :pressed-color))) (:hover (style-value w (if (typep w 'entry) :surface :hover-color)))
   (otherwise (style-value w :surface))))

(defun resolved-roundness (w &optional (width (width w)) (height (height w))
                                      (proportion (style-value w :border-radius)))
 "Convert the styled pixel cap to raylib's shorter-side proportion."
 (let ((side (min width height)))
   (if (plusp side)
       (min proportion (/ (* 2 (style-value w :max-border-radius)) side))
       0)))
(defun paint-surface (w &optional color)
 (rl:draw-rectangle-rounded (rl:rect (x w) (y w) (width w) (height w))
   (resolved-roundness w) 12 (or color (surface-color w)))
 (let ((border (style-value w :border-width)))
   (when (plusp border)
     (rl:draw-rectangle-rounded-lines-ex (rl:rect (x w) (y w) (width w) (height w))
       (resolved-roundness w) 12 border (style-value w :border-color)))))
(defun paint-rounded (w x y width height radius color)
 (when (and (plusp width) (plusp height))
   (rl:draw-rectangle-rounded (rl:rect x y width height) (resolved-roundness w width height radius) 12 color)))
(defun row-text-y (w py)
 (+ py (max 0 (/ (- (row-height w) (style-value w :font-size)) 2))))
(defun paint-row-selection (w py &optional (color (style-value w :accent)))
 (let ((inset (max 2 (style-value w :border-width))))
   (paint-rounded w (+ (x w) inset) (+ py 2)
     (max 0 (- (width w) (* 2 inset))) (max 0 (- (row-height w) 4))
     (style-value w :border-radius) color)))
(defun paint-list-surface (w)
 (paint-surface w (style-value w (if (eq (widget-state w) :disabled) :disabled-color :surface))))
(defun paint-model-row (view key index py)
 (cond ((and (view-selection view) (selection-contains-p (view-selection view) key)) (paint-row-selection view py))
       ((eql index (hovered-row view)) (paint-row-selection view py (style-value view :hover-color)))))
(defun model-row-color (view key)
 (style-value view (if (and (view-selection view) (selection-contains-p (view-selection view) key)) :on-accent :foreground)))
(defun paint-model-cell (view index key column-index left py cw clip draw-text)
 (let* ((presentation (cell-presentation view index column-index))
        (selected (and (view-selection view) (selection-contains-p (view-selection view) key)))
        (cell-clip (intersect-rectangles clip (list left py cw (row-height view)))))
   (with-ui-scissor ((first cell-clip) (second cell-clip) (third cell-clip) (fourth cell-clip))
     (when (and (not selected) (getf presentation :background))
       (rl:draw-rectangle left py cw (row-height view) (getf presentation :background)))
     (funcall draw-text view (getf presentation :text) (+ left (style-value view :padding)) (row-text-y view py)
       (if selected (model-row-color view key) (or (getf presentation :foreground) (model-row-color view key)))))))
(defun paint-model-table (view draw-text clip-bounds)
 (paint-list-surface view)
 (let* ((columns (table-columns view)) (cw (model-table-column-width view)) (rh (row-height view))
        (offset (table-horizontal-offset view))
        (start (floor offset (max 1 cw)))
        (end (min (length columns) (ceiling (+ offset (width view)) (max 1 cw))))
        (clip (intersect-rectangles clip-bounds (list (x view) (+ (y view) rh) (width view) (model-viewport-height view)))))
   (when (and (plusp (third clip)) (plusp (fourth clip)))
     (with-ui-scissor ((first clip) (second clip) (third clip) (fourth clip))
       (map-visible-model-rows view
         (lambda (index key item px py width height)
           (declare (ignore item width height))
           (paint-model-row view key index py)
           (loop for c from start below end do
             (paint-model-cell view index key c (+ px (* c cw) (- offset)) py cw clip draw-text)
             (begin-ui-scissor (first clip) (second clip) (third clip) (fourth clip)))))))
   (let ((header (intersect-rectangles clip-bounds (list (x view) (y view) (width view) rh))))
     (loop for c from start below end for column = (nth c columns)
           for left = (+ (x view) (* c cw) (- offset))
           for cell = (intersect-rectangles header (list left (y view) cw rh)) do
       (with-ui-scissor ((first cell) (second cell) (third cell) (fourth cell))
         (funcall draw-text view (data-column-title column) (+ left (style-value view :padding)) (row-text-y view (y view))))))))
(defun paint-viewport-scrollbar (bar)
  (rl:draw-rectangle (x bar) (y bar) (width bar) (height bar)
                     (style-value bar :background))
  (multiple-value-bind (start thumb) (viewport-scrollbar-geometry bar)
    (if (eq (scrollbar-axis bar) :vertical)
        (rl:draw-rectangle (+ (x bar) 2) (+ (y bar) start) (max 0 (- (width bar) 4)) thumb
                           (style-value bar :border-color))
        (rl:draw-rectangle (+ (x bar) start) (+ (y bar) 2) thumb (max 0 (- (height bar) 4))
                           (style-value bar :border-color)))))

(defun render-data-table (view font &key clip (scale *render-ui-scale*))
  "Render a MODEL-TABLE-VIEW in a host's existing transform using borrowed FONT.
No window, font ownership, event polling or transforms are installed. The host
owns FONT, layout and dispatch. Native main thread with an open context only.
CLIP is an optional logical rectangle; SCALE controls logical scissor conversion.
This is the same table painter used by LUT/RAYLIB. Restore outer clipping after
this call when embedding inside a host scissor."
  (ensure-live view)
  (let* ((*render-ui-scale* scale)
         (bounds (list (x view) (y view) (width view) (height view)))
         (clip (intersect-rectangles bounds (or clip bounds))))
    (when (and (plusp (third clip)) (plusp (fourth clip)))
      (with-ui-scissor ((first clip) (second clip) (third clip) (fourth clip))
        (paint-model-table view
          (lambda (widget string px py &optional color)
            (rl:draw-text-ex font string (rl:vec2 px py) (style-value widget :font-size)
                            (style-value widget :font-spacing) (or color (style-value widget :foreground))))
          clip)))))

(defun render-data-scroll-container (container font &key clip (scale *render-ui-scale*))
  "Render a SCROLL-CONTAINER holding one model table and its LUT scrollbars.
Uses the host's existing transform and borrowed FONT; see RENDER-DATA-TABLE.
Call LAYOUT and DISPATCH through the ordinary LUT APIs."
  (ensure-live container)
  (let* ((*render-ui-scale* scale)
         (bounds (list (x container) (y container) (width container) (height container)))
         (clip (intersect-rectangles bounds (or clip bounds))))
    (when (and (plusp (third clip)) (plusp (fourth clip)))
      (dolist (child (children container))
        (when (and (visible-p child) (not (disposed-p child)))
          (etypecase child
            (model-table-view (render-data-table child font :clip clip :scale scale))
            (viewport-scrollbar
             (with-ui-scissor ((first clip) (second clip) (third clip) (fourth clip))
               (paint-viewport-scrollbar child)))))))))
