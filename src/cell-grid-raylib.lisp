(in-package #:lut)
(defun draw-grid-glyph (font glyph px py cw ch factor color &optional (shift 0))
 ;; Crop atlas coordinates instead of changing GPU scissor state for each cell.
 ;; The widget's scissor still enforces the enclosing pane/scroll viewport.
 (destructuring-bind (source ox oy) glyph
   (let* ((gx (+ px shift (* ox factor))) (gy (+ py (* oy factor)))
          (gw (* (rl:rectangle-width source) factor)) (gh (* (rl:rectangle-height source) factor))
          (left (max px gx)) (top (max py gy))
          (right (min (+ px cw) (+ gx gw))) (bottom (min (+ py ch) (+ gy gh))))
     (when (and (> right left) (> bottom top))
       (rl:draw-texture-pro (rl:font-texture font)
         (rl:rect (+ (rl:rectangle-x source) (/ (- left gx) factor))
                  (+ (rl:rectangle-y source) (/ (- top gy) factor))
                  (/ (- right left) factor) (/ (- bottom top) factor))
         (rl:rect left top (- right left) (- bottom top)) (rl:vec2 0 0) 0 color)))))
(defmethod render ((grid cell-grid))
 (let* ((cw (grid-cell-width grid)) (ch (grid-cell-height grid))
        (foreground (style-value grid :foreground)) (accent (style-value grid :accent))
        (on-accent (style-value grid :on-accent))
        (characters (with-output-to-string (out)
                      (dotimes (r (grid-rows grid))
                        (dotimes (c (grid-columns grid))
                          (write-char (getf (aref (grid-data grid) r c) :character #\Space) out)))))
        (glyphs (widget-glyph-set grid characters)) (font (lookup-widget-font grid glyphs))
        (factor (/ (style-value grid :font-size) (rl:font-base-size font)))
        (records (make-hash-table :test #'eql)))
   (rl:draw-rectangle-rec (rl:rect (x grid) (y grid) (width grid) (height grid)) (style-value grid :surface))
   ;; Keep backgrounds and glyphs in separate passes so texture changes do not
   ;; force a GPU batch flush for every character.
   (dotimes (r (grid-rows grid))
     (dotimes (c (grid-columns grid))
       (let* ((cell (aref (grid-data grid) r c))
              (background (if (grid-cell-selected-p grid c r) accent (getf cell :background))))
         (when background
           (rl:draw-rectangle-rec (rl:rect (+ (x grid) (* c cw)) (+ (y grid) (* r ch)) cw ch) background)))))
   (dotimes (r (grid-rows grid))
     (dotimes (c (grid-columns grid))
       (let* ((cell (aref (grid-data grid) r c)) (character (getf cell :character #\Space))
              (px (+ (x grid) (* c cw))) (py (+ (y grid) (* r ch)))
              (color (if (grid-cell-selected-p grid c r) on-accent (or (getf cell :foreground) foreground))))
         (unless (char= character #\Space)
           (let ((record (or (gethash character records)
                             (let ((info (rl:get-glyph-info font (char-code character))))
                               (setf (gethash character records)
                                     (list (rl:get-glyph-atlas-rec font (char-code character))
                                           (rl:glyph-info-offset-x info) (rl:glyph-info-offset-y info)))))))
             (draw-grid-glyph font record px py cw ch factor color)
             (when (getf cell :bold) (draw-grid-glyph font record px py cw ch factor color 1)))))))
   (dotimes (r (grid-rows grid))
     (dotimes (c (grid-columns grid))
       (let ((cell (aref (grid-data grid) r c)))
         (when (getf cell :underline)
           (rl:draw-rectangle-rec
             (rl:rect (+ (x grid) (* c cw)) (+ (y grid) (* r ch) (max 0 (- ch 2))) cw (min ch 1))
             (if (grid-cell-selected-p grid c r) on-accent (or (getf cell :foreground) foreground)))))))))
