(in-package #:lut)
(defun validate-command-shortcut (shortcut)
 (unless (or (null shortcut) (keywordp shortcut)
             (and (listp shortcut) (evenp (length shortcut)) (keywordp (getf shortcut :key))
                  (getf shortcut :key)
                  (loop for (key value) on shortcut by #'cddr
                    always (and (member key '(:key :control :alt :super :shift))
                                (if (eq key :key) (keywordp value) (typep value 'boolean))))))
   (error "A command shortcut must be NIL, a normalized key, or a :KEY/modifier plist.")) shortcut)
(defwidget command (widget) "Nonvisual reusable action with a label, shortcut and context-sensitive availability."
 ((command-label "" string "Caption shared by bound buttons and menu buttons.")
  (command-action nil (or null function symbol) "Function designator taking (command context).")
  (command-predicate nil (or null function symbol) "Optional pure function (command context); true enables execution.")
  (command-shortcut nil (or null symbol list) "Normalized key keyword, or exact (:KEY key :CONTROL bool :ALT bool :SUPER bool :SHIFT bool) spec.")))
(defmethod validate-slot ((command command) slot value)
 (declare (ignore command))
 (when (eq slot 'command-shortcut) (validate-command-shortcut value)) value)
(defclass command-binding ()
 ((command :initarg :command) (window :initarg :window) (widget :initarg :widget)
  (context :initarg :context) (context-function :initarg :context-function)
  (old-text :initarg :old-text) (old-enabled :initarg :old-enabled)
  (connections :initform nil)
  (active-p :initform t :reader command-binding-active-p))
 (:documentation "Nonvisual binding handle. UNBIND-COMMAND or DISPOSE releases endpoint/context references."))
(defun make-command (id label action &key (enabled-p t) enabled-when shortcut)
 "Construct a nonvisual COMMAND. ACTION and optional ENABLED-WHEN take (command context)."
 (make-widget 'command :id id :command-label label :command-action action
              :enabled-p enabled-p :command-predicate enabled-when :command-shortcut shortcut))
(defun command-available-p (command &optional context)
 "Return whether COMMAND is live, enabled, has an action, and accepts CONTEXT."
 (and (not (disposed-p command)) (enabled-p command) (command-action command)
      (or (null (command-predicate command))
          (funcall (command-predicate command) command context))
      (not (disposed-p command)) (enabled-p command) (command-action command) t))
(defun binding-context (binding)
 (if (slot-value binding 'context-function)
     (funcall (slot-value binding 'context-function) (slot-value binding 'window))
     (slot-value binding 'context)))
(defun binding-present-p (binding)
 (and (command-binding-active-p binding)
      (let ((window (slot-value binding 'window)) (widget (slot-value binding 'widget)))
        (and (not (disposed-p window))
             (or (null widget) (and (not (disposed-p widget)) (eq (root-of widget) window)))))))
(defun refresh-command-binding (binding)
 (when (and (command-binding-active-p binding) (slot-value binding 'widget))
   (let* ((command (slot-value binding 'command)) (widget (slot-value binding 'widget))
          (available (and (binding-present-p binding)
                          (command-available-p command (binding-context binding)))))
     ;; Context providers/predicates may disconnect a binding; never resurrect it.
     (when (and (command-binding-active-p binding) (not (disposed-p widget)))
       (unless (string= (text widget) (command-label command))
         (setf (text widget) (command-label command)))
       (unless (eq (enabled-p widget) (not (null available)))
         (setf (enabled-p widget) (not (null available))))))) binding)
(defun window-commands (window)
 "Return distinct commands with present bindings in WINDOW, in registration order. Includes disabled commands."
 (remove-duplicates
   (loop for binding in (reverse (copy-list (slot-value window 'command-links)))
         when (and (binding-present-p binding) (eq window (slot-value binding 'window)))
         collect (slot-value binding 'command)) :test #'eq :from-end t))
(defun refresh-commands (window)
 "Refresh the captions and enabled states of WINDOW's command-bound controls."
 (dolist (binding (copy-list (slot-value window 'command-links)))
   (when (and (command-binding-active-p binding) (eq window (slot-value binding 'window)))
     (refresh-command-binding binding))) window)
(defun refresh-command-links (command)
 (dolist (binding (copy-list (slot-value command 'command-links)))
   (refresh-command-binding binding)))
(defun invoke-command (command &optional context)
 "Recheck availability, then execute COMMAND with CONTEXT. Return executed-p and the action's primary result."
 (if (command-available-p command context)
     (let ((result (funcall (command-action command) command context)))
       (refresh-command-links command) (values t result))
     (values nil nil)))
(defun invoke-command-binding (binding)
 (when (and (binding-present-p binding) (enabled-p (slot-value binding 'window))
            (visible-p (slot-value binding 'window)) (null (modal-blocker (slot-value binding 'window))))
   (let ((context (binding-context binding)))
     (when (command-binding-active-p binding)
       (invoke-command (slot-value binding 'command) context)))))
(defun command-shortcut-matches-p (shortcut event)
 (if (keywordp shortcut) (eq shortcut (event-key event))
     (and shortcut
          (eq (getf shortcut :key) (or (event-base-key event) (event-key event)))
          (eq (getf shortcut :control) (event-control-p event))
          (eq (getf shortcut :alt) (event-alt-p event))
          (eq (getf shortcut :super) (event-super-p event))
          (eq (getf shortcut :shift) (event-shift-p event)))))
(defun unbind-command (binding &key (restore-p t))
 "Disconnect BINDING idempotently. Restore the control's previous label/enabled state by default; clear all endpoint/context references."
 (check-type restore-p boolean)
 (when (command-binding-active-p binding)
   (setf (slot-value binding 'active-p) nil)
   (unwind-protect
     (let ((widget (slot-value binding 'widget)))
       (dolist (connection (slot-value binding 'connections)) (disconnect connection))
       (dolist (endpoint (remove-duplicates (list (slot-value binding 'command) (slot-value binding 'window) widget)))
         (when endpoint (setf (slot-value endpoint 'command-links)
                              (remove binding (slot-value endpoint 'command-links)))))
       (when (and widget (not (disposed-p widget)))
         (if restore-p
             (setf (text widget) (slot-value binding 'old-text) (enabled-p widget) (slot-value binding 'old-enabled))
             (setf (enabled-p widget) nil))))
     (dolist (slot '(command window widget context context-function old-text old-enabled connections))
       (setf (slot-value binding slot) nil)))) binding)
(defmethod dispose ((binding command-binding)) (unbind-command binding))
(defmethod release-command-links :before ((widget widget))
 (let (failure)
   (dolist (binding (copy-list (slot-value widget 'command-links)))
     (handler-case (unbind-command binding :restore-p (not (typep widget 'command)))
       (error (e) (unless failure (setf failure e)))))
   (when failure (error failure))))
(defun bind-command (window command &key widget (context window) context-function (shortcut-p t))
 "Bind COMMAND to WINDOW and optionally a button/menu button. CONTEXT is constant; CONTEXT-FUNCTION takes WINDOW and supplies dynamic context. Return a binding handle."
 (check-type window window) (check-type command command) (check-type shortcut-p boolean)
 (ensure-live window) (ensure-live command)
 (when widget
   (check-type widget button) (ensure-live widget)
   (when (some (lambda (b) (and (command-binding-active-p b) (eq widget (slot-value b 'widget))))
               (slot-value widget 'command-links))
     (error "This control already has a command binding.")))
 (unless (typep context-function '(or null function symbol))
   (error "CONTEXT-FUNCTION must be a function designator or NIL."))
 (let ((binding (make-instance 'command-binding :command command :window window :widget widget
                 :context context :context-function context-function
                 :old-text (when widget (text widget)) :old-enabled (when widget (enabled-p widget)))))
   (dolist (endpoint (remove-duplicates (list window command widget)))
     (when endpoint (push binding (slot-value endpoint 'command-links))))
   (handler-case
     (progn
       (when widget
         (push (nth-value 1 (on widget :activate
                 (lambda (w payload)
                   (declare (ignore payload))
                   (when (and (command-binding-active-p binding) (live-input-widget-p w window))
                     (let ((menu (ancestor-of-type w 'context-menu)))
                       (when (invoke-command-binding binding)
                         (when menu (dismiss-dialog menu)))))) :owner command))
               (slot-value binding 'connections)))
       (when shortcut-p
         (push (nth-value 1 (on window :key
                 (lambda (w event)
                   (when (and (command-binding-active-p binding) (eq (input-root w) w)
                              (event-key event)
                              (command-shortcut-matches-p (command-shortcut command) event)
                              (invoke-command-binding binding))
                     (setf (event-key event) nil))) :owner command))
               (slot-value binding 'connections)))
       (refresh-command-binding binding) binding)
     (error (condition) (ignore-errors (unbind-command binding)) (error condition)))))
(defmethod dispose :after ((command command))
 (setf (slot-value command 'command-action) nil (slot-value command 'command-predicate) nil
       (slot-value command 'command-shortcut) nil (slot-value command 'command-label) ""))
(defmethod (setf command-label) :after (value (command command))
 (declare (ignore value)) (unless (disposed-p command) (refresh-command-links command)))
(defmethod (setf command-action) :after (value (command command))
 (declare (ignore value)) (unless (disposed-p command) (refresh-command-links command)))
(defmethod (setf command-predicate) :after (value (command command))
 (declare (ignore value)) (unless (disposed-p command) (refresh-command-links command)))
(defmethod (setf enabled-p) :after (value (command command))
 (declare (ignore value)) (unless (disposed-p command) (refresh-command-links command)))
