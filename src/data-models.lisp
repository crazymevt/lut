(in-package #:lut)

(defclass data-model (widget)
 ((revision :initform 0 :reader model-revision)
  (notifying-p :initform nil :accessor model-notifying-p)
  (disposing-p :initform nil :accessor model-disposing-p))
 (:documentation "Keyed application data. Keys are non-NIL, immutable, unique under EQUAL and stable across reorderings."))
(defgeneric model-count (model) (:documentation "Number of currently visible rows; must not materialize row strings."))
(defgeneric model-item (model index) (:documentation "Application item at a zero-based visible INDEX."))
(defgeneric model-key (model index) (:documentation "Stable non-NIL EQUAL identity at visible INDEX."))
(defgeneric model-index (model key) (:documentation "Visible index of KEY, or NIL. Implement for efficient lazy-model lookup."))
(defgeneric model-contains-key-p (model key) (:documentation "Whether KEY still exists, including hidden/filtered tree rows."))
(defgeneric model-depth (model index))
(defgeneric model-branch-p (model index))
(defmethod model-depth ((model data-model) index) (check-model-index model index) 0)
(defmethod model-branch-p ((model data-model) index) (check-model-index model index) nil)
(defmethod model-index ((model data-model) key)
 (loop for i below (model-count model) when (equal key (model-key model i)) return i))
(defmethod model-contains-key-p ((model data-model) key) (not (null (model-index model key))))
(defun check-model-index (model index)
 (ensure-live model)
 (unless (and (integerp index) (<= 0 index) (< index (model-count model))) (error "Model index out of range: ~s" index)))
(defun ensure-model-mutable (model)
 (ensure-live model)
 (when (or (model-notifying-p model) (model-disposing-p model)) (error "Reentrant model mutation; queue a follow-up change.")))
(defun notify-model-change (model)
 "Publish an externally committed change. Advances revision, then emits :MODEL-CHANGE with that revision."
 (ensure-model-mutable model)
 (incf (slot-value model 'revision))
 (let ((revision (model-revision model)))
   (setf (model-notifying-p model) t)
   (unwind-protect (emit model :model-change revision) (setf (model-notifying-p model) nil))) model)
(defmethod dispose :around ((model data-model))
 ;; Dependents detach while the source can still emit; cleanup runs even if a
 ;; dependent observer fails. Models never own application items or sources.
 (unless (or (disposed-p model) (model-disposing-p model))
   (setf (model-disposing-p model) t)
   (let ((failure nil))
     (unwind-protect
         (dolist (connection (reverse (copy-list (slot-value model 'handlers))))
           (when (and (connection-active-p connection) (eq :model-disposing (connection-event connection)))
             (handler-case (funcall (connection-callback connection) model nil)
               (error (condition) (unless failure (setf failure condition))))))
       (call-next-method))
     (when failure (error failure)))) model)

(defclass function-model (data-model)
 ((count-function :initarg :count :accessor count-function)
  (item-function :initarg :item :accessor model-item-function)
  (key-function :initarg :key :accessor model-key-function)
  (index-function :initarg :index :accessor model-index-function)))
(defun make-function-model (&key count item (key #'identity) index)
 "COUNT is a nonnegative integer or zero-argument function; ITEM/KEY map index to item/key. INDEX maps key to index or NIL."
 (unless (or (typep count '(integer 0 *)) (typep count '(or function symbol))) (error "Invalid model count."))
 (unless (and count item key) (error "COUNT, ITEM and KEY are required."))
 (make-instance 'function-model :count count :item item :key key :index index))
(defmethod model-count ((model function-model))
 (ensure-live model)
 (let ((n (if (integerp (count-function model)) (count-function model) (funcall (count-function model)))))
   (check-type n (integer 0 *)) n))
(defmethod model-item ((model function-model) index)
 (check-model-index model index) (funcall (model-item-function model) index))
(defmethod model-key ((model function-model) index)
 (check-model-index model index) (or (funcall (model-key-function model) index) (error "NIL is not a model key.")))
(defmethod model-index ((model function-model) key)
 (ensure-live model)
 (if (model-index-function model)
     (let ((index (funcall (model-index-function model) key)))
       (when (and (integerp index) (<= 0 index) (< index (model-count model)) (equal key (model-key model index))) index))
     (call-next-method)))
(defmethod dispose :after ((model function-model))
 (setf (count-function model) 0 (model-item-function model) nil (model-key-function model) nil (model-index-function model) nil))

(defclass vector-model (data-model)
 ((data :initform #() :accessor model-data)
  (keys :initform #() :accessor model-keys)
  (indices :initform (make-hash-table :test #'equal) :accessor model-indices)
  (key-function :initarg :key :accessor vector-key-function)))
(defun keyed-vector (items key-function)
 (let* ((data (coerce items 'vector)) (keys (make-array (length data))) (indices (make-hash-table :test #'equal)))
   (loop for item across data for i from 0 for key = (funcall key-function item) do
     (unless key (error "NIL is not a model key."))
     (when (nth-value 1 (gethash key indices)) (error "Duplicate model key ~s." key))
     (setf (aref keys i) key (gethash key indices) i))
   (values (copy-seq data) keys indices)))
(defun make-vector-model (items &key (key #'identity))
 "Copy a sequence of application items. KEY maps each item to a unique stable non-NIL identity."
 (let ((model (make-instance 'vector-model :key key)))
   (multiple-value-bind (data keys indices) (keyed-vector items key)
     (setf (model-data model) data (model-keys model) keys (model-indices model) indices)) model))
(defun replace-model-items (model items)
 "Validate and replace a vector model's sequence transactionally, then publish :MODEL-CHANGE."
 (check-type model vector-model) (ensure-model-mutable model)
 (multiple-value-bind (data keys indices) (keyed-vector items (vector-key-function model))
   (setf (model-data model) data (model-keys model) keys (model-indices model) indices))
 (notify-model-change model))
(defmethod model-count ((model vector-model)) (ensure-live model) (length (model-data model)))
(defmethod model-item ((model vector-model) index) (check-model-index model index) (aref (model-data model) index))
(defmethod model-key ((model vector-model) index) (check-model-index model index) (aref (model-keys model) index))
(defmethod model-index ((model vector-model) key) (ensure-live model) (gethash key (model-indices model)))
(defmethod dispose :after ((model vector-model))
 (setf (model-data model) #() (model-keys model) #() (model-indices model) (make-hash-table :test #'equal)
       (vector-key-function model) nil))

(defclass projection-model (data-model)
 ((source-model :initarg :source :accessor projection-source)
  (predicate :initform nil :accessor projection-predicate)
  (lessp :initform nil :accessor projection-lessp)
  (order :initform #() :accessor projection-order)
  (indices :initform (make-hash-table :test #'equal) :accessor projection-indices)))
(defun projection-snapshot (model predicate lessp)
 (let* ((source (projection-source model))
        (order (loop for i below (model-count source) when (or (null predicate) (funcall predicate (model-item source i))) collect i)))
   (when lessp (setf order (stable-sort order (lambda (a b) (funcall lessp (model-item source a) (model-item source b))))))
   (let ((indices (make-hash-table :test #'equal)))
     (loop for i in order for j from 0 do (setf (gethash (model-key source i) indices) j))
     (values (coerce order 'vector) indices))))
(defun set-model-query (model &key (predicate (projection-predicate model)) (lessp (projection-lessp model)))
 "Set item predicate and stable ordering comparator. NIL disables either. Builds before committing; O(source rows)."
 (check-type model projection-model) (ensure-model-mutable model)
 (multiple-value-bind (order indices) (projection-snapshot model predicate lessp)
   (setf (projection-order model) order (projection-indices model) indices
         (projection-predicate model) predicate (projection-lessp model) lessp))
 (notify-model-change model))
(defun make-projection-model (source &key predicate lessp)
 "A sorted/filtered index over SOURCE; retains items and stable identities without copying row data."
 (check-type source data-model) (ensure-live source)
 (let ((model (make-instance 'projection-model :source source)))
   (set-model-query model :predicate predicate :lessp lessp)
   (on source :model-change (lambda (s revision) (declare (ignore s revision))
     (handler-case (set-model-query model)
       (error (condition) (dispose model) (error condition)))) :owner model)
   (on source :model-disposing (lambda (s p) (declare (ignore s p)) (dispose model)) :owner model) model))
(defmethod model-count ((model projection-model)) (ensure-live model) (length (projection-order model)))
(defmethod model-item ((model projection-model) index)
 (check-model-index model index) (model-item (projection-source model) (aref (projection-order model) index)))
(defmethod model-key ((model projection-model) index)
 (check-model-index model index) (model-key (projection-source model) (aref (projection-order model) index)))
(defmethod model-depth ((model projection-model) index)
 (check-model-index model index) (model-depth (projection-source model) (aref (projection-order model) index)))
(defmethod model-branch-p ((model projection-model) index)
 (check-model-index model index) (model-branch-p (projection-source model) (aref (projection-order model) index)))
(defmethod model-index ((model projection-model) key) (ensure-live model) (gethash key (projection-indices model)))
(defmethod model-contains-key-p ((model projection-model) key) (model-contains-key-p (projection-source model) key))
(defmethod dispose :after ((model projection-model))
 (setf (projection-source model) nil (projection-predicate model) nil (projection-lessp model) nil
       (projection-order model) #() (projection-indices model) (make-hash-table :test #'equal)))

(defclass tree-model (data-model)
 ((roots :initarg :roots :accessor tree-roots)
  (key-function :initarg :key :accessor tree-key-function)
  (children-function :initarg :child-function :accessor tree-children-function)
  (expanded :initform (make-hash-table :test #'equal) :accessor tree-expanded)
  (all :initform (make-hash-table :test #'equal) :accessor tree-all)
  (visible :initform #() :accessor tree-visible)
  (indices :initform (make-hash-table :test #'equal) :accessor tree-indices)))
(defun tree-snapshot (roots key-function children-function expanded)
 (let ((all (make-hash-table :test #'equal)) (indices (make-hash-table :test #'equal)) (visible nil) (index 0))
   (labels ((visit (items depth shown)
              (map nil (lambda (item)
                (let ((key (funcall key-function item)) (children (coerce (funcall children-function item) 'list)))
                  (unless key (error "NIL is not a tree key."))
                  (when (nth-value 1 (gethash key all)) (error "Duplicate/cyclic tree key ~s." key))
                  (setf (gethash key all) item)
                  (when shown (setf (gethash key indices) index) (incf index)
                    (push (list item key depth (not (null children))) visible))
                  (visit children (1+ depth) (and shown (gethash key expanded))))) items)))
     (visit roots 0 t))
   (values all (coerce (nreverse visible) 'vector) indices)))
(defun replace-tree-roots (model roots)
 "Rebuild a tree from application data; validate all unique keys before commit. Retain expansion for surviving keys."
 (check-type model tree-model) (ensure-model-mutable model)
 (let ((roots (coerce roots 'list)))
   (multiple-value-bind (all visible indices) (tree-snapshot roots (tree-key-function model) (tree-children-function model) (tree-expanded model))
     (setf (tree-roots model) (copy-list roots) (tree-all model) all (tree-visible model) visible (tree-indices model) indices)
     (maphash (lambda (key value) (declare (ignore value))
                (unless (nth-value 1 (gethash key all)) (remhash key (tree-expanded model)))) (tree-expanded model))))
 (notify-model-change model))
(defun make-tree-model (roots &key (key #'identity) children)
 "Tree of application objects. KEY supplies stable identity; CHILDREN returns a finite sequence. Initially collapsed."
 (unless children (error "A tree children function is required."))
 (let ((model (make-instance 'tree-model :roots nil :key key :child-function children))) (replace-tree-roots model roots)))
(defun tree-expanded-p (model key) (not (null (gethash key (tree-expanded model)))))
(defun set-tree-expanded (model key expanded)
 "Set KEY's expansion, rebuild visible rows and notify. Hidden descendant selections remain valid."
 (check-type model tree-model) (ensure-model-mutable model)
 (unless (model-contains-key-p model key) (error "Unknown tree key ~s." key))
 (let ((next (make-hash-table :test #'equal)))
   (maphash (lambda (k v) (setf (gethash k next) v)) (tree-expanded model))
   (if expanded (setf (gethash key next) t) (remhash key next))
   (multiple-value-bind (all visible indices) (tree-snapshot (tree-roots model) (tree-key-function model) (tree-children-function model) next)
     (setf (tree-expanded model) next (tree-all model) all (tree-visible model) visible (tree-indices model) indices)))
 (notify-model-change model))
(defmethod model-count ((model tree-model)) (ensure-live model) (length (tree-visible model)))
(defmethod model-item ((model tree-model) index) (check-model-index model index) (first (aref (tree-visible model) index)))
(defmethod model-key ((model tree-model) index) (check-model-index model index) (second (aref (tree-visible model) index)))
(defmethod model-depth ((model tree-model) index) (check-model-index model index) (third (aref (tree-visible model) index)))
(defmethod model-branch-p ((model tree-model) index) (check-model-index model index) (fourth (aref (tree-visible model) index)))
(defmethod model-index ((model tree-model) key) (ensure-live model) (gethash key (tree-indices model)))
(defmethod model-contains-key-p ((model tree-model) key) (ensure-live model) (nth-value 1 (gethash key (tree-all model))))
(defmethod dispose :after ((model tree-model))
 (setf (tree-roots model) nil (tree-key-function model) nil (tree-children-function model) nil (tree-visible model) #())
 (clrhash (tree-expanded model)) (clrhash (tree-all model)) (clrhash (tree-indices model)))

(defclass selection-model (widget)
 ((model :initarg :model :reader selection-source)
  (mode :initarg :mode :reader model-selection-mode)
  (keys :initform nil :accessor selection-keys)
  (focus :initform nil :reader selection-focus)
  (anchor :initform nil :reader selection-anchor))
 (:documentation "Independent keyed :NONE/:SINGLE/:MULTIPLE selection created by MAKE-SELECTION-MODEL; source remains application-owned."))
(defun selected-keys (selection) "Copy the selection's stable keys, including temporarily hidden keys." (copy-list (selection-keys selection)))
(defun selection-contains-p (selection key) (not (null (member key (selection-keys selection) :test #'equal))))
(defun publish-model-selection (selection keys focus anchor)
 (let ((changed (not (and (equal keys (selection-keys selection)) (equal focus (selection-focus selection))
                          (equal anchor (selection-anchor selection))))))
   (setf (selection-keys selection) keys (slot-value selection 'focus) focus (slot-value selection 'anchor) anchor)
   (when changed (emit selection :selection-change (selected-keys selection)))) selection)
(defun reconcile-model-selection (selection)
 (let ((model (selection-source selection)))
   (flet ((valid (key) (and key (not (disposed-p model)) (model-contains-key-p model key))))
     (publish-model-selection selection (remove-if-not #'valid (selection-keys selection))
       (when (valid (selection-focus selection)) (selection-focus selection))
       (when (valid (selection-anchor selection)) (selection-anchor selection))))))
(defun make-selection-model (model &key (mode :single))
 "Independent :NONE/:SINGLE/:MULTIPLE keyed selection. A range follows current visible model order."
 (check-type model data-model) (ensure-live model)
 (unless (member mode '(:none :single :multiple)) (error "Unknown selection mode."))
 (let ((selection (make-instance 'selection-model :model model :mode mode)))
   (on model :model-change (lambda (m revision) (declare (ignore m revision)) (reconcile-model-selection selection)) :owner selection)
   (on model :model-disposing (lambda (m p) (declare (ignore m p)) (dispose selection)) :owner selection) selection))
(defun clear-model-selection (selection)
 "Clear keys, focus and range anchor; emit :SELECTION-CHANGE only if changed."
 (ensure-live selection) (publish-model-selection selection nil nil nil))
(defun select-model-index (selection index &key extend toggle)
 "Select visible INDEX; EXTEND forms an anchored range, TOGGLE adds/removes, both add the range."
 (ensure-live selection)
 (let* ((model (selection-source selection)) (mode (model-selection-mode selection)))
   (check-model-index model index)
   (unless (eq mode :none)
     (let* ((key (model-key model index)) (multiple (eq mode :multiple))
            (anchor (and multiple extend (selection-anchor selection)))
            (a (and anchor (model-index model anchor)))
            (range (if a (loop for i from (min a index) to (max a index) collect (model-key model i)) (list key)))
            (keys (cond ((and multiple toggle extend) (union (selection-keys selection) range :test #'equal))
                        ((and multiple toggle) (if (selection-contains-p selection key)
                            (remove key (selection-keys selection) :test #'equal) (append (selection-keys selection) (list key))))
                        ((and multiple extend) range) (t (list key)))))
       (publish-model-selection selection keys key (if a anchor key))))) selection)
(defmethod dispose :after ((selection selection-model))
 (setf (selection-keys selection) nil (slot-value selection 'focus) nil (slot-value selection 'anchor) nil
       (slot-value selection 'model) nil))
(defun handle-selection-event (selection event &key index)
 "Apply pointer :DOWN at supplied INDEX or keyboard Up/Down/Home/End to any model selection. Return handled-p."
 (ensure-live selection)
 (let* ((model (selection-source selection))
        (current (and (selection-focus selection) (model-index model (selection-focus selection))))
        (destination
          (case (event-kind event)
            (:down index)
            (:key (when (plusp (model-count model))
                    (case (event-key event) (:home 0) (:end (1- (model-count model)))
                      (:up (max 0 (1- (or current 1))))
                      (:down (min (1- (model-count model)) (if current (1+ current) 0)))))))))
   (when destination
     (select-model-index selection destination :extend (event-shift-p event)
       :toggle (or (event-control-p event) (event-super-p event))) t)))
