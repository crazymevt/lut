(in-package #:lut)

(defun submit-search-control (w)
 (emit w :search (text w)))
(defun clear-search-control (w)
 (when (editable-p w)
   (select-all w)
   (replace-selection w "")
   (emit w :cancel (text w))))
(defmethod initialize-instance :after ((w search-control) &key)
 (setf (search-submit w) (add-child w (make-widget 'search-submit-button :tooltip-text "Search"))
       (search-clear w) (add-child w (make-widget 'search-clear-button :tooltip-text "Clear search")))
 (on w :activate (lambda (source payload) (declare (ignore payload)) (submit-search-control source)) :owner w)
 (on (search-submit w) :activate
     (lambda (button payload) (declare (ignore button payload)) (submit-search-control w)) :owner w)
 (on (search-clear w) :activate
     (lambda (button payload) (declare (ignore button payload))
       (clear-search-control w)
       (let ((root (root-of w))) (when (typep root 'window) (focus root w)))) :owner w))
(defmethod layout :after ((w search-control) x y width height)
 (let* ((inset (min 4 (/ height 4) (/ width 8)))
        (size (max 0 (min 28 (- height (* 2 inset)) (/ width 3)))))
   (layout (search-submit w) (+ x inset) (+ y (/ (- height size) 2)) size size)
   (layout (search-clear w) (- (+ x width) inset size) (+ y (/ (- height size) 2)) size size)))
(defmethod text-left-padding ((w search-control))
 (+ (- (x (search-submit w)) (x w)) (width (search-submit w)) 8))
(defmethod scroll-viewport ((w search-control))
 (let ((left (+ (x w) (text-left-padding w)))
       (right (- (x (search-clear w)) 8)))
   (values left (+ (y w) 2) (max 0 (- right left)) (max 0 (- (height w) 4)))))
(defmethod scroll-geometry ((w search-control) &optional (axis :vertical))
 (multiple-value-bind (extent page offset) (call-next-method)
   (values extent (if (eq axis :horizontal) (nth-value 2 (scroll-viewport w)) page) offset)))
(defmethod handle-event ((w search-control) e)
 (when (and (eq (event-kind e) :key) (eq (event-key e) :escape))
   (clear-search-control w) t))

(defmethod measure ((w search-control) axis &optional for-size)
 (declare (ignore for-size))
 (if (eq axis :horizontal)
     (values 120 (max 200 (+ 88 (text-width w (search-hint w)))))
     (let ((size (max 36 (+ 16 (style-value w :font-size))))) (values size size))))
(defmethod measure ((w activity-indicator) axis &optional for-size)
 (declare (ignore axis for-size)) (values 24 24))
