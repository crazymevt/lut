(in-package #:lut)
(defun presentation-texture (source)
 (let* ((key (list (namestring (pathname source)) (file-write-date source)))
        (texture (or (cdr (assoc key *texture-cache* :test #'equal))
                     (let ((texture (rl:load-texture (namestring (pathname source)))))
                       (unless (rl:is-texture-valid texture) (error "Could not load image ~a" source))
                       (push (cons key texture) *texture-cache*) texture))))
   (pushnew texture *used-textures* :test #'eq) texture))
(defun presentation-range-rectangle (view start end py)
 (let ((left (text-position-rectangle view start)) (right (text-position-rectangle view end)))
   (values left py (max (if (= start end) 2 0) (- right left)) (line-height view))))
(defun paint-presentation-decoration (view record start end py)
 (let ((a (max start (record-start record))) (b (min end (record-end record)))
       (color (or (getf record :color) (style-value view :accent))))
   (when (<= a b)
     (multiple-value-bind (left top width height) (presentation-range-rectangle view a b py)
       (case (getf record :kind)
         (:background (rl:draw-rectangle left top width height color))
         (:underline (rl:draw-rectangle left (+ top height -2) width 2 color))
         (:annotation (when (<= start (record-start record) end)
                        (draw-string view (or (getf record :text) "") (+ left 4) top color))))))))
(defun paint-styled-line (view root line start end py)
 (multiple-value-bind (a b advance) (visible-line-fragment view root line)
   (declare (ignore advance))
   ;; Font/background spans, then application backgrounds, then selection.
   (map-presentation-fragments view a b
     (lambda (lo hi style image)
       (declare (ignore image))
       (when (getf style :background)
         (multiple-value-bind (left top width height) (presentation-range-rectangle view lo hi py)
           (rl:draw-rectangle left top width height (getf style :background))))))
   (map-text-decorations view a (1+ b)
     (lambda (record) (when (eq (getf record :kind) :background) (paint-presentation-decoration view record a b py))))
   (multiple-value-bind (lo hi) (selection view)
     (setf lo (max lo a) hi (min hi b))
     (when (< lo hi)
       (multiple-value-bind (left top width height) (presentation-range-rectangle view lo hi py)
         (rl:draw-rectangle left top width height (style-value view :accent)))))
   (map-presentation-fragments view a b
     (lambda (lo hi style image)
       (flet ((paint-part (from to selected)
                (when (< from to)
                  (let ((left (+ (text-position-rectangle view from) (if (> from start) (text-metric-spacing view) 0)))
                        (*text-style-context* (cons view (append (when selected (list :foreground (style-value view :on-accent))) style)))
                        (*text-run-font* nil))
                    (if image
                        (let ((texture (presentation-texture (getf image :source))))
                          (rl:draw-texture-pro texture (rl:rect 0 0 (rl:texture-width texture) (rl:texture-height texture))
                            (rl:rect left (+ py (max 0 (/ (- (line-height view) (getf image :height)) 2)))
                                     (getf image :width) (getf image :height)) (rl:vec2 0 0) 0 :white))
                        (draw-string view (index-substring root from to) left py))))))
         (multiple-value-bind (selected-start selected-end) (selection view)
           (let ((from (max lo selected-start)) (to (min hi selected-end)))
             (if (< from to)
                 (progn (paint-part lo from nil) (paint-part from to t) (paint-part to hi nil))
                 (paint-part lo hi nil)))))))
   (map-text-decorations view a (1+ b)
     (lambda (record) (unless (member (getf record :kind) '(:background :gutter))
                       (paint-presentation-decoration view record a b py))))
   (loop for record across (presentation-links view)
         when (and (< (record-start record) b) (> (record-end record) a)) do
           (paint-presentation-decoration view (list :start (record-start record) :end (record-end record) :kind :underline) a b py))
   (when (and (<= start (cursor view) end) (typep (root-of view) 'window)
              (eq view (focused-widget (root-of view))))
     (multiple-value-bind (cx cy cw lh) (text-position-rectangle view (cursor view))
       (rl:draw-rectangle cx cy cw lh (style-value view :foreground))))))
(defmethod render ((view styled-text-view))
 (paint-surface view)
 (let* ((*font-codepoints-cache* (list (cons (root-of view) (font-codepoints view))))
        (root (display-index view))
        (gesture (and (typep (root-of view) 'window)
                      (eq view (first (slot-value (root-of view) 'text-selection-state))))))
   (unless gesture (reveal-text-cursor view :vertical (/= (last-cursor view) (cursor view))))
   (let* ((left (+ (x view) (text-left-padding view)))
          (clip (intersect-rectangles *clip* (list left (y view) (max 0 (- (+ (x view) (width view)) left (style-value view :padding))) (height view)))))
     (when (and (plusp (third clip)) (plusp (fourth clip)))
       (with-ui-scissor ((first clip) (second clip) (third clip) (fourth clip))
         (map-visible-text-lines view (lambda (line start end px py) (declare (ignore px))
           (paint-styled-line view root line start end py))))))
   (when (plusp (gutter-width view))
     (let ((clip (intersect-rectangles *clip* (list (x view) (y view) (text-left-padding view) (height view)))))
       (with-ui-scissor ((first clip) (second clip) (third clip) (fourth clip))
         (rl:draw-rectangle (x view) (y view) (text-left-padding view) (height view) (style-value view :background))
         (map-visible-text-lines view (lambda (line start end px py) (declare (ignore line px))
           (map-text-decorations view start (1+ end) (lambda (record)
             (when (eq (getf record :kind) :gutter)
               (draw-string view (or (getf record :text) "") (+ (x view) (style-value view :padding)) py
                            (or (getf record :color) (style-value view :foreground)))))))))))
   ;; The outer renderer draws focus using its original ancestor clip.
   (begin-ui-scissor (first *clip*) (second *clip*) (third *clip*) (fourth *clip*))))
(defmethod render ((surface suggestion-surface))
 (paint-surface surface)
 (let* ((pad (style-value surface :padding)) (rh (row-height surface))
        (first (max 0 (floor (scroll-offset surface) rh)))
        (limit (min (length (items surface)) (ceiling (+ (scroll-offset surface) (- (height surface) (* 2 pad))) rh))))
   (loop for item in (nthcdr first (items surface)) for index from first below limit
         for py = (- (+ (y surface) pad (* index rh)) (scroll-offset surface)) do
     (when (eql index (value surface))
       (rl:draw-rectangle (+ (x surface) pad) py (max 0 (- (width surface) (* 2 pad))) rh (style-value surface :accent)))
     (draw-string surface (funcall (item-label-function surface) item) (+ (x surface) pad) py
                  (style-value surface (if (eql index (value surface)) :on-accent :foreground))))))
