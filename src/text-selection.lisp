(in-package #:lut)
(defun index-character (root position)
 (if (text-node-string root) (char (text-node-string root) position)
     (let ((left (text-node-left root)))
       (if (< position (node-size left)) (index-character left position)
           (index-character (text-node-right root) (- position (node-size left)))))))
(defun text-character-kind (character)
 (cond ((find character '(#\Space #\Tab #\Newline #\Return #\Page)) :space)
       ((or (alphanumericp character) (char= character #\_)) :word) (t :punctuation)))
(defun index-skip-kind (root position kind backward)
 ;; Descend once, then scan adjacent leaf strings in order. Each character is
 ;; classified once; skipped subtrees are pruned rather than looked up per char.
 (let ((p position))
   (labels ((visit (node base)
              (when (and node (if backward (< base p) (> (+ base (node-size node)) p)))
                (let ((string (text-node-string node)))
                  (if string
                      (if backward
                          (loop for i downfrom (1- (min (length string) (- p base))) to 0 do
                            (unless (eq kind (text-character-kind (char string i)))
                              (return-from index-skip-kind (+ base i 1)))
                            (decf p))
                          (loop for i from (max 0 (- p base)) below (length string) do
                            (unless (eq kind (text-character-kind (char string i)))
                              (return-from index-skip-kind (+ base i)))
                            (incf p)))
                      (let ((right-base (+ base (node-size (text-node-left node)))))
                        (if backward
                            (progn (visit (text-node-right node) right-base) (visit (text-node-left node) base))
                            (progn (visit (text-node-left node) base) (visit (text-node-right node) right-base)))))))))
     (visit root 0)) p))
(defun index-word-range (root position)
 (let ((size (node-size root)))
   (unless (and (integerp position) (<= 0 position size)) (error "Invalid word position."))
   (if (zerop size) (values 0 0)
       (let* ((at (min position (1- size))) (kind (text-character-kind (index-character root at))))
         (values (index-skip-kind root at kind t) (index-skip-kind root (1+ at) kind nil))))))
(defun text-word-range (target position)
 "Return the character run containing POSITION (EOF uses the preceding character). Runs are word, whitespace or punctuation."
 (index-word-range (target-text-index target) position))
(defun word-navigation-position (root position direction)
 (if (eq direction :word-left)
     (let ((p (index-skip-kind root position :space t)))
       (if (zerop p) 0 (index-skip-kind root p (text-character-kind (index-character root (1- p))) t)))
     (let ((p (if (= position (node-size root)) position
                  (index-skip-kind root position (text-character-kind (index-character root position)) nil))))
       (index-skip-kind root p :space nil))))
(defun display-line-selection-range (root position)
 (let ((line (index-position-line root position)))
   (multiple-value-bind (start end) (index-line-range root line)
     (values start (if (< end (node-size root)) (1+ end) end)))))
(defun text-content-width (view)
 (if (typep view 'search-control) (max 1 (nth-value 2 (scroll-viewport view)))
     (max 1 (- (width view) (text-left-padding view) (style-value view :padding)
               (if (typep view 'combo-box) (selection-button-width view) 0)))))
(defun reveal-text-cursor (view &key (vertical t))
 "Reveal VIEW's caret using shared geometry and its own offsets. VERTICAL NIL preserves vertical scroll. Return VIEW; selection is unchanged."
 (check-type view entry) (ensure-live view)
 (multiple-value-bind (cx cy cw lh) (text-position-rectangle view (cursor view))
   (let* ((pad (style-value view :padding))
          (available (text-content-width view))
          (tall (max lh (- (height view) (* 2 pad))))
          (local-x (+ (- cx (x view) (text-left-padding view)) (text-offset view)))
          (local-y (+ (- cy (y view) pad) (vertical-offset view))))
     (setf (text-offset view) (max 0 (min (text-offset view) local-x)))
     (when (> (+ local-x cw) (+ (text-offset view) available))
       (setf (text-offset view) (max 0 (- (+ local-x cw) available))))
     (when (and vertical (typep view 'text-view))
       (setf (vertical-offset view) (max 0 (min (vertical-offset view) local-y)))
       (when (> (+ local-y lh) (+ (vertical-offset view) tall))
         (setf (vertical-offset view) (- (+ local-y lh) tall)))))
   (setf (slot-value view 'last-cursor) (cursor view))) view)
(defun select-word (view &optional (position (cursor view)))
 "Select the display run at POSITION, preserving read-only policy. Return VIEW."
 (check-type view entry) (ensure-live view)
 (multiple-value-bind (start end) (index-word-range (display-index view) position)
   (setf (slot-value view 'anchor) start (cursor view) end))
 (reveal-text-cursor view))
(defun select-line (view &optional (position (cursor view)))
 "Select the logical display line at POSITION, including its terminating newline. Return VIEW."
 (check-type view entry) (ensure-live view)
 (let ((root (display-index view)))
   (unless (and (integerp position) (<= 0 position (node-size root))) (error "Invalid line selection position."))
   (multiple-value-bind (start end) (display-line-selection-range root position)
     (setf (slot-value view 'anchor) start (cursor view) end)))
 (reveal-text-cursor view))
(defun move-text-cursor (view movement &key extend)
 "Move by character, word, visual row or document. EXTEND preserves the anchor. Return the new character position."
 (check-type view entry) (ensure-live view)
 (let* ((root (display-index view)) (position (cursor view)) (size (node-size root))
        (vertical (member movement '(:up :down)))
        (goal (when vertical
                (or (slot-value view 'navigation-x)
                    (+ (- (text-position-rectangle view position) (x view) (text-left-padding view)) (text-offset view)))))
        (destination
          (cond
            ((and (not extend) (/= position (slot-value view 'anchor))
                  (member movement '(:left :right :word-left :word-right)))
             (if (member movement '(:left :word-left)) (min position (slot-value view 'anchor))
                 (max position (slot-value view 'anchor))))
            (t (ecase movement
                 (:left (max 0 (1- position))) (:right (min size (1+ position)))
                 ((:word-left :word-right) (word-navigation-position root position movement))
                 (:line-start (nth-value 0 (text-row-range view position)))
                 (:line-end (nth-value 1 (text-row-range view position)))
                 (:document-start 0) (:document-end size)
                 ((:up :down)
                  (text-vertical-position view position goal (if (eq movement :up) -1 1))))))))

   (setf (cursor view) destination)
   (finish-text-navigation view movement)
   (when vertical (setf (slot-value view 'navigation-x) goal))
   (unless extend (setf (slot-value view 'anchor) destination))
   (reveal-text-cursor view) destination))
(defmethod cancel-text-selection ((window window) &key forget-clicks)
 (let* ((state (slot-value window 'text-selection-state)) (view (first state)))
   (when (and view (eq view (slot-value window 'pressed-widget))
              (not (and (current-drag window) (eq (drag-state (current-drag window)) :dragging))))
     (setf (slot-value window 'pressed-widget) nil (pressed-p view) nil))
   (setf (slot-value window 'text-selection-state) nil)
   (when forget-clicks (setf (slot-value window 'text-click-state) nil))
   (not (null state))))
(defun cancel-view-text-selection (view)
 (setf (slot-value view 'navigation-x) nil (slot-value view 'last-cursor) -1)
 (let ((root (root-of view)))
   (when (typep root 'window)
     (when (eq view (first (slot-value root 'text-selection-state))) (cancel-text-selection root))
     (when (eq view (first (slot-value root 'text-click-state))) (setf (slot-value root 'text-click-state) nil)))))
(defun remap-view-text-selection (view start old-end new-end)
 ;; Peer edits preserve capture and its initial unit/anchor, including read-only
 ;; log views receiving appended output. Click repetition refers to old content.
 (setf (slot-value view 'navigation-x) nil (slot-value view 'last-cursor) -1)
 (let ((root (root-of view)))
   (when (typep root 'window)
     (let ((state (slot-value root 'text-selection-state)))
       (when (eq view (first state))
         (setf (fifth state) (remap-text-position (fifth state) start old-end new-end)
               (sixth state) (remap-text-position (sixth state) start old-end new-end))))
     (when (eq view (first (slot-value root 'text-click-state))) (setf (slot-value root 'text-click-state) nil)))))
(defun near-pointer-click-p (click x y)
 (and click (<= (+ (expt (- x (third click)) 2) (expt (- y (fourth click)) 2)) 25)))
(defun pointer-click-count (event previous &key target (cycle 3))
 "Return COUNT and opaque next state for repeated pointer downs on TARGET.
Pass the returned state as PREVIOUS on the next down; NIL resets it. Targets
are compared with EQUAL. Timestamped clicks within 0.5 seconds and 5 logical
pixels repeat, cycling at CYCLE (2 or 3). Explicit event counts take priority.
Events without timestamps do not retain repetition state."
 (unless (member cycle '(2 3)) (error "Click cycle must be 2 or 3."))
 (let* ((time (event-timestamp event))
        (count (or (event-click-count event)
                   (if (and previous (equal target (first previous))
                            (realp time) (realp (second previous))
                            (<= 0 (- time (second previous)) 0.5)
                            (near-pointer-click-p previous (event-x event) (event-y event)))
                       (1+ (mod (fifth previous) cycle)) 1))))
   (unless (member count '(1 2 3)) (error "Click count must be 1, 2 or 3."))
   (values count (when (realp time) (list target time (event-x event) (event-y event) (min count cycle))))))
(defun text-click-count (window view event)
 (multiple-value-bind (count state)
     (pointer-click-count event (slot-value window 'text-click-state) :target view)
   (setf (slot-value window 'text-click-state) state)
   count))
(defun text-word-point-position (view px py)
 ;; Caret hit testing rounds to the nearest insertion point. Unit selection
 ;; instead uses the character under the pointer, including a word's last half
 ;; character before punctuation/whitespace.
 (let* ((*text-caret-affinity* nil) (position (text-point-position view px py))
        (start (nth-value 0 (text-row-range view position))))
   (multiple-value-bind (cx cy) (text-position-rectangle view position)
     (if (and (plusp position)
              (or (< py cy) (and (> position start) (< px cx))))
         (1- position) position))))

(defun begin-text-selection (window view event)
 (let* ((position (text-position view event)) (count (text-click-count window view event))
        (mode (if (event-shift-p event) :character (case count (2 :word) (3 :line) (t :character)))))
   (case mode
     (:word (select-word view (text-word-point-position view (event-x event) (event-y event))))
     (:line (select-line view position))
     (:character (setf (cursor view) position)
                 (unless (event-shift-p event) (setf (slot-value view 'anchor) position))))
   (multiple-value-bind (start end) (selection view)
     (setf (slot-value window 'text-selection-state)
           (list view (event-x event) (event-y event) mode
                 (if (eq mode :character) (slot-value view 'anchor) start) end)))
   (reveal-text-cursor view)))
(defun selection-content-bounds (view)
 (when (typep view 'search-control)
   (multiple-value-bind (x y width height) (scroll-viewport view)
     (return-from selection-content-bounds
       (values x y (max x (- (+ x width) (style-value view :caret-width))) (max y (- (+ y height) 1))))))
 (let ((pad (style-value view :padding)))
   (values (+ (x view) (text-left-padding view)) (+ (y view) pad)
           (max (+ (x view) (text-left-padding view)) (- (+ (x view) (width view)) pad (style-value view :caret-width)
                   (cond ((typep view 'combo-box) (selection-button-width view))
                 ((typep view 'search-control) (width (search-clear view))) (t 0))))
           (max (+ (y view) pad) (- (+ (y view) (height view)) pad 1)))))
(defun valid-text-selection-p (window)
 (let ((view (first (slot-value window 'text-selection-state))))
   (and view (eq view (slot-value window 'pressed-widget)) (live-input-widget-p view window)
        (not (modal-blocker window))
        (not (and (current-drag window) (eq (drag-state (current-drag window)) :dragging))))))
(defun update-text-selection (window &optional event)
 (let* ((state (slot-value window 'text-selection-state)) (view (first state)))
   (unless (valid-text-selection-p window)
     (cancel-text-selection window :forget-clicks t) (return-from update-text-selection nil))
   ;; Caret reveal can scroll after selecting a whole word/line. A stationary
   ;; release/move must keep that selection rather than hit-test different text.
   (when (and event (= (event-x event) (second state)) (= (event-y event) (third state)))
     (return-from update-text-selection t))
   (when event
     (setf (second state) (event-x event) (third state) (event-y event))
     (let ((click (slot-value window 'text-click-state)))
       (when (and click (not (near-pointer-click-p click (second state) (third state))))
         (setf (slot-value window 'text-click-state) nil))))
   (multiple-value-bind (left top right bottom) (selection-content-bounds view)
     (let* ((mode (fourth state)) (px (max left (min right (second state)))) (py (max top (min bottom (third state))))
            (position (if (eq mode :word) (text-word-point-position view px py) (text-point-position view px py)))
            (start (fifth state)) (end (sixth state)))
       (if (eq mode :character)
           (setf (slot-value view 'anchor) start (cursor view) position)
           (multiple-value-bind (a b)
               (if (eq mode :word) (index-word-range (display-index view) position)
                   (display-line-selection-range (display-index view) position))
             (if (< position start)
                 (setf (slot-value view 'anchor) end (cursor view) a)
                 (setf (slot-value view 'anchor) start (cursor view) (max end b)))))
       (setf (slot-value view 'last-cursor) (cursor view)))) t))
(defun selection-scroll-step (point low high seconds)
 (* (cond ((< point low) (- (min 800 (+ 120 (* 4 (- low point))))))
          ((> point high) (min 800 (+ 120 (* 4 (- point high))))) (t 0)) (min seconds 0.1)))
(defun advance-text-selection (window seconds)
 "Advance captured selection autoscroll by nonnegative SECONDS; native frames call this automatically. Return whether offsets changed."
 (check-type window window) (check-type seconds (real 0 *))
 (unless (valid-text-selection-p window)
   (cancel-text-selection window :forget-clicks t) (return-from advance-text-selection nil))
 (when (zerop seconds) (return-from advance-text-selection nil))
 (let* ((state (slot-value window 'text-selection-state)) (view (first state))
        (old-x (text-offset view)) (old-y (vertical-offset view)))
   (multiple-value-bind (left top right bottom) (selection-content-bounds view)
     (incf (text-offset view) (max (- old-x) (selection-scroll-step (second state) left right seconds)))
     (when (typep view 'text-view)
       (let ((limit (max 0 (- (text-content-height view)
                             (max 1 (- (height view) (* 2 (style-value view :padding))))))))
         (setf (vertical-offset view) (max 0 (min limit (+ old-y (selection-scroll-step (third state) top bottom seconds))))))))
   (when (and (= old-x (text-offset view)) (= old-y (vertical-offset view)))
     (return-from advance-text-selection nil))
   (update-text-selection window)
   ;; At the end of a short line the endpoint is already measured; clamp without
   ;; scanning an unmeasured long line merely to discover its full width.
   (multiple-value-bind (left top right bottom) (selection-content-bounds view)
     (let* ((position (text-point-position view (max left (min right (second state)))
                                               (max top (min bottom (third state)))))
            (end (nth-value 1 (text-row-range view position))))
       (when (= position end)
         (let* ((extent (+ (- (text-position-rectangle view end) (x view) (text-left-padding view))
                           (text-offset view)))
                (limit (max 0 (- (+ extent (style-value view :caret-width)) (text-content-width view)))))
           (setf (text-offset view) (min (text-offset view) limit))))))
   (update-text-selection window)
   (or (/= old-x (text-offset view)) (/= old-y (vertical-offset view)))))
