(in-package #:lut)
(defstruct event
 "Normalized input. KIND: :DOWN :MOVE :UP :WHEEL :KEY :TEXT :CONTEXT :GESTURE :OS-DROP. DROP-DATA holds adapter file-path strings for :OS-DROP. KEY: keyword. TEXT: string. X/Y/DELTA: real. SHIFT-P/CONTROL-P/ALT-P/SUPER-P: booleans; BASE-KEY is the key before shortcut aliases. TIMESTAMP is optional monotonic seconds; CLICK-COUNT optionally forces 1/2/3 on pointer down."
 kind drop-data (x 0) (y 0) key base-key (text "") (delta 0) shift-p control-p alt-p super-p timestamp click-count)
(defmethod (setf text) :around (new-text (entry entry))
 (if (and (slot-boundp entry 'view-buffer) (view-buffer entry))
     (set-buffer-view-text entry new-text)
     (let ((record (when (and *record-history* (slot-boundp entry 'text) (stringp new-text)
                             (not (string= new-text (text entry))))
                     (make-standalone-history-entry entry new-text))))
       (prog1 (call-next-method)
         (when (eq entry (first *standalone-selection-after*))
           (setf (cursor entry) (second *standalone-selection-after*)
                 (slot-value entry 'anchor) (third *standalone-selection-after*)))
         (when record
           (setf (buffer-history-entry-after-cursor record) (cursor entry)
                 (buffer-history-entry-after-anchor record) (slot-value entry 'anchor)
                 (undo-history entry) (bounded-buffer-history entry (cons record (undo-history entry)))
                 (redo-history entry) nil)
           (notify-history-overflow entry record :edit :undo))))))
(defun undo (entry)
 "Undo an entry or text buffer. All histories store ranges; shared views use their buffer. Return true when changed."
 (when (editable-p entry)
   (if (or (typep entry 'text-buffer) (view-buffer entry))
       (restore-buffer-history entry :undo) (restore-standalone-history entry :undo))))
(defun redo (entry)
 "Redo an entry or text buffer. Return true when changed."
 (when (editable-p entry)
   (if (or (typep entry 'text-buffer) (view-buffer entry))
       (restore-buffer-history entry :redo) (restore-standalone-history entry :redo))))
(defun selection (entry)
 "Return sorted start and end selection indices as two values."
 (values (min (cursor entry) (slot-value entry 'anchor))
         (max (cursor entry) (slot-value entry 'anchor))))
(defun select-all (entry)
 "Select all text."
 (setf (slot-value entry 'anchor) 0 (cursor entry) (text-length entry)) entry)
(defun selected-text (entry)
 "Return the selected substring."
 (multiple-value-bind (a b) (selection entry) (text-range entry a b)))
(defun replace-selection (entry string)
 "Replace selected text when editable and notify listeners. Shared views edit their buffer once."
 (when (editable-p entry)
   (multiple-value-bind (a b) (selection entry)
     (if (view-buffer entry)
         (replace-buffer-range (view-buffer entry) a b string :origin entry)
         (progn
           (let ((*standalone-selection-after* (list entry (+ a (length string)) (+ a (length string)))))
             (setf (text entry) (concatenate 'string (subseq (text entry) 0 a) string (subseq (text entry) b))))
           (emit entry :change (text entry)))))))
(defun focusable-p (w)
 (or (typep w 'notebook) (typep w 'expander) (typep w 'button) (typep w 'entry) (typep w 'list-view)
     (and (typep w 'slider) (not (typep w 'progress-bar)))))
(defun focus (window widget)
 "Set keyboard focus to an enabled visible interactive descendant or NIL."
 (when widget
   (unless (and (eq (root-of widget) window) (focusable-p widget)
                (in-input-scope-p widget (input-root window))
                (loop for p = widget then (parent p) while p always (and (visible-p p) (enabled-p p))))
     (error "Invalid focus target.")))
 (when (and (slot-value window 'text-selection-state)
            (not (eq widget (first (slot-value window 'text-selection-state)))))
   (cancel-text-selection window :forget-clicks t))
 (setf (focused-widget window) widget (focus-visible-p window) t))
(defun input-root (window) (or (find-if-not (lambda (d) (or (typep d 'tooltip) (nonmodal-overlay-p d))) (slot-value window 'overlays)) window))
(defgeneric overlay-input-scope-p (overlay scope))
(defmethod overlay-input-scope-p ((overlay widget) scope) (declare (ignore scope)) nil)
(defun in-input-scope-p (widget scope)
 (loop for node = widget then (parent node) while node
       thereis (or (eq node scope) (overlay-input-scope-p node scope))))
(defun input-hit-test (window px py)
 (or (loop for overlay in (slot-value window 'overlays)
           for hit = (and (nonmodal-overlay-p overlay) (in-input-scope-p overlay (input-root window))
                          (hit-test overlay px py)) when hit return hit)
     (hit-test (input-root window) px py)))
(defun tab-focus (window backwards)
 (let (nodes)
   (labels ((visit (w)
              (when (and (visible-p w) (enabled-p w))
                (when (focusable-p w) (push w nodes))
                (mapc #'visit (active-children w))))) (visit (input-root window)))
   (setf nodes (nreverse nodes))
   (when nodes
     (let ((pos (position (focused-widget window) nodes)))
       (focus window (nth (mod (if pos (+ pos (if backwards -1 1)) (if backwards -1 0))
                              (length nodes)) nodes))))))
(defun change-number (w number)
 (setf (value w) (max (minimum w) (min (maximum w) number)))
 (emit w :change (value w)))
(defun activate (w)
 (when (typep w 'radio-button)
   (dolist (peer (group w)) (unless (eq peer w) (setf (value peer) nil))))
 (when (typep w 'check-button)
   (setf (value w) (if (typep w 'radio-button) t (not (value w)))) (emit w :change (value w)))
 (emit w :activate))
(defgeneric display-text (widget) (:documentation "Return the visible string for a label/entry; override for masked or formatted controls."))
(defmethod display-text ((w label)) (text w))
(defgeneric text-width (widget string) (:documentation "Measure a full string using the active font backend."))
(defmethod text-width ((w widget) string) (* (length string) 0.6 (style-value w :font-size)))
(defun text-lines (string)
 (loop for start = 0 then (1+ end) for end = (position #\Newline string :start start)
       collect (list start (or end (length string))) while end))
(defun text-position (w e)
 (text-point-position w (event-x e) (event-y e)))
(defun handle-key (w e)
 (let ((key (event-key e)))
   (cond
    ((typep w 'entry)
     (let ((n (text-length w)))
       (case key
         (:undo (undo w)) (:redo (redo w))
         (:select-all (select-all w))
         (:copy (setf (clipboard-text w) (selected-text w)))
         (:cut (when (editable-p w) (setf (clipboard-text w) (selected-text w)) (replace-selection w "")))
         (:paste (when (editable-p w) (replace-selection w (clipboard-text w))))
         ((:left :right :home :end :up :down)
          (move-text-cursor w
            (case key
              (:left (cond ((event-super-p e) :line-start)
                           ((or (event-control-p e) (event-alt-p e)) :word-left) (t :left)))
              (:right (cond ((event-super-p e) :line-end)
                            ((or (event-control-p e) (event-alt-p e)) :word-right) (t :right)))
              (:home (if (or (event-control-p e) (event-super-p e)) :document-start :line-start))
              (:end (if (or (event-control-p e) (event-super-p e)) :document-end :line-end))
              (:up (if (event-super-p e) :document-start :up))
              (:down (if (event-super-p e) :document-end :down)))
            :extend (event-shift-p e)))
         ((:backspace :delete)
          (when (editable-p w)
           (when (= (cursor w) (slot-value w 'anchor))
            (setf (slot-value w 'anchor)
                  (if (eq key :backspace) (max 0 (1- (cursor w))) (min n (1+ (cursor w))))))
           (replace-selection w "")))
         (:enter (if (typep w 'text-view) (replace-selection w (string #\Newline)) (emit w :activate))))))
    ((typep w 'button) (when (member key '(:space :enter)) (activate w)))
    ((and (typep w 'slider) (not (typep w 'progress-bar)))
     (when (member key '(:left :right :up :down))
       (change-number w (+ (value w) (* (step w) (if (member key '(:left :down)) -1 1))))))
    ((typep w 'list-view)
     (when (and (items w) (member key '(:up :down)))
       (setf (value w) (max 0 (min (1- (length (items w)))
                                      (+ (or (value w) 0) (if (eq key :up) -1 1)))))
       (emit w :change (value w)))))))
(defun dispatch-base (window event)
 "Dispatch normalized input: :DOWN, :UP, :MOVE, :WHEEL, :KEY, :TEXT, :CONTEXT.
Callbacks receive (widget payload). Pointer capture supports text drag selection."
 (let* ((target (input-hit-test window (event-x event) (event-y event)))
        (focused (focused-widget window)))
   (when (and focused
              (not (and (eq (root-of focused) window)
                        (in-input-scope-p focused (input-root window))
                        (loop for p = focused then (parent p) while p
                              always (and (visible-p p) (enabled-p p))))))
     (setf (focused-widget window) nil focused nil))
   (case (event-kind event)
     (:down
      (setf (slot-value window 'pressed-widget) target)
      (when (and target (focusable-p target)) (focus window target) (setf (focus-visible-p window) (typep target 'entry)))
      (when (typep target 'entry) (begin-text-selection window target event))
      (when (and (typep target 'slider) (not (typep target 'progress-bar)))
        (change-number target (+ (minimum target) (* (- (maximum target) (minimum target))
                               (/ (- (event-x event) (x target)) (max 1 (width target))))))))
     (:move
      (when (slot-value window 'text-selection-state) (update-text-selection window event)))
     (:up
      (when (slot-value window 'text-selection-state)
        (update-text-selection window event) (cancel-text-selection window))
      (when (and target (eq target (slot-value window 'pressed-widget)))
        (cond ((typep target 'button) (activate target))
              ((typep target 'list-view)
               (let ((index (floor (+ (- (event-y event) (y target)) (scroll-offset target)) (row-height target))))
                 (when (< -1 index (length (items target)))
                   (setf (value target) index) (emit target :change index))))))
      (setf (slot-value window 'pressed-widget) nil))
     (:wheel
      (loop for node = target then (parent node) while node
        when (or (typep node 'scroll-view) (typep node 'list-view))
          do (let ((range (if (typep node 'list-view)
                              (max 0 (- (* (row-height node) (length (items node))) (height node)))
                              (scroll-range node))))
               (setf (scroll-offset node) (max 0 (min range
                   (- (scroll-offset node) (* (row-height node) (event-delta event)))))))
             (return)
        when (and (typep node 'slider) (not (typep node 'progress-bar)))
          do (change-number node (+ (value node) (* (step node) (event-delta event)))) (return)))
     (:context (when target (emit target :context event)))
     (:key (cond ((eq (event-key event) :tab) (tab-focus window (event-shift-p event)))
                 ((eq (event-key event) :escape) (close-dialog window))
                 (focused (handle-key focused event))))
     (:text (when (typep focused 'entry)
              (replace-selection focused
                (if (typep focused 'text-view) (event-text event)
                    (remove #\Newline (remove #\Return (event-text event))))))))
   target))
(defmethod (setf text) :after (new-text (w entry))
 ;; Live edits to TEXT preserve valid selection indices and stop stale gestures.
 (cancel-view-text-selection w)
 (setf (cursor w) (min (cursor w) (length new-text))
       (slot-value w 'anchor) (min (slot-value w 'anchor) (length new-text))))

(defmethod validate-slot ((w entry) slot v)
 (when (and (eq slot 'cursor) (slot-boundp w 'text) (> v (text-length w)))
   (error "Caret index exceeds text length.")) v)

(defmethod (setf cursor) :after (position (view entry))
 (declare (ignore position))
 (setf (slot-value view 'navigation-x) nil))
