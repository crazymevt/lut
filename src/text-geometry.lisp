(in-package #:lut)
(defvar *text-caret-affinity* t)
;; Geometry describes unwrapped logical lines in root coordinates. Each cache
;; increment measures a bounded run, never a full-buffer or full-line string.
(defgeneric text-character-advance (view character))
(defmethod text-character-advance ((view widget) character)
 (if (char= character #\Tab) (* (style-value view :tab-size 4) (text-width view " "))
     (text-width view (string character))))
(defgeneric map-text-run-advances (view string function))
(defmethod map-text-run-advances ((view widget) string function)
 (loop for c across string do (funcall function (text-character-advance view c))))
(defgeneric text-left-padding (view))
(defmethod text-left-padding ((view widget)) (style-value view :padding))
(defgeneric map-text-range-advances (view string start function))
(defmethod map-text-range-advances ((view widget) string start function)
 (declare (ignore start)) (map-text-run-advances view string function))
(defgeneric text-metric-spacing (view))
(defmethod text-metric-spacing ((view widget)) 0)
(defgeneric text-metric-key (view)
 (:documentation "Return an EQUAL-comparable key for VIEW's effective text measurements. Applications may use it to key derived geometry caches. Specializations must include inherited key data and all measurement-affecting state."))
(defmethod text-metric-key ((view widget))
 (list (style-value view :tab-size 4) (style-value view :font) (style-value view :font-size) (style-value view :font-spacing)
       (compute-applicable-methods #'text-character-advance (list view #\a))
       (compute-applicable-methods #'text-width (list view ""))))
(defstruct line-metrics root key line start end
 (advances (make-array 1 :adjustable t :fill-pointer 1 :initial-element 0)))
(defun display-index (view)
 ;; Ordinary views never request the compatibility full-string getter.
 (if (equal (compute-applicable-methods #'display-text (list view))
            (list (find-method #'display-text nil (list (find-class 'label)))))
     (target-text-index view)
     (let* ((string (display-text view)) (cache (slot-value view 'geometry-cache))
            (hit (find-if (lambda (entry) (and (consp entry) (eq (first entry) :display)
                                             (equal (second entry) string))) cache)))
       (if hit (third hit)
           (let ((root (index-string string)))
             (setf (slot-value view 'geometry-cache) (list (list :display (copy-seq string) root))) root)))))
(defun index-line-range (root line)
 (values (if (zerop line) 0 (1+ (index-newline root (1- line))))
         (if (= line (node-lines root)) (node-size root) (index-newline root line))))
(defun view-line-metrics (view root line)
 (let* ((key (text-metric-key view)) (cache (slot-value view 'geometry-cache))
        (retained (remove-if-not
          (lambda (m) (or (and (consp m) (eq (first m) :display))
                          (and (line-metrics-p m) (eq root (line-metrics-root m))
                               (equal key (line-metrics-key m))))) cache))
        (hit (find-if (lambda (m) (and (line-metrics-p m) (= line (line-metrics-line m)))) retained)))
   (or hit
       (multiple-value-bind (start end) (index-line-range root line)
         (let ((metrics (make-line-metrics :root root :key key :line line :start start :end end)))
           (setf (slot-value view 'geometry-cache)
                 (cons metrics (subseq retained 0 (min 7 (length retained))))) metrics)))))
(defun extend-line-metrics (view metrics &key column pixel)
 (let* ((advances (line-metrics-advances metrics))
        (size (- (line-metrics-end metrics) (line-metrics-start metrics))))
   (loop while (and (<= (length advances) size)
                    (if column (<= (length advances) column) (<= (metric-caret-width view advances (1- (length advances))) pixel)))
         for from = (1- (length advances)) for to = (min size (+ from 256))
         for string = (index-substring (line-metrics-root metrics)
                         (+ (line-metrics-start metrics) from) (+ (line-metrics-start metrics) to))
         do (map-text-range-advances view string (+ (line-metrics-start metrics) from)
              (lambda (advance)
                (vector-push-extend (+ (aref advances (1- (length advances)))
                                      (max 0 advance)) advances)))) advances))
(defun metric-caret-width (view advances column)
 (- (aref advances column) (if (plusp column) (text-metric-spacing view) 0)))
(defun line-column-at-pixel (view metrics pixel)
 (let* ((advances (extend-line-metrics view metrics :pixel pixel)) (lo 0) (hi (1- (length advances))))
   (loop while (< lo hi) for mid = (floor (+ lo hi) 2)
         do (if (< pixel (/ (+ (metric-caret-width view advances mid) (metric-caret-width view advances (1+ mid))) 2))
                (setf hi mid) (setf lo (1+ mid)))) lo))
(defun single-line-entry-p (view)
 (and (typep view 'entry) (not (typep view 'text-view))))
(defun text-line-box-height (view)
 (if (single-line-entry-p view) (style-value view :font-size) (line-height view)))
(defun text-top-inset (view)
 (if (single-line-entry-p view)
     (max 0 (/ (- (height view) (text-line-box-height view)) 2))
     (style-value view :padding)))
(defgeneric text-position-rectangle (view position))
(defmethod text-position-rectangle ((view entry) position)
 "Return caret X, Y, WIDTH, HEIGHT in root pixels for a display character position. No wrapping/shaping."
 (check-type view entry)
 (let ((root (display-index view)))
   (unless (and (integerp position) (<= 0 position (node-size root))) (error "Invalid display text position."))
   (let* ((line (index-position-line root position))
          (metrics (view-line-metrics view root line)) (column (- position (line-metrics-start metrics)))
          (advances (extend-line-metrics view metrics :column column))
          (top (text-top-inset view)) (lh (text-line-box-height view)))
     (values (- (+ (x view) (text-left-padding view) (metric-caret-width view advances column)) (text-offset view))
             (- (+ (y view) top (* line lh)) (if (single-line-entry-p view) 0 (vertical-offset view)))
             (style-value view :caret-width) lh))))
(defgeneric text-point-position (view px py))
(defmethod text-point-position ((view entry) px py)
 "Return nearest display character insertion position at root coordinates PX/PY; clamp outside text."
 (check-type view entry) (check-type px real) (check-type py real)
 (let* ((root (display-index view)) (pad (style-value view :padding))
        (line (if (typep view 'text-view)
                  (max 0 (min (node-lines root) (floor (+ (- py (y view) pad) (vertical-offset view)) (line-height view)))) 0))
        (metrics (view-line-metrics view root line)))
   (+ (line-metrics-start metrics)
      (line-column-at-pixel view metrics (+ (- px (x view) (text-left-padding view)) (text-offset view))))))
(defgeneric map-visible-text-lines (view function))
(defmethod map-visible-text-lines ((view label) function)
 "Call FUNCTION with (LINE START END X Y) for vertically visible logical lines. END excludes newline; no text copies. Return count."
 (check-type view label)
 (let* ((root (display-index view)) (pad (text-top-inset view)) (lh (text-line-box-height view))
        (entry-p (typep view 'entry))
        (offset (if (and entry-p (not (single-line-entry-p view))) (vertical-offset view) 0))
        (available (max 0 (- (height view) (* 2 pad))))
        (first (max 0 (floor offset lh)))
        (limit (min (1+ (node-lines root)) (ceiling (+ offset available) lh))) (count 0))
   (when (plusp available)
     (loop for line from first below limit do
       (multiple-value-bind (start end) (index-line-range root line)
         (funcall function line start end
                  (- (+ (x view) (text-left-padding view)) (if entry-p (text-offset view) 0))
                  (- (+ (y view) pad (* line lh)) offset)) (incf count)))) count))
(defgeneric visible-line-fragment (view root line))
(defmethod visible-line-fragment ((view label) root line)
 ;; Include the glyph crossing each horizontal viewport boundary.
 (let* ((metrics (view-line-metrics view root line))
        (left (if (typep view 'entry) (text-offset view) 0))
        (right (+ left (max 0 (- (width view) (text-left-padding view) (style-value view :padding)))))
        (a (max 0 (1- (line-column-at-pixel view metrics left))))
        (b (min (- (line-metrics-end metrics) (line-metrics-start metrics))
                (1+ (line-column-at-pixel view metrics right)))))
   (values (+ (line-metrics-start metrics) a) (+ (line-metrics-start metrics) b)
           (aref (line-metrics-advances metrics) a))))
(defun invalidate-text-geometry (view)
 "Clear VIEW's measured line caches after application-defined font/measurement state changes. Return VIEW."
 (check-type view label) (ensure-live view)
 (setf (slot-value view 'geometry-cache) nil) view)
(defmethod dispose :after ((view label))
 (setf (slot-value view 'text-root) nil (slot-value view 'indexed-string) nil
       (slot-value view 'geometry-cache) nil))

(defgeneric text-content-height (view))
(defmethod text-content-height ((view text-view))
 (* (text-line-count view) (line-height view)))
(defgeneric text-row-range (view position))
(defmethod text-row-range ((view entry) position)
 (index-line-range (display-index view) (index-position-line (display-index view) position)))
(defgeneric text-range-width (view start end))
(defmethod text-range-width ((view entry) start end)
 (- (text-position-rectangle view end) (text-position-rectangle view start)))

(defgeneric text-vertical-position (view position goal direction))
(defmethod text-vertical-position ((view entry) position goal direction)
 (let* ((root (display-index view))
        (row (max 0 (min (node-lines root) (+ (index-position-line root position) direction)))))
   (text-point-position view
     (- (+ (x view) (text-left-padding view) goal) (text-offset view))
     (- (+ (y view) (style-value view :padding) (* row (line-height view)) (/ (line-height view) 2))
        (vertical-offset view)))))
(defgeneric finish-text-navigation (view movement))
(defmethod finish-text-navigation ((view entry) movement) (declare (ignore movement)))
