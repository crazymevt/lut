(in-package #:lut)
(defun native-window-remote (window)
 (bt:with-lock-held (*remote-lock*)
   (find-if (lambda (remote) (and (eq window (remote-window-root remote))
                 (remote-window-alive-p remote) (not (remote-window-closing-p remote)))) *remote-windows*)))
(defmethod native-window-state-available-p ((window window))
 (not (null (or (and (eq window *active-window*) (rl:is-window-ready)) (native-window-remote window)))))
(defun sync-native-window-state (window)
 (let* ((mode (if (rl:is-window-maximized) :maximized :normal))
        (previous (native-window-mode window)))
   (when (and (eq previous :maximized) (eq mode :normal) (null (native-state-pending window)))
     (setf (native-state-settle-frames window) 3))
   (setf (native-window-mode window) mode)
   (cond ((plusp (native-state-settle-frames window)) (decf (native-state-settle-frames window)))
         ((and (eq mode :normal) (not (rl:is-window-minimized))
               (or (null (native-state-pending window)) (eq (native-state-pending window) :normal)))
          (let ((width (/ (rl:get-screen-width) (ui-scale window))) (height (/ (rl:get-screen-height) (ui-scale window))))
            (when (and (plusp width) (plusp height))
              (setf (native-normal-width window) width (native-normal-height window) height)))))
   (when (and (zerop (native-state-settle-frames window)) (eq mode (native-state-pending window)))
     (setf (native-state-pending window) nil))) window)
(defun perform-native-window-operation (window operation value generation)
 (setf (native-operation-generation window) generation)
 (ecase operation
   (:normal-size
     (setf (native-normal-width window) (first value) (native-normal-height window) (second value))
     (unless (rl:is-window-maximized)
       (rl:set-window-size (max 1 (round (* (first value) (ui-scale window))))
                           (max 1 (round (* (second value) (ui-scale window)))))
       (setf (native-state-settle-frames window) 3 (native-state-pending window) :normal)))
   (:state
     (when (and (eq value :maximized) (eq (native-window-mode window) :normal))
       (sync-native-window-state window))
     (setf (native-state-pending window) value (native-state-settle-frames window) 3)
     (ecase value
       (:maximized (rl:maximize-window))
       (:normal
         (rl:restore-window)
         (multiple-value-bind (width height) (normal-window-size window)
           (rl:set-window-size (max 1 (round (* width (ui-scale window)))) (max 1 (round (* height (ui-scale window)))))))))) window)
(defmethod request-native-window-operation ((window window) operation value)
 (let ((generation (incf (native-operation-generation window))) (remote (native-window-remote window)))
   (cond ((and (eq window *active-window*) (rl:is-window-ready))
          (perform-native-window-operation window operation value generation))
         (remote
          (evaluate-in-window remote
            (list (list 'perform-native-window-operation '*active-window* operation (list 'quote value) generation))))
         (t (error 'unsupported-capability :capability :native-window-state)))))
(defun native-window-report (window)
 (multiple-value-bind (width height) (normal-window-size window)
   (list (native-operation-generation window) (native-window-mode window) width height)))
(defun accept-native-window-report (window report)
 (when (and (listp report) (= (length report) 4) (typep (first report) '(integer 0 *))
            (member (second report) '(:normal :maximized))
            (typep (third report) '(real (0) *)) (typep (fourth report) '(real (0) *))
            (>= (first report) (native-operation-generation window)))
   (setf (native-operation-generation window) (first report) (native-window-mode window) (second report)
         (native-normal-width window) (third report) (native-normal-height window) (fourth report)) t))
