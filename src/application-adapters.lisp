(in-package #:lut)

(defvar *default-application-command* :auto
 "Default-application argv prefix: :AUTO uses macOS open or xdg-open; NIL disables launching; a nonempty string list configures a portable fallback. No shell is used.")
(define-condition target-launch-error (error)
 ((target :initarg :target :reader launch-error-target)
  (reason :initarg :reason :reader launch-error-reason)
  (detail :initarg :detail :initform nil :reader launch-error-detail)
  (exit-code :initarg :exit-code :initform nil :reader launch-error-exit-code))
 (:report (lambda (condition stream)
   (format stream "Could not launch ~s (~a): ~a" (launch-error-target condition)
           (launch-error-reason condition) (or (launch-error-detail condition) "no launcher available")))))
(defun launcher-program (name)
 (loop for directory in (uiop:split-string (or (uiop:getenv "PATH") "") :separator (if (uiop:os-windows-p) '(#\;) '(#\:)))
       for path = (merge-pathnames name (uiop:ensure-directory-pathname (if (equal directory "") "." directory)))
       when (probe-file path) return (namestring (truename path))))
(defun default-application-capabilities ()
 "Return fresh :AVAILABLE-P/:BACKEND/:NATIVE-P/:COMMAND records for explicit launching. Availability does not guarantee a registered target handler."
 (let* ((preference *default-application-command*)
        (command (cond ((null preference) nil)
                       ((eq preference :auto)
                        #+darwin (when (probe-file #p"/usr/bin/open") (list "/usr/bin/open" "--"))
                        #-darwin (unless (uiop:os-windows-p)
                                   (let ((program (launcher-program "xdg-open"))) (when program (list program)))))
                       ((and (listp preference) preference (every #'stringp preference))
                        (let ((program (launcher-program (first preference))))
                          (when program (cons program (rest preference)))))
                       (t (error "Default application command must be :AUTO, NIL or a nonempty list of strings.")))))
   (list :available-p (not (null command)) :backend (cond ((null command) :unavailable)
                  ((not (eq preference :auto)) :configured) (t #+darwin :macos-open #-darwin :xdg-open))
         :native-p (and (eq preference :auto) (not (null command)) #+darwin t #-darwin nil)
         :command (mapcar #'copy-seq command))))
(defvar *launch-program-function*
 (lambda (command) (uiop:run-program command :output :string :error-output :string :ignore-error-status t)))
(defun launch-application-target (target)
 (let* ((capabilities (default-application-capabilities)) (backend (getf capabilities :backend)))
   (unless (getf capabilities :available-p)
     (error 'target-launch-error :target target :reason :unavailable))
   (handler-case
       (multiple-value-bind (output errors status)
           (funcall *launch-program-function* (append (getf capabilities :command) (list target)))
         (declare (ignore output))
         (unless (eql status 0)
           (error 'target-launch-error :target target :reason :nonzero-exit :exit-code status :detail errors))
         (values t backend))
     (target-launch-error (condition) (error condition))
     (error (condition) (error 'target-launch-error :target target :reason :process-error :detail (princ-to-string condition))))))
(defun launch-uri (uri)
 "Explicitly ask the default application to handle absolute URI. Return T and backend on successful submission; signal TARGET-LAUNCH-ERROR on failure."
 (check-type uri string)
 (let ((colon (position #\: uri)))
   (unless (and colon (plusp colon) (find (char uri 0) "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ")
                (every (lambda (c) (find c "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+-.")) (subseq uri 0 colon))
                (notany (lambda (c) (or (<= (char-code c) 32) (= (char-code c) 127))) uri))
     (error 'target-launch-error :target uri :reason :invalid-target :detail "Expected an absolute URI without whitespace/control characters.")))
 (launch-application-target uri))
(defun launch-file (path)
 "Explicitly open an existing file/directory using its default application. No shell or file creation. Return T and backend; signal TARGET-LAUNCH-ERROR on failure."
 (let ((canonical (handler-case (truename path) (error () nil))))
   (unless canonical (error 'target-launch-error :target path :reason :invalid-target :detail "File or directory does not exist."))
   (launch-application-target (namestring canonical))))

(defgeneric native-window-state-available-p (window))
(defmethod native-window-state-available-p ((window widget)) nil)
(defgeneric request-native-window-operation (window operation value))
(defmethod request-native-window-operation ((window widget) operation value)
 (declare (ignore operation value)) (error 'unsupported-capability :capability :native-window-state))
(defun window-state (window)
 "Return last observed :NORMAL/:MAXIMIZED and availability boolean. Before a native context/report, return :UNAVAILABLE. Worker observations are asynchronous."
 (check-type window window) (ensure-live window)
 (if (native-window-state-available-p window) (values (native-window-mode window) t) (values :unavailable nil)))
(defun normal-window-size (window)
 "Return saved logical normal width/height, independent of allocated geometry. Before a normal size is recorded/configured, use current WIDTH/HEIGHT."
 (check-type window window) (ensure-live window)
 (values (or (native-normal-width window) (width window))
         (or (native-normal-height window) (height window))))
(defun set-normal-window-size (window width height)
 "Set positive normal logical dimensions. Configure before opening; resize an active normal window, or retain for restore while maximized. Return WINDOW."
 (check-type window window) (ensure-live window)
 (check-type width (real (0) *)) (check-type height (real (0) *))
 (setf (native-normal-width window) width (native-normal-height window) height)
 (when (native-window-state-available-p window) (request-native-window-operation window :normal-size (list width height))) window)
(defun set-window-state (window state)
 "Request :NORMAL or :MAXIMIZED on an active native window/worker. Completion is asynchronous; query WINDOW-STATE. Return WINDOW."
 (check-type window window) (ensure-live window)
 (unless (member state '(:normal :maximized)) (error "Window state must be :NORMAL or :MAXIMIZED."))
 (unless (native-window-state-available-p window) (error 'unsupported-capability :capability :native-window-state))
 (request-native-window-operation window :state state) window)
