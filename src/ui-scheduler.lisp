(in-package #:lut)

;; All deadlines use monotonic seconds. No scheduler thread and no idle cadence.
(defvar *scheduler-lock* (bt:make-lock "LUT deadlines and native wake lifetime"))
(defvar *ui-wake-function* nil)
(defvar *ui-timers* nil)
(defvar *ui-services* nil)
(defvar *scheduler-clock* (lambda () (/ (get-internal-real-time) internal-time-units-per-second)))
(defstruct ui-timer deadline function owner interval (active-p t))
(defstruct ui-service function deadline owner (active-p t))
(defun scheduler-now () (funcall *scheduler-clock*))
(defun wake-ui ()
  ;; Holding this lock also prevents a publisher calling native GLFW after the
  ;; controller has disabled the hook and destroyed its window/context.
  (bt:with-lock-held (*scheduler-lock*)
    (when *ui-wake-function* (funcall *ui-wake-function*))))
(defun install-ui-wake (function)
  (bt:with-lock-held (*scheduler-lock*) (setf *ui-wake-function* function)))
(defun clear-ui-timer (timer)
  (setf (ui-timer-active-p timer) nil (ui-timer-function timer) nil (ui-timer-owner timer) nil))
(defun schedule-ui (delay function &key owner interval)
  "Run FUNCTION on the GUI thread after DELAY monotonic seconds. INTERVAL repeats
with missed periods coalesced. OWNER disposal cancels and releases the closure.
Return a handle for CANCEL-UI-TIMER. Publication wakes a sleeping native loop."
  (check-type delay (real 0 *)) (check-type function function)
  (when interval (check-type interval (real (0) *)))
  (when owner (ensure-live owner))
  (let ((timer (make-ui-timer :deadline (+ (scheduler-now) delay)
                             :function function :owner owner :interval interval)))
    (bt:with-lock-held (*scheduler-lock*)
      (when owner (ensure-live owner)) (push timer *ui-timers*))
    (wake-ui) timer))
(defun cancel-ui-timer (timer)
  (bt:with-lock-held (*scheduler-lock*)
    (clear-ui-timer timer) (setf *ui-timers* (delete timer *ui-timers*)))
  (wake-ui) timer)
(defun register-ui-service (function deadline &key owner)
  "Register a native service. DEADLINE returns seconds until work, or NIL to sleep
indefinitely. FUNCTION runs when due on the GUI thread. Native publishers must
call WAKE-UI (or the backend's C wake entry point) on an earlier deadline."
  (check-type function function) (check-type deadline function)
  (when owner (ensure-live owner))
  (let ((service (make-ui-service :function function :deadline deadline :owner owner)))
    (bt:with-lock-held (*scheduler-lock*)
      (when owner (ensure-live owner)) (push service *ui-services*))
    (wake-ui) service))
(defun cancel-ui-service (service)
  (bt:with-lock-held (*scheduler-lock*)
    (setf (ui-service-active-p service) nil (ui-service-function service) nil
          (ui-service-deadline service) nil (ui-service-owner service) nil
          *ui-services* (delete service *ui-services*)))
  (wake-ui) service)
(defun cancel-owner-deadlines (owner)
  (bt:with-lock-held (*scheduler-lock*)
    (dolist (timer *ui-timers*)
      (when (eq owner (ui-timer-owner timer)) (clear-ui-timer timer)))
    (setf *ui-timers* (delete-if-not #'ui-timer-active-p *ui-timers*))
    (dolist (service (copy-list *ui-services*))
      (when (eq owner (ui-service-owner service))
        (setf (ui-service-active-p service) nil (ui-service-function service) nil
              (ui-service-deadline service) nil (ui-service-owner service) nil)
        (setf *ui-services* (delete service *ui-services*))))))
(defun run-ui-deadlines ()
  (let ((now (scheduler-now)))
    ;; Snapshot due work. New immediate work is handled on the next controller
    ;; turn, so a callback rescheduling itself cannot starve native input.
    (dolist (timer (bt:with-lock-held (*scheduler-lock*)
                     (remove-if-not (lambda (timer) (<= (ui-timer-deadline timer) now))
                                    (copy-list *ui-timers*))))
      (let ((function
              (bt:with-lock-held (*scheduler-lock*)
                (when (ui-timer-active-p timer)
                  (let ((function (ui-timer-function timer)) (owner (ui-timer-owner timer)))
                    (cond ((and owner (disposed-p owner))
                           (clear-ui-timer timer) (setf *ui-timers* (delete timer *ui-timers*)) nil)
                          ((ui-timer-interval timer)
                           (setf (ui-timer-deadline timer) (+ now (ui-timer-interval timer))) function)
                          (t (clear-ui-timer timer)
                             (setf *ui-timers* (delete timer *ui-timers*)) function)))))))
        (when function (funcall function))))
    (dolist (entry (ui-service-snapshot))
      (destructuring-bind (function deadline owner) entry
        (when (or (null owner) (not (disposed-p owner)))
          (let ((delay (funcall deadline)))
            (when (and delay (<= delay 0)) (funcall function))))))))
(defun ui-service-snapshot ()
  ;; Take strong local callback references under the cancellation lock. Once
  ;; captured a service invocation may finish, just like an executing UI job.
  (bt:with-lock-held (*scheduler-lock*)
    (loop for service in *ui-services* when (ui-service-active-p service)
          collect (list (ui-service-function service) (ui-service-deadline service) (ui-service-owner service)))))
(defun next-ui-delay ()
  (let ((now (scheduler-now)) (delay nil))
    (flet ((include-delay (value)
             (when value (setf delay (if delay (min delay (max 0 value)) (max 0 value))))))
      (bt:with-lock-held (*scheduler-lock*)
        (dolist (timer *ui-timers*) (include-delay (- (ui-timer-deadline timer) now))))
      (dolist (entry (ui-service-snapshot))
        (destructuring-bind (function deadline owner) entry
          (declare (ignore function))
          (when (or (null owner) (not (disposed-p owner)))
            (include-delay (funcall deadline))))))
    delay))

(defvar *ui-lock*)
(defvar *ui-queue*)
(defvar *remote-windows*)
(defvar *event-backend-p* nil)
(defvar *native-damage-p* nil)
(defvar *controller-cache-key* nil)
(defvar *controller-pointer-key* nil)
(defun native-event-backend-p ()
  (when (equal "0" (uiop:getenv "LUT_EVENT_LOOP")) (return-from native-event-backend-p nil))
  (let ((version (cffi:foreign-symbol-pointer "LUTEventBridgeVersion")))
    (when (and version (not (cffi:null-pointer-p version)))
      (unless (= 1 (cffi:foreign-funcall-pointer version () :int))
        (error "Unsupported LUT event bridge ABI."))
      (dolist (name '("LUTSetManualEvents" "LUTWakeEvents" "LUTWaitEvents" "LUTConsumeDamage"))
        (unless (cffi:foreign-symbol-pointer name) (error "Incomplete LUT event bridge: ~A" name)))
      t)))
(defun native-event-call (name &optional value)
  (if value (cffi:foreign-funcall-pointer (cffi:foreign-symbol-pointer name) () :int value :void)
      (cffi:foreign-funcall-pointer (cffi:foreign-symbol-pointer name) () :int)))
(defun controller-cache-key (root)
  (list (layout-revision root) (slot-value root 'damage-revision) (render-revision root) (focused-widget root)
        (focus-visible-p root) (rl:is-window-focused) (rl:get-screen-width) (rl:get-screen-height)))
(defun legacy-tick-delay (root)
  (let ((delays (loop for connection in (slot-value root 'handlers)
                      when (and (connection-active-p connection)
                                (eq :tick (connection-event connection)) (connection-interval connection))
                      collect (connection-interval connection))))
    (when delays (reduce #'min delays))))
(defun context-menu-delay (root)
  ;; Only live overlays are inspected; no periodic tree traversal. A stationary
  ;; submenu grace transition needs one wake even without another mouse event.
  (let ((now (scheduler-now)) (delay nil))
    (dolist (overlay (slot-value root 'overlays))
      (when (typep overlay 'context-menu)
        (let ((pending (hover-pending overlay)))
          (when pending
            (let ((remaining (max 0 (- (+ (second pending) (coerce 0.2 'double-float)) now))))
              (setf delay (if delay (min delay remaining) remaining)))))))
    delay))
(defun controller-wait (root)
  (let ((delay (next-ui-delay)))
    (flet ((include-delay (value)
             (when value (setf delay (if delay (min delay value) value)))))
      (include-delay (legacy-tick-delay root))
      (include-delay (context-menu-delay root))
      (when (or *frame-limit-p* (plusp (native-state-settle-frames root))) (include-delay (/ 1.0d0 60)))
      (when (or (not (cache-enabled-p root)) (slot-value root 'pressed-widget) (current-drag root) (slot-value root 'text-selection-state)
                (and (boundp '*remote-windows*) *remote-windows*)
                (and (fboundp 'window-has-dynamic-content-p) (window-has-dynamic-content-p root)))
        (include-delay (/ 1.0d0 60)))
      (when (bt:with-lock-held (*ui-lock*) *ui-queue*) (include-delay 0))
      (when (or rl::*stop-requested* (disposed-p root)) (include-delay 0)))
    (incf *native-waits*)
    (cffi:foreign-funcall "LUTWaitEvents" :double (coerce (or delay -1) 'double-float) :void)))

(defun clear-ui-deadlines ()
  (bt:with-lock-held (*scheduler-lock*)
    (mapc #'clear-ui-timer *ui-timers*)
    (setf *ui-timers* nil)
    (dolist (service *ui-services*)
      (setf (ui-service-active-p service) nil (ui-service-function service) nil
            (ui-service-deadline service) nil (ui-service-owner service) nil))
    (setf *ui-services* nil)))
