(in-package #:lut)

(defclass picker-calendar-popup (popover)
 ((navigate :initform nil :accessor calendar-navigate)))
(defmethod dispose :after ((popup picker-calendar-popup)) (setf (calendar-navigate popup) nil))
(defmethod handle-event ((day calendar-day-button) event)
 (when (eq (event-kind event) :key)
   (let ((delta (case (event-key event) (:left -1) (:right 1) (:up -7) (:down 7))))
     (when delta
       (funcall (calendar-navigate (parent (parent day))) (parse-integer (text day)) delta)
       t))))
(defmethod surface-closed ((popup picker-calendar-popup))
 (let ((owner (popup-owner popup)))
   (call-next-method)
   (when owner
     (setf (picker-popup owner) nil (popup-owner popup) nil)
     (let ((root (root-of owner)))
       (when (and (typep root 'window) (live-input-widget-p owner root)) (focus root owner))))
   (dispose popup)))
(defmethod dispose :after ((w date-picker))
 (when (picker-popup w)
   (let ((popup (picker-popup w)))
     (setf (picker-popup w) nil)
     (dismiss-dialog popup) (dispose popup))))

(defun picker-month-days (year month)
 (if (= month 2)
     (if (and (zerop (mod year 4)) (or (not (zerop (mod year 100))) (zerop (mod year 400)))) 29 28)
     (nth (1- month) '(31 28 31 30 31 30 31 31 30 31 30 31))))
(defmethod validate-slot ((w date-picker) slot v)
 (when (and (eq slot 'picker-field) (= v 3)
            (not (and (typep w 'time-picker) (slot-boundp w 'time-format) (eq (time-format w) :12-hour))))
   (error "AM/PM field is available only in 12-hour time mode."))
 (if (eq slot 'calendar-date)
     (unless (and (= (length v) 3) (every #'integerp v)
                  (<= 1 (first v) 9999) (<= 1 (second v) 12)
                  (<= 1 (third v) (picker-month-days (first v) (second v))))
       (error "Expected Gregorian (year month day), year 1..9999."))
     (call-next-method)) v)
(defmethod validate-slot ((w time-picker) slot v)
 (if (eq slot 'clock-time)
     (unless (and (= (length v) 3) (every #'integerp v)
                  (<= 0 (first v) 23) (<= 0 (second v) 59) (<= 0 (third v) 59))
       (error "Expected 24-hour (hour minute second)."))
     (call-next-method)) v)
(defmethod calendar-date :around ((w date-picker)) (copy-list (call-next-method)))
(defmethod (setf calendar-date) :around (v (w date-picker)) (call-next-method (copy-list v) w))
(defmethod clock-time :around ((w time-picker)) (copy-list (call-next-method)))
(defmethod (setf clock-time) :around (v (w time-picker)) (call-next-method (copy-list v) w))
(defun picker-value (w) (if (typep w 'time-picker) (clock-time w) (calendar-date w)))
(defun picker-publish (w v)
 (unless (equal v (picker-value w))
   (if (typep w 'time-picker) (setf (clock-time w) v) (setf (calendar-date w) v))
   (emit w :change (copy-list v))))
(defun picker-set-field (w number)
 (let* ((v (picker-value w)) (field (picker-field w))
        (timep (typep w 'time-picker))
        (low (if timep 0 1))
        (high (if timep (if (zerop field) 23 59)
                  (case field (0 9999) (1 12) (2 (picker-month-days (first v) (second v)))))))
   (when (<= low number high)
     (setf (nth field v) number)
     (unless timep (setf (third v) (min (third v) (picker-month-days (first v) (second v)))))
     (picker-publish w v))))
(defun picker-twelve-hour-p (w)
 (and (typep w 'time-picker) (eq (time-format w) :12-hour)))
(defmethod (setf time-format) :after (format (w time-picker))
 (setf (picker-digits w) "")
 (when (and (eq format :24-hour) (= (picker-field w) 3)) (setf (picker-field w) 0)))
(defun picker-toggle-period (w)
 (let ((v (clock-time w)))
   (setf (first v) (mod (+ (first v) 12) 24)) (picker-publish w v)))
(defun picker-step (w delta)
 (let ((v (picker-value w)) (field (picker-field w)))
   (setf (picker-digits w) "")
   (if (typep w 'time-picker)
       (if (= field 3) (picker-toggle-period w)
           (picker-set-field w (mod (+ (nth field v) delta) (if (zerop field) 24 60))))
       (if (= field 2)
           (destructuring-bind (year month day) v
             (incf day delta)
             (cond ((< day 1) (decf month) (when (< month 1) (setf month 12) (decf year))
                              (when (plusp year) (setf day (picker-month-days year month))))
                   ((> day (picker-month-days year month)) (setf day 1) (incf month)
                    (when (> month 12) (setf month 1) (incf year))))
             (when (<= 1 year 9999) (picker-publish w (list year month day))))
           (picker-set-field w (+ (nth field v) delta))))))
(defun picker-field-string (w field)
 (format nil "~v,'0d" (if (and (not (typep w 'time-picker)) (zerop field)) 4 2)
         (let ((number (nth field (picker-value w))))
           (if (and (picker-twelve-hour-p w) (zerop field)) (1+ (mod (1- number) 12)) number))))
(defun picker-actions-width (w)
 (if (typep w 'time-picker) (if (picker-twelve-hour-p w) 92 48) 72))
(defun picker-field-width (w) (/ (max 0 (- (width w) (picker-actions-width w))) 3))
(defun picker-region-at (w px py)
 (when (contains-point-p w px py)
   (let* ((relative (- px (x w))) (fw (picker-field-width w)) (controls (* 3 fw)))
     (cond ((< relative controls) (min 2 (floor relative (max 1 fw))))
           ((< relative (+ controls 24)) :minus)
           ((< relative (+ controls 48)) :plus)
           ((picker-twelve-hour-p w) :period)
           ((not (typep w 'time-picker)) :calendar)))))
(defmethod measure ((w date-picker) axis &optional for-size)
 (declare (ignore for-size))
 (let ((size (if (eq axis :horizontal)
                 (+ (picker-actions-width w)
                    (* 3 (+ (* 2 (style-value w :padding))
                            (text-width w (if (typep w 'time-picker) "00" "0000")))))
                 (+ (* 2 (style-value w :padding)) (line-height w)))))
   (values size size)))
(defmethod handle-event ((w date-picker) e)
 (case (event-kind e)
   (:down
    (setf (picker-digits w) "" (picker-press w) (picker-region-at w (event-x e) (event-y e)))
    (when (integerp (picker-press w)) (setf (picker-field w) (picker-press w)))
    (when (eq (picker-press w) :period) (setf (picker-field w) 3)) t)
   (:move (setf (picker-hover w) (picker-region-at w (event-x e) (event-y e))) t)
   (:up
    (let ((pressed (picker-press w)) (region (picker-region-at w (event-x e) (event-y e))))
      (setf (picker-press w) nil)
      (when (and pressed (eql pressed region))
        (if (and (integerp pressed) (not (typep w 'time-picker)))
            (picker-calendar w)
            (case pressed (:minus (picker-step w -1)) (:plus (picker-step w 1))
                          (:calendar (picker-calendar w)) (:period (picker-toggle-period w)))))) t)
   (:wheel (unless (zerop (event-delta e)) (picker-step w (signum (event-delta e)))) t)
   (:key
    (case (event-key e)
      ((:left :right) (setf (picker-field w) (mod (+ (picker-field w) (if (eq (event-key e) :left) -1 1)) (if (picker-twelve-hour-p w) 4 3))
                            (picker-digits w) "") t)
      ((:up :down) (picker-step w (if (eq (event-key e) :up) 1 -1)) t)
      (:escape (setf (picker-digits w) "") t)))
   (:text
    (loop for char across (event-text e) do
      (cond
        ((and (picker-twelve-hour-p w) (find char "aApP"))
         (let ((v (clock-time w)))
           (setf (first v) (+ (mod (first v) 12) (if (find char "pP") 12 0)))
           (picker-publish w v)))
        ((and (< (picker-field w) 3) (digit-char-p char))
         (let* ((limit (if (and (not (typep w 'time-picker)) (zerop (picker-field w))) 4 2))
                (digits (concatenate 'string (if (>= (length (picker-digits w)) limit) "" (picker-digits w)) (string char)))
                (number (parse-integer digits)))
           (setf (picker-digits w) digits)
           (if (and (picker-twelve-hour-p w) (zerop (picker-field w)))
               (when (<= 1 number 12)
                 (picker-set-field w (+ (mod number 12) (if (>= (first (clock-time w)) 12) 12 0))))
               (picker-set-field w number)))))) t)))

(defun picker-calendar (w)
 (when (picker-popup w) (return-from picker-calendar (picker-popup w)))
 (let* ((selected (calendar-date w)) (year (first selected)) (month (second selected))
        (root (root-of w))
        (popup (make-widget 'picker-calendar-popup :style '(:padding 12 :border-radius 0.6 :max-border-radius 12)
                 :x (max (x root) (min (x w) (- (+ (x root) (width root)) 310)))
                 :y (if (<= (+ (y w) (height w) 310) (+ (y root) (height root)))
                        (+ (y w) (height w)) (max (y root) (- (y w) 310)))
                 :width 310 :height 310 :popup-owner w)))
   (labels ((fill-calendar ()
              (dolist (child (copy-list (children popup))) (remove-child popup child :dispose t))
              (let ((header (add-child popup (make-widget 'box :orientation :horizontal :height 44)))
                    (days (make-widget 'grid :columns 7 :height 232 :spacing 2)))
                (flet ((nav (label delta)
                         (let ((b (add-child header (make-widget 'calendar-nav-button :text label :width 32 :height 28
                                                                :tooltip-text (if (minusp delta) "Previous month" "Next month")))))
                           (on b :activate (lambda (button payload) (declare (ignore button payload))
                             (let* ((index (+ (* (1- year) 12) (1- month) delta)))
                               (when (<= 0 index (1- (* 9999 12)))
                                 (setf year (1+ (floor index 12)) month (1+ (mod index 12)))
                                 (fill-calendar)))) :owner popup))))
                  (nav "<" -1)
                  (add-child header (make-widget 'label
                    :text (format nil "~a ~d" (nth (1- month) '("January" "February" "March" "April" "May" "June" "July" "August" "September" "October" "November" "December")) year)
                    :width 158 :height 28 :style '(:font-size 16 :padding 4 :bold t)))
                  (nav ">" 1))
                (add-child popup days)
                (dolist (name '("Mo" "Tu" "We" "Th" "Fr" "Sa" "Su"))
                  (add-child days (make-widget 'label :text name :style '(:font-size 14))))
                (let* ((previous (1- year))
                       (weekday (mod (+ (* 365 previous) (floor previous 4) (- (floor previous 100))
                                        (floor previous 400)
                                        (loop for m from 1 below month sum (picker-month-days year m))) 7)))
                  (dotimes (i weekday) (add-child days (make-widget 'widget)))
                  (loop for day from 1 to (picker-month-days year month) do
                    (let* ((date (list year month day))
                           (b (add-child days (make-widget 'calendar-day-button :text (princ-to-string day) :value (equal date selected)))))
                      (on b :activate (lambda (button payload) (declare (ignore button payload))
                        (dismiss-dialog popup)
                        (picker-publish w date)) :owner popup)))
                  ;; Keep a stable six-week calendar height.
                  (loop while (< (length (children days)) 49) do (add-child days (make-widget 'widget)))))))
     (fill-calendar)
     (setf (calendar-navigate popup)
       (lambda (day delta)
         (let ((target (+ day delta)))
           (cond ((< target 1)
                  (if (and (= year 1) (= month 1)) (setf target 1)
                      (progn (decf month) (when (< month 1) (setf month 12) (decf year))
                             (incf target (picker-month-days year month)))))
                 ((> target (picker-month-days year month))
                  (if (and (= year 9999) (= month 12)) (setf target 31)
                      (progn (decf target (picker-month-days year month))
                             (incf month) (when (> month 12) (setf month 1) (incf year))))))
           (fill-calendar)
           (let ((button (find (princ-to-string target) (children (second (children popup)))
                              :key (lambda (child) (if (typep child 'button) (text child) "")) :test #'string=)))
             (when button (focus root button))))))
     (setf (picker-popup w) popup)
     (show-dialog root popup)
     (let* ((days (second (children popup)))
            (day (find (princ-to-string (third selected)) (children days)
                       :key (lambda (child) (if (typep child 'button) (text child) "")) :test #'string=)))
       (when day (focus root day)))
     popup)))
(defmethod initialize-instance :after ((w date-picker) &key)
 (when (slot-boundp w 'calendar-date) (setf (calendar-date w) (calendar-date w)))
 (when (typep w 'time-picker) (setf (clock-time w) (clock-time w)))
 (unless (typep w 'time-picker)
   (on w :activate (lambda (source payload) (declare (ignore payload)) (picker-calendar source)) :owner w)))
