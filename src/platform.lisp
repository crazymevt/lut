(in-package #:lut)

(defun ui-to-device (window x y)
 "Convert logical UI coordinates to native window coordinates. OS backing-pixel DPI remains the backend's responsibility."
 (values (* x (ui-scale window)) (* y (ui-scale window))))
(defun device-to-ui (window x y) "Convert native window coordinates to logical UI units."
 (values (/ x (ui-scale window)) (/ y (ui-scale window))))
(defun dispatch-device-event (window event)
 "Dispatch a copied native-coordinate EVENT after one coordinate conversion; wheel deltas remain row units."
 (let ((copy (copy-event event)))
   (multiple-value-bind (x y) (device-to-ui window (event-x event) (event-y event))
     (setf (event-x copy) x (event-y copy) y))
   (dispatch window copy)))
(defmethod (setf ui-scale) :after (scale (window window))
 (declare (ignore scale))
 (walk-widgets window (lambda (node) (when (typep node 'label) (invalidate-text-geometry node))))
 (dolist (overlay (slot-value window 'overlays))
   (walk-widgets overlay (lambda (node) (when (typep node 'label) (invalidate-text-geometry node))))))
(defgeneric native-platform-available-p (window))
(defmethod native-platform-available-p ((window widget)) nil)
(defgeneric activate-native-command-menu (menu))
(defmethod activate-native-command-menu ((menu widget)) nil)
(defgeneric update-native-command-menu (menu snapshot))
(defmethod update-native-command-menu ((menu widget) snapshot) (declare (ignore snapshot)) nil)
(defgeneric release-native-command-menu (menu))
(defmethod release-native-command-menu ((menu widget)) nil)
(defgeneric native-shortcut-supported-p (command))
(defmethod native-shortcut-supported-p ((command widget)) nil)
(defgeneric run-native-path-request (request))
(defmethod run-native-path-request ((request widget)) nil)
(defun menu-separator-p (item) (or (null item) (eq item :separator)))

(defclass command-menu-heading (button) ())
(defmethod handle-event ((heading command-menu-heading) event)
 (let* ((root (root-of heading)) (scope (input-root root)))
   (when (and (eq (event-kind event) :move) (typep scope 'context-menu)
              (in-input-scope-p heading scope) (enabled-p heading))
     (unless (some (lambda (menu) (and (typep menu 'context-menu) (eq (popup-owner menu) heading)))
                   (slot-value root 'overlays))
       (loop while (typep (input-root root) 'context-menu) do (dismiss-dialog (input-root root)))
       (emit heading :activate nil))
     t)))
(defmethod layout :before ((bar menu-bar) x y width height)
 (declare (ignore x y width height))
 (dolist (heading (children bar))
   (when (typep heading 'command-menu-heading)
     (setf (width heading) (+ (text-width heading (text heading)) 24)))))

(defclass command-menu (widget)
 ((window :initarg :window :accessor menu-window)
  (groups :initarg :groups :accessor menu-groups)
  (context :initarg :context :accessor menu-context)
  (preference :initarg :native :accessor menu-preference)
  (bar :initform nil :reader command-menu-bar)
  (backend :initform :drawn :reader command-menu-backend)
  (bindings :initform nil :accessor menu-bindings)
  (shortcut-state :initform nil :accessor menu-shortcut-state)
  (native-state :initform nil :accessor menu-native-state))
 (:documentation "Owned per-window command menu handle. Groups contain :LABEL and :COMMANDS; :SEPARATOR/NIL entries separate actions. Dispose detaches native/drawn UI."))
(defun menu-item-snapshot (menu command)
 (if (menu-separator-p command) :separator
   (list :command command :label (command-label command) :shortcut (copy-tree (command-shortcut command))
     :commands (when (command-submenu command)
                 (mapcar (lambda (child) (menu-item-snapshot menu child))
                   (funcall (command-submenu command) command (menu-context menu))))
     :enabled (let ((window (menu-window menu)))
                (and (not (disposed-p window)) (enabled-p window) (visible-p window)
                     (eq (input-root window) window) (null (modal-blocker window))
                     (command-available-p command (menu-context menu)))))))
(defun menu-command-snapshot (menu)
 (loop for group in (menu-groups menu) collect
   (list :label (getf group :label) :commands
     (mapcar (lambda (command) (menu-item-snapshot menu command)) (getf group :commands)))))
(defun menu-record-actions (menu records)
 (loop for record in records collect
   (if (eq record :separator) :separator
     (let ((command (getf record :command)) (children (getf record :commands)))
       (list (getf record :label)
         (lambda () (invoke-menu-command menu command))
         (getf record :enabled)
         (when (command-submenu command)
           (lambda () (menu-record-actions menu children))))))))
(defun invoke-menu-command (menu command)
 (let ((window (menu-window menu)))
   (when (and window (not (disposed-p menu)) (not (disposed-p window))
              (enabled-p window) (visible-p window) (eq (input-root window) window) (null (modal-blocker window)))
     (invoke-command command (menu-context menu)))))
(defun sync-menu-shortcuts (menu)
 (let* ((commands (remove-duplicates (remove-if #'menu-separator-p (mapcan (lambda (group) (copy-list (getf group :commands))) (menu-groups menu)))))
        (state (list (command-menu-backend menu) (loop for c in commands collect (list c (disposed-p c) (copy-tree (command-shortcut c)))))))
   (unless (equal state (menu-shortcut-state menu))
     (dolist (binding (menu-bindings menu)) (dispose binding))
     (setf (menu-bindings menu) nil (menu-shortcut-state menu) state)
     (dolist (command commands)
       (when (and (not (disposed-p command))
                  (or (eq (command-menu-backend menu) :drawn) (not (native-shortcut-supported-p command))))
         (push (bind-command (menu-window menu) command :context (menu-context menu)) (menu-bindings menu)))))))
(defun open-command-menu-group (menu button group)
 (let ((snapshot (nth (position group (menu-groups menu) :test #'eq) (menu-command-snapshot menu))))
   (open-context-menu (menu-window menu) button
     (make-event :kind :context :x (x button) :y (+ (y button) (height button)))
     (menu-record-actions menu (getf snapshot :commands)))))
(defun refresh-command-menu (menu)
 "Refresh live labels, enabled states and shortcuts. Auto native installation waits until an eligible native context exists."
 (ensure-live menu)
 (when (and (not (eq (menu-preference menu) nil)) (eq (command-menu-backend menu) :drawn)
            (native-platform-available-p (menu-window menu)))
   (when (activate-native-command-menu menu)
     (setf (slot-value menu 'backend) :native (visible-p (command-menu-bar menu)) nil)))
 (sync-menu-shortcuts menu)
 (when (eq (command-menu-backend menu) :native) (update-native-command-menu menu (menu-command-snapshot menu))) menu)
(defun set-command-menu-native (menu native)
 "Switch MENU's backend preference at runtime. NIL forces drawn menus; :AUTO restores platform selection."
 (ensure-live menu)
 (unless (member native '(:auto t nil)) (error "NATIVE must be :AUTO, T or NIL."))
 (when (and (eq native t) (not (native-platform-available-p (menu-window menu))))
   (error 'unsupported-capability :capability :native-menu))
 (setf (menu-preference menu) native)
 (when (null native)
   (release-native-command-menu menu)
   (setf (slot-value menu 'backend) :drawn (visible-p (command-menu-bar menu)) t))
 (refresh-command-menu menu))

(defun install-command-menu (window groups &key (native :auto) (context window))
 "Install one menu per WINDOW. GROUPS are (:LABEL string :COMMANDS (command ... :SEPARATOR ...)) plists; NIL also separates. NATIVE :AUTO/T/NIL selects preference; workers retain drawn menus. Commands stay application-owned."
 (check-type window window) (ensure-live window)
 (unless (member native '(:auto t nil)) (error "NATIVE must be :AUTO, T or NIL."))
 (when (find-if (lambda (resource) (typep resource 'command-menu)) (slot-value window 'platform-resources))
   (error "A command menu is already installed for this window."))
 (unless (and (listp groups) groups
              (every (lambda (group) (and (stringp (getf group :label)) (listp (getf group :commands))
                (every (lambda (c) (or (menu-separator-p c) (and (typep c 'command) (not (disposed-p c))))) (getf group :commands)))) groups))
   (error "Menu groups require labels and live command lists."))
 (when (and (eq native t) (not (native-platform-available-p window))) (error 'unsupported-capability :capability :native-menu))
 (let* ((menu (make-instance 'command-menu :window window :groups
               (mapcar (lambda (group) (list :label (copy-seq (getf group :label)) :commands (copy-list (getf group :commands)))) groups)
               :context context :native native))
        (bar (make-widget 'menu-bar :height (row-height window) :spacing 0 :style '(:padding 0))))
   (setf (slot-value menu 'bar) bar)
   (handler-case
     (progn
       (dolist (group (menu-groups menu))
         (let ((button (add-child bar (make-widget 'command-menu-heading :text (getf group :label) :height (row-height window)
                                    :style '(:button-depth 0 :border-width 0 :border-radius 0 :padding 12)))))
           (on button :activate (lambda (w p) (declare (ignore p)) (open-command-menu-group menu w group)) :owner menu)))
       (add-child window bar)
       (push menu (slot-value window 'platform-resources))
       (on window :context-close (lambda (w p) (declare (ignore w p))
         (release-native-command-menu menu)
         (setf (slot-value menu 'backend) :drawn (visible-p bar) t)
         (sync-menu-shortcuts menu)) :owner menu)
       (refresh-command-menu menu))
     (error (condition) (dispose menu) (error condition))) menu))
(defmethod dispose :before ((menu command-menu))
 (release-native-command-menu menu)
 (dolist (binding (menu-bindings menu)) (dispose binding))
 (when (command-menu-bar menu) (dispose (command-menu-bar menu))))
(defmethod dispose :after ((menu command-menu))
 (when (menu-window menu)
   (setf (slot-value (menu-window menu) 'platform-resources) (remove menu (slot-value (menu-window menu) 'platform-resources))))
 (setf (menu-window menu) nil (menu-groups menu) nil (menu-context menu) nil (menu-bindings menu) nil
       (slot-value menu 'bar) nil (menu-native-state menu) nil (menu-shortcut-state menu) nil))

(defclass path-request (widget)
 ((window :initarg :window :accessor request-window)
  (callback :initarg :callback :accessor request-callback)
  (kind :initarg :kind :reader request-kind)
  (initial-directory :initarg :directory :reader request-directory)
  (filename :initarg :filename :reader request-filename)
  (title :initarg :title :reader request-title)
  (state :initform :pending :reader path-request-state)
  (result :initform nil :reader path-request-result)
  (dialog :initform nil :reader path-request-dialog))
 (:documentation "One file/folder/save request. Callback receives pathname on acceptance or NIL on cancellation; no file is written."))
(defclass portable-path-dialog (dialog) ((request :initarg :request :accessor dialog-path-request)))
(defmethod surface-closed ((dialog portable-path-dialog))
 (let ((request (dialog-path-request dialog)))
   (when (and request (eq (path-request-state request) :pending)) (cancel-path-request request))))
(defmethod dispose :before ((dialog portable-path-dialog))
 (let ((request (dialog-path-request dialog)))
   (when (and request (eq (path-request-state request) :pending)) (cancel-path-request request))))
(defmethod dispose :after ((dialog portable-path-dialog)) (setf (dialog-path-request dialog) nil))
(defun finish-path-request (request path)
 (when (eq (path-request-state request) :pending)
   (let ((callback (request-callback request)))
     (setf (slot-value request 'state) (if path :accepted :cancelled) (slot-value request 'result) path
           (request-callback request) nil)
     (when (path-request-dialog request)
       (let ((dialog (path-request-dialog request)))
         (setf (slot-value request 'dialog) nil) (dismiss-dialog dialog) (dispose dialog)))
     (let ((window (request-window request)))
       (when window (setf (slot-value window 'platform-resources) (remove request (slot-value window 'platform-resources))))
       (setf (request-window request) nil))
     (when callback (funcall callback path)))) request)
(defun cancel-path-request (request)
 "Cancel a pending portable request once, releasing UI/callback references before calling CALLBACK with NIL."
 (finish-path-request request nil))
(defun accepted-request-path (request string)
 (let ((path (merge-pathnames (pathname string) (request-directory request))))
   (case (request-kind request)
     (:file (unless (and (probe-file path) (not (uiop:directory-pathname-p (truename path)))) (error "Choose an existing file.")) (truename path))
     (:folder (unless (uiop:directory-exists-p path) (error "Choose an existing directory.")) (truename (uiop:ensure-directory-pathname path)))
     (:save (when (or (uiop:directory-pathname-p path) (not (uiop:directory-exists-p (uiop:pathname-directory-pathname path))))
              (error "Choose a filename in an existing directory.")) path))))
(defun show-portable-path-request (request)
 (let* ((dialog (make-widget 'portable-path-dialog :request request :text (request-title request) :width 580 :height 470 :native-p nil))
        (path (add-child dialog (make-widget 'entry :text (namestring (merge-pathnames (or (request-filename request) "") (request-directory request))))))
        (files (add-child dialog (make-widget 'list-view :height 192)))
        (status (add-child dialog (make-widget 'label :id :path-validation-status :text "" :height 44
                                  :style '(:foreground :red :wrap-text t :font-size 14 :line-height 20)))))
   (labels ((refresh ()
              (let* ((p (pathname (text path))) (directory (if (uiop:directory-exists-p p) (uiop:ensure-directory-pathname p) (uiop:pathname-directory-pathname p))))
                (setf (items files) (mapcar #'namestring (append (uiop:subdirectories directory)
                  (unless (eq (request-kind request) :folder) (uiop:directory-files directory)))))))
            (report-validation-error (condition)
              (setf (text status) (princ-to-string condition))
              (focus (root-of path) path))
            (try-refresh ()
              (handler-case (progn (refresh) (setf (text status) ""))
                (error (condition) (report-validation-error condition)))))
     (on files :change (lambda (w i) (setf (text path) (nth i (items w)))) :owner request)
     (chooser-action dialog "Browse directory" #'try-refresh)
     (chooser-action dialog "Choose" (lambda ()
       ;; Only path parsing/validation belongs to inline feedback. Application
       ;; callback errors must still propagate after committed completion.
       (multiple-value-bind (chosen valid-p)
           (handler-case (values (accepted-request-path request (text path)) t)
             (error (condition) (report-validation-error condition) (values nil nil)))
         (when valid-p (finish-path-request request chosen)))))
     (chooser-action dialog "Cancel" (lambda () (cancel-path-request request)))
     ;; The initial browse can fail (for example, directory permissions) too;
     ;; show that failure after the dialog belongs to the active input scope.
     (setf (slot-value request 'dialog) dialog)
     (show-dialog (request-window request) dialog)
     (try-refresh))) request)
(defun request-path (window callback &key (kind :file) (directory (user-homedir-pathname)) filename (title "Choose a path") (native :auto))
 "Request :FILE/:FOLDER/:SAVE. Callback receives one pathname or NIL. Native dialogs are synchronous; fallback dialogs complete later. No file creation or overwrite policy."
 (check-type window window) (ensure-live window)
 (unless (and (member kind '(:file :folder :save)) (member native '(:auto t nil)) (typep callback '(or function symbol))
              (stringp title) (or (null filename) (stringp filename))) (error "Invalid path request options."))
 (let* ((directory (truename (uiop:ensure-directory-pathname directory)))
        (request (make-instance 'path-request :window window :callback callback :kind kind :directory directory :filename filename :title title)))
   (push request (slot-value window 'platform-resources))
   (handler-case
     (if (and native (native-platform-available-p window))
         (run-native-path-request request)
         (if (eq native t) (error 'unsupported-capability :capability :native-path-picker) (show-portable-path-request request)))
     (error (condition) (dispose request) (error condition))) request))
(defmethod dispose :before ((request path-request))
 (setf (request-callback request) nil)
 (cancel-path-request request))
(defmethod dispose :after ((request path-request))
 (setf (request-window request) nil (slot-value request 'dialog) nil (slot-value request 'result) nil))
(defun refresh-platform-integration (window)
 (dolist (resource (copy-list (slot-value window 'platform-resources)))
   (when (and (typep resource 'command-menu) (not (disposed-p resource))) (refresh-command-menu resource))))
(defun release-platform-context (window)
 ;; Called from the backend's unwind cleanup as well as ordinary context-close
 ;; hooks, so an application observer cannot strand native targets/menus.
 (let ((failure nil))
   (dolist (resource (copy-list (slot-value window 'platform-resources)))
     (when (and (typep resource 'command-menu) (not (disposed-p resource)))
       (handler-case
           (progn (release-native-command-menu resource)
             (setf (slot-value resource 'backend) :drawn (visible-p (command-menu-bar resource)) t)
             (sync-menu-shortcuts resource))
         (error (condition) (unless failure (setf failure condition))))))
   (when failure (error failure))))
(defmethod dispose :before ((window window))
 (let ((resources (slot-value window 'platform-resources)) (failure nil))
   (setf (slot-value window 'platform-resources) nil)
   (dolist (resource resources) (handler-case (dispose resource) (error (e) (unless failure (setf failure e)))))
   (when failure (error failure))))
(defun platform-capabilities (window)
 "Return fresh capability audit records. Native availability requires an eligible primary macOS context; text gaps are explicit."
 (let ((native (native-platform-available-p window)))
   (list (list :name :default-application :status (if (getf (default-application-capabilities) :available-p) :available :unsupported))
         (list :name :window-state :status (if (native-window-state-available-p window) :native :unavailable))
         (list :name :menus :status (if native :native :portable) :scope :primary-window)
         (list :name :path-pickers :status (if native :native :portable) :scope :primary-window)
         (list :name :ui-scaling :status :portable :units :logical)
         (list :name :unicode-glyphs :status :partial :detail "Font coverage; character indices, no grapheme/shaping engine.")
         (list :name :shaping :status :unsupported) (list :name :bidi :status :unsupported)
         (list :name :ime-composition :status :unsupported) (list :name :accessibility :status :unsupported)
         (list :name :linux-native :status :unverified) (list :name :windows-native :status :unverified))))
(defun platform-capability (window name) "Return one copied capability audit record, or NIL for unknown NAME."
 (find name (platform-capabilities window) :key (lambda (record) (getf record :name))))
